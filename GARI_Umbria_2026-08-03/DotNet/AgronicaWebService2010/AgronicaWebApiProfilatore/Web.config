      </service>
    </services>
    <behaviors>
      <endpointBehaviors>
        <behavior name="BH_ProfilatoreUtenze_EndPoint">
          <webHttp />
        </behavior>
      </endpointBehaviors>
      <serviceBehaviors>
        <behavior name="BH_ProfilatoreUtenze">
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>

    <bindings configSource="bindings.config" />
    <serviceHostingEnvironment multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
