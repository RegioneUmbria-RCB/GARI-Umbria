    Gli attributi seguenti possono essere impostati sul tag <httpRuntime>.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->   
  <system.web>
    <compilation debug="true" strict="false" explicit="true" targetFramework="4.8" />
    <customErrors mode="RemoteOnly" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
  <system.web.extensions>
    <scripting>
      <scriptResourceHandler enableCompression="true" enableCaching="true" />
      <webServices>
        <jsonSerialization maxJsonLength="2147483647" />
      </webServices>
    </scripting>
  </system.web.extensions>
    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <!--<add name="Access-Control-Allow-Origin" value="*" />-->
                <add name="Access-Control-Allow-Headers" value="Content-Type, x-compressione, x-timezone" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
    <appSettings file="appsettings.config">
        <add key="cr2" value="74b7ca09-dbe5-4e5d-9a70-661cb5f60587" />
    </appSettings>
  <system.serviceModel>
    <services>
