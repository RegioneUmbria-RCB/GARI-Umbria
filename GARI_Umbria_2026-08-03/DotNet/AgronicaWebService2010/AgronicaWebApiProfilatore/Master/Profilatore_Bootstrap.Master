</head>
<body onload="">


    <div id="wrap_master">

    <div id="DIV_Messaggi" ></div>


    <form id="Form1" runat="server" class="form-horizontal">
    <asp:ScriptManager ID="ScriptManager1" runat="server">
    </asp:ScriptManager>
    
    <cc2:Agrokendo id="agroKendo" runat="server" />

    <script>
        kendo.culture("it-IT");
    </script>
    
    <script src="<%=PATH_GIASBASE %>agronica/Scripts/AgronicaControlli/controlli_form.js?<% =Application("GiasVersioneCorrente")%>" type="text/javascript"></script>
    
    <script type="text/javascript" src="<%= ResolveClientUrl("Profilatore_Bootstrap_jQueryDocReady.js?" & Application("GiasVersioneCorrente").ToString) %>"></script>
