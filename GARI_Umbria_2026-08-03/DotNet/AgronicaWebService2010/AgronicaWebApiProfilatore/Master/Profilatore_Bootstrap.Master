     <style type="text/css">

      /* Sticky footer styles
      -------------------------------------------------- */

      html,
      body {
        height: 100%;
        /* The html and body elements cannot have any padding or margin. */
      }

      /* Wrapper for page content to push down footer */
      #wrap_master {
        min-height: 100%;
        height: auto !important;
        height: 100%;
        /* Negative indent footer by it's height */
        margin: 0 auto -85px;
          padding: 0 0 85px;
      }

      /* Set the fixed height of the footer here */
      #push,
      #footer {
        height: 85px;
      }
      #footer {
        background-color: #052747;
        color: #fff;
        padding: 15px 0;
      }
      #footer h5
      {
          font-size: 14px;
          margin-bottom: 3px;
      }
      


      /* Lastly, apply responsive CSS fixes as necessary */
      @media (max-width: 991px) {
        #footer {
         /* margin-left: -20px;
          margin-right: -20px;*/
          padding-left: 20px;
          padding-right: 20px;
          padding-bottom: 20px;
          height: auto;
        }
        
        .footer_logo
        {
            float: none;
            margin-bottom: 5px;
        }
        
        #footer .nopadding
        {
            text-align: center;
            margin-bottom: 15px;
            
        }
      }
      
    /*  
    @media(max-width: 767px){body { font-size: 18px; }}
    @media(min-width: 768px){body { font-size: 16px; }}
    @media(min-width: 992px){body { font-size: 14px; }}
    @media(min-width: 1200px){body { font-size: 12px; }}
    */
    </style>
    

    <script type="text/javascript">

        //configurazione server 
        //var pathCoreWS = '<=pathCoreWS %>';
        var localizationPageUrl = "<%= ResolveClientUrl("~/Localization.aspx") %>";
        
