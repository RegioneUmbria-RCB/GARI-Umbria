                                            Dim Flag_Protetto As Integer = -1
                                            Dim Flag_PubblicoPrivato As Integer = 0
                                            'Dim IdRcdpi As Integer = 0


                                            '02/09/2014 escludo la protezione antigrandine
                                            If Cop_Cod <> 0 AndAlso
                                                    Cop_Cod <> 1 AndAlso
                                                    Cop_Cod <> 3 AndAlso
                                                    Cop_Cod <> 4 AndAlso
                                                    Cop_Cod <> 5 AndAlso
                                                    Cop_Cod <> 6 Then
