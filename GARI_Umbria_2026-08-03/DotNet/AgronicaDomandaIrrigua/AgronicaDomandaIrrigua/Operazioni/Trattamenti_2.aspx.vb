    Private Sub CheckSostenibilita(ByVal sender As Object, ByVal e As System.EventArgs)

        If objParametriAgenda.Disciplinare = NessunDpiNessunaEtichetta Then
            Exit Sub
        End If

        If Not (Not IsNothing(objParametriAgenda.Veg_Cod) AndAlso
                              IsNumeric(objParametriAgenda.Veg_Cod.Split("/")(0)) AndAlso
                              CInt(objParametriAgenda.Veg_Cod.Split("/")(0)) > 0) Then
            Exit Sub
        End If

        '---------------------------------------
        ' recupero gli IMPIANTI
        Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
        ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()
        If ListaImpianti.Count = 0 Then
            Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.SelezionareAlmenoUnImpiantoColturale, Page, ,
                                    CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
            Exit Sub
        End If
        'modifico la selezione degli rbl per salvare correttamente i dati dato che salvo sempre e solo la dose/ha
        rbl_DoseHA.Checked = True
        rbl_DoseHL.Checked = False
        rbl_QtaDose.Checked = True
        rbl_QtaTot.Checked = False



        '--------------------------------------------------
        '--------------------------------------------------
        '--------- CREAZIONE OGGETTO DA SALVARE   ---------
        '--------------------------------------------------
        '--------------------------------------------------

        'non mi importa suddividere le qta dei magazzini
        Dim i As Integer = 0
        Dim Dt_Dosi As New DataTable
        Dt_Dosi = Session("vs_dtDosi")
        Dim dt_DosiSelect As DataTable
        Dim Qta_da_scaricare As New List(Of Decimal)
        dt_DosiSelect = Dt_Dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto")
        For i = 0 To dt_DosiSelect.Rows.Count - 1
            Dim qta As Decimal = 0
            Dim rows = Dt_Dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' ")
            For Each row In rows
                qta += row.Item("Dose_Tot_Reale")
            Next
            Qta_da_scaricare.Add(qta)
            'Qta_da_scaricare.Add(dt_dosi.Rows(i).Item("Qta_Tot"))
        Next

        Dim Qta_da_scaricare_Magazzino As New List(Of Decimal)
        dt_DosiSelect = Dt_Dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto", "Piva", "Sa_Cod", "Fabbricato_Cod")
        For i = 0 To dt_DosiSelect.Rows.Count - 1
            Dim qta As Decimal = 0
            Dim rows = Dt_Dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' " &
                                              " AND Lotto = '" & dt_DosiSelect.Rows(i)("Lotto") & "' " &
                                              " AND Piva = '" & dt_DosiSelect.Rows(i)("Piva") & "' " &
                                              " AND Sa_Cod = " & dt_DosiSelect.Rows(i)("Sa_Cod") & " " &
                                              " AND Fabbricato_Cod = " & dt_DosiSelect.Rows(i)("Fabbricato_Cod") & " ")
            For Each row In rows
                qta += row.Item("Dose_Tot_Reale")
            Next
            Qta_da_scaricare_Magazzino.Add(qta)
            'Qta_da_scaricare.Add(dt_dosi.Rows(i).Item("Qta_Tot"))
        Next

        Dim Agenda As Operazione_Agenda
        Agenda = CreaOggettoAgenda(ListaImpianti, objParametriAgenda.Sa_Cod, Qta_da_scaricare, Qta_da_scaricare_Magazzino)

        If IsNothing(Agenda) Then
            Exit Sub
        End If

        'Dim Dpi_Cod As Integer = 0
        'Dim Dpi_PubblicoPrivato As Integer = 0
        'Dim Bio As Boolean = False

        'una volta creato l'oggetto agenda posso invocare il suo metodo che mi genera l'xml
        'Dim Helper As New Agenda_Operazione_Helper
        'Dim strXML As String
        'If IsTrattamento = True Then
        '    strXML = Helper.GeneraXML_CAU_TRATTAMENTO(Agenda, Dpi_Cod, Dpi_PubblicoPrivato)
        'Else
        '    strXML = Helper.GeneraXML_CAU_LAVORAZIONI(Agenda, Dpi_Cod, Dpi_PubblicoPrivato)
        'End If

        'strXML = Replace(strXML, "TipoOperazioneDB=""1""", "TipoOperazioneDB=""" & Agenda.Tipo_Operazione & """")

        '------------------------verifica disciplinare agenda 2010------------------------
        Dim Array = Split(objParametriAgenda.Disciplinare, "/")
        Dim Disciplinare_Cod As Integer = CInt(Array(0))
        Dim Disciplinare_PubblicoPrivato As Integer = 0
        Dim Disciplinare_Des As String = ""
        If Array.Length > 4 AndAlso Array(4) IsNot Nothing Then
            Disciplinare_PubblicoPrivato = CInt(Array(4))
        End If
        Disciplinare_Des = CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Testo_Combo
        Dim Elemento_Verifica_Disciplinare As New AgronicaCoreModello.Agenda.Util.Elemento_Verifica_Disciplinare(Disciplinare_Cod, Disciplinare_PubblicoPrivato, Disciplinare_Des, Agenda)

        'Elemento_Verifica_Disciplinare.Disciplinare_Cod = Disciplinare_Cod
        'Elemento_Verifica_Disciplinare.Disciplinare_PubblicoPrivato = Disciplinare_PubblicoPrivato
        'If Elemento_Verifica_Disciplinare.Disciplinare_Cod = -2 Then
        '    Elemento_Verifica_Disciplinare.Biologico = True
        'End If
        'Elemento_Verifica_Disciplinare.Disciplinare_Des = Disciplinare_Des


        Session("Elemento_Verifica_Disciplinare") = Elemento_Verifica_Disciplinare


        Dim strJS1 As New StringBuilder
        strJS1.AppendLine("$(document).ready(function () { ")
        strJS1.AppendLine("      window.open( '../GestioneDisciplinari/Verifica_Sostenibilita.aspx') ")
        strJS1.AppendLine(" });")
        ScriptManager.RegisterStartupScript(CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel), CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).GetType(),
                                          String.Format("jQuery_{0}", CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).ClientID), strJS1.ToString, True)

        '---------------------------------------------------------------------------

    End Sub

    Private Sub CambiatoDisciplinare()

        ComboFormulati.ddl_Formulati.Items.Clear()
        ddl_avversita.Items.Clear()
        ComboEtichetta.ddl_Dosi.Items.Clear()

        Select Case objParametriAgenda.Lav_Cod

            Case LAVCOD_DISTRIBUZIONE_CONCIME, LAVCOD_SARCHIATURA_CONCIMAZIONE, LAVCOD_DISTRIBUZIONE_AMMENDANTI, LAVCOD_CONCIMAZIONE_FOGLIARE, LAVCOD_FERTIRRIGAZIONE, LAVCOD_TRATTAMENTO_ANTIBUTTERATURA

                riga_animali.Visible = False
                'If objParametriAgenda.Lav_Cod = LAVCOD_DISTRIBUZIONE_AMMENDANTI Then

                If Not IsNothing(objParametriAgenda.Veg_Cod) AndAlso
                            objParametriAgenda.Veg_Cod.Split("/")(0) <> "" AndAlso
                            objParametriAgenda.Veg_Cod.Split("/")(0) <> "-1" Then

                    ComboEpoche.Veg_Cod = objParametriAgenda.Veg_Cod.Split("/")(0)

                    ComboEpoche.PrimaRiga_Flag = True
                    ComboEpoche.PrimaRiga_Text = ""
                    ComboEpoche.PrimaRiga_Value = "0"

                    'If objParametriAgenda.Disciplinare.Split("/").Length > 1 AndAlso objParametriAgenda.Disciplinare.Split("/")(1) = enum_PUARegolamenti_Tipo.PUA Then
                    If objParametriAgenda.Disciplinare.Split("/").Length > 1 Then
                        ComboEpoche.Regolamento_Cod = objParametriAgenda.Disciplinare.Split("/")(0)
                        If objParametriAgenda.Disciplinare.Split("/")(1) = enum_PUARegolamenti_Tipo.PUA Then
                            ComboEpoche.PrimaRiga_Flag = False
                        End If
                    End If

                    'ComboEpoche.CaricaComboEpocheFertilizzazione()
                    ComboEpoche.CaricaComboEpocheFertilizzazionePua()

                    If ComboEpoche.ddl_ComboEpocheFertilizzazione.Items.Count > 0 Then
                        riga_epoca_fertilizzazione.Visible = True
                        Dim sbScript As New StringBuilder()

                        sbScript.Append("<script language='JavaScript' type='text/javascript'>" & ControlChars.Lf)
                        sbScript.Append("<!--" & ControlChars.Lf)
                        sbScript.Append((Me.GetPostBackEventReference(Me, "PBArg") & ";" & ControlChars.Lf))
                        sbScript.Append("// -->" & ControlChars.Lf)
                        sbScript.Append("</")
                        sbScript.Append("script>" & ControlChars.Lf)
                        Me.RegisterStartupScript("AutoPostBackScript", sbScript.ToString())

                    Else
                        riga_epoca_fertilizzazione.Visible = False
                    End If

                Else
                    riga_epoca_fertilizzazione.Visible = False
                End If


                If objParametriAgenda.TipoRicetta <> enum_TipoRicetta.PianoDistribuzionePua AndAlso
                    objParametriAgenda.Disciplinare.Split("/").Length > 1 AndAlso
                    objParametriAgenda.Disciplinare.Split("/")(1) = "2" AndAlso
                    CInt(objParametriAgenda.Disciplinare.Split("/")(0)) < 78 Then
                    CaricaListControl.Lista_Tipi_Allevamenti(Cmb_Allevamenti, False, "", "", objParametriAgenda.Disciplinare.Split("/")(0), "", "", objParametri_Server)
                    riga_animali.Visible = True
                End If

                'End If

                'If objParametriAgenda.Lav_Cod = LAVCOD_DISTRIBUZIONE_AMMENDANTI AndAlso
                '        objParametriAgenda.Disciplinare.Split("/").Length > 1 AndAlso
                '        objParametriAgenda.Disciplinare.Split("/")(1) = "2" Then
                '    AgronicaCoreUtility.CaricaListControl.Lista_Tipi_Allevamenti(Cmb_Allevamenti, False, "", "", objParametriAgenda.Disciplinare.Split("/")(0), "", "", objParametri_Server)
                '    riga_animali.Visible = True
                'End If

            Case Else

                If objParametriAgenda.FiltroRicerca = "2" Then
                    'CaricaGriglia_Avversita()
                    Carica_Avversita()
                End If

                If Not IsNothing(objParametriAgenda.Disciplinare) AndAlso
                objParametriAgenda.Disciplinare <> "0" AndAlso
                objParametriAgenda.Disciplinare <> "-2" AndAlso
                objParametriAgenda.Disciplinare <> NessunDpiNessunaEtichetta AndAlso
                objParametriAgenda.Disciplinare <> "" Then

                    Dim Array() As String
                    Dim Dpi_Cod As Integer = 0
                    Dim IdRcdpi As Integer = 0
                    Dim Grfi_Cod As Integer = 0
                    Dim Flag_Protetto As Integer = 0
                    Dim Flag_PubblicoPrivato As Integer = 0
                    Dim TipoTestata As Integer = 0

                    Array = Split(objParametriAgenda.Disciplinare, "/")
                    Dpi_Cod = Array(0)
                    IdRcdpi = Array(1)
                    Grfi_Cod = Array(2)
                    Flag_Protetto = Array(3)
                    Flag_PubblicoPrivato = Array(4)

                    Select Case objParametriAgenda.Lav_Cod
                        Case LAVCOD_TRATTAMENTO_ANTIPARASSITARIO, LAVCOD_TRATTAMENTO_FITOREGOLATORE, LAVCOD_CONCIA_SEME, LAVCOD_GEODISINFESTAZIONE,
                                 LAVCOD_CONFUSIONE_SESSUALE, LAVCOD_DISORIENTAMENTO_SESSUALE
                            TipoTestata = 0
                        Case LAVCOD_DISERBO
                            TipoTestata = 1
                        Case LAVCOD_DISSECCAMENTO
                            TipoTestata = 0
                    End Select

                    ComboEpocheDPI1.TipoTestata = TipoTestata
                    ComboEpocheDPI1.IdRcdpi = IdRcdpi
                    If Flag_PubblicoPrivato = 2 Then
                        Dpi_Cod = -Dpi_Cod
                    End If
                    ComboEpocheDPI1.Dpi_Cod = Dpi_Cod
                    ComboEpocheDPI1.Modulo = 0

                    ComboEpocheDPI1.CaricaComboEpocheDPI()

                    If ComboEpocheDPI1.ddl_ComboEpocheDPI.Items.Count > 0 Then
                        riga_epoca_trattamento.Visible = True
                    Else
                        riga_epoca_trattamento.Visible = False
                    End If

                Else
                    riga_epoca_trattamento.Visible = False
                End If

        End Select

    End Sub

