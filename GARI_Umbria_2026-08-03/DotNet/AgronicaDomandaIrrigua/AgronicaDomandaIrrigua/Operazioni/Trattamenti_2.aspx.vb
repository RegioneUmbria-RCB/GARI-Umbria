    Private Function ControllaDosaggio(ByVal Fr_Cod As Integer, ByVal Dose_Acqua As Decimal,
                                           ByVal For_Veg_Av_Dos_Cod As Integer,
                                           ByVal DoseMin As Decimal, ByVal DoseMax As Decimal, ByVal Udm_Cod As Integer, ByVal Udm_Sim As String,
                                           ByVal AcquaMin As Decimal, ByVal AcquaMax As Decimal, ByVal AcquaUdm_Cod As Integer, ByVal AcquaUdm_Sim As String,
                                           ByVal Da_Epoca As Integer, ByVal A_Epoca As Integer,
                                           ByVal Limite As Integer, ByVal Limite_Udm_Cod As Integer, ByVal Limite_Sim As String,
                                           ByVal Flag_Fioritura As Integer,
                                           ByVal IntervalloTrattamenti_Min As Integer, ByVal IntervalloTrattamenti_Max As Integer,
                                           ByVal Num_Max_Interventi_Globali As Integer, ByVal Gruppo_Dosaggi As Integer,
                                           ByRef strAlert As String) As Boolean


        Dim SuperataDose As Boolean = False
        Dim SuperataDoseDiserbo As Boolean = False

        'Dim strAlert As String = ""

        'controllo le dosi MASSIME
        Dim BloccoDoseMassima As Boolean = ControllaDoseMassima(DoseMax, Udm_Cod, SuperataDose, SuperataDoseDiserbo, strAlert)

        'controllo N MAX trattamenti
        Dim BloccoNTratt As Boolean = ControllaNumeroMaxTrattamenti(Fr_Cod, For_Veg_Av_Dos_Cod, Limite, Limite_Udm_Cod, Limite_Sim, Num_Max_Interventi_Globali, strAlert)

        'controllo Intervallo Trattamenti
        Dim BloccoIntervallo As Boolean = ControllaIntervalloTrattamenti(Fr_Cod, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max, strAlert)

        ' ACQUA
        Dim BloccoAcqua As Boolean = ControllaAcqua(AcquaMin, AcquaMax, AcquaUdm_Cod, Dose_Acqua, SuperataDose, strAlert)

        'controllo le dosi MINIME
        'le dosi minime NON sono BLOCCANTI
        Dim BloccoDoseMinima As Boolean = ControllaDoseMinima(DoseMin, Udm_Cod, SuperataDose, strAlert)

        ''controllo Fioritura
        'Dim BloccoDopoFioritura As Boolean = False
        'If Flag_Fioritura <> 0 Then
        '    BloccoDopoFioritura = ControllaBloccoFioritura(Fr_Cod, strAlert)
        'End If

        'If strAlert <> "" Then
        '    Messaggi.AgroMsgBox(strAlert, Page, , updateDoseInserisci)
        'End If

        If BloccoDoseMassima Then
            Return False
        End If

        If BloccoNTratt Then
            Return False
        End If

        If BloccoIntervallo Then
            Return False
        End If

        If BloccoAcqua Then
            Return False
        End If

        If BloccoDoseMinima Then
            Return False
        End If

        'If BloccoDopoFioritura Then
        '    Return False
        'End If

        Return True

    End Function

    Private Function ControllaSogliaSoddisfatta(ByVal Soglia_LavCod As Integer, ByVal Soglia_AvCod As Integer,
                                                    ByVal Soglia_UdmCod As Integer, ByVal Soglia_Qta As Decimal,
                                                       ByRef strVerificaSoglia As String) As Boolean

        Dim nImpiantiViolati As Integer = 0
        Dim strErr_SogliaNonSoddisfatta As String = ""
        Dim SogliaSoddisfatta As Boolean = True
        Dim SogliaImpOk As Boolean

        ' recupero gli IMPIANTI
        Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
        ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()

        If ListaImpianti.Count <> 0 Then

            For i = 0 To ListaImpianti.Count - 1

                Select Case Soglia_LavCod

                    Case LAVCOD_RILIEVO_AVVERSITA_CAMPO

                        SogliaImpOk = False

                        Dim ObjRilievi As New AgronicaCoreContabDAL.Mov_Dettaglio_Tecnico_R
                        Dim dtRilievi As DataTable

                        'Lettura Rilievi Precedenti
                        dtRilievi = ObjRilievi.Leggi_RilieviAvversita(ListaImpianti.Item(i).Piva,
                                                                            ListaImpianti.Item(i).Sa_Cod,
                                                                            ListaImpianti.Item(i).Appezza,
                                                                            ListaImpianti.Item(i).ID_Reg,
                                                                            Soglia_UdmCod,
                                                                            Soglia_AvCod,
                                                                            ListaImpianti.Item(i).Validita_Inizio_Distinta,
                                                                            objParametriAgenda.Data,
                                                                            AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                            "",
                                                                            "Mov_Destinazioni.Validita_Inizio Desc, Mov_Destinazioni.Qta Desc",
                                                                            objParametri_Server)

                        If dtRilievi.Rows.Count > 0 Then

                            'Gestione Presenza
                            If CDbl(Soglia_Qta) = 0 Then
                                Soglia_Qta = 0.5 'Presenza
                            End If

                            If CDbl(dtRilievi.Rows(0).Item("Qta")) < Soglia_Qta Then
                                nImpiantiViolati += 1
                                strErr_SogliaNonSoddisfatta &= " App." & ListaImpianti.Item(i).App_Nome & ", "
                            Else
                                SogliaImpOk = True
                                'Soglia Soddisfatta --> Impianto Ok
                            End If

                        Else
                            nImpiantiViolati += 1
                            strErr_SogliaNonSoddisfatta &= " App." & ListaImpianti.Item(i).App_Nome & ", "
                        End If

                        If Not SogliaImpOk Then

                            'Ricerca di un rilievo fatto nel centro rispetta all'avversità e alla specie vegetale
                            dtRilievi = ObjRilievi.Leggi_RilieviTrappole(ListaImpianti.Item(i).Piva,
                                                                                ListaImpianti.Item(i).Sa_Cod,
                                                                                0,
                                                                                0,
                                                                                0,
                                                                                Soglia_AvCod,
                                                                                objParametriAgenda.Veg_Cod.Split("/")(0),
                                                                                ListaImpianti.Item(i).Validita_Inizio_Distinta,
                                                                                objParametriAgenda.Data,
                                                                                AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                                "",
                                                                                "",
                                                                                objParametri_Server)

                            Dim Qta_Rilievo As Integer = 0
                            Dim Qta_Media_Rilievo As Integer = 0

                            If dtRilievi.Rows.Count > 0 Then

                                Dim iRil As Integer
                                For iRil = 0 To dtRilievi.Rows.Count - 1
                                    Qta_Rilievo = Qta_Rilievo + dtRilievi.Rows(iRil).Item("Qta_Ril")
                                Next iRil

                                Qta_Media_Rilievo = (Qta_Rilievo / dtRilievi.Rows.Count)

                                If Qta_Media_Rilievo >= Soglia_Qta Then
                                    'Soglia Soddisfatta --> Impianto Ok
                                    SogliaImpOk = True
                                    nImpiantiViolati -= 1
                                    strErr_SogliaNonSoddisfatta = Replace(strErr_SogliaNonSoddisfatta, " App." & ListaImpianti.Item(i).App_Nome & ", ", "")
                                End If
                            End If

                        End If


                    Case LAVCOD_RILIEVO_AVVERSITA_TRAPPOLE

                        SogliaImpOk = False

                        Dim ObjRilievi As New AgronicaCoreContabDAL.Mov_Dettaglio_Tecnico_R
                        Dim dtRilievi As DataTable

                        'Ricerca di un rilievo fatto nel centro rispetta all'avversità e alla specie vegetale
                        dtRilievi = ObjRilievi.Leggi_RilieviTrappole(ListaImpianti.Item(i).Piva,
                                                                            ListaImpianti.Item(i).Sa_Cod,
                                                                            0,
                                                                            0,
                                                                            0,
                                                                            Soglia_AvCod,
                                                                            objParametriAgenda.Veg_Cod.Split("/")(0),
                                                                            ListaImpianti.Item(i).Validita_Inizio_Distinta,
                                                                            objParametriAgenda.Data,
                                                                            AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                            "",
                                                                            "",
                                                                            objParametri_Server)

                        Dim Qta_Rilievo As Integer = 0
                        Dim Qta_Media_Rilievo As Integer = 0

                        If dtRilievi.Rows.Count > 0 Then

                            Dim iRil As Integer
                            For iRil = 0 To dtRilievi.Rows.Count - 1
                                Qta_Rilievo = Qta_Rilievo + dtRilievi.Rows(iRil).Item("Qta_Ril")
                            Next iRil

                            Qta_Media_Rilievo = (Qta_Rilievo / dtRilievi.Rows.Count)

                            If Qta_Media_Rilievo < Soglia_Qta Then
                                nImpiantiViolati += 1
                                strErr_SogliaNonSoddisfatta &= " App." & ListaImpianti.Item(i).App_Nome & ", "
                            Else
                                'Soglia Soddisfatta --> Impianto Ok
                                SogliaImpOk = True
                            End If
                        Else
                            nImpiantiViolati += 1
                            strErr_SogliaNonSoddisfatta &= " App." & ListaImpianti.Item(i).App_Nome & ", "
                        End If

                        '(27/02/2019 fede) aggiunto controllo se è stato registrato il rilievo avv in campo della soglia necessaria
                        If Not SogliaImpOk Then

                            dtRilievi = ObjRilievi.Leggi_RilieviAvversita(ListaImpianti.Item(i).Piva,
                                                                            ListaImpianti.Item(i).Sa_Cod,
                                                                            ListaImpianti.Item(i).Appezza,
                                                                            ListaImpianti.Item(i).ID_Reg,
                                                                            Soglia_UdmCod,
                                                                            Soglia_AvCod,
                                                                            ListaImpianti.Item(i).Validita_Inizio_Distinta,
                                                                            objParametriAgenda.Data,
                                                                            AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                            "",
                                                                            "Mov_Destinazioni.Validita_Inizio Desc, Mov_Destinazioni.Qta Desc",
                                                                            objParametri_Server)

                            If dtRilievi.Rows.Count > 0 Then

                                'Gestione Presenza
                                If CDbl(Soglia_Qta) = 0 Then
                                    Soglia_Qta = 0.5 'Presenza
                                End If

                                If CDbl(dtRilievi.Rows(0).Item("Qta")) >= Soglia_Qta Then
                                    SogliaImpOk = True
                                    'Soglia Soddisfatta --> Impianto Ok
                                    nImpiantiViolati -= 1
                                    strErr_SogliaNonSoddisfatta = Replace(strErr_SogliaNonSoddisfatta, " App." & ListaImpianti.Item(i).App_Nome & ", ", "")
                                End If

                            End If

                        End If

                    Case LAVCOD_CATTURE_MASSA, LAVCOD_DISORIENTAMENTO_SESSUALE

                        Dim ObjRilievi As New AgronicaCoreContabDAL.Mov_Dettaglio_Tecnico_R
                        Dim dtRilievi As DataTable

                        dtRilievi = ObjRilievi.Leggi_ConfusioneDisorientamentoSessuale(ListaImpianti.Item(i).Piva,
                                                                            ListaImpianti.Item(i).Sa_Cod,
                                                                            ListaImpianti.Item(i).Appezza,
                                                                            ListaImpianti.Item(i).ID_Reg,
                                                                            Soglia_LavCod,
                                                                            Soglia_AvCod,
                                                                            ListaImpianti.Item(i).Validita_Inizio_Distinta,
                                                                            objParametriAgenda.Data,
                                                                            "",
                                                                            "Mov_Destinazioni.Validita_Inizio Desc, Mov_Destinazioni.Qta Desc",
                                                                            objParametri_Server)

                        If dtRilievi.Rows.Count > 0 Then
                            'Soglia Soddisfatta --> Impianto Ok
                        Else
                            nImpiantiViolati += 1
                            strErr_SogliaNonSoddisfatta &= " App." & ListaImpianti.Item(i).App_Nome & ", "
                        End If

                End Select

            Next

            If strErr_SogliaNonSoddisfatta <> "" Then
                SogliaSoddisfatta = False
                strErr_SogliaNonSoddisfatta = strErr_SogliaNonSoddisfatta.Replace("<b>", "").Replace("</b>", "")
                strVerificaSoglia &= Left(strErr_SogliaNonSoddisfatta, strErr_SogliaNonSoddisfatta.Length - 2)
            End If

        End If

        Return SogliaSoddisfatta

    End Function



    ''' <summary>
    ''' Controlla se è selezionato un FORMULATO
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Private Function ControllaSelezioneFormulato(ByRef FrCod As String,
                                                     ByRef FrDes As String,
                                                     ByRef Carenza As Integer, ByRef For_Veg_Cod As Integer,
                                                     ByRef strPA_Cod As String,
                                                     ByRef strPA_Cod_Pesi As String,
                                                     ByRef strCLTOSS_COD As String,
                                                     ByRef TipoRichiesto As Integer,
                                                     ByRef BufferMin As Decimal,
                                                     ByRef BufferMax As Decimal,
                                                     ByRef Lotto As String,
                                                     ByRef PrincipiAttiviPercAbb As String
                                                     ) As Boolean
        If Me.ComboFormulati.Testo_Combo = "" Then
            Messaggi.AgroMsgBox("Selezionare un formulato.", Page, , UpdatePanel_Prodotti)
            Return False
        Else

            Dim ArrayTmp() As String
            Dim ArrayTmpFrDes() As String
            ArrayTmp = Split(ComboFormulati.Valore_Combo, "£")
            ArrayTmpFrDes = Split(ComboFormulati.Testo_Combo, "---")

            If ArrayTmp IsNot Nothing Then
                FrCod = ArrayTmp(0)
                FrDes = ComboFormulati.Testo_Combo

                If ArrayTmp.Length > 3 Then
                    If ArrayTmp(3) <> "" Then
                        Carenza = ArrayTmp(3)
                    Else
                        Carenza = 0
                    End If
                End If


                If ArrayTmp.Length > 5 Then
                    If ArrayTmp(5) <> "" Then
                        For_Veg_Cod = ArrayTmp(5)
                    Else
                        For_Veg_Cod = 0
                    End If
                End If

                If ArrayTmp.Length > 7 Then
                    If ArrayTmp(7) <> "" Then
                        strPA_Cod = ArrayTmp(7)
                    Else
                        strPA_Cod = ""
                    End If
                End If

                If ArrayTmp.Length > 8 Then
                    If ArrayTmp(8) <> "" Then
                        strPA_Cod_Pesi = ArrayTmp(8)
                    Else
                        strPA_Cod_Pesi = ""
                    End If
                End If

                If ArrayTmp.Length > 9 Then
                    If ArrayTmp(9) <> "" Then
                        strCLTOSS_COD = ArrayTmp(9)
                    Else
                        strCLTOSS_COD = 0
                    End If
                End If

                If ArrayTmp.Length > 6 Then
                    If ArrayTmp(6) <> "" Then
                        TipoRichiesto = ArrayTmp(6)
                    Else
                        TipoRichiesto = 0
                    End If
                End If

                If ArrayTmp.Length > 10 Then
                    If ArrayTmp(10) <> "" Then
                        BufferMin = ArrayTmp(10)
                    End If
                End If
                If ArrayTmp.Length > 11 Then
                    If ArrayTmp(11) <> "" Then
                        BufferMax = ArrayTmp(11)
                    End If
                End If

                If ArrayTmp.Length > 13 Then
                    If ArrayTmp(13) <> "" Then
                        Lotto = ArrayTmp(13)
                    End If
                End If

                If objParametriAgenda.Disciplinare = NessunDpiNessunaEtichetta AndAlso ArrayTmp.Length > 17 Then
                    If ArrayTmp(17) <> "" Then
                        strPA_Cod = ArrayTmp(17)
                    End If
                End If

                If objParametriAgenda.Disciplinare = NessunDpiNessunaEtichetta AndAlso ArrayTmp.Length > 18 Then
                    If ArrayTmp(18) <> "" Then
                        strPA_Cod_Pesi = ArrayTmp(18)
                    End If
                End If

            End If

            If ArrayTmpFrDes IsNot Nothing Then
                FrDes = ArrayTmpFrDes(0)
            End If

            If Leggi_FlagNuovoControlloRiduzioneDiserbo() Then
                If Not IsNothing(HD_PrincipiAttiviPercAbb.Value) AndAlso Not String.IsNullOrEmpty(HD_PrincipiAttiviPercAbb.Value) Then
                    PrincipiAttiviPercAbb = HD_PrincipiAttiviPercAbb.Value
                End If
            End If

        End If

        Return True

    End Function

    Private Function ControllaPeriodoDivieto(ByRef MessaggioErrore As String, ByVal Regolamento_Cod As Integer) As Boolean

        If Me.ComboFertilizzanti.Testo_Combo = "" Then
            Messaggi.AgroMsgBox("Selezionare un fertilizzante.", Page, , UpdatePanel_Prodotti)
            Return False
        Else

            Dim EffCod As Integer = 0
            If Split(ComboFertilizzanti.Valore_Combo, "$").Length > 5 Then
                EffCod = Split(ComboFertilizzanti.Valore_Combo, "$")(6)
            End If

            'Dim objEff As New AgronicaCorePUA_DAL.Pua_Effluente_R
            'Dim DtEffluenti As DataTable = objEff.Leggi(Regolamento_Cod, Qs_Pua_Cod, EffCod, "", "", objParametri_Server)
            Dim objEffDiv As New AgronicaCorePUA_DAL.Pua_Effluente_PeriodoDivieto_R
            Dim DtEffluentiDiv As DataTable = objEffDiv.Leggi_DaEffluente(Regolamento_Cod, Qs_Pua_Cod, 0, 0, EffCod, "", "", objParametri_Server)

            Dim Data_Inizio_Divieto As Date = AGRODATAINIZIO
            Dim Data_Fine_Divieto As Date = AGRODATAFINE

            If DtEffluentiDiv IsNot Nothing AndAlso DtEffluentiDiv.Rows.Count > 0 Then

                For i = 0 To DtEffluentiDiv.Rows.Count - 1

                    If Not IsDBNull(DtEffluentiDiv.Rows(i).Item("Data_Divieto_DA")) Then
                        Data_Inizio_Divieto = DtEffluentiDiv.Rows(i).Item("Data_Divieto_DA")
                    End If
                    If Not IsDBNull(DtEffluentiDiv.Rows(i).Item("Data_Divieto_A")) Then
                        Data_Fine_Divieto = DtEffluentiDiv.Rows(i).Item("Data_Divieto_A")
                    End If

                    If Data_Inizio_Divieto <> AGRODATAINIZIO AndAlso objParametriAgenda.Data >= Data_Inizio_Divieto AndAlso
                            Data_Fine_Divieto <> AGRODATAFINE AndAlso objParametriAgenda.Data <= Data_Fine_Divieto Then
                        MessaggioErrore = "Periodo Divieto (" & Data_Inizio_Divieto.ToShortDateString & " - " & Data_Fine_Divieto.ToShortDateString & ") NON rispettato!"
                        Return False
                    End If

                Next

            End If

        End If

        Return True

    End Function

    Private Function ControllaCarenza(ByRef MessaggioErrore As String, ByRef DataMinima As Date, ByRef Carenza As Integer) As Boolean

        If Me.ComboFormulati.Testo_Combo = "" Then
            Messaggi.AgroMsgBox("Selezionare un formulato.", Page, , UpdatePanel_Prodotti)
            Return False
        Else

            Dim ArrayTmp() As String
            ArrayTmp = Split(ComboFormulati.Valore_Combo, "£")

            If ArrayTmp IsNot Nothing Then

                If ArrayTmp.Length > 3 Then
                    If ArrayTmp(3) <> "" Then
                        Carenza = ArrayTmp(3)
                    Else
                        Carenza = 0
                    End If
                End If

            End If

        End If

        'Verifico la Carenza
        If Carenza > 0 Then
            If Session("Blocca_Carenza") = True And objParametriAgenda.Disciplinare <> NessunDpiNessunaEtichetta Then
                'If Session("Blocca_Carenza") = True And ComboFiltriAggiuntiviAgenda1.ddl_FiltriAggiuntivi.SelectedValue <> "0" Then
                Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
                ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()
                DataMinima = AGRODATAFINE
                For i = 0 To ListaImpianti.Count - 1
                    If ListaImpianti(i).Data_Raccolta <> New Date Then
                        If DataMinima > ListaImpianti(i).Data_Raccolta AndAlso
                                    ListaImpianti(i).Data_Raccolta_Prevista >= objParametriAgenda.Data Then
                            DataMinima = ListaImpianti(i).Data_Raccolta
                        End If
                    Else
                        If ListaImpianti(i).Data_Raccolta_Prevista <> New Date Then
                            If DataMinima > ListaImpianti(i).Data_Raccolta_Prevista AndAlso
                                    ListaImpianti(i).Data_Raccolta_Prevista >= objParametriAgenda.Data Then
                                DataMinima = ListaImpianti(i).Data_Raccolta_Prevista
                            End If
                        End If
                    End If
                Next

                Dim DataMinimaRaccolta As Date
                DataMinimaRaccolta = objParametriAgenda.Data
                DataMinimaRaccolta = DataMinimaRaccolta.AddDays(CInt(Carenza + 1))
                'controllo che la data della registrazione non sia posteriore di quella della prima raccolta
                If DataMinima >= objParametriAgenda.Data Then
                    If DataMinimaRaccolta > DataMinima Then
                        MessaggioErrore = String.Format(Resources.AgronicaAgenda_2010.LaDataDiRaccoltaDiUnoDegliAppezzamentiNonÈ, DataMinima, Carenza)
                        Return False
                    End If
                End If
            End If

        End If

        Return True

    End Function

    ''' <summary>
    '''  Avversita
    ''' </summary>
    ''' <param name="Av_Cod"></param>
    ''' <param name="Av_Gru"></param>
    ''' <param name="Av_Des"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    ''' 
    Private Function ControllaBloccoFioritura(ByRef MessaggioErrore As String) As Boolean

        Dim strEpocheFioritura As String = ""

        If Me.ComboFormulati.Testo_Combo = "" Then
            Messaggi.AgroMsgBox("Selezionare un formulato.", Page, , UpdatePanel_Prodotti)
            Return False
        Else
            Dim ArrayTmp() As String
            ArrayTmp = Split(ComboFormulati.Valore_Combo, "£")
            If ArrayTmp IsNot Nothing Then
                If ArrayTmp.Length > 12 Then
                    If ArrayTmp(12) <> "" Then
                        strEpocheFioritura = ArrayTmp(12)
                    End If
                End If
            End If
        End If


        If strEpocheFioritura <> "" AndAlso Session("Blocca_Fioritura") = True Then

            Dim Intervalli() As String = strEpocheFioritura.Split("|")

            If Intervalli IsNot Nothing Then

                '(12/11/2018 fede) aggiunta indicazione fase fenologica corrente
                Dim objParametriUscitaFasiNew As AgronicaCoreMetaSchemaBIZ.FasiFenologiche_output
                Dim objParametriUscitaFasiOld As AgronicaCoreMetaSchemaBIZ.FasiFenologiche_output
                If IsNumeric(objParametriAgenda.Veg_Cod.Split("/")(0)) AndAlso CInt(objParametriAgenda.Veg_Cod.Split("/")(0)) > 0 Then
                    Dim objParametriIngresso As New AgronicaCoreMetaSchemaBIZ.FasiFenologiche_input
                    objParametriIngresso.Veg_Cod = CInt(objParametriAgenda.Veg_Cod.Split("/")(0))
                    Dim Leggi_impostazioni As New AgronicaCoreUtentiDAL.Utenti_Impostazioni_Read
                    Dim imp As String = Leggi_impostazioni.ImpostazioneValore1_from_ImpostazioneCod(enum_Impostazioni_Utenti.SUPERUSER_COD_PERSON_RILIEVO_FASI_FENOLOGICHE, objParametri_Utenti, 2)
                    If imp = "1" Then
                        objParametriIngresso.Personalizzate = True
                    End If
                    Dim objFasi_WS As New AgronicaCoreWebService.FasiFenologiche_WS
                    objParametriUscitaFasiNew = objFasi_WS.FasiFenologiche(objParametriIngresso)
                    objParametriUscitaFasiOld = objFasi_WS.FasiFenologiche_OLD(objParametriIngresso)
                End If

                For Inter = 0 To Intervalli.Length - 1

                    Dim Epoca_DA As Integer = 0
                    Dim Stadio_Da As String = ""
                    Dim Epoca_A As Integer = 0
                    Dim Stadio_A As String = ""

                    If IsNumeric(Split(Intervalli(Inter), "_")(0)) Then
                        Epoca_DA = CInt(Split(Intervalli(Inter), "_")(0))
                    End If
                    If Split(Intervalli(Inter), "_")(1) Then
                        Stadio_Da = CInt(Split(Intervalli(Inter), "_")(1))
                    End If
                    If IsNumeric(Split(Intervalli(Inter), "_")(2)) Then
                        Epoca_A = CInt(Split(Intervalli(Inter), "_")(2))
                    End If
                    If Split(Intervalli(Inter), "_")(3) Then
                        Stadio_A = CInt(Split(Intervalli(Inter), "_")(3))
                    End If
                    'EpocheBlocco &= dr_blocchi("epoca_da") & "_" & dr_blocchi("cod_ss_da") & dr_blocchi("stadio_da") & "_" & dr_blocchi("progressivo_da") &
                    '                dr_blocchi("epoca_a") & "_" & dr_blocchi("cod_ss_a") & dr_blocchi("stadio_a") & "_" & dr_blocchi("progressivo_a") & "|"


                    Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
                    ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()
                    Dim Fase_Cod_Corrente As Integer = 0
                    Dim StadioBbch_Corrente As String
                    For i = 0 To ListaImpianti.Count - 1
                        Dim objDest As New AgronicaCoreContabDAL.Mov_Destinazioni_R
                        Dim Dt As New DataTable
                        Dt = objDest.Leggi_UltimaFaseFenologicaImpianti_InData(ListaImpianti(i).Piva, ListaImpianti(i).Sa_Cod, ListaImpianti(i).Appezza, ListaImpianti(i).ID_Reg, objParametriAgenda.Data, "", "", objParametri_Server)
                        If Dt IsNot Nothing Then
                            Fase_Cod_Corrente = Dt.Rows(0).Item("FF_Classe")
                            Select Case Fase_Cod_Corrente
                                Case < 1000 'caso vecchio
                                    'StadioBbch_Corrente = (From aa In objParametriUscitaFasiOld.ListaFasiFenologiche
                                    '                       Where aa.FF_Cod = Fase_Cod_Corrente
                                    '                       Select aa.Descrizione
                                    '        ).FirstOrDefault
                                Case Else 'caso nuovo 
                                    StadioBbch_Corrente = (From aa In objParametriUscitaFasiNew.ListaFasiFenologiche
                                                           Where aa.Cod_SS = Fase_Cod_Corrente
                                                           Select aa.Stadio
                                                ).FirstOrDefault
                            End Select
                        End If

                        'blocco da .....
                        If Epoca_DA <> 0 AndAlso Epoca_A = 0 Then
                            If Stadio_Da < StadioBbch_Corrente Then
                                MessaggioErrore = "Blocco Fioritura non rispettato."
                                Return False
                            End If


                            'blocco fino a .................
                        ElseIf Epoca_DA = 0 AndAlso Epoca_A <> 0 Then
                            If Stadio_A > StadioBbch_Corrente Then
                                MessaggioErrore = "Blocco Fioritura non rispettato."
                                Return False
                            End If


                            'blocco all'interno
                        ElseIf Epoca_DA <> 0 AndAlso Epoca_A <> 0 Then

                            If Stadio_A > StadioBbch_Corrente OrElse Stadio_Da < StadioBbch_Corrente Then
                                MessaggioErrore = "Blocco Fioritura non rispettato."
                                Return False
                            End If


                        End If

                    Next

                Next
            End If

        End If

        Return True

    End Function

