    Private Function ControllaBuffer(ByRef MessaggioErrore As String, ByRef BufferMin As Decimal, ByRef BufferMax As Decimal) As Boolean

        If Me.ComboFormulati.Testo_Combo = "" Then
            Messaggi.AgroMsgBox("Selezionare un formulato.", Page, , UpdatePanel_Prodotti)
            Return False
        Else

            Dim ArrayTmp() As String
            ArrayTmp = Split(ComboFormulati.Valore_Combo, "£")

            If ArrayTmp IsNot Nothing Then

                If ArrayTmp.Length > 10 Then
                    If ArrayTmp(10) <> "" Then
                        BufferMin = ArrayTmp(10)
                    End If
                End If
                If ArrayTmp.Length > 11 Then
                    If ArrayTmp(11) <> "" Then
                        BufferMax = ArrayTmp(11)
                    End If
                End If

            End If

        End If


        If BufferMin <> 0 OrElse BufferMax <> 0 Then

            If Session("Blocca_BufferZone") = True Then

                Dim buffer_da_controllare As Decimal
                Dim distanzaprimapianta As Decimal
                Dim lunghezza As Decimal
                Dim perc_mitig As Decimal
                Dim sup_rid As Decimal
                Dim sup_massima_trattabile As Decimal

                'If BufferMin <> 0 And BufferMax = 0 Then
                '    buffer_da_controllare = BufferMin
                'Else
                '    buffer_da_controllare = BufferMax
                'End If
                buffer_da_controllare = BufferMin

                Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
                ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()

                For i = 0 To ListaImpianti.Count - 1

                    lunghezza = ListaImpianti(i).DistBZ_CorpiIdrici + ListaImpianti(i).DistBZ_AreeResPub + ListaImpianti(i).DistBZ_Allevamenti + ListaImpianti(i).DistBZ_VegNatNonColt

                    If lunghezza > 0 Then

                        distanzaprimapianta = CDec(ListaImpianti(i).SupBZ_Riduzione) 'capezzagna
                        perc_mitig = CDec(ListaImpianti(i).Perc_Riduzione_Deriva)

                        buffer_da_controllare = (buffer_da_controllare - distanzaprimapianta) - ((buffer_da_controllare - distanzaprimapianta) * perc_mitig / 100)

                        If (lunghezza * buffer_da_controllare / 10000) < 0 Then
                            sup_rid = 0
                        Else
                            sup_rid = lunghezza * buffer_da_controllare / 10000
                        End If

                        sup_massima_trattabile = Agro_Math.ArrotondaVal_4(ListaImpianti(i).Sup_Imp - sup_rid)
                        'sup_massima_trattabile = ListaImpianti(i).Sup_Imp - Agro_Math.ArrotondaVal_4(sup_rid)

                        'If ListaImpianti(i).Qta2 >= ListaImpianti(i).Sup_Imp Then
                        If sup_massima_trattabile > 0 AndAlso CDec(ListaImpianti(i).Qta2) > sup_massima_trattabile Then
                            If BufferMin <> 0 AndAlso BufferMax = 0 Then
                                MessaggioErrore = "Buffer Zone (" & BufferMin & " m) non rispettata. Ridurre la superficie trattata."
                            Else
                                MessaggioErrore = "Buffer Zone (" & BufferMin & " - " & BufferMax & " m) non rispettata. Ridurre la superficie trattata."
                            End If
                            Return False
                        End If
                    End If
                Next
            End If

        End If

        Return True

    End Function

    Private Function ControllaSelezioneAvversita(ByVal TipoRichiesto As Integer, ByRef Av_Cod As String, ByRef Av_Gru As String, ByRef Av_Des As String,
                                                     ByRef Soglia_Value As String, ByRef Soglia_Des As String) As Boolean

        Select Case TipoRichiesto

            Case enum_TipoFormulato.Coadiuvanti
                Av_Cod = "-1"
                Av_Gru = "-1"
                Av_Des = ""
                Soglia_Value = ""
                Soglia_Des = ""

            Case enum_TipoFormulato.Corroboranti_Fisiofarmaci
                Av_Cod = "-2"
                Av_Gru = "-2"
                Av_Des = ""
                Soglia_Value = ""
                Soglia_Des = ""

            Case enum_TipoFormulato.Fitoregolatori, enum_TipoFormulato.Disseccanti
                Av_Cod = "-3"
                Av_Gru = "-3"
                Av_Des = ""
                Soglia_Value = ""
                Soglia_Des = ""

            Case Else
                Av_Cod = "0"
                Av_Gru = "0"
                Av_Des = ""
                Soglia_Value = ""
                Soglia_Des = ""

                If ddl_avversita.SelectedValue <> "" Then
                    If Split(ddl_avversita.SelectedValue, "|")(0) <> "0" Then
                        Av_Cod = Split(ddl_avversita.SelectedValue, "|")(0)
                        Av_Des = ddl_avversita.SelectedItem.Text
                        If ddl_soglieAvversita.Visible Then
                            Soglia_Value = ddl_soglieAvversita.SelectedValue
                            Soglia_Des = ddl_soglieAvversita.SelectedItem.Text
                        End If
                    Else
                        Av_Gru = Split(ddl_avversita.SelectedValue, "|")(1)
                        Av_Des = ddl_avversita.SelectedItem.Text
                    End If
                End If

                If Av_Des = "" Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.ENecessarioSelezionareUnAvversità, Page, , UpdatePanel_Prodotti)
                    Return False
                End If

        End Select

        Return True

    End Function


    ''' <summary>
    ''' UNITA' di MISURA
    ''' </summary>
    ''' <param name="UdmCod"></param>
    ''' <param name="UdmDesSimbolo"></param>
    ''' <param name="UdmDes"></param>
    ''' <param name="UdmCodTrasformato"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Private Function ControllaSelezioneUnitadiMisura(FrCod As String, ByRef UdmCod As Integer, ByRef UdmDesSimbolo As String, ByRef UdmDes As String, ByRef UdmCodTrasformato As Integer, ByRef Ha_Hl As Integer, ByRef Dose_QtaTot As Integer) As Boolean
        If Me.Cmb_UdM.SelectedItem.Text = "" Then
            Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.SelezionareUnUnitaDiMisura, Page, , UpdatePanel_Prodotti)
            Return False
        Else

            Dim Dt_Dosi As DataTable = Session("vs_dtDosi")
            If Dt_Dosi IsNot Nothing AndAlso Dt_Dosi.Rows.Count > 0 Then
                For i = 0 To Dt_Dosi.Rows.Count - 1
                    If Dt_Dosi.Rows(i).Item("fr_cod") = FrCod Then
                        If Not UdmCompatibili(Dt_Dosi.Rows(i).Item("udm_cod"), Cmb_UdM.SelectedItem.Value) Then
                            Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.SelezionareUnitaDiMisuraCompatibili, Page, , UpdatePanel_Prodotti)
                            Return False
                        End If
                    End If
                Next
            End If

            Dim udmArea As String = AgronicaCoreMetaSchemaDAL.UDM_Helper.GetUdmSim_AREA(objParametri_Server, objParametri_Utenti)

            UdmCod = Cmb_UdM.SelectedItem.Value
            UdmDesSimbolo = Cmb_UdM.SelectedItem.Text

            If Me.rbl_DoseHL.Checked Then
                UdmDes = "[" & UdmDesSimbolo & "/hl]" 'todo, litri ettolitri, ecc..
                Ha_Hl = enum_TipoMezzo.Ettolitro
            Else
                UdmDes = "[" & UdmDesSimbolo & "/" & udmArea & "]"
                Ha_Hl = enum_TipoMezzo.Ettaro
            End If

            If rbl_QtaDose.Checked Then
                Dose_QtaTot = enum_TipoModalitaDistribuzione.Dose
            Else
                Dose_QtaTot = enum_TipoModalitaDistribuzione.Totale
            End If

            Select Case UdmCod
                Case enum_UnitaMisura.Grammi
                    UdmCodTrasformato = 2
                Case enum_UnitaMisura.Quintali
                    UdmCodTrasformato = 2
                Case enum_UnitaMisura.Tonnellate
                    UdmCodTrasformato = 2
                Case enum_UnitaMisura.Milligrammi
                    UdmCodTrasformato = 2

                Case enum_UnitaMisura.Millilitri
                    UdmCodTrasformato = 29
                Case enum_UnitaMisura.CentimetriCubi  'cc
                    UdmCodTrasformato = 29
                Case enum_UnitaMisura.Metri_Cubi  'metri cubi
                    UdmCodTrasformato = 29

                Case enum_UnitaMisura.KG, enum_UnitaMisura.Litri
                    UdmCodTrasformato = UdmCod

                Case enum_UnitaMisura.Unita_Seme, enum_UnitaMisura.Num_Piante, enum_UnitaMisura.Confezioni
                    UdmCodTrasformato = UdmCod
            End Select

        End If


        Return True
    End Function

