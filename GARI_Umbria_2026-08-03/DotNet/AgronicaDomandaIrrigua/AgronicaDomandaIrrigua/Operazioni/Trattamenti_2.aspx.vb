    Private Function Get_TaraturaUgello() As Double

        Dim dtScarico As DataTable

        If Session("dtScarico") IsNot Nothing Then
            dtScarico = Session("dtScarico")

            For Each row In dtScarico.Rows

                Dim risorsa_cod = row("Risorsa_Cod").ToString.Split("*")

                'Macchina
                If risorsa_cod(1) = "1" Then
                    Dim Mac_Cod = CInt(risorsa_cod(3))
                    Dim objMacchine As New AgronicaCoreContabDAL.Parco_Macchine_R
                    Dim dt = objMacchine.Leggi("",
                                      Mac_Cod, False, "", "", "", "", "", 0, "",
                                      False, 0, "", True,
                                      AGRODATAINIZIO, AGRODATAFINE,
                                      " Taratura_Ugello IS NOT NULL AND Taratura_Ugello > 0 ",
                                      "", objParametri_Server)

                    If dt.Rows.Count > 0 AndAlso
                        Not IsDBNull(dt.Rows(0)("Taratura_Ugello")) AndAlso
                        dt.Rows(0)("Taratura_Ugello") > 0 Then

                        Return CDbl(dt.Rows(0)("Taratura_Ugello"))



                    End If

                End If

            Next

        End If

    End Function

    Private Sub Btn_MovContabili_Click(sender As Object, e As EventArgs) Handles Btn_MovContabili.Click

        Dim strRes = hfRigheMovContabili.Value

        If strRes <> "" Then
            Dim arrContabili = JArray.Parse(strRes)

            If IsSemina Then

                Dim FrCod As String = ""
                Dim FrDes As String = ""
                Dim Carenza As Integer = -1
                Dim BufferMin As Decimal = 0
                Dim BufferMax As Decimal = 0

                Dim Dose_Tot As Decimal
                Dim UdmCod As Integer = 0
                Dim UdmCodTrasformato As Integer = 0
                Dim UdmDes As String = ""
                Dim Ha_Hl As Integer = 1
                Dim Dose_QtaTot As Integer = 0

                Dim Av_Cod As String = ""
                Dim Av_Gru As String = ""
                Dim Av_Des As String = ""

                Dim Dose_Etichetta_Max As String = ""

                Dim Soglia_Value As String = ""
                Dim Soglia_Des As String = ""

                Dim strPA_COD As String = ""
                Dim strPA_COD_Pesi As String = ""
                Dim strCLTOSS_COD As String = ""


                Dim N As String = ""
                Dim N_Utile As String = ""
                Dim P As String = ""
                Dim K As String = ""
                Dim M As String = ""
                Dim Cu As String = ""
                Dim Efficienza As String = ""

                Dim Lotto As String = ""

                Dim Cod_Articolo As String = ""
                Dim Mat_Regolamento As Integer = 0
                Dim Mat_Veg_Cod As Integer = 0
                Dim Mat_Cul_Cod As Integer = 0

                Dim Piva_Rif As String = ""
                Dim Sa_Cod_Rif As String = ""
                Dim Id_Agenda_Rif As String = ""
                Dim Id_Mov_Rif As String = ""
                Dim Id_Mov_Det_Rif As String = ""
                Dim Lav_Cod_Rif As String = ""
                Dim Cau_Mov_Rif As String = ""
                Dim Des_Rif As String = ""
                Dim Qta_Rif As String = ""

                Dim Prima_Data As String = ""
                Dim DosaggiControllati As String = ""
                Dim DosaggiControllatiValue As String = ""
                Dim Limite As Integer = 0
                Dim Limite_Udm_Cod As Integer = 0
                Dim Limite_Sim As String = ""
                Dim IntervalloTrattamenti_Min As Integer = 0
                Dim IntervalloTrattamenti_Max As Integer = 0

                Dim objMateriePrime As New AgronicaCoreAnagrafeDAL.Materie_Prime_R

                For Each ElemSel In arrContabili

                    If CBool(ElemSel("Selected").ToString) = True AndAlso CInt(ElemSel("Elem_Cod").ToString) = 10 Then

                        Piva_Rif = ElemSel("PIVA").ToString
                        Sa_Cod_Rif = ElemSel("Sa_Cod").ToString
                        Id_Agenda_Rif = ElemSel("Id_Agenda").ToString
                        Id_Mov_Det_Rif = ElemSel("Id_Mov_Det").ToString
                        Id_Mov_Rif = ElemSel("id_mov").ToString

                        Des_Rif = ElemSel("Des_Lib").ToString
                        Lav_Cod_Rif = ElemSel("Lav_Cod").ToString
                        Cau_Mov_Rif = ElemSel("cau_mov").ToString

                        UdmCod = ElemSel("Unita_Misura").ToString
                        UdmCodTrasformato = ElemSel("Unita_Misura").ToString
                        UdmDes = ElemSel("Unita_Misura_Des").ToString
                        FrCod = ElemSel("Mat_Cod").ToString
                        FrDes = "Gino"

                        If IsNumeric(ElemSel("Qta_Residua").ToString) Then
                            Qta_Rif = ElemSel("Qta_Residua").ToString
                        Else
                            Qta_Rif = ElemSel("Qta").ToString
                        End If
                        Lotto = ElemSel("Lotto").ToString


                        'Qta_Rif = CalcolaQtaDistribuita_Dettaglio_Contabile(FrCod,
                        '                                          Lotto,
                        '                                          Piva_Rif,
                        '                                          Id_Agenda_Rif,
                        '                                          Id_Mov_Rif,
                        '                                          Id_Mov_Det_Rif)

                        Dim Dose_Totale As Decimal = Qta_Rif
                        Dim Dose_HL As Decimal = Qta_Rif
                        Dim Dose_HA_Reale As Decimal = CDbl(Dose_Totale / Txt_SupTrattata.Value)
                        Dim Dose_HA As Decimal = Math.Round(Dose_HA_Reale, 4)

                        Dose_Tot = Dose_Totale
                        Dose_QtaTot = Dose_Totale

                        FrDes = ElemSel("Mat_Des").ToString
                        Cod_Articolo = ElemSel("Cod_Articolo").ToString
                        Mat_Veg_Cod = ElemSel("Veg_Cod").ToString
                        Mat_Cul_Cod = ElemSel("Cul_Cod").ToString

                        Dim dtMat = objMateriePrime.Leggi("", 0, 0, FrCod, "", 0, 0, 0, 0, 0, 0, 0, "", 0, "", True, False, "", enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)

                        If dtMat.Rows.Count > 0 Then
                            Mat_Regolamento = dtMat.Rows(0)("Regolamento")
                        End If


                        If Qta_Rif <> 0 Then

                            Call Dosi_Inserisci(objParametriAgenda.Fabbricato,
                                            FrCod,
                                            FrDes,
                                            Dose_Totale,
                                            Dose_HA,
                                            Dose_HL,
                                            Dose_Tot, UdmCod, UdmDes, UdmCodTrasformato,
                                            "", Carenza.ToString, Prima_Data,
                                            Av_Cod, Av_Gru, Av_Des,
                                            DosaggiControllati, Dose_Etichetta_Max,
                                            Limite, Limite_Sim, Limite_Udm_Cod,
                                            Soglia_Value, Soglia_Des, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max,
                                            strPA_COD, strPA_COD_Pesi, BufferMin, BufferMax, strCLTOSS_COD,
                                            DosaggiControllatiValue,
                                            Efficienza, N, N_Utile, P, K, M, Cu,
                                            CStr(Dose_HA_Reale).Replace(".", Stringhe.SeparatoreDecimale),'Hidden_Dose_Ha_Reale.Value.Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale),
                                            CStr(Dose_HL).Replace(".", Stringhe.SeparatoreDecimale), 'Hidden_Dose_Hl_Reale.Value.Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale),
                                            CStr(Dose_Tot).Replace(".", Stringhe.SeparatoreDecimale), 'Hidden_Dose_Tot_Reale.Value.Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale),
                                            Ha_Hl, Dose_QtaTot, Lotto, Cod_Articolo, Mat_Regolamento, Mat_Veg_Cod, Mat_Cul_Cod, 0,
                                            Piva_Rif, Sa_Cod_Rif, Id_Agenda_Rif, Id_Mov_Rif, Id_Mov_Det_Rif, Lav_Cod_Rif, Cau_Mov_Rif, Des_Rif, Qta_Rif, "")

                        End If


                    End If

                Next

                Griglia_Dosi_Data_Bind()

            End If

        End If

    End Sub
End Class