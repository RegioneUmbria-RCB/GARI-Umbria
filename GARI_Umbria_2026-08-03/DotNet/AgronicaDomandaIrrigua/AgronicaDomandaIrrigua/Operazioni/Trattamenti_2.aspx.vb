                        Case Else

                            If objParametriAgenda.FiltroRicerca <> "2" Then
                                Carica_Avversita(FrCod, FormulatiXAllegatiNormative_IDRiga)
                                LeggiDosi = False
                            Else
                                LeggiDosi = True
                            End If

                    End Select

            End Select

            If LeggiDosi Then

                If objParametriAgenda.Veg_Cod <> 0 AndAlso FrCod <> 0 AndAlso objParametriAgenda.Disciplinare <> NessunDpiNessunaEtichetta Then

                    Dim DoseTrovata As Boolean = False
                    Dim ArrayDose() As String

                    Dim Av_Cod As Integer = 0
                    Dim Av_Gru As Integer = 0

                    Select Case TipoRichiesto

                        Case enum_TipoFormulato.Coadiuvanti
                            Av_Cod = "-1"
                            Av_Gru = "-1"

                        Case enum_TipoFormulato.Corroboranti_Fisiofarmaci
                            Av_Cod = "-2"
                            Av_Gru = "-2"

                        Case enum_TipoFormulato.Fitoregolatori, enum_TipoFormulato.Disseccanti
                            Av_Cod = "-3"
                            Av_Gru = "-3"


                        Case Else
                            If ddl_avversita.SelectedValue = "" Then
                                Exit Sub
                            Else
                                If Split(ddl_avversita.SelectedValue, "|")(0) <> "0" Then
                                    Av_Cod = Split(ddl_avversita.SelectedValue, "|")(0)
                                Else
                                    Av_Gru = Split(ddl_avversita.SelectedValue, "|")(1)
                                End If
                                If Split(ddl_avversita.SelectedValue, "|").Length > 2 Then
                                    FormulatiXAllegatiNormative_IDRiga = Split(ddl_avversita.SelectedValue, "|")(3)
                                End If
                            End If
                    End Select

                    Dim grfi_cod As Integer = 0
                    grfi_cod = IdentificaGrfi_Cod()
                    If grfi_cod = -999 Then
                        Dim strJSs As New StringBuilder
                        strJSs.AppendLine("$(document).ready(function () { ")
                        strJSs.AppendLine("      alert('Selezionare gli impianti'); ")
                        strJSs.AppendLine(" });")
                        ScriptManager.RegisterClientScriptBlock(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType(),
                                          String.Format("jQuery_{0}", UpdatePanel_Prodotti.ClientID), strJSs.ToString, True)
                        Exit Sub
                    End If

                    '(11/01/2018 fede) aggiunto filtro copertura
                    Dim Copertura As String
                    Copertura = IdentificaCopertura()

                    If Copertura = "-999" Then
                        Dim strJSs As New StringBuilder
                        strJSs.AppendLine("$(document).ready(function () { ")
                        strJSs.AppendLine("      alert('Selezionare gli impianti'); ")
                        strJSs.AppendLine(" });")
                        ScriptManager.RegisterClientScriptBlock(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType(),
                                          String.Format("jQuery_{0}", UpdatePanel_Prodotti.ClientID), strJSs.ToString, True)
                        Exit Sub
                    End If

                    ComboEtichetta.Lav_Cod = objParametriAgenda.Lav_Cod
                    ComboEtichetta.Fr_Cod = FrCod
                    ComboEtichetta.Veg_Cod = Veg_Cod
                    ComboEtichetta.Av_Cod = Av_Cod
                    ComboEtichetta.Av_Gru = Av_Gru
                    ComboEtichetta.Grfi_Cod = grfi_cod
                    ComboEtichetta.WS_Fitofarmaci_AgroWS_Fitofarmaci = objParametriAgenda.WS_Fitofarmaci_AgroWS_Fitofarmaci
                    ComboEtichetta.Data = objParametriAgenda.Data

                    ComboEtichetta.FormulatiXAllegatiNormative_IDRiga = FormulatiXAllegatiNormative_IDRiga

                    ComboEtichetta.Copertura = Copertura
                    ComboEtichetta.TipoRichiesto = TipoRichiesto
                    ComboEtichetta.CaricaComboEtichetta()

                    Select Case objParametriAgenda.Lav_Cod
                        Case LAVCOD_DISERBO, LAVCOD_DISSECCAMENTO
                            If CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Valore_Combo <> "0" Then
                                If objParametriAgenda.Fabbricato.Split("|").Length > 1 Then
                                    Dim splitArr = objParametriAgenda.Fabbricato.Split("|")
                                    Imposta_DoseConsentitaDiserbo(FrCod, splitArr(2), splitArr(1), splitArr(0))
                                Else
                                    Imposta_DoseConsentitaDiserbo(FrCod, objParametriAgenda.Piva, 0, 0)
                                End If
                            End If
                    End Select

                    'controllo se ho una unità di misura da magazzino
                    Dim Udm_Da_Magazzino As Integer

                    If ArrayTmp.Length > 16 AndAlso IsNumeric(ArrayTmp(16)) AndAlso CInt(ArrayTmp(16)) <> 0 Then
                        Udm_Da_Magazzino = ArrayTmp(16)
                    Else
                        Udm_Da_Magazzino = -99
                    End If


                    If ComboEtichetta.ddl_Dosi.Items.Count > 0 Then

                        If ComboEtichetta.Valore_Combo <> "0" Then

                            ArrayDose = Split(ComboEtichetta.Valore_Combo, "$")

                            If ArrayDose IsNot Nothing AndAlso ArrayDose.Length > 1 Then

                                DoseTrovata = True

                                '----
                                'Acqua
                                AcquaMin = ArrayDose(5)
                                AcquaMax = ArrayDose(6)
                                AcquaUdm_Cod = ArrayDose(7)
                                Imposta_VolumiAcqua(AcquaMin, AcquaMax, AcquaUdm_Cod)

                                Udm_Cod = ArrayDose(3)

                                Dim Udm_Radice, per_ha_hl As Integer
                                Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
                                objUdm.ScomponiUdm(Udm_Radice, per_ha_hl, CInt(Udm_Cod))
                                If Udm_Da_Magazzino <> -99 Then
                                    Dim v As Integer
                                    Select Case Udm_Radice
                                        Case 3, 2032, 2, 304, 4
                                            v = 2
                                        'acqua
                                        Case 104, 101, 29
                                            v = 29
                                    End Select
                                    If Udm_Da_Magazzino = v Then
                                        Imposta_DosiEtichetta(ComboEtichetta.Valore_Combo)
                                    End If
                                Else
                                    Imposta_DosiEtichetta(ComboEtichetta.Valore_Combo)
                                End If

                            End If

                            'dosi multiple
                            Dim kg As Boolean = False
                            Dim l As Boolean = False
                            If ComboEtichetta.ddl_Dosi.Items.Count > 1 Then

                                If ArrayTmp.Length > 16 AndAlso ArrayTmp(16) <> "" Then
                                    'If Not IsNothing(Giacenze) AndAlso Giacenze.Keys.Count = 1 Then
                                    'carico solo le udm indicate da magazzino
                                Else
                                    For i = 0 To ComboEtichetta.ddl_Dosi.Items.Count - 1

                                        Udm_Cod = Split(ComboEtichetta.ddl_Dosi.Items(i).Value, "$")(3)

                                        'controllo se è sempre lo stesso
                                        Dim Udm_Radice, per_ha_hl As Integer
                                        Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
                                        objUdm.ScomponiUdm(Udm_Radice, per_ha_hl, CInt(Udm_Cod))

                                        Select Case Udm_Radice
                                            Case 3, 2032, 2, 304, 4
                                                kg = True
                                            'acqua
                                            Case 104, 101, 29
                                                l = True
                                        End Select
                                    Next

                                    If kg AndAlso l Then
                                        'preseleziono il valore precedente
                                        Dim valSel As Integer = Cmb_UdM.SelectedValue
                                        Cmb_UdM.Items.Clear()
                                        'ricarico con tutte le unita di misura
                                        CaricaKGeLitri(valSel)
                                    End If
                                End If

                            End If


                        End If

                    End If


                    If Not DoseTrovata Then

                        DoseMin = 0
                        DoseMax = 0
                        Udm_Cod = 0
                        Dim objDPILeggi As New AgronicaCoreDpiBIZ.Fitofarmaci_Leggi
                        objDPILeggi.Recupera_UdM_da_FrCod(Nothing,
                                                    FrCod,
                                                    Udm_Cod,
                                                    Nothing,
                                                    Nothing,
                                                    Session)

                        Select Case Udm_Cod
                            Case 2
                                CaricaKG(Udm_Cod)
                            Case 29
                                CaricaLitri(Udm_Cod)
                        End Select
                    End If

                    If Not statoEspansione Then
                        ScriptManager.RegisterStartupScript(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType(),
                                                              String.Format("jQuery_{0}", ComboEtichetta.ClientID), ComboEtichetta.GetJS(), True)
                    End If

                    Post_CaricamentoEtichetta_AggiornaCaselleTesto()

                    aggiornaGiacenzaPerUdm()

                End If

            End If

        End If


    End Sub

    Private Sub Imposta_DosiEtichetta(ByVal DoseValue As String)

        Dim DoseMin, DoseMax, AcquaMin, AcquaMax As Decimal
        Dim For_Veg_Av_Dos_Cod, Udm_Cod, AcquaUdm_Cod, Limite, Limite_Udm_Cod, Flag_Fioritura, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max, Da_Epoca, A_Epoca As Integer
        Dim Udm_Sim, AcquaUdm_Sim, Limite_Sim, strCLTOSS_Grado As String
        Dim copiaEtichetta As Boolean = False
        Dim Mdi_Cod As Integer
        Dim Flag_Protetto As Integer
        Dim FormulatiXAllegatiNormative_IDRiga As Integer = 0
        Dim DataSmaltimentoScorte As String
        Dim Gruppo_Dosaggi As Integer
        Dim Num_Max_Interventi_Globali As Integer
        Dim Moltiplicatore As Decimal
        Resettasession_Etichetta()

        If Not IsNumeric(Txt_Acqua_Tot.Text) Then
            Txt_Acqua_Tot.Text = "0"
        End If

        If ComboEtichetta.ValoriDose(DoseValue, For_Veg_Av_Dos_Cod, DoseMin, DoseMax, Udm_Cod, Udm_Sim,
                                         AcquaMin, AcquaMax, AcquaUdm_Cod, AcquaUdm_Sim,
                                         Da_Epoca, A_Epoca, Limite, Limite_Udm_Cod, Limite_Sim,
                                         strCLTOSS_Grado, Flag_Fioritura, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max,
                                         Mdi_Cod, Flag_Protetto, FormulatiXAllegatiNormative_IDRiga, DataSmaltimentoScorte, Gruppo_Dosaggi, Num_Max_Interventi_Globali) = True Then

            'verifico se è dose Ettaro o dose HL
            Dim Udm_Radice, per_ha_hl As Integer
            Dim MoltiplicatoreDose As Decimal = 1
            Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
            objUdm.ScomponiUdm(Udm_Radice, per_ha_hl, Udm_Cod, MoltiplicatoreDose)

            If Udm_Radice <> -1 Then
                'converto l'acqua in Hl
                Dim AcquaMaxHL As Decimal = 0
                Dim AcquaMinHL As Decimal = 0

                If AcquaMax <> 0 Then
                    Dim AcquaUdm_Radice, Acquaper_ha_hl As Integer

                    AcquaUdm_Radice = -1
                    objUdm.ScomponiUdm(AcquaUdm_Radice, Acquaper_ha_hl, AcquaUdm_Cod)
                    If AcquaUdm_Radice <> -1 Then
                        If Acquaper_ha_hl = 2123 Then
                            Select Case AcquaUdm_Cod
                                Case 2 'kg
                                    AcquaMaxHL = AcquaMax / 100
                                Case 4 'q
                                    AcquaMaxHL = AcquaMax
                                Case 304 't
                                    AcquaMaxHL = AcquaMax * 10
                                Case 3 'g
                                    AcquaMaxHL = AcquaMax / 10000
                                Case 2032 'mg
                                    AcquaMaxHL = AcquaMax / 100000
                                Case 29 'l
                                    AcquaMaxHL = AcquaMax / 100
                                Case 101 'ml
                                    AcquaMaxHL = AcquaMax / 100000
                                Case 104 'cc
                                    AcquaMaxHL = AcquaMax / 100000
                            End Select
                        End If
                    End If

                End If

                If AcquaMin <> 0 Then
                    Dim AcquaUdm_Radice, Acquaper_ha_hl As Integer

                    AcquaUdm_Radice = -1

                    objUdm.ScomponiUdm(AcquaUdm_Radice, Acquaper_ha_hl, AcquaUdm_Cod)
                    If AcquaUdm_Radice <> -1 Then
                        If Acquaper_ha_hl = 2123 Then
                            Select Case AcquaUdm_Cod
                                Case 2 'kg
                                    AcquaMinHL = AcquaMin / 100
                                Case 4 'q
                                    AcquaMinHL = AcquaMin
                                Case 304 't
                                    AcquaMinHL = AcquaMin * 10
                                Case 3 'g
                                    AcquaMinHL = AcquaMin / 10000
                                Case 2032 'mg
                                    AcquaMinHL = AcquaMin / 100000
                                Case 29 'l
                                    AcquaMinHL = AcquaMin / 100
                                Case 101 'ml
                                    AcquaMinHL = AcquaMin / 100000
                                Case 104 'cc
                                    AcquaMinHL = AcquaMin / 100000
                            End Select
                        End If
                    End If
                End If
            End If


            If Session("D_HA_Max_Diserbo") <> 0 Then

                Session("Chili_Litri") = True

                Cmb_UdM.Items.Clear()
                Carica_Cmb_UdM_fromUdm(Udm_Radice, per_ha_hl)

                Dim udm_sorgente_app = Udm_Radice
                Dim udm_sorgente_trasformata As Integer = 0
                Dim Moltiplicatore_app As Decimal
                AgronicaCoreMetaSchemaDAL.UnitaMisura_R.ConvertiToKG_L(udm_sorgente_app, udm_sorgente_trasformata, Moltiplicatore_app)
                Dim dose_HA_app As Decimal
                dose_HA_app = DoseMax * Moltiplicatore_app * MoltiplicatoreDose

                If dose_HA_app < Session("D_HA_Max_Diserbo") Then
                    copiaEtichetta = True
                Else
                    Select Case per_ha_hl
                        Case TipiEnumerativi.enum_UnitaMisura.Ettolitro
                            Me.Txt_Dose_HL.Text = Session("D_HA_Max_Diserbo")
                            Txt_DoseTot_HA.Text = Txt_Dose_HL.Text * Txt_Acqua_Tot.Text
                            If (CDec(Txt_SupTrattata.Value) > 0) Then
                                Txt_Dose_HA.Text = Txt_DoseTot_HA.Text / Txt_SupTrattata.Value
                            End If
                        Case TipiEnumerativi.enum_UnitaMisura.Ettaro
                            Me.Txt_Dose_HA.Text = Session("D_HA_Max_Diserbo")
                            'calcolo la dose totale 
                            Txt_DoseTot_HA.Text = Txt_Dose_HA.Text * Txt_SupTrattata.Value
                            If (CDec(Txt_Acqua_Tot.Text) > 0) Then
                                Txt_Dose_HL.Text = Txt_DoseTot_HA.Text / Txt_Acqua_Tot.Text
                            Else
                                Txt_Dose_HL.Text = 0
                            End If
                    End Select

                    Select Case Session("Udm_Radice_HA")
                            'peso
                        Case 3, 2032, 2, 304, 4
                            Session("Udm_Radice_HA") = 2
                                'acqua
                        Case 104, 101, 29
                            Session("Udm_Radice_HA") = 29
                    End Select

                End If

            Else
                copiaEtichetta = True
            End If


            If copiaEtichetta Then

                If DoseMax <> 0 Then

                    Cmb_UdM.Items.Clear()
                    Dim udm_sorgente As Integer = 0
                    Carica_Cmb_UdM_fromUdm(Udm_Radice, per_ha_hl)

                    udm_sorgente = Udm_Radice
                    'Dim Moltiplicatore As Decimal

                    If Session("Chili_Litri") = True Then
                        Dim udm_sorgente_trasformata As Integer = 0
                        AgronicaCoreMetaSchemaDAL.UnitaMisura_R.ConvertiToKG_L(udm_sorgente, udm_sorgente_trasformata, Moltiplicatore)
                    Else
                        Moltiplicatore = 1
                    End If

                    Moltiplicatore = Moltiplicatore * MoltiplicatoreDose
                    'imposto la qta 
                    If CopiaQuantita Then
                        Select Case per_ha_hl
                            Case enum_UnitaMisura.Ettolitro
                                Me.Txt_Dose_HL.Text = DoseMax * Moltiplicatore
                                'calcolo la dose totale 
                                Txt_DoseTot_HA.Text = Txt_Dose_HL.Text * Txt_Acqua_Tot.Text
                                If (CDec(Txt_SupTrattata.Value) > 0) Then
                                    Txt_Dose_HA.Text = Txt_DoseTot_HA.Text / Txt_SupTrattata.Value
                                End If
                            Case enum_UnitaMisura.Ettaro
                                Me.Txt_Dose_HA.Text = DoseMax * Moltiplicatore
                                'calcolo la dose totale 
                                Txt_DoseTot_HA.Text = Txt_Dose_HA.Text * Txt_SupTrattata.Value
                                If (CDec(Txt_Acqua_Tot.Text) > 0) Then
                                    Txt_Dose_HL.Text = Txt_DoseTot_HA.Text / Txt_Acqua_Tot.Text
                                Else
                                    Txt_Dose_HL.Text = 0
                                End If
                        End Select
                        Cmb_UdM.SelectedValue = udm_sorgente
                    End If

                    'modifico le dosi in base alla selezione kg/litri
                    If Session("Chili_Litri") = True Then
                        'gestisco kg / litri
                        Select Case udm_sorgente
                                'peso
                            Case 3, 2032, 2, 304, 4
                                Cmb_UdM.SelectedValue = "2"

                                    'acqua
                            Case 104, 101, 29, 19
                                Cmb_UdM.SelectedValue = "29"
                                'devo trasformare le dosi
                        End Select
                    End If

                Else

                    '--------------------
                    'DOSE NON DISPONIBILE
                    'Me.Lbl_Dose_Etichetta.Text = Resources.AgronicaAgenda_2010.BrNonDisponibile



                    If CopiaQuantita Then

                        Me.Txt_Dose_HA.Text = "0"
                        Me.Txt_Dose_HL.Text = "0"
                        Txt_DoseTot_HA.Text = "0"

                        Hidden_Dose_Ha_Reale.Value = "0"
                        Hidden_Dose_Hl_Reale.Value = "0"
                        Hidden_Dose_Tot_Reale.Value = "0"

                        'imposto il radiobutton solo la prima volta
                        If Me.rbl_DoseHA.Enabled Then
                            Select Case 0
                                Case 21, 23, 37, 126, 164, 165, 173, 175
                                    Me.rbl_DoseHL.Checked = True   '/hl

                                Case 20, 22, 88, 89, 90, 163, 176, 318
                                    Me.rbl_DoseHA.Checked = True  '/ha

                                Case Else
                                    Me.rbl_DoseHA.Checked = True
                            End Select
                        End If
                    End If
                End If
            End If

        Else

            Me.Txt_Dose_HA.Text = "0"
            Me.Txt_Dose_HL.Text = "0"
            Txt_DoseTot_HA.Text = "0"

            Hidden_Dose_Ha_Reale.Value = "0"
            Hidden_Dose_Hl_Reale.Value = "0"
            Hidden_Dose_Tot_Reale.Value = "0"

            'imposto il radiobutton solo la prima volta
            If Me.rbl_DoseHA.Enabled Then
                Select Case 0
                    Case 21, 23, 37, 126, 164, 165, 173, 175
                        Me.rbl_DoseHL.Checked = True   '/hl

                    Case 20, 22, 88, 89, 90, 163, 176, 318
                        Me.rbl_DoseHA.Checked = True  '/ha

                    Case Else
                        Me.rbl_DoseHA.Checked = True
                End Select
            End If

        End If


        'preseleziono kg / Litri
        If Session("Chili_Litri") = True Then
            If Not IsNothing(Cmb_UdM.Items.FindByValue("2")) Then
                Cmb_UdM.SelectedValue = "2"
            End If

            If Not IsNothing(Cmb_UdM.Items.FindByValue("29")) Then
                Cmb_UdM.SelectedValue = "29"
            End If
        End If

        Hidden_Dose_Ha_Reale.Value = CDec(Txt_Dose_HA.Text)
        Hidden_Dose_Hl_Reale.Value = CDec(Txt_Dose_HL.Text)
        Hidden_Dose_Tot_Reale.Value = CDec(Txt_DoseTot_HA.Text)
        Hidden_Dose_Acqua_Ha_Reale.Value = CDec(Txt_Acqua_Ha.Text)
        Hidden_Dose_Acqua_Tot_Reale.Value = CDec(Txt_Acqua_Tot.Text)


        Txt_Dose_HA.Text = Math.Round(CDec(Txt_Dose_HA.Text), 4)
        Txt_Dose_HL.Text = Math.Round(CDec(Txt_Dose_HL.Text), 4)
        Txt_DoseTot_HA.Text = Math.Round(CDec(Txt_DoseTot_HA.Text), 4)
        Txt_Acqua_Ha.Text = Math.Round(CDec(Txt_Acqua_Ha.Text), 4)
        Txt_Acqua_Tot.Text = Math.Round(CDec(Txt_Acqua_Tot.Text), 4)

        Dim STR_UpdatePanelDose As New StringBuilder
        STR_UpdatePanelDose.AppendLine("$(document).ready(function () {")
        STR_UpdatePanelDose.AppendLine("memorizza_unita_base();")
        STR_UpdatePanelDose.AppendLine(" });")

        ScriptManager.RegisterStartupScript(CType(Page.Master, OperazioneBootstrap).Property_UpdatePanelPerScript,
                                                CType(Page.Master, OperazioneBootstrap).Property_UpdatePanelPerScript.GetType(),
                                          String.Format("jQuery_{0}", CType(Page.Master, OperazioneBootstrap).Property_UpdatePanelPerScript.ClientID),
                                          STR_UpdatePanelDose.ToString, True)

        aggiornaGiacenzaPerUdm()

    End Sub

    Private Sub Imposta_VolumiAcqua(ByVal AcquaMin As Decimal,
                                        ByVal AcquaMax As Decimal,
                                        ByVal AcquaUdm_Cod As Integer)
        'se ho già inserito un prodotto non modifico la dose acqua
        If GridView_Dosi.Rows.Count > 0 Then
            Exit Sub
        End If

        Dim AcquaTaraturaHL = Get_TaraturaUgello()

        If AcquaMax <> 0 OrElse AcquaMin <> 0 Then

            Dim AcquaUdm_Radice, Acquaper_ha_hl As Integer
            Dim AcquaMaxHL As Decimal
            Dim AcquaMinHL As Decimal
            AcquaUdm_Radice = -1
            Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
            objUdm.ScomponiUdm(AcquaUdm_Radice, Acquaper_ha_hl, AcquaUdm_Cod)
            If AcquaUdm_Radice <> -1 Then
                If Acquaper_ha_hl = 2123 Then
                    Me.rblAcqua_HA.Checked = True
                    Me.rblAcqua_Tot.Checked = False
                    If AcquaMax <> 0 Then
                        AcquaMaxHL = AgronicaCoreMetaSchemaDAL.UnitaMisura_R.Converti(AcquaUdm_Cod,
                                                        AcquaMax, TipiEnumerativi.enum_UnitaMisura.Ettolitro)
                    End If

                    If AcquaMin <> 0 Then
                        AcquaMinHL = AgronicaCoreMetaSchemaDAL.UnitaMisura_R.Converti(AcquaUdm_Cod,
                                                        AcquaMin, TipiEnumerativi.enum_UnitaMisura.Ettolitro)
                    End If

                    If (AcquaTaraturaHL > 0 AndAlso AcquaTaraturaHL > AcquaMaxHL) OrElse AcquaTaraturaHL = 0 Then

                        'controllo se l'acqua non è già stata inserita
                        If IsNumeric(Txt_Acqua_Ha.Text) AndAlso Txt_Acqua_Ha.Text > 0 Then
                            'se è all'interno del range non faccio nulla altrimenti lo modifico
                            'If Txt_Acqua_Ha.Text < AcquaMin Then
                            '    'imposto la qta di acqua minima
                            '    Txt_Acqua_Ha.Text = AcquaMinHL.ToString
                            '    lbl_acqua_provenienza.Text = "da vincoli etichetta"
                            'Else

                            'If Txt_Acqua_Ha.Text > AcquaMax Then
                            'imposto la qta di acqua max
                            Txt_Acqua_Ha.Text = AcquaMaxHL.ToString
                            lbl_acqua_provenienza.Text = Resources.AgronicaAgenda_2010.DaDosiDiEtichetta
                            If IsNumeric(Txt_SupTrattata.Value) AndAlso CDec(Txt_SupTrattata.Value) > 0 Then
                                Txt_Acqua_Tot.Text = CDec(AcquaMaxHL) * CDec(Txt_SupTrattata.Value)
                            End If
                            'Else
                            'mantengo la dose di acqua impostata dato che è all'interno del range
                            'di etichetta
                            'End If
                            'End If
                        Else
                            Txt_Acqua_Ha.Text = AcquaMaxHL.ToString
                            lbl_acqua_provenienza.Text = Resources.AgronicaAgenda_2010.DaVincoliEtichetta
                            If IsNumeric(Txt_SupTrattata.Value) AndAlso CDec(Txt_SupTrattata.Value) > 0 Then
                                Txt_Acqua_Tot.Text = CDec(AcquaMaxHL) * CDec(Txt_SupTrattata.Value)
                            End If
                        End If

                    Else

                        'Txt_Acqua_Ha.Text = AcquaTaraturaHL.ToString
                        'lbl_acqua_provenienza.Text = Resources.AgronicaAgenda_2010.DaTaraturaUgelli
                        'If IsNumeric(Txt_SupTrattata.Value) AndAlso CDec(Txt_SupTrattata.Value) > 0 Then
                        '    Txt_Acqua_Tot.Text = CDec(AcquaTaraturaHL) * CDec(Txt_SupTrattata.Value)
                        'End If

                    End If

                End If
            End If

        ElseIf AcquaTaraturaHL > 0 Then

            Txt_Acqua_Ha.Text = AcquaTaraturaHL.ToString
            lbl_acqua_provenienza.Text = Resources.AgronicaAgenda_2010.DaTaraturaUgelli
            If IsNumeric(Txt_SupTrattata.Value) AndAlso CDec(Txt_SupTrattata.Value) > 0 Then
