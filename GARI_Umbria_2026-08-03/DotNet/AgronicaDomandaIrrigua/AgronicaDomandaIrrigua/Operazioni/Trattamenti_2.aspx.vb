#Region "COMBO SelectedIndexChanged"

    Private Sub BTN_Magazzini_Click()


        If IsSemina Then

            'Reimposto il radiobutton del tipo semina
            Imposta_TipoSemina_DaOpzioneUtente()

            'In caso di semina senza magazzino devo togliere tutti i controlli in quanto si può fare solo la registrazione "secca"
            If objParametriAgenda.Fabbricato = "0" Then
                pnlSeminaOpzioniSalvataggio.Visible = False
                'pnlSeminaOpzioniSalvataggio.Style.Add("display", "none")
                'riga_sementi.Visible = False

                'Nascondo panello prodotti
                UpdatePanel_Prodotti.Attributes.Add("style", "display:none")
                Dim strJSs As New StringBuilder
                strJSs.AppendLine("$(document).ready(function () { ")
                strJSs.AppendLine("      var element = document.getElementById('" & UpdatePanel_Prodotti.ClientID & "'); ")
                strJSs.AppendLine("      element.classList.add('displaynone'); ")
                strJSs.AppendLine(" });")
                ScriptManager.RegisterClientScriptBlock(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType(),
                                              String.Format("jQuery_{0}", UpdatePanel_Prodotti.ClientID), strJSs.ToString, True)

            Else

                If TipoOperazioneAgenda = enum_Tipo_Operazione_Agenda.QuadernoDiCampagna Then
                    pnlSeminaOpzioniSalvataggio.Visible = True
                    'pnlSeminaOpzioniSalvataggio.Style.Remove("display")
                    'riga_sementi.Visible = True
                End If

                'Mostro pannello prodotti
                UpdatePanel_Prodotti.Attributes.Remove("style")
                Dim strJSs As New StringBuilder
                strJSs.AppendLine("$(document).ready(function () { ")
                strJSs.AppendLine("      var element = document.getElementById('" & UpdatePanel_Prodotti.ClientID & "'); ")
                strJSs.AppendLine("      element.classList.remove('displaynone'); ")
                strJSs.AppendLine(" });")
                ScriptManager.RegisterClientScriptBlock(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType(),
                                      String.Format("jQuery_{0}", UpdatePanel_Prodotti.ClientID), strJSs.ToString, True)



            End If

        Else

            CaricaComboUnitadiMisura()

        End If

        'Cambio da nessun magazzino al magazzino selezionato se:
        ' 1 Sono in modifica di un'operazione
        ' 2 Sto ribaltando in qdc una ricetta

        If objParametriAgenda.Fabbricato <> "0" AndAlso
            ((objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Modifica) OrElse
            (objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Scrittura AndAlso objParametriAgenda.TipoOperazioneAgenda = "1" AndAlso objParametriAgenda.TipoRicetta AndAlso Qs_Ricetta_Cod <> "0")) Then

            Dim Dt_Dosi As DataTable = Session("vs_dtDosi")
            If Dt_Dosi IsNot Nothing AndAlso Dt_Dosi.Rows.Count > 0 Then
                Dim modificatoFabbricato As Boolean = False
                Dim objMagazzino As New AgronicaCoreAnagrafeDAL.Fabbricati_R
                For Each row In Dt_Dosi.Rows

                    If row("Piva") = "" OrElse row("Sa_Cod") = 0 OrElse row("Fabbricato_Cod") = 0 Then
                        Dim Piva = objParametriAgenda.Fabbricato.Split("|")(2)
                        Dim Sa_Cod = objParametriAgenda.Fabbricato.Split("|")(1)
                        Dim Fabbricato_Cod = objParametriAgenda.Fabbricato.Split("|")(0)

                        row("Piva") = Piva
                        row("Sa_Cod") = Sa_Cod
                        row("Fabbricato_Cod") = Fabbricato_Cod
                        row("Fabbricato_Des") = objMagazzino.Leggi(Piva, Sa_Cod, Fabbricato_Cod, enumSelezioneVariabile.Selezione_TabellaDatiMinimi, "", "", objParametri_Server).Rows(0)("Fabbricato_Des")
                        modificatoFabbricato = True
                    End If

                Next

                If modificatoFabbricato Then
                    Griglia_Dosi_Data_Bind()
                End If

            End If

        End If

        'UpdatePanel_Prodotti.Update()

    End Sub

