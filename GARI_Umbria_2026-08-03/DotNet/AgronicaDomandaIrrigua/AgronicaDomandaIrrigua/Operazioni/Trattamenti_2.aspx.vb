                        ComboFormulati.Tipo_Testata = 2
                End Select


                'verifico i comuni (in base al catasto degli appezzamenti)
                Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
                ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()

                Dim ListaComuni As New List(Of AgronicaControlli_2010.Comune)
                Dim ComunePresente As Boolean = False
                For i = 0 To ListaImpianti.Count - 1
                    For p = 0 To ListaImpianti(i).ListaParticelle.Count - 1
                        ComunePresente = False
                        For c = 0 To ListaComuni.Count - 1
                            If (ListaComuni(c).Prov = ListaImpianti(i).ListaParticelle(p).Provincia AndAlso
                                        ListaComuni(c).Com = ListaImpianti(i).ListaParticelle(p).Comune) Then
                                ComunePresente = True
                                Exit For
                            End If
                        Next
                        If Not ComunePresente Then
                            Dim Comune As New AgronicaControlli_2010.Comune
                            Comune.Prov = ListaImpianti(i).ListaParticelle(p).Provincia
                            Comune.Com = ListaImpianti(i).ListaParticelle(p).Comune
                            ListaComuni.Add(Comune)
                        End If
                    Next
                Next
                'se gli appezzamenti non hanno catasto 
                'prendo l'indirizzo del centro
                If ListaComuni.Count = 0 Then
                    Dim objCentro As New AgronicaCoreAnagrafeDAL.CentriAziendali_Read
                    Dim DtCentro As DataTable
                    DtCentro = objCentro.Leggi(objParametriAgenda.Piva, objParametriAgenda.Sa_Cod, enumSelezioneVariabile.Selezione_JoinDescrizioni, "", "", objParametri_Server)
                    If DtCentro.Rows.Count > 0 Then
                        Dim Comune As New AgronicaControlli_2010.Comune
                        Comune.Prov = DtCentro.Rows(0).Item("pro_cod_istat")
                        Comune.Com = DtCentro.Rows(0).Item("com_cod_istat")
                        ListaComuni.Add(Comune)
                    End If
                End If
                ComboFormulati.ListaComuni = ListaComuni


