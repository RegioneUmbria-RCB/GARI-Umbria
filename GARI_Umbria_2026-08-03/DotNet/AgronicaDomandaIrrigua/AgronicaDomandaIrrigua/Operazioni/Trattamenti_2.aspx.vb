                                              " AND Fabbricato_Cod = " & dt_DosiSelect.Rows(i)("Fabbricato_Cod") & " ")
                        For Each rowD In rows
                            Select Case rowD.Item("Udm_Cod") 'verificare queste conversioni
                                Case enum_UnitaMisura.Grammi
                                    DoseTotale_Trasformata = DoseTotale / 1000
                                Case enum_UnitaMisura.Milligrammi
                                    DoseTotale_Trasformata = DoseTotale / 1000000
                                Case enum_UnitaMisura.Quintali
                                    DoseTotale_Trasformata = DoseTotale * 100
                                Case enum_UnitaMisura.Tonnellate
                                    DoseTotale_Trasformata = DoseTotale * 1000
                                Case enum_UnitaMisura.Millilitri
                                    DoseTotale_Trasformata = DoseTotale / 1000
                                Case enum_UnitaMisura.CentimetriCubi
                                    DoseTotale_Trasformata = DoseTotale / 1000
                                Case enum_UnitaMisura.Metri_Cubi
                                    DoseTotale_Trasformata = DoseTotale * 1000
                                Case 2, 29 'kg,l
                                    DoseTotale_Trasformata = DoseTotale
                                Case enum_UnitaMisura.Unita_Seme, enum_UnitaMisura.Num_Piante, enum_UnitaMisura.Confezioni
                                    DoseTotale_Trasformata = DoseTotale
                            End Select
