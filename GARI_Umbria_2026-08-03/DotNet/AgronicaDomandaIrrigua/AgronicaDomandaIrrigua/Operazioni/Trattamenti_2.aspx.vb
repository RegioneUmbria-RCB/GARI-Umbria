    Private Function CheckModificabilita() As Boolean
        Dim objAgenda As New Agenda_Operazione_Helper
        Dim Agenda = objAgenda.Leggi(objParametriAgenda.Piva,
                                         CInt(objParametriAgenda.Sa_Cod),
                                         CInt(objParametriAgenda.Id_Agenda),
                                         0,
                                         objParametri_Server)

        If Agenda IsNot Nothing AndAlso Agenda.Movimenti IsNot Nothing Then
            For i = 0 To Agenda.Movimenti.Count - 1
                If Agenda.Movimenti(i).Cau_Mov = CAU_TRATTAMENTO _
                    OrElse CAU_LAVORAZIONE _
                    OrElse CAU_RILIEVO_RACCOLTA _
                    OrElse CAU_RILIEVO_CAMPO Then

                    If Agenda.Movimenti(i).Movimenti_Dettagli IsNot Nothing Then
                        For j = 0 To Agenda.Movimenti(i).Movimenti_Dettagli.Count - 1

                            'Per ogni movimento di dettaglio, conto i relativi movimenti di scarico 
                            Dim count = 0
                            For Each movimenti In Agenda.Movimenti
                                If movimenti.Cau_Mov = CAU_SCARICO Then
                                    For Each movimentiDettagli In movimenti.Movimenti_Dettagli
                                        If movimentiDettagli.Elem_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Elem_Cod AndAlso
                                            movimentiDettagli.Pro_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Pro_Cod AndAlso
                                            movimentiDettagli.Mat_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Mat_Cod Then

                                            If IsSemina Then
                                                If movimentiDettagli.Lotto = Agenda.Movimenti(i).Movimenti_Dettagli(j).Lotto Then
                                                    count += 1
                                                End If
                                            Else
                                                count += 1
                                            End If

                                        End If
                                    Next
                                End If
                            Next
                            If count > 1 Then
                                Return False
                            End If
                        Next
                    End If
                End If

            Next
        End If

        Return True
    End Function
