    Private Sub CreaAgendaScaricoAltraAzienda(ByVal Piva_Magazzino As String,
                                                  ByVal Sa_Cod_Magazzino As Integer,
                                                  ByVal Fabbricato_Cod As Integer,
                                                  ByRef AgendaScarico As Operazione_Agenda)

        Dim Movimento As Movimento
        Dim Movimento_Dettaglio As Movimento_Dettaglio
        Dim Movimento_Destinazione As Movimento_Destinazione

        '------------------------------------------------
        '----- Calcolo i valori di BaseCode e TopCode
        '------------------------------------------------
        Dim BaseCode As Integer = 0
        Dim TopCode As Integer = 0

        Calcola_BaseCode_TopCode(BaseCode, TopCode, Session("ASG_ProgressivoGIAS"))


        ' recupero le DOSI
        Dim Dt_Dosi As New DataTable
        If Session("vs_dtDosi") IsNot Nothing Then
            Dt_Dosi = Session("vs_dtDosi")
        End If

        'OPERAZIONE DI SCARICO SU ALTRA AZIENDA
        Dim Id_Agenda_Scarico As Integer = 0


        'verifico se l'azienda esiste come CLIENTE per l'azienda TERZISTA
        'se non esiste lo creo
        Dim objRU As New AgronicaCoreAnagrafeDAL.Risorse_Umane_R
        Dim Cod_RisUm As Integer = 0

        If objRU.Esiste_RisorsaUmana2(Piva_Magazzino, objParametriAgenda.Piva, COD_CLIENTE, "", Cod_RisUm, objParametri_Server) = False Then

            'se non esiste il rapporto verifico se esiste almeno il contatto
            Dim objC As New AgronicaCoreAnagrafeDAL.Contatti_R
            If objC.Esiste_Contatto(Piva_Magazzino, objParametriAgenda.Piva, enumSelezioneVariabile.Selezione_TabellaDatiMinimi, "", "", objParametri_Server) = False Then

                'Se non esiste il contatto lo creo
                Dim objContattoW As New AgronicaCoreAnagrafeBIZ.Contatti_W
                Dim xmlDoc As New System.Xml.XmlDocument
                Dim xContatto As System.Xml.XmlElement
                Dim objxml As New AgronicaCoreXML.XML_Anagrafe
                Dim streerore As String = ""

                Dim DT_RisUm As DataTable
                Dim objXML_Utility As New AgronicaCoreXML.XML_Utility
                DT_RisUm = objXML_Utility.CaricaGriglia_RisUm_for_XML()
                objXML_Utility.Inserisci_Riga_Dt_RisUm_for_XML(DT_RisUm, enum_TipoOperazioneDB.Scrittura, Piva_Magazzino, objParametriAgenda.Piva, , , COD_CLIENTE)

                xContatto = objxml.XML_2_Contatti(streerore,
                                          xmlDoc,
                                          BaseCode,
                                          TopCode,
                                          True,
                                          enum_TipoOperazioneDB.Scrittura,
                                          Piva_Magazzino,
                                          objParametriAgenda.Piva,
                                          Nothing,
                                          DT_RisUm,
                                            0,
                                            PERSONA_GIURIDICA,
                                            objParametriAgenda.RagSoc, ,
                                            objParametriAgenda.Piva)

                If objContattoW.Contatto_Scrivi(xContatto.OuterXml, "", "", objParametri_Server) = True Then
                    objRU.Esiste_RisorsaUmana2(Piva_Magazzino, objParametriAgenda.Piva, COD_CLIENTE, "", Cod_RisUm, objParametri_Server)
                End If
            Else
                'altrimenti creo solo il rapporto contabile cliente
                Dim ObjSequenze As New AgronicaCoreDataProvider.Agro_Sequenze
                Cod_RisUm = ObjSequenze.NuovoId_Tabella("Risorse_Umane",
                                                                    BaseCode, TopCode,
                                                                    objParametri_Server)

                Dim objRisUm_W As New AgronicaCoreAnagrafeDAL.Risorse_Umane_W
                objRisUm_W.Scrivi(Piva_Magazzino, 0, Cod_RisUm, objParametriAgenda.Piva,
                                                 COD_CLIENTE,
                                                "",
                                                 "",
                                                 0,
                                                 0,
                                                0,
                                                0,
                                                 0,
                                                 0,
                                                 0,
                                                 "",
                                                 AGRODATAINIZIO,
                                                 AGRODATAFINE,
                                                 "",
                                                 0,
                                                 "",
                                                 0,
                                                 0,
                                                 0,
                                                 AGRODATAINIZIO,
                                                 AGRODATAFINE,
                                                 objParametri_Server)


            End If



        End If





        '------------------------------------------------
        '----- AGENDA
        '------------------------------------------------
        AgendaScarico = New Operazione_Agenda

        AgendaScarico.Tipo_Operazione = objParametriAgenda.Tipo_Operazione
        AgendaScarico.Id_Agenda = Id_Agenda_Scarico
        AgendaScarico.Data = objParametriAgenda.Data
        AgendaScarico.Piva = Piva_Magazzino
        AgendaScarico.Sa_Cod = Sa_Cod_Magazzino
        AgendaScarico.Lav_Cod = LAVCOD_BOLLA_EMESSA
        AgendaScarico.Des_Lib = "DDT emesso relativo a " & objParametriAgenda.Lav_Des & " (Azienda " & Agro_SQL_SaveText(objParametriAgenda.RagSoc) & "  [P.IVA " & objParametriAgenda.Piva & "])"


        AgendaScarico.BaseCode = BaseCode
        AgendaScarico.TopCode = TopCode


        '------------------------------------------------
        '----- MOVIMENTI
        '------------------------------------------------
        AgendaScarico.Movimenti = New List(Of Movimento)

        '------------------------------------------------
        '------------------------------------------------
        '----- MOVIMENTO CONTABILE
        '------------------------------------------------
        '------------------------------------------------
        Movimento = New Movimento

        Movimento.Id_Agenda = Id_Agenda_Scarico
        Movimento.Piva = Piva_Magazzino
        Movimento.Sa_Cod = Sa_Cod_Magazzino
        Movimento.Data = objParametriAgenda.Data
        Movimento.Lav_Cod = LAVCOD_BOLLA_EMESSA
        Movimento.Cau_Mov = CAU_REGISTRAZIONI
        Movimento.Mov_Desc = "DDT Emesso relativo a " & objParametriAgenda.Lav_Des & " (Azienda " & Agro_SQL_SaveText(objParametriAgenda.RagSoc) & "  [P.IVA " & objParametriAgenda.Piva & "])"
        Movimento.Data_Registrazione = objParametriAgenda.Data
        Movimento.Scadenza = AGRODATAFINE

        Movimento.Doc_Numero_Sin = ""
        Movimento.Doc_Numero = 0
        Movimento.Doc_Numero_Des = ""
        Movimento.Num_Protocollo = 0
        Movimento.Colli = 0
        Movimento.Peso = 0
        Movimento.Aspetto = ""
        Movimento.Causale_Trasporto = ""
        Movimento.Cod_Risum = Cod_RisUm
        Movimento.Modalita = 0

        Movimento.BaseCode = BaseCode
        Movimento.TopCode = TopCode

        AgendaScarico.Movimenti.Add(Movimento)


        '------------------------------------------------
        '------------------------------------------------
        '----- MOVIMENTO SCARICO
        '------------------------------------------------
        '------------------------------------------------
        Movimento = New Movimento

        Movimento.Id_Agenda = Id_Agenda_Scarico
        Movimento.Piva = Piva_Magazzino
        Movimento.Sa_Cod = Sa_Cod_Magazzino
        Movimento.Data = objParametriAgenda.Data
        Movimento.Lav_Cod = LAVCOD_BOLLA_EMESSA
        Movimento.Cau_Mov = CAU_SCARICO
        Movimento.Mov_Desc = "Scarico DDT emesso relativo a " & objParametriAgenda.Lav_Des & " (Azienda " & Agro_SQL_SaveText(objParametriAgenda.RagSoc) & "  [P.IVA " & objParametriAgenda.Piva & "])"
        Movimento.Data_Registrazione = objParametriAgenda.Data
        Movimento.Scadenza = AGRODATAFINE

        Movimento.BaseCode = BaseCode
        Movimento.TopCode = TopCode

        AgendaScarico.Movimenti.Add(Movimento)

        '------------------------------------------------
        '----- MOVIMENTI DETTAGLI
        '------------------------------------------------
        Dim DoseTotale_Trasformata As Decimal
        Dim DoseTotale As Decimal

        AgendaScarico.Movimenti(AgendaScarico.Movimenti.Count - 1).Movimenti_Dettagli = New List(Of Movimento_Dettaglio)

        For i = 0 To Dt_Dosi.Rows.Count - 1

            Movimento_Dettaglio = New Movimento_Dettaglio

            Movimento_Dettaglio.Id_Agenda = Id_Agenda_Scarico
            Movimento_Dettaglio.Piva = Piva_Magazzino
            Movimento_Dettaglio.Sa_Cod = Sa_Cod_Magazzino
            Movimento_Dettaglio.Data = objParametriAgenda.Data
            Movimento_Dettaglio.Lav_Cod = objParametriAgenda.Lav_Cod
            Movimento_Dettaglio.Cau_Mov = CAU_SCARICO

            'Grilli 23/08/2019 Distinguo in base al tipo di operazione
            If IsTrattamento Then
                Movimento_Dettaglio.Elem_Cod = FORMULATI
                Movimento_Dettaglio.Pro_Cod = Dt_Dosi.Rows(i).Item("Fr_Cod")
                Movimento_Dettaglio.Mat_Cod = 0
            ElseIf IsFertilizzazione Then
                Movimento_Dettaglio.Elem_Cod = FERTILIZZANTI
                Movimento_Dettaglio.Pro_Cod = Dt_Dosi.Rows(i).Item("Fr_Cod")
                Movimento_Dettaglio.Mat_Cod = 0
            ElseIf IsSemina Then
                Movimento_Dettaglio.Elem_Cod = SEMENTI
                Movimento_Dettaglio.Pro_Cod = 0
                Movimento_Dettaglio.Mat_Cod = Dt_Dosi.Rows(i).Item("Fr_Cod")
            Else
                Throw New Exception("Tipo di operazione non gestita con il TERZISTA")
            End If

            Movimento_Dettaglio.Extra_Int = 0
            Movimento_Dettaglio.Udm_Cod = Dt_Dosi.Rows(i).Item("Udm_Cod_Trasformato")

            'DoseTotale = Dt_Dosi.Rows(i).Item("Qta_Tot") 'Qta_da_scaricare(i)
            DoseTotale = Dt_Dosi.Rows(i).Item("Dose_Tot_Reale") 'Qta_da_scaricare(i)

            Select Case Dt_Dosi.Rows(i).Item("Udm_Cod") 'verificare queste conversioni
                Case 3  'g
                    DoseTotale_Trasformata = DoseTotale / 1000  'caso in cui ho i grammi
                Case 2032  'mg
                    DoseTotale_Trasformata = DoseTotale / 1000000  'caso in cui ho i grammi
                Case 4  'q
                    DoseTotale_Trasformata = DoseTotale * 100  'caso in cui ho i quintali
                Case 304 't
                    DoseTotale_Trasformata = DoseTotale * 1000   'caso in cui ho le tonnelate
                Case 101 'ml
                    DoseTotale_Trasformata = DoseTotale / 1000  'caso in cui ho i ml
                Case 104 'cc
                    DoseTotale_Trasformata = DoseTotale / 1000  'caso in cui ho i cc
                Case 2, 29 'kg,l
                    DoseTotale_Trasformata = DoseTotale
                Case enum_UnitaMisura.Unita_Seme, enum_UnitaMisura.Num_Piante, enum_UnitaMisura.Confezioni
                    DoseTotale_Trasformata = DoseTotale
            End Select
            Movimento_Dettaglio.Qta = DoseTotale_Trasformata

            Movimento_Dettaglio.Contabilizzato = NONCONTABILE

            Movimento_Dettaglio.BaseCode = BaseCode
            Movimento_Dettaglio.TopCode = TopCode

            AgendaScarico.Movimenti(AgendaScarico.Movimenti.Count - 1).Movimenti_Dettagli.Add(Movimento_Dettaglio)

            '------------------------------------------------
            '----- MOVIMENTI DESTINAZIONI
            '------------------------------------------------
            Dim indice As Integer = AgendaScarico.Movimenti(AgendaScarico.Movimenti.Count - 1).Movimenti_Dettagli.Count - 1

            AgendaScarico.Movimenti(AgendaScarico.Movimenti.Count - 1).Movimenti_Dettagli(indice).Movimenti_Destinazioni = New List(Of Movimento_Destinazione)

            Movimento_Destinazione = New Movimento_Destinazione

            Movimento_Destinazione.Data = objParametriAgenda.Data

            Movimento_Destinazione.Id_Agenda = Id_Agenda_Scarico
            Movimento_Destinazione.Piva = Piva_Magazzino
            Movimento_Destinazione.Sa_Cod = Sa_Cod_Magazzino
            Movimento_Destinazione.Appezza = 0
            Movimento_Destinazione.Id_Destinazione = Fabbricato_Cod
            Movimento_Destinazione.Tipo = MAGAZZINO

            Movimento_Destinazione.Qta = DoseTotale_Trasformata '* QTA2_TOT

            Movimento_Destinazione.BaseCode = BaseCode
            Movimento_Destinazione.TopCode = TopCode

            AgendaScarico.Movimenti(AgendaScarico.Movimenti.Count - 1).Movimenti_Dettagli(indice).Movimenti_Destinazioni.Add(Movimento_Destinazione)

        Next


    End Sub

    Private Function VerificaDPI(ByVal Agenda As Operazione_Agenda, ByRef Errore As String) As Boolean

        'una volta creato l'oggetto agenda posso infocare il suo metodo che mi genera l'xml
        Dim Dpi_Cod As Integer = 0
        Dim Dpi_PubblicoPrivato As Integer = 0

        Dim Helper As New Agenda_Operazione_Helper
        Dim strXML As String = Helper.GeneraXML_CAU_TRATTAMENTO(Agenda, Dpi_Cod, Dpi_PubblicoPrivato)
        strXML = Replace(strXML, "TipoOperazioneDB=""1""", "TipoOperazioneDB=""" & Agenda.Tipo_Operazione & """")

        Dim Conforme As Boolean

        Dim objDpiVerifica As New AgronicaCoreDpiBIZ.DPI_Verifica
        Dim rval As New rispostaStandard(Of AgronicaCoreDpiBIZ.Verifica_Disciplinare_Intervento)
        rval = objDpiVerifica.Verifica_Conformita_Intervento_New(objParametri_Server, objParametri_Utenti,
                                                                                                             Agenda.Piva,
                                                                                                             strXML, 0,
                                                                                                             Agenda.Id_Agenda,
                                                                                                                True,
                                                                                                                 enum_Disciplinare_Operazione.QuelloDellOperazione, 0,
                                                                                                                     "", 0, 0, 0)

        If rval.RispostaOK Then
            Errore = rval.RispostaStringa.strNonConformita
            Conforme = rval.RispostaStringa.Conforme 'VerificaStringaErrori(rval.RispostaStringa.Risultato, Errore)
        End If

        Return Conforme


    End Function


    '########################################################################################
    Private Function VerificaStringaErrori(ByVal RisultatoVerifica As String, ByRef strErrore As String) As Boolean

        '------------------------------------------
        '----- Dichiarazione delle Variabili
        '------------------------------------------

        Dim Conforme As Boolean = True

        Dim XmlDoc As New System.Xml.XmlDocument
        Dim XML_DatiRisultati As System.Xml.XmlElement
        Dim XML_DatiGenerali As System.Xml.XmlElement
        Dim XML_DatiNonConformi As System.Xml.XmlElement
        Dim XML_DatoNonConforme As System.Xml.XmlElement
        Dim XMLs_DatoNonConforme As System.Xml.XmlNodeList

        Dim x As Integer = 0

        '------------------------------------------
        '----- Analizzo la stringa XML
        '------------------------------------------

        'Carico la stringa nel documento XML
        XmlDoc.LoadXml(RisultatoVerifica)

        '----- Elemento <DatiRisultati>
        XML_DatiRisultati = XmlDoc.SelectSingleNode("DatiRisultati")

        '----- Elemento <DatiGenerali>
        XML_DatiGenerali = XML_DatiRisultati.SelectSingleNode("DatiGenerali")

        '----- Elemento <DatiNonConformi>
        XML_DatiNonConformi = XML_DatiGenerali.SelectSingleNode("DatiNonConformi")

        XMLs_DatoNonConforme = XML_DatiNonConformi.GetElementsByTagName("DatoNonConforme")

        If Not XML_DatiNonConformi.HasChildNodes Then
            Conforme = True
        Else
            Conforme = False
        End If

        '------------------------------------------
        '----- Data Grid Dettagli
        '------------------------------------------
        For x = 0 To XMLs_DatoNonConforme.Count - 1
            XML_DatoNonConforme = XMLs_DatoNonConforme.Item(x)
            If InStr(strErrore, CStr(XML_DatoNonConforme.GetAttribute("err_des"))) = 0 Then
                strErrore &= CStr(XML_DatoNonConforme.GetAttribute("err_des")) & "<br>"
            End If
        Next

        Return Conforme

    End Function






