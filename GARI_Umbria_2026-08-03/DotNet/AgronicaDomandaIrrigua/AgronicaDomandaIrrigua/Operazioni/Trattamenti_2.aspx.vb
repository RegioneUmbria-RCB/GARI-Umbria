        Dim IdRcdpi As Integer
        Dim Modulo As Integer
        Dim Epoca As Integer
        Dim xGrfi_Cod As Integer = 0
        Dim Grfi_Cod As Integer = 0
        Dim Cop_Cod As Integer = 0
        Dim Copertura As Integer = 0


        Dim frm_AvCod As String
        Dim frm_AvGru As String
        Dim frm_AvDes As String
        Dim frm_SogliaValue As String
        Dim frm_SogliaDes As String

        Dim TempoCarenza As Integer
        Dim DoseEtichetta As String
        Dim DoseEtichetta_Value As String
        Dim PrincipiAttivi As String
        Dim PrincipiAttiviPesi As String
        Dim PrincipiAttiviPercAbb As String = ""
        Dim PercAbbMin As Decimal = 100
        Dim BufferMin As Decimal = 0
        Dim BufferMax As Decimal = 0
        Dim ClasseTossicologica As String

        Dim Destinazione As Integer
        Dim SaCodDestinazione As Integer
        Dim PivaDestinazione As String

        Dim Movimento As Movimento
        Dim Movimento_Dettaglio As Movimento_Dettaglio

        '------------------------------------------
        '----- Recupero le informazioni
        '------------------------------------------
        Dim XmlDoc As New System.Xml.XmlDocument
        Dim XML_Ricetta_Operazione As System.Xml.XmlElement
        Dim xDatiRicettaxNote As System.Xml.XmlElement
        Dim xListaRicettaxNote As System.Xml.XmlNodeList
        Dim xRicettaxNote As System.Xml.XmlElement
        Dim XML_DatiRicetta_Dettagli As System.Xml.XmlElement
        Dim XML_Ricetta_Dettaglio As System.Xml.XmlElement
        Dim XMLs_Ricetta_Dettaglio As System.Xml.XmlNodeList
        Dim XML_RicettaDestinazione As System.Xml.XmlElement
        Dim XMLs_RicettaDestinazione As System.Xml.XmlNodeList
        Dim XML_DatiRicetta_Dettagli_Tecnici As System.Xml.XmlElement
        Dim XML_Ricetta_Dettaglio_Tecnico As System.Xml.XmlElement
        Dim XMLs_Ricetta_Dettaglio_Tecnico As System.Xml.XmlNodeList
        Dim XML_Ricetta_Dettaglio_Tecnico_2 As System.Xml.XmlElement
        Dim XMLs_Ricetta_Dettaglio_Tecnico_2 As System.Xml.XmlNodeList

        XmlDoc.LoadXml(Xml_Operazione)

        XML_Ricetta_Operazione = XmlDoc.SelectSingleNode("Ricetta_Operazione")

        Dim flagNuovoControlloRiduzioneDiserbo As Boolean = Leggi_FlagNuovoControlloRiduzioneDiserbo()
        Dim NoteIntervento As String = CStr(XML_Ricetta_Operazione.GetAttribute("note"))
        CType(Page.Master, OperazioneBootstrap).SetNota(NoteIntervento)

        ' ----- NOTE

        Dim Nota As Nota

        xDatiRicettaxNote = XML_Ricetta_Operazione.SelectSingleNode("DatiRicettaxNote_2")
        If xDatiRicettaxNote IsNot Nothing Then
            xListaRicettaxNote = xDatiRicettaxNote.GetElementsByTagName("RicettaxNote_2")
            If xListaRicettaxNote IsNot Nothing Then
                For i = 0 To xListaRicettaxNote.Count - 1
                    xRicettaxNote = xListaRicettaxNote.Item(i)
                    Nota = New Nota
                    Nota.Nota_Cod = CInt(xRicettaxNote.GetAttribute("nota_cod"))
                    objParametriAgenda.Note.Add(Nota)
                Next
            End If
        End If
        objParametriAgenda.salva()


        'Attività
        If XML_Ricetta_Operazione.GetAttribute("lav_cod") = LAVCOD_ALTRE_OPERAZIONI Then
            Txt_AttivitaDes.Value = XML_Ricetta_Operazione.GetAttribute("ricetta_operazione_des")
            ComboAttivita.SelectedIndex = ComboAttivita.Items.IndexOf(ComboAttivita.Items.FindByValue(XML_Ricetta_Operazione.GetAttribute("extra_int")))
        End If

        'CaricaComboDisciplinariExteso()
        'ComboDisciplinari1.ddl_Disciplinari.SelectedIndex = -1

        '-------------------------------------------
        '-------------------------------------------
        'Disciplinari
        '= 0  --> Nessun Filtro + Casi Vecchi senza DPI
        '> 0  --> DPI
        '= -1 --> Nuovo caso con etichetta ma senza DPI
        '-------------------------------------------
        '-------------------------------------------

        'Disciplinari
        Dpi_Cod = CInt(XML_Ricetta_Operazione.GetAttribute("num_protocollo"))
        DisciplinarePP = CInt(XML_Ricetta_Operazione.GetAttribute("disciplinare_pubblicoprivato"))
        IdRcdpi = CInt(XML_Ricetta_Operazione.GetAttribute("id_rcdpi"))
        Epoca = 0
        Modulo = 0
        If IsTrattamento Then
            Select Case CInt(XML_Ricetta_Operazione.GetAttribute("lav_cod"))
                Case LAVCOD_TRATTAMENTO_ANTIPARASSITARIO, LAVCOD_TRATTAMENTO_FITOREGOLATORE, LAVCOD_CONCIA_SEME, LAVCOD_GEODISINFESTAZIONE, LAVCOD_CONFUSIONE_SESSUALE, LAVCOD_DISORIENTAMENTO_SESSUALE
                    Modulo = CInt(XML_Ricetta_Operazione.GetAttribute("extra_int"))
                Case LAVCOD_DISERBO
                    Epoca = CInt(XML_Ricetta_Operazione.GetAttribute("extra_int"))
            End Select
        End If
        If IsFertilizzazione Then
            Epoca = CInt(XML_Ricetta_Operazione.GetAttribute("extra_int"))
        End If

        If objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Scrittura AndAlso TipoOperazioneAgenda = enum_Tipo_Operazione_Agenda.QuadernoDiCampagna AndAlso Qs_Operazione_Ricetta <> "" _
                AndAlso Not IsDBNull(XML_Ricetta_Operazione.GetAttribute("app_ricetta_operazione_id")) Then
            hf_app_ricetta_operazione_id.Value = XML_Ricetta_Operazione.GetAttribute("app_ricetta_operazione_id").ToString()
        End If

        '##################CARICO IL DISCIPLINARE#######################
        If IsTrattamento OrElse IsFertilizzazione Then

            Select Case Dpi_Cod
                Case 0 'nessuno nessuno caso vecchio
                    If IsTrattamento Then
                        objParametriAgenda.Disciplinare = NessunDpiNessunaEtichetta
                    End If
                    If IsFertilizzazione Then
                        objParametriAgenda.Disciplinare = Dpi_Cod
                    End If
                Case -2 'BIO
                    objParametriAgenda.Disciplinare = Dpi_Cod
                Case -1 'etichetta
                Case Else 'dpi
            End Select

            CType(Page.Master, OperazioneBootstrap).CaricaComboDisciplinariExteso()

            '------------------------------
            'Recupero il DPI
            Dim Disciplinare_Valore As String = ""
            If IsTrattamento Then

                Select Case Dpi_Cod

                    Case 0  'nessun dpi nessun vincolo
                        Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.SelectedIndex =
                                    Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items.IndexOf(Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items.FindByValue(
                                        NessunDpiNessunaEtichetta))
                        objParametriAgenda.Disciplinare = NessunDpiNessunaEtichetta

                    Case -2 'BIO
                        Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.SelectedIndex =
                             Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items.IndexOf(Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items.FindByValue(
                                 Dpi_Cod))
                        objParametriAgenda.Disciplinare = Dpi_Cod

                    Case Is > 0 'DPI
                        Dim Flag_Protetto As Integer = -1
                        Dim Flag_PubblicoPrivato As Integer = 0
                        'Dim IdRcdpi As Integer = 0

                        '02/09/2014 escludo la protezione antigrandine
                        If Cop_Cod <> 0 AndAlso Cop_Cod <> 1 AndAlso Cop_Cod <> 3 AndAlso Cop_Cod <> 4 AndAlso Cop_Cod <> 5 AndAlso Cop_Cod <> 6 Then
                            Copertura = 1
                        End If

                        'cerco il DPI giusto x finalita e copertura
                        Dim Array() As String
                        Dim Disciplinare_Cod As Integer
                        Dim Id_RcdpiTmp As Integer = 0

                        For c = 1 To Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items.Count - 1

                            Array = Split(Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items(c).Value, "/")
                            Disciplinare_Cod = Array(0)
                            If Array.Length > 1 AndAlso Array(1) IsNot Nothing Then
                                Id_RcdpiTmp = Array(1)
                            End If
                            'verifico se il dpi dell'operazione è lo stesso..
                            If Dpi_Cod = Disciplinare_Cod AndAlso IdRcdpi = Id_RcdpiTmp Then
                                Disciplinare_Valore = Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items(c).Value
                                Exit For
                            Else
                                If Dpi_Cod = Disciplinare_Cod Then
                                    Grfi_Cod = Array(2)
                                    Flag_Protetto = Array(3)
                                    Flag_PubblicoPrivato = Array(4)
                                    'verifico se la finalità è = 0 (= tutte x il DPI)
                                    If Grfi_Cod = 0 Then
                                        If Copertura = 1 AndAlso Flag_Protetto = 1 Then
                                            Disciplinare_Valore = Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items(c).Value
                                            'Exit For
                                        ElseIf (Copertura = 0 AndAlso Flag_Protetto = 0) OrElse (Copertura = 0 AndAlso Flag_Protetto = -1) OrElse (Copertura = 0 AndAlso Flag_Protetto = 2) Then
                                            Disciplinare_Valore = Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items(c).Value
                                            'Exit For
                                        End If
                                    Else
                                        'caso in cui nel dpi è indicata la finalità..
                                        'verifico se è uguale a quella dell'impianto
                                        If Grfi_Cod = xGrfi_Cod Then
                                            If Copertura = 1 AndAlso Flag_Protetto = 1 Then
                                                Disciplinare_Valore = Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items(c).Value
                                                Exit For
                                            ElseIf (Copertura = 0 AndAlso Flag_Protetto = 0) OrElse (Copertura = 0 AndAlso Flag_Protetto = -1) OrElse (Copertura = 0 AndAlso Flag_Protetto = 2) Then
                                                Disciplinare_Valore = Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items(c).Value
                                                'Exit For
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        Next

                        'Imposto la selezione della combobox
                        objParametriAgenda.Disciplinare = Disciplinare_Valore

                        Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.SelectedIndex =
                                Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items.IndexOf(Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items.FindByValue(
                                    Disciplinare_Valore))
                End Select

            End If

            If IsFertilizzazione Then
                If Dpi_Cod > 0 Then
                    For c = 1 To Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items.Count - 1
                        If Dpi_Cod = Split(Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items(c).Value, "/")(0) Then

                            Disciplinare_Valore = Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items(c).Value
                            objParametriAgenda.Disciplinare = Disciplinare_Valore

                            Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.SelectedIndex =
                                    Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items.IndexOf(Master_Operazione.Property_ComboDisciplinari.ddl_Disciplinari.Items.FindByValue(
                                        Disciplinare_Valore))
                        End If
                    Next
                End If
            End If

            CambiatoDisciplinare()
        End If
        '##################FINE CARICO DISCIPLINARE#######################



        If Modulo <> 0 Then
            Session("modulo") = Modulo
            If riga_epoca_trattamento.Visible Then
                ComboEpocheDPI1.ddl_ComboEpocheDPI.SelectedIndex =
                        ComboEpocheDPI1.ddl_ComboEpocheDPI.Items.IndexOf(ComboEpocheDPI1.ddl_ComboEpocheDPI.Items.FindByValue(
                                Modulo))
            End If
        End If
        If Epoca <> 0 Then
            If riga_epoca_trattamento.Visible Then
                ComboEpocheDPI1.ddl_ComboEpocheDPI.SelectedIndex =
                        ComboEpocheDPI1.ddl_ComboEpocheDPI.Items.IndexOf(ComboEpocheDPI1.ddl_ComboEpocheDPI.Items.FindByValue(
                                Epoca))
            End If
            If riga_epoca_fertilizzazione.Visible Then
                ComboEpoche.ddl_ComboEpocheFertilizzazione.SelectedIndex =
                        ComboEpoche.ddl_ComboEpocheFertilizzazione.Items.IndexOf(ComboEpoche.ddl_ComboEpocheFertilizzazione.Items.FindByValue(
                                Epoca))
            End If
        End If

        Dim Mezzo As Integer = CInt(XML_Ricetta_Operazione.GetAttribute("mezzo"))

        If IsSemina Then
            Mezzo = 1
        End If

        Select Case Mezzo
            Case 1
                'HA
                Me.rbl_DoseHA.Checked = True
                Me.rbl_DoseHL.Checked = False

            Case 0
                'HL
                Me.rbl_DoseHL.Checked = True
                Me.rbl_DoseHA.Checked = False
        End Select

        '----- ACQUA
        XML_DatiRicetta_Dettagli_Tecnici = XML_Ricetta_Operazione.SelectSingleNode("DatiRicetta_Dettagli_Tecnici")

        If XML_DatiRicetta_Dettagli_Tecnici IsNot Nothing Then

            XMLs_Ricetta_Dettaglio_Tecnico = XML_DatiRicetta_Dettagli_Tecnici.GetElementsByTagName("Ricetta_Dettaglio_Tecnico")

            If XMLs_Ricetta_Dettaglio_Tecnico IsNot Nothing Then
                For i = 0 To XMLs_Ricetta_Dettaglio_Tecnico.Count - 1
                    XML_Ricetta_Dettaglio_Tecnico = XMLs_Ricetta_Dettaglio_Tecnico.Item(i)
                    If CDec(XML_Ricetta_Dettaglio_Tecnico.GetAttribute("qta_ril")) <> 0 Then
                        xQtaAcqua = CDec(XML_Ricetta_Dettaglio_Tecnico.GetAttribute("qta_ril"))
                        'se l'acqua è stata salvata negativa significa che è stata salvata/ha, altrimenti totale
                        If xQtaAcqua < 0 Then
                            Me.Txt_Acqua_Ha.Text = Math.Abs(xQtaAcqua)
                            rblAcqua_HA.Checked = True
                            rblAcqua_Tot.Checked = False
                        Else
                            Me.Txt_Acqua_Tot.Text = Math.Abs(xQtaAcqua)
                            rblAcqua_Tot.Checked = True
                            rblAcqua_HA.Checked = False
                        End If

                    End If
                Next
            End If

        End If

        Dim MovimentiCosti As List(Of Movimento) = New List(Of Movimento)

        XML_DatiRicetta_Dettagli = XML_Ricetta_Operazione.SelectSingleNode("DatiRicetta_Dettagli")

        Dim grfi_cod_x_etichette As Integer = -99

        If XML_DatiRicetta_Dettagli IsNot Nothing Then

            XMLs_Ricetta_Dettaglio = XML_DatiRicetta_Dettagli.GetElementsByTagName("Ricetta_Dettaglio")

            For i = 0 To XMLs_Ricetta_Dettaglio.Count - 1

                XML_Ricetta_Dettaglio = XMLs_Ricetta_Dettaglio.Item(i)

                Cau_Mov = XML_Ricetta_Dettaglio.GetAttribute("cau_mov")

                Elem_Cod = XML_Ricetta_Dettaglio.GetAttribute("elem_cod")
                Pro_Cod = XML_Ricetta_Dettaglio.GetAttribute("pro_cod")
                Mat_Cod = XML_Ricetta_Dettaglio.GetAttribute("mat_cod")

                Lotto = XML_Ricetta_Dettaglio.GetAttribute("lotto")

                Dim Mezzo_det As Integer = XML_Ricetta_Dettaglio.GetAttribute("mezzo_det")

                Movimento = New Movimento

                Movimento.Piva = objParametriAgenda.Piva
                Movimento.Sa_Cod = objParametriAgenda.Sa_Cod
                Movimento.Data = objParametriAgenda.Data
                Movimento.Lav_Cod = objParametriAgenda.Lav_Cod
                Movimento.Cau_Mov = Cau_Mov

                Select Case Cau_Mov

                    Case CAU_LAVORAZIONE

                        If IsFertilizzazione Then

                            Fr_Cod = Pro_Cod '& "/" & Mat_Cod
                            Fr_Des = ""

                            Select Case Mat_Cod

                                Case 0

                                    Dim objFerDes As New AgronicaCoreMetaSchemaDAL.Fertilizzanti_R
                                    Fr_Des = objFerDes.FerDes_from_FerCod(Pro_Cod, objParametri_Server)
                                    objFerDes = Nothing

                                Case Else

                                    Dim objMatDes As New AgronicaCoreAnagrafeDAL.Materie_Prime_R
                                    Fr_Des = objMatDes.MatDes_from_MatCod("", FERTILIZZANTI, Mat_Cod, "", Nothing, "", objParametri_Server)
                                    objMatDes = Nothing

                            End Select

                            Udm_Cod = XML_Ricetta_Dettaglio.GetAttribute("extra_int")
                            Udm_Cod_Trasformato = XML_Ricetta_Dettaglio.GetAttribute("udm_cod")

                            Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
                            Udm_Des = objUdm.UdmDes_from_UdmCod(Udm_Cod, Udm_Sim, objParametri_Server)
                            objUdm = Nothing

                            Dim udmArea As String = AgronicaCoreMetaSchemaDAL.UDM_Helper.GetUdmSim_AREA(objParametri_Server, objParametri_Utenti)

                            If rbl_DoseHL.Checked Then
                                Udm_Des = "[" & Udm_Sim & "/hl]"
                            Else
                                Udm_Des = "[" & Udm_Sim & "/" & udmArea & "]"
                            End If

                            Dose = XML_Ricetta_Dettaglio.GetAttribute("qta")


                        End If

                        If IsSemina Then

                            Fr_Cod = Mat_Cod

                            Dim objMatDes As New AgronicaCoreAnagrafeDAL.Materie_Prime_R
                            Fr_Des = objMatDes.MatDes_from_MatCod("", SEMENTI, Mat_Cod, "", Nothing, "", objParametri_Server)
                            objMatDes = Nothing

                            Udm_Cod = XML_Ricetta_Dettaglio.GetAttribute("udm_cod")
                            Udm_Cod_Trasformato = XML_Ricetta_Dettaglio.GetAttribute("udm_cod")

                            Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
                            Udm_Des = objUdm.UdmDes_from_UdmCod(Udm_Cod, Udm_Sim, objParametri_Server)
                            objUdm = Nothing

                            Dim udmArea As String = AgronicaCoreMetaSchemaDAL.UDM_Helper.GetUdmSim_AREA(objParametri_Server, objParametri_Utenti)

                            If rbl_DoseHL.Checked Then
                                Udm_Des = "[" & Udm_Sim & "/hl]"
                            Else
                                Udm_Des = "[" & Udm_Sim & "/" & udmArea & "]"
                            End If

                            Dose = XML_Ricetta_Dettaglio.GetAttribute("qta")

                        End If


                        If Not PrimoProdotto Then

                            XMLs_RicettaDestinazione = XML_Ricetta_Dettaglio.GetElementsByTagName("Ricetta_Destinazione")

                            Dim idnudo As Integer = 0
                            Dim idnudoold As Integer = 0
                            Dim cambiatonudo As Boolean = False

                            'HO DESTINAZIONI (ricetta aziendale)
                            If XMLs_RicettaDestinazione IsNot Nothing AndAlso XMLs_RicettaDestinazione.Count > 0 Then

                                For j = 0 To XMLs_RicettaDestinazione.Count - 1

                                    XML_RicettaDestinazione = XMLs_RicettaDestinazione.Item(j)

                                    Dim objAppezzamento As New AgronicaCoreModello.ParametriAgenda_Temp.Impianto

                                    objAppezzamento.Piva = CStr(XML_RicettaDestinazione.GetAttribute("piva"))
                                    objAppezzamento.Sa_Cod = CInt(XML_RicettaDestinazione.GetAttribute("sa_cod"))
                                    objAppezzamento.Appezza = CInt(XML_RicettaDestinazione.GetAttribute("appezza"))
                                    objAppezzamento.ID_Reg = CInt(XML_RicettaDestinazione.GetAttribute("id_reg"))
                                    objAppezzamento.Programmazione_Entita_cod = CInt(XML_RicettaDestinazione.GetAttribute("programmazione_entita_cod"))


                                    Dim objImp As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
                                    Dim objPl As New AgronicaCoreAnagrafeDAL.Programmazione_Entita_R

                                    Dim Dt_Imp As New DataTable
                                    If objParametriAgenda.TargetOperazione = enum_Tipo_Operazione_Agenda_Target.Reale Then
                                        Dt_Imp = objImp.Leggi(CStr(XML_RicettaDestinazione.GetAttribute("piva")),
                                                CInt(XML_RicettaDestinazione.GetAttribute("sa_cod")),
                                                CInt(XML_RicettaDestinazione.GetAttribute("appezza")),
                                                CInt(XML_RicettaDestinazione.GetAttribute("id_reg")),
                                                enumSelezioneVariabile.Selezione_JoinDescrizioni,
                                                "", "", objParametri_Server)
                                    Else
                                        Dt_Imp = objPl.Leggi_solo_Programmazione_entita(objParametriAgenda.Programmazione_Cod, objAppezzamento.Programmazione_Entita_cod, objParametri_Server)
                                    End If

                                    If j = 0 Then
                                        objParametriAgenda.Veg_Cod = CInt(Dt_Imp.Rows(0).Item("veg_cod"))
                                    End If

                                    'per operazione su terreno nudo,
                                    'se sempre la solita destinazione la setto nel veg_cod, altrimenti lascio 0
                                    If objParametriAgenda.Veg_Cod = 0 AndAlso CInt(Dt_Imp.Rows(0).Item("id_cod")) <> 0 Then
                                        If j = 0 Then
                                            idnudo = CInt(Dt_Imp.Rows(0).Item("id_cod"))
                                            idnudoold = idnudo
                                        Else
                                            idnudo = CInt(Dt_Imp.Rows(0).Item("id_cod"))
                                            If idnudoold <> idnudo Then
                                                cambiatonudo = True
                                            End If
                                        End If
                                        If j = XMLs_RicettaDestinazione.Count - 1 Then
                                            If cambiatonudo Then
                                                objParametriAgenda.Veg_Cod = "0"
                                            Else
                                                objParametriAgenda.Veg_Cod = "0/" & idnudo
                                            End If
                                        End If
                                    End If

                                    Dim x_sup_imp As String
                                    If objParametriAgenda.TargetOperazione = enum_Tipo_Operazione_Agenda_Target.Reale Then
                                        x_sup_imp = "sup_imp"
                                    Else
                                        x_sup_imp = "superficie"
                                    End If

                                    objAppezzamento.Qta2 = CDec(XML_RicettaDestinazione.GetAttribute("qta2"))
                                    If objAppezzamento.Qta2 = 0 Then
                                        If Dt_Imp.Rows.Count > 0 Then
                                            objAppezzamento.Qta2 = Dt_Imp.Rows(0).Item(x_sup_imp)
                                        End If
                                    End If
                                    Sup_Tot_Sel += CDec(objAppezzamento.Qta2)
                                    If Dt_Imp.Rows.Count > 0 Then
                                        Sup_Tot += Dt_Imp.Rows(0).Item(x_sup_imp)
                                    End If

                                    objParametriAgenda.Impianti.Add(objAppezzamento)
                                    objParametriAgenda.salva()

                                Next


                                Txt_SupSelezionata.Value = Sup_Tot
                                Txt_SupTrattata.Value = Sup_Tot_Sel

                                '  TODO: Vanni, 19/09/2016 18:07:50: capire questa cosa. ...
                                If objParametriAgenda.TargetOperazione = enum_Tipo_Operazione_Agenda_Target.Planning Then
                                    Master_Operazione.Inserisci_Impianti_Della_Ricetta(objParametriAgenda.Impianti)
                                End If

                            Else

                                'NON HO DESTINAZIONI (linea tecnica)

                                Sup_Tot = Txt_SupSelezionata.Value
                                Sup_Tot_Sel = Txt_SupTrattata.Value

                            End If

                            PrimoProdotto = True

                            'se l'acqua è stata salvata negativa significa che è stata salvata/ha, altrimenti totale
                            If xQtaAcqua <> 0 Then
                                Select Case xQtaAcqua
                                    Case Is < 0
                                        Me.Txt_Acqua_Tot.Text = Math.Abs(xQtaAcqua) * Sup_Tot_Sel
                                    Case Else
                                        Me.Txt_Acqua_Ha.Text = Math.Abs(xQtaAcqua) / Sup_Tot_Sel
                                End Select
                            End If

                        End If

                        If IsFertilizzazione Then

                            Ha_Hl = Mezzo_det

                            Select Case CInt(XML_Ricetta_Operazione.GetAttribute("lav_cod"))
                                Case LAVCOD_DISTRIBUZIONE_CONCIME, LAVCOD_SARCHIATURA_CONCIMAZIONE, LAVCOD_DISTRIBUZIONE_AMMENDANTI
                                    Ha_Hl = enum_TipoMezzo.Ettaro
                            End Select

                            If Ha_Hl = enum_TipoMezzo.Indefinito Then
                                If rbl_DoseHA.Checked Then
                                    '/ha
                                    Dose_Totale = Math.Round(Dose * Sup_Tot_Sel, 4)
                                    Dose_HA = Dose

                                    Dim app As Decimal
                                    If xQtaAcqua < 0 Then
                                        app = (Math.Abs(xQtaAcqua) * Sup_Tot_Sel)
                                    Else
                                        app = xQtaAcqua
                                    End If

                                    If IsNumeric(app) AndAlso app > 0 Then
                                        Dose_HL = CDbl(Dose_Totale / app)
                                    End If
                                Else
                                    '/hl o totale
                                    If xQtaAcqua < 0 Then
                                        Dose_Totale = Math.Round(Dose * (Math.Abs(xQtaAcqua) * Sup_Tot_Sel), 4)
                                    Else
                                        Dose_Totale = Math.Round(Dose * xQtaAcqua)
                                    End If

                                    Dose_HL = Dose
