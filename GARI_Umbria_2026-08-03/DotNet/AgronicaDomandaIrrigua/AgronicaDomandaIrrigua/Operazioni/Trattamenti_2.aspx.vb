                    'Messaggi.AgroMsgBuonFine("NB: Esistono costi collegati a questa operazione.", Page, , CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                    Master.Property_hf_esistonoCostiCollegatiCDG = True
                    Exit For
                End If
            Next

        End If

        'aggiorno il Datagrid delle dosi
        Griglia_Dosi_Data_Bind()

        'per le concimazioni carico ele epoche ed eventualmente setto la combo
        If IsFertilizzazione Then

            If Not IsNothing(objParametriAgenda.Veg_Cod) AndAlso
                           objParametriAgenda.Veg_Cod.Split("/")(0) <> "" AndAlso
                           objParametriAgenda.Veg_Cod.Split("/")(0) <> "-1" Then

                ComboEpoche.Veg_Cod = objParametriAgenda.Veg_Cod.Split("/")(0)

                ComboEpoche.PrimaRiga_Flag = True
                ComboEpoche.PrimaRiga_Text = ""
