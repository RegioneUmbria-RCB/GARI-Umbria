    Protected Sub cambioAvversita()

        Dim Udm_Cod As Integer = 0
        Dim DoseMin, DoseMax As Decimal
        Dim AcquaMin, AcquaMax As Decimal
        Dim AcquaUdm_Cod As Integer = 0

        Dim DoseTrovata As Boolean = False
        Dim ArrayDose() As String

        Dim Av_Cod As Integer = 0
        Dim Av_Gru As Integer = 0
        Dim i As Integer = 0

        Dim FormulatiXAllegatiNormative_IDRiga As Integer

        '----------------------------------
        'pulisco i controlli etichetta
        Av_Cod = 0
        Av_Gru = 0
        Cmb_UdM.Items.Clear()
        ComboEtichetta.ddl_Dosi.Items.Clear()
        Lbl_Dose_Consigliata.Text = ""
        Lbl_Giacenza.Text = ""
        Lbl_GiacenzaTotale.Text = ""

        Txt_Dose_HA.Text = "0"
        Txt_Dose_HL.Text = "0"
        Txt_DoseTot_HA.Text = "0"

        Resettasession_Etichetta()

        ddl_soglieAvversita.Items.Clear()
        Riga_Soglia.Visible = False

        '----------------------------

        Session("D_HA_Max_Diserbo") = 0


        Dim Fr_Cod As Integer = 0
        If ComboFormulati.Valore_Combo <> "" Then
            Fr_Cod = ComboFormulati.Valore_Combo.Split("£")(0)
        End If
        If Fr_Cod = 0 Then
            Exit Sub
        End If
        Dim Veg_Cod As Integer = objParametriAgenda.Veg_Cod.Split("/")(0)

        CaricaComboUnitadiMisura()

        If ddl_avversita.SelectedValue = "" Then
            Exit Sub
        Else
            If Split(ddl_avversita.SelectedValue, "|")(0) <> "0" Then
                Av_Cod = Split(ddl_avversita.SelectedValue, "|")(0)
            Else
                Av_Gru = Split(ddl_avversita.SelectedValue, "|")(1)
            End If
            If Split(ddl_avversita.SelectedValue, "|").Length > 2 Then
                FormulatiXAllegatiNormative_IDRiga = Split(ddl_avversita.SelectedValue, "|")(3)
            End If
        End If

        'Lbl_Dose_Etichetta.Text = Resources.AgronicaAgenda_2010.NonDisponibile

        'Dim Dose_Consigliata As Decimal = 0
        'Dim Dose_Consigliata_Udm As Integer = 0
        Dim grfi_cod As Integer = 0
        grfi_cod = IdentificaGrfi_Cod()
        If grfi_cod = -999 Then
            Dim strJSs As New StringBuilder
            strJSs.AppendLine("$(document).ready(function () { ")
            strJSs.AppendLine("      alert('Selezionare gli impianti'); ")
            strJSs.AppendLine(" });")
            ScriptManager.RegisterClientScriptBlock(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType(),
                                              String.Format("jQuery_{0}", UpdatePanel_Prodotti.ClientID), strJSs.ToString, True)
            Exit Sub
        End If

        '(11/01/2018 fede) aggiunto filtro copertura
        Dim Copertura As String
        Copertura = IdentificaCopertura()

        If Copertura = "-999" Then
            Dim strJSs As New StringBuilder
            strJSs.AppendLine("$(document).ready(function () { ")
            strJSs.AppendLine("      alert('Selezionare gli impianti'); ")
            strJSs.AppendLine(" });")
            ScriptManager.RegisterClientScriptBlock(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType(),
                                              String.Format("jQuery_{0}", UpdatePanel_Prodotti.ClientID), strJSs.ToString, True)
            Exit Sub
        End If



        'controllo se ho una unità di misura da magazzino
        Dim Udm_Da_Magazzino As Integer

        Dim ArrayTmp() As String = Split(ComboFormulati.Valore_Combo, "£")

        If ArrayTmp.Length > 16 AndAlso IsNumeric(ArrayTmp(16)) AndAlso CInt(ArrayTmp(16)) <> 0 Then
            Udm_Da_Magazzino = ArrayTmp(16)
        Else
            Udm_Da_Magazzino = -99
        End If

        '--------------------------------------

        If Veg_Cod <> 0 AndAlso Fr_Cod <> 0 AndAlso objParametriAgenda.Disciplinare <> NessunDpiNessunaEtichetta Then

            ComboEtichetta.Lav_Cod = objParametriAgenda.Lav_Cod
            ComboEtichetta.Fr_Cod = Fr_Cod
            ComboEtichetta.Veg_Cod = Veg_Cod
            ComboEtichetta.Av_Cod = Av_Cod
            ComboEtichetta.Av_Gru = Av_Gru
            ComboEtichetta.Grfi_Cod = grfi_cod
            ComboEtichetta.WS_Fitofarmaci_AgroWS_Fitofarmaci = objParametriAgenda.WS_Fitofarmaci_AgroWS_Fitofarmaci
            ComboEtichetta.Data = objParametriAgenda.Data

            ComboEtichetta.FormulatiXAllegatiNormative_IDRiga = FormulatiXAllegatiNormative_IDRiga

            ComboEtichetta.Copertura = Copertura

            Dim TipoRichiesto As Integer = 0
            'Dim ArrayTmp() As String

            'If ComboFormulati.Valore_Combo <> "" Then

            'ArrayTmp = Split(ComboFormulati.Valore_Combo, "£")

            If ArrayTmp.Length > 6 Then
                If ArrayTmp(6) <> "" Then
                    TipoRichiesto = ArrayTmp(6)
                Else
                    TipoRichiesto = 0
                End If
            End If

            'End If

            ComboEtichetta.TipoRichiesto = TipoRichiesto
            ComboEtichetta.CaricaComboEtichetta()


            Select Case objParametriAgenda.Lav_Cod
                Case LAVCOD_DISERBO, LAVCOD_DISSECCAMENTO
                    If CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Valore_Combo <> "0" Then
                        If objParametriAgenda.Fabbricato.Split("|").Length > 1 Then
                            Dim splitArr = objParametriAgenda.Fabbricato.Split("|")
                            Imposta_DoseConsentitaDiserbo(Fr_Cod, splitArr(2), splitArr(1), splitArr(0))
                        Else
                            Imposta_DoseConsentitaDiserbo(Fr_Cod, objParametriAgenda.Piva, 0, 0)
                        End If

                    End If
            End Select

            If ComboEtichetta.ddl_Dosi.Items.Count > 0 Then

                If ComboEtichetta.Valore_Combo <> "0" Then

                    ArrayDose = Split(ComboEtichetta.Valore_Combo, "$")

                    If ArrayDose IsNot Nothing AndAlso ArrayDose.Length > 1 Then

                        DoseTrovata = True

                        '----
                        'Acqua
                        AcquaMin = ArrayDose(5)
                        AcquaMax = ArrayDose(6)
                        AcquaUdm_Cod = ArrayDose(7)
                        Imposta_VolumiAcqua(AcquaMin, AcquaMax, AcquaUdm_Cod)

                        Udm_Cod = ArrayDose(3)

                        Dim Udm_Radice, per_ha_hl As Integer
                        Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
                        objUdm.ScomponiUdm(Udm_Radice, per_ha_hl, CInt(Udm_Cod))
                        If Udm_Da_Magazzino <> -99 Then
                            Dim v As Integer
                            Select Case Udm_Radice
                                Case 3, 2032, 2, 304, 4
                                    v = 2
                                        'acqua
                                Case 104, 101, 29
                                    v = 29
                            End Select
                            If Udm_Da_Magazzino = v Then
                                Imposta_DosiEtichetta(ComboEtichetta.Valore_Combo)
                            End If
                        Else
                            Imposta_DosiEtichetta(ComboEtichetta.Valore_Combo)
                        End If

                    End If

                    'dosi multiple
                    Dim kg As Boolean = False
                    Dim l As Boolean = False
                    If ComboEtichetta.ddl_Dosi.Items.Count > 1 Then

                        'If Not IsNothing(Giacenze) AndAlso Giacenze.Keys.Count = 1 Then
                        If ArrayTmp.Length > 16 AndAlso ArrayTmp(16) <> "" Then
                            'carico solo le udm indicate da magazzino
                        Else
                            For i = 0 To ComboEtichetta.ddl_Dosi.Items.Count - 1

                                Udm_Cod = Split(ComboEtichetta.ddl_Dosi.Items(i).Value, "$")(3)

                                'controllo se è sempre lo stesso
                                Dim Udm_Radice, per_ha_hl As Integer
                                Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
                                objUdm.ScomponiUdm(Udm_Radice, per_ha_hl, CInt(Udm_Cod))

                                Select Case Udm_Radice
                                    Case 3, 2032, 2, 304, 4
                                        kg = True
                                            'acqua
                                    Case 104, 101, 29
                                        l = True
                                End Select
                            Next

                            If kg AndAlso l Then
                                'preseleziono il valore precedente
                                Dim valSel As Integer = Cmb_UdM.SelectedValue
                                Cmb_UdM.Items.Clear()
                                'ricarico con tutte le unita di misura
                                CaricaKGeLitri(valSel)
                            End If
                        End If

                    End If


                End If

            End If

            'Select Case objParametriAgenda.Lav_Cod
            '    Case LAVCOD_DISERBO, LAVCOD_DISSECCAMENTO
            '        If CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Valore_Combo <> "0" Then
            '            Imposta_DoseConsentitaDiserbo(Fr_Cod)
            '        End If
            'End Select

            If Not DoseTrovata Then

                DoseMin = 0
                DoseMax = 0
                Udm_Cod = 0
                Dim objDPILeggi As New AgronicaCoreDpiBIZ.Fitofarmaci_Leggi
                objDPILeggi.Recupera_UdM_da_FrCod(Nothing,
                                                        Fr_Cod,
                                                        Udm_Cod,
                                                        Nothing,
                                                        Nothing,
                                                        Session)

                Select Case Udm_Cod
                    Case 2
                        CaricaKG(Udm_Cod)
                    Case 29
                        CaricaLitri(Udm_Cod)
                End Select
            End If

        End If

        'End If

        'reinserisco i controlli 
        pnlBtnRilievo.Visible = False
        Dim objAgroWebConfig As New AgroWebConfig
        If Session("Collegamento_DPI") = True AndAlso
                     CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Valore_Combo <> NessunDpiNessunaEtichetta AndAlso
                   CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Valore_Combo <> "0" AndAlso
                    CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Valore_Combo <> "-2" Then
            Carica_SoglieIntervento_Avversita()

            ''==========================================================================================================================
            ''Localizzazioni
            ''--------------------------------------------------------------------------------------------------------------------------
            Dim DTLocalizzazioni As New DataTable
            Dim strErrLocalizzazioni As String = ""
            Dim DescrizioneLocalizzazione As String = ""

            DTLocalizzazioni = Carica_Localizzazione(strErrLocalizzazioni)

            If DTLocalizzazioni Is Nothing OrElse Trim(strErrLocalizzazioni) <> "" Then
                DescrizioneLocalizzazione = strErrLocalizzazioni
            Else
                If DTLocalizzazioni.Rows.Count > 0 Then

                    'Visualizzazione descrizione
                    If DTLocalizzazioni.Rows(0).Item("TL_COD") <> 0 Then

                        DescrizioneLocalizzazione = DTLocalizzazioni.Rows(0).Item("TL_DES")

                    End If

                End If

            End If

            If Trim(DescrizioneLocalizzazione) <> "" Then

                If Riga_NoteProdotto.Visible Then
                    Lbl_NoteProdotto.InnerText = Lbl_NoteProdotto.InnerText & ". " & DescrizioneLocalizzazione
                Else
                    Lbl_NoteProdotto.InnerText = DescrizioneLocalizzazione
                    Riga_NoteProdotto.Visible = True
                End If


            End If

        End If
        ''==========================================================================================================================



        If Not statoEspansione Then

            ScriptManager.RegisterStartupScript(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType(),
                                      String.Format("jQuery_{0}", ComboEtichetta.ClientID), ComboEtichetta.GetJS(), True)
            '    statoEspansione = True

        End If

