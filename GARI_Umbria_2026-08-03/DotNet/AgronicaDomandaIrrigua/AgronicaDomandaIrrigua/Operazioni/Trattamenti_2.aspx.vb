    Private Sub Carica_Avversita(Optional ByVal FrCod As Integer = 0, Optional ByVal FormulatiXAllegatiNormative_IDRiga As Integer = 0)

        ddl_avversita.Items.Clear()

        Dim Modulo, Epoca As Integer

        Dim ObjDownloadWs As WS_Disciplinari.AgroWS_Disciplinari
        Dim i As Integer

        Dim Array() As String
        Dim Dpi_Cod As Integer = 0
        Dim IdRcdpi As Integer = 0
        Dim Grfi_Cod As Integer = 0
        Dim Flag_Protetto As Integer = 0
        Dim Flag_PubblicoPrivato As Integer = 0

        Dim DtAvv As New DataTable
        DtAvv.TableName = "Av_Des"
        Dim Dr As DataRow

        DtAvv.Columns.Add(New DataColumn("Av_Des", GetType(String)))
        DtAvv.Columns.Add(New DataColumn("Av_Cod", GetType(Integer)))
        DtAvv.Columns.Add(New DataColumn("Av_Gru", GetType(Integer)))
        DtAvv.Columns.Add(New DataColumn("For_Veg_Av_Cod", GetType(Integer)))

        Dim DtKeys(2) As DataColumn
        DtKeys(0) = DtAvv.Columns("For_Veg_Av_Cod")
        DtKeys(1) = DtAvv.Columns("Av_Cod")
        DtKeys(2) = DtAvv.Columns("Av_Gru")
        DtAvv.PrimaryKey = DtKeys


        If objParametriAgenda.Veg_Cod.Split("/")(0) = "" Then
            objParametriAgenda.Veg_Cod = 0
        End If
        '---------------------------------------------------------------
        If objParametriAgenda.Veg_Cod.Split("/")(0) = "" OrElse objParametriAgenda.Veg_Cod.Split("/")(0) = "-1" Then
            'If objParametriAgenda.Veg_Cod = "" OrElse objParametriAgenda.Veg_Cod = "0" OrElse objParametriAgenda.Veg_Cod = "-1" Then
            'AgroMsgBox("Selezionare la Specie Vegetale!", Page)
            Exit Sub
        End If

        'nel caso filtro prod --> avv se non ho scelto un formulato non carico nulla
        If FrCod = 0 AndAlso objParametriAgenda.FiltroRicerca = "1" Then
            Exit Sub
        End If

        Dim TipoTestata As Integer = 0

        'controllo se devo caricare i fitofarmaci o i diserbanti
        Select Case objParametriAgenda.Lav_Cod

            Case LAVCOD_TRATTAMENTO_ANTIPARASSITARIO, LAVCOD_CONCIA_SEME, LAVCOD_GEODISINFESTAZIONE, LAVCOD_TRATTAMENTO_FITOREGOLATORE,
                     LAVCOD_CONFUSIONE_SESSUALE, LAVCOD_DISORIENTAMENTO_SESSUALE
                If objParametriAgenda.Veg_Cod.Split("/")(0) = -1 Then
                    Exit Sub
                End If
                If objParametriAgenda.Veg_Cod.Split("/")(0) <> "0" Then
                    TipoTestata = 0
                Else
                    'per i terreni nudi, permetto l'operazione con nessuno nessuno
                    If CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Valore_Combo = NessunDpiNessunaEtichetta Then
                        TipoTestata = 0
                    Else
                        Exit Sub
                    End If
                End If

            Case LAVCOD_DISERBO
                TipoTestata = 1

            Case LAVCOD_DISSECCAMENTO
                If objParametriAgenda.Veg_Cod.Split("/")(0) <> 0 Then
                    TipoTestata = 1
                Else
                    Exit Sub
                End If

        End Select

        Select Case Session("Collegamento_Fito")

                '----------------------------------
                ' WEB SERVICE
                '---------------------------------- 

            Case True


                If Session("Collegamento_DPI") = True Then

                    Select Case objParametriAgenda.Disciplinare
                        Case NessunDpiNessunaEtichetta
                            'nel caso di nessun dpi nessuna etichetta carico le avv/gruppi filtrati solo sulla specie e la data
                            If objParametriAgenda.Disciplinare = NessunDpiNessunaEtichetta Then
                                FrCod = 0
                            End If
                    End Select


                    Array = Split(CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Valore_Combo, "/")

                    If Array(0) <> "" Then
                        Dpi_Cod = Array(0)

                        If Array.Length > 1 Then
                            IdRcdpi = Array(1)
                            Grfi_Cod = Array(2)
                            Flag_Protetto = Array(3)
                            Flag_PubblicoPrivato = Array(4)
                        End If

                        'If IdRcdpi > 0 Then

                        Modulo = 0
                        Epoca = 0

                        If riga_epoca_trattamento.Visible Then
                            If TipoTestata = 0 Then
                                Modulo = CInt(ComboEpocheDPI1.ddl_ComboEpocheDPI.SelectedValue)
                            Else
                                Epoca = CInt(ComboEpocheDPI1.ddl_ComboEpocheDPI.SelectedValue)
                            End If
                        End If

                        ObjDownloadWs = New WS_Disciplinari.AgroWS_Disciplinari
                        Dim objWs As New AgronicaCoreVarieDAL.ConnessioneWS
                        Dim objAgroWs As New AgronicaCoreGestioneRichieste.AgroWebConfig
                        objWs.NewWS(ObjDownloadWs, objAgroWs.GiasOnline_WS_Disciplinari_AgroWS_Disciplinari, objParametri_Utenti)

                        Dim XmlDoc As New System.Xml.XmlDocument
                        Dim XML_Credenziali As System.Xml.XmlElement
                        Dim StrCredenziali As String = ""
                        Dim StrParametri As String = ""
                        Dim Parametri As String = ""
                        Dim objCoreAgroWs As New AgronicaCoreWebService.AgroWs
                        Dim strErr As String = ""
                        objCoreAgroWs.AgroWS_XML__Credenziali(AgronicaCoreWebService.AgroWs.enum_AWS_Xml.Xml_CODIFICA,
                                                    StrCredenziali,
                                                    AgronicaCoreWebService.AgroWs.enum_AWS_Schede.AWS_Fitofarmaci_Formulati_SpecieVegetali_Avversita,
                                                    objCoreAgroWs.AgroWS_DoorKey(AgronicaCoreWebService.AgroWs.enum_AWS_Schede.AWS_Fitofarmaci_Formulati_SpecieVegetali_Avversita),
                                                    HttpContext.Current.Session("ASG_ProgressivoGIAS"),
                                                    HttpContext.Current.Session("ASG_SuperUser_CodFiscale").ToString,
                                                    HttpContext.Current.Session("ASG_SuperUser_Username").ToString,
                                                    HttpContext.Current.Session("ASG_SuperUser_Password").ToString,
                                                    HttpContext.Current.Session("ASG_Utente_Username").ToString,
                                                    HttpContext.Current.Session("ASG_Utente_Password").ToString)

                        XmlDoc.LoadXml(StrCredenziali)

                        XML_Credenziali = XmlDoc.SelectSingleNode("CREDENZIALI")

                        Dim Storico As Boolean = True
                        If objParametriAgenda.FiltroRicerca = "2" Then
                            Storico = False
                        End If

                        'verifico i comuni (in base al catasto degli appezzamenti)
                        Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
                        ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()

                        Dim ListaComuni As New List(Of AgronicaControlli_2010.Comune)
                        Dim ComunePresente As Boolean = False
                        If ListaImpianti IsNot Nothing Then
                            For i = 0 To ListaImpianti.Count - 1
                                If ListaImpianti(i).ListaParticelle IsNot Nothing Then
                                    For p = 0 To ListaImpianti(i).ListaParticelle.Count - 1
                                        ComunePresente = False
                                        For c = 0 To ListaComuni.Count - 1
                                            If (ListaComuni(c).Prov = ListaImpianti(i).ListaParticelle(p).Provincia AndAlso
                                            ListaComuni(c).Com = ListaImpianti(i).ListaParticelle(p).Comune) Then
                                                ComunePresente = True
                                                Exit For
                                            End If
                                        Next
                                        If Not ComunePresente Then
                                            Dim Comune As New AgronicaControlli_2010.Comune
                                            Comune.Prov = ListaImpianti(i).ListaParticelle(p).Provincia
                                            Comune.Com = ListaImpianti(i).ListaParticelle(p).Comune
                                            ListaComuni.Add(Comune)
                                        End If
                                    Next
                                End If

                            Next
                        End If
                        'se gli appezzamenti non hanno catasto 
                        'prendo l'indirizzo del centro
                        If ListaComuni.Count = 0 Then
                                Dim objCentro As New AgronicaCoreAnagrafeDAL.CentriAziendali_Read
                                Dim DtCentro As DataTable
                                DtCentro = objCentro.Leggi(objParametriAgenda.Piva, objParametriAgenda.Sa_Cod, enumSelezioneVariabile.Selezione_JoinDescrizioni, "", "", objParametri_Server)
                                If DtCentro.Rows.Count > 0 Then
                                    Dim Comune As New AgronicaControlli_2010.Comune
                                    Comune.Prov = DtCentro.Rows(0).Item("pro_cod_istat")
                                    Comune.Com = DtCentro.Rows(0).Item("com_cod_istat")
                                    ListaComuni.Add(Comune)
                                End If
                            End If
                            Dim strListaComuni As String = ""
                            For c = 0 To ListaComuni.Count - 1
                                strListaComuni &= ListaComuni(c).Prov & ListaComuni(c).Com & ","
                            Next
                            If strListaComuni <> "" Then
                                strListaComuni = Left(strListaComuni, strListaComuni.Length - 1)
                            End If

                            Dim objUtility As New AgronicaControlli_2010.STD_Utility

                            Dim strTipiRichiesti As String = objUtility.GetTipiFormulatiRichiesti(objParametriAgenda.Lav_Cod)

                            objCoreAgroWs.AgroWS_XML_Parametri_Avversita(AgronicaCoreWebService.AgroWs.enum_AWS_Xml.Xml_CODIFICA,
                                                                            StrParametri,
                                                                            FrCod,
                                                                            objParametriAgenda.Veg_Cod.Split("/")(0),
                                                                            IdRcdpi, Dpi_Cod, Flag_PubblicoPrivato, TipoTestata,
                                                                            0,
                                                                            0, 0,
                                                                            0, 0,
                                                                            0, "",
                                                                            CInt(Modulo), CInt(Epoca),
                                                                            FormulatiXAllegatiNormative_IDRiga,
                                                                            Storico,
                                                                            objParametri_Server.Lingua_Cod,
                                                                            "",
                                                                            "",
                                                                            objParametriAgenda.Data,
                                                                            strListaComuni,
                                                                            strTipiRichiesti,
                                                                            strErr)

                            XML_Credenziali.InnerXml = StrParametri

                            Parametri = XmlDoc.OuterXml

                            Parametri = objCoreAgroWs.AWS_Codifica_P(Parametri)

                            DtAvv = ObjDownloadWs.Leggi_Infestanti_conDescrizioniAvversita_DT(Parametri, strErr)

                            ObjDownloadWs = Nothing
                            objWs = Nothing

                            If IsNothing(DtAvv) OrElse DtAvv.Rows.Count = 0 Then
                                Select Case Dpi_Cod
                                    Case > 0
                                        If TipoTestata = 0 Then
                                            Messaggi.AgroMsgBox("Non è stata trovata corrispondenza tra le Avversità indicate in etichetta e quelle del disciplinare! Il prodotto non è utilizzabile con il disciplinare indicato!", Page, ,
                                            CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                                        Else
                                            Messaggi.AgroMsgBox("Non è stata trovata corrispondenza tra le Infestanti indicate in etichetta e quelle del disciplinare! Il prodotto non è utilizzabile con il disciplinare indicato!", Page, ,
                                         CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                                        End If
                                    Case Else
                                        If TipoTestata = 0 Then
                                            Messaggi.AgroMsgBox("Nessuna Avversità Trovata!", Page, ,
                                            CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                                        Else
                                            Messaggi.AgroMsgBox("Nessuna Infestante Trovata!", Page, ,
                                            CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                                        End If
                                End Select
                                Exit Sub
                            End If

                            'End If
                        End If

                    End If

            Case Else

                '----------------------------------
                ' METASCHEMA LOCALE
                '---------------------------------- 

                Dim filtroAvv As String
                Dim DtAvvTmp As DataTable
                Dim DtAvvGruTmp As DataTable

                If TipoTestata = 0 Then
                    'TRATTAMENTO

                    'filtro infestanti/gruppi infestanti
                    filtroAvv &= "  NOT EXISTS (SELECT *	FROM InfestantiAttive " &
                                       " WHERE InfestantiAttive.Av_Cod = Avversita.Av_Cod ) "

                    'elimino avversita/gruppi con (#) e non usare IN SCRITTURA
                    filtroAvv &= " AND Avversita.Av_Des_Vol NOT LIKE '%non usare%' " &
                                     " AND Avversita.Av_Des_Vol NOT LIKE '%(#)%' "

                    Dim objAvv As New AgronicaCoreMetaSchemaDAL.Avversita_R
                    DtAvvTmp = objAvv.Leggi(0, "",
                                            AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaDatiMinimi,
                                            filtroAvv,
                                            "",
                                            objParametri_Server)
                    objAvv = Nothing
                    If Not IsNothing(DtAvvTmp) Then
                        For i = 0 To DtAvvTmp.Rows.Count - 1
                            Dr = DtAvv.NewRow
                            Dr.Item("Av_Des") = DtAvvTmp.Rows(i).Item("Av_Des_Vol") & " (" & DtAvvTmp.Rows(i).Item("Av_Des_Lat") & ")"
                            Dr.Item("Av_Cod") = DtAvvTmp.Rows(i).Item("Av_Cod")
                            Dr.Item("Av_Gru") = 0
                            DtAvv.Rows.Add(Dr)
                        Next
                    End If

                    '-----------------------
                    'GRUPPI
                    Dim filtroAvvGru As String
                    'filtro infestanti/gruppi infestanti
                    filtroAvvGru = "  NOT EXISTS (SELECT *	FROM GruppoAvversitaAttive " &
                                     " WHERE GruppoAvversitaAttive.Av_Gru = GruppoAvversita.Av_Gru ) "

                    'elimino avversita/gruppi con (#) e non usare IN SCRITTURA
                    filtroAvvGru &= " AND GruppoAvversita.Av_Gru_Des NOT LIKE '%non usare%' " &
                                        " AND GruppoAvversita.Av_Gru_Des NOT LIKE '%(#)%' "

                    'End If
                    Dim objAvvGru As New AgronicaCoreMetaSchemaDAL.GruppoAvversita_R
                    DtAvvGruTmp = objAvvGru.Leggi(0, 0,
                                            AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaDatiMinimi,
                                            filtroAvvGru,
                                            "",
                                            objParametri_Server)
                    objAvvGru = Nothing
                    If Not IsNothing(DtAvvGruTmp) Then
                        For i = 0 To DtAvvGruTmp.Rows.Count - 1
                            Dr = DtAvv.NewRow
                            Dr.Item("Av_Des") = DtAvvGruTmp.Rows(i).Item("Av_Gru_Des") & " (" & DtAvvGruTmp.Rows(i).Item("Av_Gru_Des_Lat") & ")"
                            Dr.Item("Av_Cod") = 0
                            Dr.Item("Av_Gru") = DtAvvGruTmp.Rows(i).Item("Av_Gru")
                            DtAvv.Rows.Add(Dr)
                        Next
                    End If

                Else
                    'DISERBO

                    'filtro infestanti/gruppi infestanti
                    'elimino avversita/gruppi con (#) e non usare IN SCRITTURA
                    filtroAvv &= " Avversita.Av_Des_Vol NOT LIKE '%non usare%' " &
                                     " AND Avversita.Av_Des_Vol NOT LIKE '%(#)%' "

                    Dim objAvv As New AgronicaCoreMetaSchemaDAL.InfestantiAttive_R
                    DtAvvTmp = objAvv.Leggi(0, 0,
                                            AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaDatiMinimi,
                                            filtroAvv,
                                            "",
                                            objParametri_Server)
                    objAvv = Nothing
                    If Not IsNothing(DtAvvTmp) Then
                        For i = 0 To DtAvvTmp.Rows.Count - 1
                            Dr = DtAvv.NewRow
                            Dr.Item("Av_Des") = DtAvvTmp.Rows(i).Item("Av_Des_Vol") & " (" & DtAvvTmp.Rows(i).Item("Av_Des_Lat") & ")"
                            Dr.Item("Av_Cod") = DtAvvTmp.Rows(i).Item("Av_Cod")
                            Dr.Item("Av_Gru") = 0 ' DtAvvTmp.Rows(i).Item("Av_Gru")
                            DtAvv.Rows.Add(Dr)
                        Next
                    End If



                    '-----------------------
                    'GRUPPI
                    Dim filtroAvvGru As String
                    'filtro infestanti/gruppi infestanti
                    'elimino avversita/gruppi con (#) e non usare IN SCRITTURA
                    filtroAvvGru = " GruppoAvversita.Av_Gru_Des NOT LIKE '%non usare%' " &
                                        " AND GruppoAvversita.Av_Gru_Des NOT LIKE '%(#)%' "

                    Dim objAvvGru As New AgronicaCoreMetaSchemaDAL.GruppoAvversitaAttive_R
                    DtAvvGruTmp = objAvvGru.Leggi(0, 0,
                                            AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaDatiMinimi,
                                            filtroAvvGru,
                                            "",
                                            objParametri_Server)

                    If Not IsNothing(DtAvvGruTmp) Then
                        For i = 0 To DtAvvGruTmp.Rows.Count - 1
                            Dr = DtAvv.NewRow
                            Dr.Item("Av_Des") = DtAvvGruTmp.Rows(i).Item("Av_Gru_Des") & " (" & DtAvvGruTmp.Rows(i).Item("Av_Gru_Des_Lat") & ")"
                            Dr.Item("Av_Cod") = 0
                            Dr.Item("Av_Gru") = DtAvvGruTmp.Rows(i).Item("Av_Gru")
                            DtAvv.Rows.Add(Dr)
                        Next

                    End If

                End If

        End Select


        '----------------------------------------------------------------------
        '----- Associo il DataTable con la DataGrid

        'uso il dataview per ordinare
        Dim DvAvv As New DataView
        DvAvv.Table = DtAvv
        DvAvv.Sort = "Av_Des ASC"

        Dim dt As DataTable = DvAvv.ToTable
        For i = 0 To dt.Rows.Count - 1
            If IsDate(dt.Rows(i).Item("datasmaltimentoscorte")) Then
                ddl_avversita.Items.Add(New ListItem(dt.Rows(i).Item("Av_Des") & " --- [Fine Scorta al " & dt.Rows(i).Item("datasmaltimentoscorte") & "]", dt.Rows(i).Item("Av_Cod") & "|" & dt.Rows(i).Item("Av_Gru") & "|" & dt.Rows(i).Item("For_Veg_Av_Cod") & "|" & FormulatiXAllegatiNormative_IDRiga))
            Else
                ddl_avversita.Items.Add(New ListItem(dt.Rows(i).Item("Av_Des"), dt.Rows(i).Item("Av_Cod") & "|" & dt.Rows(i).Item("Av_Gru") & "|" & dt.Rows(i).Item("For_Veg_Av_Cod") & "|" & FormulatiXAllegatiNormative_IDRiga))
            End If
        Next

        Session("DtAvv") = DvAvv.ToTable

        If objParametriAgenda.FiltroRicerca <> "2" Then
            getJSGeneric(ddl_avversita)
            cambioAvversita()
            'getJSGeneric(ddl_avversita)
        Else
