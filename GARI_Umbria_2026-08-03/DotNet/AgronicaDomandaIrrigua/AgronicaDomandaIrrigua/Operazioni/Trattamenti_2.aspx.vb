    Private Sub SettaImpostazioneUtente_UDM()

        Dim ObjUtenti As New AgronicaCoreUtentiDAL.Utenti_Impostazioni_Read
        Dim Dt_Impostazioni As DataTable = ObjUtenti.Leggi(0,
                                              1,
                                              enumSelezioneVariabile.Selezione_TabellaCompleta,
                                              "",
                                              "",
                                              objParametri_Utenti)

        Dim fatto As Boolean = False
        If Dt_Impostazioni IsNot Nothing AndAlso Dt_Impostazioni.Rows.Count > 0 Then
            For i = 0 To Dt_Impostazioni.Rows.Count - 1
                Select Case CInt(Dt_Impostazioni.Rows(i).Item("Impostazione_Cod"))
                    Case enum_Impostazioni_Utenti.UTENTE_UDM_Area_COD
                        Dim lUdm As Integer = CInt(Dt_Impostazioni.Rows(i).Item("Impostazione_Valore_1"))
                        SettaUdmDatoCodice(lUdm)
                        fatto = True
                End Select
            Next
        End If

        If Not fatto Then
            SettaUdmDatoCodice(2123)
        End If

    End Sub

    Private Sub SettaImpostazioniSuperUser()

        Session("GestioneLotti_Formulati") = enum_Gestione_Lotti.Nessuna
        Session("GestioneLotti_Fertilizzanti") = enum_Gestione_Lotti.Nessuna
        Session("GestioneLotti_Sementi") = enum_Gestione_Lotti.Nessuna

        Session("GestioneGiacenze_Formulati") = enum_Gestione_Giacenze.SoloMovimentati
        Session("GestioneGiacenze_Fertilizzanti") = enum_Gestione_Giacenze.SoloMovimentati
        Session("GestioneGiacenze_Sementi") = enum_Gestione_Giacenze.SoloMovimentati

        'INIZIO Setto impostazioni superuser per gestioni giacenze e lotti
        Dim ObjUtentiSuperUser As New AgronicaCoreUtentiDAL.Utenti_Impostazioni_Read
        Dim Dt_Impostazioni_SuperUser As DataTable = ObjUtentiSuperUser.Leggi(enum_Impostazioni_Utenti.UTENTE_COD_FILTRO_CATEGORIAMAGAZZINO_LOTTI,
                                                      2,
                                                      enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                      "",
                                                      "",
                                                      objParametri_Utenti)

        If Dt_Impostazioni_SuperUser IsNot Nothing AndAlso Dt_Impostazioni_SuperUser.Rows.Count > 0 AndAlso Dt_Impostazioni_SuperUser.Rows(0).Item("Impostazione_Valore_1") <> "" Then
            Dim elem() As String = Dt_Impostazioni_SuperUser.Rows(0).Item("Impostazione_Valore_1").Split("|")
            For Each s As String In elem
                Dim elem_cod() As String = s.Split("_")
                If elem_cod(0) = FORMULATI Then  '0=no;1=obbligatorio;2=facoltativo
                    Session("GestioneLotti_Formulati") = elem_cod(1)
                End If
                If elem_cod(0) = FERTILIZZANTI Then  '0=no;1=obbligatorio;2=facoltativo
                    Session("GestioneLotti_Fertilizzanti") = elem_cod(1)
                End If
                If elem_cod(0) = SEMENTI Then  '0=no;1=obbligatorio;2=facoltativo
                    Session("GestioneLotti_Sementi") = elem_cod(1)
                End If
            Next
        End If
        Dt_Impostazioni_SuperUser = ObjUtentiSuperUser.Leggi(enum_Impostazioni_Utenti.UTENTE_COD_FILTRO_CATEGORIAMAGAZZINO_GIACENZE,
                                                      2,
                                                      enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                      "",
                                                      "",
                                                      objParametri_Utenti)
        If Dt_Impostazioni_SuperUser IsNot Nothing AndAlso Dt_Impostazioni_SuperUser.Rows.Count > 0 AndAlso Dt_Impostazioni_SuperUser.Rows(0).Item("Impostazione_Valore_1") <> "" Then
            Dim elem() As String = Dt_Impostazioni_SuperUser.Rows(0).Item("Impostazione_Valore_1").Split("|")
            For Each s As String In elem
                Dim elem_cod() As String = s.Split("_")
                '0=soloMovimentati; 1=soloPresenti (default); 2=tutti
                If elem_cod(0) = FORMULATI Then
                    Session("GestioneGiacenze_Formulati") = elem_cod(1)
                End If
                If elem_cod(0) = FERTILIZZANTI Then
                    Session("GestioneGiacenze_Fertilizzanti") = elem_cod(1)
                End If
                If elem_cod(0) = SEMENTI Then
                    Session("GestioneGiacenze_Sementi") = elem_cod(1)
                End If
            Next
        End If
        'FINE Setto impostazioni superuser per gestioni giacenze e lotti

    End Sub

    Private Sub SettaImpostazioniUtente()

        ViewState("ImpostoDPINellaCombo") = Nothing
        Session("DpiPredefinitoUtente") = Nothing

        Session("ControllaBlocco") = Nothing
        Session("ControllaBloccoInserimento") = Nothing

        Session("Blocca_Dose_Massima") = Nothing
        Session("Blocca_Dose_Minima") = Nothing
        Session("Blocca_Acqua_Massima") = Nothing
        Session("Blocca_Acqua_Minima") = Nothing
        Session("Blocca_Numero_Massimo") = Nothing
        Session("Blocca_Carenza") = Nothing
        Session("Blocca_Fioritura") = Nothing
        Session("Blocca_Intervallo_Minimo") = Nothing
        Session("Blocca_Soglia") = Nothing

        Session("UTENTE_COD_BLOCCA_SE_SUPERA_LIMITIMAS") = Nothing

        Session("Blocca_BufferZone") = Nothing

        'Session("Formulati_Stato") = Nothing

        Select Case TipoOperazioneAgenda
            Case enum_Tipo_Operazione_Agenda.QuadernoDiCampagna
                objParametriAgenda.FiltroRicerca = "1" '1, 0 Prodotto-->Avversita ; 2 Avversità-->Prodotto
                ComboFiltriAggiuntiviAgenda1.ddl_FiltriAggiuntivi.Items.Add(New ListItem("Prodotti Avversità", "1"))
            Case enum_Tipo_Operazione_Agenda.Ricetta, enum_Tipo_Operazione_Agenda.RicettaBrogliaccio
                objParametriAgenda.FiltroRicerca = "2" '1, 0 Prodotto-->Avversita ; 2 Avversità-->Prodotto
                ComboFiltriAggiuntiviAgenda1.ddl_FiltriAggiuntivi.Items.Add(New ListItem("Avversità Prodotti", "2"))
        End Select

        If objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Scrittura Then

            'If riga_avversita.Visible Then
            If IsTrattamento Then

                Dim ObjUtenti As New AgronicaCoreUtentiDAL.Utenti_Impostazioni_Read
                Dim Dt_Impostazioni As DataTable = ObjUtenti.Leggi(0,
                                                      1,
                                                      enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                      "",
                                                      "",
                                                      objParametri_Utenti)


                Session("ControllaBlocco") = "0"
