    Private Function CalcolaQtaDistribuita_Dettaglio_Contabile(Mat_cod As Integer,
                                                          Lotto As String,
                                                          Piva_Rif As String,
                                                          Id_Agenda_Rif As Integer,
                                                          Id_Mov_Rif As Integer,
                                                          Id_Mov_Det_Rif As Integer) As Decimal
        Dim Qta As Decimal = 0
        Dim obj_Mov_Detagli As New AgronicaCoreContabDAL.Movimenti_Dettagli_R
        Dim dt_Tot = obj_Mov_Detagli.Leggi(Piva_Rif, 0, Id_Agenda_Rif, Id_Mov_Rif, Id_Mov_Det_Rif, 0, 0, Mat_cod, "", 0, 0, 0, 0, 0, 0, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)
        If dt_Tot.Rows.Count() > 0 Then
            Qta = dt_Tot.Rows(0)("Qta")
            Dim obj_Mov_Dettagli_Rif As New AgronicaCoreContabDAL.Mov_Dettagli_Riferimenti_R
            Dim DT = obj_Mov_Dettagli_Rif.Leggi_Specifica("", 0, 0, 0, 0, 0, "", Piva_Rif, 0, Id_Agenda_Rif, Id_Mov_Rif, Id_Mov_Det_Rif, 0, "", "", "", objParametri_Server)
            For Each row In DT.Rows
                If row("Piva") <> objParametriAgenda.Piva Or row("Id_Agenda") <> objParametriAgenda.Id_Agenda Then
                    Qta -= row("Qta")
                End If
            Next

        End If

        Return Qta
    End Function

    Private Sub GridView_Dosi_ClientMod_Rimuovi(FrCod As Integer, lotto As String)
        Dim righeModificate As String = GridVew_Dosi_ClientMod.Value
        If Not (String.IsNullOrEmpty(righeModificate) OrElse righeModificate = "[]") Then
            Dim righeModificateArray As JArray = JArray.Parse(righeModificate)

            Dim toDelete As JToken
            For Each r In righeModificateArray
                If IsSemina Then
                    If CInt(r("fr_cod")) = FrCod AndAlso CStr(r("lotto")) = lotto Then
                        toDelete = r
                    End If
                Else
                    If CInt(r("fr_cod")) = FrCod Then
                        toDelete = r
                    End If
                End If
            Next

            righeModificateArray.Remove(toDelete)

            GridVew_Dosi_ClientMod.Value = righeModificateArray.ToString()

        End If
    End Sub


