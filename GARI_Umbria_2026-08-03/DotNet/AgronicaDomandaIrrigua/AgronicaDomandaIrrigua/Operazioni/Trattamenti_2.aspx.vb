                If Not IsNumeric(Me.Txt_N_Utile.Text) Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareNUtile, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                End If
                If Me.Txt_N_Utile.Text < 0 Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.NonEPossibileInserireUnaQuantitaDiNUtileNe, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                Else
                    N_Utile = Txt_N_Utile.Text
                End If
            Else
                N_Utile = "0"
            End If


            '-----

            If Txt_P2O5.Text <> "" Then
