    Private Sub Imposta_TipoSemina_DaOpzioneUtente()

        pnlSeminaOpzioniSalvataggio.Visible = True
        'pnlSeminaOpzioniSalvataggio.Attributes.Add("style", "display:none")

        If objParametriAgenda.Tipo_Operazione = TipiEnumerativi.enum_TipoOperazioneDB.Scrittura AndAlso TipoOperazioneAgenda = enum_Tipo_Operazione_Agenda.QuadernoDiCampagna Then

            If objParametriAgenda.Fabbricato = "0" Then ' Se sono senza magazzino posso solo fare la semina standard
                RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Solo_Semina_Default
                pnlSeminaOpzioniSalvataggio.Visible = False
            ElseIf objParametriAgenda.Lav_Cod = LAVCOD_SOVESCIO Then
                RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Solo_Semina_Default
            Else

                Dim ObjUtentiI As New AgronicaCoreUtentiDAL.Utenti_Impostazioni_Read
                Dim Tipo_Semina_Val As String = ObjUtentiI.Impostazione_Valore_From_Impostazione_Cod_Utente_Poi_SuperUser(enum_Impostazioni_Utenti.UTENTE_COD_SEMINA_TIPO, objParametri_Utenti)

                If IsNumeric(Tipo_Semina_Val) Then

                    Select Case Tipo_Semina_Val
                        Case enum_SEMINA_TIPO.Frazionamento_Appezzamenti_perLotto_e_Semina_sui_Singoli_Vincolo
                            RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Frazionamento_Appezzamenti_perLotto_e_Semina_sui_Singoli_Default
                        Case enum_SEMINA_TIPO.Semina_e_Modifica_Appezzamenti_Vincolo
                            RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Semina_e_Modifica_Appezzamenti_Default
                        Case enum_SEMINA_TIPO.Solo_Semina_Vincolo
                            RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Solo_Semina_Default
                        Case Else
                            RBL_Tipo_Semina.SelectedValue = Tipo_Semina_Val
                            pnlSeminaOpzioniSalvataggio.Visible = True
                            'pnlSeminaOpzioniSalvataggio.Attributes.Remove("style")
                            'pnlSeminaOpzioniSalvataggio.Attributes.Remove("display")

                    End Select

                    If RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Frazionamento_Appezzamenti_perLotto_e_Semina_sui_Singoli_Default Then
                        Master_Operazione.Property_ImgBtn_DDT.Visible = False
                        Master_Operazione.Property_ImgBtn_DDT_Cancella.Visible = False
                    End If

                Else
                    RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Solo_Semina_Default
                    pnlSeminaOpzioniSalvataggio.Visible = True
                    'pnlSeminaOpzioniSalvataggio.Attributes.Remove("style")
                    'pnlSeminaOpzioniSalvataggio.Attributes.Remove("display")
                End If

            End If

        Else
            RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Solo_Semina_Default
        End If

        RBL_Tipo_Semina_SelectedIndexChanged(Nothing, Nothing)

    End Sub

