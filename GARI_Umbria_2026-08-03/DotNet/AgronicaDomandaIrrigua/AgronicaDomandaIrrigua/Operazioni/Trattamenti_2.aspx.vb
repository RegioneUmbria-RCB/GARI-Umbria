                                                                Disciplinare_Valore = CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).ddl_Disciplinari.Items(c).Value
                                                                'Exit For
                                                            End If
                                                        Else
                                                            'caso in cui nel dpi è indicata la finalità..
                                                            'verifico se è uguale a quella dell'impianto
                                                            If Grfi_Cod = xGrfi_Cod Then
                                                                If Copertura = 1 AndAlso Flag_Protetto = 1 Then
                                                                    Disciplinare_Valore = CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).ddl_Disciplinari.Items(c).Value
                                                                    Exit For
                                                                ElseIf (Copertura = 0 AndAlso Flag_Protetto = 0) OrElse
                                                                    (Copertura = 0 AndAlso Flag_Protetto = -1) OrElse
                                                                    (Copertura = 0 AndAlso Flag_Protetto = 2) Then
                                                                    Disciplinare_Valore = CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).ddl_Disciplinari.Items(c).Value
