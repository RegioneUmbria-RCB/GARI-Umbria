    ''' <summary>
    ''' Salvataggio dei Dati
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    ''' <remarks></remarks>
    Private Sub SalvaTutto(ByVal sender As Object, ByVal e As System.EventArgs) Implements iOperazioneGUI.SalvaTutto

        Dim ErroriVari As String = ""

        ' VAnni: 16/2/2017: memorizzo i costi accessori prima di procedere con il salvataggio..
        Master.SalvaCostiAccessori_SuAgendaMovimenti(False, Nothing)

        '--------------BLOCCO SALVATAGGIO SENZA MAGAZZINO-------------------
        If Master_Operazione.Property_Div_ProvenienzaRisorse.Visible Then
            If Not IsNothing(Session("UTENTE_COD_BLOCCA_SE_SENZA_MAGAZZINO")) AndAlso Session("UTENTE_COD_BLOCCA_SE_SENZA_MAGAZZINO") = True Then
                If objParametriAgenda.Fabbricato = "0" OrElse objParametriAgenda.Fabbricato = "" Then
                    ErroriVari = "In base alle impostazioni utente NON è possibile salvare l'operazione senza utilizzare il magazzino!" & "<br>"
                    'Dim MErrore As String = "In base alle impostazioni utente NON è possibile salvare l'operazione senza utilizzare il magazzino!"
                    'Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.AttenzioneLOperazioneNonÈStataRegistrataBr & MErrore, Page, ,
                    '    CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                    'Exit Sub
                End If
            End If
        End If
        '---------------------------------------------------------------------

        '--------------BLOCCO SALVATAGGIO SENZA NOTE -------------------
        If IsTrattamento Then
            If Not IsNothing(Session("UTENTE_COD_DEFAULT_BLOCCO_INSERIMENTO_NOTE")) AndAlso Session("UTENTE_COD_DEFAULT_BLOCCO_INSERIMENTO_NOTE") = "1" Then
                Dim ListaConsigli As List(Of Nota)
                ListaConsigli = CType(Master, OperazioneBootstrap).GetConsigli()
                If ListaConsigli.Count = 0 Then
                    ErroriVari &= "In base alle impostazioni utente NON è possibile salvare l'operazione senza selezionare almeno una nota!" & "<br>"
                    'Dim MErrore As String = "In base alle impostazioni utente NON è possibile salvare l'operazione senza selezionare almeno una nota!"
                    'Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.AttenzioneLOperazioneNonÈStataRegistrataBr & MErrore, Page, ,
                    'CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                    'Exit Sub
                End If
            End If
        End If


        '--------------BLOCCO SALVATAGGIO SENZA MACCHINE -------------------
        If IsTrattamento Then
            If Not IsNothing(Session("UTENTE_COD_DEFAULT_BLOCCO_INSERIMENTO_MACCHINE")) AndAlso Session("UTENTE_COD_DEFAULT_BLOCCO_INSERIMENTO_MACCHINE") = "1" Then
                Dim MacchinaPresente As Boolean = False
                For i = 0 To objParametriAgenda.Movimenti.Count - 1
                    Select Case objParametriAgenda.Movimenti(i).Cau_Mov
                        Case CAU_IMPUTAZIONE_PARCOMACCHINE
                            MacchinaPresente = True
                    End Select
                Next
                If Not MacchinaPresente Then
                    ErroriVari &= "In base alle impostazioni utente NON è possibile salvare l'operazione senza indicare almeno una macchina!" & "<br>"
                    'Dim MErrore As String = "In base alle impostazioni utente NON è possibile salvare l'operazione senza indicare almeno una macchina!"
                    'Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.AttenzioneLOperazioneNonÈStataRegistrataBr & MErrore, Page, ,
                    '    CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                    'Exit Sub
                End If
            End If
        End If


        '--------------BLOCCO SALVATAGGIO SENZA OPERATORE -------------------
        If IsTrattamento Then
            If Not IsNothing(Session("UTENTE_COD_DEFAULT_BLOCCO_INSERIMENTO_OPERATORE")) AndAlso Session("UTENTE_COD_DEFAULT_BLOCCO_INSERIMENTO_OPERATORE") = "1" Then
                Dim OperatorePresente As Boolean = False
                For i = 0 To objParametriAgenda.Movimenti.Count - 1
                    Select Case objParametriAgenda.Movimenti(i).Cau_Mov
                        Case CAU_IMPUTAZIONE_MANODOPERA, CAU_IMPUTAZIONE_TECNICO_RESPONSABILE, CAU_IMPUTAZIONE_TERZISTI
                            OperatorePresente = True
                    End Select
                Next
                If Not OperatorePresente Then
                    ErroriVari &= "In base alle impostazioni utente NON è possibile salvare l'operazione senza indicare almeno un operatore!" & "<br>"
                    'Dim MErrore As String = "In base alle impostazioni utente NON è possibile salvare l'operazione senza indicare almeno un operatore!"
                    'Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.AttenzioneLOperazioneNonÈStataRegistrataBr & MErrore, Page, ,
                    '    CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                    'Exit Sub
                End If
            End If
        End If

        '--------------BLOCCO SALVATAGGIO SENZA TERZISTA SE SELEZIONATO IL MAGAZZINO DI UN TERZISTA -------------------
        If objParametriAgenda.Fabbricato <> "0" AndAlso
                                        Split(objParametriAgenda.Fabbricato, "|").Count = 3 AndAlso
                                        Split(objParametriAgenda.Fabbricato, "|")(2) <> objParametriAgenda.Piva Then

            verificaConformitaMagazzini()

            Dim magazzinoGerarchico As Boolean = isMagazzinoGerarchico(objParametriAgenda.Fabbricato)
            If Not magazzinoGerarchico Then

                Dim TerzistaPresente As Boolean = False
                Dim CodRisUm As Integer = 0
                For i = 0 To objParametriAgenda.Movimenti.Count - 1
                    Select Case objParametriAgenda.Movimenti(i).Cau_Mov
                        Case CAU_IMPUTAZIONE_TERZISTI
                            If objParametriAgenda.Movimenti(i).Movimenti_Dettagli.Count > 0 Then
                                For c = 0 To objParametriAgenda.Movimenti(i).Movimenti_Dettagli.Count - 1
                                    CodRisUm = objParametriAgenda.Movimenti(i).Movimenti_Dettagli(c).Mat_Cod
                                    Dim ObjCR As New AgronicaCoreAnagrafeDAL.Rapporti_Contabili_R
                                    Dim DtRC As DataTable
                                    DtRC = ObjCR.RapportiContabilixCostiAccessori_ImpreseGias(objParametriAgenda.Piva, False, True, enumSelezioneVariabile.Selezione_TabellaCompleta, " cod_risum=" & CodRisUm.ToString, "", objParametri_Server)
                                    For cc = 0 To DtRC.Rows.Count - 1
                                        If DtRC.Rows(cc).Item("cod_contatto") = Split(objParametriAgenda.Fabbricato, "|")(2) Then
                                            TerzistaPresente = True
                                            Exit For
                                        End If
                                    Next
                                Next
                            End If
                            'If Split(objParametriAgenda.Fabbricato, "|")(2) = objParametriAgenda.Movimenti(i).Piva Then
                            '    TerzistaPresente = True
                            '    Exit For
                            'End If
                    End Select
                Next
                If Not TerzistaPresente Then
                    ErroriVari &= "Si è scelto di utilizzare le risorse provenienti da '" & CType(Ricerca.FindControlIterative(Page.Master, "ComboMagazzini"), AgronicaControlli_2010.ComboMagazzini).Testo_Combo & "'. E' necessario aggiungere il terzista selezionato in 'Altre Risorse Impiegate'!" & "<br>"
                End If

            End If
        End If


        '--------------BLOCCO SALVATAGGIO SEMINA CON FRAZIONAMENTO CON PIU IMPIANTI -------------------
        If IsSemina AndAlso RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Frazionamento_Appezzamenti_perLotto_e_Semina_sui_Singoli_Default Then
            Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto) = CType(Master, OperazioneBootstrap).GetImpianti()
            If ListaImpianti.Count > 1 Then
                ErroriVari &= "Se si sceglie l'opzione di salvataggio '" & RBL_Tipo_Semina.SelectedItem.Text & "' è possibile selezionare un solo appezzamento per volta!" & NEWLINE
            Else
                'Se si è selezionato un solo impianto controllo che sia l'unico registrato sull'appezzamento
                Dim objRegImpianto As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
                Dim DT As DataTable = objRegImpianto.Leggi(ListaImpianti(0).Piva, ListaImpianti(0).Sa_Cod, ListaImpianti(0).Appezza, 0, enumSelezioneVariabile.Selezione_TabellaDatiMinimi, "", "", objParametri_Server)
                If DT.Rows.Count > 1 Then
                    ErroriVari &= "Non è possibile frazionare un Appezzamento con più di un impianto registrato!" & NEWLINE
                End If
            End If
        End If

        If ErroriVari <> "" Then
            Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.AttenzioneLOperazioneNonÈStataRegistrataBr & ErroriVari, Page, ,
                    CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
            Exit Sub
        End If

        '''-----------------------------------------------------------------------------------------------------
        '''-----------------------TEMPORANERO PER EVITARE SALVATAGGIO MAGAZZINI ESTERNI------------------------
        ''If objParametriAgenda.Fabbricato <> "0" AndAlso Split(objParametriAgenda.Fabbricato, "|").Count = 3 AndAlso Split(objParametriAgenda.Fabbricato, "|")(2) <> objParametriAgenda.Piva Then
        ''    Dim MErrore As String = Resources.AgronicaAgenda_2010.ATTENZIONEBrAlMomentoNonÈPermessoIlSalvata
        ''    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.AttenzioneLOperazioneNonÈStataRegistrataBr & MErrore, Page, , _
        ''        CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
        ''    Exit Sub
        ''End If
        '''-----------------------------------------------------------------------------------------------------
        '''-----------------------------------------------------------------------------------------------------

        Dim messaggio_errore As String = ""
        Dim messaggio_alert As String = ""
        Dim Unid_Operazione As String = ""

        Dim TipoSalvataggio As Integer = CType(Ricerca.FindControlIterative(Page.Master, "tipo_salva"), HiddenField).Value

        Dim AgendaScarico As Operazione_Agenda
        Dim ListaOpAgenda As New List(Of Operazione_Agenda)


        If SalvaOperazioneAgenda(TipoSalvataggio, messaggio_errore, Unid_Operazione, ListaOpAgenda, AgendaScarico, messaggio_alert) Then

            'se magazzino è di ALTRA AZIENDA NON ho salvato l'operazione
            'LA SALVERO al salvataggio del DDT EMESSO x non salvare incoerenze
            'If objParametriAgenda.Fabbricato <> "0" AndAlso _
            '    Split(objParametriAgenda.Fabbricato, "|").Count = 3 AndAlso _
            '    Split(objParametriAgenda.Fabbricato, "|")(2) <> objParametriAgenda.Piva Then
            'End If

            If AgendaScarico IsNot Nothing Then

                Session("AgendaScarico") = AgendaScarico
                Session("ListaOpAgenda") = ListaOpAgenda

                Dim objImprese As New AgronicaCoreAnagrafeDAL.Imprese_Read
                Dim RagSocTerzista As String = objImprese.RagSoc_from_Piva(AgendaScarico.Piva, objParametri_Server)
                Dim strJS As New StringBuilder
                strJS.AppendLine("$(document).ready(function () { ")

                strJS.AppendLine(" window.location = '../GestioneContabilita/DocumentoContabileGenerico.aspx?p=" & Stringa_Codifica(AgendaScarico.Piva, AgroKey_EncoderDecoder) &
                            "&o=" & Stringa_Codifica(enum_TipoOperazioneDB.Scrittura, AgroKey_EncoderDecoder) &
                            "&s=" & Stringa_Codifica(0, AgroKey_EncoderDecoder) &
                            "&i=" & Stringa_Codifica(0, AgroKey_EncoderDecoder) &
                            "&l=" & Stringa_Codifica(AgendaScarico.Lav_Cod, AgroKey_EncoderDecoder) &
                            "&d=" & Stringa_Codifica(CStr(AgendaScarico.Data), AgroKey_EncoderDecoder) &
                            "&tf=" & Stringa_Codifica(0, AgroKey_EncoderDecoder) &
                            "&rs=" & Stringa_Codifica(RagSocTerzista, AgroKey_EncoderDecoder) &
                            "&orig=" & Stringa_Codifica(enum_PagineAgenda_2010.Menu, AgroKey_EncoderDecoder) &
                                                                                              "'; ")
                strJS.AppendLine(" });")

                ScriptManager.RegisterStartupScript(CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel), CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).GetType(),
                                                  String.Format("jQuery_{0}", CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).ClientID), strJS.ToString, True)

                Messaggi.AgroMsgBuonFine(Resources.AgronicaAgenda_2010.RegistrazioneEffettuataConSuccesso, Page, ,
                                      CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))

                Trattamenti_Disposed()
                objParametriAgenda.Svuota_DatiOperazione()
                Exit Sub

            End If


            ScriptManager.RegisterStartupScript(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType, "azzera",
                                                        "$(document).ready(function () {$('#" & HiddenVarie.ClientID & "').val(''); });", True)


            fine_salvataggio(TipoSalvataggio, Unid_Operazione)

        Else
            If messaggio_errore <> "" Then
                Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.AttenzioneLOperazioneNonÈStataRegistrataBr & messaggio_errore, Page, ,
                                        CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
            Else
                If messaggio_alert <> "" Then
                    ' VAnni: 28/2/2020: Non usare il resx sulla stringa "Salva"
                    Messaggi.AgroSiNo(messaggio_alert & vbCr & Resources.AgronicaAgenda_2010.BrBIProcedereUgualmenteIB, "Salva", Page, ,
                                          CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                End If
            End If
        End If

    End Sub


    Private Function SalvaOperazioneAgenda(
                               ByRef messaggio_errore As String,
                               ByRef Unid_Operazione As String
                               ) As Boolean Implements iOperazioneGUI_Trattamento.SalvaOperazioneAgenda

        'Non serve, ma viene richiesto dall'interfaccia..
    End Function

    Private Function SalvaOperazioneAgenda(
                               ByVal TipoSalvataggio As Integer,
                               ByRef messaggio_errore As String,
                               ByRef Unid_Operazione As String,
                               ByRef ListaOpAgenda As List(Of Operazione_Agenda),
                               ByRef AgendaScarico As Operazione_Agenda,
                               ByRef messaggio_alert As String) As Boolean Implements iOperazioneGUI_Trattamento.SalvaOperazioneAgenda

        Dim listaXMLRicettaOperazione As New List(Of String)
        Dim listaIdAgendaNuovi As New List(Of Integer)
        Dim res As Boolean = False

        Dim ht_CDG As New Hashtable

        'DT: controllo non contemporaneità di prodotto multiplo (con lotto diverso) e multicentro
        'nella nuova versione Angular questo controllo non verrà introdotto, serve solo per tamponare un malfunzionamento attuale
        If IsTrattamento OrElse IsFertilizzazione Then
            Dim Dt_DosiCheck As DataTable = Session("vs_dtDosi")
            If Dt_DosiCheck IsNot Nothing AndAlso Dt_DosiCheck.Rows.Count > 0 Then

                Dim fr_codes = From row In Dt_DosiCheck.AsEnumerable()
                               Select row.Field(Of String)("fr_cod") Distinct

                If fr_codes.Count <> Dt_DosiCheck.Rows.Count Then

                    Dim ListaImpiantiCheck As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
                    ListaImpiantiCheck = CType(Master, OperazioneBootstrap).GetImpianti()
                    Dim countDistinct_Sa_Cod = ListaImpiantiCheck.Select(Function(x) x.Sa_Cod).Distinct.Count

                    If countDistinct_Sa_Cod > 1 Then
                        Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.BloccoMultiprodottoMulticentro, Page, , UpdatePanel_Prodotti)
                        Exit Function
                    End If

                End If
            End If
        End If

        '---------------------------------------
        ' recupero il CENTRO
        'Dim Sa_Cod As Integer = 0
        If objParametriAgenda.Sa_Cod = "" Then
            messaggio_errore = Resources.AgronicaAgenda_2010.SelezionareUnCentroAziendale
            Return False
            'Else
            'Sa_Cod = CInt(objParametriAgenda.Sa_Cod)
        End If


        '---------------------------------------
        ' recupero il MAGAZZINO
        Dim Fabbricato_Cod As String = objParametriAgenda.Fabbricato


        '////////////////////////////////////////////////////////////
        '//////////////////DATI PER L OPERAZIONE///////////////////////
        '////////////////////////////////////////////////////////////

        '---------------------------------------
        ' recupero gli IMPIANTI
        Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto) = CType(Master, OperazioneBootstrap).GetImpianti()

        'If ListaImpianti.Count = 0 AndAlso isNonUtilizzo = False Then
        '    'Messaggi.AgroMsgBox("Selezionare almeno un impianto colturale!", Page, , CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
        '    messaggio_errore = Resources.AgronicaAgenda_2010.SelezionareAlmenoUnImpiantoColturale
        '    Return False
        'End If

        If ListaImpianti.Count = 0 Then
            If Not isNonUtilizzo Then
                messaggio_errore = Resources.AgronicaAgenda_2010.SelezionareAlmenoUnImpiantoColturale
                Return False
            Else 'verifica esistenza di almenno un centro aziendale
                If Master_Operazione.Property_ComboCentroAziendale.ddl_CentroAziendale.Items.Count <= 1 Then
                    messaggio_errore = Resources.AgronicaAgenda_2010.CreaCentroAziendaleAssociatoAdImpresa
                    Return False
                Else
                    If Not IsNothing(objParametriAgenda.Veg_Cod) Then
                        If objParametriAgenda.Veg_Cod.Split("/").Length > 1 Then
                            messaggio_errore = Resources.AgronicaAgenda_2010.SelezionareAlmenoUnImpiantoColturale
                            Return False
                        Else
                            If objParametriAgenda.Veg_Cod.Split("/")(0) <> "" AndAlso
                            objParametriAgenda.Veg_Cod.Split("/")(0) <> "-1" AndAlso
                            objParametriAgenda.Veg_Cod.Split("/")(0) <> "0" Then
                                messaggio_errore = Resources.AgronicaAgenda_2010.SelezionareAlmenoUnImpiantoColturale
                                Return False
                            End If
                        End If
                    End If
                End If
            End If
        End If



        '---------------------------------------
        'Se è stato selezionato 'Tutti i centri aziendali' ma tutti gli impianti appartengono ad un solo centro, imposto il valore sull'objparametriAgenda
        If objParametriAgenda.Sa_Cod = "0" Then
            Dim listaSaCodImpianti As List(Of Integer) = (From x As AgronicaCoreModello.ParametriAgenda_Temp.Impianto In ListaImpianti Select x.Sa_Cod).Distinct().ToList()
            If listaSaCodImpianti.Count = 1 Then
                objParametriAgenda.Sa_Cod = listaSaCodImpianti.First().ToString()
            End If
        End If
        '--------------------------------------- 

        'modifico la selezione degli rbl per salvare correttamente i dati dato che salvo sempre e solo la dose/ha
        rbl_DoseHA.Checked = True
        rbl_DoseHL.Checked = False

        If objParametriAgenda.Fabbricato.Length > 1 Then
            rbl_QtaDose.Checked = False
            rbl_QtaTot.Checked = True
        End If

        'modifico le dosi a ettaro in modo da avare una precisione maggiore
        Dim dt_dosi As DataTable = Session("vs_dtDosi")
        Dim HashMatCod As New Hashtable
        Dim sup_trattata As Decimal = Txt_SupTrattata.Value
        For i = 0 To dt_dosi.Rows.Count - 1
            'dt_dosi.Rows(i).Item("Dose") = CDec(CDec(dt_dosi.Rows(i).Item("Qta_tot")) / sup_trattata)
            dt_dosi.Rows(i).Item("Dose") = CDec(CDec(dt_dosi.Rows(i).Item("Dose_Tot_Reale")) / sup_trattata)
            If IsSemina Then
                If Not HashMatCod.ContainsKey(dt_dosi.Rows(i).Item("fr_cod")) Then
                    HashMatCod.Add(dt_dosi.Rows(i).Item("fr_cod"), CStr(dt_dosi.Rows(i).Item("fr_Des")) & "§" & CStr(dt_dosi.Rows(i).Item("Cod_Articolo")) & "§" & CStr(dt_dosi.Rows(i).Item("Lotto")) & "§" & CStr(dt_dosi.Rows(i).Item("Mat_Regolamento")) & "§" & CStr(dt_dosi.Rows(i).Item("Mat_Veg_cod")) & "§" & CStr(dt_dosi.Rows(i).Item("Mat_Cul_cod")))
                End If
            End If
        Next

        Dim magazzinoEsterno As Boolean = False

        'Dim DtOperazioniSplittateSemina As DataTable

        Try

            '-----------------------------------------------------
            '----------- CONNESSIONE E TRANSAZIONE ---------------
            ConnessioniTransazioni.ApriConnessione(True, objParametri_Server)
            '-----------------------------------------------------
            Dim dt_DosiSelect As DataTable

            If IsSemina AndAlso
                    RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Frazionamento_Appezzamenti_perLotto_e_Semina_sui_Singoli_Default AndAlso
                    objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Scrittura Then

#Region "SEMINA CON FRAZIONAMENTO"
                Dim Mat_Cod As Integer
                Dim Mat_Des As String
                Dim Sup_App_New As Decimal
                Dim Sup_Tot As Decimal

                Dim messaggio As String = ""
                For Each Key In HashMatCod
                    Mat_Cod = Key.key
                    Mat_Des = Split(Key.value, "§")(0)
                    Sup_App_New = 0
                    Dim DrMatCod() As DataRow = dt_dosi.Select("fr_cod='" & Mat_Cod.ToString & "'")
                    If DrMatCod IsNot Nothing Then
                        For Each dr As DataRow In DrMatCod
                            Sup_App_New += dr.Item("sup_calcolata")
                        Next
                    End If
                    messaggio &= "<br>- " & Mat_Des & " (" & Sup_App_New.ToString & " Ha)" & vbCrLf
                    Sup_Tot += Sup_App_New
                Next
                If Sup_Tot < ListaImpianti(0).Sup_Imp Then
                    messaggio &= "<br>- Terreno Nudo (" & (ListaImpianti(0).Sup_Imp - Sup_Tot).ToString & " Ha)"
                End If

                If messaggio <> "" Then
                    If HiddenVarie.Value = "" Then
                        messaggio_alert = "Attenzione! Verranno generati i seguenti appezzamenti: " & vbCrLf & messaggio
                        Throw New Exception("")
                    End If
                    HiddenVarie.Value = ""
                End If


                Dim DtNuoviImp As New DataTable

                DtNuoviImp.Columns.Add("piva", GetType(String))
                DtNuoviImp.Columns.Add("sa_cod", GetType(Integer))
                DtNuoviImp.Columns.Add("appezza_old", GetType(Integer))
                DtNuoviImp.Columns.Add("id_reg_old", GetType(Integer))
                DtNuoviImp.Columns.Add("appezza_new", GetType(Integer))
                DtNuoviImp.Columns.Add("id_reg_new", GetType(Integer))
                DtNuoviImp.Columns.Add("sup_new", GetType(Decimal))
                DtNuoviImp.Columns.Add("sup_perc", GetType(Decimal))

                Dim AppezzaDaSeminare As Integer
                Dim IdRegDaSeminare As Integer

                Dim PrimaSemina As Boolean = False
                Dim Id_Agenda_DaEscludere As Integer
                Dim ListaImpiantiDaModificare As New List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
                ListaImpiantiDaModificare.Add(ListaImpianti(0))

                Dim Validita_Inizio_New As Date = ListaImpianti(0).Validita_Inizio_Appezzamento
                Dim Validita_Fine_New As Date = ListaImpianti(0).Validita_Fine_Appezzamento

                If IsDate(ListaImpianti(0).Validita_Inizio) Then
                    Validita_Inizio_New = ListaImpianti(0).Validita_Inizio
                End If
                If IsDate(ListaImpianti(0).Validita_Fine) AndAlso CDate(ListaImpianti(0).Validita_Fine) > CDate(ListaImpianti(0).Validita_Inizio) Then
                    Validita_Fine_New = ListaImpianti(0).Validita_Fine
                End If


                Dim Veg_Cod_New As Integer
                Dim Cul_Cod_New As Integer
                Dim MetodoProduzione_New As Integer

                Dim Udm_Cod_New As Decimal
                Dim Qta_New As Decimal
                Dim P_Ha_New As Decimal
                Dim P_Ha_Tot_New As Decimal

                Dim Grfi_Cod_Old As Integer = ListaImpianti(0).Grfi_Cod 'IdentificaGrfi_Cod()
                Dim Grfi_Cod_New As Integer = 0
                If Grfi_Cod_Old > 0 Then
                    Grfi_Cod_New = Grfi_Cod_Old
                End If

                Dim Cop_Cod_Old As Integer = ListaImpianti(0).Cop_Cod
                Dim Cop_Cod_New As Integer = 0
                If Cop_Cod_Old > 0 Then
                    Cop_Cod_New = Cop_Cod_Old
                End If

                Sup_Tot = 0

                Dim PrimoApp As Boolean = True

                Dim N_App As Integer = 1

                For Each Key In HashMatCod

                    PrimaSemina = False

                    Mat_Cod = Key.key

                    Sup_App_New = 0
                    Udm_Cod_New = 0
                    Qta_New = 0
                    P_Ha_New = 0
                    P_Ha_Tot_New = 0

                    Dim DrMatCod() As DataRow = dt_dosi.Select("fr_cod='" & Mat_Cod.ToString & "'")

                    If DrMatCod IsNot Nothing Then
                        For Each dr As DataRow In DrMatCod
                            Sup_App_New += dr.Item("sup_calcolata")
                            P_Ha_Tot_New += dr.Item("Dose_HA_Reale")
                            Qta_New += dr.Item("Dose_Tot_Reale")
                            Udm_Cod_New = dr.Item("udm_cod")
                        Next
                    End If
                    'p_ha medie
                    P_Ha_New = P_Ha_Tot_New / DrMatCod.Length

                    Veg_Cod_New = Split(Key.value, "§")(4)
                    Cul_Cod_New = Split(Key.value, "§")(5)
                    MetodoProduzione_New = IIf(Split(Key.value, "§")(3) = 4, 3, Split(Key.value, "§")(3))


                    'se l'app selezionato non aveva finalita ne prendo una
                    Dim objFin As New AgronicaCoreMetaSchemaDAL.GruppoFinalitaxSpecieVegetali_R
                    If Grfi_Cod_New <= 0 Then
                        Grfi_Cod_New = objFin.PrimoGrfiCod_from_Vegcod(Veg_Cod_New, objParametri_Server)
                    Else
                        'Se è già impostata una finalità (perché l'ha presa dal vecchio impianto), verifico che sia valida anche per la nuova specie
                        Dim dtFinNew As DataTable = objFin.Leggi(Grfi_Cod_New, Veg_Cod_New, "", "", objParametri_Server)
                        If dtFinNew.Rows.Count = 0 Then
                            Grfi_Cod_New = objFin.PrimoGrfiCod_from_Vegcod(Veg_Cod_New, objParametri_Server)
                        End If
                    End If
                    If Cop_Cod_New <= 0 Then
                        Dim objCop As New AgronicaCoreMetaSchemaDAL.Copertura_R
                        Cop_Cod_New = objCop.CodCopNessuna_from_VegCod(Veg_Cod_New, objParametri_Server)
                    End If

                    Sup_Tot += Sup_App_New

                    If PrimoApp Then

                        'al primo lotto selezionato modifico l'impianto

                        Modifica_Impianto(ListaImpianti(0), Veg_Cod_New, Cul_Cod_New, Grfi_Cod_New, MetodoProduzione_New, Sup_App_New, Udm_Cod_New, Qta_New, P_Ha_New, messaggio_errore, "", True)

                        Dim SupPerc As Decimal = 0
                        SupPerc = CDec(Sup_App_New * 100 / ListaImpianti(0).Sup_Imp)

                        Dim dr As DataRow = DtNuoviImp.NewRow
                        dr.Item("piva") = ListaImpianti(0).Piva
                        dr.Item("sa_cod") = ListaImpianti(0).Sa_Cod
                        dr.Item("appezza_old") = ListaImpianti(0).Appezza
                        dr.Item("id_reg_old") = ListaImpianti(0).ID_Reg
                        dr.Item("appezza_new") = ListaImpianti(0).Appezza
                        dr.Item("id_reg_new") = ListaImpianti(0).ID_Reg
                        dr.Item("sup_new") = Sup_App_New
                        dr.Item("sup_perc") = SupPerc
                        DtNuoviImp.Rows.Add(dr)

                        AppezzaDaSeminare = ListaImpianti(0).Appezza
                        IdRegDaSeminare = ListaImpianti(0).ID_Reg

                        PrimoApp = False
                        PrimaSemina = True

                    Else

                        ' per gli altri lotti creo nuovi appezzamenti

                        Dim AppezzaNew As Integer = 0
                        Dim IdRegNew As Integer = 0
                        Dim AssociaCatasto As Boolean = False

                        Dim ListaPart As New List(Of Particella)
                        ListaPart = ListaImpianti(0).ListaParticelle
                        If ListaPart.Count = 1 Then
                            AssociaCatasto = True
                        End If

                        'Se il nome dell'appezzamento ha più di 45 caratteri lo devo accorciare
                        Dim App_Nome As String = ListaImpianti(0).App_Nome.Substring(0, IIf(ListaImpianti(0).App_Nome.Length > 45, 45, ListaImpianti(0).App_Nome.Length))
                        CreaAppezzamento(ListaImpianti(0).Piva, ListaImpianti(0).Sa_Cod, ListaImpianti(0).Campo_Cod,
                                                 ListaImpianti(0).Appezza, ListaImpianti(0).ID_Reg,
                                                     Validita_Inizio_New, Validita_Fine_New,
                                                     ListaImpianti(0).Validita_Inizio_Appezzamento, ListaImpianti(0).Validita_Fine_Appezzamento,
                                                     ListaImpianti(0).Validita_Inizio_Distinta, ListaImpianti(0).Validita_Fine_Distinta,
                                                     App_Nome & " - " & N_App.ToString,
                                                     Sup_App_New,
                                                     P_Ha_New,
                                                     If(MetodoProduzione_New = enum_Cod_Regolamento.Regolamento_bio, enum_MetodoProduzione.Biologico, enum_MetodoProduzione.Integrato),
                                                     Cul_Cod_New, Grfi_Cod_New, Cop_Cod_New,
                                                     "", 0,
                                                     AppezzaNew, IdRegNew, DtNuoviImp,
                                                     ListaImpianti(0).Sup_Imp,
                                                     AssociaCatasto)

                        AppezzaDaSeminare = AppezzaNew
                        IdRegDaSeminare = IdRegNew

                    End If

                    N_App += 1

                    '-------------------------------------------
                    ' registro la semina
                    Dim Agenda As Operazione_Agenda = CreaOggettoAgendaSingoloApp(DrMatCod, ListaImpianti(0).Sa_Cod, AppezzaDaSeminare, IdRegDaSeminare, Sup_App_New, messaggio_errore)

                    If IsNothing(Agenda) Then
                        Throw New Exception(Resources.AgronicaAgenda_2010.NonÈStatoPossibileCreareLOperazione & messaggio_errore)
                    End If

                    Dim objAgendaScrivi As New Agenda_Operazione_Helper

                    Dim Id_Agenda As Integer
                    Id_Agenda = objAgendaScrivi.Scrivi(Agenda, objParametri_Server)

                    If PrimaSemina Then
                        Id_Agenda_DaEscludere = Id_Agenda
                    End If

                Next

                '''per gli impianti selezionati
                '''se non è stata utilizzata tutta la superficie 
                '''viene generato un appezzamento terreno nudo 
                If Sup_Tot < ListaImpianti(0).Sup_Imp Then

                    Dim AppezzaNew As Integer = 0
                    Dim IdRegNew As Integer = 0

                    'Se il nome dell'appezzamento ha più di 45 caratteri lo devo accorciare
                    Dim AppNomeNew As String = ListaImpianti(0).App_Nome.Substring(0, IIf(ListaImpianti(0).App_Nome.Length > 45, 45, ListaImpianti(0).App_Nome.Length)) & " - " & N_App.ToString
                    CreaAppezzamento(ListaImpianti(0).Piva, ListaImpianti(0).Sa_Cod, ListaImpianti(0).Campo_Cod,
                                     ListaImpianti(0).Appezza, ListaImpianti(0).ID_Reg,
                                     Validita_Inizio_New, Validita_Fine_New,
                                     ListaImpianti(0).Validita_Inizio_Appezzamento, ListaImpianti(0).Validita_Fine_Appezzamento,
                                     ListaImpianti(0).Validita_Inizio_Distinta, ListaImpianti(0).Validita_Fine_Distinta,
                                     AppNomeNew,
                                     ListaImpianti(0).Sup_Imp - Sup_Tot,
                                     0,
                                     0, 0, 0, 0, "Terreno Nudo", 0,
                                     AppezzaNew, IdRegNew, DtNuoviImp, ListaImpianti(0).Sup_Imp, True)

                End If

                FrazionaAgenda(ListaImpianti(0), DtNuoviImp, Id_Agenda_DaEscludere, ht_CDG)

                res = True
#End Region
            Else
#Region "ALTRE OPERAZIONI"
                Dim objUtenti As New AgronicaCoreUtentiDAL.Utenti_Impostazioni_Read
                'Controllo, nel caso di ricetta, se devo salvare un'operazione per ogni impianto 
                Dim creaUnaOperazionePerOgniImpianto As Boolean = False
                If TipoOperazioneAgenda = enum_Tipo_Operazione_Agenda.Ricetta OrElse TipoOperazioneAgenda = enum_Tipo_Operazione_Agenda.RicettaBrogliaccio AndAlso
                            objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Scrittura Then


                    Dim impostaz As String = objUtenti.ImpostazioneValore1_from_ImpostazioneCod(enum_Impostazioni_Utenti.SUPERUSER_COD_RICETTE_CREA_UNA_OPERAZIONE_PER_OGNI_IMPIANTO, objParametri_Utenti, 2)

                    If IsNumeric(impostaz) AndAlso CInt(impostaz) = 1 Then
                        creaUnaOperazionePerOgniImpianto = True
                    End If

                End If



                If creaUnaOperazionePerOgniImpianto Then
#Region "PREPARAZIONE XML RICETTE_OPERAZIONI"
                    If ListaImpianti.Count > 1 Then
                        'se ho più impianti salvo sempre la qta di acqua a ettaro
                        rblAcqua_HA.Checked = True
                        rblAcqua_Tot.Checked = False
                    End If

                    'calcolo le qta per singolo Impianto
                    Dim listalista As New List(Of List(Of Decimal))
                    dt_DosiSelect = dt_dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto")
                    If Session("vs_dtDosi") IsNot Nothing Then

                        Dim tot As Decimal = Txt_SupTrattata.Value

                        For j = 0 To ListaImpianti.Count - 1
                            listalista.Add(New List(Of Decimal))
                        Next

                        For j = 0 To ListaImpianti.Count - 1

                            Dim rapporto As Decimal = ListaImpianti(j).Qta2 / tot

                            'controllo se sono all'ultimo giro o no
                            If j = ListaImpianti.Count - 1 Then

                                For i = 0 To dt_DosiSelect.Rows.Count - 1
                                    Dim qta As Decimal = 0
                                    Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' ")
                                    For Each row In rows
                                        qta += row.Item("Dose_Tot_Reale")
                                    Next
                                    For jj As Integer = 0 To listalista.Count - 2
                                        qta -= listalista(jj)(i)
                                    Next
                                    listalista(j).Add(qta)
                                Next

                            Else

                                For i = 0 To dt_DosiSelect.Rows.Count - 1
                                    Dim qta As Decimal = 0
                                    Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' ")
                                    For Each row In rows
                                        qta += row.Item("Dose_Tot_Reale")
                                    Next
                                    qta = qta * rapporto
                                    'qta = dt_dosi.Rows(i).Item("Qta_tot") * rapporto
                                    listalista(j).Add(qta)
                                Next
                            End If

                        Next
                    End If

                    'effettuo verifica arrotondamento
                    dt_DosiSelect = dt_dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto")
                    For i = 0 To dt_DosiSelect.Rows.Count - 1
                        'per ogni prodotto mi calcolo la somma totale
                        Dim sum_qta As Decimal = 0
                        For j = 0 To listalista.Count - 1
                            sum_qta += listalista(j)(i)
                        Next

                        Dim qta_Tot_Reale As Decimal = 0
                        Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' ")
                        For Each row In rows
                            qta_Tot_Reale += row.Item("Dose_Tot_Reale")
                        Next

                        If sum_qta <> qta_Tot_Reale Then
                            listalista(listalista.Count - 1)(i) += (qta_Tot_Reale - sum_qta)
                        End If

                    Next


                    Dim listalista_Magazzino As New List(Of List(Of Decimal))
                    dt_DosiSelect = dt_dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto", "Piva", "Sa_Cod", "Fabbricato_Cod")
                    If Session("vs_dtDosi") IsNot Nothing Then

                        Dim tot As Decimal = Txt_SupTrattata.Value

                        For j = 0 To ListaImpianti.Count - 1
                            listalista_Magazzino.Add(New List(Of Decimal))
                        Next

                        For j = 0 To ListaImpianti.Count - 1

                            Dim rapporto As Decimal = ListaImpianti(j).Qta2 / tot

                            'controllo se sono all'ultimo giro o no
                            If j = ListaImpianti.Count - 1 Then

                                For i = 0 To dt_DosiSelect.Rows.Count - 1
                                    Dim qta As Decimal = 0
                                    Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' ")
                                    For Each row In rows
                                        qta += row.Item("Dose_Tot_Reale")
                                    Next
                                    For jj As Integer = 0 To listalista.Count - 2
                                        qta -= listalista_Magazzino(jj)(i)
                                    Next
                                    listalista_Magazzino(j).Add(qta)
                                Next

                            Else

                                For i = 0 To dt_DosiSelect.Rows.Count - 1
                                    Dim qta As Decimal = 0
                                    Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' " &
                                              " AND Lotto = '" & dt_DosiSelect.Rows(i)("Lotto") & "' " &
                                              " AND Piva = '" & dt_DosiSelect.Rows(i)("Piva") & "' " &
                                              " AND Sa_Cod = " & dt_DosiSelect.Rows(i)("Sa_Cod") & " " &
                                              " AND Fabbricato_Cod = " & dt_DosiSelect.Rows(i)("Fabbricato_Cod") & " ")
                                    For Each row In rows
                                        qta += row.Item("Dose_Tot_Reale")
                                    Next
                                    qta = qta * rapporto
                                    'qta = dt_dosi.Rows(i).Item("Qta_tot") * rapporto
                                    listalista_Magazzino(j).Add(qta)
                                Next
                            End If

                        Next
                    End If

                    'effettuo verifica arrotondamento
                    dt_DosiSelect = dt_dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto", "Piva", "Sa_Cod", "Fabbricato_Cod")
                    For i = 0 To dt_DosiSelect.Rows.Count - 1
                        'per ogni prodotto mi calcolo la somma totale
                        Dim sum_qta As Decimal = 0
                        For j = 0 To listalista_Magazzino.Count - 1
                            sum_qta += listalista_Magazzino(j)(i)
                        Next

                        Dim qta_Tot_Reale As Decimal = 0
                        Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' " &
                                              " AND Lotto = '" & dt_DosiSelect.Rows(i)("Lotto") & "' " &
                                              " AND Piva = '" & dt_DosiSelect.Rows(i)("Piva") & "' " &
                                              " AND Sa_Cod = " & dt_DosiSelect.Rows(i)("Sa_Cod") & " " &
                                              " AND Fabbricato_Cod = " & dt_DosiSelect.Rows(i)("Fabbricato_Cod") & " ")
                        For Each row In rows
                            qta_Tot_Reale += row.Item("Dose_Tot_Reale")
                        Next

                        If sum_qta <> qta_Tot_Reale Then
                            listalista_Magazzino(listalista_Magazzino.Count - 1)(i) += (qta_Tot_Reale - sum_qta)
                        End If

                    Next


                    Dim Messaggio As String = ""
                    Dim Conforme As Boolean = True

                    If IsTrattamento Then

                        'VERIFICHE CONFORMITA (x ogni centro) PRELIMINARE
                        '(31/05/2016) introdotta impostazione x dare alert
                        '(20/07/2016) spostata x multi-centro
                        Select Case Session("ControllaBlocco")

                            Case "1", "2" '1=blocco 2=alert

                                If objParametriAgenda.Disciplinare <> NessunDpiNessunaEtichetta AndAlso HiddenVarie.Value = "" Then

                                    Dim Corretto As Boolean


                                    For i = 0 To ListaImpianti.Count - 1

                                        Dim ListaImpiantiConUnSoloImp As New List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
                                        ListaImpiantiConUnSoloImp.Add(ListaImpianti.Item(i))

                                        Dim Agenda As Operazione_Agenda = CreaOggettoAgenda(ListaImpiantiConUnSoloImp, ListaImpiantiConUnSoloImp(0).Sa_Cod, listalista(i), listalista_Magazzino(i))

                                        If IsNothing(Agenda) Then
                                            Throw New Exception(Resources.AgronicaAgenda_2010.NonÈStatoPossibileCreareLOperazione)
                                        End If

                                        Corretto = VerificaDPI(Agenda, Messaggio)

                                        If Session("ControllaBlocco") = "1" Then
                                            If Not Corretto Then
                                                Throw New Exception(Resources.AgronicaAgenda_2010.BLOperazioneNonÈConformeBBr & Messaggio)
                                            End If
                                        Else
                                            If Not Corretto Then
                                                messaggio_alert = Messaggio
                                            End If
                                            If messaggio_alert <> "" Then
                                                If HiddenVarie.Value = "" Then
                                                    Conforme = False
                                                    messaggio_alert = "Attenzione operazione NON conforme " & Messaggio
                                                End If
                                                HiddenVarie.Value = ""
                                            End If
                                        End If
                                    Next

                                End If

                        End Select

                    End If

                    'QUIQUI
                    Dim bloccoGiacenze As Boolean = False
                    Dim messaggio_alertGiacenze As String = ""
                    ControllaGiacenzeSalvataggioOperazione(messaggio_alertGiacenze, bloccoGiacenze, 0)

                    If messaggio_alert <> "" OrElse messaggio_alertGiacenze <> "" Then
                        If messaggio_alertGiacenze <> "" AndAlso bloccoGiacenze Then
                            messaggio_alert &= vbCrLf & "Controllo giacenze non superato" & messaggio_alertGiacenze
                            Throw New Exception(messaggio_alert)
                        End If

                        Throw New Exception("")
                    End If

                    'Ciclo per ogni impianto
                    For i = 0 To ListaImpianti.Count - 1

                        Dim ListaImpiantiConUnSoloImp As New List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
                        ListaImpiantiConUnSoloImp.Add(ListaImpianti.Item(i))

                        '--------------------------------------------------
                        '--------------------------------------------------
                        '--------- CREAZIONE OGGETTO DA SALVARE   ---------
                        '--------------------------------------------------
                        '--------------------------------------------------

                        Dim Id_Agenda As Integer = 0

                        Dim Agenda As Operazione_Agenda = CreaOggettoAgenda(ListaImpiantiConUnSoloImp, ListaImpiantiConUnSoloImp(0).Sa_Cod, listalista(i), listalista_Magazzino(i))

                        If IsNothing(Agenda) Then
                            Throw New Exception(Resources.AgronicaAgenda_2010.NonÈStatoPossibileCreareLOperazione)
                        End If

                        Dim rif_Lav_Cod As Integer
                        Dim rif_Des_Lib As String = ""
                        Dim rif_Data As Date
                        Dim rif_Note As String = ""

                        Dim Dpi_Cod As Integer = 0
                        Dim Dpi_PubblicoPrivato As Integer = 0

                        'una volta creato l'oggetto agenda posso invocare il suo metodo che mi genera l'xml
                        Dim StringaXmlOperazione As String = ""
                        Dim Helper As New Agenda_Operazione_Helper
                        If IsTrattamento Then
                            StringaXmlOperazione = Helper.GeneraXML_CAU_TRATTAMENTO(Agenda, Dpi_Cod, Dpi_PubblicoPrivato)
                        End If
                        If IsLavorazione OrElse IsAbbattimento OrElse IsSemina OrElse IsRaccolta OrElse isNonUtilizzo OrElse IsAbbattimento Then
                            StringaXmlOperazione = Helper.GeneraXML_CAU_LAVORAZIONI(Agenda)
                        End If
                        If IsFertilizzazione Then
                            StringaXmlOperazione = Helper.GeneraXML_CAU_LAVORAZIONI(Agenda, Dpi_Cod, Dpi_PubblicoPrivato)
                        End If

                        'creo la ricetta_operazione dall'xml dell'agenda
                        Dim objRicettaOp As New AgronicaCoreContabBIZ.Ricette_Operazioni_R
                        Dim StringaXmlRicettaOperazione As String = objRicettaOp.XML_GeneraStringa_Ricetta_Operazione(objParametriAgenda.Tipo_Operazione, Qs_Ricetta_Cod, Qs_Operazione_Ricetta,
                                                                                                       objParametriAgenda.TipoOperazioneAgenda, Session("ASG_ProgressivoGIAS"), objParametri_Server,
                                                                                        StringaXmlOperazione, rif_Lav_Cod, rif_Des_Lib, rif_Data, rif_Note)

                        listaXMLRicettaOperazione.Add(StringaXmlRicettaOperazione)

                    Next
#End Region
                Else

#Region "CASO TRADIZIONALE SENZA FRAZIONAMENTO DELLE OPERAZIONI PER IMPIANTO"
                    'CASO TRADIZIONALE SENZA FRAZIONAMENTO DELLE OPERAZIONI PER IMPIANTO
                    Select Case objParametriAgenda.Sa_Cod

                    '--------------------------------------------------
                    '--------------------------------------------------
                    '--------- OPERAZIONE MULTI-CENTRO    -------------
                    '--------------------------------------------------
                    '--------------------------------------------------
#Region "MULTI-CENTRO"
                        Case "0"

                            'se è multicentro salvo sempre la qta di acqua a ettaro
                            rblAcqua_HA.Checked = True
                            rblAcqua_Tot.Checked = False

                            Dim ListaSacod As New List(Of Integer)
                            Dim Trovato As Boolean
                            For i = 0 To ListaImpianti.Count - 1
                                Trovato = False
                                For j = 0 To ListaSacod.Count - 1
                                    If ListaImpianti(i).Sa_Cod = ListaSacod(j) Then
                                        Trovato = True
                                        Exit For
                                    End If
                                Next
                                If Not Trovato Then
                                    ListaSacod.Add(ListaImpianti(i).Sa_Cod)
                                End If
                            Next

                            'calcolo le qta per singolo Centro
                            Dim listalista As New List(Of List(Of Decimal))

                            If Session("vs_dtDosi") IsNot Nothing Then
                                dt_DosiSelect = dt_dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto")
                                Dim tot As Decimal = Txt_SupTrattata.Value
                                For j = 0 To ListaSacod.Count - 1
                                    listalista.Add(New List(Of Decimal))
                                Next

                                For j = 0 To ListaSacod.Count - 1

                                    Dim sommatoriaQtaquestoSa_Cod As Decimal = 0

                                    For i = 0 To ListaImpianti.Count - 1
                                        If ListaImpianti(i).Sa_Cod = ListaSacod(j) Then
                                            sommatoriaQtaquestoSa_Cod += ListaImpianti(i).Qta2
                                        End If
                                    Next

                                    Dim rapporto As Decimal = sommatoriaQtaquestoSa_Cod / tot
                                    'controllo se sono all'ultimo giro o no
                                    If j = ListaSacod.Count - 1 Then
                                        For i = 0 To dt_DosiSelect.Rows.Count - 1
                                            Dim qta As Decimal = 0
                                            Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' ")
                                            For Each row In rows
                                                qta += row.Item("Dose_Tot_Reale")
                                            Next
                                            'Dim qta As Decimal = dt_dosi.Rows(i).Item("Qta_tot")
                                            For jj As Integer = 0 To listalista.Count - 2
                                                qta = qta - listalista(jj)(i)
                                            Next
                                            listalista(j).Add(qta)
                                        Next

                                    Else
                                        For i = 0 To dt_DosiSelect.Rows.Count - 1
                                            Dim qta As Decimal = 0
                                            Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' ")
                                            For Each row In rows
                                                qta += row.Item("Dose_Tot_Reale")
                                            Next
                                            qta = qta * rapporto
                                            'qta = dt_dosi.Rows(i).Item("Qta_tot") * rapporto
                                            listalista(j).Add(qta)
                                        Next
                                    End If
                                Next
                            End If

                            'effettuo verifica arrotondamento
                            dt_DosiSelect = dt_dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto")
                            For i = 0 To dt_DosiSelect.Rows.Count - 1
                                'per ogni prodotto mi calcolo la somma totale
                                Dim sum_qta As Decimal = 0
                                For j = 0 To listalista.Count - 1
                                    sum_qta = sum_qta + listalista(j)(i)
                                Next
                                'If sum_qta <> dt_dosi.Rows(i).Item("Qta_tot") Then
                                '    listalista(listalista.Count - 1)(i) = listalista(listalista.Count - 1)(i) + (dt_dosi.Rows(i).Item("Qta_tot") - sum_qta)
                                'End If
                                Dim qta_Tot_Reale As Decimal = 0
                                Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' ")
                                For Each row In rows
                                    qta_Tot_Reale += row.Item("Dose_Tot_Reale")
                                Next

                                If sum_qta <> qta_Tot_Reale Then
                                    listalista(listalista.Count - 1)(i) = listalista(listalista.Count - 1)(i) + (qta_Tot_Reale - sum_qta)
                                End If

                            Next

                            Dim listalista_Magazzino As New List(Of List(Of Decimal))
                            If Session("vs_dtDosi") IsNot Nothing Then
                                dt_DosiSelect = dt_dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto", "Piva", "Sa_Cod", "Fabbricato_Cod")
                                Dim tot As Decimal = Txt_SupTrattata.Value
                                For j = 0 To ListaSacod.Count - 1
                                    listalista_Magazzino.Add(New List(Of Decimal))
                                Next

                                For j = 0 To ListaSacod.Count - 1

                                    Dim sommatoriaQtaquestoSa_Cod As Decimal = 0

                                    For i = 0 To ListaImpianti.Count - 1
                                        If ListaImpianti(i).Sa_Cod = ListaSacod(j) Then
                                            sommatoriaQtaquestoSa_Cod += ListaImpianti(i).Qta2
                                        End If
                                    Next

                                    Dim rapporto As Decimal = sommatoriaQtaquestoSa_Cod / tot
                                    'controllo se sono all'ultimo giro o no
                                    If j = ListaSacod.Count - 1 Then
                                        For i = 0 To dt_DosiSelect.Rows.Count - 1
                                            Dim qta As Decimal = 0
                                            Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' " &
                                              " AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' " &
                                              " AND Piva = '" & dt_DosiSelect.Rows(i)("Piva") & "' " &
                                              " AND Sa_Cod = " & dt_DosiSelect.Rows(i)("Sa_Cod") & " " &
                                              " AND Fabbricato_Cod = " & dt_DosiSelect.Rows(i)("Fabbricato_Cod") & " ")
                                            For Each row In rows
                                                qta += row.Item("Dose_Tot_Reale")
                                            Next
                                            'Dim qta As Decimal = dt_dosi.Rows(i).Item("Qta_tot")
                                            For jj As Integer = 0 To listalista_Magazzino.Count - 2
                                                qta = qta - listalista_Magazzino(jj)(i)
                                            Next
                                            listalista_Magazzino(j).Add(qta)
                                        Next

                                    Else
                                        For i = 0 To dt_DosiSelect.Rows.Count - 1
                                            Dim qta As Decimal = 0
                                            Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' " &
                                              " AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' " &
                                              " AND Piva = '" & dt_DosiSelect.Rows(i)("Piva") & "' " &
                                              " AND Sa_Cod = " & dt_DosiSelect.Rows(i)("Sa_Cod") & " " &
                                              " AND Fabbricato_Cod = " & dt_DosiSelect.Rows(i)("Fabbricato_Cod") & " ")
                                            For Each row In rows
                                                qta += row.Item("Dose_Tot_Reale")
                                            Next
                                            qta = qta * rapporto
                                            'qta = dt_dosi.Rows(i).Item("Qta_tot") * rapporto
                                            listalista_Magazzino(j).Add(qta)
                                        Next
                                    End If
                                Next
                            End If

                            'effettuo verifica arrotondamento
                            dt_DosiSelect = dt_dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto", "Piva", "Sa_Cod", "Fabbricato_Cod")
                            For i = 0 To dt_DosiSelect.Rows.Count - 1
                                'per ogni prodotto mi calcolo la somma totale
                                Dim sum_qta As Decimal = 0
                                For j = 0 To listalista_Magazzino.Count - 1
                                    sum_qta = sum_qta + listalista_Magazzino(j)(i)
                                Next
                                'If sum_qta <> dt_dosi.Rows(i).Item("Qta_tot") Then
                                '    listalista(listalista.Count - 1)(i) = listalista(listalista.Count - 1)(i) + (dt_dosi.Rows(i).Item("Qta_tot") - sum_qta)
                                'End If
                                Dim qta_Tot_Reale As Decimal = 0
                                Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' " &
                                              " AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' " &
                                              " AND Piva = '" & dt_DosiSelect.Rows(i)("Piva") & "' " &
                                              " AND Sa_Cod = " & dt_DosiSelect.Rows(i)("Sa_Cod") & " " &
                                              " AND Fabbricato_Cod = " & dt_DosiSelect.Rows(i)("Fabbricato_Cod") & " ")
                                For Each row In rows
                                    qta_Tot_Reale += row.Item("Dose_Tot_Reale")
                                Next

                                If sum_qta <> qta_Tot_Reale Then
                                    listalista_Magazzino(listalista_Magazzino.Count - 1)(i) = listalista_Magazzino(listalista_Magazzino.Count - 1)(i) + (qta_Tot_Reale - sum_qta)
                                End If

                            Next

                            If isNonUtilizzo AndAlso ListaSacod.Count = 0 Then
                                For Each li As ListItem In Master_Operazione.Property_ComboCentroAziendale.ddl_CentroAziendale.Items
                                    If li.Value <> "0" Then
                                        ListaSacod.Add(li.Value)
                                        listalista.Add(New List(Of Decimal)(New Decimal(0)))
                                        listalista_Magazzino.Add(New List(Of Decimal)(New Decimal(0)))
                                    End If
                                Next
                            End If

                            If IsTrattamento Then

                                'VERIFICHE CONFORMITA (x ogni centro) PRELIMINARE
                                '(31/05/2016) introdotta impostazione x dare alert
                                '(20/07/2016) spostata x multi-centro
                                Select Case Session("ControllaBlocco")

                                    Case "1", "2" '1=blocco 2=alert

                                        If objParametriAgenda.Disciplinare <> NessunDpiNessunaEtichetta AndAlso
                                                    HiddenVarie.Value = "" Then

                                            Dim Corretto As Boolean
                                            Dim Messaggio As String = ""

                                            For i = 0 To ListaSacod.Count - 1

                                                Dim ListaImpiantixQuestoSaCod As New List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)

                                                'Seleziono solamente gli impianti relativi a questo centro aziendale
                                                For j = 0 To ListaImpianti.Count - 1
                                                    If ListaImpianti(j).Sa_Cod = ListaSacod(i) Then
                                                        ListaImpiantixQuestoSaCod.Add(ListaImpianti(j))
                                                    End If
                                                Next

                                                Dim Agenda As Operazione_Agenda = CreaOggettoAgenda(ListaImpiantixQuestoSaCod, ListaSacod(i), listalista(i), listalista_Magazzino(i))

                                                If IsNothing(Agenda) Then
                                                    Throw New Exception(Resources.AgronicaAgenda_2010.NonÈStatoPossibileCreareLOperazione)
                                                End If

                                                Corretto = VerificaDPI(Agenda, Messaggio)

                                                If Session("ControllaBlocco") = "1" Then
                                                    If Not Corretto Then
                                                        Throw New Exception(Resources.AgronicaAgenda_2010.BLOperazioneNonÈConformeBBr & Messaggio)
                                                    End If
                                                Else
                                                    If Not Corretto Then
                                                        messaggio_alert = Messaggio
                                                    End If
                                                    If messaggio_alert <> "" Then
                                                        If HiddenVarie.Value = "" Then
                                                            If Messaggio <> "" Then
                                                                messaggio_alert = "Attenzione operazione NON conforme " & Messaggio
                                                            End If
                                                            'Throw New Exception("")
                                                        End If
                                                        HiddenVarie.Value = ""
                                                    End If
                                                End If
                                            Next

                                        End If

                                End Select

                            End If

                            'QUIQUI
                            Dim bloccoGiacenze As Boolean = False
                            Dim messaggio_alertGiacenze As String = ""
                            ControllaGiacenzeSalvataggioOperazione(messaggio_alertGiacenze, bloccoGiacenze, 0)

                            If messaggio_alert <> "" OrElse messaggio_alertGiacenze <> "" Then
                                If HiddenVarie.Value = "" Then
                                    If messaggio_alertGiacenze <> "" AndAlso bloccoGiacenze Then
                                        messaggio_alert &= vbCrLf & "Controllo giacenze non superato" & messaggio_alertGiacenze
                                        Throw New Exception(messaggio_alert)
                                    End If
                                    If messaggio_alert = "" Then
                                        messaggio_alert &= messaggio_alertGiacenze
                                    End If
                                    Throw New Exception("")
                                End If
                                HiddenVarie.Value = ""
                            End If

                            'Ciclo per ogni centro aziendale
                            For i = 0 To ListaSacod.Count - 1

                                Dim ListaImpiantixQuestoSaCod As New List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)

                                'Seleziono solamente gli impianti relativi a questo centro aziendale
                                For j = 0 To ListaImpianti.Count - 1
                                    If ListaImpianti(j).Sa_Cod = ListaSacod(i) Then
                                        ListaImpiantixQuestoSaCod.Add(ListaImpianti(j))
                                    End If
                                Next

                                '--------------------------------------------------
                                '--------------------------------------------------
                                '--------- CREAZIONE OGGETTO DA SALVARE   ---------
                                '--------------------------------------------------
                                '--------------------------------------------------

                                Dim Id_Agenda As Integer = 0

                                Dim Agenda As Operazione_Agenda = CreaOggettoAgenda(ListaImpiantixQuestoSaCod, ListaSacod(i), listalista(i), listalista_Magazzino(i))

                                If IsNothing(Agenda) Then
                                    Throw New Exception(Resources.AgronicaAgenda_2010.NonÈStatoPossibileCreareLOperazione)
                                End If


                                'If i = 0 Then
                                'se magazzino è di ALTRA AZIENDA creo l'operazione di DDT emesso dall'altra azienda
                                '(solo i=0 al primo giro)
                                If objParametriAgenda.Fabbricato <> "0" AndAlso
                                                Split(objParametriAgenda.Fabbricato, "|").Count = 3 AndAlso
                                                Split(objParametriAgenda.Fabbricato, "|")(2) <> objParametriAgenda.Piva Then

                                    Dim piva_magazzino As String = Split(objParametriAgenda.Fabbricato, "|")(2)
                                    Dim sa_cod_magazzino As String = Split(objParametriAgenda.Fabbricato, "|")(1)
                                    Dim fabbricatox_Cod As String = Split(objParametriAgenda.Fabbricato, "|")(0)

                                    magazzinoEsterno = True

                                    If TipoOperazioneAgenda = enum_Tipo_Operazione_Agenda.QuadernoDiCampagna Then

                                        verificaConformitaMagazzini()

                                        If isMagazzinoGerarchico(objParametriAgenda.Fabbricato) = True Then
                                            Dim util As New Utility_NS.Utility_Operazioni
                                            util.Gestisci_Magazzino_Aziendale(Agenda, Id_Agenda, objParametriAgenda, objParametri_Server)
                                        Else
                                            CreaAgendaScaricoAltraAzienda(piva_magazzino, sa_cod_magazzino, fabbricatox_Cod, AgendaScarico)
                                        End If
                                    Else
                                        'CASO RICETTE
                                        'SOSTITUISCO IL MAGAZZINO DELLA DESTINAZIONE SCARICO CON QUELLO INDICATO 
                                        '(per non generare altre operazioni)
                                        For Each movimentoagenda As Movimento In Agenda.Movimenti

                                            If movimentoagenda.Cau_Mov = CAU_SCARICO Then

                                                movimentoagenda.Piva = piva_magazzino
                                                movimentoagenda.Sa_Cod = sa_cod_magazzino

                                                For Each movimentoDetScarico As Movimento_Dettaglio In movimentoagenda.Movimenti_Dettagli

                                                    movimentoDetScarico.Piva = piva_magazzino
                                                    movimentoDetScarico.Sa_Cod = sa_cod_magazzino

                                                    For Each movimentoDestScarico As Movimento_Destinazione In movimentoDetScarico.Movimenti_Destinazioni
                                                        movimentoDestScarico.Piva = piva_magazzino
                                                        movimentoDestScarico.Sa_Cod = sa_cod_magazzino
                                                        movimentoDestScarico.Id_Destinazione = fabbricatox_Cod
                                                    Next

                                                Next

                                            End If

                                        Next

                                    End If

                                End If

                                'End If

                                If TipoOperazioneAgenda = enum_Tipo_Operazione_Agenda.Ricetta OrElse TipoOperazioneAgenda = enum_Tipo_Operazione_Agenda.RicettaBrogliaccio Then
#Region "XML RICETTE_OPERAZIONI"
                                    Dim rif_Lav_Cod As Integer
                                    Dim rif_Des_Lib As String = ""
                                    Dim rif_Data As Date
                                    Dim rif_Note As String = ""

                                    Dim Dpi_Cod As Integer = 0
                                    Dim Dpi_PubblicoPrivato As Integer = 0

                                    'una volta creato l'oggetto agenda posso invocare il suo metodo che mi genera l'xml
                                    Dim StringaXmlOperazione As String = ""
                                    Dim Helper As New Agenda_Operazione_Helper
                                    If IsTrattamento Then
                                        StringaXmlOperazione = Helper.GeneraXML_CAU_TRATTAMENTO(Agenda, Dpi_Cod, Dpi_PubblicoPrivato)
                                    End If
                                    If IsLavorazione OrElse IsAbbattimento OrElse IsSemina OrElse IsRaccolta OrElse isNonUtilizzo OrElse IsAbbattimento Then
                                        StringaXmlOperazione = Helper.GeneraXML_CAU_LAVORAZIONI(Agenda)
                                    End If
                                    If IsFertilizzazione Then
                                        StringaXmlOperazione = Helper.GeneraXML_CAU_LAVORAZIONI(Agenda, Dpi_Cod, Dpi_PubblicoPrivato)
                                    End If

                                    If objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Modifica Then
                                        'Dal 06/23 conserviamo la data e l'username di creazione originali per tutti i record Agenda
                                        allinea_DataUsernameCreazione(Agenda, objParametri_Server, Tipo_Attivita.Ricetta, Qs_Ricetta_Cod)
                                    End If

                                    'creo la ricetta_operazione dall'xml dell'agenda
                                    Dim objRicettaOp As New AgronicaCoreContabBIZ.Ricette_Operazioni_R
                                    Dim StringaXmlRicettaOperazione As String = objRicettaOp.XML_GeneraStringa_Ricetta_Operazione(objParametriAgenda.Tipo_Operazione, Qs_Ricetta_Cod, Qs_Operazione_Ricetta,
                                                                                                       objParametriAgenda.TipoOperazioneAgenda, Session("ASG_ProgressivoGIAS"), objParametri_Server,
                                                                                        StringaXmlOperazione, rif_Lav_Cod, rif_Des_Lib, rif_Data, rif_Note, Agenda.Data_Creazione, Agenda.Username_Creazione)

                                    listaXMLRicettaOperazione.Add(StringaXmlRicettaOperazione)
#End Region
                                Else
#Region "AGENDA"
                                    'se scarico da altra azienda NON salvo l'operazione
                                    If magazzinoEsterno Then

                                        ListaOpAgenda.Add(Agenda)

                                    Else

                                        Dim objAgendaScrivi As New Agenda_Operazione_Helper

                                        If objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Modifica Then

                                            'Recupero i vecchi costi CdG prima che vengano cancellati
                                            Dim mdr_Rif As New Agenda_Movimenti_Dettagli_Riferimenti_Helper()
                                            Dim lista_mdRif As List(Of Movimento_Dettaglio_Riferimento) = mdr_Rif.LeggiRiferimentiAgenda(Agenda.Piva, 0, Agenda.Id_Agenda, 0, "", objParametri_Server)

                                            'Dal 06/23 conserviamo la data e l'username di creazione originali per tutti i record Agenda
                                            allinea_DataUsernameCreazione(Agenda, objParametri_Server, Tipo_Attivita.QuadernoDiCampagna, 0)

                                            Dim CancellataOperazione As Boolean = objAgendaScrivi.Cancella(objParametriAgenda.Piva,
                                                                                                                 objParametriAgenda.Sa_Cod,
                                                                                                                 objParametriAgenda.Id_Agenda, False,
                                                                                                                 objParametri_Server, logCancellazione:=False)

                                            'Riscrivo i vecchi costi
                                            Dim mdRif_helper As New Agenda_Movimenti_Dettagli_Riferimenti_Helper
                                            For Each mdRif As Movimento_Dettaglio_Riferimento In lista_mdRif
                                                If mdRif.Lav_Cod_Rif = LAVCOD_COSTI_CDG Then
                                                    mdRif_helper.Scrivi(mdRif, objParametri_Server)
                                                    Exit For
                                                End If
                                            Next

                                        End If

                                        Id_Agenda = objAgendaScrivi.Scrivi(Agenda, objParametri_Server)

                                        listaIdAgendaNuovi.Add(Id_Agenda)

                                        'se sono n scrittura devo agganciare la ricetta se presente
                                        If Id_Agenda <> 0 AndAlso objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Scrittura Then
                                            ' se Session("UtilizzataRicetta") esiste e se è true allora ho utilizzato la ricetta per creare l'operazione
                                            If Not IsNothing(Session("UtilizzataRicetta")) AndAlso Session("UtilizzataRicetta") Then

                                                Dim ricetta_cod As String = Session("ricetta_cod")
                                                Dim Ricetta_Operazione_Cod As String = Session("Ricetta_Operazione_Cod")


                                                Dim Impostazione_RicetteXagenda As String = objUtenti.ImpostazioneValore1_from_ImpostazioneCod(enum_Impostazioni_Utenti.UTENTE_COD_DEFAULT_RiferimentoRicetteOperazioni,
                                                                                            HttpContext.Current.Session("ASG_objParametri_Utenti"),
                                                                                                1)
                                                If Impostazione_RicetteXagenda <> "0" Then
                                                    Dim objRicetta As New AgronicaCoreContabDAL.RicettexAgenda_W
                                                    If Not objRicetta.Scrivi(ricetta_cod, Ricetta_Operazione_Cod, Id_Agenda, AGRODATAINIZIO, AGRODATAFINE, objParametri_Server) Then
                                                        Throw New Exception(Resources.AgronicaAgenda_2010.BNonÈRiuscitoLAggancioDellaRicettaBBr)
                                                    End If
                                                End If

                                            End If

                                        End If

                                    End If

#End Region
                                End If

                            Next
#End Region
                        Case Else
                            '--------------------------------------------------
                            '--------------------------------------------------
                            '--------- OPERAZIONE SINGOLO CENTRO    -----------
                            '--------------------------------------------------
                            '--------------------------------------------------
#Region "SINGOLO CENTRO"

                            '--------------------------------------------------
                            '--------------------------------------------------
                            '--------- CREAZIONE OGGETTO DA SALVARE   ---------
                            '--------------------------------------------------
                            '--------------------------------------------------

                            Dim Qta_da_scaricare As New List(Of Decimal)
                            'la qta da scaricare è esattamente quella indicata nella qta_totale
                            dt_DosiSelect = dt_dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto")
                            For i = 0 To dt_DosiSelect.Rows.Count - 1
                                Dim qta As Decimal = 0
                                Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' ")
                                For Each row In rows
                                    qta += row.Item("Dose_Tot_Reale")
                                Next
                                Qta_da_scaricare.Add(qta)
                                'Qta_da_scaricare.Add(dt_dosi.Rows(i).Item("Qta_Tot"))
                            Next

                            Dim Qta_da_scaricare_Magazzino As New List(Of Decimal)
                            dt_DosiSelect = dt_dosi.DefaultView.ToTable(True, "Fr_Cod", "Lotto", "Piva", "Sa_Cod", "Fabbricato_Cod")
                            For i = 0 To dt_DosiSelect.Rows.Count - 1
                                Dim qta As Decimal = 0
                                Dim rows = dt_dosi.Select(" Fr_Cod ='" & dt_DosiSelect.Rows(i)("Fr_Cod") & "' " &
                                              " AND Lotto = '" & UtilityProvider.Agro_SQL_SaveText(dt_DosiSelect.Rows(i)("Lotto")) & "' " &
                                              " AND Piva = '" & dt_DosiSelect.Rows(i)("Piva") & "' " &
                                              " AND Sa_Cod = " & dt_DosiSelect.Rows(i)("Sa_Cod") & " " &
                                              " AND Fabbricato_Cod = " & dt_DosiSelect.Rows(i)("Fabbricato_Cod") & " ")
                                For Each row In rows
                                    qta += row.Item("Dose_Tot_Reale")
                                Next
                                Qta_da_scaricare_Magazzino.Add(qta)
                                'Qta_da_scaricare.Add(dt_dosi.Rows(i).Item("Qta_Tot"))
                            Next

                            Dim Id_Agenda As Integer = 0

                            Dim Agenda As Operazione_Agenda = CreaOggettoAgenda(ListaImpianti, objParametriAgenda.Sa_Cod, Qta_da_scaricare, Qta_da_scaricare_Magazzino)

                            objParametriAgenda.Impianti = ListaImpianti

                            If IsNothing(Agenda) Then
                                Throw New Exception(Resources.AgronicaAgenda_2010.NonÈStatoPossibileCreareLOperazione)
                            End If

                            'se magazzino è di ALTRA AZIENDA creo l'operazione di DDT emesso dall'altra azienda
                            If (objParametriAgenda.Fabbricato <> "0" AndAlso
                                    Split(objParametriAgenda.Fabbricato, "|").Count = 3 AndAlso
                                    Split(objParametriAgenda.Fabbricato, "|")(2) <> objParametriAgenda.Piva) Then

                                Dim piva_magazzino As String = Split(objParametriAgenda.Fabbricato, "|")(2)
                                Dim sa_cod_magazzino As String = Split(objParametriAgenda.Fabbricato, "|")(1)
                                Dim fabbricatox_Cod As String = Split(objParametriAgenda.Fabbricato, "|")(0)

                                magazzinoEsterno = True

                                If TipoOperazioneAgenda = enum_Tipo_Operazione_Agenda.QuadernoDiCampagna Then
                                    verificaConformitaMagazzini()

                                    If isMagazzinoGerarchico(objParametriAgenda.Fabbricato) = True Then
                                        Dim util As New Utility_NS.Utility_Operazioni
                                        util.Gestisci_Magazzino_Aziendale(Agenda, Id_Agenda, objParametriAgenda, objParametri_Server)
                                    Else
                                        CreaAgendaScaricoAltraAzienda(piva_magazzino, sa_cod_magazzino, fabbricatox_Cod, AgendaScarico)
                                    End If

                                    'se sono n scrittura devo agganciare la ricetta se presente
                                    If Id_Agenda <> 0 AndAlso objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Scrittura Then
                                        ' se Session("UtilizzataRicetta") esiste e se è true allora ho utilizzato la ricetta per creare l'operazione
                                        If Not IsNothing(Session("UtilizzataRicetta")) AndAlso Session("UtilizzataRicetta") Then

