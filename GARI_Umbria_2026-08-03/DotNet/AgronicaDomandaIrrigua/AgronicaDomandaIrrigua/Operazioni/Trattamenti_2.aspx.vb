                        strRet &= strErr_N_Ricetta & strErr_P_Ricetta & strErr_K_Ricetta & strErr_Cu_Ricetta
                    End If

                End If

            End If

        End If

        Return strRet

    End Function

    Protected Sub Btn_ComboEpoche_Click(sender As Object, e As EventArgs) Handles Btn_ComboEpoche.Click

        Dim TipoFertilizzante As Integer
        Dim Epoca As Integer
        Dim Efficienza As Decimal = 1
        Dim FerCod As Integer
        Dim DatiFertilizzante As String
        Dim ClassiTessitura As New List(Of Integer)
        Dim EffCod As Integer = 0
        Dim Regolamento_Cod As Integer = 0
        Dim Tipo_PuaRegolamento As Integer = 0

        Regolamento_Cod = objParametriAgenda.Disciplinare.Split("/")(0)

        If objParametriAgenda.Disciplinare.Split("/").Length > 1 Then
            Tipo_PuaRegolamento = objParametriAgenda.Disciplinare.Split("/")(1)
        End If

        Dim Veg_Cod As Integer = 0
        If objParametriAgenda.Veg_Cod.Split("/").Length > 0 AndAlso IsNumeric(objParametriAgenda.Veg_Cod.Split("/")(0)) AndAlso CInt(objParametriAgenda.Veg_Cod.Split("/")(0)) > 0 Then
            Veg_Cod = CInt(objParametriAgenda.Veg_Cod.Split("/")(0))
        End If


        Txt_Efficienza.Text = "1"

        ClassiTessitura = Master_Operazione.GetClassiTessituraImpiantiSelezionati()

        '-----------
        'EFFICIENZA
        '-----------
        If ComboFertilizzanti.Valore_Combo.Split("/").Length > 1 AndAlso Split(ComboFertilizzanti.Valore_Combo, "$")(1) <> "0" Then

            DatiFertilizzante = Split(ComboFertilizzanti.Valore_Combo, "$")(0)

            FerCod = Split(DatiFertilizzante, "/")(0)
            TipoFertilizzante = CInt(Split(ComboFertilizzanti.Valore_Combo, "$")(1))

            If Not IsNothing(ComboEpoche.ddl_ComboEpocheFertilizzazione) AndAlso Not IsNothing(ComboEpoche.ddl_ComboEpocheFertilizzazione.SelectedValue) AndAlso IsNumeric(ComboEpoche.ddl_ComboEpocheFertilizzazione.SelectedValue) Then
                Epoca = CInt(ComboEpoche.ddl_ComboEpocheFertilizzazione.SelectedValue)
            End If

            If Split(ComboFertilizzanti.Valore_Combo, "$").Length > 5 Then
                EffCod = Split(ComboFertilizzanti.Valore_Combo, "$")(6)
            End If

            If TipoFertilizzante <> 0 AndAlso Epoca <> 0 Then

                Select Case Tipo_PuaRegolamento
                    Case 0
                    Case 1 'pua 2007
                        Dim objEff As New AgronicaCoreMetaSchemaDAL.EfficienzaxTipoFertilizzante_R
                        Efficienza = objEff.Efficienza_From_Id_Tp_Fer_Em_Cod(TipoFertilizzante, Epoca, objParametri_Server)
                    Case Else 'pan successivi
                        Dim TipoAllevamento As Integer = 0
                        If riga_animali.Visible Then
                            TipoAllevamento = CInt(Cmb_Allevamenti.SelectedValue)
                        End If
                        Dim Dose = 1
                        Dim qta, qta_trasformata, N, qta_N As Decimal
                        If Txt_N.Text <> "NaN" AndAlso IsNumeric(Txt_N.Text) Then
                            N = CDec(Txt_N.Text)
                        Else
                            N = 0
                        End If
                        If Txt_Dose_HA.Text <> "NaN" AndAlso IsNumeric(Txt_Dose_HA.Text) Then
                            qta = Txt_Dose_HA.Text
                            Select Case Cmb_UdM.SelectedValue
                                Case "2", "29" 'kg, l
                                    qta_trasformata = qta
                                Case "4" 'q
                                    qta_trasformata = qta * 100
                                Case "304" 't
                                    qta_trasformata = qta * 1000
                                Case "19" 'mc
                                    qta_trasformata = qta * 1000
                            End Select
                            qta_N = qta * N / 100
                            If qta_N > 125 Then
                                Dose = 2
                            End If
                        End If
                        Efficienza = AggiornaEfficienza(EffCod, Epoca, TipoAllevamento, Dose, Regolamento_Cod, ClassiTessitura, Veg_Cod)
                End Select

                Txt_Efficienza.Text = Efficienza.ToString

            End If

            Txt_N_Utile.Text = Txt_N.Text

            If IsNumeric(Txt_N.Text) Then
                Txt_N_Utile.Text = CDec(Txt_N.Text) * Efficienza
            End If

        End If

        Dim Qta_Ha_Distribuibile_Prodotto As Decimal = 1000000
        Dim Qta_Ha_Distribuibile_Prodotto_Ricette As Decimal = 1000000
        Dim strMassimali As String = ControllaMassimali(False, Qta_Ha_Distribuibile_Prodotto, Qta_Ha_Distribuibile_Prodotto_Ricette)

        If Qta_Ha_Distribuibile_Prodotto <> 1000000 Then
            Lbl_Dose_Consigliata.Text = Qta_Ha_Distribuibile_Prodotto
            Lbl_Dose_Consigliata.Visible = True
            lbl_qta_residua.Visible = True
            lbl_qta_residua.Text = "Dose/Ha di Prodotto Residua [kg] [l]"
            Lbl_Dose_Consigliata_Ricetta.Text = ""
            Lbl_Dose_Consigliata_Ricetta.Visible = False
            lbl_qta_residua_ricetta.Visible = False
            lbl_qta_residua_ricetta.Text = ""
        Else
            Me.Lbl_Dose_Consigliata.Text = ""
            Me.Lbl_Dose_Consigliata_Ricetta.Text = ""
        End If

        If objParametriAgenda.TipoRicetta = enum_TipoRicetta.PianoDistribuzionePua Then
            If Qta_Ha_Distribuibile_Prodotto_Ricette <> 1000000 Then
                Lbl_Dose_Consigliata_Ricetta.Text = Qta_Ha_Distribuibile_Prodotto_Ricette
                Lbl_Dose_Consigliata_Ricetta.Visible = True
                lbl_qta_residua_ricetta.Visible = True
                lbl_qta_residua_ricetta.Text = "Dose/Ha di Prodotto Residua per PUA [kg] [l]"
            Else
                Me.Lbl_Dose_Consigliata_Ricetta.Text = ""
            End If
        End If

    End Sub

    <WebMethod(EnableSession:=True)>
    Public Shared Function ApriRilievoRientra() As RispostaStandard
        Dim r As New RispostaStandard
        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            r.Sessione = False
            Return r
        End If

        Try


            Dim objParametriAgenda As New ParametriAgenda
            objParametriAgenda.RecuperaRientro()



            r.RispostaOK = True

        Catch ex As Exception

            r.RispostaOK = False
            'uso questa funzione per ottenere il Messaggio..:
            r.Errore = AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)

        End Try


        Return r

    End Function

    <WebMethod(EnableSession:=True)>
    Public Shared Function ApriRilievo(ByVal lav_cod As String, ByVal dpi_cod As String, ByVal av_cod As String, ByVal udm_cod As String, impiantiSelezionati As String) As RispostaStandard

        Dim r As New RispostaStandard
        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            r.Sessione = False
            Return r
        End If

        Try


            Dim Url As String = "RilieviBS.aspx?trattamento=true"

            Dim objParametriAgenda As New ParametriAgenda

            Dim objImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto) = GetImpiantiKendo(impiantiSelezionati)

            objParametriAgenda.Impianti = objImpianti

            objParametriAgenda.ImpostaPerRientro()

            objParametriAgenda.Rilievi = New List(Of rilievoAvv)

            objParametriAgenda.Disciplinare = dpi_cod

            objParametriAgenda.PaginaSitoOrigine = enum_PagineAgenda_2010.Pagina_Trattamenti

            Dim lavCodFinale As String = lav_cod

            Select Case lavCodFinale

                Case LAVCOD_FASI_FENOLOGICHE

                    'Case LAVCOD_RILIEVO_AVVERSITA_TRAPPOLE

                    '    Url = "Installazione_Trappole.aspx"

                Case Else

                    Dim udm1 As String() = udm_cod.Split("_")
                    Dim avCod1 As String() = av_cod.Split("|")

                    Dim udmFinale As String = "0"
                    Dim valoreFinale As String = ""

                    If udm1.Length = 5 Then
                        lavCodFinale = udm1(4)
                        udmFinale = udm1(3)
                        If IsNumeric(udm1(1)) Then
                            valoreFinale = udm1(1)
                        Else
                            valoreFinale = "1"
                        End If
                        'valoreFinale = udm1(1)
                    Else
                        lavCodFinale = udm1(3)
                        udmFinale = udm1(2)
                        valoreFinale = "0"
                    End If

                    For Each impianto In objImpianti
                        objParametriAgenda.Rilievi.Add(New rilievoAvv With {
                                .Av_cod = avCod1(0),
                                .Udm_cod = udmFinale,
                                .Valore = valoreFinale,
                                .Impianto = impianto
                            })
                    Next

                    '(13/03/2019 fede) forzo anche per le trappole il rilievo avv in campo per ora
                    lavCodFinale = LAVCOD_RILIEVO_AVVERSITA_CAMPO

            End Select


            'nuovo lav_cod
            objParametriAgenda.Lav_Cod = lavCodFinale

            'nuovi movimenti (da capire i movimenti di scarico magazzino e costi accessori)
            objParametriAgenda.Movimenti = New List(Of Movimento)
            objParametriAgenda.Movimenti.Add(New Movimento With {.Cau_Mov = CAU_RILIEVO_CAMPO, .Data_Registrazione = objParametriAgenda.Data})

            objParametriAgenda.Tipo_Operazione = enum_TipoOperazioneDB.Scrittura

            objParametriAgenda.salva()

            r.RispostaOK = True
            r.RispostaStringa = Url

        Catch ex As Exception

            r.RispostaOK = False
            'uso questa funzione per ottenere il Messaggio..:
            r.Errore = AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)


        End Try

        Return r

    End Function

