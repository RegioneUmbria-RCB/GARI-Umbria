                    Exit Sub
                End If

                ComboFormulati.Copertura = Copertura

                ComboFormulati.Flag_ClasseTossicologica = True
                ComboFormulati.Flag_Classificazione = True
                'ComboFormulati.CaricaComboFormulatiClassificazione()


                'Stato Impianto --> Default 102 = Produzione
                Dim Stato_Impianto As Integer = 0
                Dim Stato_Impianto_Controllo As Integer

                For i = 0 To ListaImpianti.Count - 1

                    Select Case ListaImpianti(i).Stato_Impianto
                        Case 101, 2, 3 'I anno allev., II anno allev.
                            Stato_Impianto_Controllo = 101 'Allevamento
                        Case Else
                            Stato_Impianto_Controllo = 102 'Produzione
                    End Select


                    If Stato_Impianto = 0 Then
                        'Inizializzazione
                        Stato_Impianto = Stato_Impianto_Controllo
                    End If
                    If Stato_Impianto <> Stato_Impianto_Controllo Then
                        Stato_Impianto = -1 'Eterogeneo
                        Exit For
                    End If

                Next
                ComboFormulati.Stato_Impianto = Stato_Impianto


                If objParametriAgenda.FiltroRicerca = "2" Then

                    Dim Array_AvCod(0) As Integer
                    Dim Array_AvGru(0) As Integer

                    If ddl_avversita.SelectedValue <> "" Then
                        If Split(ddl_avversita.SelectedValue, "|")(0) <> "0" Then
                            Array_AvCod(0) = Split(ddl_avversita.SelectedValue, "|")(0)
                        Else
                            Array_AvCod(0) = 0
                        End If
                        If Split(ddl_avversita.SelectedValue, "|")(1) <> "0" Then
                            Array_AvGru(0) = Split(ddl_avversita.SelectedValue, "|")(1)
                        Else
                            Array_AvGru(0) = 0
                        End If
                    End If

                    ComboFormulati.Av_Cod = Array_AvCod
                    ComboFormulati.Av_Gru = Array_AvGru

                End If

                ComboFormulati.GestioneLotto = Session("GestioneLotti_Formulati")
                ComboFormulati.GestioneGiacenze = Session("GestioneGiacenze_Formulati")

                If CB_VisualizzaGiacenzeZero.Checked Then
                    ComboFormulati.EscludiGiacenzeZero = False
                End If

                '(29/11/2019 fede) controllo stato centro
                Dim Stato_Cod As String = ""
                If objParametriAgenda.Sa_Cod = "0" Then
                    Dim objIndI As New AgronicaCoreAnagrafeDAL.ImpresexIndirizzi_R
                    Stato_Cod = objIndI.Stato_From_Piva(objParametriAgenda.Piva, objParametri_Server)
                Else
                    Dim objIndC As New AgronicaCoreAnagrafeDAL.CentrixIndirizzi_Read
                    Stato_Cod = objIndC.Stato_from_PivaSaCod(objParametriAgenda.Piva, objParametriAgenda.Sa_Cod, objParametri_Server)
                End If
                If Stato_Cod.Length <> 2 Then
                    Stato_Cod = "IT"
                End If



                'If Not Session("Formulati_Stato") Is Nothing AndAlso Session("Formulati_Stato") <> "" Then
                ComboFormulati.Stato_Cod = Stato_Cod 'Session("Formulati_Stato")
                'End If

                ComboFormulati.CaricaComboFormulatiClassificazioni_Storico()

                Lbl_Num_Formulati.InnerText = "(" & ComboFormulati.N_Formulati & ")"

                ComboFormulati.ddl_Formulati.Items(0).Text = "SELEZIONARE PRODOTTO"

                'se ho caricato un solo formulato preseleziono quello
                'gesticco eccezione per non bloccare
                If ComboFormulati.N_Formulati = 1 Then
                    Try
                        ComboFormulati.ddl_Formulati.SelectedIndex = 1
                        Cambiato_Formulato()
                    Catch ex As Exception

                    End Try

                Else
                    If Not statoEspansione Then
                        ScriptManager.RegisterStartupScript(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType(),
                                      String.Format("jQuery_{0}", ComboFormulati.ClientID), ComboFormulati.GetJS(), True)
                    End If
                End If


        End Select





    End Sub

