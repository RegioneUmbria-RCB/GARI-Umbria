    Private Sub Cambiato_Fertilizzante()

        Dim FerCod As Integer
        Dim N, N_Utile, P2O5, K2O, MgO, Cu As String
        Dim UdmCod As Integer
        Dim UdmDes As String
        Dim QtaPresente As String = "0"

        Dim DatiFertilizzante As String
        Dim TestoFertilizzante As String
        Dim TipoFertilizzante As Integer
        Dim Epoca As Integer
        Dim Efficienza As Decimal = 1
        Dim Regolamento_Cod As Integer = 0
        Dim Tipo_PuaRegolamento As Integer = 0
        Dim EffCod As Integer = 0

        Dim ClassiTessitura As New List(Of Integer)
        Dim Lotto As String
        Lbl_Dose_Consigliata.Text = ""
        Lbl_Dose_Consigliata.Visible = False
        Lbl_Dose_Consigliata2.Text = ""
        Lbl_Dose_Consigliata2.Visible = False
        lbl_qta_residua.Visible = False
        Div_DettaglioDoseConsentita.Visible = False

        Regolamento_Cod = objParametriAgenda.Disciplinare.Split("/")(0)

        If objParametriAgenda.Disciplinare.Split("/").Length > 1 Then
            Tipo_PuaRegolamento = objParametriAgenda.Disciplinare.Split("/")(1)
        End If

        Dim Veg_Cod As Integer = 0
        If objParametriAgenda.Veg_Cod.Split("/").Length > 0 AndAlso IsNumeric(objParametriAgenda.Veg_Cod.Split("/")(0)) AndAlso CInt(objParametriAgenda.Veg_Cod.Split("/")(0)) > 0 Then
            Veg_Cod = CInt(objParametriAgenda.Veg_Cod.Split("/")(0))
        End If

        Txt_Efficienza.Text = "1"

        lbl_n_calcolato.Style.Add("display", "none")
        lbl_p_calcolato.Style.Add("display", "none")
        lbl_k_calcolato.Style.Add("display", "none")
        lbl_cu_calcolato.Style.Add("display", "none")


        If ComboFertilizzanti.Valore_Combo <> "" Then

            DatiFertilizzante = Split(ComboFertilizzanti.Valore_Combo, "$")(0)
            TestoFertilizzante = ComboFertilizzanti.Testo_Combo

            'N calcolato
            If InStr(Split(Split(Split(ComboFertilizzanti.Testo_Combo, "(")(1), ")")(0), "-")(0), "*") <> 0 Then
                lbl_n_calcolato.Style.Remove("display")
            End If
            'p calcolato
            If InStr(Split(Split(Split(ComboFertilizzanti.Testo_Combo, "(")(1), ")")(0), "-")(1), "*") <> 0 Then
                lbl_p_calcolato.Style.Remove("display")
            End If
            'N calcolato
            If InStr(Split(Split(Split(ComboFertilizzanti.Testo_Combo, "(")(1), ")")(0), "-")(2), "*") <> 0 Then
                lbl_k_calcolato.Style.Remove("display")
            End If
            'N calcolato
            If InStr(Split(Split(Split(ComboFertilizzanti.Testo_Combo, "(")(1), ")")(0), "-")(3), "*") <> 0 Then
                lbl_cu_calcolato.Style.Remove("display")
            End If

            FerCod = Split(DatiFertilizzante, "/")(0)
            'MatCod = Split(DatiFertilizzante, "/")(1)

            If FerCod = 0 Then
                ImgBtn_Info.Visible = False
            Else
                ImgBtn_Info.Visible = True
            End If

            '-----------
            'TITOLI
            '-----------
            Dim strNPKM As String = Split(DatiFertilizzante, "/")(1)
            N = Split(strNPKM, "-")(0)
            P2O5 = Split(strNPKM, "-")(1)
            K2O = Split(strNPKM, "-")(2)
            MgO = Split(strNPKM, "-")(3)
            Cu = Split(strNPKM, "-")(4)

            Txt_N.Text = N
            Txt_P2O5.Text = P2O5
            Txt_K2O.Text = K2O
            Txt_MgO.Text = MgO
            Txt_Cu.Text = Cu


            If Split(ComboFertilizzanti.Valore_Combo, "$").Length > 6 Then
                EffCod = Split(ComboFertilizzanti.Valore_Combo, "$")(6)
            End If

            If Split(ComboFertilizzanti.Valore_Combo, "$").Length > 7 Then
                UdmCod = Split(ComboFertilizzanti.Valore_Combo, "$")(7)
            End If

            If Split(ComboFertilizzanti.Valore_Combo, "$").Length > 8 Then
                Lotto = Split(ComboFertilizzanti.Valore_Combo, "$")(8)
            End If

            ClassiTessitura = Master_Operazione.GetClassiTessituraImpiantiSelezionati()

            'Controllo se il titolo lo devo leggere dagli Effluenti
            'If objParametriAgenda.Lav_Cod = LAVCOD_DISTRIBUZIONE_AMMENDANTI AndAlso objParametriAgenda.TipoRicetta = enum_TipoRicetta.PianoDistribuzionePua Then

            '    If EffCod <> 0 And Qs_Pua_Cod <> 0 Then

            '        'Cerco l'effluente selezionato
            '        Dim objEff As New AgronicaCorePUA_DAL.Pua_Effluente_R
            '        Dim DtEffluenti As DataTable = objEff.Leggi(Qs_Pua_Cod, " azoto_qta > 0 AND Eff_Cod=" & EffCod, "", objParametri_Server)

            '        If Not IsNothing(DtEffluenti) AndAlso DtEffluenti.Rows.Count = 1 AndAlso IsNumeric(DtEffluenti.Rows(0).Item("Azoto_Titoli")) Then

            '            N = DtEffluenti.Rows(0).Item("Azoto_Titoli")
            '            Txt_N.Text = Math.Round(CDec(N), 2).ToString
            '        End If
            '    End If

            'End If

            '-----------
            'EFFICIENZA
            '-----------
            If ComboFertilizzanti.Valore_Combo.Split("/").Length > 1 AndAlso Split(ComboFertilizzanti.Valore_Combo, "$")(1) <> "0" Then

                TipoFertilizzante = CInt(Split(ComboFertilizzanti.Valore_Combo, "$")(1))
                'Regolamento_Cod = CInt(Split(ComboFertilizzanti.Valore_Combo, "$")(1).Split("|")(1))

                If Not IsNothing(ComboEpoche.ddl_ComboEpocheFertilizzazione) AndAlso Not IsNothing(ComboEpoche.ddl_ComboEpocheFertilizzazione.SelectedValue) AndAlso IsNumeric(ComboEpoche.ddl_ComboEpocheFertilizzazione.SelectedValue) Then
                    Epoca = CInt(ComboEpoche.ddl_ComboEpocheFertilizzazione.SelectedValue)
                End If

                If TipoFertilizzante <> 0 AndAlso Epoca <> 0 Then

                    Select Case Tipo_PuaRegolamento
                        Case 0
                        Case 1 'pua 2007
                            Dim objEff As New AgronicaCoreMetaSchemaDAL.EfficienzaxTipoFertilizzante_R
                            Efficienza = objEff.Efficienza_From_Id_Tp_Fer_Em_Cod(TipoFertilizzante, Epoca, objParametri_Server)
                        Case Else 'pan successivi
                            Dim TipoAllevamento As Integer = 0
                            If riga_animali.Visible Then
                                TipoAllevamento = CInt(Cmb_Allevamenti.SelectedValue)
                            End If
                            Dim Dose = 1
                            Dim qta, qta_trasformata, qta_N As Decimal
                            If Txt_Dose_HA.Text <> "NaN" AndAlso IsNumeric(Txt_Dose_HA.Text) Then
                                qta = Txt_Dose_HA.Text
                                Select Case Cmb_UdM.SelectedValue
                                    Case "2", "29" 'kg, l
                                        qta_trasformata = qta
                                    Case "4" 'q
                                        qta_trasformata = qta * 100
                                    Case "304" 't
                                        qta_trasformata = qta * 1000
                                    Case "19" 'mc
                                        qta_trasformata = qta * 1000
                                End Select
                                qta_N = qta * N / 100
                                If qta_N > 125 Then
                                    Dose = 2
                                End If
                            End If
                            Efficienza = AggiornaEfficienza(EffCod, Epoca, TipoAllevamento, Dose, Regolamento_Cod, ClassiTessitura, Veg_Cod)
                    End Select

                    Txt_Efficienza.Text = Efficienza.ToString

                End If


            End If

            '-----------
            'TITOLI
            '-----------

            N_Utile = N
            If IsNumeric(N) Then
                N_Utile = CDec(N) * Efficienza
            End If
            Txt_N_Utile.Text = N_Utile

            Dim Qta_Ha_Distribuibile_Prodotto As Decimal = 1000000
            Dim Qta_Ha_Distribuibile_Prodotto_Ricette As Decimal = 1000000
            Dim strMassimali As String = ControllaMassimali(False, Qta_Ha_Distribuibile_Prodotto, Qta_Ha_Distribuibile_Prodotto_Ricette)

            If Qta_Ha_Distribuibile_Prodotto <> 1000000 Then
