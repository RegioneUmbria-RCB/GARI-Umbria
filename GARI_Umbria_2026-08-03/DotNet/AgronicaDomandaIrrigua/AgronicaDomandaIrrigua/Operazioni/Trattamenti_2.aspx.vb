    '########################################################################################
    Private Function Carica_SoglieIntervento_Avversita() As Boolean

        Dim risposta As Boolean = False

        Dim objAgroWebConfig As New AgroWebConfig
        Dim strAvversita As String
        Dim strGruppiAvversita As String
        Dim Av_Cod As Integer

        Dim ObjDownloadWs As WS_Disciplinari.AgroWS_Disciplinari
        Dim Dati As String

        Dim XmlDocumento As New System.Xml.XmlDocument
        Dim XmlNodo As System.Xml.XmlNodeList
        Dim XmlElemento As System.Xml.XmlElement

        Dim DtSoglieA As New DataTable
        Dim DrA As DataRow
        Dim DrSogliaA() As DataRow

        DtSoglieA.Columns.Add(New DataColumn("Av_Cod", GetType(Integer)))
        DtSoglieA.Columns.Add(New DataColumn("Soglia", GetType(String)))
        DtSoglieA.Columns.Add(New DataColumn("Soglia_Cod", GetType(Integer)))
        DtSoglieA.Columns.Add(New DataColumn("Quantita", GetType(String)))
        DtSoglieA.Columns.Add(New DataColumn("Udm_Cod", GetType(Integer)))
        DtSoglieA.Columns.Add(New DataColumn("Lav_Cod", GetType(Integer)))


        strAvversita = ""
        strGruppiAvversita = ""

        Dim Array() As String
        Dim Dpi_Cod As Integer = 0
        Dim IdRcdpi As Integer = 0
        Dim Grfi_Cod As Integer = 0
        Dim Flag_Protetto As Integer = 0
        Dim Flag_PubblicoPrivato As Integer = 0

        Array = Split(CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Valore_Combo, "/")

        Dpi_Cod = Array(0)
        IdRcdpi = Array(1)
        Grfi_Cod = Array(2)
        Flag_Protetto = Array(3)
        Flag_PubblicoPrivato = Array(4)

        '------------------------------------------------------------------------------
        'AVVERSITA' SINGOLE
        '------------------------------------------------------------------------------

        strAvversita = strAvversita & " Av_Cod=" & Split(ddl_avversita.SelectedValue, "|")(0)

        Try

            ObjDownloadWs = New WS_Disciplinari.AgroWS_Disciplinari
            Dim objWs As New AgronicaCoreVarieDAL.ConnessioneWS
            objWs.NewWS(ObjDownloadWs,
                                objAgroWebConfig.GiasOnline_WS_Disciplinari_AgroWS_Disciplinari,
                                objParametri_Utenti)

            If Flag_PubblicoPrivato = 2 Then
                Dpi_Cod = -Dpi_Cod
            End If

            Dati = ObjDownloadWs.Leggi_SoglieIntervento(CInt(IdRcdpi),
                                                            CInt(Dpi_Cod),
                                                            CInt(0),
                                                            CInt(0),
                                                            CInt(0),
                                                            CInt(0),
                                                            CInt(0),
                                                            CStr(strAvversita),
                                                            CInt(0),
                                                            CStr(Session("ASG_Utente_Username_Crypt")),
                                                            CStr(Session("ASG_Utente_Password_Crypt")))

        Catch ex As Exception

            'AgroMsgBox("Si sono verificati errori in fase di chiamata al WebService Dicliplinari!", Page)

        End Try

        If Not IsNothing(Dati) AndAlso Dati.ToLower.IndexOf("errore") < 0 Then

            XmlDocumento.LoadXml(Dati)

            XmlNodo = XmlDocumento.GetElementsByTagName("Record")

            If XmlNodo IsNot Nothing Then

                For Each XmlElemento In XmlNodo

                    DrA = DtSoglieA.NewRow

                    DrA.Item("Av_Cod") = CInt(XmlElemento.GetAttribute("av_cod"))
                    DrA.Item("Soglia") = CStr(XmlElemento.GetAttribute("dichiarazione_des").ToString.ToLower)
                    DrA.Item("Soglia_Cod") = CStr(XmlElemento.GetAttribute("si_cod"))

                    DrA.Item("Quantita") = CStr(XmlElemento.GetAttribute("quantita"))
                    DrA.Item("Udm_Cod") = 0
                    If IsNumeric(XmlElemento.GetAttribute("udm_cod_specifico")) Then
                        DrA.Item("Udm_Cod") = CInt(XmlElemento.GetAttribute("udm_cod_specifico"))
                    End If
                    DrA.Item("Lav_Cod") = 0
                    If IsNumeric(XmlElemento.GetAttribute("lav_cod")) Then
                        DrA.Item("Lav_Cod") = CInt(XmlElemento.GetAttribute("lav_cod"))
                    End If
                    DtSoglieA.Rows.Add(DrA)

                Next

            End If

        End If


        If ddl_avversita.SelectedValue = "" Then
            Exit Function
        End If
        Av_Cod = Split(ddl_avversita.SelectedValue, "|")(0)

        DrSogliaA = DtSoglieA.Select("Av_Cod=" & Av_Cod)

        If DrSogliaA IsNot Nothing AndAlso DrSogliaA.Length > 0 Then

            Dim iSoglie As Integer

            ddl_soglieAvversita.Items.Clear()

            For iSoglie = 0 To DrSogliaA.Length - 1

                risposta = True

                Dim str As String
                Dim value As String


                If DrSogliaA(iSoglie).Item("Quantita") <> "" Then
                    str = " > del " & CDec(DrSogliaA(iSoglie).Item("Quantita")) &
                            DrSogliaA(iSoglie).Item("Soglia").ToString
                    value = DrSogliaA(iSoglie).Item("Av_Cod") & "_" &
                                DrSogliaA(iSoglie).Item("Quantita") & "_" &
                                DrSogliaA(iSoglie).Item("Soglia_Cod") & "_" &
                                DrSogliaA(iSoglie).Item("Udm_Cod") & "_" &
                                DrSogliaA(iSoglie).Item("Lav_Cod")
                Else
                    str = DrSogliaA(iSoglie).Item("Soglia").ToString
                    value = DrSogliaA(iSoglie).Item("Av_Cod") & "_" &
                                    "_" & DrSogliaA(iSoglie).Item("Soglia_Cod") & "_" &
                                DrSogliaA(iSoglie).Item("Udm_Cod") & "_" &
                                DrSogliaA(iSoglie).Item("Lav_Cod")
                End If

                ddl_soglieAvversita.Items.Add(New ListItem(str, value))

            Next

        End If


        If ddl_soglieAvversita.Items.Count > 0 Then
            Riga_Soglia.Visible = True
            cambioSoglia()
        End If

        getJSGeneric(ddl_soglieAvversita)

        Return risposta

    End Function

    Protected Sub ddl_soglieAvversita_SelectedIndexChanged(sender As Object, e As EventArgs) Handles ddl_soglieAvversita.SelectedIndexChanged

        cambioSoglia()

    End Sub

    Protected Sub cambioSoglia()

        Dim Soglia_LavCod As Integer = 0
        Dim Soglia_AvCod As Integer = 0
        Dim Soglia_Qta As Decimal = 0
        Dim Soglia_UdmCod As Integer = 0

        Lbl_Verifica_Soglia.InnerText = ""
        Lbl_Verifica_Soglia.Visible = False
        pnlBtnRilievo.Visible = False

        Dim strVerificaSoglia As String = ""
        Dim SogliaSoddisfatta As Boolean = True

        If ddl_soglieAvversita.SelectedValue = "" Then
            Exit Sub
        Else
            If Split(ddl_soglieAvversita.SelectedValue, "_").Length > 4 Then
                Soglia_AvCod = Split(ddl_soglieAvversita.SelectedValue, "_")(0)
                If IsNumeric(Split(ddl_soglieAvversita.SelectedValue, "_")(1)) Then
                    Soglia_Qta = Split(ddl_soglieAvversita.SelectedValue, "_")(1)
                End If
                Soglia_UdmCod = Split(ddl_soglieAvversita.SelectedValue, "_")(3)
                Soglia_LavCod = Split(ddl_soglieAvversita.SelectedValue, "_")(4)
            Else
                Soglia_AvCod = Split(ddl_soglieAvversita.SelectedValue, "_")(0)
                Soglia_Qta = 0
                Soglia_UdmCod = Split(ddl_soglieAvversita.SelectedValue, "_")(2)
                Soglia_LavCod = Split(ddl_soglieAvversita.SelectedValue, "_")(3)
            End If

            If Session("Blocca_Soglia") IsNot Nothing AndAlso Session("Blocca_Soglia") = True Then

                Lbl_Verifica_Soglia.Visible = True

                SogliaSoddisfatta = ControllaSogliaSoddisfatta(Soglia_LavCod, Soglia_AvCod, Soglia_UdmCod, Soglia_Qta, strVerificaSoglia)

                If SogliaSoddisfatta Then
                    'Lbl_Verifica_Soglia.InnerText = "Soglia Soddisfatta"
                Else
                    Lbl_Verifica_Soglia.InnerText = "Soglia/Giustificazione NON ancora rilevata sugli appezzamenti: " & strVerificaSoglia
                    Lbl_Verifica_Soglia.Visible = True
                    'al momento 
                    Select Case Soglia_LavCod
                        Case LAVCOD_RILIEVO_AVVERSITA_CAMPO, LAVCOD_RILIEVO_AVVERSITA_TRAPPOLE
                            pnlBtnRilievo.Visible = True
                    End Select
                End If

            End If

        End If


    End Sub




