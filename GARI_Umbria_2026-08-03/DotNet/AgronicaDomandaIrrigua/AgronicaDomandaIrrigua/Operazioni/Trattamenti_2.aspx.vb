                    Else
                        For i = 0 To ListaImpianti.Count - 1
                            Sup_Tot += ListaImpianti(i).Sup_Imp
                        Next
                    End If

                    '------------------------------------------------
                    '----- Preparazione stringa Xml Impianti
                    '------------------------------------------------

                    XML_DatiImpianti = XmlDoc.CreateElement("DatiImpianti")

                    XmlDoc.AppendChild(XML_DatiImpianti)

                    For i = 0 To ListaImpianti.Count - 1

                        XML_Impianto = XmlDoc.CreateElement("Impianto")

                        XML_Impianto.SetAttribute("piva", ListaImpianti(i).Piva)
                        XML_Impianto.SetAttribute("sa_cod", ListaImpianti(i).Sa_Cod)
                        XML_Impianto.SetAttribute("appezza", ListaImpianti(i).Appezza)
