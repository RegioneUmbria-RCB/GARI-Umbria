    Public Function IdentificaGrfi_Cod()
        Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
        ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()

        Dim appezza_string As String = ""
        Dim i As Integer
        For i = 0 To ListaImpianti.Count - 1
            If appezza_string.Length = 0 Then
                appezza_string = " (Sa_Cod =" & ListaImpianti(i).Sa_Cod & " AND Appezza =" & ListaImpianti(i).Appezza & " AND ID_REG = " & ListaImpianti(i).ID_Reg & ")"
            Else
                appezza_string = appezza_string & " or (Sa_Cod =" & ListaImpianti(i).Sa_Cod & " AND Appezza =" & ListaImpianti(i).Appezza & " AND ID_REG = " & ListaImpianti(i).ID_Reg & ")"
            End If
        Next



        If appezza_string.Length = 0 Then
            Return -999
        Else
            appezza_string = "( " & appezza_string & " )"
        End If



        Dim dt As DataTable
        Dim objAppeza As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read

        dt = objAppeza.Leggi_Lista_grfi_cod(ListaImpianti(0).Piva, appezza_string, objParametri_Server)

        Dim grfi_cod As Integer
        Try
            grfi_cod = dt.Rows(0).Item("Grfi_Cod")
        Catch ex As Exception
            grfi_cod = 0
        End Try


        For i = 1 To dt.Rows.Count - 1
            If Not IsDBNull(dt.Rows(i).Item("grfi_cod")) Then
                If dt.Rows(i).Item("grfi_cod") <> grfi_cod Then
                    Return -1
                End If
            Else
                Return -1
            End If
        Next
        Return grfi_cod
    End Function

    'dato l'elenco di impianti restituisce copertura se almeno un impianto ha la copertura
    Private Function IdentificaCopertura()

        Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
        ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()

        Dim appezza_string As String = ""
        Dim i As Integer
        For i = 0 To ListaImpianti.Count - 1
            If appezza_string.Length = 0 Then
                appezza_string = " (Sa_Cod =" & ListaImpianti(i).Sa_Cod & " AND Appezza =" & ListaImpianti(i).Appezza & " AND ID_REG = " & ListaImpianti(i).ID_Reg & ")"
            Else
                appezza_string = appezza_string & " or (Sa_Cod =" & ListaImpianti(i).Sa_Cod & " AND Appezza =" & ListaImpianti(i).Appezza & " AND ID_REG = " & ListaImpianti(i).ID_Reg & ")"
            End If
        Next

        If appezza_string.Length = 0 Then
            Return "-999"
        Else
            appezza_string = "( " & appezza_string & " )"
        End If

        Dim dt As DataTable
        Dim objAppeza As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read

        dt = objAppeza.Leggi_Lista_cop_cod(ListaImpianti(0).Piva, appezza_string, objParametri_Server)

        Dim copertura As String = ""

        For i = 0 To dt.Rows.Count - 1
            If Not IsDBNull(dt.Rows(i).Item("cop_cod")) Then
                Select Case CInt(dt.Rows(i).Item("cop_cod"))
                    Case 0, 1, 3, 4, 5, 6 'antigrandine + nessuna varia
                        If InStr(copertura, "0") = 0 Then
                            copertura &= "0,"
                        End If
                    Case Else
                        If InStr(copertura, "1") = 0 Then
                            copertura &= "1,"
                        End If
                End Select
            End If
        Next
        If copertura <> "" Then
            copertura = Left(copertura, copertura.Length - 1)
        End If

        Return copertura

    End Function


