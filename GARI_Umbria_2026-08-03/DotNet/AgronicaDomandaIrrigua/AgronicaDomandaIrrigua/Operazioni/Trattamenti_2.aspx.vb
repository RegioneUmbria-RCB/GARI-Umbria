    Public Function TrovaFabbricatoCAU_Scarico(Agenda As Operazione_Agenda,
                                               Elem_Cod As Integer,
                                               Pro_Cod As Integer,
                                               Mat_Cod As Integer) As String
        Dim Fabbricato As String = "0"
        For Each movimenti In Agenda.Movimenti
            If movimenti.Cau_Mov = CAU_SCARICO Then
                For Each movimenti_dettagli In movimenti.Movimenti_Dettagli
                    If movimenti_dettagli.Elem_Cod = Elem_Cod AndAlso movimenti_dettagli.Pro_Cod = Pro_Cod AndAlso movimenti_dettagli.Mat_Cod = Mat_Cod Then
                        If movimenti_dettagli.Movimenti_Destinazioni IsNot Nothing AndAlso movimenti_dettagli.Movimenti_Destinazioni.Count > 0 Then
                            Dim mov_destinazioni = movimenti_dettagli.Movimenti_Destinazioni(0)
                            Return CStr(mov_destinazioni.Id_Destinazione) & "|" & CStr(mov_destinazioni.Sa_Cod) & "|" & CStr(mov_destinazioni.Piva)
                        End If
                    End If
                Next
            End If
        Next
        Return Fabbricato
    End Function

    Public Function TrovaFabbricatoCAU_Scarico_xRicetta(XML_Ricetta_Operazione As System.Xml.XmlElement,
                                               Elem_Cod As Integer,
                                               Pro_Cod As Integer) As String
        Dim Fabbricato As String = "0"

        Dim XML_DatiRicetta_Dettagli As System.Xml.XmlElement = XML_Ricetta_Operazione.SelectSingleNode("DatiRicetta_Dettagli")
        If XML_DatiRicetta_Dettagli IsNot Nothing Then

            Dim XMLs_Ricetta_Dettaglio = XML_DatiRicetta_Dettagli.GetElementsByTagName("Ricetta_Dettaglio")
            For i = 0 To XMLs_Ricetta_Dettaglio.Count - 1
                Dim XML_Ricetta_Dettaglio As System.Xml.XmlElement = XMLs_Ricetta_Dettaglio.Item(i)
                Dim Cau_Mov = XML_Ricetta_Dettaglio.GetAttribute("cau_mov")

                Select Case Cau_Mov
                    Case CAU_SCARICO
                        Dim Elem_Cod_Op As Integer = XML_Ricetta_Dettaglio.GetAttribute("elem_cod")
                        Dim Pro_Cod_Op As Integer = XML_Ricetta_Dettaglio.GetAttribute("pro_cod")

                        If Elem_Cod = Elem_Cod_Op AndAlso Pro_Cod = Pro_Cod_Op Then
                            Dim XMLs_RicettaDestinazione = XML_Ricetta_Dettaglio.GetElementsByTagName("Ricetta_Destinazione")
                            If XMLs_RicettaDestinazione IsNot Nothing AndAlso XMLs_RicettaDestinazione.Count > 0 Then
                                Dim XML_RicettaDestinazione As System.Xml.XmlElement = XMLs_RicettaDestinazione.Item(0)
                                Return CStr(XML_RicettaDestinazione.GetAttribute("id_reg")) & "|" &
                                        CStr(XML_RicettaDestinazione.GetAttribute("sa_cod")) & "|" &
                                        CStr(XML_RicettaDestinazione.GetAttribute("piva"))
                            End If

                        End If

                End Select

            Next

        End If

        'For Each movimenti In Agenda.Movimenti
        '    If movimenti.Cau_Mov = CAU_SCARICO Then
        '        For Each movimenti_dettagli In movimenti.Movimenti_Dettagli
        '            If movimenti_dettagli.Elem_Cod = Elem_Cod AndAlso movimenti_dettagli.Pro_Cod = Pro_Cod Then
        '                If movimenti_dettagli.Movimenti_Destinazioni IsNot Nothing Then
        '                    For Each mov_destinazioni In movimenti_dettagli.Movimenti_Destinazioni
        '                        Return CStr(mov_destinazioni.Id_Destinazione) & "|" & CStr(mov_destinazioni.Sa_Cod) & "|" & CStr(mov_destinazioni.Piva)
        '                    Next
        '                End If
        '            End If
        '        Next
        '    End If
        'Next
        Return Fabbricato
    End Function

