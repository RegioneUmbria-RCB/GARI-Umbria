    Private Function ControllaMassimali(ByVal ConsideraProdottoInInserimento As Boolean,
                                        ByRef Qta_Ha_Distribuibile_Prodotto As Decimal,
                                        ByRef Qta_Ha_Distribuibile_Prodotto_Ricette As Decimal) As String

        Dim FerCod As Integer
        Dim N, N_Utile As String
        Dim i, o As Integer
        Dim Moltiplicatore As Decimal
        Dim Udm_Cod_Trasformato As Integer

        Dim N_Massimo As Decimal
        Dim N_Massimo_Org As Decimal
        Dim P_Massimo As Decimal
        Dim K_Massimo As Decimal
        Dim Mg_Massimo As Decimal
        Dim Cu_Massimo As Decimal

        Dim N_Distribuito As Decimal
        Dim P_Distribuito As Decimal
        Dim K_Distribuito As Decimal
        Dim Mg_Distribuito As Decimal
        Dim Cu_Distribuito As Decimal

        Dim N_Distribuito_Ricetta As Decimal
        Dim P_Distribuito_Ricetta As Decimal
        Dim K_Distribuito_Ricetta As Decimal
        Dim Mg_Distribuito_Ricetta As Decimal
        Dim Cu_Distribuito_Ricetta As Decimal

        Dim N_Operazione As Decimal
        Dim P_Operazione As Decimal
        Dim K_Operazione As Decimal
        Dim Mg_Operazione As Decimal
        Dim Cu_Operazione As Decimal

        Dim DatiFertilizzante As String
        Dim TipoFertilizzante As Integer
        Dim Epoca As Integer
        Dim Efficienza As Decimal = 1
        Dim ClassiTessitura As New List(Of Integer)
        Dim EffCod As Integer = 0

        Dim Regolamento_Cod As Integer = 0
        Dim Tipo_PuaRegolamento As Integer = 0


        Dim strErr_N As String = ""
        Dim strErr_P As String = ""
        Dim strErr_K As String = ""
        Dim strErr_Cu As String = ""
        Dim strErr_N_Intervento As String = ""

        Dim strErr_N_Ricetta As String = ""
        Dim strErr_P_Ricetta As String = ""
        Dim strErr_K_Ricetta As String = ""
        Dim strErr_Cu_Ricetta As String = ""


        Regolamento_Cod = objParametriAgenda.Disciplinare.Split("/")(0)

        If objParametriAgenda.Disciplinare.Split("/").Length > 1 Then
            Tipo_PuaRegolamento = objParametriAgenda.Disciplinare.Split("/")(1)
        End If

        Dim Veg_Cod As Integer = 0
        If objParametriAgenda.Veg_Cod.Split("/").Length > 0 AndAlso IsNumeric(objParametriAgenda.Veg_Cod.Split("/")(0)) AndAlso CInt(objParametriAgenda.Veg_Cod.Split("/")(0)) > 0 Then
            Veg_Cod = CInt(objParametriAgenda.Veg_Cod.Split("/")(0))
        End If


        Dim strRet As String

        Txt_Efficienza.Text = "1"

        Txt_Dose_HA.Text = Replace(Txt_Dose_HA.Text, ".", ",")

        ClassiTessitura = Master_Operazione.GetClassiTessituraImpiantiSelezionati()

        If ComboFertilizzanti.Valore_Combo <> "" Then

            DatiFertilizzante = Split(ComboFertilizzanti.Valore_Combo, "$")(0)

            FerCod = Split(DatiFertilizzante, "/")(0)
            'MatCod = Split(DatiFertilizzante, "/")(1)

            N = Txt_N.Text

            If Split(ComboFertilizzanti.Valore_Combo, "$").Length > 5 Then
                EffCod = Split(ComboFertilizzanti.Valore_Combo, "$")(6)
            End If

            '-----------
            'EFFICIENZA
            '-----------
            If ComboFertilizzanti.Valore_Combo.Split("/").Length > 1 AndAlso Split(ComboFertilizzanti.Valore_Combo, "$")(1) <> "0" Then

                TipoFertilizzante = CInt(Split(ComboFertilizzanti.Valore_Combo, "$")(1))

                If Not IsNothing(ComboEpoche.ddl_ComboEpocheFertilizzazione) AndAlso Not IsNothing(ComboEpoche.ddl_ComboEpocheFertilizzazione.SelectedValue) AndAlso IsNumeric(ComboEpoche.ddl_ComboEpocheFertilizzazione.SelectedValue) Then
                    Epoca = CInt(ComboEpoche.ddl_ComboEpocheFertilizzazione.SelectedValue)
                End If


                If TipoFertilizzante <> 0 AndAlso Epoca <> 0 Then

                    Select Case Tipo_PuaRegolamento
                        Case 0
                        Case 1 'pua 2007
                            Dim objEff As New AgronicaCoreMetaSchemaDAL.EfficienzaxTipoFertilizzante_R
                            Efficienza = objEff.Efficienza_From_Id_Tp_Fer_Em_Cod(TipoFertilizzante, Epoca, objParametri_Server)
                        Case Else 'pan successivi
                            Dim TipoAllevamento As Integer = 0
                            If riga_animali.Visible Then
                                TipoAllevamento = CInt(Cmb_Allevamenti.SelectedValue)
                            End If
                            Dim Dose = 1
                            Dim qta, qta_trasformata, qta_N As Decimal
                            If Txt_Dose_HA.Text <> "NaN" AndAlso IsNumeric(Txt_Dose_HA.Text) Then
                                qta = Txt_Dose_HA.Text
                                Select Case Cmb_UdM.SelectedValue
                                    Case "2", "29" 'kg, l
                                        qta_trasformata = qta
                                    Case "4" 'q
                                        qta_trasformata = qta * 100
                                    Case "304" 't
                                        qta_trasformata = qta * 1000
                                    Case "19" 'mc
                                        qta_trasformata = qta * 1000
                                End Select
                                qta_N = qta * N / 100
                                If qta_N > 125 Then
                                    Dose = 2
                                End If
                            End If

                            Efficienza = AggiornaEfficienza(EffCod, Epoca, TipoAllevamento, Dose, Regolamento_Cod, ClassiTessitura, Veg_Cod)
                    End Select

                    Txt_Efficienza.Text = Efficienza.ToString

                End If


            End If

            N_Utile = N
            If IsNumeric(N) Then
                N_Utile = CDec(N) * Efficienza
            End If

            If ConsideraProdottoInInserimento AndAlso Txt_Dose_HA.Text <> "NaN" AndAlso IsNumeric(Txt_Dose_HA.Text) Then

                '------------------------------------------
                'FERTILIZZANTE CHE STO INSERENDO IN MISCELA

                ' il controllo è sulla dose a ettaro
                N_Operazione = CDec(Txt_Dose_HA.Text) * CDec(N_Utile) / 100
                P_Operazione = CDec(Txt_Dose_HA.Text) * CDec(Txt_P2O5.Text) / 100
                K_Operazione = CDec(Txt_Dose_HA.Text) * CDec(Txt_K2O.Text) / 100
                Mg_Operazione = CDec(Txt_Dose_HA.Text) * CDec(Txt_MgO.Text) / 100
                Cu_Operazione = CDec(Txt_Dose_HA.Text) * CDec(Txt_Cu.Text) / 100

                'conversione forzata Kg/L x verifica massimali
                AgronicaCoreMetaSchemaDAL.UnitaMisura_R.ConvertiToKG_L(CInt(Cmb_UdM.SelectedValue), Udm_Cod_Trasformato, Moltiplicatore)

                N_Operazione = N_Operazione * Moltiplicatore
                P_Operazione = P_Operazione * Moltiplicatore
                K_Operazione = K_Operazione * Moltiplicatore
                Mg_Operazione = Mg_Operazione * Moltiplicatore
                Cu_Operazione = Cu_Operazione * Moltiplicatore

            End If

            '---------------------------------------
            ''FERTILIZZANTI GIA' INSERITI IN MISCELA
            Dim d As Integer = 0
            Dim Dt_Dosi As New DataTable
            Dt_Dosi = Session("vs_dtDosi")

            For d = 0 To Dt_Dosi.Rows.Count - 1

                'escludo il fertilizzante se già inserito
                If FerCod <> Dt_Dosi.Rows(d).Item("Fr_Cod") Then

                    AgronicaCoreMetaSchemaDAL.UnitaMisura_R.ConvertiToKG_L(Dt_Dosi.Rows(d).Item("udm_cod"), Udm_Cod_Trasformato, Moltiplicatore)
                    Dim Dose_Ha_KGL As Decimal = CDec(Dt_Dosi.Rows(d).Item("Dose_Ha_Reale")) * Moltiplicatore

                    N_Operazione += Dose_Ha_KGL * CDec(Dt_Dosi.Rows(d).Item("N_Utile")) / 100
                    P_Operazione += Dose_Ha_KGL * CDec(Dt_Dosi.Rows(d).Item("P2O5")) / 100
                    K_Operazione += Dose_Ha_KGL * CDec(Dt_Dosi.Rows(d).Item("K2O")) / 100
                    Mg_Operazione += Dose_Ha_KGL * CDec(Dt_Dosi.Rows(d).Item("MgO")) / 100
                    Cu_Operazione += Dose_Ha_KGL * CDec(Dt_Dosi.Rows(d).Item("cu")) / 100

                End If

            Next



            '---------------------------------------
            ' recupero gli IMPIANTI
            Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
            ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()

            Dim nImpiantiViolati As Integer = 0
            Dim nImpiantiViolati_Ricetta As Integer = 0

            Dim nImpiantiViolati_N_Max_Intervento As Integer = 0
            Dim N_Max_Intervento As Decimal = 0

            Dim objParametriUscita As AgronicaCorePianoConcimazioneBIZ.PianoConcimazione_FattoriCorrettivi_output

            If Regolamento_Cod > 0 AndAlso IsNumeric(objParametriAgenda.Veg_Cod.Split("/")(0)) AndAlso CInt(objParametriAgenda.Veg_Cod.Split("/")(0)) > 0 Then

                Dim objParametriIngresso As New AgronicaCorePianoConcimazioneBIZ.PianoConcimazione_FattoriCorrettivi_input
                objParametriIngresso.Regolamento_Cod = Regolamento_Cod
                objParametriIngresso.Veg_Cod = CInt(objParametriAgenda.Veg_Cod.Split("/")(0))
                objParametriIngresso.Grfi_Cod = 0

                '(26/03/2020 fede) aggiunta finalita gias
                '(grfi_cod è la finalita_rer)
                Dim Grfi_cod_Gias As Integer = IdentificaGrfi_Cod()
                objParametriIngresso.Grfi_Cod_Gias = Grfi_cod_Gias

                objParametriIngresso.SoloValorizzati = True
                objParametriIngresso.SoloVisibili = False
                objParametriIngresso.Fattore_Cod = enum_PianoConcimazione_FattoriCorrettivi.N_Max_Intervento

                Dim objPC_WS As New AgronicaCoreWebService.PianoConcimazione_WS
                'objParametriUscita = objPC_WS.FattoriCorrettivi_Leggi(objParametriIngresso)
                objParametriUscita = objPC_WS.FattoriCorrettivi_ConFinalitaGias_Leggi(objParametriIngresso)
                If objParametriUscita.ListaFattoriCorrettivi.Count > 0 Then
                    N_Max_Intervento = objParametriUscita.ListaFattoriCorrettivi.Item(0).Valore
                End If
            End If

            'se è stato selezionato un disciplinare o il regolamento bio
            Cu_Massimo = -1
            If Regolamento_Cod > 0 OrElse Regolamento_Cod = -2 Then
                If objParametriAgenda.Data >= #1/1/2019# Then
                    Cu_Massimo = 4
                Else
                    Cu_Massimo = 6
                End If
            End If

            Dim Hash_FormulatiPA As New Hashtable
            Dim Hash_FormulatiPAPesi As New Hashtable

            If ListaImpianti.Count <> 0 Then

                For i = 0 To ListaImpianti.Count - 1

                    '===========================================================================================
                    'Lettura dei massimi apporti macroelementi
                    '-------------------------------------------------------------------------------------------
                    N_Massimo = -1
                    P_Massimo = -1
                    K_Massimo = -1
                    Mg_Massimo = -1
                    N_Massimo_Org = -1

                    Dim objApporti As New AgronicaCoreAnagrafeDAL.Impresa_Progetti_R
                    Dim Regolamento_Concimazioni_Cod As Integer = 0

                    objApporti.Leggi_Macroelementi_Impostati(ListaImpianti.Item(i).Piva,
                                                                ListaImpianti.Item(i).Sa_Cod,
                                                                ListaImpianti.Item(i).Appezza,
                                                                ListaImpianti.Item(i).ID_Reg,
                                                                ListaImpianti.Item(i).Progetto_Cod,
                                                                N_Massimo, N_Massimo_Org,
                                                                P_Massimo,
                                                                K_Massimo,
                                                                Mg_Massimo,
                                                                Regolamento_Concimazioni_Cod,
                                                                objParametri_Server)

                    objApporti = Nothing

                    If N_Max_Intervento <> 0 Then
                        If (N_Operazione - N_Max_Intervento) > 0.001 Then
                            'If N_Operazione > N_Max_Intervento Then
                            strErr_N_Intervento &= " App." & ListaImpianti.Item(i).App_Nome & " (distribuiti " & (N_Operazione) & " kg/ha - limite per intervento " & N_Max_Intervento & " kg/ha)"
                            nImpiantiViolati_N_Max_Intervento += 1
                        End If
                    End If

                    N_Distribuito = 0
                    P_Distribuito = 0
                    K_Distribuito = 0
                    Mg_Distribuito = 0
                    Cu_Distribuito = 0

                    Dim objDett As New AgronicaCoreContabDAL.Movimenti_Dettagli_R

                    objDett.Leggi_Macroelementi_Distribuiti(N_Distribuito,
                                                                    P_Distribuito,
                                                                    K_Distribuito,
                                                                    Mg_Distribuito,
                                                                    Cu_Distribuito,
                                                                    0, 0, 0, 0, 0,
                                                                    ListaImpianti.Item(i).Piva,
                                                                    ListaImpianti.Item(i).Sa_Cod,
                                                                    ListaImpianti.Item(i).Appezza,
                                                                    ListaImpianti.Item(i).ID_Reg,
                                                                    ListaImpianti.Item(i).Progetto_Cod,
                                                                    ListaImpianti.Item(i).Validita_Inizio_Distinta,
