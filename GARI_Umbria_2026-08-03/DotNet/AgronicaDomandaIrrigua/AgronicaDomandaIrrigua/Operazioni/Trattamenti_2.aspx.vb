    ''' <summary>
    ''' Bind Delle Dosi
    ''' </summary>
    ''' <remarks></remarks>
    Private Sub Griglia_Dosi_Data_Bind()

        GridView_Dosi.DataSource = Session("vs_dtDosi")
        GridView_Dosi.DataBind()

        '(08/08/2018 fede) modificata edit dose per colorare e non piu eliminare la riga della dose
        If IsSemina Then
            If Fr_Cod_Modificato.Value <> "" Then
                For i = 0 To GridView_Dosi.Rows.Count - 1
                    If CInt(Fr_Cod_Modificato.Value) = GridView_Dosi.Rows(i).Cells(7).Text AndAlso
                        CStr(Lotto_Modificato.Value) = GridView_Dosi.Rows(i).Cells(24).Text AndAlso
                        CStr(Piva_Modificato.Value) = GridView_Dosi.Rows(i).Cells(45).Text AndAlso
                        CStr(Sa_Cod_Modificato.Value) = GridView_Dosi.Rows(i).Cells(46).Text AndAlso
                        CStr(Fabbricato_Cod_Modificato.Value) = GridView_Dosi.Rows(i).Cells(47).Text AndAlso
                        CStr(Piva_Rif_Modificato.Value) = If(IsNumeric(GridView_Dosi.Rows(i).Cells(48).Text), GridView_Dosi.Rows(i).Cells(48).Text, "") AndAlso
                        CStr(Sa_Cod_Rif_Modificato.Value) = If(IsNumeric(GridView_Dosi.Rows(i).Cells(49).Text), GridView_Dosi.Rows(i).Cells(49).Text, "") AndAlso
                        CStr(Id_Agenda_Rif_Modificato.Value) = If(IsNumeric(GridView_Dosi.Rows(i).Cells(50).Text), GridView_Dosi.Rows(i).Cells(50).Text, "") AndAlso
                        CStr(Id_Mov_Rif_Modificato.Value) = If(IsNumeric(GridView_Dosi.Rows(i).Cells(51).Text), GridView_Dosi.Rows(i).Cells(51).Text, "") AndAlso
                        CStr(Id_Mov_Det_Rif_Modificato.Value) = If(IsNumeric(GridView_Dosi.Rows(i).Cells(52).Text), GridView_Dosi.Rows(i).Cells(52).Text, "") Then
                        GridView_Dosi.Rows(i).BackColor = Drawing.Color.Gold
                    End If
                Next
            End If
        Else
            If Fr_Cod_Modificato.Value <> "" Then
                For i = 0 To GridView_Dosi.Rows.Count - 1
                    If CInt(Fr_Cod_Modificato.Value) = GridView_Dosi.Rows(i).Cells(7).Text AndAlso
                            CStr(Piva_Modificato.Value) = GridView_Dosi.Rows(i).Cells(45).Text AndAlso
                        CStr(Sa_Cod_Modificato.Value) = GridView_Dosi.Rows(i).Cells(46).Text AndAlso
                        CStr(Fabbricato_Cod_Modificato.Value) = GridView_Dosi.Rows(i).Cells(47).Text AndAlso
                        CStr(Piva_Rif_Modificato.Value) = If(IsNumeric(GridView_Dosi.Rows(i).Cells(48).Text), GridView_Dosi.Rows(i).Cells(48).Text, "") AndAlso
                        CStr(Sa_Cod_Rif_Modificato.Value) = If(IsNumeric(GridView_Dosi.Rows(i).Cells(49).Text), GridView_Dosi.Rows(i).Cells(49).Text, "") AndAlso
                        CStr(Id_Agenda_Rif_Modificato.Value) = If(IsNumeric(GridView_Dosi.Rows(i).Cells(50).Text), GridView_Dosi.Rows(i).Cells(50).Text, "") AndAlso
                        CStr(Id_Mov_Rif_Modificato.Value) = If(IsNumeric(GridView_Dosi.Rows(i).Cells(51).Text), GridView_Dosi.Rows(i).Cells(51).Text, "") AndAlso
                        CStr(Id_Mov_Det_Rif_Modificato.Value) = If(IsNumeric(GridView_Dosi.Rows(i).Cells(52).Text), GridView_Dosi.Rows(i).Cells(52).Text, "") Then
                        GridView_Dosi.Rows(i).BackColor = Drawing.Color.Gold
                    End If
                Next
            End If
        End If


    End Sub

    ''' <summary>
    ''' inserisce una nuova riga all'interno del dt delle dosi mantenuto in sessione
    ''' </summary>
    ''' <param name="Fr_Cod"></param>
    ''' <param name="Fr_Des"></param>
    ''' <param name="Dose"></param>
    ''' <param name="Dose_HA"></param>
    ''' <param name="Dose_HL"></param>
    ''' <param name="Qta_Tot"></param>
    ''' <param name="Udm_Cod"></param>
    ''' <param name="Udm_Des"></param>
    ''' <param name="Udm_Cod_Trasformato"></param>
    ''' <param name="Carenza"></param>
    ''' <param name="Prima_Raccolta"></param>
    ''' <param name="Av_Cod"></param>
    ''' <param name="Av_Gru"></param>
    ''' <param name="Av_Des"></param>
    ''' <param name="Dose_Etichetta"></param>
    ''' <param name="Dose_Etichetta_Max"></param>
    ''' <param name="Limite_Numero_Trattamenti"></param>
    ''' <param name="Limite_Numero_Trattamenti_UDM_SIM"></param>
    ''' <param name="Limite_Numero_Trattamenti_UDM_COD"></param>
    ''' <remarks></remarks>
    Private Sub Dosi_Inserisci(Fabbricato As String,
                               ByVal Fr_Cod As String,
                               ByVal Fr_Des As String,
                               ByVal Dose As Decimal,
                               ByVal Dose_HA As Decimal,
                               ByVal Dose_HL As Decimal,
                               ByVal Qta_Tot As Decimal,
                               ByVal Udm_Cod As Integer,
                               ByVal Udm_Des As String,
                               ByVal Udm_Cod_Trasformato As Integer,
                               ByVal For_Veg_Cod As String,
                               ByVal Carenza As String,
                               ByVal Prima_Raccolta As String,
                               ByVal Av_Cod As String,
                               ByVal Av_Gru As String,
                               ByVal Av_Des As String,
                               ByVal Dose_Etichetta As String,
                               ByVal Dose_Etichetta_Max As String,
                               ByVal Limite_Numero_Trattamenti As Integer,
                               ByVal Limite_Numero_Trattamenti_UDM_SIM As String,
                               ByVal Limite_Numero_Trattamenti_UDM_COD As Integer,
                               ByVal Soglia_Value As String,
                               ByVal Soglia_Des As String,
                               ByVal IntervalloTrattamenti_Min As Integer,
                               ByVal IntervalloTrattamenti_Max As Integer,
                               ByVal strPA_COD As String,
                               ByVal strPA_COD_Pesi As String,
                               ByVal BufferMin As Decimal,
                               ByVal BufferMax As Decimal,
                               ByVal strCLTOSS_COD As String,
                               ByVal Dose_Etichetta_Value As String,
                               ByVal Efficienza As String,
                               ByVal N As String,
                               ByVal N_Utile As String,
                               ByVal P2O5 As String,
                               ByVal K2O As String,
                               ByVal MgO As String,
                               ByVal Cu As String,
                               ByVal Dose_Ha_Reale As Decimal,
                               ByVal Dose_Hl_Reale As Decimal,
                               ByVal Dose_Tot_Reale As Decimal,
                               ByVal Ha_Hl As Integer,
                               ByVal Dose_QtaTot As Integer,
                               ByVal Lotto As String,
                               ByVal Cod_Articolo As String,
                               ByVal Mat_Regolamento As Integer,
                               ByVal Mat_Veg_Cod As Integer,
                               ByVal Mat_Cul_Cod As Integer,
                               ByVal Sup_Calcolata As Decimal,
                               ByVal Piva_Rif As String,
                               ByVal Sa_Cod_Rif As String,
                               ByVal Id_Agenda_Rif As String,
                               ByVal Id_Mov_Rif As String,
                               ByVal Id_Mov_Det_Rif As String,
                               ByVal Lav_Cod_Rif As String,
                               ByVal Cau_Mov_Rif As String,
                               ByVal Des_Rif As String,
                               ByVal Qta_Rif As String,
                               ByVal PrincipiAttiviPercAbb As String)


        'ByVal Sa_Cod As Integer,
        'ByVal Fabbricato_Cod As Integer,

        Dim Piva As String = objParametriAgenda.Piva
        Dim Sa_Cod As Integer = 0
        Dim Fabbricato_Cod As Integer = 0
        Dim objMagazzino As New AgronicaCoreAnagrafeDAL.Fabbricati_R

        If Fabbricato <> "" AndAlso Fabbricato <> "0" Then
            Fabbricato_Cod = Fabbricato.Split("|")(0)
            Sa_Cod = Fabbricato.Split("|")(1)
            Piva = Fabbricato.Split("|")(2)
        End If

        '----- Dimensiono le variabili

        Dim Dt As DataTable
        Dim Dr As DataRow
        Dim IndiceRiga As Integer = 0
        Dim ElementoPresente As Boolean
        Dim Messaggio As String = ""

        '----- Recupero i dati 

        '   Li ho gia' tutti ...
        '   Non ho la necessita' di recuperare nulla
        '   Lascio questa nota per usi futuri di Copia e Incolla

        '----- Verifico che il formulato non sia gia' presente nel datatable

        'Inizializzo
        ElementoPresente = False

        'Recupero il datatable
        Dt = Session("vs_dtDosi")

        '---------------------------------------------
        ' ELIMINO LA RIGA DAL DT
        '(08/08/2018 fede) se sono in modifica elimino il precedente e inserisco il nuovo
        If IsSemina Then
            If Fr_Cod_Modificato.Value <> "" AndAlso IsNumeric(Fr_Cod_Modificato.Value) Then
                Dim Keys() As Object = {CInt(Fr_Cod_Modificato.Value),
                                        CStr(Lotto_Modificato.Value),
                                        CStr(Piva_Modificato.Value),
                                        CStr(Sa_Cod_Modificato.Value),
                                        CStr(Fabbricato_Cod_Modificato.Value),
                                        CStr(Piva_Rif_Modificato.Value),
                                        CStr(Sa_Cod_Rif_Modificato.Value),
                                        CStr(Id_Agenda_Rif_Modificato.Value),
                                        CStr(Id_Mov_Rif_Modificato.Value),
                                        CStr(Id_Mov_Det_Rif_Modificato.Value)}
                Dr = Dt.Rows.Find(Keys)
                If Dr IsNot Nothing Then
                    Dr.Delete()
                End If
            End If
        Else
            If Fr_Cod_Modificato.Value <> "" AndAlso IsNumeric(Fr_Cod_Modificato.Value) Then
                Dim Keys() As Object = {CInt(Fr_Cod_Modificato.Value),
                                        CStr(Piva_Modificato.Value),
                                        CStr(Sa_Cod_Modificato.Value),
                                        CStr(Fabbricato_Cod_Modificato.Value),
                                        CStr(Piva_Rif_Modificato.Value),
                                        CStr(Sa_Cod_Rif_Modificato.Value),
                                        CStr(Id_Agenda_Rif_Modificato.Value),
                                        CStr(Id_Mov_Rif_Modificato.Value),
                                        CStr(Id_Mov_Det_Rif_Modificato.Value)}
                Dr = Dt.Rows.Find(Keys)
                If Dr IsNot Nothing Then
                    Dr.Delete()
                End If
            End If
        End If


        'Ciclo nelle righe del datatable
        For IndiceRiga = 0 To Dt.Rows.Count - 1
            If Dt.Rows(IndiceRiga).Item("Fr_Cod") = Fr_Cod AndAlso
                Dt.Rows(IndiceRiga).Item("Piva") = Piva AndAlso
                Dt.Rows(IndiceRiga).Item("Sa_Cod") = Sa_Cod AndAlso
                Dt.Rows(IndiceRiga).Item("Fabbricato_Cod") = Fabbricato_Cod AndAlso
                Dt.Rows(IndiceRiga).Item("Piva_Rif") = Piva_Rif AndAlso
                Dt.Rows(IndiceRiga).Item("Sa_Cod_Rif") = Sa_Cod_Rif AndAlso
                Dt.Rows(IndiceRiga).Item("Id_Agenda_Rif") = Id_Agenda_Rif AndAlso
                Dt.Rows(IndiceRiga).Item("Id_Mov_Rif") = Id_Mov_Rif AndAlso
                Dt.Rows(IndiceRiga).Item("Id_Mov_Det_Rif") = Id_Mov_Det_Rif Then
                If IsTrattamento Then
                    ElementoPresente = True
                    Messaggio = Resources.AgronicaAgenda_2010.NonEConsentitoInserireUnFormulatoGiaPresen
                End If
                If IsFertilizzazione Then
                    ElementoPresente = True
                    Messaggio = Resources.AgronicaAgenda_2010.NonEConsentitoInserireUnFertilizzanteGiaPr
                End If
                'la semina ha in chiave anche il lotto
                If IsSemina Then
                    If Dt.Rows(IndiceRiga).Item("lotto") = Lotto Then
                        ElementoPresente = True
                        Messaggio = Resources.AgronicaAgenda_2010.NonEConsentitoInserireUnaSementePiantinaGiaPresen
                    End If
                End If
                If Messaggio <> "" Then
                    Messaggi.AgroMsgBox(Messaggio, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                End If
            End If
        Next


        '----- Inserisco il nuovo record

        'Creo una nuova riga
        Dr = Dt.NewRow

        'DRUDI 2020-07-27 AGGIUNTO FABBRICATO
        Dr.Item("Piva") = Piva
        Dr.Item("Sa_Cod") = Sa_Cod
        Dr.Item("Fabbricato_Cod") = Fabbricato_Cod
        If Fabbricato_Cod <> 0 Then
            Dr.Item("Fabbricato_Des") = objMagazzino.Leggi(Piva, Sa_Cod, Fabbricato_Cod, enumSelezioneVariabile.Selezione_TabellaDatiMinimi, "", "", objParametri_Server).Rows(0)("Fabbricato_Des")
        Else
            Dr.Item("Fabbricato_Des") = "Magazzino Non Selezionato"
        End If

        Dr.Item("Fr_Cod") = Fr_Cod
        Dr.Item("Fr_Des") = Fr_Des

        Dr.Item("Udm_Cod") = Udm_Cod
        Dr.Item("Udm_Des") = Udm_Des
        Dr.Item("Udm_Cod_Trasformato") = Udm_Cod_Trasformato
        Dr.Item("Dose") = Dose
        Dr.Item("Dose_HA") = Math.Round(Dose_HA, 4)
        Dr.Item("Dose_HL") = Math.Round(Dose_HL, 4)
        Dr.Item("Qta_Tot") = Qta_Tot

        Dr.Item("Dose_Ha_Reale") = Dose_Ha_Reale
        Dr.Item("Dose_Hl_Reale") = Dose_Hl_Reale
        Dr.Item("Dose_Tot_Reale") = Dose_Tot_Reale
        Dr.Item("Ha_Hl") = Ha_Hl
        Dr.Item("Dose_QtaTot") = Dose_QtaTot

        Dr.Item("Av_Cod") = Av_Cod
        Dr.Item("Av_Gru") = Av_Gru
        Dr.Item("Av_Des") = Av_Des
        Dr.Item("Carenza") = Carenza
        Dr.Item("Prima_Raccolta") = Prima_Raccolta
        Dr.Item("For_Veg_Cod") = For_Veg_Cod

        Dr.Item("Dose_Etichetta") = Dose_Etichetta
        Dr.Item("Dose_Etichetta_Max") = Dose_Etichetta_Max
        Dr.Item("Dose_Etichetta_Value") = Dose_Etichetta_Value
        Dr.Item("Limite_Numero_Trattamenti") = Limite_Numero_Trattamenti
        Dr.Item("Limite_Numero_Trattamenti_UDM_SIM") = Limite_Numero_Trattamenti_UDM_SIM
        Dr.Item("Limite_Numero_Trattamenti_UDM_COD") = Limite_Numero_Trattamenti_UDM_COD
        Dr.Item("Soglia_Value") = Soglia_Value
        Dr.Item("Soglia_Des") = Soglia_Des
        Dr.Item("IntervalloTrattamenti_Min") = IntervalloTrattamenti_Min
        Dr.Item("IntervalloTrattamenti_Max") = IntervalloTrattamenti_Max
        Dr.Item("strPA_COD") = strPA_COD
        Dr.Item("PrincipiAttiviPercAbb") = PrincipiAttiviPercAbb
        Dr.Item("strPA_COD_Pesi") = strPA_COD_Pesi
        Dr.Item("strCLTOSS_COD") = strCLTOSS_COD
        Dr.Item("BufferMin") = BufferMin
        Dr.Item("BufferMax") = BufferMax
        Dr.Item("strBuffer") = ""
        If BufferMin <> 0 OrElse BufferMax <> 0 Then
            Dr.Item("strBuffer") = BufferMin & " - " & BufferMax
        End If

        Dr.Item("Efficienza") = Efficienza
        Dr.Item("N") = N
        Dr.Item("N_Utile") = N_Utile
        Dr.Item("P2O5") = P2O5
        Dr.Item("K2O") = K2O
        Dr.Item("MgO") = MgO
        Dr.Item("Cu") = Cu
        Dr.Item("Dose_Fittizia") = Math.Round(Dose, 3)

        Dr.Item("lotto") = Lotto

        Dr.Item("Cod_Articolo") = Cod_Articolo
        Dr.Item("Mat_Regolamento") = Mat_Regolamento
        Dr.Item("Mat_Veg_Cod") = Mat_Veg_Cod
        Dr.Item("Mat_Cul_Cod") = Mat_Cul_Cod
        Dr.Item("Sup_Calcolata") = Sup_Calcolata


        Dr.Item("Piva_Rif") = Piva_Rif
        Dr.Item("Sa_Cod_Rif") = Sa_Cod_Rif
        Dr.Item("Id_Agenda_Rif") = Id_Agenda_Rif
        Dr.Item("Id_Mov_Rif") = Id_Mov_Rif
        Dr.Item("Id_Mov_Det_Rif") = Id_Mov_Det_Rif
        Dr.Item("Lav_Cod_Rif") = Lav_Cod_Rif
        Dr.Item("Cau_Mov_Rif") = Cau_Mov_Rif
        Dr.Item("Des_Rif") = Des_Rif
        Dr.Item("Qta_Rif") = Qta_Rif
        'Dt.Columns.Add(New DataColumn("Giacenza", GetType(Decimal)))

        Dr.Item("PrincipiAttiviPercAbb") = PrincipiAttiviPercAbb

        Dt.Rows.Add(Dr)

        '----- Salvo il DataTable dentro il session

        Session("vs_dtDosi") = Dt

        '(08/08/2018 fede) se sono in modifica forzo l'aggiornamento la stringa json
        'If Fr_Cod_Modificato.Value <> "" AndAlso IsNumeric(Fr_Cod_Modificato.Value) Then

        Fr_Cod_Modificato.Value = ""
        Lotto_Modificato.Value = ""
        Piva_Modificato.Value = ""
        Sa_Cod_Modificato.Value = ""
        Fabbricato_Cod_Modificato.Value = ""
        Piva_Rif_Modificato.Value = ""
        Sa_Cod_Rif_Modificato.Value = ""
        Id_Agenda_Rif_Modificato.Value = ""
        Id_Mov_Rif_Modificato.Value = ""
        Id_Mov_Det_Rif_Modificato.Value = ""

        Dim strJS1 As New StringBuilder
        strJS1.AppendLine("$(document).ready(function () { ")
        strJS1.AppendLine("      Btn_AggiornaDosiGriglia_click(); ")
        strJS1.AppendLine(" });")
        ScriptManager.RegisterStartupScript(CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel), CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).GetType(),
                                            String.Format("jQuery_{0}", CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).ClientID), strJS1.ToString, True)
        'End If


    End Sub





    ''' <summary>
    ''' Cancellazione / Modifica di una dose
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    ''' <remarks></remarks>
    Private Sub GridView_Dosi_RowCommand(ByVal sender As Object, ByVal e As System.Web.UI.WebControls.GridViewCommandEventArgs) Handles GridView_Dosi.RowCommand

        Dim IndiceRigaGriglia As Integer = 0

        Dim FrCod As Integer = 0
        Dim FrDes As String = ""

        Dim AvCod As String
        Dim AvGru As String
        Dim AvCodxDose As Integer
        Dim AvGruxDose As Integer
        Dim AvDes As String
        Dim Soglia_Value As String
        Dim Soglia_Des As String

        Dim Dt As DataTable
        Dim Dr As DataRow

        Dim Frazione As Decimal = 0
        Dim Dose As Decimal = 0
        Dim DoseTotale As Decimal = 0

        Dim Dose_HA_Reale, Dose_Hl_Reale, Dose_Tot_Reale As Decimal
        Dim Ha_Hl, Dose_QtaTot As Integer

        Dim DoseTrasformata As Decimal = 0
        Dim QuantitaTotale As Decimal = 0
        Dim QuantitaParziale As Decimal = 0
        Dim UdmCod As Integer = 0
        Dim Sup_Imp As Decimal = 0
        Dim Sup_Tot As Decimal = 0
        Dim DoseEtichetta As String = ""
        Dim DoseEtichetta_Value As String = ""
        Dim FormulatiXAllegatiNormative_IDRiga As Integer = 0

        Dim Efficienza As Decimal = 1
        Dim N_Utile As Decimal = 0
        Dim N_Prodotto As Decimal = 0
        Dim P_Prodotto As Decimal = 0
        Dim K_Prodotto As Decimal = 0
        Dim Mg_Prodotto As Decimal = 0
        Dim Cu_Prodotto As Decimal = 0

        Dim TipiRichiesti As New List(Of Integer)

        Dim Piva As String
        Dim Sa_Cod As Integer
        Dim Fabbricato_Cod As Integer

        Dim Piva_Rif As String = ""
        Dim Sa_Cod_Rif As String = ""
        Dim ID_Agenda_Rif As String = ""
        Dim ID_Mov_Rif As String = ""
        Dim ID_Mov_Det_Rif As String = ""


        IndiceRigaGriglia = Convert.ToInt32(e.CommandArgument)

        Fr_Cod_Modificato.Value = ""
        Lotto_Modificato.Value = ""
        Piva_Modificato.Value = ""
        Sa_Cod_Modificato.Value = ""
        Fabbricato_Cod_Modificato.Value = ""
        Piva_Rif_Modificato.Value = ""
        Sa_Cod_Rif_Modificato.Value = ""
        Id_Agenda_Rif_Modificato.Value = ""
        Id_Mov_Rif_Modificato.Value = ""
        Id_Mov_Det_Rif_Modificato.Value = ""

        Dim Lotto As String = ""
        Dim Sup_Calcolata As Decimal


        'Recupero il datatable
        Dim Dt_Dosi As DataTable = Session("vs_dtDosi")

        If Dt_Dosi IsNot Nothing Then

            'FrCod = Split(Dt_Dosi.Rows(IndiceRigaGriglia).Item("Fr_Cod"), "/")(0)
            FrCod = Split(Dt_Dosi.Rows(IndiceRigaGriglia).Item("Fr_Cod"), "/")(0)
            FrDes = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Fr_Des")

            Lotto = Dt_Dosi.Rows(IndiceRigaGriglia).Item("lotto")

            Piva_Rif = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Piva_Rif")
            Sa_Cod_Rif = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Sa_Cod_Rif")
            ID_Agenda_Rif = Dt_Dosi.Rows(IndiceRigaGriglia).Item("ID_Agenda_Rif")
            ID_Mov_Rif = Dt_Dosi.Rows(IndiceRigaGriglia).Item("ID_Mov_Rif")
            ID_Mov_Det_Rif = Dt_Dosi.Rows(IndiceRigaGriglia).Item("ID_Mov_Det_Rif")

            Piva = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Piva")
            Sa_Cod = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Sa_Cod")
            Fabbricato_Cod = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Fabbricato_Cod")

            Select Case e.CommandName

                Case "Modifica"

                    '--------------------------------------------------------------------------
                    UdmCod = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Udm_Cod")
                    Dose = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Dose")
                    DoseTotale = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Qta_Tot")

                    Dose_HA_Reale = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Dose_Ha_Reale")
                    Dose_Hl_Reale = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Dose_Hl_Reale")
                    Dose_Tot_Reale = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Dose_Tot_Reale")

                    Ha_Hl = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Ha_Hl")
                    Dose_QtaTot = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Dose_QtaTot")


                    Sup_Calcolata = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Sup_Calcolata")

                    Select Case Ha_Hl
                        Case enum_TipoMezzo.Indefinito
                        Case enum_TipoMezzo.Ettaro
                            rbl_DoseHA.Checked = True
                            rbl_DoseHL.Checked = False
                        Case enum_TipoMezzo.Ettolitro
                            rbl_DoseHL.Checked = True
                            rbl_DoseHA.Checked = False
                    End Select
                    Select Case Dose_QtaTot
                        Case enum_TipoModalitaDistribuzione.Dose
                            rbl_QtaDose.Checked = True
                            rbl_QtaTot.Checked = False
                        Case enum_TipoModalitaDistribuzione.Totale
                            rbl_QtaTot.Checked = True
                            rbl_QtaDose.Checked = False
                    End Select

                    'seleziono l'unita di misura corretta
                    Cmb_UdM.Items.Clear()
                    Select Case UdmCod
                        Case 3, 2032, 2, 304, 4
                            CaricaKG(UdmCod)
                        Case 104, 101, 29
                            CaricaLitri(UdmCod)
                    End Select

                    Hidden_Dose_Ha_Reale.Value = Dose_HA_Reale
                    Hidden_Dose_Hl_Reale.Value = Dose_Hl_Reale
                    Hidden_Dose_Tot_Reale.Value = Dose_Tot_Reale

                    Txt_Dose_HA.Text = Math.Round(Dose_HA_Reale, 4)
                    Txt_DoseTot_HA.Text = Math.Round(Dose_Tot_Reale, 4)
                    Txt_Dose_HL.Text = Math.Round(Dose_Hl_Reale, 4)

                    Txt_SupCalcolata.Value = Sup_Calcolata

                    '(08/08/2018 fede) coloro e non elimino piu la riga del dosaggio in modifica
                    Fr_Cod_Modificato.Value = FrCod
                    Lotto_Modificato.Value = Lotto

                    If Not IsDBNull(Dt_Dosi.Rows(IndiceRigaGriglia).Item("Id_Mov_Det_Rif")) AndAlso IsNumeric(Dt_Dosi.Rows(IndiceRigaGriglia).Item("Id_Mov_Det_Rif")) Then
                        ID_Mov_Det_Rif = Dt_Dosi.Rows(IndiceRigaGriglia).Item("Id_Mov_Det_Rif")
                    End If

                    'CONCIMAZIONE

                    If IsFertilizzazione Then

                        Efficienza = CDec(Dt_Dosi.Rows(IndiceRigaGriglia).Item("Efficienza"))
                        N_Utile = CDec(Dt_Dosi.Rows(IndiceRigaGriglia).Item("N_Utile"))
                        N_Prodotto = CDec(Dt_Dosi.Rows(IndiceRigaGriglia).Item("N"))
                        P_Prodotto = CDec(Dt_Dosi.Rows(IndiceRigaGriglia).Item("P2O5"))
                        K_Prodotto = CDec(Dt_Dosi.Rows(IndiceRigaGriglia).Item("K2O"))
                        Mg_Prodotto = CDec(Dt_Dosi.Rows(IndiceRigaGriglia).Item("MgO"))
                        Cu_Prodotto = CDec(Dt_Dosi.Rows(IndiceRigaGriglia).Item("Cu"))

                        Dim TipoRichiesto As Integer = 0
                        Dim PUARegolamentoCod As Integer = objParametriAgenda.Disciplinare.Split("/")(0) '0
                        Dim Tipo_PuaRegolamento As Integer = 0

                        If objParametriAgenda.Disciplinare.Split("/").Length > 1 Then
                            Tipo_PuaRegolamento = objParametriAgenda.Disciplinare.Split("/")(1)
                        End If

                        ComboFertilizzanti.TipoRichiesto = TipoRichiesto
                        ComboFertilizzanti.TestoRicerca = ""
                        ComboFertilizzanti.IncludiAziendali = True
                        ComboFertilizzanti.Piva = objParametriAgenda.Piva
                        ComboFertilizzanti.Fabbricato_Cod = objParametriAgenda.Fabbricato
