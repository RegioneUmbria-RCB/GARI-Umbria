                    Txt_P2O5.Text = Replace(Txt_P2O5.Text, ".", ",")
                End If
                If Not IsNumeric(Me.Txt_P2O5.Text) Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareP2O5, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                End If
                If Me.Txt_P2O5.Text < 0 Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.NonEPossibileInserireUnaQuantitaDiP2O5Nega, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                Else
                    P = Txt_P2O5.Text
                End If
            Else
                P = "0"
            End If

            '------

            If Txt_K2O.Text <> "" Then
                If InStr(Txt_K2O.Text, ".") <> 0 Then
                    Txt_K2O.Text = Replace(Txt_K2O.Text, ".", ",")
                End If
                If Not IsNumeric(Me.Txt_K2O.Text) Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareK2O, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                End If
                If Me.Txt_K2O.Text < 0 Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.NonEPossibileInserireUnaQuantitaDiK2ONegat, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                Else
                    K = Txt_K2O.Text
                End If
            Else
                K = "0"
            End If

            '------

            If Txt_MgO.Text <> "" Then
                If InStr(Txt_MgO.Text, ".") <> 0 Then
                    Txt_MgO.Text = Replace(Txt_MgO.Text, ".", ",")
                End If
                If Not IsNumeric(Me.Txt_MgO.Text) Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareMgO, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                End If
                If Me.Txt_MgO.Text < 0 Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.NonEPossibileInserireUnaQuantitaDiMgONegat, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                Else
                    M = Txt_MgO.Text
                End If
            Else
                M = "0"
            End If


            If Txt_Cu.Text <> "" Then
                If InStr(Txt_Cu.Text, ".") <> 0 Then
                    Txt_Cu.Text = Replace(Txt_Cu.Text, ".", ",")
                End If
                If Not IsNumeric(Me.Txt_Cu.Text) Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareCu, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                End If
                If Me.Txt_Cu.Text < 0 Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.NonEPossibileInserireUnaQuantitaDiCuNegat, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                Else
                    Cu = Txt_Cu.Text
                End If
            Else
                Cu = "0"
            End If

            Dim Qta_Ha_Distribuibile_Prodotto As Decimal = 0
            Dim Qta_Ha_Distribuibile_Prodotto_Ricette As Decimal = 0
            Dim strMassimali As String = ControllaMassimali(True, Qta_Ha_Distribuibile_Prodotto, Qta_Ha_Distribuibile_Prodotto_Ricette)

            If strMassimali <> String.Empty Then

                If Session("UTENTE_COD_BLOCCA_SE_SUPERA_LIMITIMAS") Then
                    ' visualizzo l'alert e blocco l'inserimenti della dose
                    strMassimali = "In base alle impostazioni utente NON è possibile inserire il prodotto:<br>" & strMassimali
                    Messaggi.AgroMsgBox(strMassimali, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                Else
                    ' visualizzo solo l'alert
                    Messaggi.AgroMsgBox(strMassimali, Page, , UpdatePanel_Prodotti)
                End If

            End If



        End If

        If IsSemina Then
            If objParametriAgenda.Fabbricato <> "0" Then
                FrCod = Split(ComboSementi.Valore_Combo, "§")(0)
                FrDes = Split(ComboSementi.Valore_Combo, "§")(1)
                Cod_Articolo = Split(ComboSementi.Valore_Combo, "§")(2)
                Lotto = Split(ComboSementi.Valore_Combo, "§")(3)
                Mat_Regolamento = Split(ComboSementi.Valore_Combo, "§")(4)
                Mat_Veg_Cod = Split(ComboSementi.Valore_Combo, "§")(5)
                Mat_Cul_Cod = Split(ComboSementi.Valore_Combo, "§")(6)
            Else
                FrCod = Split(ComboSementi.Valore_Combo, "§")(0)
                FrDes = Split(ComboSementi.Valore_Combo, "§")(1)
            End If

        End If

        'controllo dose
        Dim Dose_HA As Decimal
        If Not IsNumeric(Me.Txt_Dose_HA.Text) Then
            Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumPerLaBDoseFormulato, Page, , UpdatePanel_Prodotti)
            Exit Sub
        Else
            If CDec(Me.Txt_Dose_HA.Text) <= 0 Then
                Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.NonEPossibileInserireUnaDoseNullaONegativa, Page, , UpdatePanel_Prodotti)
                Exit Sub
            End If
            Dose_HA = Txt_Dose_HA.Text
            Dose = Txt_Dose_HA.Text
        End If

        Dim Dose_HL As Decimal
        If Not IsNumeric(Me.Txt_Dose_HL.Text) Then
            Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumPerLaBDoseFormulato, Page, , UpdatePanel_Prodotti)
            Exit Sub
        Else

            'CONTROLLO OBBLIGO ACQUA
            Select Case objParametriAgenda.Lav_Cod
                Case LAVCOD_GEODISINFESTAZIONE, LAVCOD_CONCIA_SEME, LAVCOD_DISTRIBUZIONE_CONCIME, LAVCOD_DISTRIBUZIONE_AMMENDANTI, LAVCOD_SARCHIATURA_CONCIMAZIONE
                    If CDec(Me.Txt_Dose_HL.Text) < 0 Then
                        Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.NonEPossibileInserireUnaDoseNegativa, Page, , UpdatePanel_Prodotti)
                        Exit Sub
                    End If
                Case LAVCOD_TRATTAMENTO_ANTIPARASSITARIO
                    Select Case Check_NoAcqua.Checked
                        Case True
                            If CDec(Me.Txt_Dose_HL.Text) < 0 Then
                                Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareLaBQuan, Page, , UpdatePanel_Prodotti)
                                Exit Sub
                            End If
                        Case Else
                            If CDec(Me.Txt_Dose_HL.Text) <= 0 Then
                                Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareLaBQuan & " o impostare il check Trattamento Polverulento!", Page, , UpdatePanel_Prodotti)
                                Exit Sub
                            End If
                    End Select
                Case LAVCOD_SEMINA, LAVCOD_SOD_SEDDING, LAVCOD_SOVESCIO, LAVCOD_TRAPIANTO

                Case Else
                    If CDec(Me.Txt_Dose_HL.Text) <= 0 Then
                        Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareLaBQuan, Page, , UpdatePanel_Prodotti)
                        Exit Sub
                    End If
            End Select

            Dose_HL = Txt_Dose_HL.Text

        End If

        'controlli generici sulla dose totale
        If Not IsNumeric(Txt_DoseTot_HA.Text) Then
            Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareLaBDose, Page, , UpdatePanel_Prodotti)
            Exit Sub
        Else
            If CDec(Me.Txt_DoseTot_HA.Text) <= 0 Then
                Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.NonEPossibileInserireUnaBDoseTotaleBNullaO, Page, , UpdatePanel_Prodotti)
                Exit Sub
            End If
            Dose_Tot = Txt_DoseTot_HA.Text
        End If

        '-------------------------------
        ' ACQUA
        '-------------------------------
        Txt_Acqua_Ha.Text = Replace(Txt_Acqua_Ha.Text, ".", ",")

        'controllo se esiste una qta di acqua max
        Dim Dose_Acqua As Decimal
        'l'acqua non è obbligatoria quindi posso avere anche 0
        If Not IsNumeric(Me.Txt_Acqua_Ha.Text) Then
            Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareLaBQuan, Page, , UpdatePanel_Prodotti)
            Exit Sub
        Else
            Dose_Acqua = Txt_Acqua_Ha.Text
        End If

        Dim Prima_Data As String = ""
        Dim DosaggiControllati As String = ""
        Dim DosaggiControllatiValue As String = ""
        Dim Limite As Integer = 0
        Dim Limite_Udm_Cod As Integer = 0
        Dim Limite_Sim As String = ""
        Dim IntervalloTrattamenti_Min As Integer = 0
        Dim IntervalloTrattamenti_Max As Integer = 0

        Dim Mdi_Cod As Integer
        Dim Flag_Protetto As Integer
        Dim FormulatiXAllegatiNormative_IDRiga As Integer = 0

        If IsTrattamento Then

            'Controlli ETICHETTA (dosi + acqua + Numero Trattamenti + Intervallo Trattamenti)
            Dim DoseMin, DoseMax, AcquaMin, AcquaMax As Decimal
            Dim For_Veg_Av_Dos_Cod, Udm_Cod, AcquaUdm_Cod, Flag_Fioritura, Da_Epoca, A_Epoca, HaHl, Udm_Cod_Scomposta As Integer
            Dim Udm_Sim, AcquaUdm_Sim, strCLTOSS_Grado, DataSmaltimentoScorte As String
            Dim For_Veg_Av_Dos_Cod_selezionato, FormulatiXAllegatiNormative_IDRiga_Selezionato, Da_Epoca_selezionata, A_Epoca_selezionata, Udm_Cod_selezionata As Integer
            Dim Gruppo_Dosaggi, Gruppo_Dosaggi_Selezionato As Integer
            Dim Num_Max_Interventi_Globali As Integer

            Dim strAlertDosaggio As String = ""
            Dim strAlertDosaggi As String = ""
            Dim InserisciProdotto As Boolean = True

            If ComboEtichetta.ddl_Dosi IsNot Nothing AndAlso ComboEtichetta.ddl_Dosi.SelectedItem IsNot Nothing AndAlso ComboEtichetta.ddl_Dosi.SelectedValue <> "0" Then

                'controllo la dose selezionata
                If ComboEtichetta.ValoriDose(ComboEtichetta.Valore_Combo, For_Veg_Av_Dos_Cod, DoseMin, DoseMax, Udm_Cod, Udm_Sim,
                          AcquaMin, AcquaMax, AcquaUdm_Cod, AcquaUdm_Sim,
                          Da_Epoca, A_Epoca, Limite, Limite_Udm_Cod, Limite_Sim,
                          strCLTOSS_Grado, Flag_Fioritura, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max,
                                     Mdi_Cod, Flag_Protetto, FormulatiXAllegatiNormative_IDRiga, DataSmaltimentoScorte, Gruppo_Dosaggi, Num_Max_Interventi_Globali) = True Then

                    For_Veg_Av_Dos_Cod_selezionato = For_Veg_Av_Dos_Cod
                    FormulatiXAllegatiNormative_IDRiga_Selezionato = FormulatiXAllegatiNormative_IDRiga
                    Da_Epoca_selezionata = Da_Epoca
                    A_Epoca_selezionata = A_Epoca
                    Udm_Cod_selezionata = Udm_Cod
                    Gruppo_Dosaggi_Selezionato = Gruppo_Dosaggi

                    strAlertDosaggio = ""
                    If ControllaDosaggio(FrCod, Dose_Acqua, For_Veg_Av_Dos_Cod, DoseMin, DoseMax, Udm_Cod, Udm_Sim,
                                              AcquaMin, AcquaMax, AcquaUdm_Cod, AcquaUdm_Sim,
                                              Da_Epoca, A_Epoca, Limite, Limite_Udm_Cod, Limite_Sim,
                                              Flag_Fioritura, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max,
                                               Num_Max_Interventi_Globali, Gruppo_Dosaggi, strAlertDosaggio) = False Then
                        InserisciProdotto = False
                    End If
                    DosaggiControllati = ComboEtichetta.Testo_Combo
                    DosaggiControllatiValue = ComboEtichetta.Valore_Combo
                    If strAlertDosaggio <> "" Then
                        strAlertDosaggi &= "La dose (" & ComboEtichetta.Testo_Combo & ") non risulta rispettata :" & " <br>" & strAlertDosaggio & " <br>"
                    End If
                End If

                'scorro i dosaggi per controllare gli altri nella stessa epoca
                For i = 0 To ComboEtichetta.ddl_Dosi.Items.Count - 1
                    If ComboEtichetta.ValoriDose(ComboEtichetta.ddl_Dosi.Items(i).Value, For_Veg_Av_Dos_Cod, DoseMin, DoseMax, Udm_Cod, Udm_Sim,
                                                     AcquaMin, AcquaMax, AcquaUdm_Cod, AcquaUdm_Sim,
                                                     Da_Epoca, A_Epoca, Limite, Limite_Udm_Cod, Limite_Sim,
                                                     strCLTOSS_Grado, Flag_Fioritura, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max,
                                                     Mdi_Cod, Flag_Protetto, FormulatiXAllegatiNormative_IDRiga, DataSmaltimentoScorte, Gruppo_Dosaggi, Num_Max_Interventi_Globali) = True Then

                        Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
                        objUdm.ScomponiUdm(Udm_Cod_Scomposta, HaHl, Udm_Cod)

                        '(15/01/2021 fede) introdotta verifica dei dosaggi tra loro solo per i dosaggi dello stesso decreto ( = FormulatiXAllegatiNormative_IDRiga)
                        If For_Veg_Av_Dos_Cod <> For_Veg_Av_Dos_Cod_selezionato AndAlso
                                    (Udm_Cod_selezionata <> Udm_Cod) AndAlso
                                    (FormulatiXAllegatiNormative_IDRiga_Selezionato = FormulatiXAllegatiNormative_IDRiga OrElse FormulatiXAllegatiNormative_IDRiga = 0) AndAlso
                                    (Da_Epoca_selezionata = Da_Epoca OrElse Da_Epoca = 0) AndAlso
                                    (A_Epoca_selezionata = A_Epoca OrElse A_Epoca = 0) AndAlso
                                    (HaHl = 2123) Then

                            DosaggiControllati &= "<br>" & ComboEtichetta.ddl_Dosi.Items(i).Text
                            DosaggiControllatiValue &= "<br>" & ComboEtichetta.ddl_Dosi.Items(i).Value
                            strAlertDosaggio = ""
                            If ControllaDosaggio(FrCod, Dose_Acqua, For_Veg_Av_Dos_Cod, DoseMin, DoseMax, Udm_Cod, Udm_Sim,
                                           AcquaMin, AcquaMax, AcquaUdm_Cod, AcquaUdm_Sim,
                                           Da_Epoca, A_Epoca, Limite, Limite_Udm_Cod, Limite_Sim,
                                           Flag_Fioritura, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max,
                                                Num_Max_Interventi_Globali, Gruppo_Dosaggi, strAlertDosaggio) = False Then
                                InserisciProdotto = False
                            End If
                            If strAlertDosaggio <> "" Then
                                strAlertDosaggi &= "La dose (" & ComboEtichetta.ddl_Dosi.Items(i).Text & ") non risulta rispettata :" & " <br>" & strAlertDosaggio & " <br>"
                            End If

                        End If

                    End If
                Next


                If strAlertDosaggi <> "" Then
                    Messaggi.AgroMsgBox(strAlertDosaggi, Page, , UpdatePanel_Prodotti)
                End If

                If Not InserisciProdotto Then
                    Exit Sub
                End If

            End If

            ScriptManager.RegisterStartupScript(UpdatePanel_Prodotti, UpdatePanel_Prodotti.GetType, "azzera",
                                                        "$(document).ready(function () {$('#" & HiddenVarie.ClientID & "').val(''); });", True)


            If ComboEtichetta.ddl_Dosi IsNot Nothing AndAlso ComboEtichetta.ddl_Dosi.SelectedItem IsNot Nothing Then
                Dose_Etichetta = ComboEtichetta.Testo_Combo
                Dose_Etichetta_Value = ComboEtichetta.Valore_Combo
            End If

            Dose_Etichetta_Max = DoseMax


            '------

            If IsNumeric(Carenza.ToString) AndAlso CInt(Carenza) > 0 Then
                Dim data As Date
                data = objParametriAgenda.Data.AddDays(1)
                Prima_Data = data.AddDays(CInt(Carenza.ToString)).ToShortDateString
            Else
                Prima_Data = ""
            End If

        End If

        If Carenza = -1 Then
            Carenza = 0
        End If

        Dim Piva_Rif As String = ""
        Dim Sa_Cod_Rif As String = ""
        Dim Id_Agenda_Rif As String = ""
        Dim Id_Mov_Rif As String = ""
        Dim Id_Mov_Det_Rif As String = ""
        Dim Lav_Cod_Rif As String = ""
        Dim Cau_Mov_Rif As String = ""
        Dim Des_Rif As String = ""
        Dim Qta_Rif As String = ""


        Piva_Rif = hf_Piva_Rif.Value
        Sa_Cod_Rif = hf_Sa_Cod_Rif.Value
        Id_Agenda_Rif = hf_ID_Agenda_Rif.Value
        Id_Mov_Rif = hf_ID_Mov_Rif.Value
        Id_Mov_Det_Rif = hf_ID_Mov_Det_Rif.Value
        Lav_Cod_Rif = hf_Lav_Cod_Rif.Value
        Cau_Mov_Rif = hf_Cau_Mov_Rif.Value
        Qta_Rif = hf_Qta_Rif.Value
        Des_Rif = hf_Des_Rif.Value
        If Piva_Rif <> "" AndAlso Id_Agenda_Rif <> "" AndAlso IsNumeric(Id_Agenda_Rif) AndAlso Id_Agenda_Rif <> 0 Then
            Dim objMov_Dettagli As New AgronicaCoreContabDAL.Movimenti_Dettagli_R
            Dim dt_Det = objMov_Dettagli.Leggi(Piva_Rif, Sa_Cod_Rif, Id_Agenda_Rif, Id_Mov_Rif, Id_Mov_Det_Rif,
                                               0, 0, 0, "", 0, 0, 0, 0, 0, 0, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)
            If dt_Det.Rows.Count > 0 Then
                If CDec(CStr(Hidden_Dose_Tot_Reale.Value.Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale))) > dt_Det.Rows(0)("Qta") Then
                    Messaggi.AgroMsgBox("Non è possibile selezionare una Quantità superiore a " & CStr(dt_Det.Rows(0)("Qta")) & "", Page, , UpdatePanel_Prodotti)
                    Exit Sub
                End If
            End If
        End If

        Qta_Rif = CStr(Hidden_Dose_Tot_Reale.Value.Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale))



        Call Dosi_Inserisci(objParametriAgenda.Fabbricato, FrCod, FrDes, Dose,
                                Txt_Dose_HA.Text,
                                Txt_Dose_HL.Text,
                                Dose_Tot, UdmCod, UdmDes, UdmCodTrasformato,
                                For_Veg_Cod.ToString, Carenza.ToString, Prima_Data,
                                Av_Cod, Av_Gru, Av_Des,
                                DosaggiControllati, Dose_Etichetta_Max,
                                Limite, Limite_Sim, Limite_Udm_Cod,
                                Soglia_Value, Soglia_Des, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max,
                                strPA_COD, strPA_COD_Pesi, BufferMin, BufferMax, strCLTOSS_COD,
                                DosaggiControllatiValue,
                                Efficienza, N, N_Utile, P, K, M, Cu,
                                Hidden_Dose_Ha_Reale.Value.Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale),
                                Hidden_Dose_Hl_Reale.Value.Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale),
                                Hidden_Dose_Tot_Reale.Value.Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale),
                                Ha_Hl, Dose_QtaTot, Lotto, Cod_Articolo, Mat_Regolamento, Mat_Veg_Cod, Mat_Cul_Cod, sup_calcolata,
                                Piva_Rif, Sa_Cod_Rif, Id_Agenda_Rif, Id_Mov_Rif, Id_Mov_Det_Rif, Lav_Cod_Rif, Cau_Mov_Rif, Des_Rif, Qta_Rif, PrincipiAttiviPercAbb)

        Griglia_Dosi_Data_Bind()

        If IsTrattamento Then

            'verifica limite buffer
            If IsNumeric(HD_Buffer_Min.Value) Then
                If CDec(HD_Buffer_Min.Value) < BufferMin Then
                    HD_Buffer_Min.Value = BufferMin
                End If
            Else
                HD_Buffer_Min.Value = BufferMin
            End If
            If IsNumeric(HD_Buffer_Max.Value) Then
                If CDec(HD_Buffer_Max.Value) < BufferMax Then
                    HD_Buffer_Max.Value = BufferMax
                End If
            Else
                HD_Buffer_Max.Value = BufferMax
            End If

            HD_Buffer_Min_Tmp.Value = ""
            HD_Buffer_Max_Tmp.Value = ""

            If objParametriAgenda.Lav_Cod = LAVCOD_TRATTAMENTO_ANTIPARASSITARIO Then
                Check_NoAcqua.Enabled = False
            End If

            'se ho un formulato sono in modifica della riga della miscela
            'se ne ho diversi sono in inserimento
            If ComboFormulati.ddl_Formulati.Items.Count = 1 Then
                ComboFormulati.ddl_Formulati.Items.Clear()
            Else
                ComboFormulati.ddl_Formulati.SelectedIndex = -1
            End If

            Cambiato_Formulato()

            ComboEpocheDPI1.ddl_ComboEpocheDPI.Enabled = False

        End If

        If IsFertilizzazione Then

            If ComboFertilizzanti.ddl_Fertilizzanti.Items.Count = 1 Then
                ComboFertilizzanti.ddl_Fertilizzanti.Items.Clear()
            Else
                ComboFertilizzanti.ddl_Fertilizzanti.SelectedIndex = -1
            End If

            Cambiato_Fertilizzante()

        End If

        If IsSemina Then

            If ComboSementi.ddl_Sementi.Items.Count = 1 Then
                ComboSementi.ddl_Sementi.Items.Clear()
            Else
                ComboSementi.ddl_Sementi.SelectedIndex = -1
            End If

            Cambiato_Semente()

        End If

    End Sub

#End Region



