    ''' <summary>
    ''' Ripristina Dati all'interno dei Controlli quando sono in modifica
    ''' </summary>
    ''' <remarks></remarks>
    Private Sub Ripristina_Dati_nei_Controlli() Implements iOperazioneGUI_Trattamento.Ripristina_Dati_nei_Controlli

        'Questa subroutine legge le informazioni dal database
        'e ripristina lo stato dei controlli sulla form.

        'MODIFICA PER BUG DATI SALVATI CON AGENDA VECCHIA
        Dim FlagAgendaVecchiaSalvataConcimazioneDoseTotale As Boolean = False

        '------------------------------------------
        '----- Dichiarazione delle Variabili
        '------------------------------------------

        Dim i As Integer = 0
        Dim j As Integer = 0
        Dim x As Integer = 0


        Dim Fr_Cod As String
        Dim Fr_Des As String
        Dim Udm_Cod As Integer = 0
        Dim Ha_Hl As Integer
        Dim Dose_QtaTot As Integer
        Dim Udm_Cod_Trasformato As Integer = 0
        Dim Udm_Des As String = ""
        Dim Udm_Sim As String = ""
        Dim Dose As Decimal
        Dim Dose_HA, Dose_HL, Dose_Totale As Decimal
        Dim Dose_HA_Reale, Dose_HL_Reale, Dose_Tot_Reale As Decimal
        Dim Carenza As Integer = 0
        Dim For_Veg_Cod As Integer = 0
        Dim CoadiuvanteCorroborante As Boolean

        Dim PrincipiAttivi As String = ""
        Dim PrincipiAttiviPercAbb As String = ""
        Dim PrincipiAttiviPesi As String = ""
        Dim ClassiTossicologiche As String = ""
        Dim Buffer As String = ""
        Dim BufferMin As Decimal = 0
        Dim BufferMax As Decimal = 0
        Dim PercAbbMin As Decimal = 100


        Dim Dpi_Cod As Integer = 0
        Dim Disciplinare_PubblicoPrivato As Integer
        Dim Id_Rcdpi As Integer = 0
        Dim Modulo As Integer = 0
        Dim Epoca As Integer = 0

        Dim AvCod() As String
        Dim AvGru() As String
        Dim AvCod_2() As String
        Dim AvGru_2() As String
        Dim N_Avv As Integer = 0

        Dim strAvCod As String = ""
        Dim strAvGru As String = ""
        Dim strAvDes As String = ""

        Dim DoseEtichetta As String = ""
        Dim DoseEtichetta_Value As String = ""
        Dim DoseEtichetta_Max As String = ""

        Dim Destinazione As Integer
        Dim SaCodDestinazione As Integer = 0

        Dim Sup_Tot As Decimal = 0
        Dim Sup_Tot_Sel As Decimal = 0
        Dim xQtaAcqua As Decimal = 0
        Dim xGrfi_Cod As Integer = 0
        Dim Grfi_Cod As Integer = 0
        Dim Cop_Cod As Integer = 0
        Dim Copertura As Integer = 0

        Dim Efficienza As String = ""
        Dim N As String = ""
        Dim N_Utile As String = ""
        Dim P As String = ""
        Dim K As String = ""
        Dim Mg As String = ""
        Dim Cu As String = ""

        '------------------------------------------
        '----- Recupero le informazioni
        '------------------------------------------

        Dim objAgenda As New Agenda_Operazione_Helper

        Dim Agenda As New Operazione_Agenda

        Agenda = objAgenda.Leggi(objParametriAgenda.Piva,
                                         CInt(objParametriAgenda.Sa_Cod),
                                         CInt(objParametriAgenda.Id_Agenda),
                                         0,
                                         objParametri_Server)

        objAgenda = Nothing
        HD_Perc_Abb_Min.Value = 0

        If Not IsNothing(Agenda) Then

            ' per aggiunta tag a xml se usare vecchio o nuovo controllo
            Dim flagNuovoControlloRiduzioneDiserbo As Boolean = Leggi_FlagNuovoControlloRiduzioneDiserbo()

            objParametriAgenda.Piva = Agenda.Piva
            objParametriAgenda.Sa_Cod = Agenda.Sa_Cod
            objParametriAgenda.Lav_Cod = Agenda.Lav_Cod

            If Agenda.Lav_Cod = LAVCOD_ALTRE_OPERAZIONI Then
                Txt_AttivitaDes.Value = Agenda.Des_Lib
                ComboAttivita.SelectedIndex = ComboAttivita.Items.IndexOf(ComboAttivita.Items.FindByValue(Agenda.Id_Attivita))
            End If

            'NOTE
            If Not IsNothing(Agenda.Note) Then
                For i = 0 To Agenda.Note.Count - 1
                    objParametriAgenda.Note.Add(Agenda.Note(i))
                Next
            End If
            objParametriAgenda.salva()

            'MOVIMENTI
            If Not IsNothing(Agenda.Movimenti) Then

                Dim MovimentiCosti As List(Of Movimento) = New List(Of Movimento)
                objParametriAgenda.Impianti = New List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)

                For i = 0 To Agenda.Movimenti.Count - 1

                    Select Case Agenda.Movimenti(i).Cau_Mov

                        Case CAU_TRATTAMENTO, CAU_LAVORAZIONE, CAU_RILIEVO_RACCOLTA, CAU_RILIEVO_CAMPO

                            objParametriAgenda.Data = Agenda.Movimenti(i).Data

                            CType(Page.Master, OperazioneBootstrap).SetNota(Agenda.Movimenti(i).Mov_Desc)

                            Dim Elem_Cod As Integer
                            Dim Mat_Cod As Integer
                            Dim Qta As Integer
                            Dim Cal_Cod As Integer
                            Dim Lotto As String
                            'Dim Cod_Progetto As Integer

                            If IsRaccolta Then
                                Dim Modalita As Integer = Agenda.Movimenti(i).Modalita 'manuale, meccanica
                                Dim Tipo_Raccolta_Salvata As enum_RACCOLTA_TIPO = Agenda.Movimenti(i).Extra_Int  'salvo il tipo raccolta, puo essere utile
                            End If

                            If IsTrattamento OrElse IsFertilizzazione Then

                                Select Case Agenda.Movimenti(i).Mezzo
                                    Case 1
                                        'HA
                                        Me.rbl_DoseHA.Checked = True
                                        Me.rbl_DoseHL.Checked = False
                                    Case 0
                                        'HL

                                        '--------------------------------------------------------------------------------------------------------
                                        '-------------------------------------MODIFICA PER BUG DATI SALVATI CON AGENDA VECCHIA-------------------
                                        If (objParametriAgenda.Lav_Cod = LAVCOD_DISTRIBUZIONE_CONCIME OrElse
                                                objParametriAgenda.Lav_Cod = LAVCOD_SARCHIATURA_CONCIMAZIONE OrElse
                                                objParametriAgenda.Lav_Cod = LAVCOD_DISTRIBUZIONE_AMMENDANTI) Then
                                            'Se sono nella concimazione l'agenda nuovo sava sempre per ettaro, quindi sempre con 1
                                            'ma le operazioni vecchie possono salvare la dose talquale in qta movdettagli, 
                                            'ed indicano quindi con mezzo 0. devo capirlo, sia per ripristinare i dati nella tabella che
                                            'alrimenti non vengono visti , sia per quando modifico un formulato
                                            'e di default il valore me lo metterebbe in quantità dose e non quantità talquale
                                            'salvo in sessione un flag per capire
                                            'Session("FlagAgendaVecchiaSalvataConcimazioneDoseTotale") = True
                                            FlagAgendaVecchiaSalvataConcimazioneDoseTotale = True
                                        End If
                                        '--------------------------------------------------------------------------------------------------------
                                        '--------------------------------------------------------------------------------------------------------

                                        Me.rbl_DoseHL.Checked = True
                                        Me.rbl_DoseHA.Checked = False
                                End Select

                                Select Case Agenda.Movimenti(i).Modalita
                                    Case 10
                                        'Totale
                                        Me.rbl_QtaTot.Checked = True
                                        Me.rbl_QtaDose.Checked = False
                                    Case 11
                                        'dose
                                        Me.rbl_QtaDose.Checked = True
                                        Me.rbl_QtaTot.Checked = False
                                End Select

                                '-------------------------------------------
                                '-------------------------------------------
                                'Disciplinari
                                '= 0  --> Nessun Filtro + Casi Vecchi senza DPI
                                '> 0  --> DPI
                                '= -1 --> Nuovo caso con etichetta ma senza DPI
                                '= -2 --> regolamento BIO
                                '-------------------------------------------
                                '-------------------------------------------
                                Dpi_Cod = Agenda.Movimenti(i).Num_Protocollo
                                Disciplinare_PubblicoPrivato = Agenda.Movimenti(i).Disciplinare_PubblicoPrivato
                                Id_Rcdpi = Agenda.Movimenti(i).Doc_Numero

                                If IsTrattamento Then
                                    If Dpi_Cod <> 0 Then
                                        If Agenda.Movimenti(i).Extra_Int <> 0 Then
                                            Modulo = Agenda.Movimenti(i).Extra_Int
                                            Session("modulo") = Modulo
                                        End If
                                    End If
                                End If

                                If IsFertilizzazione Then
                                    If Agenda.Movimenti(i).Extra_Int <> 0 Then
                                        Epoca = Agenda.Movimenti(i).Extra_Int
                                    End If
                                End If

                                'MOVIMENTO_DETTAGLIO TECNICO x ACQUA

                                If IsTrattamento Then

                                    If Not IsNothing(Agenda.Movimenti(i).Movimenti_Dettagli_Tecnici) Then

                                        For j = 0 To Agenda.Movimenti(i).Movimenti_Dettagli_Tecnici.Count - 1

                                            If Agenda.Movimenti(i).Movimenti_Dettagli_Tecnici(j).Av_Cod = 0 AndAlso
                                                    Agenda.Movimenti(i).Movimenti_Dettagli_Tecnici(j).Av_Gru = 0 Then

                                                xQtaAcqua = Agenda.Movimenti(i).Movimenti_Dettagli_Tecnici(j).Qta_Ril

                                                'se l'acqua è stata salvata negativa significa che è stata salvata/ha, altrimenti totale
                                                If xQtaAcqua < 0 Then
                                                    Me.Txt_Acqua_Ha.Text = Math.Abs(xQtaAcqua)
                                                    rblAcqua_HA.Checked = True
                                                    rblAcqua_Tot.Checked = False
                                                Else
                                                    Me.Txt_Acqua_Tot.Text = Math.Abs(xQtaAcqua)
                                                    rblAcqua_Tot.Checked = True
                                                    rblAcqua_HA.Checked = False
                                                End If
                                            Else

                                                Select Case Dpi_Cod
                                                    Case 0
                                                        ReDim Preserve AvCod(N_Avv)
                                                        ReDim Preserve AvGru(N_Avv)
                                                        AvCod(N_Avv) = Agenda.Movimenti(i).Movimenti_Dettagli_Tecnici(j).Av_Cod.ToString
                                                        AvGru(N_Avv) = Agenda.Movimenti(i).Movimenti_Dettagli_Tecnici(j).Av_Gru.ToString
                                                        N_Avv += 1
                                                End Select
                                            End If

                                        Next

                                        'trattamento polverulento
                                        If Agenda.Lav_Cod = LAVCOD_TRATTAMENTO_ANTIPARASSITARIO Then
                                            If xQtaAcqua = 0 Then
                                                Check_NoAcqua.Checked = True
                                            End If
                                            Check_NoAcqua.Enabled = False
                                        End If
                                    End If
                                End If

                                If IsFertilizzazione Then
                                    If Not IsNothing(Agenda.Movimenti(i).Movimenti_Dettagli_Tecnici) Then
                                        For j = 0 To Agenda.Movimenti(i).Movimenti_Dettagli_Tecnici.Count - 1
                                            xQtaAcqua = Agenda.Movimenti(i).Movimenti_Dettagli_Tecnici(j).Qta_Ril
                                            If xQtaAcqua < 0 Then
                                                Me.Txt_Acqua_Ha.Text = Math.Abs(xQtaAcqua)
                                            Else
                                                Me.Txt_Acqua_Tot.Text = Math.Abs(xQtaAcqua)
                                            End If
                                        Next
                                    End If
                                End If

                            End If

                            Dim grfi_cod_x_etichette As Integer = -99

                            'MOVIMENTI_DETTAGLI
                            If Not IsNothing(Agenda.Movimenti(i).Movimenti_Dettagli) Then

                                For j = 0 To Agenda.Movimenti(i).Movimenti_Dettagli.Count - 1

                                    Lotto = Agenda.Movimenti(i).Movimenti_Dettagli(j).Lotto

                                    If IsRaccolta Then
                                        Elem_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Elem_Cod
                                        Mat_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Mat_Cod
                                        Udm_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Udm_Cod
                                        Qta = Agenda.Movimenti(i).Movimenti_Dettagli(j).Qta
                                        'Cod_Progetto  = agenda.Movimenti(i).Movimenti_Dettagli(j).Cod_Progetto
                                        Cal_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Cal_Cod
                                    End If

                                    If IsTrattamento OrElse IsFertilizzazione OrElse IsSemina Then

                                        CoadiuvanteCorroborante = False

                                        Fr_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Pro_Cod
                                        Fr_Des = ""
                                        Udm_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Extra_Int
                                        Udm_Cod_Trasformato = Agenda.Movimenti(i).Movimenti_Dettagli(j).Udm_Cod

                                        If IsTrattamento Then

                                            Dim objFrDes As New AgronicaCoreMetaSchemaDAL.Formulati_R
                                            Dim DT_Fr As DataTable = objFrDes.Leggi(Agenda.Movimenti(i).Movimenti_Dettagli(j).Pro_Cod,
                                                                          AGRODATAINIZIO,
                                                                          AGRODATAFINE,
                                                                           enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                           "",
                                                                           "",
                                                                           objParametri_Server)

                                            If DT_Fr IsNot Nothing AndAlso DT_Fr.Rows.Count > 0 Then
                                                Fr_Des = DT_Fr.Rows(0).Item("Fr_Des")
                                            End If
                                        End If

                                        If IsFertilizzazione Then

                                            Dim objParametriIngresso As New AgronicaCoreMetaSchemaBIZ.Fertilizzanti_input
                                            objParametriIngresso.Codice = Agenda.Movimenti(i).Movimenti_Dettagli(j).Pro_Cod

                                            objParametriIngresso.IncludiApporti = True
                                            objParametriIngresso.IncludiTipologia = True

                                            Dim objParametriUscita As AgronicaCoreMetaSchemaBIZ.Fertilizzanti_output
                                            Dim objFert_WS As New AgronicaCoreWebService.Fertilizzanti_WS
                                            objParametriUscita = objFert_WS.Fertilizzanti(objParametriIngresso)

                                            If objParametriUscita.ListaFertilizzanti.Count > 0 Then
                                                Fr_Des = objParametriUscita.ListaFertilizzanti(0).Descrizione
                                            End If

                                        End If

                                        If IsSemina Then

                                            Dim conMagazzino As Boolean = (From m As Movimento In Agenda.Movimenti Where m.Cau_Mov = CAU_SCARICO Select m).Count > 0

                                            If conMagazzino Then

                                                Elem_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Elem_Cod
                                                Mat_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Mat_Cod
                                                Udm_Cod = Agenda.Movimenti(i).Movimenti_Dettagli(j).Udm_Cod

                                                Fr_Cod = Mat_Cod
                                                'Fr_Des = New AgronicaCoreAnagrafeDAL.Materie_Prime_R().MatDes_from_MatCod("", SEMENTI, Mat_Cod, "", Nothing, "", objParametri_Server)

                                            Else

