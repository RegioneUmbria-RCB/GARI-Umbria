                Lbl_Dose_Consigliata.Visible = True
                lbl_qta_residua.Visible = True
                lbl_qta_residua.Text = "Dose/Ha di Prodotto Residua [kg] [l]"
                Lbl_Dose_Consigliata_Ricetta.Text = ""
                Lbl_Dose_Consigliata_Ricetta.Visible = False
                lbl_qta_residua_ricetta.Visible = False
                lbl_qta_residua_ricetta.Text = ""
            Else
                Me.Lbl_Dose_Consigliata.Text = ""
                Me.Lbl_Dose_Consigliata_Ricetta.Text = ""
            End If

            If objParametriAgenda.TipoRicetta = enum_TipoRicetta.PianoDistribuzionePua Then
                If Qta_Ha_Distribuibile_Prodotto_Ricette <> 1000000 Then
                    Lbl_Dose_Consigliata_Ricetta.Text = Qta_Ha_Distribuibile_Prodotto_Ricette
                    Lbl_Dose_Consigliata_Ricetta.Visible = True
                    lbl_qta_residua_ricetta.Visible = True
                    lbl_qta_residua_ricetta.Text = "Dose/Ha di Prodotto Residua per PUA [kg] [l]"
                Else
                    Me.Lbl_Dose_Consigliata_Ricetta.Text = ""
                End If
            End If


            If objParametriAgenda.Lav_Cod = LAVCOD_DISTRIBUZIONE_AMMENDANTI AndAlso
                    objParametriAgenda.TipoRicetta = enum_TipoRicetta.PianoDistribuzionePua AndAlso UdmCod > 0 Then

                Dim HashUdm As New Hashtable
                For Each u In Cmb_UdM.Items
                    If IsNumeric(u.value) AndAlso u.value = UdmCod Then
                        HashUdm.Add(UdmCod, u.text)
                    End If
                Next
                Cmb_UdM.Items.Clear()
                If HashUdm.Count > 0 Then
                    For Each u In HashUdm
                        Cmb_UdM.Items.Add(New ListItem(u.value, u.key))
                    Next
                Else
                    Cmb_UdM.Items.Add(New ListItem(New AgronicaCoreMetaSchemaDAL.UnitaMisura_R().UdmDes_from_UdmCod(UdmCod, "", objParametri_Server), UdmCod))
                End If

            Else

                Select Case objParametriAgenda.Fabbricato

                    Case Is <> "0"

                        Dim GiacenzaAllaData As String = Split(ComboFertilizzanti.Valore_Combo, "$")(2)
                        Dim GiacenzaTotale As String = Split(ComboFertilizzanti.Valore_Combo, "$")(3)
                        Dim GiacenzaUdmCod As String = Split(ComboFertilizzanti.Valore_Combo, "$")(4)
                        Dim GiacenzaUdmSim As String = Split(ComboFertilizzanti.Valore_Combo, "$")(5)

                        If IsNumeric(GiacenzaUdmCod) Then

                            UdmCod = GiacenzaUdmCod
                            UdmDes = GiacenzaUdmSim

                            If UdmCod.ToString() <> "" AndAlso IsNothing(Cmb_UdM.Items.FindByValue(UdmCod)) Then
                                Cmb_UdM.Items.Add(New ListItem(UdmDes, UdmCod))
                            End If

                            If Cmb_Allevamenti.Visible Then
                                If UdmCod = enum_UnitaMisura.KG Then
                                    Cmb_UdM.Items.Add(New ListItem("q", enum_UnitaMisura.Quintali))
                                    Cmb_UdM.Items.Add(New ListItem("t", enum_UnitaMisura.Tonnellate))
                                ElseIf UdmCod = enum_UnitaMisura.Litri Then
                                    Cmb_UdM.Items.Add(New ListItem("m3", enum_UnitaMisura.Metri_Cubi))
                                End If
                            End If
                        End If


                        QtaPresente = GiacenzaAllaData

                        'ignoro le giacenze infinitesime
                        If IsNumeric(GiacenzaTotale) AndAlso Math.Abs(CDec(GiacenzaTotale)) >= QTA_GiancenzeVisualizzate Then

                            If UdmCod.ToString() <> "" Then

                                If IsNothing(Cmb_UdM.Items.FindByValue(UdmCod)) Then
                                    If UdmCod = enum_UnitaMisura.Litri Then
                                        CaricaLitri(UdmCod)
                                    ElseIf UdmCod = enum_UnitaMisura.KG Then
                                        CaricaKG(UdmCod)
                                    End If

                                Else
                                    Cmb_UdM.SelectedIndex = Cmb_UdM.Items.IndexOf(Cmb_UdM.Items.FindByValue(UdmCod))
                                End If

                            End If

                        End If

                        aggiornaGiacenzaPerUdm()

                End Select

            End If

            cella_disponibilita.Style.Add("display", "none")

            If Qs_Ricetta_Cod <> 0 AndAlso objParametriAgenda.TipoRicetta = enum_TipoRicetta.PianoDistribuzionePua AndAlso objParametriAgenda.Lav_Cod = LAVCOD_DISTRIBUZIONE_AMMENDANTI Then

                Dim fertilizzanteUsato As Decimal = 0
                Dim StoccaggioPrevistoInData As Decimal = 0
                'Dim disponibilita As Decimal = CaricaDisponibilitaAttuale(FerCod, pua_Cod, Regolamento_Cod, objParametriAgenda.Data, fertilizzanteUsato)
                Dim disponibilita As Decimal = CaricaDisponibilitaAttuale(FerCod, EffCod, Qs_Pua_Cod, Regolamento_Cod, objParametriAgenda.Data, StoccaggioPrevistoInData, fertilizzanteUsato)

                Lbl_DisponibilitaAttuale.Text = Math.Round(StoccaggioPrevistoInData, 4) 'disponibilita & " ( finora usato: " & fertilizzanteUsato & ")"

                Lbl_Dose_Consigliata_Ricetta.Text = Qta_Ha_Distribuibile_Prodotto_Ricette 'disponibilita & " ( finora usato: " & fertilizzanteUsato & ")"

                cella_disponibilita.Style.Remove("display")

            End If

            Dim strJS1 As New StringBuilder
            strJS1.AppendLine("$(document).ready(function () { ")
            strJS1.AppendLine("      memorizza_unita_base(); ")
            strJS1.AppendLine(" });")
            ScriptManager.RegisterStartupScript(CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel), CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).GetType(),
                                          String.Format("jQuery_{0}", CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).ClientID), strJS1.ToString, True)


        End If

    End Sub

    <Script.Services.ScriptMethod()>
    <WebMethod(EnableSession:=True)>
    Public Shared Function AggiornaEfficienza(ByVal EffCod As Integer,
                                              ByVal Epoca As Integer,
                                              ByVal TipoAllevamento As Integer,
                                              ByVal Dose As Integer,
                                              ByVal RegolamentoCod As Integer,
                                              ByVal ClassiTessiture As List(Of Integer),
                                              ByVal VegCod As Integer
                                         ) As Decimal


        Dim Efficienza As Decimal = 1
        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")

        Dim objParametriIngresso As New PUA_EfficienzaxTipiAllevamentixEffluenti_input
        objParametriIngresso.Regolamento_Cod = RegolamentoCod
        objParametriIngresso.Eff_Cod = EffCod
        objParametriIngresso.Em_Cod = Epoca
        If RegolamentoCod < 78 Then
            objParametriIngresso.All_Cod = TipoAllevamento
        End If

        objParametriIngresso.Dose = Dose

        Dim objPC_WS As New AgronicaCoreWebService.PianoConcimazione_WS
        Dim objParametriUscita As PUA_EfficienzaxTipiAllevamentixEffluenti_output = objPC_WS.EfficienzaxTipiAllevamentixEffluenti(objParametriIngresso)

        If objParametriUscita.ListaEfficienzaxTipiAllevamentixEffluenti.Count > 0 Then

            If ClassiTessiture.Count > 0 Then

                'Devo prendere la massima efficienza perché implica un minor dosaggio e quindi sono più cautelativo
                Dim maxEfficienza As Decimal = 0

                For Each cltes As Integer In ClassiTessiture

                    Dim attEff As Decimal = (From x As PUA_Efficienza In objParametriUscita.ListaEfficienzaxTipiAllevamentixEffluenti Where x.Id_ClasseTessitura = cltes Select x.Efficienza_Val).Max()

                    If maxEfficienza < attEff Then
                        maxEfficienza = attEff
                    End If

                Next

                Efficienza = maxEfficienza

            Else

                Efficienza = (From x As PUA_Efficienza In objParametriUscita.ListaEfficienzaxTipiAllevamentixEffluenti Select x.Efficienza_Val).Max()

            End If


            Dim Considera_CoefficienteTempo As Integer = (From x As PUA_Efficienza In objParametriUscita.ListaEfficienzaxTipiAllevamentixEffluenti Select x.Considera_CoefficienteTempo_Efficienza).First()
            If Considera_CoefficienteTempo = 1 Then
                Dim objParametriIngressoCT As New PUA_CoefficienteTempo_Coltura_input
                objParametriIngressoCT.Regolamento_Cod = RegolamentoCod
                objParametriIngressoCT.Veg_Cod = VegCod
                Dim objParametriUscitaCT As PUA_CoefficienteTempo_Coltura_output = objPC_WS.CoefficienteTempo_Coltura(objParametriIngressoCT)
                If objParametriUscitaCT.ListaCoefficienteTempo.Count > 0 Then
                    Dim CoefficienteTempo As Decimal = (From x As PUA_CoefficienteTempo In objParametriUscitaCT.ListaCoefficienteTempo Select x.Coeff_Temp).First()
                    If CoefficienteTempo > 0 Then
                        Efficienza = Efficienza * CoefficienteTempo
                    End If
                End If
            End If

        End If

        Return Efficienza

    End Function

    ''' <summary>
    ''' generato dal cambio di selezione sui Disciplinari 
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    ''' <remarks></remarks>

    Private Function ControllaGiacenzaMagazzino(ByRef MessaggioErrore As String) As Boolean

        Dim Elem_Cod As Integer
        'controllo se ho già visualizzato il messaggio di alert 
        'If HiddenVarie.Value <> "" Then
        '    HiddenVarie.Value = ""
        '    Return True
        'End If

        'verifico se il magazzino è stato selezionato
        If objParametriAgenda.Fabbricato.Length > 3 Then


            If IsTrattamento Then
                If ComboFormulati.ddl_Formulati.SelectedItem.Value = "" Then
                    Exit Function
                End If
            End If

            If IsFertilizzazione Then
                If ComboFertilizzanti.ddl_Fertilizzanti.SelectedItem.Value = "" Then
                    Exit Function
                End If
            End If

            If IsSemina Then
                If ComboSementi.ddl_Sementi.SelectedItem.Value = "" Then
                    Exit Function
                End If
            End If


            Dim frm_FerCod As Integer = 0
            Dim frm_FerDes As String = ""
            Dim frm_UdmCod As Integer = 0
            Dim unita_m As String = ""
            Dim frm_MatCod As Integer = 0
            Dim qta_in_data As Decimal
            Dim frm_EffCod As Integer = 0
            Dim Lotto As String = LOTTO_NONDEFINITO
            Dim QtaTot As Decimal = Txt_DoseTot_HA.Text

            'converto in k / l, todo, tutto da rivedere per internazionalizzazione
            Select Case Cmb_UdM.SelectedValue

                Case enum_UnitaMisura.KG
                    frm_UdmCod = enum_UnitaMisura.KG
                    unita_m = Resources.AgronicaAgenda_2010.Kg
                Case enum_UnitaMisura.Grammi
                    frm_UdmCod = enum_UnitaMisura.KG
                    unita_m = Resources.AgronicaAgenda_2010.Kg
                    QtaTot = QtaTot / 1000
                Case enum_UnitaMisura.Milligrammi
                    frm_UdmCod = enum_UnitaMisura.KG
                    unita_m = Resources.AgronicaAgenda_2010.Kg
                    QtaTot = QtaTot / 1000000

                Case enum_UnitaMisura.CentimetriCubi
                    frm_UdmCod = enum_UnitaMisura.Litri
                    unita_m = Resources.AgronicaAgenda_2010.Litri
                    QtaTot = QtaTot / 1000
                Case enum_UnitaMisura.Litri
                    frm_UdmCod = enum_UnitaMisura.Litri
                    unita_m = Resources.AgronicaAgenda_2010.Litri
                Case enum_UnitaMisura.Millilitri
                    frm_UdmCod = enum_UnitaMisura.Litri
                    unita_m = Resources.AgronicaAgenda_2010.Litri
                    QtaTot = QtaTot / 1000
                Case enum_UnitaMisura.Metri_Cubi
                    frm_UdmCod = enum_UnitaMisura.Litri
                    unita_m = Resources.AgronicaAgenda_2010.Litri
                    QtaTot = QtaTot * 1000

                Case enum_UnitaMisura.Unita_Seme
                    frm_UdmCod = enum_UnitaMisura.Unita_Seme
                    unita_m = "Unita' di Seme"
                Case enum_UnitaMisura.Num_Piante
                    frm_UdmCod = enum_UnitaMisura.Num_Piante
                    unita_m = "Numero di Piante"
                Case enum_UnitaMisura.Confezioni
                    frm_UdmCod = enum_UnitaMisura.Confezioni
                    unita_m = "Confezioni"
            End Select

            If IsTrattamento Then
                frm_FerCod = ComboFormulati.ddl_Formulati.SelectedValue.Split("£")(0)
                frm_FerDes = CStr(ComboFormulati.ddl_Formulati.SelectedItem.Text)
                Elem_Cod = FORMULATI
                If Split(ComboFormulati.Valore_Combo, "£").Length > 13 Then
                    If Split(ComboFormulati.Valore_Combo, "£")(13) <> "" Then
                        Lotto = Split(ComboFormulati.Valore_Combo, "£")(13)
                    End If
                End If
            End If

            If IsFertilizzazione Then
                frm_FerCod = ComboFertilizzanti.ddl_Fertilizzanti.SelectedValue.Split("/")(0)
                frm_FerDes = CStr(ComboFertilizzanti.ddl_Fertilizzanti.SelectedItem.Text)
                Elem_Cod = FERTILIZZANTI
                frm_EffCod = Split(ComboFertilizzanti.Valore_Combo, "$")(6)

                If Split(ComboFertilizzanti.Valore_Combo, "$").Length > 8 Then
                    Lotto = Split(ComboFertilizzanti.Valore_Combo, "$")(8)
                End If
            End If

            If IsSemina Then
                frm_MatCod = ComboSementi.ddl_Sementi.SelectedValue.Split("§")(0)
                frm_FerDes = ComboSementi.ddl_Sementi.SelectedValue.Split("§")(1)

                If Split(ComboSementi.ddl_Sementi.SelectedValue, "§").Length > 3 Then
                    Lotto = ComboSementi.ddl_Sementi.SelectedValue.Split("§")(3)
                End If
                Elem_Cod = SEMENTI
            End If

            If objParametriAgenda.Lav_Cod = LAVCOD_DISTRIBUZIONE_AMMENDANTI AndAlso objParametriAgenda.TipoRicetta = enum_TipoRicetta.PianoDistribuzionePua Then

                'guardo se la quantità è conforme per la data di intervento
                Dim objRicDet As New AgronicaCoreContabDAL.Ricette_Dettagli_R
                qta_in_data = objRicDet.Verifica_Giacenze_Con_Pua(
                                            objParametriAgenda.Piva,
                                            Qs_Ricetta_Cod,
                                            Elem_Cod,
                                            frm_FerCod,
                                            frm_MatCod,
                                            CInt(frm_UdmCod),
                                            frm_EffCod,
                                            AGRODATAINIZIO,
                                            CDate(objParametriAgenda.Data),
                                            If(IsNumeric(Qs_Operazione_Ricetta), Qs_Operazione_Ricetta, 0),
                                            objParametri_Server)

                If QtaTot > Math.Round(qta_in_data, 4) Then
                    MessaggioErrore = MessaggioErrore & String.Format(Resources.AgronicaAgenda_2010.ATTENZIONEBrLaQuantitàDiBX0BAlBX1BÈPariABX1, frm_FerDes, objParametriAgenda.Data, qta_in_data, unita_m)
                End If

                'guardo se la quantità di giacenza è conforme a prescindere dalla data
                qta_in_data = objRicDet.Verifica_Giacenze_Con_Pua(
                                            objParametriAgenda.Piva,
                                            Qs_Ricetta_Cod,
                                            Elem_Cod,
                                            frm_FerCod,
                                            frm_MatCod,
                                            CInt(frm_UdmCod),
                                            frm_EffCod,
                                            AGRODATAINIZIO,
                                            AGRODATAFINE,
                                            If(IsNumeric(Qs_Operazione_Ricetta), Qs_Operazione_Ricetta, 0),
                                            objParametri_Server)

                If QtaTot > Math.Round(qta_in_data, 4) Then
                    MessaggioErrore = MessaggioErrore & String.Format(Resources.AgronicaAgenda_2010.ATTENZIONEBrLaGiacenzaAttualeDiBX0BX1X2Non1, frm_FerDes, qta_in_data, unita_m)
                End If

            Else
                'guardo se la quantità è conforme per la data di intervento
                Dim objMovDet As New AgronicaCoreContabDAL.Movimenti_Dettagli_R
                qta_in_data = objMovDet.Verifica_Giacenze_Con_Magazzino_Esterno(Split(objParametriAgenda.Fabbricato, "|")(2),
                                            CInt(Split(objParametriAgenda.Fabbricato, "|")(1)),
                                            CInt(Split(objParametriAgenda.Fabbricato, "|")(0)),
                                            Elem_Cod,
                                            frm_FerCod,
                                            frm_MatCod,
                                            0, 0, Lotto,
                                            0, CInt(frm_UdmCod),
                                            AGRODATAINIZIO,
                                            CDate(objParametriAgenda.Data),
                                            objParametriAgenda.Piva,
                                            objParametriAgenda.Sa_Cod,
                                            objParametriAgenda.Id_Agenda,
                                            objParametri_Server)
                If QtaTot > Math.Round(qta_in_data, 4) Then
                    MessaggioErrore = MessaggioErrore & String.Format(Resources.AgronicaAgenda_2010.ATTENZIONEBrLaQuantitàDiBX0BAlBX1BÈPariABX1, frm_FerDes, objParametriAgenda.Data, qta_in_data, unita_m)
                End If

                'guardo se la quantità di giacenza è conforme a prescindere dalla data
                qta_in_data = objMovDet.Verifica_Giacenze_Con_Magazzino_Esterno(Split(objParametriAgenda.Fabbricato, "|")(2),
                                            CInt(Split(objParametriAgenda.Fabbricato, "|")(1)),
                                            CInt(Split(objParametriAgenda.Fabbricato, "|")(0)),
                                            Elem_Cod,
                                            frm_FerCod,
                                            frm_MatCod,
                                            0, 0, Lotto,
                                            0, CInt(frm_UdmCod),
                                            AGRODATAINIZIO,
                                            AGRODATAFINE,
                                            objParametriAgenda.Piva,
                                            objParametriAgenda.Sa_Cod,
                                            objParametriAgenda.Id_Agenda,
                                            objParametri_Server)
                If QtaTot > Math.Round(qta_in_data, 4) Then
                    MessaggioErrore = MessaggioErrore & String.Format(Resources.AgronicaAgenda_2010.ATTENZIONEBrLaGiacenzaAttualeDiBX0BX1X2Non1, frm_FerDes, qta_in_data, unita_m)
                End If

            End If

            If MessaggioErrore <> "" Then

                '(03/12/2018 fede) spostato fuori
                ''--------------BLOCCO SALVATAGGIO SE_SUPERA_GIACENZE-------------------
                'If Not IsNothing(Session("UTENTE_COD_BLOCCA_SE_SUPERA_GIACENZE")) AndAlso Session("UTENTE_COD_BLOCCA_SE_SUPERA_GIACENZE") = True Then

                '    Dim MErrore As String
                '    MErrore = "In base alle impostazioni utente NON è possibile usare un prodotto con giacenza non sufficiente! " & vbCr & Messaggio
                '    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.AttenzioneLOperazioneNonÈStataRegistrataBr & MErrore, Page, ,
                '        CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar"), UpdatePanel))
                '    Return False

                'End If
                ''---------------------------------------------------------------------

                'Messaggio = Messaggio & vbCr & Resources.AgronicaAgenda_2010.BrBIProcedereUgualmenteIB
                'Messaggi.AgroSiNo(Messaggio, "Prosegui", Page, , UpdatePanel_Prodotti)
                Return False

            End If

        End If

        Return True

    End Function


    ''' <summary>
    ''' Bottone che gestisce l'aggiunta della dose indicata (FRECCIA ROSSA IN GIU)
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    ''' <remarks></remarks>
    Protected Sub ImgBtn_DoseInserisci_Click(ByVal sender As Object, ByVal e As System.Web.UI.ImageClickEventArgs) Handles ImgBtn_DoseInserisci.Click

        Dim FrCod As String = ""
        Dim FrDes As String = ""
        Dim Carenza As Integer = -1
        Dim BufferMin As Decimal = 0
        Dim BufferMax As Decimal = 0
        Dim For_Veg_Cod As Integer = 0

        Dim Dose As Decimal
        Dim Dose_Tot As Decimal
        Dim UdmCod As Integer = 0
        Dim UdmCodTrasformato As Integer = 0
        Dim UdmDes As String = ""
        Dim UdmDesSimbolo As String = ""
        Dim Ha_Hl As Integer = 0
        Dim Dose_QtaTot As Integer = 0

        Dim Av_Cod As String = ""
        Dim Av_Gru As String = ""
        Dim Av_Des As String = ""

        Dim Dose_Etichetta As String = ""
        Dim Dose_Etichetta_Value As String = ""
        Dim Dose_Etichetta_Max As String = ""

        Dim Soglia_Value As String = ""
        Dim Soglia_Des As String = ""

        Dim strPA_COD As String = ""
        Dim strPA_COD_Pesi As String = ""
        Dim strCLTOSS_COD As String = ""
        Dim PrincipiAttiviPercAbb As String = ""


        Dim N As String = ""
        Dim N_Utile As String = ""
        Dim P As String = ""
        Dim K As String = ""
        Dim M As String = ""
        Dim Cu As String = ""
        Dim Efficienza As String = ""

        Dim Lotto As String = ""

        Dim Cod_Articolo As String = ""
        Dim Mat_Regolamento As Integer = 0
        Dim Mat_Veg_Cod As Integer = 0
        Dim Mat_Cul_Cod As Integer = 0

        Dim TipoRichiesto As Integer

        '-------------------------------
        ' DOSE
        '-------------------------------
        Txt_Dose_HL.Text = Replace(Txt_Dose_HL.Text, ".", ",")
        Txt_Dose_HA.Text = Replace(Txt_Dose_HA.Text, ".", ",")
        Txt_DoseTot_HA.Text = Replace(Txt_DoseTot_HA.Text, ".", ",")
        Txt_SupCalcolata.Value = Replace(Txt_SupCalcolata.Value, ".", ",")

        '(03/12/2018 fede) spostati i controlli
        If HiddenVarie.Value <> "" Then

            HiddenVarie.Value = ""

        Else
            Dim MessaggioGlobale As String = ""

            Dim MsgControlloMagazzino As String = ""
            Dim MsgControlloCarenza As String = ""
            Dim MsgControllaBloccoFioritura As String = ""
            Dim MsgControlloBuffer As String = ""
            Dim MsgControlloPeriodoDivieto As String = ""
            Dim DataMinima As Date = AGRODATAFINE

            Dim MsgBlocco As String = ""
            Dim MsgAlert As String = ""

            'controllo sulle giacenze di magazzino
            If ControllaGiacenzaMagazzino(MsgControlloMagazzino) = False Then

                If Not IsNothing(Session("UTENTE_COD_BLOCCA_SE_SUPERA_GIACENZE")) AndAlso Session("UTENTE_COD_BLOCCA_SE_SUPERA_GIACENZE") = True Then
                    MsgBlocco = MsgControlloMagazzino
                Else
                    If IsTrattamento AndAlso CInt(Session("GestioneGiacenze_Formulati")) = 1 Then
                        MsgBlocco = MsgControlloMagazzino
                    Else
                        If IsSemina AndAlso CInt(Session("GestioneGiacenze_Sementi")) = 1 Then
                            MsgBlocco = MsgControlloMagazzino
                        Else
                            If IsFertilizzazione AndAlso CInt(Session("GestioneGiacenze_Fertilizzanti")) = 1 Then
                                MsgBlocco = MsgControlloMagazzino
                            Else
                                MsgAlert = MsgControlloMagazzino
                            End If
                        End If
                    End If
                End If
            End If

            'controllo carenza
            If IsTrattamento Then

                If ControllaCarenza(MsgControlloCarenza, DataMinima, Carenza) = False Then
                    Select Case Session("ControllaBloccoInserimento")
                        Case "1" 'blocco
                            If Session("Blocca_Carenza") = True Then
                                MsgBlocco &= "<br>" & String.Format(Resources.AgronicaAgenda_2010.LaDataDiRaccoltaDiUnoDegliAppezzamentiNonÈ, DataMinima, Carenza)
                            End If
                        Case "2" 'avviso
                            If Session("Blocca_Carenza") = True Then
                                MsgAlert &= "<br>" & String.Format(Resources.AgronicaAgenda_2010.LaDataDiRaccoltaDiUnoDegliAppezzamentiNonÈ, DataMinima, Carenza)
                            End If
                    End Select
                End If

                If ControllaBloccoFioritura(MsgControllaBloccoFioritura) = False Then
                    Select Case Session("ControllaBloccoInserimento")
                        Case "1" 'blocco
                            If Session("Blocca_Fioritura") = True Then
                                MsgBlocco &= "<br>" & MsgControllaBloccoFioritura
                            End If
                        Case "2" 'avviso
                            If Session("Blocca_Fioritura") = True Then
                                MsgAlert &= "<br>" & MsgControllaBloccoFioritura
                            End If
                    End Select
                End If

                If ControllaBuffer(MsgControlloBuffer, BufferMin, BufferMax) = False Then
                    Select Case Session("ControllaBloccoInserimento")
                        Case "1" 'blocco
                            If Session("Blocca_BufferZone") = True Then
                                MsgBlocco &= "<br>" & MsgControlloBuffer
                            End If
                        Case "2" 'avviso
                            If Session("Blocca_BufferZone") = True Then
                                MsgAlert &= "<br>" & MsgControlloBuffer
                            End If
                    End Select
                End If

            End If

            'controllo periodo divieto (direttiva nitrati)
            If objParametriAgenda.TipoRicetta = enum_TipoRicetta.PianoDistribuzionePua AndAlso
                                objParametriAgenda.Lav_Cod = LAVCOD_DISTRIBUZIONE_AMMENDANTI AndAlso objParametriAgenda.Disciplinare.Split("/").Length > 1 AndAlso objParametriAgenda.Disciplinare.Split("/")(1) = 2 Then
                If ControllaPeriodoDivieto(MsgControlloPeriodoDivieto, objParametriAgenda.Disciplinare.Split("/")(0)) = False Then
                    MsgAlert &= "<br>" & MsgControlloPeriodoDivieto
                End If
            End If


            If MsgControlloMagazzino <> "" OrElse MsgControlloCarenza <> "" OrElse MsgControllaBloccoFioritura <> "" OrElse MsgControlloBuffer <> "" OrElse MsgControlloPeriodoDivieto <> "" Then

                If MsgControlloMagazzino <> "" OrElse MsgControlloCarenza <> "" OrElse MsgControllaBloccoFioritura <> "" OrElse MsgControlloBuffer <> "" Then
                    MessaggioGlobale = "In base alle impostazioni utente NON è possibile inserire il prodotto:<br><br>"
                End If

                If MsgBlocco <> "" Then
                    MessaggioGlobale &= MsgBlocco
                    If MsgAlert <> "" Then
                        MessaggioGlobale &= " (Controllo impostato come BLOCCANTE) " & "<br>" & MsgAlert & " (Controllo impostato come NON BLOCCANTE) " & "<br>"
                    End If
                    Messaggi.AgroMsgBox(MessaggioGlobale, Page, , UpdatePanel_Prodotti)
                Else
                    If MsgAlert <> "" Then
                        MessaggioGlobale &= MsgAlert
                        Messaggi.AgroSiNo(MessaggioGlobale & "<br><br> Si desidera proseguire?", "Prosegui", Page, , UpdatePanel_Prodotti)
                    End If
                End If

                Exit Sub

            End If

        End If

        'Controlli Vari
        If IsTrattamento Then

            If ControllaSelezioneFormulato(FrCod, FrDes, Carenza, For_Veg_Cod, strPA_COD, strPA_COD_Pesi, strCLTOSS_COD, TipoRichiesto, BufferMin, BufferMax, Lotto, PrincipiAttiviPercAbb) = False Then
                Exit Sub
            End If

            If ControllaSelezioneAvversita(TipoRichiesto, Av_Cod, Av_Gru, Av_Des, Soglia_Value, Soglia_Des) = False Then
                Exit Sub
            End If

        End If

        If IsFertilizzazione Then

            If Me.ComboFertilizzanti.Testo_Combo = "" Then
                Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.SelezionareUnFertilizzante, Page, , UpdatePanel_Prodotti)
                Exit Sub
            Else
                FrCod = Split(ComboFertilizzanti.Valore_Combo, "/")(0) '& "/" & Split(ComboFertilizzanti.Valore_Combo, "/")(1)
                FrDes = Split(ComboFertilizzanti.Testo_Combo, "---")(0)
                If Split(ComboFertilizzanti.Valore_Combo, "$").Length > 8 Then
                    Lotto = Split(ComboFertilizzanti.Valore_Combo, "$")(8)
                End If
            End If

        End If

        Dim sup_calcolata As Decimal = 0

        If IsSemina Then

            If Me.ComboSementi.Testo_Combo = "" Then
                Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.SelezionareUnaSementePiantina, Page, , UpdatePanel_Prodotti)
                Exit Sub
            Else
                FrCod = Split(ComboSementi.Valore_Combo, "§")(0)
                FrDes = Split(ComboSementi.Valore_Combo, "§")(1)
            End If

            'verifico che la sup_app del nuovo appezzamento non superi la trattata
            If IsSemina AndAlso RBL_Tipo_Semina.SelectedValue = enum_SEMINA_TIPO.Frazionamento_Appezzamenti_perLotto_e_Semina_sui_Singoli_Default Then

                Dim sup_trattata As Decimal = 0
                If IsNumeric(Txt_SupTrattata.Value) Then
                    sup_trattata = CDec(Txt_SupTrattata.Value)
                End If

                If IsNumeric(Txt_SupCalcolata.Value) Then
                    sup_calcolata = CDec(Txt_SupCalcolata.Value)
                End If
                'If sup_calcolata > sup_trattata Then
                '    Messaggi.AgroMsgBox("ATTENZIONE la Superficie calcolata supera quella indicata!", Page, , UpdatePanel_Prodotti)
                '    Exit Sub
                'End If

                Dim sup_calcolata_dosi As Decimal = 0
                Dim Dt As DataTable = Session("vs_dtDosi")
                If Dt IsNot Nothing Then
                    For Each drtmp As DataRow In Dt.Rows
                        If Not (drtmp.Item("fr_cod") = Fr_Cod_Modificato.Value AndAlso drtmp.Item("lotto") = Lotto_Modificato.Value) Then
                            sup_calcolata_dosi += drtmp.Item("sup_calcolata")
                        End If
                    Next
                End If
                If sup_calcolata_dosi + sup_calcolata > sup_trattata Then
                    Messaggi.AgroMsgBox("ATTENZIONE la Superficie calcolata supera quella indicata!", Page, , UpdatePanel_Prodotti)
                    Exit Sub
                End If

            End If

        End If


        If ControllaSelezioneUnitadiMisura(FrCod, UdmCod, UdmDesSimbolo, UdmDes, UdmCodTrasformato, Ha_Hl, Dose_QtaTot) = False Then
            Exit Sub
        End If
        '-----

        'DT: controllo non contemporaneità di prodotto multiplo (con lotto diverso) e multicentro
        'nella nuova versione Angular questo controllo non verrà introdotto, serve solo per tamponare un malfunzionamento attuale
        If IsTrattamento OrElse IsFertilizzazione Then
            Dim Dt_Dosi As DataTable = Session("vs_dtDosi")
            If Dt_Dosi IsNot Nothing AndAlso Dt_Dosi.Rows.Count > 0 Then

                For i = 0 To Dt_Dosi.Rows.Count - 1
                    If Dt_Dosi.Rows(i).Item("fr_cod") = FrCod Then

                        Dim ListaImpianti As List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
                        ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti()
                        Dim countDistinct_Sa_Cod = ListaImpianti.Select(Function(x) x.Sa_Cod).Distinct.Count

                        If countDistinct_Sa_Cod > 1 Then
                            Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.BloccoMultiprodottoMulticentro, Page, , UpdatePanel_Prodotti)
                            Exit Sub
                        End If

                        Exit For
                    End If
                Next
            End If
        End If



        If IsFertilizzazione Then

            Txt_Efficienza.Text = Replace(Txt_Efficienza.Text, ".", ",")
            Txt_N.Text = Replace(Txt_N.Text, ".", ",")
            Txt_N_Utile.Text = Replace(Txt_N_Utile.Text, ".", ",")
            Txt_P2O5.Text = Replace(Txt_P2O5.Text, ".", ",")
            Txt_K2O.Text = Replace(Txt_K2O.Text, ".", ",")
            Txt_MgO.Text = Replace(Txt_MgO.Text, ".", ",")
            Txt_Cu.Text = Replace(Txt_Cu.Text, ".", ",")

            '---------------
            'Efficienza
            '---------------
            If Txt_Efficienza.Text <> "" Then
                If InStr(Txt_Efficienza.Text, ".") <> 0 Then
                    Txt_Efficienza.Text = Replace(Txt_Efficienza.Text, ".", ",")
                End If
                If Not IsNumeric(Me.Txt_Efficienza.Text) Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreNumericoPerIndicareLEffici, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                End If
                If CDec(Me.Txt_Efficienza.Text) < 0 Or CDec(Me.Txt_Efficienza.Text > 1) Then
                    Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.InserireUnValoreDiEfficienzaIncluso01, Page, , UpdatePanel_Prodotti)
                    Exit Sub
                Else
                    Efficienza = Txt_Efficienza.Text
                End If
            Else
                Efficienza = "1"
            End If


            '---------------
            'N - P - K - M - Cu
            '---------------
            If Txt_N.Text <> "" Then
                If InStr(Txt_N.Text, ".") <> 0 Then
