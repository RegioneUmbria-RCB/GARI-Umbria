                                                               Fr_Cod,
                                                               Fr_Des,
                                                               Dose,
                                                               Dose_HA,
                                                               Dose_HL,
                                                               Dose_Totale,
                                                               Udm_Cod,
                                                               Udm_Des,
                                                               Udm_Cod_Trasformato,
                                                               "", "", "", "", "", "", "", "", 0, "", 0, "", "", 0, 0, "", "", 0, 0, "", "",
                                                               "", "", "", "", "", "", "0",
                                                               CStr(Dose_HA_Reale).Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale),
                                                               CStr(Dose_HL_Reale).Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale),
                                                               CStr(Dose_Tot_Reale).Replace(".", AgronicaCoreUtility.Stringhe.SeparatoreDecimale),
                                                               Ha_Hl, Dose_QtaTot, Lotto, Cod_Articolo, Mat_Regolamento, Mat_Veg_Cod, Mat_Cul_Cod, 0,
                                                               Piva_Rif, Sa_Cod_Rif, Id_Agenda_Rif, Id_Mov_Rif, Id_Mov_Det_Rif, Lav_Cod_Rif, Cau_Mov_Rif, Des_Rif, Qta_Rif, "")
                                            End If


                                        End If

                                    End If

                                Next

                                Txt_SupSelezionata.Value = Sup_Tot.ToString

                                If IsRaccolta AndAlso Tipo_Raccolta <> enum_RACCOLTA_TIPO.Fast Then

                                    cmb_Prodotto.SelectedValue = Mat_Cod
                                    Cmb_UdM_Raccolta.SelectedValue = Udm_Cod
                                    Txt_QtaTotRaccolta.Text = Qta
                                    'TextBoxLotto.Text = Lotto
                                End If




                            End If


                            If IsTrattamento OrElse IsFertilizzazione Then

                                Select Case Dpi_Cod
                                    Case 0 'nessuno nessuno caso vecchio
                                        If IsTrattamento Then
                                            objParametriAgenda.Disciplinare = NessunDpiNessunaEtichetta
                                        End If
                                        If IsFertilizzazione Then
                                            objParametriAgenda.Disciplinare = Dpi_Cod
                                        End If
