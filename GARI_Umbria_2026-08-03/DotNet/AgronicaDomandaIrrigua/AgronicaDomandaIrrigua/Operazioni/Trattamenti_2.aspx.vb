                                        'If Not (ComboFiltriAggiuntiviAgenda1.ddl_FiltriAggiuntivi.SelectedValue = "0" And
                                        '    CType(Ricerca.FindControlIterative(Page.Master, "ComboDisciplinari1"), AgronicaControlli_2010.ComboDisciplinari).Valore_Combo = "0") Then

