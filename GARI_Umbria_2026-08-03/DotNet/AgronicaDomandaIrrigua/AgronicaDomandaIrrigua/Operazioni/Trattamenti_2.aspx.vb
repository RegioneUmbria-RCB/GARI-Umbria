    Private Sub GridView_Dosi_AggiornaDaClient()

        Dim righeModificate As String = GridVew_Dosi_ClientMod.Value

        If String.IsNullOrEmpty(righeModificate) OrElse righeModificate = "[]" Then
            Exit Sub
        End If

        If IsNothing(Session("vs_dtDosi")) Then
            Exit Sub
        End If

        Dim righeModificateArray As JArray = JArray.Parse(righeModificate)
        Dim xDt As DataTable = Session("vs_dtDosi")

        Dim i As Integer = 0
        If xDt.Rows.Count = righeModificateArray.Count Then
            For Each cRow In righeModificateArray
                xDt.Rows(i)("Qta_Tot") = CDec(cRow("dose_tot").ToString.Replace(",", AgronicaCoreUtility.Stringhe.SeparatoreDecimale))
                xDt.Rows(i)("Dose_HA") = CDec(cRow("dose_ha").ToString.Replace(",", AgronicaCoreUtility.Stringhe.SeparatoreDecimale))
                If IsNumeric(cRow("dose_hl")) Then
                    xDt.Rows(i)("Dose_HL") = CDec(cRow("dose_hl").ToString.Replace(",", AgronicaCoreUtility.Stringhe.SeparatoreDecimale))
                Else
                    xDt.Rows(i)("Dose_HL") = "0,0000"
                End If
                xDt.Rows(i)("Dose_HA_Reale") = CDec(cRow("dose_ha_reale").ToString.Replace(",", AgronicaCoreUtility.Stringhe.SeparatoreDecimale))
                If IsNumeric(cRow("dose_hl_reale")) Then
                    xDt.Rows(i)("Dose_HL_Reale") = CDec(cRow("dose_hl_reale").ToString.Replace(",", AgronicaCoreUtility.Stringhe.SeparatoreDecimale))
                Else
                    xDt.Rows(i)("Dose_HL_Reale") = "0"
                End If
                xDt.Rows(i)("Dose_Tot_Reale") = CDec(cRow("dose_tot_reale").ToString.Replace(",", AgronicaCoreUtility.Stringhe.SeparatoreDecimale))
                i += 1
            Next
        End If

        Session("vs_dtDosi") = xDt
        Griglia_Dosi_Data_Bind()

    End Sub

