                        XML_Impianto.SetAttribute("progetto_cod", ListaImpianti(i).Progetto_Cod)
                        XML_Impianto.SetAttribute("app_nome", ListaImpianti(i).App_Nome)
                        XML_Impianto.SetAttribute("specie", CType(Ricerca.FindControlIterative(Page.Master, "ComboSpecie"), AgronicaControlli_2010.ComboSpecie).Testo_Combo)
                        XML_Impianto.SetAttribute("varieta", ListaImpianti(i).Cul_Des)
                        XML_Impianto.SetAttribute("superficie", ListaImpianti(i).Sup_Imp)
                        XML_Impianto.SetAttribute("validita_inizio_distinta", ListaImpianti(i).Validita_Inizio_Distinta)
                        XML_Impianto.SetAttribute("validita_fine_distinta", ListaImpianti(i).Validita_Fine_Distinta)

                        Sup_Imp = CDec(ListaImpianti(i).Sup_Imp)

                        N_Distribuito = 0
                        P_Distribuito = 0
                        K_Distribuito = 0
                        Mg_Distribuito = 0

                        If Sup_Imp <> 0 Then

                            Select Case UdmCod
                                Case 19 'm3 ?????????
                                    DoseTrasformata = Dose * 1000
                                Case 4 'q
                                    DoseTrasformata = Dose * 100
                                Case 304 't
                                    DoseTrasformata = Dose * 1000
                                Case 3, 101, 104
                                    DoseTrasformata = Dose / 1000  'caso in cui ho g, ml o cc
                                Case Else       'caso in cui ho Kg o l o mc
                                    DoseTrasformata = Dose
                            End Select

                            DoseTotale = DoseTrasformata

                            QuantitaTotale = DoseTotale * Sup_Tot

                            Frazione = Sup_Imp / Sup_Tot

                            QuantitaParziale = QuantitaTotale * Frazione


                            If Efficienza < 1 Then
                                N_Distribuito = N_Distribuito + ((CDec(QuantitaParziale) * N_Prodotto * Efficienza / Sup_Imp) / 100)
                            Else
                                N_Distribuito = N_Distribuito + (CDec(QuantitaParziale) * N_Prodotto / (100 * Sup_Imp))
                            End If

                            P_Distribuito = P_Distribuito + (CDec(QuantitaParziale) * P_Prodotto / (100 * Sup_Imp))
                            K_Distribuito = K_Distribuito + (CDec(QuantitaParziale) * K_Prodotto / (100 * Sup_Imp))
                            Mg_Distribuito = Mg_Distribuito + (CDec(QuantitaParziale) * Mg_Prodotto / (100 * Sup_Imp))

                        End If


                        XML_Impianto.SetAttribute("n", N_Distribuito)
                        XML_Impianto.SetAttribute("p", P_Distribuito)
                        XML_Impianto.SetAttribute("k", K_Distribuito)
                        XML_Impianto.SetAttribute("m", Mg_Distribuito)

                        XML_DatiImpianti.AppendChild(XML_Impianto)

                    Next

                    XmlDatiImpianti = XmlDoc.OuterXml

                    Session("DatiImpianti") = XmlDatiImpianti

                    '------------------------------------------------
                    '----- Preparazione stringa Xml Dati Generali
                    '------------------------------------------------

                    XML_DatiGenerali = XmlDoc2.CreateElement("DatiGenerali")

                    XmlDoc2.AppendChild(XML_DatiGenerali)

                    XML_Generale = XmlDoc2.CreateElement("Generale")

                    XML_Generale.SetAttribute("piva", objParametriAgenda.Piva)
                    XML_Generale.SetAttribute("sa_cod", objParametriAgenda.Sa_Cod)
                    'XML_Generale.SetAttribute("rag_soc", CType(Ricerca.FindControlIterative(Page.Master.Master, "Lbl_Rag_Soc"), Label).Text)
                    XML_Generale.SetAttribute("rag_soc", CType(Page.Master.Master, DomandaIrriguaBootstrap).LblRag_Soc.Text)
                    XML_Generale.SetAttribute("sa_nome", CType(Ricerca.FindControlIterative(Page.Master, "ComboCentroAziendale"), AgronicaControlli_2010.ComboCentroAziendale).Testo_Combo)
                    XML_Generale.SetAttribute("des_lib", CType(Page.Master.Master, DomandaIrriguaBootstrap).Lbl_Titolo.Text)
                    XML_Generale.SetAttribute("veg_cod", objParametriAgenda.Veg_Cod)
                    XML_Generale.SetAttribute("veg_des", CType(Ricerca.FindControlIterative(Page.Master, "ComboSpecie"), AgronicaControlli_2010.ComboSpecie).Testo_Combo)
                    XML_Generale.SetAttribute("pro_cod", FrCod.ToString)
                    XML_Generale.SetAttribute("mat_cod", "0")
                    XML_Generale.SetAttribute("fer_des", FrDes.ToString)
                    XML_Generale.SetAttribute("id_agenda", objParametriAgenda.Id_Agenda)

                    XML_Generale.SetAttribute("n_prodotto", N_Prodotto)
                    XML_Generale.SetAttribute("p_prodotto", P_Prodotto)
                    XML_Generale.SetAttribute("k_prodotto", K_Prodotto)
                    XML_Generale.SetAttribute("mg_prodotto", Mg_Prodotto)
                    XML_Generale.SetAttribute("efficienza", Efficienza)

                    XML_DatiGenerali.AppendChild(XML_Generale)

                    XmlDatiGenerali = XmlDoc2.OuterXml

                    Session("DatiGenerali") = XmlDatiGenerali


                    ' VAnni: 26/9/2017: collegata nuova pagina sulla i in riga fertilizzazioni

                    ''commentare questo:
                    'Dim strJS1 As New StringBuilder
                    'strJS1.AppendLine("$(document).ready(function () { ")
                    'strJS1.AppendLine("      window.open( '../GestioneDisciplinari/Verifica_ApportiMassimi.aspx','_blank'); ")
                    'strJS1.AppendLine(" });")

                    'ScriptManager.RegisterStartupScript(CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel), CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).GetType(),
                    '                  String.Format("jQuery_{0}", CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).ClientID), strJS1.ToString, True)


                    'decommentare questo:
                    Dim strJS1 As New StringBuilder
                    strJS1.AppendLine("$(document).ready(function () { ")
                    strJS1.AppendLine("      $(""#" & Me.Master.Property_ImgBtn_DoseConsigliata.ClientID & """).click(); ")
                    strJS1.AppendLine(" });")
                    ScriptManager.RegisterStartupScript(CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel), CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).GetType(),
                                          String.Format("jQuery_{0}", CType(Ricerca.FindControlIterative(Page.Master, "UpdatePanelToolBar1"), UpdatePanel).ClientID), strJS1.ToString, True)

            End Select

        End If


