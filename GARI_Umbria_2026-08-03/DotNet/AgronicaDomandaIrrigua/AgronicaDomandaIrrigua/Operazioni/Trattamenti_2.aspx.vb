    Private Function ControllaAcqua(ByVal Acqua_Min As Decimal,
                                        ByVal Acqua_Max As Decimal,
                                        ByVal AcquaUdm_Cod As Integer,
                                        ByVal Dose_Acqua_Ha As Decimal,
                                        ByRef SuperataDose As Boolean,
                                        ByRef strAlert As String) As Boolean

        Dim strAvviso As String = ""

        'converto l'acqua in Hl
        Dim AcquaUdm_Radice, Acquaper_ha_hl As Integer
        AcquaUdm_Radice = -1
        Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
        objUdm.ScomponiUdm(AcquaUdm_Radice, Acquaper_ha_hl, AcquaUdm_Cod)

        Dim AcquaMaxHL As Decimal = 0
        Dim AcquaMinHL As Decimal = 0

        If AcquaUdm_Radice <> -1 Then
            If Acquaper_ha_hl = TipiEnumerativi.enum_UnitaMisura.Ettaro Then
                Select Case AcquaUdm_Radice
                    Case 2 'kg
                        AcquaMaxHL = Acqua_Max / 100
                        AcquaMinHL = Acqua_Min / 100
                    Case 4 'q
                        AcquaMaxHL = Acqua_Max
                        AcquaMinHL = Acqua_Min
                    Case 304 't
                        AcquaMaxHL = Acqua_Max * 10
                        AcquaMinHL = Acqua_Min * 10
                    Case 3 'g
                        AcquaMaxHL = Acqua_Max / 10000
                        AcquaMinHL = Acqua_Min / 10000
                    Case 2032 'mg
                        AcquaMaxHL = Acqua_Max / 100000
                        AcquaMinHL = Acqua_Min / 100000
                    Case 29 'l
                        AcquaMaxHL = Acqua_Max / 100
                        AcquaMinHL = Acqua_Min / 100
                    Case 101 'ml
                        AcquaMaxHL = Acqua_Max / 100000
                        AcquaMinHL = Acqua_Min / 100000
                    Case 104 'cc
                        AcquaMaxHL = Acqua_Max / 100000
                        AcquaMinHL = Acqua_Min / 100000
                End Select

            End If
        End If

        'controllo che qta Max
        If Acqua_Max <> 0 Then
            If Dose_Acqua_Ha > AcquaMaxHL Then
                'entrambe le quantità sono già espresse in HL
                strAvviso &= Resources.AgronicaAgenda_2010.ATTENZIONEBrLaBQuantitàDiAcquaBSuperaLaQua & "<br>"

                Select Case Session("ControllaBloccoInserimento")
                    Case "1" 'blocco
                        If Session("Blocca_Acqua_Massima") = True Then
                            strAvviso &= " (Controllo impostato come BLOCCANTE) " & "<br>"
                            strAlert &= strAvviso
                            Return True
                        End If
                    Case "2" 'avviso
                        If Session("Blocca_Acqua_Massima") = True Then
                            strAvviso &= " (Controllo impostato come NON BLOCCANTE) " & "<br>"
                            strAlert &= strAvviso
                        End If
                End Select
                'If Session("Blocca_Acqua_Massima") = True Then
                '    strAlert &= " (Controllo impostato come BLOCCANTE) " & "<br>"
                '    Return True
                'Else
                '    strAlert &= " (Controllo impostato come NON BLOCCANTE) " & "<br>"
                'End If
            End If
        End If
        'controllo che qta Min
        If Acqua_Min <> 0 Then
            If Dose_Acqua_Ha < AcquaMinHL Then
                'entrambe le quantità sono già espresse in HL
                strAvviso &= Resources.AgronicaAgenda_2010.ATTENZIONEBrLaBQuantitàDiAcquaBÈInferioreA & "<br>"

                Select Case Session("ControllaBloccoInserimento")
                    Case "1" 'blocco
                        If Session("Blocca_Acqua_Minima") = True Then
                            strAvviso &= " (Controllo impostato come BLOCCANTE) " & "<br>"
                            strAlert &= strAvviso
                            Return True
                        End If
                    Case "2" 'avviso
                        If Session("Blocca_Acqua_Minima") = True Then
                            strAvviso &= " (Controllo impostato come NON BLOCCANTE) " & "<br>"
                            strAlert &= strAvviso
                        End If
                End Select
                'If Session("Blocca_Acqua_Minima") = True Then
                '    strAlert &= " (Controllo impostato come BLOCCANTE) " & "<br>"
                '    Return True
                'Else
                '    strAlert &= " (Controllo impostato come NON BLOCCANTE) " & "<br>"
                'End If
            End If
        End If

        Return False

    End Function

    Private Function ControllaNumeroMaxTrattamenti(ByVal Fr_Cod As Integer,
                                                       ByVal For_Veg_Av_Dos_Cod As Integer,
                                                       ByVal Limite As Integer,
                                                       ByVal Limite_Udm_Cod As Integer,
                                                       ByVal N_Trattamenti_Udm_Sim As String,
                                                       ByVal Num_Max_Interventi_Globali As Integer,
                                                       ByRef strAlert As String)

        Dim strAvviso As String = ""

        'TODO: Vanni, 19/09/2016 09:28:00: Verifica conformità Op. di Agenda: leggere da Planning e non da impianti (es.: ControllaNumeroMaxTrattamenti). Al momento si bypassa il controllo
        If objParametriAgenda.TargetOperazione = enum_Tipo_Operazione_Agenda_Target.Planning Then
            Limite = -1
        End If

        If Limite > 0 Then

            'ciclo sugli impianti selezionati in modo da identificare piva,sa_cod,Appezza,Id_reg
            Dim ListaImpianti As New List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
            Dim Str_FiltroAggiuntivo As New StringBuilder
            Dim i As Integer = 0
            ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti
            If ListaImpianti.Count > 0 Then
                Str_FiltroAggiuntivo.Append("(")
                For i = 0 To ListaImpianti.Count - 1
                    Str_FiltroAggiuntivo.Append("( ")
                    Str_FiltroAggiuntivo.Append("Mov_Destinazioni.Piva = '" & ListaImpianti(i).Piva & "' ")
                    Str_FiltroAggiuntivo.Append("AND Mov_Destinazioni.Sa_Cod = " & ListaImpianti(i).Sa_Cod & " ")
                    Str_FiltroAggiuntivo.Append("AND Mov_Destinazioni.Appezza = " & ListaImpianti(i).Appezza & " ")
                    Str_FiltroAggiuntivo.Append("AND Mov_Destinazioni.Id_Destinazione = " & ListaImpianti(i).ID_Reg & " ")
                    Str_FiltroAggiuntivo.Append(" ) ")
                    If i <> ListaImpianti.Count - 1 Then
                        Str_FiltroAggiuntivo.Append(" OR ")
                    Else
                        Str_FiltroAggiuntivo.Append(" ) ")
                    End If
                Next
                Str_FiltroAggiuntivo.Append(" AND  Imprese_Progetti.Validita_Inizio <= '" & objParametriAgenda.Data & "' AND Imprese_Progetti.Validita_Fine  >= '" & objParametriAgenda.Data & "' ")

                If objParametriAgenda.Id_Agenda <> "0" Then
                    Str_FiltroAggiuntivo.Append(" AND Mov_Destinazioni.id_agenda <> " & Agro_SQL_SaveNum(objParametriAgenda.Id_Agenda) & " ")
                End If

                'Str_FiltroAggiuntivo.Append(" AND (Movimenti_dettagli.doseetichetta_value like '" & Agro_SQL_SaveText(For_Veg_Av_Dos_Cod.ToString) & "$%' ")
                'Str_FiltroAggiuntivo.Append("      OR  Movimenti_dettagli.doseetichetta_value like '<br>" & Agro_SQL_SaveText(For_Veg_Av_Dos_Cod.ToString) & "$%') ")

            Else
                'Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.ErroreNonSonoStatiRilevatiImpiantiSelezion, Page, , updateDoseInserisci)
                strAlert &= Resources.AgronicaAgenda_2010.ErroreNonSonoStatiRilevatiImpiantiSelezion & "<br>"
                Return True
            End If


            Dim dt_Movimenti As DataTable
            Dim objMovimentiDettagli As New AgronicaCoreContabDAL.Movimenti_Dettagli_R
            dt_Movimenti = objMovimentiDettagli.NumeroTrattamentiperImpianti(Fr_Cod, Str_FiltroAggiuntivo.ToString, "", objParametri_Server)

            Dim Dt_Movimenti_SingolaDose As DataTable
            Str_FiltroAggiuntivo.Append(" AND (Movimenti_dettagli.doseetichetta_value like '" & Agro_SQL_SaveText(For_Veg_Av_Dos_Cod.ToString) & "$%' ")
            Str_FiltroAggiuntivo.Append("      OR  Movimenti_dettagli.doseetichetta_value like '<br>" & Agro_SQL_SaveText(For_Veg_Av_Dos_Cod.ToString) & "$%') ")
            Dt_Movimenti_SingolaDose = objMovimentiDettagli.NumeroTrattamentiperImpianti(Fr_Cod, Str_FiltroAggiuntivo.ToString, "", objParametri_Server)


            Dim str_Controllo_Aggiuntivo As String
            'controllo se devo verificare la distinta o l anno
            'Select Case Limite_Udm_Cod
            '    Case TipiEnumerativi.enum_UnitaMisura.Anno
            '        'anno
            '        str_Controllo_Aggiuntivo = " AND Data_Movimento >'31/12/" & objParametriAgenda.Data.Year - 1 & "'" &
            '                                                " AND Data_Movimento < '31/12/" & objParametriAgenda.Data.Year & "' "
            '    Case TipiEnumerativi.enum_UnitaMisura.CicloColturale
            '        'distinta
            '        'str_Controllo_Aggiuntivo = " AND validita_inizio <'" & objParametriAgenda.Data.ToShortDateString & "'" & _
            '        '                                        " AND validita_Fine > '" & objParametriAgenda.Data.ToShortDateString & "' "
            '        str_Controllo_Aggiuntivo = " AND Data_Movimento >= Validita_Inizio " &
            '                                                " AND Data_Movimento <= Validita_Fine "
            'End Select

            '(26/04/2017 fede) modificato controllo 
            'verranno controllate le seguenti unità di misura (2019=anno, 2024=stagione colturale, 2025=ciclo colturale) 
            'e verranno controllate sempre in base alle date dell'esercizio

            Dim dr As DataRow()
            Dim dr_s As DataRow()
            Select Case Limite_Udm_Cod
                Case enum_UnitaMisura.CicloColturale, enum_UnitaMisura.StagioneColturale, enum_UnitaMisura.Anno
                    'distinta
                    str_Controllo_Aggiuntivo = " AND Data_Movimento >= Validita_Inizio " &
                                                                " AND Data_Movimento <= Validita_Fine "
            End Select

            Dim str_Errore As String = ""
            Dim str_Errore_Globale As String = ""
            For i = 0 To ListaImpianti.Count - 1

                dr = dt_Movimenti.Select(" Piva ='" & ListaImpianti(i).Piva & "'" &
                                              " AND Sa_Cod =" & ListaImpianti(i).Sa_Cod &
                                              " AND Appezza =" & ListaImpianti(i).Appezza &
                                              " AND ID_Destinazione =" & ListaImpianti(i).ID_Reg &
                                              str_Controllo_Aggiuntivo)

                dr_s = Dt_Movimenti_SingolaDose.Select(" Piva ='" & ListaImpianti(i).Piva & "'" &
                                                          " AND Sa_Cod =" & ListaImpianti(i).Sa_Cod &
                                                          " AND Appezza =" & ListaImpianti(i).Appezza &
                                                          " AND ID_Destinazione =" & ListaImpianti(i).ID_Reg &
                                                          str_Controllo_Aggiuntivo)

                ''conto 
                'If dr.Length >= Limite Then
                '    str_Errore = str_Errore & " (" & ListaImpianti(i).App_Nome & ")"
                'End If

                ''(09/07/2018) fede
                'If Num_Max_Interventi_Globali > 0 Then
                '    If dr.Length >= Num_Max_Interventi_Globali Then
                '        str_Errore_Globale = str_Errore_Globale & " (" & ListaImpianti(i).App_Nome & ")"
                '    End If
                'End If

                '(12/10/2018 fede) se ho il globale valorizzato
                'verifico il limite solo sulla dose selezionata + il globale su tutti 
                If Num_Max_Interventi_Globali > 0 Then

                    If dr_s.Length >= Limite Then
                        str_Errore = str_Errore & " (" & ListaImpianti(i).App_Nome & ")"
                    End If

                    If dr.Length >= Num_Max_Interventi_Globali Then
                        str_Errore_Globale = str_Errore_Globale & " (" & ListaImpianti(i).App_Nome & ")"
                    End If

                Else

                    'caso vecchio
                    If dr.Length >= Limite Then
                        str_Errore = str_Errore & " (" & ListaImpianti(i).App_Nome & ")"
                    End If

                End If

            Next

            If str_Errore <> "" OrElse str_Errore_Globale <> "" Then

                If str_Errore <> "" Then
                    strAvviso &= String.Format(Resources.AgronicaAgenda_2010.IlNumeroMassimoDiX0TrattamentiX1IndicatiDa, Limite, N_Trattamenti_Udm_Sim) & str_Errore & "<br>"
                End If

                If str_Errore_Globale <> "" Then
                    strAvviso &= String.Format(Resources.AgronicaAgenda_2010.IlNumeroMassimoDiX0TrattamentiX1IndicatiDa, Num_Max_Interventi_Globali, N_Trattamenti_Udm_Sim) & str_Errore_Globale & "<br>"
                End If

                Select Case Session("ControllaBloccoInserimento")
                    Case "1" 'blocco
                        If Session("Blocca_Numero_Massimo") = True Then
                            strAvviso &= " (Controllo impostato come BLOCCANTE) " & "<br>"
                            strAlert &= strAvviso
                            Return True
                        End If
                    Case "2" 'avviso
                        If Session("Blocca_Numero_Massimo") = True Then
                            strAvviso &= " (Controllo impostato come NON BLOCCANTE) " & "<br>"
                            strAlert &= strAvviso
                        End If
                End Select

            End If

        End If

        Return False

    End Function

    Private Function ControllaIntervalloTrattamenti(ByVal Fr_Cod As Integer,
                                                        ByVal IntervalloTrattamenti_Min As Integer,
                                                        ByVal IntervalloTrattamenti_Max As Integer,
                                                        ByRef strAlert As String)


        '  Vanni, 19/09/2016 09:29:25: Verifica conformità Op. di Agenda: leggere da Planning e non da impianti (es.: ControllaNumeroMaxTrattamenti). Al momento si bypassa il controllo
        If objParametriAgenda.TargetOperazione = enum_Tipo_Operazione_Agenda_Target.Planning Then
            Return False
        End If

        Dim strAvviso As String = ""

        'verifico se ci sono dei trattamenti con lo stesso fr_cod

        'ciclo sugli impianti selezionati in modo da identificare piva,sa_cod,Appezza,Id_reg
        Dim ListaImpianti As New List(Of AgronicaCoreModello.ParametriAgenda_Temp.Impianto)
        Dim Str_FiltroAggiuntivo As New StringBuilder
        Dim i As Integer = 0
        ListaImpianti = CType(Master, OperazioneBootstrap).GetImpianti
        If ListaImpianti.Count > 0 Then
            Str_FiltroAggiuntivo.Append("(")
            For i = 0 To ListaImpianti.Count - 1
                Str_FiltroAggiuntivo.Append("( ")
                Str_FiltroAggiuntivo.Append("Mov_Destinazioni.Piva = '" & ListaImpianti(i).Piva & "' ")
                Str_FiltroAggiuntivo.Append("AND Mov_Destinazioni.Sa_Cod = " & ListaImpianti(i).Sa_Cod & " ")
                Str_FiltroAggiuntivo.Append("AND Mov_Destinazioni.Appezza = " & ListaImpianti(i).Appezza & " ")
                Str_FiltroAggiuntivo.Append("AND Mov_Destinazioni.Id_Destinazione = " & ListaImpianti(i).ID_Reg & " ")
                Str_FiltroAggiuntivo.Append(" ) ")

                If i <> ListaImpianti.Count - 1 Then
                    Str_FiltroAggiuntivo.Append(" OR ")
                Else
                    Str_FiltroAggiuntivo.Append(" ) ")
                End If

            Next
            Str_FiltroAggiuntivo.Append(" AND  Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(objParametriAgenda.Data) & " AND Imprese_Progetti.Validita_Fine  >= " & Agro_SQL_SaveDate(objParametriAgenda.Data) & " ")
            'Str_FiltroAggiuntivo.Append(" AND  data_movimento <= '" & objParametriAgenda.Data & "'  ")

            If objParametriAgenda.Id_Agenda <> "0" Then
                Str_FiltroAggiuntivo.Append(" AND Mov_Destinazioni.id_agenda <> " & Agro_SQL_SaveNum(objParametriAgenda.Id_Agenda) & " ")
            End If
        Else
            'Messaggi.AgroMsgBox(Resources.AgronicaAgenda_2010.ErroreNonSonoStatiRilevatiImpiantiSelezion, Page, , updateDoseInserisci)
            strAlert &= Resources.AgronicaAgenda_2010.ErroreNonSonoStatiRilevatiImpiantiSelezion & "<br>"
            Return True
        End If



        Dim dt_Movimenti As DataTable
        Dim objMovimentiDettagli As New AgronicaCoreContabDAL.Movimenti_Dettagli_R
        dt_Movimenti = objMovimentiDettagli.UltimoTrattamentoImpianti(Fr_Cod, objParametriAgenda.Data, Str_FiltroAggiuntivo.ToString, " data_movimento desc", objParametri_Server)

        Dim strErroreMin As String = ""
        Dim strErroreMax As String = ""
        'controllo il gg minimo
        If IntervalloTrattamenti_Min > 0 Then
            'ciclo per ogni impianto
            For i = 0 To ListaImpianti.Count - 1
                Dim dr() As DataRow = dt_Movimenti.Select(" Piva ='" & ListaImpianti(i).Piva & "'" &
                                              " AND Sa_Cod =" & ListaImpianti(i).Sa_Cod &
                                              " AND Appezza =" & ListaImpianti(i).Appezza &
                                              " AND ID_Destinazione =" & ListaImpianti(i).ID_Reg)

                'ho qualche trattamento passato
                If dr.Length > 0 Then
                    Dim data As Date = dr(0).Item("data_movimento")

                    If data.AddDays(IntervalloTrattamenti_Min) > objParametriAgenda.Data Then
                        'errore
                        strErroreMin = strErroreMin & " (" & ListaImpianti(i).App_Nome & ")"
                    End If
                End If
            Next
        End If


        If strErroreMin <> "" OrElse strErroreMax <> "" Then
            'errore 
            Dim errore As String = ""
            If strErroreMin <> "" Then
                errore = errore & "Nei seguenti appezzamenti [" & strErroreMin & "] non è rispettato <b> l intervallo minimo </b> di " &
                        IntervalloTrattamenti_Min & " gg. dal precedente. <br>"
            End If

            strAvviso &= "ATTENZIONE!!!<br>" & errore

            Select Case Session("ControllaBloccoInserimento")
                Case "1" 'blocco
                    If Session("Blocca_Intervallo_Minimo") = True Then
                        strAvviso &= " (Controllo impostato come BLOCCANTE) " & "<br>"
                        strAlert &= strAvviso
                        Return True
                    End If
                Case "2" 'avviso
                    If Session("Blocca_Intervallo_Minimo") = True Then
                        strAvviso &= " (Controllo impostato come NON BLOCCANTE) " & "<br>"
                        strAlert &= strAvviso
                    End If
            End Select

        End If


        Return False

    End Function

    Private Function ControllaDoseMassima(ByVal DoseMax As Decimal,
                                              ByVal Udm_Cod As Integer,
                                              ByRef SuperataDose As Boolean,
                                              ByRef SuperataDoseDiserbo As Boolean,
                                              ByRef strAlert As String) As Boolean

        SuperataDose = False
        SuperataDoseDiserbo = False

        Dim strAvviso As String = ""

        If DoseMax <> 0 Then
            'se ho una dose massima a ettaro
            Dim doseMaxHa_k_L As Decimal
            Dim perHaHl As Integer = 0
            Dim Udm_Cod_Max_scomposta As Integer = 0
            Dim Udm_Cod_Trasformato As Integer = 0
            Dim MoltiplicatoreDose As Decimal = 1
            Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
            objUdm.ScomponiUdm(Udm_Cod_Max_scomposta, perHaHl, Udm_Cod, MoltiplicatoreDose)
            'converto to kg o litri
            Dim doseIndicata, Moltiplicatore As Decimal
            'converto in kg o l
            AgronicaCoreMetaSchemaDAL.UnitaMisura_R.ConvertiToKG_L(Udm_Cod_Max_scomposta, Udm_Cod_Trasformato, Moltiplicatore)
            doseMaxHa_k_L = DoseMax * Moltiplicatore * MoltiplicatoreDose
            AgronicaCoreMetaSchemaDAL.UnitaMisura_R.ConvertiToKG_L(Cmb_UdM.SelectedValue, Udm_Cod_Trasformato, Moltiplicatore)
            Select Case perHaHl
                Case TipiEnumerativi.enum_UnitaMisura.Ettolitro
                    doseIndicata = Txt_Dose_HL.Text * Moltiplicatore
                Case TipiEnumerativi.enum_UnitaMisura.Ettaro
                    doseIndicata = Txt_Dose_HA.Text * Moltiplicatore
            End Select

            If doseIndicata > doseMaxHa_k_L Then
                SuperataDose = True
                Select Case perHaHl
                    Case TipiEnumerativi.enum_UnitaMisura.Ettolitro
                        strAvviso &= Resources.AgronicaAgenda_2010.ATTENZIONEBrLaBDoseHlBSelezionataNonPuòSup & "<br>"
                    Case TipiEnumerativi.enum_UnitaMisura.Ettaro
                        strAvviso &= Resources.AgronicaAgenda_2010.ATTENZIONEBrLaBDoseHaBSelezionataNonPuòSup & "<br>"
                End Select

                Select Case Session("ControllaBloccoInserimento")
                    Case "1" 'blocco
                        If Session("Blocca_Dose_Massima") = True Then
                            strAvviso &= " (Controllo impostato come BLOCCANTE) " & "<br>"
                            strAlert &= strAvviso
                            Return True
                        End If
                    Case "2" 'avviso
                        If Session("Blocca_Dose_Massima") = True Then
                            strAvviso &= " (Controllo impostato come NON BLOCCANTE) " & "<br>"
                            strAlert &= strAvviso
                        End If
                End Select
            End If
            Dim DoseConsentitaDiserbo As Decimal = 0
            If Session("D_HA_Max_Diserbo") IsNot Nothing AndAlso Session("D_HA_Max_Diserbo") <> 0 Then
                DoseConsentitaDiserbo = CDec(Session("D_HA_Max_Diserbo"))
                If doseIndicata > DoseConsentitaDiserbo Then
                    SuperataDoseDiserbo = True
                    strAlert &= Resources.AgronicaAgenda_2010.ATTENZIONEBrLaBDoseHaBSelezionataNonPuòSup1 & DoseConsentitaDiserbo & Resources.AgronicaAgenda_2010.KgOLHa & "<br>"
                    Select Case Session("ControllaBloccoInserimento")
                        Case "1" 'blocco
                            If Session("Blocca_Dose_Massima") = True Then
                                strAvviso &= " (Controllo impostato come BLOCCANTE) " & "<br>"
                                strAlert &= strAvviso
                                Return True
                            End If
                        Case "2" 'avviso
                            If Session("Blocca_Dose_Massima") = True Then
                                strAvviso &= " (Controllo impostato come NON BLOCCANTE) " & "<br>"
                                strAlert &= strAvviso
                            End If
                    End Select
                End If
            End If
        End If

        Return False

    End Function

    Private Function ControllaDoseMinima(ByVal DoseMin As Decimal,
                                             ByVal Udm_Cod As Integer,
                                             ByRef SuperataDose As Boolean,
                                             ByRef strAlert As String) As Boolean

        Dim strAvviso As String = ""

        SuperataDose = False

        If DoseMin <> 0 Then
            'se ho una dose massima a ettaro
            Dim doseMinHa_k_L As Decimal
            Dim perHaHl As Integer = 0
            Dim Udm_Cod_Max_scomposta As Integer = 0
            Dim Udm_Cod_Trasformato As Integer = 0
            Dim MoltiplicatoreDose As Decimal = 1
            Dim objUdm As New AgronicaCoreMetaSchemaDAL.UnitaMisura_R
            objUdm.ScomponiUdm(Udm_Cod_Max_scomposta, perHaHl, Udm_Cod, MoltiplicatoreDose)
            'converto to kg o litri

            Dim doseIndicata, Moltiplicatore As Decimal
            'converto in kg o l
            AgronicaCoreMetaSchemaDAL.UnitaMisura_R.ConvertiToKG_L(Udm_Cod_Max_scomposta, Udm_Cod_Trasformato, Moltiplicatore)
            doseMinHa_k_L = DoseMin * Moltiplicatore * MoltiplicatoreDose
            AgronicaCoreMetaSchemaDAL.UnitaMisura_R.ConvertiToKG_L(Cmb_UdM.SelectedValue, Udm_Cod_Trasformato, Moltiplicatore)
            Select Case perHaHl
                Case TipiEnumerativi.enum_UnitaMisura.Ettolitro
                    doseIndicata = Txt_Dose_HL.Text * Moltiplicatore
                Case TipiEnumerativi.enum_UnitaMisura.Ettaro
                    doseIndicata = Txt_Dose_HA.Text * Moltiplicatore
            End Select
            If doseIndicata < doseMinHa_k_L Then
                SuperataDose = True
                Select Case perHaHl
                    Case TipiEnumerativi.enum_UnitaMisura.Ettolitro
                        strAvviso &= Resources.AgronicaAgenda_2010.ATTENZIONEBrLaBDoseHlBSelezionataÈInferior & "<br>"
                    Case TipiEnumerativi.enum_UnitaMisura.Ettaro
                        strAvviso &= Resources.AgronicaAgenda_2010.ATTENZIONEBrLaBDoseHaBSelezionataÈInferior & "<br>"
                End Select
                Select Case Session("ControllaBloccoInserimento")
                    Case "1" 'blocco
                        If Session("Blocca_Dose_Minima") = True Then
                            strAvviso &= " (Controllo impostato come BLOCCANTE) " & "<br>"
                            strAlert &= strAvviso
                            Return True
                        End If
                    Case "2" 'avviso
                        If Session("Blocca_Dose_Minima") = True Then
                            strAvviso &= " (Controllo impostato come NON BLOCCANTE) " & "<br>"
                            strAlert &= strAvviso
                        End If
                End Select

            End If
        End If

        Return False

    End Function

