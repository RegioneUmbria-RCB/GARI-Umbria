                                                </asp:DropDownList>
                                            </div>
                                        </ItemTemplate>
                                    </asp:TemplateField>
                                    <asp:TemplateField HeaderText="Tariffa">
                                        <ItemTemplate>
                                            <div style="width: 215px;">
                                                <asp:DropDownList ID="Cmb_Tariffa" runat="server" CssClass="txtUI" AutoPostBack="true">
                                                </asp:DropDownList>
                                            </div>
                                        </ItemTemplate>
                                    </asp:TemplateField>
                                    <asp:TemplateField HeaderText="Turno">
                                        <ItemTemplate>
                                            <div style="width: 215px;">
                                                <asp:DropDownList ID="Cmb_Turni" runat="server" CssClass="txtUI" AutoPostBack="true">
                                                </asp:DropDownList>
                                            </div>
                                        </ItemTemplate>
                                    </asp:TemplateField>
                                    <asp:TemplateField HeaderText="Unit&#224; Misura" meta:resourcekey="dgrScaricoUnitaMisuraResource1">
                                        <ItemTemplate>
                                            <asp:DropDownList ID="Cmb_UdmCosti" runat="server">
                                            </asp:DropDownList>
                                        </ItemTemplate>
                                    </asp:TemplateField>
                                    <asp:TemplateField HeaderText="Quantità">
                                        <ItemTemplate>
                                            <asp:TextBox ID="Txt_Qta_Ril" runat="server" CssClass="txtUI" Width="100px">
                                            </asp:TextBox>
                                        </ItemTemplate>
                                    </asp:TemplateField>
                                    <asp:BoundField DataField="Costo_Unitario" HeaderText="Costo Unitario [euro]" meta:resourcekey="dgrScaricoCostoUnitarioResource1" />
                                    <asp:BoundField DataField="Costo" HeaderText="Costo [euro]" meta:resourcekey="dgrScaricoCostoResource1" />
                                </Columns>
                                <HeaderStyle CssClass="ui-widget-header" />
                                <PagerStyle CssClass="ui-widget-header" HorizontalAlign="Center" />
                            </asp:GridView>
                            <asp:Button ID="BTN_ComboAttivita" runat="server" Text="Button" Style="display: none" />
                            <asp:Button ID="BTN_ComboTurni" runat="server" Text="Button" Style="display: none" />
                            <asp:Button ID="BTN_ComboQualifica" runat="server" Text="Button" Style="display: none" />
                            <asp:Button ID="BTN_ComboTariffa" runat="server" Text="Button" Style="display: none" />
                            <asp:Button ID="BTN_CmbCentriDiCostoAvanzati" runat="server" Text="Button" Style="display: none" />
                            <asp:HiddenField id="ComboAttivita_IndiceRigaCambiato" runat="server" />
                        </td>
                    </tr>
                </table>
            </ContentTemplate>
            <Triggers>
                <asp:AsyncPostBackTrigger ControlID="AggiornaCostiAccessoriAvanzati" EventName="Click" />
                <asp:AsyncPostBackTrigger ControlID="SalvaCostiAccessoriAvanzati" EventName="Click" />
                <asp:AsyncPostBackTrigger ControlID="AnnullaCostiAccessoriAvanzati" EventName="Click" />
                <asp:AsyncPostBackTrigger ControlID="SalvaCostiAvanzatiDefault" EventName="Click" />
                <%--<asp:AsyncPostBackTrigger ControlID="BottoneNascostoContatti" EventName="Click" />--%>
            </Triggers>
        </asp:UpdatePanel>
    </div>
    <!------------------------------------------------------------->
    <!------------------------------------------------------------->
    <!---   Opzioni Colonne -->
    <script type="text/javascript">
        function SalvaImpostazioniColonne() {
            $('#<%=SalvaImpostazioniColonne.ClientID %>').click();
            //$('#dialogImpostazioniColonne').dialog('close');
        };

        
       
    </script>
    <asp:UpdatePanel ID="UpdatePanelImpostazioniColonne" runat="server" UpdateMode="Conditional">
        <ContentTemplate>
            <asp:Button ID="AggiornaImpostazioniColonne" runat="server" Style="display: none;"
                meta:resourcekey="AggiornaImpostazioniColonneResource1" />
        </ContentTemplate>
    </asp:UpdatePanel>
    <!--Dialog per l'eliminazione -->
    <div id="dialogImpostazioniColonne" title="Visualizzazione colonne">
        <asp:UpdatePanel ID="UpdatePanelVisualizzazioneColonne" runat="server" UpdateMode="Conditional">
            <ContentTemplate>
                <asp:UpdateProgress ID="UpdateProgressVisualizzazioneColonne" runat="server" DisplayAfter="50"
                    AssociatedUpdatePanelID="UpdatePanelVisualizzazioneColonne">
                    <ProgressTemplate>
                        <div class="LoadPanel">
                            <div class="loading-indicator-bars">
                            </div>
                        </div>
                    </ProgressTemplate>
                </asp:UpdateProgress>
                <div>
                    <!--- Bottoni Salvattaggio e Annulla -->
                    <asp:Button ID="SalvaImpostazioniColonne" runat="server" Style="display: none;" meta:resourcekey="SalvaImpostazioniColonneResource1" />
                    <asp:CheckBoxList ID="ListaColonneVisibili" runat="server" meta:resourcekey="ListaColonneVisibiliResource1">
                    </asp:CheckBoxList>
                </div>
            </ContentTemplate>
            <Triggers>
                <asp:AsyncPostBackTrigger ControlID="SalvaImpostazioniColonne" EventName="Click" />
            </Triggers>
        </asp:UpdatePanel>
    </div>
    <!--Dialog per la ricetta -->
    <div id="dialogRicette" title="Elenco delle Ricette attive">
        <asp:UpdatePanel ID="UpdatePanelRicette" runat="server">
            <ContentTemplate>
                <div>
                    <!--- Bottoni Salvattaggio e Annulla -->
                    <asp:Button ID="Btn_Inserisci_Impianti_Ricetta" runat="server" Style="display: none;"
                        CssClass="btn_per_load" meta:resourcekey="Btn_Inserisci_Impianti_RicettaResource1" />
                    <asp:Button ID="Btn_Inserisci_Costi_Ricetta" runat="server" Style="display: none;"
                        CssClass="btn_per_load" meta:resourcekey="Btn_Inserisci_Costi_RicettaResource1" />
                    <asp:Button ID="Btn_Conferma_Ricetta" runat="server" Style="display: none;" CssClass="btn_per_load"
                        meta:resourcekey="Btn_Conferma_RicettaResource1" />
                    <asp:Label ID="lbl_Ricette" runat="server" meta:resourcekey="lbl_RicetteResource1"></asp:Label>
                    <asp:RadioButtonList ID="rbl_RicetteAttive" runat="server" meta:resourcekey="rbl_RicetteAttiveResource1">
                    </asp:RadioButtonList>
                </div>
            </ContentTemplate>
        </asp:UpdatePanel>
    </div>
    <asp:UpdatePanel ID="UpdatePanelPerScript" runat="server">
        <ContentTemplate>
        </ContentTemplate>
    </asp:UpdatePanel>
</asp:Content>
