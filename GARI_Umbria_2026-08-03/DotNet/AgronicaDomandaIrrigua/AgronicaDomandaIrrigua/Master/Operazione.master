<%@ Master Language="VB" MasterPageFile="Agenda.Master" AutoEventWireup="false" CodeBehind="Operazione.master.vb"
    Inherits="AgronicaDomandaIrrigua.Operazione" %>

<%@ Register Assembly="AgronicaControlli_2010" Namespace="AgronicaControlli_2010"
    TagPrefix="cc1" %>
<asp:Content ID="Content1" ContentPlaceHolderID="ContentAgendaHead" runat="server">
    <!-- Eventuale JS E css aggiuntivi-->
    <script type="text/javascript">

        var Enum_TargetOperazione = {  
          Reale: {value: 1, name: "Reale", code: 1 }, 
          Planning : {value: 2, name: "Planning", code: 2 }
        };

        var objParametriAgenda_TargetOperazione = <%=objParametriAgenda_TargetOperazione %>;

        function Contatto_gestisciValore_esci() {
            $("#dialog").dialog("close");
        }

        function Contatto_gestisciValore(valore) {
            $("#dialog").dialog("close");
            clickButtonContatti();
        }

        function clickButtonContatti() {
            $("#<%=BottoneNascostoContatti.ClientID %>").click()
        }

        function apriFormDialog(url) {
            $("#dialog").dialog("open");
            $("#xiframe").html("<iframe frameBorder='0' src='" + url + "' style='width:100%; height:" + ($("#dialog").height()) + "px'><iframe>");
        }

        function chiudidialog() {
            $("#dialog").dialog("close");
        }

        function ChiamataParent_Id_Ageda(id_agenda) {
            try {
                window.parent.registrazioneAgenda(id_agenda);
            }
            catch (e) {

            }
            finally {

            }
        }



        function BloccaCombo_CentroAziendale() {
            $(".ComboCentroAziendale").parent().children('input').attr('disabled', 'disabled');
            $(".ComboCentroAziendale").parent().children('button').attr('disabled', 'disabled');
        }

        function BloccaCombo_Operazioni() {
            $(".ComboOperazioni").parent().children('input').attr('disabled', 'disabled');
            $(".ComboOperazioni").parent().children('button').attr('disabled', 'disabled');
        }

        function BloccaCombo_Specie() {
            $(".ComboSpecie").parent().children('input').attr('disabled', 'disabled');
            $(".ComboSpecie").parent().children('button').attr('disabled', 'disabled');
        }


        function BloccaCombo_Magazzini() {

            $(".ComboMagazzini").parent().children('input').attr('disabled', 'disabled');
            $(".ComboMagazzini").parent().children('button').attr('disabled', 'disabled');
        }

        function SloccaCombo_Magazzini() {
            $(".ComboMagazzini").parent().children('input').removeAttr('disabled');
            $(".ComboMagazzini").parent().children('button').removeAttr('disabled');
        }



        //Per invocare il postback sulle combo
        function DoPostBack_Combo($_combo, valoreOpt) {
            //postBack Specie
            if ($_combo.attr("id").endsWith("ComboSpecie")) {
                $("#<%=BTN_ComboSpecie.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }

            //postBack Varieta
            if ($_combo.attr("id").endsWith("ComboVarieta")) {
                $("#<%=BTN_ComboVarieta.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }

            //postBack CentroAziendale
            if ($_combo.attr("id").endsWith("ComboCentroAziendale")) {
                $("#<%=BTN_ComboCentroAziendale.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }


            //postBack Campo
            if ($_combo.attr("id").endsWith("ComboCampo")) {
                $("#<%=BTN_ComboCampo.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }

            //postBack Magazzini
            if ($_combo.attr("id").endsWith("ComboMagazzini")) {
                $("#<%=BTN_Magazzini.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }

            //postBack Operazioni
            if ($_combo.attr("id").endsWith("ComboOperazioni")) {
                $("#<%=BTN_ComboOperazione.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }

            if ($_combo.attr("id").endsWith("Cmb_Attivita")) {
                //alert('cambio');
                $("#<%=ComboAttivita_IndiceRigaCambiato.ClientID %>").val($($_combo).closest('tr')[0].rowIndex);
                $("#<%=BTN_ComboAttivita.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }


            if ($_combo.attr("id").endsWith("Cmb_Turni")) {
                //alert('cambio');
                $("#<%=BTN_ComboTurni.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }

            if ($_combo.attr("id").endsWith("Cmb_Qualifica")) {
                //alert('cambio');
                $("#<%=BTN_ComboQualifica.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }

            if ($_combo.attr("id").endsWith("Cmb_Tariffa")) {
                //alert('cambio');
                $("#<%=BTN_ComboTariffa.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }

            if ($_combo.attr("id").endsWith("CmbCentriDiCostoAvanzati")) {
                //alert('cambio');
                $("#<%=BTN_CmbCentriDiCostoAvanzati.ClientID %>").click();
                $('#WaitFrame').show();
                return;
            }

            DoPostBack_Combo_Slave($_combo, valoreOpt);
        }

        function comboCampoChiusa() {
            $("#<%=BTN_ComboCampo.ClientID %>").click();
            $('#WaitFrame').show();
            return;
        }

        function comboVarietaChiusa() {
            $("#<%=BTN_ComboVarieta.ClientID %>").click();
            $('#WaitFrame').show();
            return;
        }

        function ControllaDisciplinarePlanning(Oggetto) {
            //TODO: verificare ..
            return true;
        }


        function ControllaDisciplinare(Oggetto) {
            //controllo che non sia soggetto a disciplinare
            var disciplinare = false;

            if (Oggetto.parent().parent().parent().hasClass("sfondogiallo") == true) {
                //controllo se la combo dei discipòlinari è attiva
                var ComboDisciplinari = $('.ComboDisciplinari').hasClass('myCombo');
                if (ComboDisciplinari == true) {


                    if ($('.ComboDisciplinari').val() != -2 && Oggetto.parent().parent().parent().children('.classeRegolamenti').html() == 4) {
                        //if ($('.ComboDisciplinari').val() != -2 && Oggetto.parent().parent().parent().children('.classeRegolamenti').html().indexOf('834/07') >= 0) {
                        //ho selezionato un dpi ma non reg bio
                        MessaggioErrore('Se è stato impostato il regolamento Bio nell impianto occorre utilizzare il disciplinare Bio');
                        return false;
                    }

                    if ($('.ComboDisciplinari').val() == 0) {
                        //sono obbligato a utilizzare il disciplinare
                        MessaggioErrore('<%=ObbligoUsaDPI.replace("'", "\'") %>');
                        return false;
                    }
                    else {
                        return true;
                    }


                }
                else {
                    return true;
                }

            } else {
                return true;
            }

        }


        /////////////////////////////////////////////////////
        /////////////////// SUPERFICI ///////////////////////
        /////////////////////////////////////////////////////


        function SelezionaDeselezionaTuttiPlanning() {
            if ($('#chkSelezionaTuttiPlanning').is(':checked')) {
                //seleziono tutto
                $('.ChkSelezionaPlanning').each(function () {
                    $(this).children('input').prop('checked', true);
                    ChkSelezionaPlanning_Click($(this).children('input'), true);
                });
                AggiornaDopo_SupTrattata();
            }
            else {
                //seleziono tutto
                $('.ChkSelezionaPlanning').each(function () {
                    $(this).children('input').prop('checked', false);
                    ChkSelezionaPlanning_Click($(this).children('input'), true);
                });
                AggiornaDopo_SupTrattata();
            }
        }



        function SelezionaDeselezionaTutti() {
            if ($('#chkSelezionaTuttiImpianti').is(':checked')) {
                //seleziono tutto
                $('.ChkSelezionaImpianto').each(function () {
                    $(this).children('input').prop('checked', true);
                    ChkSelezionaImpianto_Click($(this).children('input'), true);
                });
                AggiornaDopo_SupTrattata();
            }
            else {
                //seleziono tutto
                $('.ChkSelezionaImpianto').each(function () {
                    $(this).children('input').prop('checked', false);
                    ChkSelezionaImpianto_Click($(this).children('input'), true);
                });
                AggiornaDopo_SupTrattata();
            }
        }


        //Dato un oggetto $ trova la superficie dell'impianto
        function ValoreSuperficie_Impianto(Oggetto) {
            return Oggetto.parent().parent().parent().children('.Sup_Imp').html().replace(',', '.');
        }
        function Inserisci_ValoreSuperficie_Impianto(Oggetto, valore) {
            var app = roundNumber(valore, 4) + "";
            app = app.replace(".", ",");
            Oggetto.parent().parent().parent().find('.Sup_Imp').val(app);
        }

        function ValoreSuperficieCoinvolta_Impianto(Oggetto) {
            return Oggetto.parent().parent().parent().find('.Sup_Coinvolta').val().replace(',', '.');
        }
        function Inserisci_ValoreSuperficieCoinvolta_Impianto(Oggetto, valore) {
            var app = roundNumber(valore, 4) + "";
            app = app.replace(".", ",");
            Oggetto.parent().parent().parent().find('.Sup_Coinvolta').val(app);
        }


        //Funzione per l'aggiornamento della superficie Totale
        function RicalcolaSuperficieTotale() {
            var SupTot = 0.00;
            //sel la checkbox è chekkata
            $('.ChkSelezionaImpianto').children('input:checked').each(function () {
                var app = ValoreSuperficie_Impianto($(this));
                SupTot += parseFloat(app);
            });
            InserisciSupTotale(SupTot);
        }

        //Funzione per l'aggiornamento della superficie Totale Planning
        function RicalcolaSuperficieTotalePlanning() {
            var SupTot = 0.00;
            //sel la checkbox è chekkata
            $('.ChkSelezionaPlanning').children('input:checked').each(function () {
                var app = ValoreSuperficie_Impianto($(this));
                SupTot += parseFloat(app);
            });
            InserisciSupTotale(SupTot);
        }

        //Aggiornamento della superficie Coinvolta Planning
        function RicalcolaSuperficieCoinvoltaPlanning() {
            var SupTot = 0.00;
            //sel la checkbox è chekkata
            $('.ChkSelezionaPlanning').children('input:checked').each(function () {
                var app = ValoreSuperficieCoinvolta_Impianto($(this));
                SupTot += parseFloat(app);
            });
            InserisciSupTrattata(SupTot);
        }

        //Aggiornamento della superficie Coinvolta
        function RicalcolaSuperficieCoinvolta() {
            var SupTot = 0.00;
            //sel la checkbox è chekkata
            $('.ChkSelezionaImpianto').children('input:checked').each(function () {
                var app = ValoreSuperficieCoinvolta_Impianto($(this));
                SupTot += parseFloat(app);
            });
            InserisciSupTrattata(SupTot);
        }

        //Ripartizione della superficie trattata
        function RipartizionaSupTrattata() {
            var SupSel = SupTotale();
            var SupTratt = SupTrattata();
            var prop;
            prop = SupTratt / SupSel;

            //'  Vanni, 20/09/2016 17:59:29: sugli impianti
            $('.ChkSelezionaImpianto').children('input:checked').each(function () {
                var app = ValoreSuperficie_Impianto($(this));
                var daInserire = roundNumber((app * prop), 4);
                $(this).parent().parent().parent().find('.Sup_Coinvolta').val(daInserire.toString().replace('.', ','));
            });

            //'  Vanni, 20/09/2016 17:59:29: sui planning
            $('.ChkSelezionaPlanning').children('input:checked').each(function () {
                var app = ValoreSuperficie_Impianto($(this));
                var daInserire = roundNumber((app * prop), 4);
                $(this).parent().parent().parent().find('.Sup_Coinvolta').val(daInserire.toString().replace('.', ','));
            });
        }


        //Aggiornamento della Superficie coinvolta del singolo planning
        function AggiornaValorePlanning(Oggetto) {
            if (Oggetto.is(':checked')) {
                Inserisci_ValoreSuperficieCoinvolta_Impianto(Oggetto, ValoreSuperficie_Impianto(Oggetto));
                Oggetto.parent().parent().parent().find('.Sup_Coinvolta').removeAttr('disabled');
            }
            else {
                Inserisci_ValoreSuperficieCoinvolta_Impianto(Oggetto, '0.00');
                Oggetto.parent().parent().parent().find('.Sup_Coinvolta').attr('disabled', 'disabled');
            }
        
        }

        //Aggiornamento della Superficie coinvolta del singolo 
        function AggiornaValoreImpianto(Oggetto) {
            if (Oggetto.is(':checked')) {
                Inserisci_ValoreSuperficieCoinvolta_Impianto(Oggetto, ValoreSuperficie_Impianto(Oggetto));
                Oggetto.parent().parent().parent().find('.Sup_Coinvolta').removeAttr('disabled');
            }
            else {
                Inserisci_ValoreSuperficieCoinvolta_Impianto(Oggetto, '0.00');
                Oggetto.parent().parent().parent().find('.Sup_Coinvolta').attr('disabled', 'disabled');
            }
        }


        //Verifico che la superficie coinvolta non superi la superficie dell'impianto
        function ControllaMax(Oggetto) {
            var valoreSup_Imp = roundNumber(Oggetto.parent().parent().find('.Sup_Imp').html().replace(",", "."), 4);
            var valoreInserito = roundNumber(Oggetto.parent().parent().find('.Sup_Coinvolta').val().replace(",", "."), 4);
            if (valoreSup_Imp < valoreInserito) {
                Oggetto.parent().parent().find('.Sup_Coinvolta').val(valoreSup_Imp.toString().replace(".", ","));
                MessaggioErrore("<%=MsgSupImpiego.Replace("""", "\""") %>");
            }
            //          else {
            //                Oggetto.parent().parent().find('.Sup_Coinvolta').val(valoreInserito.toString().replace(".", ","));
            //            }
        }


        function AbilitaDisabilita_SupTrattataPlanning() {
            $('.ChkSelezionaPlanning').children('input').each(function () {
                if ($(this).is(':checked') == false) {
                    $(this).parent().parent().parent().find('.Sup_Coinvolta').attr('disabled', 'disabled');
                }
            });
        }

        function AbilitaDisabilita_SupTrattata() {
            $('.ChkSelezionaImpianto').children('input').each(function () {
                if ($(this).is(':checked') == false) {
                    $(this).parent().parent().parent().find('.Sup_Coinvolta').attr('disabled', 'disabled');
                }
            });
        }


        function Sup_Coinvolta_Keyup(Oggetto) {
            ControllaMax(Oggetto);
            if (objParametriAgenda_TargetOperazione==Enum_TargetOperazione.Reale) {
                RicalcolaSuperficieCoinvolta();
            } else {
                RicalcolaSuperficieCoinvoltaPlanning();
            }
            AggiornaDopo_SupTrattata();
        }


        function ChkSelezionaImpianto_Click(Oggetto, tutti) {
            //controllo che non ho inserito alcuna dose 
            if ($('.rigaImpianti').length == 0) {

                //controllo che non sia soggetto a disciplinare
                var ok = ControllaDisciplinare(Oggetto);

                if (ok == true) {

                    AggiornaValoreImpianto(Oggetto);
                    RicalcolaSuperficieTotale();
                    RicalcolaSuperficieCoinvolta();
                    if (tutti == false)
                    { AggiornaDopo_SupTrattata(); }
                } else {
                    $(Oggetto).prop('checked', false);
                }
            }
        }

        function ChkSelezionaPlanning_Click(Oggetto, tutti) {

            console.log("ChkSelezionaPlanning_Click, start");

            //controllo che non ho inserito alcuna dose 
            if ($('.rigaImpianti').length == 0) {

                //controllo che non sia soggetto a disciplinare
                var ok = ControllaDisciplinarePlanning(Oggetto);

                if (ok == true) {

                    AggiornaValorePlanning(Oggetto);
                    RicalcolaSuperficieTotalePlanning();
                    RicalcolaSuperficieCoinvoltaPlanning();
                    if (tutti == false)
                    { AggiornaDopo_SupTrattata(); }
                } else {
                    $(Oggetto).prop('checked', false);
                }
            }
            
            console.log("ChkSelezionaPlanning_Click, end");


        }

        function SommaSuperficieTrattata_Keyup() {
            var valore = parseFloat(SupTotale());
            var valore2 = parseFloat(SupTrattata());
            if (valore < valore2) {
                MessaggioErrore('<%=MsgSupImpiegata.Replace("'", "\'") %>');
                $('.SommaSuperficieTrattata').val(valore);
                RipartizionaSupTrattata();
            } else {
                RipartizionaSupTrattata();
            }
            AggiornaDopo_SupTrattata();
        }






        //////////////////////////////////////////////
        ///////////////BLOCCO SBLOCCO/////////////////
        //////////////////////////////////////////////
        function BloccaSbloccaTotale() {

            if ($('.rigaImpianti').length > 0) {
                $(".rblAcqua_Tot").children('input').attr('disabled', 'disabled');
                $(".rblAcqua_HA").children('input').attr('disabled', 'disabled');

                $(".ComboDisciplinari").parent().children('input').attr('disabled', 'disabled');
                $(".ComboDisciplinari").parent().children('button').attr('disabled', 'disabled');

                $(".ComboEpocheFertilizzazione").parent().children('input').attr('disabled', 'disabled');
                $(".ComboEpocheFertilizzazione").parent().children('button').attr('disabled', 'disabled');

                $("#chkSelezionaTuttiImpianti").attr('disabled', 'disabled');

                $('.ChkSelezionaImpianto').children('input').each(function () {
                    $(this).attr('disabled', 'disabled');
                });
                $(".Sup_Coinvolta").each(function () {
                    $(this).attr('disabled', 'disabled');
                });

                $(".SommaSuperficieTrattata").attr('disabled', 'disabled');

                $(".AcquaTot").attr('disabled', 'disabled');
                $(".AcquaHa").attr('disabled', 'disabled');

                $(".rblAcqua").find('input:radio').each(function () {
                    $(this).attr('disabled', 'disabled');
                });

                $(".rblAcqua").find('input:radio').each(function () {
                    $(this).attr('disabled', 'disabled');
                });

                //controllo cosa è selezionato
                if ($(".ComboFiltriAggiuntiviAgenda").parent().children('select').val() == "0") {
                    $(".ComboFiltriAggiuntiviAgenda").parent().children('input').attr('disabled', 'disabled');
                    $(".ComboFiltriAggiuntiviAgenda").parent().children('button').attr('disabled', 'disabled');
                }

                BloccaCombo_Magazzini();

            }
            else {
                
                //solo su reale.
                if (objParametriAgenda_TargetOperazione==Enum_TargetOperazione.Reale) {
                    SloccaCombo_Magazzini();
                }

                $(".ComboDisciplinari").parent().children('input').removeAttr('disabled');
                $(".ComboDisciplinari").parent().children('button').removeAttr('disabled');

                $(".ComboEpocheFertilizzazione").parent().children('input').removeAttr('disabled');
                $(".ComboEpocheFertilizzazione").parent().children('button').removeAttr('disabled');

                $(".rblAcqua_Tot").children('input').removeAttr('disabled');
                $(".rblAcqua_HA").children('input').removeAttr('disabled');


                $("#chkSelezionaTuttiImpianti").removeAttr('disabled');

                $('.ChkSelezionaImpianto').children('input').each(function () {
                    $(this).removeAttr('disabled');
                });
                $(".Sup_Coinvolta").each(function () {
                    $(this).removeAttr('disabled');
                });

                $(".SommaSuperficieTrattata").removeAttr('disabled');

                $(".AcquaTot").children('input').removeAttr('disabled');
                $(".AcquaHa").children('input').removeAttr('disabled');

                $(".rblAcqua").find('input:radio').each(function () {
                    $(this).removeAttr('disabled');
                });

                $(".rblAcqua").find('input:radio').each(function () {
                    $(this).removeAttr('disabled');
                });


                $(".ComboFiltriAggiuntiviAgenda").parent().children('input').removeAttr('disabled');
                $(".ComboFiltriAggiuntiviAgenda").parent().children('button').removeAttr('disabled');

            }
        }

        function RiabilitaTutto() {

            $(".ComboDisciplinari").parent().children('input').removeAttr('disabled');
            $(".ComboDisciplinari").parent().children('button').removeAttr('disabled');

            $('.ChkSelezionaImpianto').children('input').each(function () {
                $(this).removeAttr('disabled');
            });
            $(".Sup_Coinvolta").each(function () {
                $(this).removeAttr('disabled');
            });

            $(".SommaSuperficieTrattata").removeAttr('disabled');

            $(".AcquaTot").removeAttr('disabled');
            $(".AcquaHa").removeAttr('disabled');


            $(".rblAcqua").find('input:radio').each(function () {
                $(this).removeAttr('disabled');
            });

            $(".rblAcqua").find('input:radio').each(function () {
                $(this).removeAttr('disabled');
            });

            $(".rblAcqua_Tot").removeAttr('disabled');
            $(".rblAcqua_HA").removeAttr('disabled');

            $("#<%=txt_DataOperazione.ClientID %>").removeAttr('disabled');
            $("#chkSelezionaTuttiImpianti").attr('disabled', 'disabled');

            $("#<%=ImgBtn_Salva.ClientID %>").click();
        }

        function FiltraMaterialiMagazzinoAvanzati() {
            $("#<%=BTN_FiltraMaterialiAvanzati.ClientID %>").click();

        }

        function AggiornaAcqua() {
            var acq = $("#<%=QtaAcqua.ClientID %>").val();
            if (acq != "" && Number(acq) != 0 && Number($(".AcquaHa").val()) == 0) {
                //controllo se non ho già inserito la quantità di acqua
                $(".AcquaHa").val(acq);
                $(".rblAcqua_HA").children('input').prop('checked', true);
                $(".rblAcqua_Tot").children('input').prop('checked', false);
                if (acq > 0) {
                    $(".lbl_acqua_provenienza").html("<%=msgdataraturaUgelli.Replace("""", "\""") %>");
                }
            }
        }

        //DOCUMENT READY
        $(document).ready(function () {
            AggiornaAcqua();

            // $('select').multipleSelect();

        }); 
          

    </script>
    <style type="text/css">
        .descrizione
        {
            width: 75px;
        }
        #dialogCostiAccessoriAvanzati input.ui-autocomplete-input
        {
            width: 170px;
        }
    </style>
    <asp:ContentPlaceHolder ID="ContentOperazioniHeader" runat="server">
    </asp:ContentPlaceHolder>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentAgendaContenuti" runat="server">
    <asp:HiddenField ID="hf_esistonoCostiCollegatiCDG" runat="server" />
    <asp:HiddenField ID="QtaAcqua" runat="server" />
    <asp:UpdatePanel ID="UpdatePanelBottoneAggiorna" runat="server" UpdateMode="Conditional">
        <ContentTemplate>
            <asp:HiddenField ID="fooName_PostedBack" runat="server" />
            <asp:Button OnClick="Wrap_Client_PostedBack" CssClass="hideBtn" ID="btnDummyPostback"
                runat="server" meta:resourcekey="btnDummyPostbackResource1" />
        </ContentTemplate>
    </asp:UpdatePanel>
    <div class="cento boxColore">
        <table width="100%">
            <tr>
                <td style="width: 700px;">
                    <div style="min-width: 700px; width: 100%; float: left">
                        <!-- Riga 1 -->
                        <div class="box50" style="width: 250px">
                            <asp:UpdatePanel ID="UpdatePanelData" runat="server" UpdateMode="Conditional">
                                <ContentTemplate>
                                    <div class="descrizione" style="width: 80px">
                                        <asp:Label ID="lblData1" runat="server" meta:resourcekey="lblData1Resource1">Data</asp:Label></div>
                                    <div class="valoriinput" style="width: 76px">
                                        <asp:TextBox ID="txt_DataOperazione" runat="server" CssClass="txtUI datepicker change_per_load"
                                            meta:resourcekey="txt_DataOperazioneResource1"></asp:TextBox>
                                        <asp:Button ID="BTN_ChangeData" runat="server" Text="Button" Style="display: none"
                                            meta:resourcekey="BTN_ChangeDataResource1" />
                                    </div>
                                </ContentTemplate>
                            </asp:UpdatePanel>
                        </div>
                        <div style="min-width: 350px">
                            <asp:UpdatePanel ID="UpdatePanelToolBar1" runat="server">
                                <ContentTemplate>
                                </ContentTemplate>
                            </asp:UpdatePanel>
                            <asp:UpdatePanel ID="UpdatePanelToolBar" runat="server">
                                <ContentTemplate>
                                    <asp:Panel ID="Box_Salva" runat="server" Style="width: 165px; padding-right: 0px;
                                        float: left" meta:resourcekey="Box_SalvaResource1">
                                        <img src="../AB_Immagini/icone32/dischetto.ico" alt="Salva" onclick="RiabilitaTutto();"
                                            style="cursor: pointer; float: left;" class="btn_per_load" />
