    <table width="100%" style="margin-top: 5px">
        <tr>
            <td>
                <asp:UpdatePanel ID="UpdatePanelCostiAccessoriVisibili" runat="server">
                    <ContentTemplate>
                        <asp:CheckBox ID="CalcolaCosti" Checked="True" CssClass="CostiAperti" runat="server"
                            Text="Associa automaticamente la superficie ai costi." ToolTip="Associa automaticamente la superficie trattata ai costi accessori nel caso l'unità di misura sia impostata ad ettaro. Quando vengono aperti i costi per la prima volta il check viene automaticamente disabilitato per permettere la modifica dei dati."
                            meta:resourcekey="CalcolaCostiResource1" />
                        <asp:UpdateProgress ID="UpdateProgress2" runat="server" AssociatedUpdatePanelID="UpdatePanelCostiAccessoriVisibili"
                            DisplayAfter="50">
                            <ProgressTemplate>
                                <div class="LoadPanel">
                                    <div class="loading-indicator-bars">
                                    </div>
                                </div>
                            </ProgressTemplate>
                        </asp:UpdateProgress>
                        <div id="CostiAccessori">
                            <asp:GridView ID="GridViewCostiAccessoriVisibili" runat="server" AutoGenerateColumns="False"
                                Width="100%" CellPadding="5" CssClass="ui-widget-content GridViewCostiAccessoriVisibili"
                                Caption="Altre Risorse Impiegate:" meta:resourcekey="GridViewCostiAccessoriVisibiliResource1">
                                <Columns>
                                    <asp:ButtonField Text="&lt;img src='../AB_Immagini/icone16/gomma16.ico' border='0'&gt;"
                                        CommandName="EliminaCosto" meta:resourcekey="ButtonFieldResource1" />
                                    <asp:BoundField DataField="codice" HeaderText="Codice" />
                                    <asp:BoundField DataField="Centro" HeaderText="Categoria"/>
                                    <asp:BoundField DataField="Categoria_Des" HeaderText="Tipo Risorsa"/>
                                    <asp:BoundField DataField="Risorsa_des" HeaderText="Risorsa" meta:resourcekey="BoundFieldResource22" />
                                    <asp:TemplateField HeaderText="Unit&#224; Misura" meta:resourcekey="TemplateFieldResource3">
                                        <ItemTemplate>
                                            <asp:DropDownList ID="Cmb_UdmCosti" runat="server" Enabled="False" CssClass="UdmCosti"
                                                meta:resourcekey="Cmb_UdmCostiResource1">
                                            </asp:DropDownList>
                                        </ItemTemplate>
                                    </asp:TemplateField>
                                    <asp:TemplateField HeaderText="Quantit&#224;" meta:resourcekey="TemplateFieldResource4">
                                        <ItemTemplate>
                                            <asp:TextBox ID="Txt_Qta_Ril" runat="server" CssClass="txtUI QtaCosti" ReadOnly="True"
                                                meta:resourcekey="Txt_Qta_RilResource1"></asp:TextBox>
                                        </ItemTemplate>
                                    </asp:TemplateField>
                                    <asp:BoundField DataField="Costo_Unitario" HeaderText="Costo Unitario [euro]" meta:resourcekey="BoundFieldResource23">
                                        <ItemStyle CssClass="CostoUnitario" />
                                    </asp:BoundField>
                                    <asp:BoundField DataField="Costo" HeaderText="Costo [euro]" meta:resourcekey="BoundFieldResource24">
                                        <ItemStyle CssClass="Costo" />
                                    </asp:BoundField>
                                    <asp:BoundField DataField="ore" HeaderText="ore">
                                        <HeaderStyle CssClass="displaynone" />
                                        <ItemStyle CssClass="ore displaynone" />
                                    </asp:BoundField>
                                    <asp:BoundField DataField="minuti" HeaderText="minuti">
                                        <HeaderStyle CssClass="displaynone" />
                                        <ItemStyle CssClass="minuti displaynone" />
                                    </asp:BoundField>
                                </Columns>
                                <HeaderStyle CssClass="ui-widget-header" />
                                <PagerStyle CssClass="ui-widget-header" HorizontalAlign="Center" />
                            </asp:GridView>
                        </div>
                    </ContentTemplate>
                    <Triggers>
                        <%--                        <asp:AsyncPostBackTrigger ControlID="AggiornaCostiAccessori" EventName="Click" />
                        <asp:AsyncPostBackTrigger ControlID="SalvaCostiAccessori" EventName="Click" />--%>
                        <asp:AsyncPostBackTrigger ControlID="AggiornaCostiAccessoriAvanzati" EventName="Click" />
                        <asp:AsyncPostBackTrigger ControlID="SalvaCostiAccessoriAvanzati" EventName="Click" />
                    </Triggers>
                </asp:UpdatePanel>
            </td>
        </tr>
    </table>
    <script type="text/javascript">

        function SalvaAccessoriAvanzatiDefault() {
            $("#<%=SalvaCostiAvanzatiDefault.ClientID %>").click(); //effettua il post back per eliminazione dei dati
            $('#dialogCostiAccessoriAvanzati').dialog("close");
        };

        function SalvaAccessoriAvanzati() {
            $("#<%=SalvaCostiAccessoriAvanzati.ClientID %>").click(); //effettua il post back per eliminazione dei dati
            $('#dialogCostiAccessoriAvanzati').dialog("close");
        };

        $(document).ready(function () {

            // messaggi errore
            $('#dialogCostiAccessoriAvanzati').dialog({
                autoOpen: false,
                modal: true,
                width: "95%",
                buttons: {
                    "Aggiungi e Salva Profilo": function () {
                        $(this).dialog("close");
                        SalvaAccessoriAvanzatiDefault();
                        //

                    },

                    "Aggiungi": function () {
                        $(this).dialog("close");
                        SalvaAccessoriAvanzati();


                    },
                    "Annulla": function () {
                        $(this).dialog("close");
                        $("#<%=AnnullaCostiAccessoriAvanzati.ClientID %>").click();
                        return false;
                    }
                }
            });

        });

       
    </script>
    <asp:UpdatePanel ID="UpdatePanel2" runat="server" UpdateMode="Conditional">
        <ContentTemplate>
            <asp:Button ID="AggiornaCostiAccessoriAvanzati" runat="server" Style="display: none;"
                meta:resourcekey="AggiornaCostiAccessoriResource1" />
        </ContentTemplate>
    </asp:UpdatePanel>
    <!--- Bottoni Salvattaggio e Annulla -->
    <asp:Button ID="SalvaCostiAccessoriAvanzati" runat="server" Style="display: none;"
        meta:resourcekey="SalvaCostiAccessoriResource1" />
    <asp:Button ID="AnnullaCostiAccessoriAvanzati" runat="server" Style="display: none;"
        meta:resourcekey="AnnullaCostiAccessoriResource1" />
    <asp:Button ID="SalvaCostiAvanzatiDefault" runat="server" Style="display: none;"
        meta:resourcekey="SalvaCostiAccessoriResource1" />
    <!--Dialog per l'eliminazione -->
    <div id="dialogCostiAccessoriAvanzati" title="<%=divCostiAccessori.Replace("""", "\""") %>">
        <asp:UpdatePanel ID="UpdateCostiAccessoriAvanzati" runat="server" UpdateMode="Conditional">
            <ContentTemplate>
