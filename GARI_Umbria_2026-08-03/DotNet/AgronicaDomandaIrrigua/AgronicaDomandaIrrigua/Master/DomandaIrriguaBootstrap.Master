    <script src="<%= ResolveClientUrl("~/Scripts/jquery.tmpl.min.js?" & Application("GiasVersioneCorrente").ToString) %>" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Scripts/jquery.validate.min.js?" & Application("GiasVersioneCorrente").ToString) %>" type="text/javascript"></script>

    <script language="javascript" type="text/javascript">

        var v = $("#aspnetForm").validate({
            invalidHandler: function (event, validator) {
                var err_message = "";
                err_message = "<div class='error-tab' style='position: absolute; right: 0; top: 0; background-color: red'>" + v.numberOfInvalids() + "</div>";

                $('.nav-tabs li.active a').append(err_message);
            }

        });

        var n = $("#form_nuovo_elemento").validate({
        });


        jQuery.logThis = function (text) {
            if ((window['console'] != undefined)) {
                console.log(text);
            }
        }

        function posizionaMessggi(jQuerySelector) {
            try {

                $(jQuerySelector).css("z-index", "100000");
                $(jQuerySelector).css("position", "absolute");
                $(jQuerySelector).css("top", window.pageYOffset.toString() + "px");
                $(jQuerySelector).css("width", $(window).width().toString() + "px");

            } catch (e) {
                console.log("posizionaMessggi non riuscita...");
            }

        }

        //MESSAGGI SU SCHERMO
        function MessaggioErrore_Bootstrap(str, id_div) {
            var stringa_html = '<div class="alert alert-danger" role="alert">' + str +
                '<button type="button" class="close chiudi_alert" data-dismiss="alert"><span aria-hidden="true">&times;</span> <span class="sr-only">Close</span></button></div>';
            $('#' + id_div).html(stringa_html);
            posizionaMessggi('#' + id_div);
        }
        function MessaggioErroreTooltip_Bootstrap(str, id_div, tooltip) {
            MessaggioErrore_Bootstrap(str, id_div);
            $('#' + id_div).attr('title', tooltip);
            posizionaMessggi('#' + id_div);
        }

        function MessaggioTuttoOK_Bootstrap(str, id_div) {
            var stringa_html = '<div class="alert alert-success" role="alert">' + str +
                '<button type="button" class="close chiudi_alert" data-dismiss="alert"><span aria-hidden="true">&times;</span> <span class="sr-only">Close</span></button></div>';
            $('#' + id_div).html(stringa_html);
            posizionaMessggi('#' + id_div);
            setTimeout(function () { $('.chiudi_alert').click(); }, 3000);
        }

        function MessaggioAttenzione_Bootstrap(str, id_div, timeFadeOut) {
            var stringa_html = '<div class="alert alert-warning" role="alert">' + str +
                '<button type="button" class="close chiudi_alert" data-dismiss="alert"><span aria-hidden="true">&times;</span> <span class="sr-only">Close</span></button></div>';
            $('#' + id_div).html(stringa_html);
            posizionaMessggi('#' + id_div);
            if (timeFadeOut === undefined || timeFadeOut === null) {
                timeFadeOut = 3000;
            }
            if (timeFadeOut !== 0) {
                setTimeout(function () { $('.chiudi_alert').click(); }, timeFadeOut);
            }
        }

        function MessaggioErrore(str) {
            $('#dialog_errore').modal('show');
            $('#messaggioErrore').html(str);
            
            WaitFrame.hide();

        }

        function ScritturaOK(str) {
            $('#dialog_ok').modal('show');
            $('#messaggioOk').html(str);

            WaitFrame.hide();
        }



        function ConfermaControlliSiNo(messaggio, str) {
            $('#messaggioSiNo').html(messaggio);
            $('#variabileSiNo').html(str);

            $('#dialog_sino').modal('show');
        }



        function Azione_Indietro() {
            try {
                $('input, select, textarea').each(function () {
                    $(this).rules('remove', 'required');
                    $(this).removeClass();
                    $(this).addClass('form-control');

                });
            }
            catch (err) {
                
            }
            

            $('#<%=ImgBtn_AnnullaTutto.ClientID %>').click();

        }
          

        function uniqueID() {
            var today = new Date();
            return "ID" + today.getgetMinutes + "_" + today.getSeconds + "_" + today.getMilliseconds;
        }

        function roundNumber(num, dec) {
            var result = Math.round(num * Math.pow(10, dec)) / Math.pow(10, dec);
            return result;
        }

        $('body').on('change', '.change_per_load', function () {
            WaitFrame.show();
        });

        $('body').on('click', '.btn_per_load', function () {
            WaitFrame.show();
        });

        //' VAnni: 14/4/2017: Nascondo il waitFrame
        //WaitFrame.show();

        //' VAnni: 14/4/2017: nascondo tutta la funzione (ormai non fa più nulla ..)
        //$(window).load(function () {
        //    //' VAnni: 14/4/2017: Nascondo il waitFrame
        //    //WaitFrame.hide();

        //    // ricalcolo il posizionamento del footer (sposto se necessario)
        //    //ricalcolaPosizioneFooter();

        //});

        function iFrameGeneric_Chiudi() {
            $('#iFrameGeneric').modal('hide');
        }

        function Azione_Cambia_Impresa() {
            <%If flag_pag_MenuAgenda OrElse flag_pag_GestioneMagazziniBS Then%>
            try {
                $('input, select, textarea').each(function () {
                    $(this).rules('remove', 'required');
                    $(this).removeClass();
                    $(this).addClass('form-control');

                });
            }
            catch (err) {

            }

            $('#<%=ImgBtn_Filtro.ClientID %>').click();
            <% Else If flag_pag_MenuBS_2017 %>
            GoToFiltrino(0);
            <%End If%>
        }

    </script>

    <asp:ContentPlaceHolder ID="ContentScript" runat="server" />

    <div style="clear: both;"></div>
</form>
