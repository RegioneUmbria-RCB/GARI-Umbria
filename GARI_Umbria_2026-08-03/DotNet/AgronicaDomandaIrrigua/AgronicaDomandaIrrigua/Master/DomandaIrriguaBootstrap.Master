        var objP_agenda = '<%=objParametri_agenda_String  %>';
        var usernameLoggato = '<%=UsernameLoggato %>'
        var SonoLoggatoComeSuperUser = <%= SonoLoggatoComeSuperUser %>;
        var LinguaDellUtente = <%= LinguaDellUtente %>;

        var pathCoreWS = '<%=pathCoreWS %>';
        var pivaAziendaSelezionata = '<%= pivaAziendaSelezionataClientSide %>';
         
        var localizationPageUrl = "<%= ResolveClientUrl("~/Localization.aspx") %>";
       
    </script>

    <cc2:bootstrap id="bootstrap" runat="server" />
