                        </div>
                    </div>
                </asp:Panel>
            </div>

        </div>
    </div>


    <!--- SALVATAGGIO -->
    <div class="row xo-operazioni-salvataggio" style="margin-bottom: 20px;">

        <asp:UpdatePanel ID="UpdatePanelSalvataggio" runat="server">
            <ContentTemplate>
                <%--                              </ContentTemplate>
            </asp:UpdatePanel>--%>

                <div class="col-lg-8 col-md-12 col-xs-12" id="divSalva" style="padding-top: 10px; padding-left: 5px; padding-right: 5px;">
                    <div class="btn btn-success btn_100 xi-btn-primary xo-max-w-200" onclick="$('#<%=tipo_salva.ClientID %>').val(1); SalvataggioCostiAccessori(); ValidaxSubmit();">
                        <i class="fa fa-floppy-o xo-icon xo-btnsave_type03_saveexit"></i>
                        <asp:Localize meta:resourcekey="btnSalvaEdEsci" runat="server">Salva ed Esci</asp:Localize>

                        <asp:HiddenField ID="tipo_salva" runat="server" />
                        <asp:HiddenField ID="tipo_salva_parametri" runat="server" />
                        <asp:ImageButton ID="ImgBtn_SalvaTutto" runat="server" ImageUrl="~/AB_Immagini/Icone32/Dischetto.ico" Style="display: none" />
                        <asp:ImageButton ID="ImgBtn_SalvaDistinta" runat="server" ImageUrl="~/AB_Immagini/Icone32/Dischetto.ico" Style="display: none" />
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-xs-6" style="padding-top: 10px; padding-left: 5px; padding-right: 5px; display: none" id="divSalvaRicetta">
                    <div class="btn btn-success btn_100 xi-btn-primary xo-max-w-200" onclick="BottoneSalvaRicetta(1);">
                        <i class="fa fa-floppy-o xo-icon xo-btnsave_type03_saveexit"></i>
                        <asp:Localize meta:resourcekey="btnSalvaEdEsci" runat="server">Salva ed Esci</asp:Localize>
                    </div>
                </div>


                <div class="col-lg-2 col-md-6 col-xs-12" style="padding-top: 10px; padding-left: 5px; padding-right: 5px;" id="divSalvaNuovo">
                    <div class="btn btn-success btn_100 xi-btn-primary xo-max-w-200" onclick="$('#<%=tipo_salva.ClientID %>').val(2); SalvataggioCostiAccessori(); ValidaxSubmit();">
                        <i class="fa fa-floppy-o xo-icon xo-btnsave_ic_options_save_and_create_new_type01"></i>
                        <asp:Localize meta:resourcekey="btnSalvaENuovo" runat="server">Salva e Nuovo</asp:Localize>
                    </div>
                </div>
                <!--<div class="col-lg-4 col-md-6 col-xs-12" style="padding-top: 10px; padding-left: 5px; padding-right: 5px; display: none" id="divSalvaNuovaRicetta">
                    <div class="btn btn-success btn_100" onclick="BottoneSalvaRicetta(2);">
                        <i class="fa fa-floppy-o"></i>
                        <asp:Localize meta:resourcekey="btnSalvaENuovaRicetta" runat="server">Salva e Nuova Ricetta</asp:Localize>
                    </div>
                </div>-->



                <div class="col-lg-2 col-md-6 col-xs-12" style="padding-top: 10px; padding-left: 5px; padding-right: 5px;" id="divSalvaDuplica">
                    <div class="btn btn-success btn_100 xi-btn-primary xo-max-w-200" onclick="$('#<%=tipo_salva.ClientID %>').val(3); SalvataggioCostiAccessori(); ValidaxSubmit();">
                        <i class="fa fa-floppy-o xo-icon xo-btnsave_ic_options_save_and_clone_type01"></i>
                        <asp:Localize meta:resourcekey="btnSalvaEDuplica" runat="server">Salva e Duplica</asp:Localize>
                    </div>
                </div>
                <!--<div class="col-lg-4 col-md-6 col-xs-12" style="padding-top: 10px; padding-left: 5px; padding-right: 5px; display: none" id="divAggiungiDettaglioRicetta">
                    <div class="btn btn-success btn_100" onclick="BottoneSalvaRicetta(3);">
                        <i class="fa fa-floppy-o"></i>
                        <asp:Localize meta:resourcekey="btnSalvaEAggiungiDettaglioRicetta" runat="server">Salva e Aggiungi Dettaglio a Ricetta</asp:Localize>
                    </div>
                </div>-->
                <div class="col-lg-6 col-md-6 col-xs-12" style="padding-top: 10px; padding-left: 5px; padding-right: 5px; display: none" id="divRicetteSalvaEVai">
                    <div>
                        <ul id="menuRicette">
                            <li class="btn btn-success btn_100">
                                <i class="fa fa-floppy-o"></i>
                                Salva e:
                                <ul id="ulMenuRicette">
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>


                <%If (Permessi.getPermesso(enum_Security_Attivita.Inserimento_CostiRicavi_Da_QdC_CdG).Scrittura = True AndAlso flag_MostraBtnSalvaCDG = True) Then%>
                <div class="col-lg-2 col-md-6 col-xs-12 pull-right" style="padding-top: 10px; padding-left: 5px; padding-right: 5px;" id="divSalvaCDG">
                    <div class="btn <%=If(hf_esistonoCostiCollegatiCDG.Value.ToLower = "true", "btn-warning", "btn-success") %> btn_100" onclick="$('#<%=tipo_salva.ClientID %>').val(4); SalvataggioCostiAccessori(); ValidaxSubmit();">
                        <i class="fa fa-floppy-o"></i>
                        <asp:Localize meta:resourcekey="btnSalvaECDG" runat="server">Salva e vai ai Costi</asp:Localize>
                    </div>
                </div>
                <%End If%>


                <div class="col-lg-1 col-md-1 col-xs-12 text-right" id="divSalvaOpzioni" style="display: none">

                    <button id="btnSalva_Opzioni" type="button" class="btn btn-success btn_100 dropdown-toggle" data-toggle="dropdown"
                        aria-haspopup="true" aria-expanded="false">
                        <span class="caret"></span><span class="sr-only">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu" style="right: 0; left: auto !important;">
                        <li><a href="#" onclick="$('#<%=tipo_salva.ClientID %>').val(1); SalvataggioCostiAccessori(); ValidaxSubmit();">Salva ed Esci</a></li>
                        <li><a href="#" onclick="$('#<%=tipo_salva.ClientID %>').val(2); SalvataggioCostiAccessori(); ValidaxSubmit();">Salva e Nuovo</a></li>
                        <li><a href="#" onclick="$('#<%=tipo_salva.ClientID %>').val(3); SalvataggioCostiAccessori(); ValidaxSubmit();">Salva e Duplica</a></li>
                        <li><a href="#" onclick="$('#<%=tipo_salva.ClientID %>').val(4); SalvataggioCostiAccessori(); ValidaxSubmit();">Salva e CDG</a></li>
                    </ul>






                    <asp:Panel ID="Box_Salva" runat="server" meta:resourcekey="Box_SalvaResource1" CssClass="row" Style="display: none;">
                        <div class="col-md-4">
                            <div class="btn btn-success btn_per_load" onclick="RiabilitaTutto();" style="width: 100%">
                                <span class="fa fa-floppy-o"></span><span>Salva</span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <asp:ImageButton ID="ImgBtn_Salva" runat="server" ImageUrl="../AB_Immagini/icone32/dischetto.ico"
                                Style="display: none;" meta:resourcekey="ImgBtn_SalvaResource1" />
                            <style>
                                .RBL_Salva tbody tr td {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                }
                            </style>

                        </div>
                    </asp:Panel>

                </div>

            </ContentTemplate>
        </asp:UpdatePanel>

    </div>


    <script type="text/javascript">

        function SalvaAccessoriDefault() {
            SalvataggioCostiAccessori();
            $("#<%=SalvaCostiDefault.ClientID%>").click(); //effettua il post back per eliminazione dei dati $('#dialogCostiAccessori').modal('hide');
        };

    </script>

    <asp:UpdatePanel ID="UpdatePanel1" runat="server" UpdateMode="Conditional">
        <ContentTemplate>
            <asp:Button ID="AggiornaCostiAccessori" runat="server" Style="display: none;" meta:resourcekey="AggiornaCostiAccessoriResource1" />
            <asp:Button ID="btnApriContattiCosti" runat="server" Style="display: none;" />
            <asp:Button ID="SalvaCostiDefault" runat="server" Style="display: none;" meta:resourcekey="SalvaCostiAccessoriResource1" />
        </ContentTemplate>
    </asp:UpdatePanel>
    <br />
    <br />

    <!-- Bottoni Salvattaggio e Annulla -->
    <asp:Button ID="SalvaCostiAccessori" runat="server" Style="display: none;" meta:resourcekey="SalvaCostiAccessoriResource1" />
    <asp:Button ID="AnnullaCostiAccessori" runat="server" Style="display: none;" meta:resourcekey="AnnullaCostiAccessoriResource1" />


    <!--Dialog per l'eliminazione -->
    <div class="modal fade" id="dialogCostiAccessori" tabindex="-1" role="dialog" aria-labelledby="dialogCostiAccessoriLabel"
        aria-hidden="true">
        <div class="modal-dialog  modal-lg">
            <asp:UpdatePanel ID="UpdateCostiAccessori" runat="server" UpdateMode="Conditional">
                <ContentTemplate>
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="dialogCostiAccessoriLabel">
                                <%=divCostiAccessori %></h4>
                        </div>
                        <div class="modal-body">
                            <!-- DIALOG -->
                            <div class="modal fade" id="dialog" tabindex="-1" role="dialog" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-body">
                                            <div id="xiframe" style="height: 100%">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <asp:Button ID="BottoneNascostoContatti" runat="server" Text="BottoneNascostoContatti"
                                Style="display: none" />
                            <div class="row">
                                <div class="col-md-4">
                                    <asp:GridView ID="dgrCentriCosto" runat="server" AutoGenerateColumns="False" CellPadding="5"
                                        CssClass="table table-bordered">
                                        <Columns>
                                            <asp:ButtonField DataTextField="Fabbricato_Des" HeaderText="Provenienza" CommandName="Select" />
                                            <asp:ButtonField Text="&lt;img src='../AB_Immagini/icone16/Nuovo16.ico'
    border='0'&gt;"
                                                CommandName="NuovoElemento" Visible="true" />
                                        </Columns>
                                        <HeaderStyle CssClass="ui-widget-header" />
                                        <PagerStyle CssClass="ui-widget-header" HorizontalAlign="Center" />
                                    </asp:GridView>
                                </div>
                                <div class="col-md-8">
                                    <div class="row">
                                        <div id="Filtro_Materiali" runat="server" style="vertical-align: top;">
                                            <div style="vertical-align: middle; float: left;">
                                                <asp:Label ID="Lbl_FiltroMateriali" runat="server">Filtro </asp:Label>
                                            </div>
                                            <div style="vertical-align: middle; float: left; margin-left: 10px;">
                                                <asp:TextBox ID="Txt_FiltroMateriali" runat="server" CssClass="txtUI"></asp:TextBox>
                                            </div>
                                            <div style="vertical-align: middle; float: left; margin-left: 10px;">
                                                <img src="../AB_Immagini/icone32/lente.ico" alt="Carica prodotti magazzino" onclick="FiltraMaterialiMagazzino();"
                                                    style="cursor: pointer;" />
                                            </div>
                                            <div style="vertical-align: middle; float: left; margin-left: 10px;">
                                                <asp:Label ID="Lbl_RisFiltro" runat="server"></asp:Label>
                                            </div>
                                            <asp:Button ID="BTN_FiltraMateriali" runat="server" Text="Filtro" Style="display: none" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <asp:GridView ID="dgrMateriali" runat="server" AutoGenerateColumns="False" CssClass="table table-bordered">
                                            <Columns>
                                                <asp:ButtonField Text="&lt;img src='../AB_Immagini/icone16/FrecciaRossa_S.ico' border='0'&gt;"
                                                    CommandName="AggiungiCosto" />
                                                <asp:BoundField DataField="Col_0" HeaderText="Categoria Prodotto" meta:resourcekey="dgrMaterialiCategoriaProdottoResource1"></asp:BoundField>
                                                <asp:BoundField DataField="Col_1" HeaderText="Prodotto" meta:resourcekey="dgrMaterialiProdottoResource1"></asp:BoundField>
                                                <asp:BoundField DataField="Col_2" HeaderText="Giacenza" meta:resourcekey="dgrMaterialiGiacenzaResource1"></asp:BoundField>
                                                <asp:BoundField DataField="Col_3" HeaderText="Codice_Materiale" meta:resourcekey="dgrMaterialiCodiceMaterialeResource1">
                                                    <ItemStyle CssClass="displaynone" />
                                                    <HeaderStyle CssClass="displaynone" />
                                                </asp:BoundField>
                                                <asp:BoundField DataField="Col_5" HeaderText="Udm_Cod">
                                                    <ItemStyle CssClass="displaynone" />
                                                    <HeaderStyle CssClass="displaynone" />
                                                </asp:BoundField>
                                                <asp:BoundField DataField="Col_6" HeaderText="Elem_Cod">
                                                    <ItemStyle CssClass="displaynone" />
                                                    <HeaderStyle CssClass="displaynone" />
                                                </asp:BoundField>
                                                <asp:BoundField DataField="Col_7" HeaderText="Ditta_Cod">
                                                    <ItemStyle CssClass="displaynone" />
                                                    <HeaderStyle CssClass="displaynone" />
                                                </asp:BoundField>
                                                <asp:BoundField DataField="Col_8" HeaderText="Mat_Cod">
                                                    <ItemStyle CssClass="displaynone" />
                                                    <HeaderStyle CssClass="displaynone" />
                                                </asp:BoundField>
                                                <asp:BoundField DataField="Col_9" HeaderText="Costo Unitario
    [euro]"
                                                    meta:resourcekey="dgrMaterialiCostoUnitarioResource1"></asp:BoundField>
                                            </Columns>
                                            <HeaderStyle CssClass="ui-widget-header" />
                                            <PagerStyle CssClass="ui-widget-header" HorizontalAlign="Center" />
                                        </asp:GridView>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <asp:GridView ID="dgrScarico" runat="server" AutoGenerateColumns="False" Width="100%"
                                        CellPadding="5" CssClass="table table-bordered">
                                        <Columns>
                                            <asp:ButtonField Text="&lt;img src='../AB_Immagini/icone16/gomma16.ico'
    border='0'&gt;"
                                                CommandName="EliminaCosto" />
                                            <asp:BoundField DataField="Centro" HeaderText="Centri di Costo" meta:resourcekey="dgrScaricoCentridiCostoResource1" />
                                            <asp:BoundField DataField="Categoria_Des" HeaderText="Categoria Risorsa" meta:resourcekey="dgrScaricoCategoriaRisorsaResource1" />
                                            <asp:BoundField DataField="Risorsa_des" HeaderText="Risorsa" meta:resourcekey="dgrScaricoRisorsaResource1" />
                                            <asp:TemplateField HeaderText="Unit&#224; Misura" meta:resourcekey="dgrScaricoUnitaMisuraResource1">
                                                <ItemTemplate>
                                                    <asp:DropDownList ID="Cmb_UdmCosti" runat="server">
                                                    </asp:DropDownList>
                                                </ItemTemplate>
                                            </asp:TemplateField>
                                            <asp:TemplateField HeaderText="Quantità">
                                                <ItemTemplate>
                                                    <asp:TextBox ID="Txt_Qta_Ril" runat="server" CssClass="txtUI"> </asp:TextBox>
                                                </ItemTemplate>
                                            </asp:TemplateField>
                                            <asp:BoundField DataField="Costo_Unitario" HeaderText="Costo
    Unitario [euro]"
                                                meta:resourcekey="dgrScaricoCostoUnitarioResource1" />
                                            <asp:BoundField DataField="Costo" HeaderText="Costo [euro]" meta:resourcekey="dgrScaricoCostoResource1" />
                                        </Columns>
                                        <HeaderStyle CssClass="ui-widget-header" />
                                        <PagerStyle CssClass="ui-widget-header" HorizontalAlign="Center" />
                                    </asp:GridView>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal" onclick='$("#<%=AnnullaCostiAccessori.ClientID %>").click();'>
                                Annulla</button>
                            <div type="button" class="btn btn-primary" id="Div3" onclick="$('#dialogCostiAccessori').modal('hide'); SalvaAccessoriDefault();">
                                Aggiungi e Salva Profilo
                            </div>
                            <div type="button" class="btn btn-primary" id="Div2" onclick="$('#dialogCostiAccessori').modal('hide');SalvaAccessori();">
                                Aggiungi
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
                <Triggers>
                    <asp:AsyncPostBackTrigger ControlID="BottoneNascostoContatti" EventName="Click" />
                    <asp:AsyncPostBackTrigger ControlID="AggiornaCostiAccessori" EventName="Click" />
                    <asp:AsyncPostBackTrigger ControlID="SalvaCostiAccessori" EventName="Click" />
                    <asp:AsyncPostBackTrigger ControlID="SalvaCostiDefault" EventName="Click" />
                    <asp:AsyncPostBackTrigger ControlID="AnnullaCostiAccessori" EventName="Click" />
                </Triggers>
            </asp:UpdatePanel>
        </div>
    </div>
    <asp:UpdatePanel ID="UpdatePanel2" runat="server" UpdateMode="Conditional">
        <ContentTemplate>
            <asp:Button ID="AggiornaCostiAccessoriAvanzati" runat="server" Style="display: none;"
                meta:resourcekey="AggiornaCostiAccessoriResource1" />
        </ContentTemplate>
    </asp:UpdatePanel>

    <!--- Bottoni Salvattaggio e Annulla -->
    <asp:Button ID="SalvaCostiAccessoriAvanzati" runat="server" Style="display: none;"
        meta:resourcekey="SalvaCostiAccessoriResource1" />
    <asp:Button ID="AnnullaCostiAccessoriAvanzati" runat="server" Style="display: none;"
        meta:resourcekey="AnnullaCostiAccessoriResource1" />

    <!--Dialog per l'eliminazione
    -->
    <div class="modal fade" id="dialogCostiAccessoriAvanzati" tabindex="-1" role="dialog"
        aria-labelledby="dialogCostiAccessoriAvanzatiLabel" aria-hidden="true">
        <div class="modal-dialog  modal-lg">
            <asp:UpdatePanel ID="UpdateCostiAccessoriAvanzati" runat="server" UpdateMode="Conditional">
                <ContentTemplate>
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="dialogCostiAccessoriAvanzatiLabel">
                                <%=divCostiAccessoriAvanzati
                                %></h4>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <asp:GridView ID="dgrCentriCostoAvanzati" runat="server" AutoGenerateColumns="False"
                                        CellPadding="5" CssClass="table table-bordered">
                                        <Columns>
                                            <asp:ButtonField DataTextField="Fabbricato_Des" HeaderText="Provenienza" CommandName="Select"
                                                meta:resourcekey="btnFldFabbricato_DesResource1" />
                                        </Columns>
                                        <HeaderStyle CssClass="ui-widget-header" />
                                        <PagerStyle CssClass="ui-widget-header" HorizontalAlign="Center" />
                                    </asp:GridView>
                                </div>
                                <div class="col-md-8">
                                    <div class="row">
                                        <div id="Filtro_MaterialiAvanzati" runat="server" style="vertical-align: top;">
                                            <div style="vertical-align: middle; float: left;">
                                                <asp:Label ID="Lbl_FiltroMaterialiAvanzati" runat="server">Filtro </asp:Label>
                                            </div>
                                            <div style="vertical-align: middle; float: left; margin-left: 10px;">
                                                <asp:TextBox ID="Txt_FiltroMaterialiAvanzati" runat="server" CssClass="txtUI"></asp:TextBox>
                                            </div>
                                            <div style="vertical-align: middle; float: left; margin-left: 10px;">
                                                <img src="../AB_Immagini/icone32/lente.ico" alt="Carica
    prodotti magazzino"
                                                    onclick="FiltraMaterialiMagazzinoAvanzati();" style="cursor: pointer;" />
                                            </div>
                                            <div style="vertical-align: middle; float: left; margin-left: 10px;">
                                                <asp:Label ID="Lbl_RisFiltroAvanzati" runat="server"></asp:Label>
                                            </div>
                                            <asp:Button ID="BTN_FiltraMaterialiAvanzati" runat="server" Text="Filtro" Style="display: none" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <asp:GridView ID="dgrMaterialiAvanzati" runat="server" AutoGenerateColumns="False"
                                            CellPadding="5" CssClass="table table-bordered">
                                            <Columns>
                                                <asp:ButtonField Text="&lt;img src='../AB_Immagini/icone16/FrecciaRossa_S.ico'
    border='0'&gt;"
                                                    CommandName="AggiungiCosto" />
                                                <asp:BoundField DataField="Col_0" HeaderText="Categoria Prodotto" meta:resourcekey="dgrMaterialiCategoriaProdottoResource1"></asp:BoundField>
                                                <asp:BoundField DataField="Col_1" HeaderText="Prodotto" meta:resourcekey="dgrMaterialiProdottoResource1"></asp:BoundField>
                                                <asp:BoundField DataField="Col_2" HeaderText="Giacenza" meta:resourcekey="dgrMaterialiGiacenzaResource1"></asp:BoundField>
                                                <asp:BoundField DataField="Col_3" HeaderText="Codice_Materiale" meta:resourcekey="dgrMaterialiCodiceMaterialeResource1">
                                                    <ItemStyle CssClass="displaynone" />
                                                    <HeaderStyle CssClass="displaynone" />
                                                </asp:BoundField>
                                                <asp:BoundField DataField="Col_5" HeaderText="Udm_Cod">
                                                    <ItemStyle CssClass="displaynone" />
                                                    <HeaderStyle CssClass="displaynone" />
                                                </asp:BoundField>
                                                <asp:BoundField DataField="Col_6" HeaderText="Elem_Cod">
                                                    <ItemStyle CssClass="displaynone" />
                                                    <HeaderStyle CssClass="displaynone" />
                                                </asp:BoundField>
                                                <asp:BoundField DataField="Col_7" HeaderText="Ditta_Cod">
                                                    <ItemStyle CssClass="displaynone" />
                                                    <HeaderStyle CssClass="displaynone" />
                                                </asp:BoundField>
                                                <asp:BoundField DataField="Col_8" HeaderText="Mat_Cod">
                                                    <ItemStyle CssClass="displaynone" />
                                                    <HeaderStyle CssClass="displaynone" />
                                                </asp:BoundField>
                                                <asp:BoundField DataField="Col_9" HeaderText="Costo Unitario
    [euro]"
                                                    meta:resourcekey="dgrMaterialiCostoUnitarioResource1"></asp:BoundField>
                                            </Columns>
                                            <HeaderStyle CssClass="ui-widget-header" />
                                            <PagerStyle CssClass="ui-widget-header" HorizontalAlign="Center" />
                                        </asp:GridView>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <asp:GridView ID="dgrScaricoAvanzati" runat="server" AutoGenerateColumns="False"
                                        Width="100%" CellPadding="5" CssClass="table table-bordered">
                                        <Columns>
                                            <asp:ButtonField Text="&lt;img src='../AB_Immagini/icone16/gomma16.ico'
    border='0'&gt;"
                                                CommandName="EliminaCosto" />
                                            <asp:BoundField DataField="Centro" HeaderText="Centri di Costo" meta:resourcekey="dgrScaricoCentridiCostoResource1" />
                                            <asp:BoundField DataField="Categoria_Des" HeaderText="Categoria Risorsa" meta:resourcekey="dgrScaricoCategoriaRisorsaResource1" />
                                            <asp:BoundField DataField="Risorsa_des" HeaderText="Risorsa" meta:resourcekey="dgrScaricoRisorsaResource1" />
                                            <asp:TemplateField HeaderText="Unit&#224; Misura" meta:resourcekey="dgrScaricoUnitaMisuraResource1">
                                                <ItemTemplate>
                                                    <asp:DropDownList ID="Cmb_UdmCosti" runat="server">
                                                    </asp:DropDownList>
                                                </ItemTemplate>
                                            </asp:TemplateField>
                                            <asp:TemplateField HeaderText="Quantità">
                                                <ItemTemplate>
                                                    <asp:TextBox ID="Txt_Qta_Ril" runat="server" CssClass="txtUI" Width="100px"> </asp:TextBox>
                                                </ItemTemplate>
                                            </asp:TemplateField>
                                            <asp:BoundField DataField="Costo_Unitario" HeaderText="Costo Unitario [euro]" meta:resourcekey="dgrScaricoCostoUnitarioResource1" />
                                            <asp:BoundField DataField="Costo" HeaderText="Costo [euro]" meta:resourcekey="dgrScaricoCostoResource1" />
                                            <asp:TemplateField HeaderText="Attività">
                                                <ItemTemplate>
                                                    <div style="width: 250px;">
                                                        <asp:DropDownList ID="Cmb_Attivita" runat="server" CssClass="txtUI" AutoPostBack="false">
                                                        </asp:DropDownList>
                                                    </div>
                                                </ItemTemplate>
                                            </asp:TemplateField>
                                            <asp:TemplateField HeaderText="Turno">
                                                <ItemTemplate>
                                                    <div style="width: 250px;">
                                                        <asp:DropDownList ID="Cmb_Turni" runat="server" CssClass="txtUI" AutoPostBack="true">
                                                        </asp:DropDownList>
                                                    </div>
                                                </ItemTemplate>
                                            </asp:TemplateField>
                                        </Columns>
                                        <HeaderStyle CssClass="ui-widget-header" />
                                        <PagerStyle CssClass="ui-widget-header" HorizontalAlign="Center" />
                                    </asp:GridView>
                                    <asp:Button ID="BTN_ComboAttivita" runat="server" Text="Button" Style="display: none" />
                                    <asp:Button ID="BTN_ComboTurni" runat="server" Text="Button" Style="display: none" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal" onclick='$("#<%=AnnullaCostiAccessoriAvanzati.ClientID %>").click();'>
