        function kendoAppezzamenti_RipristinaSelezionati() {

            var impiantiSelezionati = JSON.parse($("#<%= hdKendo_Impianti_Selezione.ClientID %>").val());

            var nRighe = impiantiSelezionati.length;

            Esegui_CalcoliFinali = false;

            for (var i = 0; i < nRighe; i++) {

                var curImpinato = impiantiSelezionati[i];

                var chiaveKendo =
                    curImpinato.Piva + "-" +
                    curImpinato.Sa_Cod + "-" +
                    curImpinato.Appezza + "-" +
                    curImpinato.ID_Reg;

                kEventoSelezionaRiga_Sup_Coninvolta = curImpinato.Qta2;
                $("#kendo_impianti_" + chiaveKendo).click();

            }

            if (nRighe > 0) {

                kendoRefresh("#kendo_impianti");
                RicalcolaSuperficieTotale();
                RicalcolaSuperficieCoinvolta(true);
                Aggiorna_hdKendo_Impianti_Selezione();

                AggiornaDopo_SupTrattata();

                if (inizializzazioneKendo_Eseguita) {
                    //AggiornaDopo_SupTrattata();
                    AggiornaCostiAdEttaro();
                    inizializzazioneKendo_Eseguita = true;
                }
            }
            Esegui_CalcoliFinali = true;
        }



