        //#Region "Eventi Kendo"

        function onSaveKendoGrid(e) {

            var fieldValue = e.container.find("input").val();

        }

        function UdmDatoCentro(centro_cod) {

            switch (centro_cod) {
                case -1:
                    return { Udm_Cod: -1, Udm_Des: "Indefinito" }
                case -2:
                    return { Udm_Cod: 2, Udm_Des: "ora" }
                default:
                    return { Udm_Cod: 2, Udm_Des: "ora" }
            }

        }

        function Centro_Des_datoCodice(centro_cod) {

            switch (centro_cod) {
                case -1:
                    return "Parco Macchine"
                case -2:
                    return "Manodopera"
                default:
                    return "Manodopera"
            }

        }

        function onDataBoundedRigheCosti(e) {

            var grid = $("#kendo_CostiAccessori").data("kendoGrid");

            //imposto i valori del centro di costo sulle righe aggiunte
            var dataItem = e.sender.dataItem(e.sender.tbody.children());

            inizializzazioneKendo_TabCosti();

            //si tratta di una nuova Riga (aggiunta) se Centro_Cod = 0
            if (dataItem != null) {
                if (dataItem.Centro_Cod == 0) {

                    var kendoModel = grid.dataSource.data();

                    var data = grid.dataSource.data();
                    for (var i = 0; i < data.length; i++) {
                        var dataModel = data[i];
                        if (dataModel.uid == dataItem.uid) {

                            var lCentro_Cod = parseInt($(id_hdKendo_CostiAccessori_ComboHelper_Comando).val());
                            var udm = UdmDatoCentro(lCentro_Cod);

                            dataModel.Centro_Cod = lCentro_Cod;
                            dataModel.Centro_Des = Centro_Des_datoCodice(lCentro_Cod);
                            dataModel.Centro = Centro_Des_datoCodice(lCentro_Cod);
                            dataModel.Udm_Cod = udm.Udm_Cod;
                            dataModel.Udm_Des = udm.Udm_Des;
                        }
                    }

                    kendoRefresh("#kendo_CostiAccessori");

                }
            }




            //autofit..
            var gridId = e.sender.element[0].id;

            for (var i = 0; i < grid.columns.length; i++) {
                if (grid.columns[i].title == "Risorsa")
                    grid.columns[i].width = 300;
                else
                    grid.autoFitColumn(i);
            }



        }

        function onDataBoundedRigheApp(e) {

            //dimensiono le colonne
            var grid = e.sender;

            if ($(window).width() <= 767) {

            } else {
                for (var i = 0; i < grid.columns.length; i++) {
                    switch (grid.columns[i].field) {
                        case null:
                            grid.columns[i].width = 30;
                            break;
                        case 'Rag_Soc':
                        case 'Sa_Nome':
                        case 'Campo_Des':
                        case 'App_Nome':
                        case 'Catasto':
                        case 'Cul_Des':
                        case 'Disciplinare':
                        case 'Reg_Des':
                        case 'Capitolato_Privato_Des':
                            grid.columns[i].width = 200;
                            break;
                        case 'Grfi_Des':
                            grid.columns[i].width = 350;
                            break;
                        default:
                            grid.columns[i].width = 100;
                    }
                }
            }


            //var RegolamentoColumnIndex = $("#kendo_impianti").find(".k-grid-header [data-field=" + "Regolamento" + "]").index();


            //righe...
            var rows = e.sender.tbody.children();

            var lavcod = $('.ComboOperazioni').val();

            for (var i = 0; i < rows.length; i++) {

                var row = $(rows[i]);
                var dataItem = e.sender.dataItem(row);

                var dpi = dataItem.get("Disciplinare");
                var reg = dataItem.get("Regolamento");

                //funzione per aggiungere il colore sulle righe che hanno il DPI quando il filtro dei disciplinari non presenta alcun tipo di disciplinare selezionato

                switch (parseInt(lavcod)) {

                    case 74: case 18: case 155: case 13: case 158: case 103: case 106: case 26: case 123: case 124: case 156: case 14: case 118: case 121:

                        if ($('.ComboDisciplinari').val() == 0 || $('.ComboDisciplinari').val() == -999) {
                            //dpi
                            if (!row.hasClass("dpiOn") && dpi != "") {
                                row.addClass("dpiOn");
                            } else {
                                row.removeClass("dpiOn");
                            }
                            //bio
                            if (!row.hasClass("dpiOn") && reg == "4") {
                                row.addClass("dpiOn");
                            }
                        } else {
                            if ($('.ComboDisciplinari').val() != -2 && reg == "4") {
                                row.addClass("dpiOn");
                            } else {
                                row.removeClass("dpiOn");
                            }
                        }
                        break;

                }


            }

        }

        function mostraColonnaUnicaSeInMobile_OperazioneBootstrapMaster(nColonneDaSaltare) {

            //Controllo se sono su mobile
            if ($(window).width() <= 767) {
                var grid = $("#kendo_impianti").data("kendoGrid");
                nColDescrizione_Unica = 0;
                nColSup_Imp_help = 0;

                for (var i = nColonneDaSaltare; i < grid.columns.length; i++) {
                    if (grid.columns[i].field === 'Descrizione_Unica')
                        nColDescrizione_Unica = i;
                    else if (grid.columns[i].field === 'Sup_Imp_help')
                        nColSup_Imp_help = i;
                    else
                        grid.hideColumn(i);
                }

                grid.showColumn(nColDescrizione_Unica);
                grid.showColumn(nColSup_Imp_help);
                //grid.columns[nColDescrizione_Unica].width = null;
                grid.columns[nColSup_Imp_help].width = 50;
                grid.scrollable = false;
                grid.reorderColumn(1, grid.columns[nColDescrizione_Unica]);

                //Nascondo il pulsante per selezionare le colonne
                $('#BtnFiltraColonne').hide();

            }
        }


