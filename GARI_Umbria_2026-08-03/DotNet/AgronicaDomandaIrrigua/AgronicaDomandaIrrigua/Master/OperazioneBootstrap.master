            </Triggers>
        </asp:UpdatePanel>

        <asp:UpdatePanel ID="UpdatePanelCostiAccessoriVisibili" runat="server">
            <ContentTemplate>

                <div id="CostiAccessori" style="width: 100%; overflow-x: auto;">
                    <asp:GridView ID="GridViewCostiAccessoriVisibili" runat="server" AutoGenerateColumns="False"
                        Width="100%" CellPadding="5" CssClass="table table-bordered table-striped" Caption="Altre Risorse Impiegate:"
                        meta:resourcekey="GridViewCostiAccessoriVisibiliResource1">
                        <Columns>
                            <asp:ButtonField Text="&lt;i class='fa fa-trash-o fa-2x' &gt; &lt;/i&gt;" CommandName="EliminaCosto" meta:resourcekey="ButtonFieldResource1" />
                            <asp:BoundField DataField="Centro" HeaderText="Centri di Costo" meta:resourcekey="BoundFieldResource20" />
                            <asp:BoundField DataField="Categoria_Des" HeaderText="Categoria Risorsa" meta:resourcekey="BoundFieldResource21" />
                            <asp:BoundField DataField="Risorsa_des" HeaderText="Risorsa" meta:resourcekey="BoundFieldResource22" />
                            <asp:TemplateField HeaderText="Unit&#224; Misura" meta:resourcekey="TemplateFieldResource3">
                                <ItemTemplate>
                                    <asp:DropDownList ID="Cmb_UdmCosti" runat="server" Enabled="true" CssClass="UdmCosti"
                                        meta:resourcekey="Cmb_UdmCostiResource1">
                                    </asp:DropDownList>
                                </ItemTemplate>
                            </asp:TemplateField>
                            <asp:TemplateField HeaderText="Quantit&#224;" meta:resourcekey="TemplateFieldResource4">
                                <ItemTemplate>
                                    <asp:TextBox ID="Txt_Qta_Ril" runat="server" CssClass="txtUI QtaCosti" meta:resourcekey="Txt_Qta_RilResource1"></asp:TextBox>
                                </ItemTemplate>
                            </asp:TemplateField>
                            <asp:BoundField DataField="Costo_Unitario" HeaderText="Costo Unitario [&lt;i class='fa fa-eur'&gt;&lt;/i&gt;]" meta:resourcekey="BoundFieldResource23" HtmlEncode="false">
                                <ItemStyle CssClass="CostoUnitario" />
                            </asp:BoundField>
                            <asp:BoundField DataField="Costo" HeaderText="Costo [&lt;i class='fa fa-eur'&gt;&lt;/i&gt;]" meta:resourcekey="BoundFieldResource24" HtmlEncode="false">
                                <ItemStyle CssClass="Costo" />
                            </asp:BoundField>
                            <asp:BoundField DataField="ore" HeaderText="ore">
                                <HeaderStyle CssClass="displaynone" />
                                <ItemStyle CssClass="ore displaynone" />
                            </asp:BoundField>
                            <asp:BoundField DataField="minuti" HeaderText="minuti">
                                <HeaderStyle CssClass="displaynone" />
                                <ItemStyle CssClass="minuti displaynone" />
                            </asp:BoundField>
                        </Columns>
                        <HeaderStyle CssClass="ui-widget-header" />
                        <PagerStyle CssClass="ui-widget-header" HorizontalAlign="Center" />
                    </asp:GridView>
