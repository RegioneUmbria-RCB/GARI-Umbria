        var DocumentReady_gisSmartInizializzazione_GPS = false;

        //DOCUMENT READY (Ufficiale)
        $(document).ready(function () {

            TraduzioniDaServerEdInizializzaPaginaOperazioneBS();

        });


        var OperazioneBSResx;

        function TraduzioniDaServerEdInizializzaPaginaOperazioneBS() {
            if (!OperazioneBSResx) {
                OperazioneBSResxLeggi();
            }
        }

        /*
         * Ottiene le traduzioni dal server
         */
        function OperazioneBSResxLeggi() {

            ajaxAgronica("../Localization.aspx/RitornaRisorseBS", JSON.stringify({ files: "Master/App_LocalResources/OperazioneBootstrap.master.resx" }),
                function (risposta) {
                    console.log(risposta);

                    try {
                        OperazioneBSResx = JSON.parse(risposta.RispostaStringa);
                        console.log("OperazioneBSResx...letto correttamente.");
                    } catch (e) {
                        console.log("OperazioneBSResx...errori in fase di parse del json.");
                    }

                    inizializzaPaginaOperazioneBS();
                }, function (risposta) {
                    console.log("OperazioneBSResx...errori in fase di lettura.");
                    inizializzaPaginaOperazioneBS();
                });
        }

        function inizializzaPaginaOperazioneBS() {

            console.log("Document.Ready: ... inizializzazioneKendo() ");

            $(".kendoCalendar").kendoDatePicker({
                footer: "#: kendo.toString(data, 'd')#",  //Template per il footer
                max: new Date(2100, 11, 31)
            });


            inizializzazioneKendo();

            inizializzazioneModuloGIS();


            $("#btn_nuova_ricetta").click(function () {
                SalvaRicettaconTestata();
            });

            $("#btnPosizione").click(function () {
                PuntoGPSFast();
            });

            $("#btnAnteprimaPosizione").click(function () {
                GisSmartBsBackGround = true;
                $("#rowGGDisegno").hide();
                $("#gissmartBsAnteprimaSuMappa_Title").hide();
                AnteprimaGisSmartBS(false);
            });

            console.log("Document.Ready: ... fine inizializzazioneKendo() ");

            inizializzazionePulsanteSalvataggio();
            AggiornaAcqua();

            $(document).on('click', '.tabCosti', function () {

                var id_costo = $(this).attr("data-idcosto");

                TabCosti_click(parseInt(id_costo));

            });


            $('#iFrameGeneric').on('hidden.bs.modal', function () {
                iFrame_Chiusura();

            });

        }


        function BottoneSalvaRicetta(bottone, Ricetta_Cod_p, Ricetta_Operazione_Cod_p, dataOp) {

            //ApriModalCreaRicetta(bottone, ricetta_cod, objParametriAgenda_TipoOperazione);
            //return;

            if ((ricetta_cod === '0' || ricetta_cod === '') && (objParametriAgenda_TipoOperazione == Enum_TipoOperazione.Scrittura.value)) {
                ApriModalCreaRicetta(bottone, ricetta_cod, objParametriAgenda_TipoOperazione);
            } else {

                var tipo_salvataggio = 0;

                switch (bottone) {
                    case 1:
                        tipo_salvataggio = 1;
                        break;

                    case 2:
                        tipo_salvataggio = 2;
                        break;

                    case 3:
                        tipo_salvataggio = 5;
                        break;
                }

                $('#<%=tipo_salva.ClientID %>').val(tipo_salvataggio);
                if (Ricetta_Cod_p !== undefined && Ricetta_Operazione_Cod_p !== undefined) {
                    var obj = {
                        ricetta_cod: Ricetta_Cod_p,
                        ricetta_operazione_cod: Ricetta_Operazione_Cod_p,
                        data: dataOp
                    }
                    $('#<%=tipo_salva_parametri.ClientID %>').val(JSON.stringify(obj));
                }
                SalvataggioCostiAccessori();
                ValidaxSubmit();
            }
        }


        async function ApriModalCreaRicetta(bottone, ricetta_cod, objParametriAgenda_TipoOperazione) {

            //presetto i valori      
            var ricetta_des = '';
            var ricetta_numero = '';
            var data_inizio_ricetta;
            var data_fine_ricetta;

            //if ((ricetta_cod === '0' || ricetta_cod === '') && (objParametriAgenda_TipoOperazione == Enum_TipoOperazione.Scrittura.value)) {
            //ricavo il default del numero ricetta
            ajaxAgronicaSync("Trattamenti_2.aspx/ricetta_numero_default", JSON.stringify({}), false,
                function (risposta) {
                    if (risposta.RispostaOK) {
                        ricetta_numero = risposta.RispostaStringa;
                    }
                }, null);

            var specie = $(".ComboSpecie").children('button').attr('title');
            var operazione = $(".ComboOperazioni").children('button').attr('title');

            data_inizio_ricetta = $("#<%=txt_DataOperazione.ClientID %>").val();
            data_fine_ricetta = $("#<%=txt_DataOperazione.ClientID %>").val();

            switch (bottone) {
                case 1:
                    ricetta_des = operazione + ' ' + specie + ' ' + data_inizio_ricetta;
                    break;
                case 2:
                    ricetta_des = operazione + ' ' + specie + ' ' + data_inizio_ricetta;
                    break;

                case 3:
                    ricetta_des = specie;
                    break;

                default:
                    ricetta_des = specie;
                    break;
            }

            //} else {
            //    var ricettaJSON = await caricaTestataRicetta(ricetta_cod);

            //    ricetta_des = ricettaJSON.Ricetta_Des;
            //    ricetta_numero = ricettaJSON.Ricetta_Numero;
            //    data_inizio_ricetta = new Date(ricettaJSON.Validita_Inizio).toLocaleDateString();
            //    data_fine_ricetta = new Date(ricettaJSON.Valitida_Fine).toLocaleDateString();


            //}

            if ($("#<%=Txt_Ricetta_Descrizione.ClientID %>").val() == "") {
                $("#<%=Txt_Ricetta_Descrizione.ClientID %>").val(ricetta_des);
            }

            if ($("#<%=Txt_Ricetta_Numero.ClientID %>").val() == "") {
                $("#<%=Txt_Ricetta_Numero.ClientID %>").val(ricetta_numero);
            }

            if ($("#<%=data_inizio_ricetta.ClientID %>").val() == "") {
                $("#<%=data_inizio_ricetta.ClientID %>").val(data_inizio_ricetta);
            }
            if ($("#<%=data_fine_ricetta.ClientID %>").val() == "") {
                $("#<%=data_fine_ricetta.ClientID %>").val(data_fine_ricetta);
            }

            $('#hd_bottone').text(bottone);

            //$('#modalCreaRicetta').modal('show');
            SalvaRicettaconTestata();
        }

        function caricaTestataRicetta(ricetta_cod) {
            return new Promise((resolve, reject) => {
                var parametri = kendo.stringify({
                    ricetta_cod: ricetta_cod
                });

                ajaxAgronica("Trattamenti_2.aspx/caricaTestataRicetta",
                    parametri,
                    function (risposta) {
                        resolve(JSON.parse(risposta.RispostaStringa));
                    }, null, null, false);
            });
        }

        function popolaTestataRicetta(ricettaJSON) {

            var ricetta_des = ricettaJSON.Ricetta_Des;
            var ricetta_numero = ricettaJSON.Ricetta_Numero;
            var data_inizio_ricetta = new Date(ricettaJSON.Validita_Inizio).toLocaleDateString();
            var data_fine_ricetta = new Date(ricettaJSON.Valitida_Fine).toLocaleDateString();
            var ricetta_note = ricettaJSON.Note;

            $("#<%=Txt_Ricetta_Descrizione.ClientID %>").val(ricetta_des);
            $("#<%=Txt_Ricetta_Numero.ClientID %>").val(ricetta_numero);

            $("#<%=data_inizio_ricetta.ClientID %>").val(data_inizio_ricetta);
            $("#<%=data_fine_ricetta.ClientID %>").val(data_fine_ricetta);

            $("#<%=Txt_Ricetta_Nota.ClientID %>").val(ricetta_note);
        }

        function SalvaRicettaconTestata() {

            var ricetta_des = $("#<%=Txt_Ricetta_Descrizione.ClientID %>").val();
            var ricetta_numero = $("#<%=Txt_Ricetta_Numero.ClientID %>").val();

            if (ricetta_des === '' || ricetta_numero === '') {
                var jsMsgInserireDescrizioneNum = Traduzione(OperazioneBSResx, "jsMsgInserireDescrizioneNum", "Inserire Descrizione e Numero della Ricetta!");
                alert(jsMsgInserireDescrizioneNum);
            } else {

                var bottone = parseInt($('#hd_bottone').text());

                var tipo_salvataggio = 0;

                switch (bottone) {
                    case 1:
                        tipo_salvataggio = 1;
                        break;

                    case 2:
                        tipo_salvataggio = 2;
                        break;

                    case 3:
                        tipo_salvataggio = 5;
                        break;
                }

                $('#<%=tipo_salva.ClientID %>').val(tipo_salvataggio);
                SalvataggioCostiAccessori();
                ValidaxSubmit();
                $('#modalCreaRicetta').modal('hide');
            }
        }

        function btnPosizioneInizializzaStart() {

            var gisSmartBsCfg = {
                tipoOggettoGisDaDisegnare: enumOggettiDisegnabili.Punto
            }

            gisSmartInizializzazione(gisSmartBsCfg);

            if (!DocumentReady_gisSmartInizializzazione_GPS) {
                gisSmartAvviaGPS()
                DocumentReady_gisSmartInizializzazione_GPS = true;
            }
        }

        /**
            * gesitone del valore di uscita nel caso dei contatti.
            *
            * @param {valore} valore di ritorno del salvataggio del contatto.        
            */
        function Contatto_gestisciValore(valore) {
            ChiusuraModale();
        }

        /**
        * gestione del valore di uscita nel caso dei contatti (se non è stato salvato il contatto).
        *
        */
        function Contatto_gestisciValore_esci() {
            ChiusuraModale();
        }

        function ChiusuraModale() {
            $('#iFrameGeneric').modal("hide");
        }

        function iFrame_Chiusura() {
            $("#PaginaGeneric").attr("src", "");
            $(id_hdKendo_CostiAccessori_ComboHelper_Gestione).val("Ricarica");
            tabCosti_onClick($(id_hdKendo_CostiAccessori_ComboHelper_Comando).val());
        }


        function tabCosti_ImpostaDescrizione(id_costo) {

            var nuovaRisorsa = "<%= NuovaRisorsaText.Replace("""", "\""") %>";
            var descr = $(".tabCosti[data-idcosto='" + id_costo + "'] span").text();
            $("#BtnCentriCostoNuovaAnagrafica_Risorsa .lampeggiante").text(nuovaRisorsa + " (" + descr.trim() + ")");
            $("#<%= master.lblDescrGeneric_ClientID %>").text(descr);
        }


        function tabCosti_FiltraPerCentroDiCosto(id_costo) {

            var grid = $("#kendo_CostiAccessori").data("kendoGrid");

            var filtro = new Array();
            if (id_costo == -4 || id_costo == -3 || id_costo == -2) {
                filtro.push({
                    field: "Centro_Cod",
                    operator: "eq",
                    value: -2
                });
                filtro.push({
                    field: "Centro_Cod",
                    operator: "eq",
                    value: -3
                });
                filtro.push({
                    field: "Centro_Cod",
                    operator: "eq",
                    value: -4
                });
            } else {
                filtro.push({
                    field: "Centro_Cod",
                    operator: "eq",
                    value: id_costo
                });
            }

            filtro.push({
                field: "Centro_Cod",
                operator: "eq",
                value: 0
            });

            grid.dataSource.filter({ filters: filtro, logic: "or" });

            grid.refresh();
        }



        function TabCosti_NascondiColonne(id_costo) {

            var Col_Attivita = kendo_indiceColonna_DatoNomeCampo("#kendo_CostiAccessori", "Id_attivita");
            var Col_Turno = kendo_indiceColonna_DatoNomeCampo("#kendo_CostiAccessori", "Turno_Cod");

            //var AggiustaColonne = true;

            switch (id_costo) {
                case Enum_CentriDiCosto.Macchine.value:
                    kendo_CostiAccessori.data("kendoGrid").hideColumn(Col_Attivita);
                    kendo_CostiAccessori.data("kendoGrid").hideColumn(Col_Turno);
                    break;

                case Enum_CentriDiCosto.Manodopera.value:
                    kendo_CostiAccessori.data("kendoGrid").showColumn(Col_Attivita);
                    kendo_CostiAccessori.data("kendoGrid").showColumn(Col_Turno);
                    break;

                default:
                    //AggiustaColonne = false;        
                    break;

            }

            //if (AggiustaColonne)
            //    kendo_AggiustaDimensioneColonne("#kendo_CostiAccessori");


        }


        function TabCosti_click(id_costo) {

            //gestione del cambio nella griglia kendo
            tabCosti_FiltraPerCentroDiCosto(id_costo);
            TabCosti_NascondiColonne(id_costo);

            //descrizione del pulsante per aprire la maschera di inserimento di una nuova risorsa
            tabCosti_ImpostaDescrizione(id_costo);

            //aggiorno il controllo hiddne con supporto per anagrafiche combo
            tabCosti_onClick(id_costo);
        }


        async function inizializzazionePulsanteSalvataggio() {

            var lavcod = $('.ComboOperazioni').val();

            if (objParametriAgenda_TipoOperazioneAgenda === 3) { //ricetta || brogliaccio

                if ((window.location.search.indexOf("?r=") !== -1 || window.location.search.indexOf("&r=") !== -1) && objParametriAgenda_TipoRicetta !== 9) { //Escludo il PUA dove la testata della ricetta esiste già
                    $("#divSalvaOpzioni").hide();
                    //$("#divSalvaNuovo").hide();
                    $("#divSalvaDuplica").hide();

                    $("#divAggiungiDettaglioRicetta").hide();
                    $("#divSalva").removeClass("col-lg-8").addClass("col-lg-12");
                }

                $("#apri_pannello_ricette").hide();
                $("#divSalvaCDG").hide();

            }



            if (objParametriAgenda_VisualizzaSoloBottoneSalvaEsci === true) { //ricetta || brogliaccio

                $("#divSalvaOpzioni").hide();
                $("#divSalvaNuovo").hide();
                $("#divSalvaDuplica").hide();

                $("#divSalva").removeClass("col-lg-8").addClass("col-lg-12");

                $("#apri_pannello_ricette").hide();
                $("#divSalvaCDG").hide();

            }

            switch (objParametriAgenda_TipoOperazione) {


                case Enum_TipoOperazione.Scrittura.value:

                    if (objParametriAgenda_TipoOperazioneAgenda === 2 && (lav_cod_ricettabili.indexOf(parseInt(lavcod)) >= 0)) { //ricetta + operazione ricettabile

                        $("#divSalvaOpzioni").hide();
                        $("#divSalva").hide();
                        $("#divSalvaNuovo").hide();
                        $("#divSalvaDuplica").hide();

                        $("#divSalvaRicetta").show();
                        $("#divSalvaNuovaRicetta").show();
                        $("#divAggiungiDettaglioRicetta").show();
                        if (objParametriAgenda_TipoRicetta !== 9) {
                            $("#divTestataRicetta").show();
                        }
                        if (ricetta_cod !== "0") {
                            var ricettaJSON = await caricaTestataRicetta(ricetta_cod);
                            popolaTestataRicetta(ricettaJSON);
                        }
                        popolaMenuRicette();
                        $("#menuRicette").kendoMenu();
                        $("#divRicetteSalvaEVai").show();

                    } else {

                        $("#divSalvaRicetta").hide();
                        $("#divSalvaNuovaRicetta").hide();
                        $("#divAggiungiDettaglioRicetta").hide();
                        $("#divTestataRicetta").hide();
                        $("#divRicetteSalvaEVai").hide();

                    }


                    //if ((window.location.search.indexOf("?r=") !== -1 || window.location.search.indexOf("&r=") !== -1) && objParametriAgenda_TipoRicetta !== 9) { //Escludo il PUA dove la testata della ricetta esiste già
                    //    $("#divSalvaOpzioni").hide();
                    //    //$("#divSalvaNuovo").hide();
                    //    $("#divSalvaDuplica").hide();

                    //    $("#divSalva").removeClass("col-lg-8").addClass("col-lg-12");
                    //}
                    break;

                case Enum_TipoOperazione.Lettura.value:

                    $("#divSalva").hide();
                    $("#divSalvaOpzioni").hide();
                    $("#divSalvaNuovo").hide();
                    $("#divSalvaDuplica").hide();
                    $("#divSalvaCDG").hide();

                    $("#divSalvaRicetta").hide();
                    $("#divSalvaNuovaRicetta").hide();
                    $("#divAggiungiDettaglioRicetta").hide();

                    $("#divAggiungiDettaglioRicetta").hide();
                    $("#apri_pannello_ricette").hide();
                    break;

                case Enum_TipoOperazione.Modifica.value:

                    $("#divSalvaOpzioni").hide();
                    $("#divSalvaNuovo").hide();
                    $("#divSalvaDuplica").hide();

                    $("#divSalva").removeClass("col-lg-8").addClass("col-lg-12");

                    $("#divSalvaRicetta").hide();
                    $("#divSalvaNuovaRicetta").hide();
                    $("#divAggiungiDettaglioRicetta").hide();
                    $("#divTestataRicetta").hide();

                    if (objParametriAgenda_TipoOperazioneAgenda === 2) { //ricetta
                        $("#divSalva").hide();
                        $("#divSalvaRicetta").show();
                        $("#divSalvaRicetta").removeClass("col-lg-4").addClass("col-lg-12");
                        if (objParametriAgenda_TipoRicetta !== 9) {
                            $("#divTestataRicetta").show();
                        }
                        var ricettaJSON = await caricaTestataRicetta(ricetta_cod);
                        popolaTestataRicetta(ricettaJSON);

                        popolaMenuRicette();
                        $("#menuRicette").kendoMenu();
                        $("#divRicetteSalvaEVai").show();
                    }

                    break;

                default:
                    console.log("inizializzazionePulsanteSalvataggio, default...");

            }

        }

        $(document).on('click', '#<%=ImgBtn_Carico_div.ClientID %>', function () {
            $('#<%=ImgBtn_Carico.ClientID %>').click();
        });

        $(document).on('click', '#<%=ImgBtn_CheckDPI_div.ClientID %>', function () {
            $('#<%=ImgBtn_CheckDPI.ClientID %>').click();
        });

        $(document).on('click', '#<%=ImgBtn_DoseConsigliataDettaglio_div.ClientID %>', function () {
            $('#<%=ImgBtn_DoseConsigliataDettaglio.ClientID %>').click();
        });

        $(document).on('click', '#<%=ImgBtn_DoseConsigliata_div.ClientID %>', function () {
            $('#<%=ImgBtn_DoseConsigliata.ClientID %>').click();
        });

        $(document).on('click', '#<%=ImgBtn_Carico_Eff_div.ClientID %>', function () {
            $('#<%=ImgBtn_Carico_Eff.ClientID %>').click();
        });

        async function popolaMenuRicette() {
            let resp = await caricaRicetteOperazioni(ricetta_cod, ricetta_operazione_cod);
            $("#ulMenuRicette").html('');
            for (let i = 0; i < resp.length; i++) {
                if (!(resp[i].ribaltata == true)) {
                    let elem = "<li class='btn-success' onClick=\"BottoneSalvaRicetta(" + resp[i].tipo + ", " + resp[i].Ricetta_Cod + ", " + resp[i].Ricetta_Operazione_Cod + ",'" + resp[i].data + "')\">";
                    elem += resp[i].des;
                    elem += "</li>";
                    $("#ulMenuRicette").append(elem);
                } else {
                    let elem = "<li class='btn btn-secondary' disabled>";
                    elem += '<i class="fa fa-times-circle" style="color:red;"></i>' + resp[i].des;
                    elem += "</li>";
                    $("#ulMenuRicette").append(elem);
                }

            }
        }

        function caricaRicetteOperazioni(ricetta_cod, ricetta_operazione_cod) {
            return new Promise((resolve, reject) => {
                let ricetta_cod_appoggio = ricetta_cod
                let ricetta_operazione_cod_appoggio = 0
                if ($.isNumeric(ricetta_operazione_cod)) {
                    ricetta_operazione_cod_appoggio = ricetta_operazione_cod
                }
                var parametri = kendo.stringify({
                    ricetta_cod: ricetta_cod_appoggio,
                    ricetta_operazione_cod: ricetta_operazione_cod_appoggio
                });

                ajaxAgronica("Trattamenti_2.aspx/caricaRicetteOperazioni",
                    parametri,
                    function (risposta) {
                        resolve(JSON.parse(risposta.RispostaStringa));
                    }, null, null, false);
            });
        }

    </script>



    <script type="text/javascript">

        //Eventi m$ ajax

        function BeginRequestHandler() {
            try {
                WaitFrame.show();
            } catch (e) {
                console.error("Eccezione su BeginRequestHandler");
            }

        }

        var inizializzazioneKendo_Eseguita = false;
        var inizializzazioneKendo_CostiAccessori_Eseguita = false;
        var inizializzazioneKendo_TabCosti_Eseguita = false;


        function inizializzazioneKendo_TabCosti() {
            if (!inizializzazioneKendo_TabCosti_Eseguita) {
                //TabCosti_click( parseInt ( $("#tabs_kendo_CostiAccessori .active").attr("data-idcosto") ) );
                //filtro per il valore corrispondente al primo tab "macchine"..   
                inizializzazioneKendo_TabCosti_Eseguita = true;
                delay_KeyUp(function () {
                    $(id_hdKendo_CostiAccessori_ComboHelper_Comando).val("-1");
                    tabCosti_FiltraPerCentroDiCosto(-1);
                    TabCosti_NascondiColonne(-1);
                    tabCosti_ImpostaDescrizione(-1);
                }, 1800);
            }

        }

        function CentriCostoNuovaAnagrafica_Risorsa() {
            $("#<%=btnApriContattiCosti.ClientID %>").click();
        }


        function inizializzazioneKendo_CostiAccessori() {

            if ($("#<%=hdKendo_CostiAccessori_Ricarica.ClientID %>").val() == "profiloOk") {
                MessaggioTuttoOK_Bootstrap("Profilo memorizzato correttamente", "DIV_Messaggi");
            }


            if ($("#<%=hdKendo_CostiAccessori_Ricarica.clientID %>").val() == "profiloNo") {
                MessaggioErrore_Bootstrap("Errore memorizzazione profilo", "DIV_Messaggi");
            }



            console.log("kendo_costiAccessori chiamato da EndRequestHandler");

            kendoCostiAccessori("kendo_CostiAccessori");

            if ($("#<%=hdKendo_CostiAccessori_Ricarica.ClientID %>").val() == "ricarica") {

                if (!inizializzazioneKendo_CostiAccessori_Eseguita) {

                    kDirtyAll("#kendo_CostiAccessori");

                    kAggiornaCostiAccessori();

                    inizializzazioneKendo_CostiAccessori_Eseguita = true;
                }


                $("#BtnCentriCostoProfilazione").click(function () {
                    //SalvaAccessoriDefault();
                    return false;
                });

                $("#BtnCentriCostoNuovaAnagrafica_Risorsa").click(function () {

                    ////Disattivo la selezione, così poi ricarica la dropdown
                    //var grid = $("#kendo_CostiAccessori").data('kendoGrid');
                    //grid.closeCell();

                    //CentriCostoNuovaAnagrafica_Risorsa();
                    //return false;
                });

            }

            var v1 = $("#<%=hdKendo_CostiAccessori_ComboHelper_Comando_Dati.clientID %>").val();
            if (v1.toString().indexOf("Chiudi") > -1) {

                var vv = v1.split(":")[1];

                var datiGriglia = $("#kendo_CostiAccessori").data('kendoGrid').dataSource.data();
                var ricaricaRichiesto = false;
                for (var i = 0; i < datiGriglia.length; i++) {
                    if (datiGriglia[i].Risorsa_Cod == vv) {
                        datiGriglia[i].Risorsa_Des = $("#<%= hdKendo_CostiAccessori_ComboHelper_NuovoValore.clientid %>").val();
                        datiGriglia[i].dirty = true;
                        ricaricaRichiesto = true;
                    }
                }

                if (ricaricaRichiesto) {
                    kendoRefresh("#kendo_CostiAccessori");
                }

                //' VAnni: 11/4/2017: chiudo il cerchio, imposto a stringa vuota i dati.
                $("#<%=hdKendo_CostiAccessori_ComboHelper_Comando_Dati.clientID %>").val("");

            }

            let idTab = $(id_hdKendo_CostiAccessori_ComboHelper_Comando).val();
            tabCosti_FiltraPerCentroDiCosto(idTab);
            TabCosti_NascondiColonne(idTab);
            tabCosti_ImpostaDescrizione(idTab);
            switch (idTab) {
                case "-2":
                    $("#costi_Manodopera").addClass("active")
                    $("#costi_Macchine").removeClass("active")
                    break;
                case "-1":
                    $("#costi_Manodopera").removeClass("active")
                    $("#costi_Macchine").addClass("active")
                    break;
                default:
                    $("#costi_Manodopera").removeClass("active")
                    $("#costi_Macchine").addClass("active")
                    break;
            }


            if ($("#<%=hdPageLoadFirst.ClientID %>").val() == "true") {
                if ($("#kendo_CostiAccessori").data('kendoGrid').dataSource.data().length > 0) {
                    MacchinaInserita();
                } else {
                    $("#tabs_kendo_CostiAccessori").hide();
                    $("#kendo_CostiAccessori").hide();
                    $("#aCostiAccessori").removeClass("fa fa-minus-circle");
                    $("#aCostiAccessori").addClass("fa fa-plus-circle");
                }
                $("#<%=hdPageLoadFirst.ClientID %>").val("false");
            }

            //' VAnni: 16/2/2017: Spengo i pulsanti annulla e salva ... il tutto viene gestito da javascript..
            $("#kendo_CostiAccessori .k-grid-save-changes").hide();
            $("#kendo_CostiAccessori .k-grid-cancel-changes").hide();

            $("#<%=hdKendo_CostiAccessori_Ricarica.clientID %>").val("");

        }

        function nuovaRisorsa() {
            var grid = $("#kendo_CostiAccessori").data('kendoGrid');
            grid.closeCell();

            CentriCostoNuovaAnagrafica_Risorsa();
            return false;
        }

        function Risorsa_Edit(tr_elem, grid_elem) {

            var datiGriglia = $(grid_elem).data('kendoGrid');
            var datiRiga = datiGriglia.dataItem(tr_elem);
            var data = datiRiga.Risorsa_Cod;

            $("#<%=hdKendo_CostiAccessori_ComboHelper_Comando_Dati.clientID%>").val(
                "Apri:" + data
            );

            CentriCostoNuovaAnagrafica_Risorsa();
            return false;
        }

        function inizializzazioneKendo_BufferZone() {

            var buffer_min = 0;
            var buffer_max = 0;
            var buffer_min_tmp = 0;
            var buffer_max_tmp = 0;
            var buffer_da_controllare = 0;
            var lunghezza = 0;
            var distanzaprimapianta = 0;
            var percAbb = 0; 
            var ricalcoliEffettuati = false;

            // ******************************************************************************************************
            // CALCOLI PER BUFFER ZONE
            // ******************************************************************************************************
            if (typeof id_HD_Buffer_Min !== 'undefined') {
                if ($('#' + id_HD_Buffer_Min).val() != "") {
                    buffer_min = parseFloat($('#' + id_HD_Buffer_Min).val().toString().replace(",", "."));
                }
                if ($('#' + id_HD_Buffer_Max).val() != "") {
                    buffer_max = parseFloat($('#' + id_HD_Buffer_Max).val().toString().replace(",", "."));
                }

                if ($('#' + id_HD_Buffer_Min_Tmp).val() != "") {
                    buffer_min_tmp = parseFloat($('#' + id_HD_Buffer_Min_Tmp).val().toString().replace(",", ".")); 
                }
                if ($('#' + id_HD_Buffer_Max_Tmp).val() != "") {                   
                    buffer_max_tmp = parseFloat($('#' + id_HD_Buffer_Max_Tmp).val().toString().replace(",", "."));
                }
            }
            //seleziono la distanza massima delle minime e la massima delle massime
            if (buffer_min_tmp > buffer_min) {
                buffer_min = buffer_min_tmp;
            }
            if (buffer_max_tmp > buffer_max) {
                buffer_max = buffer_max_tmp;
            }

            if (!(buffer_min == 0 && buffer_max == 0)) {

                buffer_da_controllare = buffer_min;
                //if (buffer_min != 0 && buffer_max == 0) {
                //    buffer_da_controllare = buffer_min;
                //}
                //else {
                //    buffer_da_controllare = buffer_max;
                //}

                if (buffer_da_controllare != 0) {

                    var griglia = $("#kendo_impianti").data('kendoGrid');
                    var datiGriglia = griglia.dataSource.data();

                    for (var i = 0; i < datiGriglia.length; i++) {

                        lunghezza = datiGriglia[i].DistBZ_Allevamenti + datiGriglia[i].DistBZ_AreeResPub + datiGriglia[i].DistBZ_CorpiIdrici + datiGriglia[i].DistBZ_VegNatNonColt;
                        distanzaprimapianta = datiGriglia[i].SupBZ_Riduzione;

                        if ((lunghezza > 0) && (datiGriglia[i].Selected == true)) {

                            if ((lunghezza * parseFloat((buffer_da_controllare - distanzaprimapianta) - ((buffer_da_controllare - distanzaprimapianta) * parseFloat(datiGriglia[i].Perc_Riduzione_Deriva) / 100)) / 10000) < 0) {
                                datiGriglia[i].Sup_Riduzione_BufferZone = 0;
                            }
                            else {
                                if (datiGriglia[i].Sup_Riduzione_BufferZone < lunghezza * parseFloat((buffer_da_controllare - distanzaprimapianta) - ((buffer_da_controllare - distanzaprimapianta) * parseFloat(datiGriglia[i].Perc_Riduzione_Deriva) / 100)) / 10000) {
                                    datiGriglia[i].Sup_Riduzione_BufferZone = lunghezza * parseFloat((buffer_da_controllare - distanzaprimapianta) - ((buffer_da_controllare - distanzaprimapianta) * parseFloat(datiGriglia[i].Perc_Riduzione_Deriva) / 100)) / 10000;
                                }
                            }

                            if (datiGriglia[i].Selected) {
                                if ((datiGriglia[i].Sup_Imp - datiGriglia[i].Sup_Riduzione_BufferZone) < 0) {
                                    datiGriglia[i].Sup_Imp_help = 0;
                                }
                                else {
                                    if (datiGriglia[i].Sup_Imp_help > roundNumber((datiGriglia[i].Sup_Imp - datiGriglia[i].Sup_Riduzione_BufferZone), 4)) {
                                        datiGriglia[i].Sup_Imp_help = roundNumber((datiGriglia[i].Sup_Imp - datiGriglia[i].Sup_Riduzione_BufferZone), 4);
                                    }
                                }
                            }
                        }
                    }

                    ricalcoliEffettuati = true;

                }

            }

            // ******************************************************************************************************
            // CALCOLI PER PERCENTUALE ABBATTIMENTO
            // ******************************************************************************************************
            if (typeof id_HD_Perc_Abb_Min !== 'undefined') {
                if ($('#' + id_HD_Perc_Abb_Min).val() != "") {
                    percAbb = parseFloat($('#' + id_HD_Perc_Abb_Min).val().toString().replace(",", "."));
                }
            }

            if (percAbb != 0)
            {
                var supImpianto = 0;
                var supTrattata = 0;
                var supTrattabile = 0;

                var griglia = $("#kendo_impianti").data('kendoGrid');
                var datiGriglia = griglia.dataSource.data();

                for (var i = 0; i < datiGriglia.length; i++)
                {

                    if (datiGriglia[i].Selected) {
                        var supImpianto = kendo.parseFloat(datiGriglia[i].Sup_Imp);
                        var supTrattata = kendo.parseFloat(datiGriglia[i].Sup_Imp_help);
                        var supTrattabile = roundNumber(supImpianto * percAbb / 100 , 4)

                        if (supTrattabile < supTrattata)
                            datiGriglia[i].Sup_Imp_help = supTrattabile;

                    }
                }
                ricalcoliEffettuati = true;
            }

            if (ricalcoliEffettuati) {
                kendoRefresh("#kendo_impianti");
                RicalcolaSuperficieCoinvolta(true);
                Aggiorna_hdKendo_Impianti_Selezione();
                AggiornaDopo_SupTrattata();
                AggiornaCostiAdEttaro();
            }
        }


        function inizializzazioneKendo() {
            if ($("#<%=hdKendo_Impianti_Ricarica.ClientID %>").val() == "colonne") {
                kendoAppezzamenti_Colonne();
            }

            if ($("#<%=hdKendo_Impianti_Ricarica.clientID %>").val() == "ricarica") {

                console.log("kendo_impianti chiamato da EndRequestHandler");

                kendoAppezzamenti("kendo_impianti");
                kendoAppezzamenti_Colonne();
                kendoAppezzamenti_RipristinaSelezionati();

                //inizializzazioneKendo_BufferZone();

                $("#BtnFiltraColonne").click(function () {
                    //console.log("Toolbar template1 command is clicked!");
                    //$('#dialogImpostazioniColonne').modal('show');
                    //return false;
                });


            } else {
                inizializzazioneKendo_BufferZone();
            }

            $("#<%=hdKendo_Impianti_Ricarica.ClientID %>").val("");


        }

        function filtraColonne() {
            console.log("Toolbar template1 command is clicked!");
            $('#dialogImpostazioniColonne').modal('show');
            return false;
        }

        function pageLoadedHandler() {
            try {
                WaitFrame.show();
            } catch (e) {
                console.error("Eccezione su EndRequestHandler");
            }

            //inizializzazioneKendo_CostiAccessori_Eseguita = false;
            //inizializzazioneKendo_TabCosti_Eseguita = false;
            console.log("Ricky");
            $("#kendo_impianti").removeClass("dpiOff");
            inizializzazioneKendo();
            inizializzazioneKendo_CostiAccessori();
            if (typeof this.InizializzazioneControlliPagina !== "undefined") {
                InizializzazioneControlliPagina();
            }
            console.log("Marco");

            try {
                WaitFrame.hide();
            } catch (e) {
                console.error("Eccezione su EndRequestHandler");
            }
        }

        function EndRequestHandler() {

            ////' VAni: 14/4/2017: ritardo l'esecuzione per dare il tempo al framework m$ di caricare la pagina e sbloccare il browser.
