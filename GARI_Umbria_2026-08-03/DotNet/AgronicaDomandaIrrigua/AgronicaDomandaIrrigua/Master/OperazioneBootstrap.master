        }

        function onEditKendo_CostiAccessori(e) {

            if ((e.bypass && e.bypass === 'Qta_Ril') || kendo_fieldName_digitato(e) == "Qta_Ril") {
                var grid = kendo_CostiAccessori.data("kendoGrid")
                var dataItem = grid.dataSource.getByUid(e.model.uid)

                e.values.Qta_Ril = e.values.Qta_Ril.toString().replace(",", ".")
                var costoTot = parseFloat(dataItem.Costo_Unitario.toString().replace(",", ".")) * e.values.Qta_Ril;

                if (dataItem.Qta_Ril != e.values.Qta_Ril) {
                    kendo_imposta_valore(dataItem, "Costo", costoTot, "n2");
                }
            }
            else if (kendo_fieldName_digitato(e) == "Costo_Unitario") {
                var grid = kendo_CostiAccessori.data("kendoGrid")
                var dataItem = grid.dataSource.getByUid(e.model.uid)

                e.values.Costo_Unitario = e.values.Costo_Unitario.toString().replace(",", ".")
                var costoTot = parseFloat(dataItem.Qta_Ril.toString().replace(",", ".")) * e.values.Costo_Unitario;

                if (dataItem.Costo_Unitario != e.values.Costo_Unitario) {
                    kendo_imposta_valore(dataItem, "Costo", costoTot, "n2");
                }
                if (dataItem.Costo_Unitario != e.values.Costo_Unitario) {
                    //kendo_imposta_valore(dataItem, "Costo_Unitario", e.values.Costo_Unitario, "n2");
                    dataItem.Costo_Unitario = e.values.Costo_Unitario
                }
                MacchinaInserita();
            }
            else if (kendo_fieldName_digitato(e) == "Udm_Cod") {
                var grid = kendo_CostiAccessori.data("kendoGrid")
                var dataItem = grid.dataSource.getByUid(e.model.uid)

                if (dataItem.Udm_Cod != e.values.Udm_Cod) {
                    kendo_imposta_valore(dataItem, "Udm_Cod", e.values.Udm_Cod, "n2");
                }

                MacchinaInserita();
            } else {
                try {
                    let field = kendo_fieldName_digitato(e);
                    dataItem[field] = e.values[field];
                } catch (e) {

                }
                MacchinaInserita();
            }

            tabCosti_impostaTabCorrente_Modificata(e);

            //MacchinaInserita();

        }

        function onEditKendoSup_Coinvolta(e) {

            var sup_imp = parseFloat(e.sender._editContainer.parent().find('.Sup_Imp').html().replace(",", "."));
            var sup_rid = 0;
            var perc_mitig = 0;
            var buffer_min = 0;
            var buffer_max = 0;
            var buffer_min_tmp = 0;
            var buffer_max_tmp = 0;
            var buffer_da_controllare = 0;
            var lunghezza = 0;
            var distanzaprimapianta = 0;
            var percAbb = 0;
            var sup_trattata = 0;

            if (typeof id_HD_Buffer_Min !== 'undefined') {
                if ($('#' + id_HD_Buffer_Min).val() != "") {
                    buffer_min = parseFloat($('#' + id_HD_Buffer_Min).val().toString().replace(",", "."));
                }
                if ($('#' + id_HD_Buffer_Max).val() != "") {
                    buffer_max = parseFloat($('#' + id_HD_Buffer_Max).val().toString().replace(",", "."));
                }

                if ($('#' + id_HD_Buffer_Min_Tmp).val() != "") {
                    buffer_min_tmp = parseFloat($('#' + id_HD_Buffer_Min_Tmp).val().toString().replace(",", "."));
                }
                if ($('#' + id_HD_Buffer_Max_Tmp).val() != "") {
                    buffer_max_tmp = parseFloat($('#' + id_HD_Buffer_Max_Tmp).val().toString().replace(",", "."));
                }
            }

            //seleziono la distanza massima delle minime e la massima delle massime
            if (buffer_min_tmp > buffer_min) {
                buffer_min = buffer_min_tmp;
            }
            if (buffer_max_tmp > buffer_max) {
                buffer_max = buffer_max_tmp;
            }

            if (!(buffer_min == 0 && buffer_max == 0)) {
                buffer_da_controllare = buffer_min;
            }

            var grid = $("#kendo_impianti").data("kendoGrid");
            var dataItem = grid.dataSource.getByUid(e.model.uid);

            var sup_riducibile = 0;
            var sup_massima_trattabile = sup_imp;

            lunghezza = parseFloat(dataItem.DistBZ_Allevamenti) + parseFloat(dataItem.DistBZ_AreeResPub) + parseFloat(dataItem.DistBZ_CorpiIdrici) + parseFloat(dataItem.DistBZ_VegNatNonColt);

            //se c'è una buffer calcolo la sup massima trattabile e riducibile
            if (lunghezza > 0) {

                distanzaprimapianta = parseFloat(dataItem.SupBZ_Riduzione);

                if (kendo_fieldName_digitato(e) == "Perc_Riduzione_Deriva") {
                    e.values.Perc_Riduzione_Deriva = e.values.Perc_Riduzione_Deriva.toString().replace(",", ".");
                    e.model.Perc_Riduzione_Deriva = e.values.Perc_Riduzione_Deriva;
                    perc_mitig = parseFloat(e.values.Perc_Riduzione_Deriva);
                } else {
                    perc_mitig = parseFloat(dataItem.Perc_Riduzione_Deriva);
                }

                buffer_da_controllare = (buffer_da_controllare - distanzaprimapianta) - ((buffer_da_controllare - distanzaprimapianta) * perc_mitig / 100);

                if ((lunghezza * buffer_da_controllare / 10000) < 0) {
                    sup_riducibile = 0;
                } else {
                    sup_riducibile = lunghezza * buffer_da_controllare / 10000;
                }

                sup_massima_trattabile = sup_imp - parseFloat(sup_riducibile);

            }


            if (typeof id_HD_Perc_Abb_Min !== 'undefined') {
                if ($('#' + id_HD_Perc_Abb_Min).val() != "") {
                    percAbb = parseFloat($('#' + id_HD_Perc_Abb_Min).val().toString().replace(",", "."));
                }
            }

            //sto editando la sup trattata
            if (kendo_fieldName_digitato(e) == "Sup_Imp_help") {

                e.values.Sup_Imp_help = e.values.Sup_Imp_help.toString().replace(",", ".");
                e.model.Sup_Imp_help = e.values.Sup_Imp_help;

                //se ho la buffer verifico che stia nel range
                if ((dataItem.Selected == true) && (lunghezza > 0) && (!(buffer_min == 0 && buffer_max == 0))) {

                    sup_trattata = parseFloat(e.values.Sup_Imp_help);

                    if (sup_trattata > sup_massima_trattabile) {
                        alert('ATTENZIONE! Buffer Zone non rispettata. Ridurre la superficie trattata!');
                    }

                    //cambio la sup riduzione
                    if ((sup_imp - sup_trattata) < 0) {
                        e.model.Sup_Riduzione_BufferZone = 0;
                        e.values.Sup_Riduzione_BufferZone = 0;
                    }
                    else {
                        if (percAbb === 0) {
                            e.model.Sup_Riduzione_BufferZone = roundNumber((sup_imp - sup_trattata), 4);
                            e.values.Sup_Riduzione_BufferZone = e.model.Sup_Riduzione_BufferZone;
                        }
                    }
                }

            }

            //sto editando la sup riduzione
            if (kendo_fieldName_digitato(e) == "Sup_Riduzione_BufferZone") {

                e.values.Sup_Riduzione_BufferZone = e.values.Sup_Riduzione_BufferZone.toString().replace(",", ".");
                e.model.Sup_Riduzione_BufferZone = e.values.Sup_Riduzione_BufferZone;

                //if (dataItem.Selected) {
                //    sup_rid = parseFloat(e.values.Sup_Riduzione_BufferZone);
                //    if ((sup_imp - sup_rid) < 0) {
                //        e.model.Sup_Imp_help = 0;
                //        e.values.Sup_Imp_help = 0;
                //    }
                //    else {
                //        e.model.Sup_Imp_help = sup_imp - sup_rid;
                //        e.values.Sup_Imp_help = e.model.Sup_Imp_help;
                //    }
                //}

                //se ho la buffer verifico che stia nel range la sup ridotta
                if ((dataItem.Selected == true) && (lunghezza > 0) && (!(buffer_min == 0 && buffer_max == 0))) {

                    sup_rid = parseFloat(e.values.Sup_Riduzione_BufferZone);

                    if (sup_rid > sup_riducibile) {
                        alert('ATTENZIONE! Buffer Zone non rispettata. Aumentare la superficie di riduzione!');
                    }

                    //cambio la sup trattata
                    if ((sup_imp - sup_rid) < 0) {
                        e.model.Sup_Imp_help = 0;
                        e.values.Sup_Imp_help = 0;
                    }
                    else {
                        if (percAbb === 0) {
                            e.model.Sup_Imp_help = roundNumber((sup_imp - sup_rid), 4);
                            e.values.Sup_Imp_help = e.model.Sup_Imp_help;
                        }
                    }
                }

            }

            //sto editando la percentuale di riduzione deriva
            if (kendo_fieldName_digitato(e) == "Perc_Riduzione_Deriva") {

                e.values.Perc_Riduzione_Deriva = e.values.Perc_Riduzione_Deriva.toString().replace(",", ".");
                e.model.Perc_Riduzione_Deriva = e.values.Perc_Riduzione_Deriva;

                if ((dataItem.Selected == true) && (lunghezza > 0) && (!(buffer_min == 0 && buffer_max == 0))) {

                    sup_trattata = sup_massima_trattabile;
                    sup_rid = sup_riducibile;

                    // 2022-05-02 Commentato da Monti / Belmonte
                    //if (sup_rid > sup_riducibile) {
                    //        alert('ATTENZIONE! Buffer Zone non rispettata. Aumentare la superficie di riduzione!');
                    // }

                    //if (sup_trattata > sup_massima_trattabile) {
                    //    alert('ATTENZIONE! Buffer Zone non rispettata. Ridurre la superficie trattata!');
                    //}

                    //cambio la sup riduzione
                    if ((sup_imp - sup_trattata) < 0) {
                        e.model.Sup_Riduzione_BufferZone = 0;
                        e.values.Sup_Riduzione_BufferZone = 0;
                    }
                    else {
                        e.model.Sup_Riduzione_BufferZone = roundNumber((sup_imp - sup_trattata), 4);
                        e.values.Sup_Riduzione_BufferZone = e.model.Sup_Riduzione_BufferZone;
                    }

                    //cambio la sup trattata
                    if ((sup_imp - sup_rid) < 0) {
                        e.model.Sup_Imp_help = 0;
                        e.values.Sup_Imp_help = 0;
                    }
                    else {
                        if (percAbb === 0) {
                            e.model.Sup_Imp_help = roundNumber((sup_imp - sup_rid), 4);
                            e.values.Sup_Imp_help = e.model.Sup_Imp_help;
                        }
                    }

                }

                //perc_mitig = parseFloat(e.values.Perc_Riduzione_Deriva);

                //if (!(buffer_min == 0 && buffer_max == 0)) {

                //    if (buffer_min != 0 && buffer_max == 0) {
                //        buffer_da_controllare = buffer_min;
                //    }
                //    else {
                //        buffer_da_controllare = buffer_max;
                //    }

                //    if (buffer_da_controllare != 0) {

                //        distanzaprimapianta = parseFloat(dataItem.SupBZ_Riduzione);
                //        buffer_da_controllare = (buffer_da_controllare - distanzaprimapianta) - ((buffer_da_controllare - distanzaprimapianta) * perc_mitig / 100);
                //        lunghezza = parseFloat(dataItem.DistBZ_Allevamenti) + parseFloat(dataItem.DistBZ_AreeResPub) + parseFloat(dataItem.DistBZ_CorpiIdrici) + parseFloat(dataItem.DistBZ_VegNatNonColt);

                //        if (lunghezza > 0) {
                //            if ((lunghezza * buffer_da_controllare / 10000) < 0) {
                //                sup_rid = 0;
                //            }
                //            else {
                //                sup_rid = lunghezza * buffer_da_controllare / 10000;
                //            }
                //            e.model.Sup_Riduzione_BufferZone = sup_rid;
                //            e.values.Sup_Riduzione_BufferZone = sup_rid;
                //            if (dataItem.Selected) {
                //                if ((sup_imp - sup_rid) < 0) {
                //                    e.model.Sup_Imp_help = 0;
                //                    e.values.Sup_Imp_help = 0;
                //                }
                //                else {
                //                    e.model.Sup_Imp_help = sup_imp - sup_rid;
                //                    e.values.Sup_Imp_help = e.model.Sup_Imp_help;
                //                }
                //            }

                //        }

                //    }

                //}


            }

            // ******************************************************************************************************
            // CALCOLI PER PERCENTUALE ABBATTIMENTO
            // ******************************************************************************************************
           
            if (percAbb != 0) {
                var supImpianto = 0;
                var supTrattata2 = 0;
                var supTrattabile = 0;
                
                if (dataItem.Selected) {
                    var supImpianto = kendo.parseFloat(dataItem.Sup_Imp);
                    var supTrattata2 = kendo.parseFloat(dataItem.Sup_Imp_help);
                    var supTrattabile = roundNumber(supImpianto * percAbb / 100, 4)

                    if (supTrattabile < supTrattata2) {
                        dataItem.Sup_Imp_help = supTrattabile;
                        e.model.Sup_Imp_help = supTrattabile;
                        e.values.Sup_Imp_help = e.model.Sup_Imp_help;
                        var messaggioPercAbb = "Attenzione! I prodotti selezionati possono essere impiegati al massimo sul " + percAbb + "% della superficie per il disciplinare.";
                        alert(messaggioPercAbb);
                        e.preventDefault();
                    }

                }
            }

            if (parseFloat(dataItem.Sup_Imp_help) <= sup_imp) {

                kendoRefresh("#kendo_impianti");
                kEventoSelezionaRiga_Sup_Coninvolta = 0;

                //calcoli finali ..
                RicalcolaSuperficieTotale();
                RicalcolaSuperficieCoinvolta(true);
                Aggiorna_hdKendo_Impianti_Selezione(e);
                AggiornaDopo_SupTrattata();
                AggiornaCostiAdEttaro();

            } else {

                MessaggioErrore("<%=MsgSupImpiego.Replace("""", "\""") %>");
                e.preventDefault();

            }

        }


        //prima di selezionare tutte le righe, disabilito i calcoli finali, per prevenire azioni di postback su ciascuna riga selezionata..
        function kSelectAllRows_Pre(ev) {
            Esegui_CalcoliFinali = false;
        }

        //dopo aver selezionato tutte le righe eseguo i calcoli necessari
        function kSelectAllRows_Post(ev) {

            kendoRefresh("#kendo_impianti");

            RicalcolaSuperficieTotale();
            RicalcolaSuperficieCoinvolta(true);
            Aggiorna_hdKendo_Impianti_Selezione();
            AggiornaDopo_SupTrattata();
            AggiornaCostiAdEttaro();

            Abilita_Disabilita_Resto();

            Esegui_CalcoliFinali = true;
        }

        //var checkedIds = {};
        var colona_Sup_imp = "12";

        var kEventoSelezionaRiga_Sup_Coninvolta = 0;
        var Esegui_CalcoliFinali = true;

        function kEventoSelezionaRiga(e) {

            var checked = this.checked,
                row = $(this).parents("tr"),
                grid = $("#kendo_impianti").data("kendoGrid"),
                dataItem = grid.dataItem(row);

            dataItem.Selected = checked;

            if (checked) {
                //-select the row
                row.addClass(GIAS_K_STATE_SELECTED);

                //se diverso da zero, vuol dire che esiste una superficie che arriva dalla lettura dei dati lato server.
                if (kEventoSelezionaRiga_Sup_Coninvolta != 0) {

                    Sup_Imp_help_Format = kEventoSelezionaRiga_Sup_Coninvolta.toString().replace(",", ".");
                    dataItem.Sup_Imp_help = kEventoSelezionaRiga_Sup_Coninvolta;
                    kEventoSelezionaRiga_Sup_Coninvolta = 0;

                } else {

                    Sup_Imp_help_Format = kendo.toString(dataItem.Sup_Imp_help, "n4").replace(",", ".");
                    //aggiunto controllo riduzione
                    if ((dataItem.Sup_Imp - dataItem.Sup_Riduzione_BufferZone) < 0) {
                        dataItem.Sup_Imp_help = 0;
                    }
                    else {
                        dataItem.Sup_Imp_help = dataItem.Sup_Imp - dataItem.Sup_Riduzione_BufferZone;
                    }
                    if (Esegui_CalcoliFinali)
                        kendoRefresh("#kendo_impianti");

                }

            } else {
                //-remove selection
                row.removeClass(GIAS_K_STATE_SELECTED);

                dataItem.Sup_Imp_help = 0;
                if (Esegui_CalcoliFinali)
                    kendoRefresh("#kendo_impianti");

            }

            //informo che la riga è cambiata..
            dataItem.dirty = true;


            //calcoli finali ..
            if (Esegui_CalcoliFinali) {
                Abilita_Disabilita_Resto();
                RicalcolaSuperficieTotale();
                RicalcolaSuperficieCoinvolta(true);
                Aggiorna_hdKendo_Impianti_Selezione();
                AggiornaDopo_SupTrattata();
                AggiornaCostiAdEttaro();
            }

            //se è stata selezionata una riga arancione parte l'avviso
            if ((row.hasClass("dpiOn") == true) && (checked == true) && (MessaggioImpiantiVisualizzato == false)) {
                MessaggioImpiantiVisualizzato = true;
                alert('Attenzione! Sono stati selezionati impianti aventi un vincolo normativo più restittivo rispetto al filtro Disciplinare sopra selezionato! Proseguendo i filtri potrebbero essere non compatibili. Sarà comunque possibile controllare le conformità.');
            }

        }

        function CambiataSpecie() {
            MessaggioImpiantiVisualizzato = false;
        }


        //#Region "Fine Eventi Kendo"


        function evaluateNull(dato, valDefault) {
            if (dato === null || dato === undefined)
                return valDefault;
            else
                return dato;
        }

        function Aggiorna_hdKendo_CostiAccessori_Selezione() {

            var grid = $("#kendo_CostiAccessori").data("kendoGrid");
            var data = grid.dataSource.data();
            var finalData = new Array();

            for (var i = 0; i < data.length; i++) {

                var dataModel = data[i];
                if (dataModel.Risorsa_Cod != "") {
                    finalData.push(dataModel);
                }

            }

            $("#<%=hdKendo_CostiAccessori_Selezione.ClientID %>").val(JSON.stringify(finalData));

        }

        function Aggiorna_hdKendo_Impianti_Selezione(e) {

            var impiantiSelezionati = new Array();

            var grid = $("#kendo_impianti").data("kendoGrid");
            var data = grid.dataSource.data();
            var totalRows = data.length;
            var currentDataItem;

            var Superficie = 0;
            var Sup_Riduzione_BufferZone = 0;
            var Perc_Riduzione_Deriva = 0;

            var lavcod = $('.ComboOperazioni').val();
            var isSemina = false;

            switch (parseInt(lavcod)) {
                case 71: case 2: case 160: case 68:
                    isSemina = true;
                    break;
            }

            var frazionaSemina = false;
            $('.TipoSemina').children().children().each(function () {
                if ($(this).children().children('input').is(":checked") && $(this).children().children('input').val() === "50") {
                    frazionaSemina = true;
                }
            });

            var N_impianti = 0;
            for (var i = 0; i < totalRows; i++) {
                currentDataItem = data[i];
                if (currentDataItem.Selected) {
                    N_impianti += 1;
                }
            }




            for (var i = 0; i < totalRows; i++) {

                currentDataItem = data[i];

                if (e !== undefined) {

                    var leggiID;
                    if (e.model !== undefined)
                        leggiID = e.model.id;
                    else
                        leggiID = e.id;

                    var leggiVal;
                    if (e.values !== undefined)
                        leggiVal = e.values;
                    else
                        leggiVal = e;

                    if (leggiID == data[i].id) {
                        Superficie = leggiVal.Sup_Imp_help;
                        Sup_Riduzione_BufferZone = leggiVal.Sup_Riduzione_BufferZone;
                        Perc_Riduzione_Deriva = leggiVal.Perc_Riduzione_Deriva;
                    } else {
                        Superficie = currentDataItem.Sup_Imp_help;
                        Sup_Riduzione_BufferZone = currentDataItem.Sup_Riduzione_BufferZone;
                        Perc_Riduzione_Deriva = currentDataItem.Perc_Riduzione_Deriva;
                    }

                } else {

                    Superficie = currentDataItem.Sup_Imp_help;
                    Sup_Riduzione_BufferZone = currentDataItem.Sup_Riduzione_BufferZone;
                    Perc_Riduzione_Deriva = currentDataItem.Perc_Riduzione_Deriva;
                }


                if (currentDataItem.Selected) {

                    var chiaveSplit = currentDataItem.id.split("-");

                    var strcatasto = currentDataItem.Catasto.split("<br>");
                    var vettParticelle = [];
                    for (var p = 0; p < strcatasto.length; p++) {

                        if (strcatasto[p] != "") {
                            var particella = strcatasto[p].split("_");
                            var oparticella = {
                                Part_Cod: 0,
                                Provincia: particella[0],
                                Comune: particella[1],
                                Sezione: particella[2],
                                Foglio: particella[3],
                                Numero: particella[4],
                                Subalterno: particella[5]
                            }
                            vettParticelle.push(oparticella);
                        }
                    }


                    let vettClassiTessitura = [];
                    if (currentDataItem.Id_ClasseTessitura !== undefined && currentDataItem.Id_ClasseTessitura !== "") {
                        vettClassiTessitura = currentDataItem.Id_ClasseTessitura.split(",");
                    }


                    var ImpiantoSelezionato = {
                        Reale_Or_Planning: 1,
                        Programmazione_Entita_cod: 0,
                        Piva: chiaveSplit[0],
                        Sa_Cod: chiaveSplit[1],
                        Appezza: chiaveSplit[2],
                        Campo_Cod: evaluateNull(currentDataItem.Campo_Cod, 0),
                        ID_Reg: chiaveSplit[3],
                        App_Nome: evaluateNull(currentDataItem.App_Nome, ""),
                        Campo_Des: evaluateNull(currentDataItem.Campo_Des, ""),
                        Progetto_Cod: evaluateNull(currentDataItem.Progetto_Cod, 0),
                        Sup_Imp: evaluateNull(currentDataItem.Sup_Imp, 0),
                        Sup_Riduzione_BufferZone: evaluateNull(Sup_Riduzione_BufferZone, 0),
                        Perc_Riduzione_Deriva: evaluateNull(Perc_Riduzione_Deriva, 0),
                        DistBZ_CorpiIdrici: evaluateNull(currentDataItem.DistBZ_CorpiIdrici, 0),
                        DistBZ_AreeResPub: evaluateNull(currentDataItem.DistBZ_AreeResPub, 0),
                        DistBZ_Allevamenti: evaluateNull(currentDataItem.DistBZ_Allevamenti, 0),
                        DistBZ_VegNatNonColt: evaluateNull(currentDataItem.DistBZ_VegNatNonColt, 0),
                        SupBZ_Riduzione: evaluateNull(currentDataItem.SupBZ_Riduzione, 0),
                        Validita_Inizio_Distinta: evaluateNull(currentDataItem.Validita_Inizio_Distinta, ""),
                        Validita_Fine_Distinta: evaluateNull(currentDataItem.Validita_Fine_Distinta, ""),
                        Cul_Des: evaluateNull(currentDataItem.Cul_Des, ""),
                        Data_Raccolta: evaluateNull(currentDataItem.Data_Raccolta, ""),
                        Data_Raccolta_Prevista: evaluateNull(currentDataItem.Data_Raccolta_Prevista, ""),
                        Data_Fioritura: evaluateNull(currentDataItem.Data_Fioritura, ""),
                        Data_Fioritura_Prevista: evaluateNull(currentDataItem.Data_Fioritura_Prevista, ""),
                        Veg_Cod: evaluateNull(currentDataItem.Veg_Cod, 0),
                        Cul_Cod: evaluateNull(currentDataItem.Cul_Cod, 0),
                        Grfi_Cod: evaluateNull(currentDataItem.Grfi_Cod, 0),
                        Stato_Impianto: evaluateNull(currentDataItem.Stato_Impianto, 102),
                        Cop_Cod: evaluateNull(currentDataItem.Cop_Cod, 0),
                        Rag_Soc: evaluateNull(currentDataItem.Rag_Soc, ""),
                        Sa_Nome: evaluateNull(currentDataItem.Sa_Nome, ""),
                        Veg_Des: evaluateNull(currentDataItem.Veg_Des, ""),
                        Validita_Inizio: evaluateNull(currentDataItem.Validita_Inizio, ""),
                        Validita_Fine: evaluateNull(currentDataItem.Validita_Fine, ""),
                        Validita_Inizio_Appezzamento: evaluateNull(currentDataItem.Validita_Inizio_Appezzamento, ""),
                        Validita_Fine_Appezzamento: evaluateNull(currentDataItem.Validita_Fine_Appezzamento, ""),
                        _QuotaDistribuzione: 0,
                        Codici_Anagrafe_Des: evaluateNull(currentDataItem.Codici_Anagrafe_Des, ""),
                        Mat_cod: 0,
                        Udm_cod: 0,
                        Qta: "0",
                        Qta2: evaluateNull(Superficie, 0),
                        GisWkt: evaluateNull(currentDataItem.GisWkt, ""),
                        GisWktGps: evaluateNull(currentDataItem.GisWktGps, ""),
                        GisWktSistemaRiferimento: evaluateNull(currentDataItem.GisWktSistemaRiferimento, ""),
                        GisTipoEntita_cod: evaluateNull(currentDataItem.GisTipoEntita_cod, 0),
                        GisLayerCod: evaluateNull(currentDataItem.GisLayerCod, 0),
                        ListaParticelle: vettParticelle,
                        ListaClassiTessitura: vettClassiTessitura
                    }

                    impiantiSelezionati.push(ImpiantoSelezionato);


                }


                $("#<%=hdKendo_Impianti_Selezione.ClientID() %>").val(JSON.stringify(impiantiSelezionati));

            }

            if (isSemina && frazionaSemina && N_impianti > 1) {
                alert('ATTENZIONE! Se si sceglie l opzione di frazionamento è possibile selezionare un solo appezzamento per volta!');
            }


        }

        function Aggiorna_hdKendo_Impianti_Selezione_New(e) {

            var impiantiSelezionati = new Array();

            var grid = $("#kendo_impianti").data("kendoGrid");
            var data = grid.dataSource.data();
            var totalRows = data.length;
            var currentDataItem;

