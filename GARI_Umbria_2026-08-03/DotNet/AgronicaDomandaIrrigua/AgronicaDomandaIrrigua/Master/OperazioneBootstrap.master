        function AggiornaCostiAdEttaro() {

            let supTrattata = SupTrattata();

            let griglia = $("#kendo_CostiAccessori").data('kendoGrid');

            if (griglia !== undefined) {

                let datiGriglia = griglia.dataSource.data();
                let ricaricaRichiesto = false;

                for (var i = 0; i < datiGriglia.length; i++) {
                    if (datiGriglia[i].Udm_Cod == 1) { //Ettaro
                        var dataItem = griglia.dataSource.getByUid(datiGriglia[i].uid)
                        griglia.trigger("save", {
                            bypass: 'Qta_Ril',
                            values: { Qta_Ril: supTrattata },
                            model: { uid: dataItem.uid }
                        });
                        kendo_imposta_valore(dataItem, "Qta_Ril", parseFloat(supTrattata.toString().replace(",", ".")), "n2");
                        ricaricaRichiesto = true;
                    }
                }

                if (ricaricaRichiesto) {
                    kendoRefresh("#kendo_CostiAccessori");
                }
            }
        }

        function mostraNascondi(aDiv, Div) {
            if ($("#" + Div).is(":visible")) {
                $("#tabs_kendo_CostiAccessori").hide();
                $("#kendo_CostiAccessori").hide();
                $("#aCostiAccessori").removeClass("fa fa-minus-circle");
                $("#aCostiAccessori").addClass("fa fa-plus-circle");
            } else {
                $("#tabs_kendo_CostiAccessori").show();
                $("#kendo_CostiAccessori").show();
                $("#aCostiAccessori").removeClass("fa fa-plus-circle");
                $("#aCostiAccessori").addClass("fa fa-minus-circle");
            }
        }



    </script>

</asp:Content>
