        }


        //Dato un oggetto $ trova la superficie dell'impianto
        function ValoreSuperficie_Impianto(Oggetto) {

            return kGetSuperficie(Oggetto, "Sup_Imp");

        }

        function Inserisci_ValoreSuperficie_Impianto(Oggetto, valore) {
            var app = roundNumber(valore, 4) + "";
            app = app.toString().replace(".", ",");
            Oggetto.parent().parent().parent().find('.Sup_Imp').val(app);
        }

        function ValoreSuperficieCoinvolta_Impianto(Oggetto) {

            return kGetSuperficie(Oggetto, "Sup_Imp_help");

        }

        function Inserisci_ValoreSuperficieCoinvolta_Impianto(Oggetto, valore) {
            var app = roundNumber(valore, 4) + "";
            app = app.replace(".", ",");
            Oggetto.parent().parent().parent().find('.Sup_Coinvolta').val(app);
        }


        //Funzione per l'aggiornamento della superficie Totale
        function RicalcolaSuperficieTotale() {
            var SupTot = 0.00;
            //sel la checkbox è chekkata

            var filteredData = kGetElementiSelezionati("#kendo_impianti");

            $.each(filteredData, function (idx, dataItem) {

                var app = ValoreSuperficie_Impianto($(dataItem));
                SupTot += parseFloat(app);
            });
            InserisciSupTotale(SupTot);

        }


        //Aggiornamento della superficie Coinvolta
        function RicalcolaSuperficieCoinvolta(ricalcola) {
            var SupTot = 0.00;
            //sel la checkbox è chekkata

            var filteredData = kGetElementiSelezionati("#kendo_impianti");

            $.each(filteredData, function (idx, dataItem) {

                var app = ValoreSuperficieCoinvolta_Impianto($(dataItem));

                //se = "" --> significa che provengo da un evento di salvataggio del valore della cella. recupero il valore da variabile appoggio.
                if (app == "") {
                    app = kEventoSelezionaRiga_Sup_Coninvolta.toString().replace(",", ".");
                    kEventoSelezionaRiga_Sup_Coninvolta = 0;
                }
                SupTot += parseFloat(app.toString().replace(",", "."));
            });
            if (ricalcola == true) {
                InserisciSupTrattata(SupTot);
            } else {
                //if (SupTrattata() != "0" && SupTrattata() != "") {
                    //InserisciSupTrattata(SupTot);
                //}
            }
            
        }

        //Ripartizione della superficie trattata
        function RipartizionaSupTrattata() {

            var SupSel = parseFloat(SupTotale());
            var SupTratt = parseFloat(SupTrattata());
            var attr;
            attr = SupTratt / SupSel;

            var filteredData = kGetElementiSelezionati("#kendo_impianti");
            var nSel = filteredData.length;
            var somma = 0;
            $.each(filteredData, function (idx, dataItem) {
                var daInserire;
                var app = parseFloat(dataItem.Sup_Imp);
                if (nSel - 1 !== idx) {
                    daInserire = roundNumber((app * attr), 4);
                    somma += daInserire;
                } else {
                    daInserire = (SupTratt.toFixed(4) - somma.toFixed(4)).toFixed(4);
                }
                

                dataItem.Sup_Imp_help = daInserire;
                //Aggiorna_hdKendo_Impianti_Selezione(dataItem);

                //$("#kendo_impianti").find("tr[data-uid='" + currentDataItem.uid + "'] td:eq(" + colona_Sup_imp + ")").text(daInserire);

            });

            Aggiorna_hdKendo_Impianti_Selezione(undefined);
            kendoRefresh("#kendo_impianti");

        }



        //Aggiornamento della Superficie coinvolta del singolo 
        //todo: revisionare
        function AggiornaValoreImpianto(Oggetto) {
            if (Oggetto.is(':checked')) {
                Inserisci_ValoreSuperficieCoinvolta_Impianto(Oggetto, ValoreSuperficie_Impianto(Oggetto));
                Oggetto.parent().parent().parent().find('.Sup_Coinvolta').removeAttr('disabled');
            }
            else {
                Inserisci_ValoreSuperficieCoinvolta_Impianto(Oggetto, '0.00');
                Oggetto.parent().parent().parent().find('.Sup_Coinvolta').attr('disabled', 'disabled');
            }
        }



