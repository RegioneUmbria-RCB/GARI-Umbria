                        <div style="overflow: auto">
                            <asp:GridView ID="GridView_Impianti" runat="server" AutoGenerateColumns="False" CssClass="table table-bordered table-striped tab_impianti"
                                AllowSorting="True" OnSorting="GridView_Impianti_Sorting" Caption="Tabella Impianti: <div class='btn btn-info btn-xs' id='btn_Impostazioni_Colonne' style='margin-top: 0; margin-left: 5px;'><span class='fa fa-plus'></span><span> Filtra colonne</span></div>"
