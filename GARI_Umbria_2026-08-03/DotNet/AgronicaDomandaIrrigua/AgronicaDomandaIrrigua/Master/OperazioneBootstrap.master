<%@ Master Language="VB" MasterPageFile="DomandaIrriguaBootstrap.Master" AutoEventWireup="false"
    CodeBehind="OperazioneBootstrap.master.vb" Inherits="AgronicaDomandaIrrigua.OperazioneBootstrap" %>

<%@ Import Namespace="AgronicaCoreDataProvider.TipiEnumerativi" %>

<%@ Register Assembly="AgronicaControlli_2010" Namespace="AgronicaControlli_2010"
    TagPrefix="cc1" %>


<%@ Register Assembly="AgronicaControlliGis" Namespace="AgronicaControlliGis"
    TagPrefix="gis" %>


<%@ MasterType VirtualPath="~/Master/DomandaIrriguaBootstrap.Master" %>

<asp:Content ID="Content1" ContentPlaceHolderID="HeadContent" runat="server">
    <asp:ContentPlaceHolder ID="ContentOperazioniHeader" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/jquery-footable/0.1.0/css/footable.min.css"
        rel="stylesheet" type="text/css" />
    <style>
        td.Sup_Coinvolta {
            border: solid 1px red;
        }

        .btn {
            font-size: 12px;
        }

        .ComboFormulati {
            min-width: 0px;
            width: 100%;
        }

        .RBL_Salva td {
            width: 33%;
        }

        table caption {
            /* background-color: rgba(255,255,255,0.5);*/
            color: #222;
            font-size: 11pt;
            font-weight: 700;
            line-height: 30px;
            text-transform: uppercase;
            height: 35px;
            margin-top: -40px;
            /*width: 100%;*/
            position: absolute;
        }

        .Titolo1 {
            font-size: 11pt;
            font-weight: 700;
            line-height: 30px;
            text-transform: uppercase;
        }

        .tab_impianti caption {
            width: 97%;
            top: 0;
            margin-top: 15px;
        }

        .bs-callout-success-all {
            border-top: solid 1px #398439 !important;
            border-bottom: solid 1px #398439 !important;
            border-left: solid 5px #398439 !important;
            border-right: solid 5px #398439 !important;
        }

        .bs-callout-info {
            border-left-color: #269ABC !important;
        }

        .bs-callout-warning {
            border-left-color: #D58512 !important;
        }

        .bs-callout-success {
            border-left-color: #398439 !important;
        }

        .bs-callout-danger {
            border-left-color: #CE4844 !important;
        }

        .bs-callout {
            padding: 20px;
            border: 1px solid #EEE;
            border-left-width: 5px;
            border-radius: 3px;
            background: rgba(255,255,255,0.5);
        }


        .dpiOn {
            box-shadow: 1px 1px rgba(0,0,0,.075) inset;
            background-color: Orange;
            /*pointer-events: none;*/
        }


        .dpiOff {
            pointer-events: none;
        }

        @media (max-width: 767px) {
            .bs-callout {
                padding: 10px !important;
            }
        }

        .wRisorsaDes {
            min-width: 100px;
        }

        .descrizione {
            width: 75px;
        }


        .btnPosizioneOffline {
            background-color: red;
        }

        .btnPosizioneOnline {
            background-color: lightgreen;
        }

        #dialogRicette table input {
            margin-right: 10px;
        }

        #dialogRicette table td {
            padding-bottom: 10px;
        }

        #dialogRicette table label {
            display: inline;
        }
    </style>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">
    <asp:HiddenField ID="hf_esistonoCostiCollegatiCDG" runat="server" />
    <asp:HiddenField ID="QtaAcqua" runat="server" />
    <asp:UpdatePanel ID="UpdatePanelBottoneAggiorna" runat="server" UpdateMode="Conditional">
        <ContentTemplate>
            <asp:HiddenField ID="fooName_PostedBack" runat="server" />
            <asp:Button OnClick="Wrap_Client_PostedBack" CssClass="hideBtn" ID="btnDummyPostback"
                runat="server" meta:resourcekey="btnDummyPostbackResource1" />
        </ContentTemplate>
    </asp:UpdatePanel>

    <asp:UpdatePanel ID="updateToolBar" runat="server" UpdateMode="Conditional">
        <ContentTemplate>

            <div style="display: none">
                <gis:GisSmartBSctrl id="GisSmartBS" runat="server"></gis:GisSmartBSctrl>
            </div>


            <div class="row" style="margin-bottom: 10px; padding: 0 15px;">


                <div class="col-lg-12 col-md-12">

                    <div class="btn-toolbar" role="toolbar">
                        <div class="btn-group" id="main_menu_button">
                            <!-- CARICO MAGAZZINO -->
                            <div class="btn btn-info btn-xs" id="ImgBtn_Carico_div" runat="server" cssclass="displaynone">
                                <i class="fa fa-archive" style="font-size: 16pt;"></i><i class="fa fa-plus" style="margin-left: -3px; font-size: 12pt;"></i>
                                <span>
                                    <asp:Localize meta:resourcekey="CaricoMagazzino" runat="server">Carico Magazzino</asp:Localize></span>
                            </div>
                            <asp:ImageButton ID="ImgBtn_Carico" runat="server" ImageUrl="../AB_Immagini/icone32/magazzinocarico.ico"
                                Style="display: none" meta:resourcekey="ImgBtn_CaricoResource1" />


                            <!-- CONFORMITA DPI -->
                            <div class="btn btn-warning  btn-xs" id="ImgBtn_CheckDPI_div" runat="server">
                                <i class="fa fa-file-text" style="font-size: 16pt;"></i><i class="fa fa-check" style="margin-left: -3px; font-size: 12pt;"></i>
                                <span>
                                    <asp:Localize runat="server" meta:resourcekey="ImgBtn_CheckDPI2Resource1">Conformità Disciplinare</asp:Localize></span>
                            </div>
                            <asp:ImageButton ID="ImgBtn_CheckDPI" runat="server" ImageUrl="../AB_Immagini/icone32/certificatoSI.ico"
                                ToolTip="Premere il pulsante per verificare la conformità al Disciplinare" Style="display: none"
                                meta:resourcekey="ImgBtn_CheckDPIResource1" />
                            <!-- DOSE DPI DISERBO -->
                            <div class="btn btn-warning btn-xs" id="ImgBtn_DoseConsigliata_div" runat="server">
                                <i class="fa fa-book" style="font-size: 16pt;"></i>
                                <span>
                                    <asp:Localize meta:resourcekey="VerificaDoseConsigliata" runat="server">Verifica Dose Consigliata</asp:Localize></span>
                            </div>
                            <asp:ImageButton ID="ImgBtn_DoseConsigliata" runat="server" ImageUrl="../AB_Immagini/icone32/registro.ico"
                                ToolTip="Premere il pulsante per verificare la dose consigliata da Disciplinare"
                                Style="display: none;" meta:resourcekey="ImgBtn_DoseConsigliataResource1" />

                            <!-- DOSE DPI DETTAGLIO DISERBO -->
                            <div class="btn btn-warning btn-xs" id="ImgBtn_DoseConsigliataDettaglio_div" runat="server">
                                <i class="fa fa-book" style="font-size: 16pt;"></i>
                                <span>
                                    <asp:Localize runat="server">Dettaglio Dose Consigliata Disciplinare</asp:Localize></span>
                            </div>
                            <asp:ImageButton ID="ImgBtn_DoseConsigliataDettaglio" runat="server" ImageUrl="../AB_Immagini/icone32/registro.ico"
                                ToolTip="Premere il pulsante per verificare il dettaglio della dose consigliata da Disciplinare"
                                Style="display: none;" />


                            <!-- RICETTE -->
                            <div class="btn btn-info btn-xs" id="apri_pannello_ricette" style="<%= RicetteOrdiniDiLavoroAttivi_CSS %>">
                                <i class="fa fa-newspaper-o" style="font-size: 16pt;"></i>
                                <span>
                                    <asp:Localize meta:resourcekey="CreaDaRicetta" runat="server">Crea da Ricetta</asp:Localize></span>
                            </div>
                            <!-- ALLEGA DDT -->
                            <asp:ImageButton ID="ImgBtn_DDT" runat="server" ImageUrl="../AB_Immagini/icone32/Clip32.ico"
                                ToolTip="Premere il pulsante per allegare un DDT all'operazione" Style="display: none"
                                meta:resourcekey="ImgBtn_DDTResource1" />
                            <!-- CANCELLA DDT -->
                            <asp:ImageButton ID="ImgBtn_DDT_Cancella" runat="server" ImageUrl="../AB_Immagini/icone32/Clip32_Elimina.ico"
                                ToolTip="Premere il pulsante per eliminare i DDT allegati all'operazione" Style="width: 32px"
                                Visible="False" meta:resourcekey="ImgBtn_DDT_CancellaResource1" />



                            <!-- CARICO EFFLUENTI -->
                            <div class="btn btn-info btn-xs" id="ImgBtn_Carico_Eff_div" runat="server" visible="False">
                                <i class="fa fa-archive" style="font-size: 16pt;"></i><i class="fa fa-plus" style="margin-left: -3px; font-size: 12pt;"></i>
                                <span>
                                    <asp:Localize runat="server">Carico Effluenti</asp:Localize></span>
                            </div>
                            <asp:ImageButton ID="ImgBtn_Carico_Eff" runat="server" ImageUrl="../AB_Immagini/icone32/magazzinocarico.ico"
                                Style="display: none" />


                        </div>

                    </div>

                </div>


            </div>
        </ContentTemplate>
    </asp:UpdatePanel>

    <div class="jumbotron xo-operazioni-jumbotron" id="divTestataRicetta" style="padding-left: 15px; padding-right: 15px; display: none">
        <div class="row">
            <div class="col-lg-6">
                <h4>Dati Ricetta</h4>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6" data-role="fieldcontain">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="input-group">
                            <span class="input-group-addon alert-info">
                                <asp:Localize meta:resourcekey="jsLblDescrizione" runat="server">Descrizione</asp:Localize></span>
                            <asp:TextBox ID="Txt_Ricetta_Descrizione" runat="server" CssClass="form-control"></asp:TextBox>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6" data-role="fieldcontain">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="input-group">
                            <span class="input-group-addon alert-info">
                                <asp:Localize meta:resourcekey="jsLblNumero" runat="server">Numero</asp:Localize></span>
                            <asp:TextBox ID="Txt_Ricetta_Numero" runat="server" CssClass="form-control"></asp:TextBox>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="input-group">
                    <label id="lbldatainizio_ricetta" class="input-group-addon alert-info" for="<%= data_inizio_ricetta.ClientID %>">
                        <asp:Localize meta:resourcekey="lbl_dataInizio" runat="server">Da</asp:Localize>
                    </label>
                    <input class="kendoCalendar form-control" id="data_inizio_ricetta" maxlength="10" runat="server" aria-describedby="lbldatainizio_ricetta" />
                </div>
            </div>
            <div class="col-lg-6">
                <div class="input-group">
                    <label id="lbldatafine_ricetta" class="input-group-addon alert-info" for="<%= data_fine_ricetta.ClientID %>">
                        <asp:Localize meta:resourcekey="lbl_dataFine" runat="server">A</asp:Localize>
                    </label>
                    <input class="kendoCalendar form-control" id="data_fine_ricetta" maxlength="10" runat="server" aria-describedby="lbldatafine_ricetta" />

                </div>
            </div>
            <div class="col-lg-12" data-role="fieldcontain">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="input-group">
                            <span class="input-group-addon alert-info">
                                <asp:Localize meta:resourcekey="lblNoteResource1" runat="server">Nota</asp:Localize></span>
                            <asp:TextBox ID="Txt_Ricetta_Nota" runat="server" CssClass="form-control" MaxLength="4000"></asp:TextBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- OPERAZIONE -->
    <asp:Panel class="row" Style="margin-bottom: 10px; padding: 0 15px;" runat="server" ID="divOperazione">

        <div class="col-lg-12 col-md-12 col-sm-12" runat="server" id="PannelloOperazioni">
            <asp:UpdatePanel ID="UpdatePanelOperazione" runat="server" UpdateMode="Conditional">
                <ContentTemplate>
                    <div class="input-group">
                        <asp:Label ID="lblOperazione" runat="server" meta:resourcekey="lblOperazioneResource1"
                            CssClass="input-group-addon alert-info" for="<%=ComboOperazione.ClientID %>">Operazione</asp:Label>
                        <cc1:ComboOperazioni ID="ComboOperazione" runat="server" meta:resourcekey="ComboOperazioneResource1"
                            aria-describedby="<%=lblOperazione.ClientID %>" Bootstrap="true" Tipo_GruppoOperazioni="'C'" />
                        <asp:Button ID="BTN_ComboOperazione" runat="server" Text="Button" Style="display: none"
                            meta:resourcekey="BTN_ComboOperazioneResource1" />
                    </div>
                </ContentTemplate>
            </asp:UpdatePanel>
            <asp:UpdatePanel ID="UpdatePanelToolBar1" runat="server">
                <ContentTemplate>
                </ContentTemplate>
            </asp:UpdatePanel>
            <asp:UpdatePanel ID="UpdatePanelToolBar" runat="server">
                <ContentTemplate>
                    <!--<div class="bs-callout">-->


                    <!--</div>-->
                </ContentTemplate>
            </asp:UpdatePanel>
        </div>
    </asp:Panel>

    <!-- FILTRI -->
    <div class="jumbotron xo-operazioni-jumbotron-filtri" style="padding-left: 15px; padding-right: 15px;">

        <div class="row">

            <!-- FILTRI -->
            <div id="divFiltri" class="col-md-12">

                <div class="row">
                    <!-- DATA -->
                    <div id="divUpdatePanelData" class="col-md-6">
                        <asp:UpdatePanel ID="UpdatePanelData" runat="server" UpdateMode="Conditional">
                            <ContentTemplate>
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <asp:Label ID="lblData1" runat="server" meta:resourcekey="lblData1Resource1" CssClass="input-group-addon alert-info">Data</asp:Label>
                                            <asp:TextBox ID="txt_DataOperazione" runat="server" CssClass="form-control"
                                                meta:resourcekey="txt_DataOperazioneResource1"></asp:TextBox>
                                            <asp:Button ID="BTN_ChangeData" runat="server" Text="Button" Style="display: none"
                                                meta:resourcekey="BTN_ChangeDataResource1" CssClass="btn_per_load" />
                                        </div>
                                    </div>
                                </div>
                            </ContentTemplate>
                        </asp:UpdatePanel>
                    </div>

                    <!-- USERNAME CREAZIONE -->
                    <asp:Panel ID="divUsernameCreazione" class="col-md-12 nopadding" Visible="false" runat="server">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <div class="input-group">
                                    <asp:Label ID="lblUsernameCreazione" runat="server" meta:resourcekey="lblUsernameCreazione" CssClass="input-group-addon alert-info">Operatore</asp:Label>
                                    <asp:TextBox ID="txtUsernameCreazione" runat="server" meta:resourcekey="txtUsernameCreazione" Enabled="false" CssClass="form-control" Style="background-color: lightgray; color: #333;" />
                                </div>
                            </div>
                        </div>
                    </asp:Panel>

                    <!-- POSIZIONE -->
                    <asp:Panel ID="divPosizione" class="col-md-12 nopadding" Visible="false" runat="server">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <div class="input-group">
                                    <asp:Label ID="lblPosizione" runat="server" meta:resourcekey="lblPosizione" CssClass="input-group-addon alert-info">Posizione</asp:Label>
                                    <asp:TextBox ID="txtPosizione" runat="server" meta:resourcekey="txtPosizione" Enabled="false" CssClass="form-control" Style="background-color: lightgray; color: #333; border-right-width: 0px;" />
                                    <% If Master.Master_versione = "2022" Then %>
                                        <div class="xo-button-horizontal">
                                    <% End If %>
                                    <% If Master.Master_versione = "2022" Then %>
                                     <div class="btn btn-success btn_100 xi-btn-primary xo-max-w-200" id="btnPosizione">
                                        <i class="fa fa-map-marker xo-icon ic_options_open_map_gis_type02"></i>
                                        <span>Nuovo Punto</span>
                                    </div>
                                    <% Else %>
                                    <span class="input-group-btn" id="btnPosizione">
                                        <a class="form-control btn btn-secondary" title="Nuovo Punto"><span class="fa fa-map-marker xo-icon ic_options_open_map_gis_type02"></span></a>
                                    </span>
                                    <% End If %>
                                   
                                    
                                    <% If Master.Master_versione = "2022" Then %>
                                     <div class="btn btn-success btn_100 xi-btn-primary xo-max-w-200" id="btnAnteprimaPosizione">
                                        <i class="fa fa-globe xo-icon ic_options_gps_gis_type02"></i>
                                        <span>Apri Anteprima GIS</span>
                                    </div>
                                    <% Else %>
                                    <span class="input-group-btn status offline" id="btnAnteprimaPosizione">
                                        <a class="form-control btn btn-secondary" style="border-bottom-right-radius: 4px; border-top-right-radius: 4px;" title="Apri Anteprima GIS"><span class="fa fa-globe"></span></a>
                                    </span>
                                    <% End If %>
                                    <% If Master.Master_versione = "2022" Then %>
                                    </div>
                                    <% End If %>
                                </div>
                            </div>
                        </div>
                    </asp:Panel>

                    <!-- IMPRESA -->
                    <asp:Panel ID="divImpresa" class="col-md-12 nopadding" Visible="false" runat="server">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <div class="input-group">
                                    <asp:Label ID="lblImpresa" runat="server" meta:resourcekey="lblImpresa" CssClass="input-group-addon alert-info">Azienda</asp:Label>
                                    <asp:TextBox ID="txtImpresa" runat="server" meta:resourcekey="txtImpresa" Enabled="false" CssClass="form-control" Style="background-color: lightgray; color: #333;" />
                                </div>
                            </div>
                        </div>
                    </asp:Panel>

                </div>

                <div class="row">
                    <!-- CENTRO -->
                    <div id="divUpdatePanelCentroAziendale" class="col-md-6">
                        <asp:UpdatePanel ID="UpdatePanelCentroAziendale" runat="server" UpdateMode="Conditional">
                            <ContentTemplate>
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <asp:Label ID="lblCentroAziendale" runat="server" meta:resourcekey="lblCentroAziendaleResource1"
                                                CssClass="input-group-addon alert-info">Centro Aziendale</asp:Label>
                                            <cc1:ComboCentroAziendale ID="ComboCentroAziendale" runat="server" meta:resourcekey="ComboCentroAziendaleResource1" Ricerca="false"
                                                bootstrap="true" />
                                            <asp:Button ID="BTN_ComboCentroAziendale" runat="server" Text="Button" Style="display: none"
                                                meta:resourcekey="BTN_ComboCentroAziendaleResource1" />
                                        </div>
                                    </div>
                                </div>
                            </ContentTemplate>
                            <Triggers>
                                <asp:AsyncPostBackTrigger ControlID="BTN_ChangeData" EventName="Click" />
                            </Triggers>
                        </asp:UpdatePanel>
                    </div>
                    <!-- MAGAZZINO -->
                    <div class="col-md-6 " runat="server" id="ProvenienzaRisorse">
                        <asp:UpdatePanel ID="UpdatePanelMagazzino" runat="server" UpdateMode="Conditional">
                            <ContentTemplate>
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <asp:Label ID="lblProvenienzaRisorse" runat="server" meta:resourcekey="lblProvenienzaRisorseResource1"
                                                CssClass="input-group-addon alert-info">Provenienza Risorse</asp:Label>
                                            <cc1:ComboMagazzini ID="ComboMagazzini" runat="server" Fabbricato_Cod="0" Flag_CodCentroFabbricato="True" Ricerca="false"
                                                Bootstrap="true" Flag_GestioneMagazziniImpresaPadre="False" meta:resourcekey="ComboMagazziniResource1"
                                                Sa_Cod="0" TipoMagazzino="20" />
                                            <asp:Button ID="BTN_Magazzini" runat="server" Text="Button" Style="display: none"
                                                meta:resourcekey="BTN_MagazziniResource1" />
                                        </div>
                                    </div>
                                </div>
                            </ContentTemplate>
                            <Triggers>
                                <asp:AsyncPostBackTrigger ControlID="Btn_Conferma_Ricetta" EventName="Click" />
                                <asp:AsyncPostBackTrigger ControlID="Btn_Aggiorna_Magazzino" EventName="Click" />
                            </Triggers>
                        </asp:UpdatePanel>
                    </div>

                </div>

                <div class="row">
                    <!-- SPECIE -->
                    <div class="col-lg-4 col-md-4 col-xs-10 " style="padding-right: 0" runat="server" id="Div_Specie">
                        <asp:UpdatePanel ID="UpdatePanelSpecie" runat="server" UpdateMode="Conditional">
                            <ContentTemplate>
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <asp:Label ID="lblSpecie" runat="server" meta:resourcekey="lblSpecieResource1" CssClass="input-group-addon alert-info">Specie</asp:Label>
                                            <cc1:ComboSpecie ID="ComboSpecie" runat="server" meta:resourcekey="ComboSpecieResource1" Ricerca="false"
                                                Bootstrap="true" />
                                            <asp:Button ID="BTN_ComboSpecie" runat="server" Text="Button" Style="display: none"
                                                meta:resourcekey="BTN_ComboSpecieResource1" OnClientClick="CambiataSpecie()" />
                                        </div>
                                    </div>
                                </div>
                            </ContentTemplate>
                            <Triggers>
                                <asp:AsyncPostBackTrigger ControlID="BTN_ChangeData" EventName="Click" />
                                <asp:AsyncPostBackTrigger ControlID="BTN_ComboCentroAziendale" EventName="Click" />

                            </Triggers>
                        </asp:UpdatePanel>
                    </div>
                    <div class="col-lg-2 col-md-2 col-xs-2 " style="padding-left: 0" runat="server" id="Div_BtnFasi">
                        <div class="btn btn-info btn_per_load " id="Rilievo" onclick="ApriRilievo(79);" style="width: 100%">
                            <span style="font-size: xx-small">
                                <i class="fa fa-leaf fa-6"></i>
                                <asp:Localize meta:resourcekey="Rileva" runat="server">Rileva Fase/Epoca</asp:Localize></span>
                        </div>
                        <asp:Button ID="BtnRilevaFasi" runat="server" Style="display: none" />
                    </div>

                    <!-- DISCIPLINARE -->
                    <asp:Panel CssClass="col-lg-6 col-md-6 col-xs-12 " runat="server" ID="Div_Disciplinare">
                        <asp:UpdatePanel ID="UpdatePanelDisciplinare" runat="server" UpdateMode="Conditional">
                            <ContentTemplate>
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <asp:Label ID="lblDPI" runat="server" meta:resourcekey="lblDPIResource1" CssClass="input-group-addon alert-info">Disciplinare</asp:Label>
                                            <cc1:ComboDisciplinari ID="ComboDisciplinari1" runat="server" meta:resourcekey="ComboDisciplinari1Resource1" Ricerca="false"
                                                Bootstrap="true" />

                                            <asp:Button ID="BTN_ComboDisciplinari1" runat="server" Text="Button" Style="display: none"
                                                meta:resourcekey="BTN_ComboDisciplinari1Resource1" />

                                        </div>
                                    </div>
                                </div>
                                <div id="div_AlertTerrenoNudo" runat="server" visible="false">
                                    <label style="color: red;">Attenzione: l'attuale selezione di destinazione del trattamento non è abbinabile a nessuna etichetta di prodotti registrati. Il sistema non potrà fornire i controlli/supporti abituali per cui la verifica di conformità e dosaggi saranno a cura dell'utente.</label>
                                </div>
                            </ContentTemplate>
                            <Triggers>
                                <asp:AsyncPostBackTrigger ControlID="BTN_ChangeData" EventName="Click" />
                                <asp:AsyncPostBackTrigger ControlID="BTN_ComboCentroAziendale" EventName="Click" />
                                <asp:AsyncPostBackTrigger ControlID="BTN_ComboSpecie" EventName="Click" />
                            </Triggers>
                        </asp:UpdatePanel>
                    </asp:Panel>
                </div>

                <div class="row">
                    <!-- content Trattamenti -->
