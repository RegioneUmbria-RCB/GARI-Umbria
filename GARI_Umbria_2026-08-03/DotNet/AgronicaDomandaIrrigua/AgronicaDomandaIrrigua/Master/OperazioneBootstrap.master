        /////////////////////////////////////
        // funzioni che aggiornano la dose 
        // al cambio dell'unita di misura
        /////////////////////////////////////



        // funzione che in base all'unità di misura selezionata definisce il moltiplicatore
        function Get_UnitaDiMisura() {
            var unita = $('select.UdmCod').val();
            var moltiplicatore, moltiplicatore_base;
            var final = 0;

            if (_unita != unita) {

                switch (_unita) {
                    case "2":
                        // kg
                        moltiplicatore_base = 1;
                        break;
                    case "3":
                        // gr
                        moltiplicatore_base = 0.001;
                        break;
                    case "4":
                        // q
                        moltiplicatore_base = 100;
                        break;
                    case "304":
                        // t
                        moltiplicatore_base = 1000;
                        break;

                    case "29":
                        // l
                        moltiplicatore_base = 1;
                        break;

                    case "104":
                        // cc
                        moltiplicatore_base = 0.001;
                        break;

                    case "101":
                        // ml
                        moltiplicatore_base = 0.001;
                        break;
                }

                switch (unita) {
                    case "2":
                        // kg
                        moltiplicatore = 1;
                        break;
                    case "3":
                        // gr
                        moltiplicatore = 0.001;
                        break;
                    case "4":
                        // q
                        moltiplicatore = 100;
                        break;
                    case "304":
                        // t
                        moltiplicatore = 1000;
                        break;

                    case "29":
                        // l
                        moltiplicatore = 1;
                        break;

                    case "104":
                        // cc
                        moltiplicatore = 0.001;
                        break;

                    case "101":
                        // ml
                        moltiplicatore = 0.001;
                        break;
                }

                final = moltiplicatore_base / moltiplicatore;
                _unita = unita;
            }

            return final;
        }

        function AggiornaDOSI_con_unita() {

            var _SupTrattata = SupTrattata();
            var _Acqua = AcquaTot();
            var unit = Get_UnitaDiMisura();

            //controllo se la gestione dell'acqua è visibile
            var gestione_acqua = false;

            if ($('.Acqua').is(':visible'))
                gestione_acqua = true

            var valTot = $('.qtaDoseTot').val();
            valTot = valTot.replace(/\,/g, '.');
            valTot = parseFloat(valTot).toFixed(6) * unit;
            valTot = roundNumber(valTot, 4) + "";
            valTot = valTot.replace(".", ",");
            $('.qtaDoseTot').val(valTot);


            if (DoseHAChecked()) {

                var val = $('.qtaDoseHa').val();
                val = val.replace(/\,/g, '.');
                val = parseFloat(val).toFixed(6) * unit;
                val = roundNumber(val, 4) + "";
                val = val.replace(".", ",");
                $('.qtaDoseHa').val(val);


                //LAVORO A HA
                if (QtaTOTChecked()) {
                    //LAVORO A TAL QUALE
                    if (_SupTrattata > 0) {
                        var _DoseTotaleHA = TotHA();
                        var _DoseHA = _DoseTotaleHA / _SupTrattata;
                        InserisciDoseHA(_DoseHA);
                        //VERIFICO L'acqua
                        if (_Acqua > 0) {
                            var _DoseHL = _DoseTotaleHA / _Acqua;
                            InserisciDoseHL(_DoseHL);
                        }
                        if (_Acqua == 0) {
                            InserisciDoseHL(0);
                        }
                    }
                }
                else {
                    //LAVORO A DOSE
                    if (_SupTrattata > 0) {
                        var _DoseHA = DoseHA();
                        var _DoseTotaleHA = _SupTrattata * _DoseHA;

                        InserisciTotHA(_DoseTotaleHA);
                        //VERIFICO L'acqua
                        if (_Acqua > 0) {
                            var _DoseHL = _DoseTotaleHA / _Acqua;
                            InserisciDoseHL(_DoseHL);
                        }
                        if (_Acqua == 0) {
                            InserisciDoseHL(0);
                        }
                    }
                }
            }
            else {

                var val = $('.qtaDoseHl').val();
                val = val.replace(/\,/g, '.');
                val = parseFloat(val).toFixed(6) * unit;
                val = roundNumber(val, 4) + "";
                val = val.replace(".", ",");
                $('.qtaDoseHl').val(val);

                //LAVORO A HL 
                if (QtaTOTChecked()) {
                    //LAVORO A TAL QUALE
                    if (_Acqua > 0) {
                        var _DoseTotaleHL = TotHA();
                        var _DoseHL = _DoseTotaleHL / _Acqua;
                        InserisciDoseHL(_DoseHL);
                        //VERIFICO L'acqua
                        if (_SupTrattata > 0) {
                            var _DoseHA = _DoseTotaleHL / _SupTrattata;
                            InserisciDoseHA(_DoseHA);
                        }
                    }
                    if (_Acqua == 0) {
                        InserisciDoseHL(0);
                    }
                }
                else {
                    //LAVORO A DOSE
                    if (_Acqua > 0) {
                        var _DoseHL = DoseHL();
                        var _DoseTotaleHL = _Acqua * _DoseHL;

                        //VERIFICO L'acqua
                        if (_SupTrattata > 0) {
                            InserisciTotHA(_DoseTotaleHL);
                            var _DoseHA = _DoseTotaleHL / _SupTrattata;
                            InserisciDoseHA(_DoseHA);
                        }
                    }
                    if (_Acqua == 0) {
                        InserisciDoseHA(0);
                    }
                }
            }
        }



        var _unita;

        function memorizza_unita_base() {
            _unita = $('select.UdmCod').val();
        }



