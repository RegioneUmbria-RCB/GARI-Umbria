    <%--fine template kendo--%>



    <script type="text/javascript">

        //variabili globali riportate da server
        var id_hdKendo_CostiAccessori_ComboHelper = "#<%= hdKendo_CostiAccessori_ComboHelper.ClientID %>";
        var id_hdKendo_CostiAccessori_ComboHelper_Comando = "#<%= hdKendo_CostiAccessori_ComboHelper_Comando.clientID %>";
        var id_btnKendo_CostiAccessori_ComboHelper = "#<%= btnKendo_CostiAccessori_ComboHelper.clientID %>";
        var id_hdKendo_CostiAccessori_ComboHelper_Gestione = "#<%= hdKendo_CostiAccessori_ComboHelper_Gestione.clientID%>";
        var id_hdKendo_CostiAccessori_Selezione = "<%=hdKendo_CostiAccessori_Selezione.ClientID  %>";
        var id_hdPageLoadFirst = "<%=hdPageLoadFirst.ClientID  %>";

        var id_OperazioneBootStrap_ProvenienzaRisorse = "#<%= ProvenienzaRisorse.ClientID %>";
        var id_OperazioneBootStrap_Specie = "#<%= Div_Specie.ClientID %>";
        var id_OperazioneBootStrap_Disciplinare = "#<%= Div_Disciplinare.ClientID %>";

        var id_OperazioneBootStrap_DivUsernameCreazione = "#<%= divUsernameCreazione.ClientID %>";
        var id_OperazioneBootStrap_DivPosizione = "#<%= divPosizione.ClientID %>";
        var id_OperazioneBootStrap_txtPosizione = "#<%= txtPosizione.ClientID %>";

        var id_OperazioneBootStrap_DivImpresa = "#<%= divImpresa.ClientID %>";

        var id_txt_DataOperazione = "#<%= txt_dataOperazione.ClientID %>";

        var id_hdKendo_Impianti_Selezione = "#<%= hdKendo_Impianti_Selezione.ClientID %>";
        var id_UpdateCostiAccessoriKendo = "#<%= UpdateCostiAccessoriKendo_ClientID %>";

        var obj_hdKendo_CostiAccessori_ComboHelper = undefined;
        var obj_hdKendo_CostiAccessori_Turno_ComboHelper = undefined;
        var obj_hdKendo_CostiAccessori_Attività_ComboHelper = undefined;

        var svrUrl = "../master/OperazioneBootstrap_WS.aspx"

        var ricetta_cod = "<%= ricetta_cod %>";
        var ricetta_operazione_cod = "<%= ricetta_operazione_cod %>";

        var iFrameGeneric_PaginaCorrente = "";

        var kendo_CostiAccessori;

        var MessaggioImpiantiVisualizzato = false;

    </script>



    <script type="text/javascript">    


        var enum_AlgoritmoCostiAccessori = {
            CAB: { value: 1, name: "CAB", code: 1 },
            SBTF: { value: 2, name: "SBTF", code: 2 },
            BASE: { value: 3, name: "CAB", code: 3 }
        }

        var ALGORITMO_COSTI_ACCESSORI = <%=ALGORITMO_COSTI_ACCESSORI %>;

        var Enum_CentriDiCosto = {
            Macchine: { value: -1, name: "Macchine", code: -1 },
            Manodopera: { value: -2, name: "Manodopera", code: -2 }
        }


        var debugMode = Enum_debugMode.Off;


        var Enum_TipoOperazione = {

            Lettura: { value: 0, name: "Lettura", code: 0 },
            Scrittura: { value: 1, name: "Scrittura", code: 1 },
            Modifica: { value: 2, name: "Modifica", code: 2 },
            Cancellazione: { value: 3, name: "Cancellazione", code: 3 },
            Trasferimento: { value: 4, name: "Trasferimento", code: 4 },
            Copia: { value: 10, name: "Copia", code: 10 },
        };

        var objParametriAgenda_TipoOperazione =  <%=objParametriAgenda_TipoOperazione %>;
        var objParametriAgenda_TipoOperazioneAgenda =  <%=objParametriAgenda_TipoOperazioneAgenda %>;
        var objParametriAgenda_VisualizzaSoloBottoneSalvaEsci =<%=objParametriAgenda_VisualizzaSoloBottoneSalvaEsci %>
        var objParametriAgenda_TipoRicetta =  <%=objParametriAgenda_TipoRicetta %>;

        var lav_cod_ricettabili = [<%=String.Join(",", ListLavCodRicettabili)%>];

        function kendoRefresh(jQuerySelector) {
            $(jQuerySelector).data("kendoGrid").refresh();
        }

        function tabCosti_impostaTabCorrente_Modificata(e) {
            var a = '<div class="error-tab" style="position: absolute; right: 5px; top: 0; background-color: red; width: 10px; text-align: center;"><b>!</b></div>';
            $("#tabs_kendo_CostiAccessori .active").append(a);

            if (e != undefined){

                if ((e.bypass && e.bypass === 'Qta_Ril') || kendo_fieldName_digitato(e) == "Qta_Ril") {}
                else if (kendo_fieldName_digitato(e) == "Costo_Unitario") {}
                else { MacchinaInserita(); }
            } else {
                //MacchinaInserita();
            }


            //if ($("#tabs_kendo_CostiAccessori .active").attr("id") == "costi_Macchine") {
            //}
        }

        function Abilita_Disabilita_Select(jQuerySelect, abilita) {

            //nonostante il disabled, l'evento click si attiva lo stesso.
            //per questo motivo uso il pointer-events (http://stackoverflow.com/questions/6657545/setting-attribute-disabled-on-a-span-element-does-not-prevent-click-events)

            if (!abilita) {
                $(jQuerySelect + ' button').css('background-color', 'lightgray');
                $(jQuerySelect + '.btn-group').css('pointer-events', 'none');
            } else {
                $(jQuerySelect + ' button').css('background-color', '');
                $(jQuerySelect + '.btn-group').css('pointer-events', '');

            }

        }

        function Abilita_Disabilita_Text(jQuerySelect, abilita) {

            //nonostante il disabled, l'evento click si attiva lo stesso.
            //per questo motivo uso il pointer-events (http://stackoverflow.com/questions/6657545/setting-attribute-disabled-on-a-span-element-does-not-prevent-click-events)

            if (!abilita) {
                $(jQuerySelect).css('background-color', 'lightgray');
                $(jQuerySelect).css('pointer-events', 'none');
            } else {
                $(jQuerySelect).css('background-color', '');
                $(jQuerySelect).css('pointer-events', '');

            }

        }


        function kCiSonoImpiantiSelezionati(griglia) {
            return kGetElementiSelezionati(griglia).length > 0;
            //return $(griglia + " .k-checkbox:checked:not(#header-chb)").length > 0;
        }



        var UtenteAbilitatoScrittura = true;

        var jSonParsed_Kendo;
        var jSonParsed_Kendo_CostiAccessori;

        function kendoAppezzamenti_Colonne() {

            var columnsHidden = $("#<%= hdKendo_Impianti_Colonne.ClientID %>").val();
            var grid = $("#kendo_impianti").data("kendoGrid");

            if (columnsHidden != null) {

                var colNames = columnsHidden.split("|");


                for (var i = 0; i < grid.columns.length; i++) {

                    if (debugMode == Enum_debugMode.Verbose) {
                        console.log("kendoAppezzamenti_Colonne(" + grid.columns[i].field + ")");
                    }


                    if (jQuery.inArray(grid.columns[i].title, colNames) == -1 && jQuery.inArray(grid.columns[i].title, ["Seleziona", "Sup.[Ha]", "Sup. Trattata[Ha]"]) == -1) {
                        grid.hideColumn(grid.columns[i].field);
                    } else {
                        grid.showColumn(grid.columns[i].field);
                    }

                } //end for

            } //end if

            mostraColonnaUnicaSeInMobile_OperazioneBootstrapMaster(1);
        }

        function kDirtyAll(jQuerySelector) {

            // Questo è necessario per forzare la modifica della griglia anche se in griglia non è cambiato nulla
            var grid = $(jQuerySelector).data("kendoGrid");
            var data = grid.dataSource.data();
            var totalRows = data.length;

            for (var i = 0; i < totalRows; i++) {
                data[i].dirty = true;
            }

        }

        function SalvataggioCostiAccessori() {
            $("#kendo_CostiAccessori .k-grid-save-changes").click();
        }

        function onBeforeSaveChangesKendoGrid() {
            kDirtyAll("#kendo_CostiAccessori");
        }

        function kAggiornaCostiAccessori() {

            kDirtyAll("#kendo_CostiAccessori");
            Aggiorna_hdKendo_CostiAccessori_Selezione();

        }


        function kReadCostiAccessori(options) {

            var data = $("#<%=hdKendo_CostiAccessori.ClientID() %>").val();
            jSonParsed_Kendo_CostiAccessori = JSON.parse(data);

            options.success(jSonParsed_Kendo_CostiAccessori.kendo_rows);
        }


        var col_Centro_di_Costo = 1;
        var categoria = 2;
        var col_risorsa_des = 3;

        function kReadCostiAccessori_col() {

            var data = $("#<%=hdKendo_CostiAccessori.ClientID() %>").val();
            var varToFill1 = JSON.parse(data);

            var cTtemplate = {
                template: "<span class='fa fa-edit fa-2x edit_elem' style='margin:0px 7px 0px 0px;' onclick=Risorsa_Edit(this.closest('tr'),this.closest('.k-grid'))></span>",
                title: "Azioni",
                width: "135px",
                widthfisso: true
            }

            var cRisorsaDes = "<%= cRisorsaDes.Replace("""", "\""") %>";
            var cModificaRisorsa = "<%= cModificaRisorsa.Replace("""", "\""") %>";
            var cUnitaDiMisura = "<%= cUnitaDiMisura.Replace("""", "\""") %>";


            kendo_Colonne_estendi(varToFill1, "Risorsa_Cod", cRisorsaDes, 1, "Risorsa_Des", Risorsa_Template, "wRisorsaDes");
            kendo_Colonne_estendi(varToFill1, undefined, cModificaRisorsa, 2, "", undefined, "", cTtemplate);

            if (ALGORITMO_COSTI_ACCESSORI == enum_AlgoritmoCostiAccessori.CAB.value || ALGORITMO_COSTI_ACCESSORI == enum_AlgoritmoCostiAccessori.SBTF.value) {
                kendo_Colonne_estendi(varToFill1, "Id_attivita", "Attivita", 3, "Attivita_Des", Attivita_Template);
                kendo_Colonne_estendi(varToFill1, "Udm_Cod", cUnitaDiMisura, 5, "Udm_Des", Udm_Template);
            }

            if (ALGORITMO_COSTI_ACCESSORI == enum_AlgoritmoCostiAccessori.CAB.value)
                kendo_Colonne_estendi(varToFill1, "Turno_Cod", "Turno", 4, "Turno_Des", Turno_Template);

            return varToFill1.kendo_columns;

        }




        function kReadCostiAccessori_mod() {

            var data = $("#<%=hdKendo_CostiAccessori.ClientID() %>").val();
            var varToFill1 = JSON.parse(data)


            return varToFill1.kendo_model;

        }

        function kReadAppezzamenti(options) {

            var data = $("#<%=hdKendo_Impianti.ClientID() %>").val();
            jSonParsed_Kendo = JSON.parse(data);

            options.success(jSonParsed_Kendo.kendo_rows);

            //console.log(data);
            //return jSonParsed_Kendo.kendo_rows;
        }

        function kReadAppezzamenti_col() {

            var data = $("#<%=hdKendo_Impianti.ClientID() %>").val();
            jSonParsed_Kendo = JSON.parse(data);

            var idle = kendo_indiceColonna_DatoNomeCampo("Sup_Imp");
            kendo_Colonne_estendi(jSonParsed_Kendo, "Sup_Imp_help", "Sup. Trattata[Ha]", 15, "Sup_Imp_help", numberEditor4decimals, "Sup_Coinvolta");
            kendo_Colonne_estendi(jSonParsed_Kendo, "Sup_Riduzione_BufferZone", "Sup. Riduzione [Ha] Buffer Zone", 13, "Sup_Riduzione_BufferZone", numberEditor4decimals, "Sup_Riduzione_Buffer");
            kendo_Colonne_estendi(jSonParsed_Kendo, "Perc_Riduzione_Deriva", "Mitigazione Deriva [%]", 14, "Perc_Riduzione_Deriva", numberEditor4decimals, "Perc_Riduzione_Deriva");

            //console.log(data);
            return jSonParsed_Kendo.kendo_columns;
        }

        function kReadAppezzamenti_mod() {

            var data = $("#<%=hdKendo_Impianti.ClientID() %>").val();
            jSonParsed_Kendo = JSON.parse(data);

            //console.log(data);
            return jSonParsed_Kendo.kendo_model;
        }

