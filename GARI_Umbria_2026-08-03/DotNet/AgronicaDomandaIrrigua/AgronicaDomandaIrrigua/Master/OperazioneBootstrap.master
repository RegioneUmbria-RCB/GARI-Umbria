                                        meta:resourcekey="BoundFieldResource13"></asp:BoundField>
                                    <asp:BoundField DataField="Data_Fioritura_Prevista" HeaderText="Data Fioritura Prevista"
                                        SortExpression="Data_Fioritura_Prevista" meta:resourcekey="BoundFieldResource14"></asp:BoundField>
                                    <asp:BoundField DataField="Data_Raccolta_Prevista" HeaderText="Data Raccolta Prevista"
                                        SortExpression="Data_Raccolta_Prevista" meta:resourcekey="BoundFieldResource15"></asp:BoundField>
                                    <asp:BoundField DataField="Progetto" HeaderText="Lotto Impianto" SortExpression="Progetto"
                                        meta:resourcekey="BoundFieldResource16"></asp:BoundField>
                                    <asp:BoundField DataField="Copertura" HeaderText="Copertura" SortExpression="Copertura"
                                        meta:resourcekey="BoundFieldResource17"></asp:BoundField>
                                    <asp:BoundField DataField="Data_Raccolta" HeaderText="Data Raccolta" SortExpression="Data_Raccolta"
                                        meta:resourcekey="BoundFieldResource18"></asp:BoundField>
                                    <asp:BoundField DataField="Data_Semina_Prevista" HeaderText="Data Semina Prevista"
                                        SortExpression="Data_Semina_Prevista" meta:resourcekey="BoundFieldResource19"></asp:BoundField>
                                    <asp:BoundField DataField="N_Massimo" HeaderText="N Massimo [Kg/Ha]" SortExpression="N_Massimo"
                                        meta:resourcekey="BoundFieldResource25"></asp:BoundField>
                                    <asp:BoundField DataField="P_Massimo" HeaderText="P Massimo [Kg/Ha]" SortExpression="P_Massimo"
