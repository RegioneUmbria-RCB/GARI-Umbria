            Me.results = results
        End Sub
        
        '''<remarks/>
        Public ReadOnly Property Result() As ISWSToOprResponse
            Get
                Me.RaiseExceptionIfNecessary
                Return CType(Me.results(0),ISWSToOprResponse)
            End Get
        End Property
    End Class
End Namespace
