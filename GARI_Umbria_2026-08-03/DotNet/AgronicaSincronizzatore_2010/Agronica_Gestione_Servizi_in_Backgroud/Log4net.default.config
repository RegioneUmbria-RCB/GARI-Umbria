<log4net>
	<!--APPENDERS-->
	<appender name="ColoredConsoleAppender" type="log4net.Appender.ColoredConsoleAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %level %message%newline" />
		</layout>
		<mapping>
			<level value="INFO" />
			<foreColor value="White" />
		</mapping>
		<mapping>
			<level value="WARN" />
			<foreColor value="Yellow" />
		</mapping>
		<mapping>
			<level value="ERROR" />
			<foreColor value="Red" />
		</mapping>
	</appender>
	<appender name="Application_Appender" type="log4net.Appender.RollingFileAppender">
		<file value="Log\Console.log" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<preserveLogFileNameExtension value="true" />
		<datePattern value="_yyyyMMdd" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %level %message%newline" />
		</layout>
	</appender>
	<appender name="Imp_RSBilance" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="%property{PercorsoLog_Imp_RSBilance}\Imp_RSBilance.log" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<preserveLogFileNameExtension value="true" />
		<datePattern value="_yyyyMMdd" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %level %message%newline" />
		</layout>
	</appender>
	<appender name="Exp_RsBilance" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="%property{PercorsoLog_Exp_RsBilance}\Exp_RsBilance.log" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<preserveLogFileNameExtension value="true" />
		<datePattern value="_yyyyMMdd" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %level %message%newline" />
		</layout>
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
	</appender>
	<appender name="Imp_Unitec" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="%property{PercorsoLog_Imp_Unitec}\Imp_Unitec.log" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<preserveLogFileNameExtension value="true" />
		<datePattern value="_yyyyMMdd" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %level %message%newline" />
		</layout>
	</appender>
	<appender name="Imp_Malavasi_Ang" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="%property{PercorsoLog_Imp_Malavasi_Ang}\Imp_Malavasi_Ang.log" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<preserveLogFileNameExtension value="true" />
		<datePattern value="_yyyyMMdd" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %level %message%newline" />
		</layout>
	</appender>
	<appender name="Imp_Malavasi_Mel" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="%property{PercorsoLog_Imp_Malavasi_Mel}\Imp_Malavasi_Mel.log" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<preserveLogFileNameExtension value="true" />
		<datePattern value="_yyyyMMdd" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %level %message%newline" />
		</layout>
	</appender>
	<appender name="Exp_Malavasi_Ang" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="%property{PercorsoLog_Exp_Malavasi_Ang}\Exp_Malavasi_Ang.log" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<preserveLogFileNameExtension value="true" />
		<datePattern value="_yyyyMMdd" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %level %message%newline" />
		</layout>
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
	</appender>
	<appender name="Exp_Malavasi_Mel" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="%property{PercorsoLog_Exp_Malavasi_Mel}\Exp_Malavasi_Mel.log" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<preserveLogFileNameExtension value="true" />
		<datePattern value="_yyyyMMdd" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %level %message%newline" />
		</layout>
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
	</appender>
	<!--ROOT-->
	<root>
		<level value="INFO" />
		<appender-ref ref="ColoredConsoleAppender" />
		<appender-ref ref="Application_Appender" />
	</root>
	<!--LOGGERS-->
	<logger name="Imp_RSBilance">
		<level value="INFO" />
		<appender-ref ref="Imp_RSBilance" />
	</logger>
	<logger name="Exp_RsBilance">
		<level value="INFO" />
		<appender-ref ref="Exp_RsBilance" />
	</logger>
	<logger name="Imp_Unitec">
		<level value="INFO" />
		<appender-ref ref="Imp_Unitec" />
	</logger>
	<logger name="Imp_Malavasi_Ang">
		<level value="INFO" />
		<appender-ref ref="Imp_Malavasi_Ang" />
	</logger>
	<logger name="Imp_Malavasi_Mel">
		<level value="INFO" />
		<appender-ref ref="Imp_Malavasi_Mel" />
	</logger>
	<logger name="Exp_Malavasi_Ang">
		<level value="INFO" />
		<appender-ref ref="Exp_Malavasi_Ang" />
	</logger>
	<logger name="Exp_Malavasi_Mel">
		<level value="INFO" />
		<appender-ref ref="Exp_Malavasi_Mel" />
	</logger>
</log4net>