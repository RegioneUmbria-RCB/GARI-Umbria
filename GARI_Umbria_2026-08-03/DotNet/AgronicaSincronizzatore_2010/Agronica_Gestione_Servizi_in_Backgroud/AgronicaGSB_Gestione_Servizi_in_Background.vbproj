    <PostBuildEvent>SET ORIGINPATH="$(SolutionDir)packages\GDAL.Native.3.9.1\build\gdal\*.*"
SET RELEASEPATH="$(SolutionDir)Agronica_Gestione_Servizi_in_Backgroud\bin\$(ConfigurationName)\gdal"

ECHO "Origine: %25ORIGINPATH%25"
ECHO "Destinazione: %25RELEASEPATH%25"

rmdir /S /Q %25RELEASEPATH%25
mkdir %25RELEASEPATH%25
xcopy /E %25ORIGINPATH%25 %25RELEASEPATH%25</PostBuildEvent>
