<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.1.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>Agronica - Etichetta casella Testo</Title>
      <Author>Fede</Author>
      <Shortcut>aect</Shortcut>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>id</ID>
          <ToolTip>id controllo</ToolTip>
          <Default>id</Default>
        </Literal>        
        <Literal>
          <ID>titolo</ID>
          <ToolTip>titolo</ToolTip>
          <Default>Titolo</Default>
        </Literal>
        <Literal>
          <ID>body</ID>
          <ToolTip>Contenuto</ToolTip>
          <Default>Contenuto</Default>
        </Literal>


      </Declarations>
      <Code Language="html">
        <![CDATA[
        <!--  -->        
      <div class="input-group" id ="$id$">
          <label class="input-group-addon control-label " id="lbl_$id$" for="Txt_$id$">
              $titolo$</label>
          <input class="form-control" id="Txt_$id$" aria-describedby="lbl_$id$" type="text"/>
      </div>
        ]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>