<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.1.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>Agronica, imposta src di Iframe</Title>
      <Author>Vanni</Author>
      <Shortcut></Shortcut>
      <HelpUrl></HelpUrl>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>id</ID>
          <ToolTip>id iframe</ToolTip>
          <Default>id</Default>
        </Literal>
        <Literal>
          <ID>src</ID>
          <ToolTip>src iframe</ToolTip>
          <Default>url</Default>
        </Literal>
      </Declarations>
      <Code Language="jscript">
        <![CDATA[
        var url="src";
        $$("#$id$").attr("src", url);
        
        ]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
