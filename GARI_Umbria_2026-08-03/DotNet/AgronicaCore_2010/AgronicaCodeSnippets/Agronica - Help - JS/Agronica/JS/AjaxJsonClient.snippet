<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.1.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>jQuery: $.ajax() template - con Gestione Session</Title>
      <Author>Vanni</Author>
      <Shortcut>jqajaxs</Shortcut>
      <HelpUrl>http://jquerysnippets.codeplex.com</HelpUrl>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>funzione</ID>
          <ToolTip>Nome della funzione</ToolTip>
          <Default>funzione</Default>
        </Literal>
        <Literal>
          <ID>indirizzohttp</ID>
          <ToolTip>The URL for the request</ToolTip>
          <Default>pagina</Default>
        </Literal>
        <Literal>
          <ID>url</ID>
          <ToolTip>The URL for the request</ToolTip>
          <Default>/url</Default>
        </Literal>
        <Literal>
          <ID>method</ID>
          <ToolTip>HTTP Method to use (GET, POST, etc.)</ToolTip>
          <Default>POST</Default>
        </Literal>
        <Literal>
          <ID>data</ID>
          <ToolTip>Data to send (querystring)</ToolTip>
          <Default>{ Parametro: '" + Parametro + "' }</Default>
        </Literal>        
        <Literal>
          <ID>NomeMetodo</ID>
          <ToolTip>Nome Metodo da chiamare</ToolTip>
          <Default>NomeMetodo</Default>
        </Literal>
        <Literal>
          <ID>asincrono</ID>
          <ToolTip>Chiamata Asincrona (impostare a false per chiamata sincrona)</ToolTip>
          <Default>true</Default>
        </Literal>
      </Declarations>
      <Code Language="jscript">
        <![CDATA[

function $funzione$ () {
    $$('#WaitFrame').show();
    WaitFrame.show();
        
    $$.ajax({
    type: "$method$",
    url: indirizzohttp + "/$NomeMetodo$",
    data: "$data$",
    dataType: "json",
    async: $asincrono$,
    contentType: "application/json; charset=utf-8",
    error: function (xhr, textStatus, errorThrown) {
            $$('#WaitFrame').hide();
            WaitFrame.hide();
            MessaggioErrore_Bootstrap("Si è verificato un problema prima della chiamata in Ajax: " + textStatus, "DIV_Messaggi");             
     },
    success: function(msg) {
           
            if (!msg.d.Sessione) {
                MessaggioErrore_Bootstrap("Sessione scaduta.", "DIV_Messaggi"); 
            }
            else {
                if (msg.d.RispostaOK) {
                
                    var msg_d = msg.d.RispostaStringa;                  
                    //codice success
                    
                }
                else
                    MessaggioErrore_Bootstrap("Si è verificato un problema lato server (Errore 500):" + msg.d.Errore, 'DIV_Messaggi');
            }
            
            $$('#WaitFrame').hide();
            WaitFrame.hide();
    }
  });
  }]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
