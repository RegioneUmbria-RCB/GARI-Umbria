<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.1.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>Bootstrap 3 - Collapse - aggiunta 1 pannello</Title>
      <Author>Vanni</Author>
      <Shortcut>shortcut</Shortcut>      
    </Header>    
    <Snippet>
      <Declarations>
        <Literal>
          <ID>id</ID>
          <ToolTip>id client del collapse</ToolTip>
          <Default>id</Default>
        </Literal>
        <Literal>
          <ID>titolo</ID>
          <ToolTip>titolo</ToolTip>
          <Default>Titolo</Default>
        </Literal>
        <Literal>
          <ID>body</ID>
          <ToolTip>Contenuto del modal</ToolTip>
          <Default>Contenuto del modal</Default>
        </Literal>
        
        <Literal>
          <ID>chiudi</ID>
          <ToolTip>chiudi</ToolTip>
          <Default>chiudi</Default>
        </Literal>
      </Declarations>
      <Code Language="html">
        <![CDATA[
        <!-- Pannello $titolo$-->
                <div class="panel panel-primary" id="$id$">
                    <div class="panel-heading">
                        <h4 class="panel-title">
                            <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#pannello-$id$">
                                $titolo$</a>
                        </h4>
                    </div>
                    <div id="pannello-$id$" class="panel-collapse collapse in">
                        <div class="panel-body">
                            $body$
                        </div>
                    </div>
                </div>
        ]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>