<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.1.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>Agronica - Etichetta casella Testo (bootstrap)</Title>
      <Author>Vanni</Author>
      <Shortcut>aect</Shortcut>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>id</ID>
          <ToolTip>id controllo</ToolTip>
          <Default>id</Default>
        </Literal>
        <Literal>
          <ID>titolo</ID>
          <ToolTip>titolo</ToolTip>
          <Default>Titolo</Default>
        </Literal>
        <Literal>
          <ID>note</ID>
          <ToolTip>note</ToolTip>
          <Default></Default>
        </Literal>
        <Literal>
          <ID>body</ID>
          <ToolTip>Contenuto</ToolTip>
          <Default>Contenuto</Default>
        </Literal>
        <Literal>
          <ID>NumeroGriglia</ID>
          <ToolTip>numero nella griglia</ToolTip>
          <Default>1</Default>
        </Literal>

      </Declarations>
      <Code Language="html">
        <![CDATA[<!-- $titolo$ -->        
            <div class="col-lg-$NumeroGriglia$ col-md-$NumeroGriglia$ col-sm-12 col-xs-12">
			    <div class="input-group" id="div_$id$">
                    <label class="input-group-addon control-label " id="lbl_$id$" for="txt_$id$">
                        <asp:Localize meta:resourcekey="lbl_$id$" runat="server">$titolo$</asp:Localize>
                    </label>
                    <input class="form-control" id="txt_$id$" aria-describedby="lbl_txt_$id$" type="text" />
                </div>
			</div>]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>