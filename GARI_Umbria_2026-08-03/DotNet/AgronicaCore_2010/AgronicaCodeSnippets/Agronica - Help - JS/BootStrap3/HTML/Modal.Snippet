<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.1.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>Bootstrap 3 - Modal</Title>
      <Author>John Sheehan</Author>
      <Shortcut>shortcut</Shortcut>      
    </Header>    
    <Snippet>
      <Declarations>
        <Literal>
          <ID>id</ID>
          <ToolTip>id client del modal</ToolTip>
          <Default>id</Default>
        </Literal>
        <Literal>
          <ID>titolo</ID>
          <ToolTip>titolo</ToolTip>
          <Default>Titolo</Default>
        </Literal>
        <Literal>
          <ID>body</ID>
          <ToolTip>Contenuto del modal</ToolTip>
          <Default>Contenuto del modal</Default>
        </Literal>
        
        <Literal>
          <ID>chiudi</ID>
          <ToolTip>chiudi</ToolTip>
          <Default>chiudi</Default>
        </Literal>
      </Declarations>
      <Code Language="html">
        <![CDATA[
        <!-- dialog modale -->
        <div class="modal fade" id="$id$">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title"><asp:label ID="lblStampa$id$" runat="server">$Titolo$</asp:label></h4>
              </div>
              <div class="modal-body">
                <p>$body$&hellip;</p>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">$chiudi$</button>                
              </div>
            </div><!-- /.modal-content -->
          </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
        ]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>