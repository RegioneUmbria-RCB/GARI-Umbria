<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Data Creazione, modifica, ecc.. (insert nella query)</Title>
      <Author>vanni</Author>
      <Shortcut>collegamento</Shortcut>
      <Description>Aggiunge l'assegnazione di data creazione, modifica, username (insert nella query)</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>Data Creazione, modifica, ecc..</ID>
          <Default>Data Creazione, modifica, ecc..</Default>
        </Literal>
      </Declarations>
      <Code Language="VB">
        <![CDATA[StrSQL.Append(" , 0 " & vbCrLf)
StrSQL.Append("		, NULL ")
StrSQL.Append("			, " & Agro_SQL_SaveDate(Data_creazione) & "  " & vbCrLf)
StrSQL.Append("			, " & Agro_SQL_SaveDate(Data_modifica) & "  " & vbCrLf)
StrSQL.Append("			,'" & Agro_SQL_SaveText(username_creazione) & "' " & vbCrLf)
StrSQL.Append("			,'" & Agro_SQL_SaveText(username_modifica) & "' " & vbCrLf)
]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>