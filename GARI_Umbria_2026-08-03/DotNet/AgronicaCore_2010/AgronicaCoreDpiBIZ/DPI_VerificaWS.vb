                            End If

                        End If


                        XmlPrincipioAttivo = XmlDoc.CreateElement("PrincipioAttivo")
                        XmlPrincipioAttivo.SetAttribute("fr_cod", PrincipiAttivi(COL_FR_COD, Riga))
