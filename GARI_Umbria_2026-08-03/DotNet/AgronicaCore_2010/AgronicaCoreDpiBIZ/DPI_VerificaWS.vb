                            'EPOCHE/FASI
                            '(22/01/2019 fede) introdotto controllo nella tabella FormulatixSpecieVegetalixBlocchi
                            If Veg_Cod <> "0" Then

                                Dim objFSB As New AgronicaCoreMetaSchemaDAL.FormulatixSpecieVegetalixBlocchi_R
                                Dim Dt_Blocchi As DataTable
                                Dt_Blocchi = objFSB.Leggi(0, Pro_Cod, Veg_Cod, "", "", objParametri_Matrice)
                                Dim strEpoche As String = ""
                                For Each dr_blocchi As DataRow In Dt_Blocchi.Rows
                                    strEpoche &= dr_blocchi("epoca_da") & "," & dr_blocchi("epoca_a") & ","
                                Next
