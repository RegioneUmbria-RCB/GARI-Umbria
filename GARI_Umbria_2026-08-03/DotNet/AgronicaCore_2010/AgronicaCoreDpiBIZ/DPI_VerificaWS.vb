                                                                                                                         strPA,
                                                                                                                         0, 0, 0, "",
                                                                                                                         CStr(Destinazioni(i_Validita_Inizio, i)),
                                                                                                                         CStr(Destinazioni(i_Validita_Fine, i)),
                                                                                                                         CDbl(Destinazioni(i_Sup_Trattata, i)),
                                                                                                                         0, 0, 0, 0, 0,
                                                                                                                         "", 0, 0, 0, 0,
                                                                                                                         Elenco_Fr_Cod_LU, Collegamento_Formulati_LU, 0)

                                                                                                        N_Warning += 1

                                                                                                    Case enTipoWarning_Verifica.Numero_Interventi_Min

                                                                                                        Select Case bSensibilita
                                                                                                            Case False
                                                                                                                'Warning_Des = "Il numero di interventi effettuati con '" & ElencoPA(strPA, Terna, objParametri_Matrice) & "' (" & Num_Interventi + Intervento_Insert & ") nell'impianto lotto " & CStr(Destinazioni(4, i)) & " " & strPeriodo & ", non raggiunge il numero minimo di interventi richiesti con tale insieme di principi attivi."
                                                                                                                Warning_Des = "Il numero di interventi effettuati con '" & ElencoPA(strPA, Terna, objParametri_Matrice) & "' (" & Num_Interventi + Intervento_Insert & ") " & strPeriodo & " non raggiunge il numero minimo di interventi richiesti con tale insieme di principi attivi."

                                                                                                            Case True
                                                                                                                'Warning_Des = "Il trattamento non è ammesso sull'impianto " & CStr(Destinazioni(4, i)) & " in quanto non sensibile all'avversità " & Avversita_Des & "."
                                                                                                                Warning_Des = "Il trattamento non è ammesso in quanto non sensibile all'avversità " & Avversita_Des & "."
                                                                                                        End Select

                                                                                                        Inserisci_Warning(XmlDoc,
                                                                                                                         XmlDatiWarnings,
                                                                                                                         N_Warning,
                                                                                                                         Warning_Code,
                                                                                                                         Warning_Des,
                                                                                                                         CStr(Destinazioni(i_Piva, i)),
                                                                                                                         CInt(Destinazioni(i_Sa_Cod, i)),
                                                                                                                         CInt(Destinazioni(i_Appezza, i)),
                                                                                                                         CInt(Destinazioni(i_Id_Reg, i)),
                                                                                                                         CStr(Destinazioni(i_Lotto, i)),
                                                                                                                         0, 0,
                                                                                                                         strAvversita, strGruppiAvversita,
                                                                                                                         Pro_Cod, Pro_Des,
                                                                                                                         0, "", 0, "", 0, "", 0,
                                                                                                                         0,
                                                                                                                         Intervento_Insert,
                                                                                                                         0, 0, 0, 0,
                                                                                                                         strPA,
                                                                                                                         0, 0, 0, "",
                                                                                                                         CStr(Destinazioni(i_Validita_Inizio, i)),
                                                                                                                         CStr(Destinazioni(i_Validita_Fine, i)),
                                                                                                                         CDbl(Destinazioni(i_Sup_Trattata, i)),
                                                                                                                         0, 0, 0, 0, 0,
                                                                                                                         "", Min_Interventi, 0, 0, 0,
                                                                                                                         "", 0, 0)

                                                                                                        N_Warning += 1

                                                                                                    ''===============================================================================
                                                                                                    ''CONTROLLO Dose Max Anno
                                                                                                    ''(16/12/2016 fede) introdotta x gestione deroga rame
                                                                                                    ''-------------------------------------------------------------------------------
                                                                                                    Case enTipoWarning_Verifica.DoseDPI_MaxAnno

                                                                                                        Warning_Code = enTipoWarning_Verifica.DoseDPI_MaxAnno

                                                                                                        Select Case bSensibilita

                                                                                                            Case False
                                                                                                                Warning_Des = "La dose massima annua di utilizzo di '" & ElencoPA_conMiscele(strPA, Terna, objParametri_Matrice) & "' (" & Num_Interventi + Intervento_Insert & ") nell'impianto lotto deve essere " & DoseMaxAnno.ToString
                                                                                                            Case True
                                                                                                                Warning_Des = "Il trattamento non è ammesso sull'impianto " & CStr(Destinazioni(4, i)) & " in quanto non sensibile all'avversità " & Avversita_Des & "."
                                                                                                        End Select

                                                                                                        Inserisci_Warning(XmlDoc,
                                                                                                                              XmlDatiWarnings,
                                                                                                                                    N_Warning, Warning_Code,
                                                                                                                                    Warning_Des,
                                                                                                                                    CStr(Destinazioni(i_Piva, i)),
                                                                                                                                    CInt(Destinazioni(i_Sa_Cod, i)),
                                                                                                                                    CInt(Destinazioni(i_Appezza, i)),
                                                                                                                                    CInt(Destinazioni(i_Id_Reg, i)),
                                                                                                                                    CStr(Destinazioni(i_Lotto, i)),
                                                                                                                                    0, 0,
                                                                                                                                    strAvversita, strGruppiAvversita,
                                                                                                                                    Pro_Cod, Pro_Des, 0, "", 0, "", 0, "", 0,
                                                                                                                                    0,
                                                                                                                                    Intervento_Insert,
                                                                                                                                    0, 0, 0, 0,
                                                                                                                                    strPA,
                                                                                                                                    0, 0, 0, "",
                                                                                                                                    CStr(Destinazioni(i_Validita_Inizio, i)),
                                                                                                                                    CStr(Destinazioni(i_Validita_Fine, i)),
                                                                                                                                    CDbl(Destinazioni(i_Sup_Trattata, i)),
                                                                                                                                    0, 0,
                                                                                                                                    DoseMaxAnno,
                                                                                                                                    0, 0, "", 0, 0, 0, 0,
                                                                                                                                    "", 0, 0)

                                                                                                        N_Warning += 1

                                                                                                End Select

                                                                                            End If


                                                                                        Else

                                                                                            bInserimentoWarningOttimizzato = False
                                                                                            LastRegolamento = CInt(Destinazioni(i_Regolamento, i))
                                                                                            LastCul_Cod = CInt(Destinazioni(i_Cul_Cod, i))

                                                                                            bBloccato = False

                                                                                            'Controllo che la limitazioni non sia bloccata
                                                                                            'Regolamenti Validi: Nessuno(1), 28/98(3), 2200/96(8), 28/99(9)

                                                                                            Select Case TipoRegolamento1_3_8_9(CInt(Destinazioni(i_Regolamento, i)))

                                                                                                Case True 'Ok

                                                                                                    For j = 0 To UBound(LimitazioniBloccate, 1) - 1
                                                                                                        If CInt(LimitazioniBloccate(j)) = CInt(dtLimitazioni.Rows(iLim).Item("Id_Lu")) Then
                                                                                                            bBloccato = True
                                                                                                            Exit For
                                                                                                        End If
                                                                                                    Next j

                                                                                                    For j = 0 To UBound(LimitazioniBloccatexCultivar, 1) - 1
                                                                                                        If LimitazioniBloccatexCultivar(j) = dtLimitazioni.Rows(iLim).Item("Id_Lu") & "|" & LastCul_Cod Then
                                                                                                            bBloccato = True
                                                                                                            Exit For
                                                                                                        End If
                                                                                                    Next j


                                                                                                Case False

                                                                                                    bBloccato = False

                                                                                            End Select




                                                                                            '===================================================================================================


                                                                                            If Not bBloccato Then

                                                                                                'Principio Attivo Valido

                                                                                                'verifico se il principio attivo è valido
                                                                                                dtPA = objDPI.Verifica_PrincipioAttivo(CInt(dtLimitazioni.Rows(iLim).Item("Id_PAA")),
                                                                                                                                              CInt(Destinazioni(i_Regolamento, i)),
                                                                                                                                              "", "", objParametri_Disciplinari)

                                                                                                bPA_Ammesso = If(dtPA.Rows.Count <> 0, True, False)

                                                                                                bPA_Ammesso = True

                                                                                                If Not bPA_Ammesso Then
                                                                                                    bByPass = True
                                                                                                End If

                                                                                                If bPA_Ammesso Then

                                                                                                    bByPass = False 'Reset Bypass

                                                                                                    '===============================================================================
                                                                                                    'CONTROLLO DEROGHE
                                                                                                    '-------------------------------------------------------------------------------

                                                                                                    If Not IsDBNull(dtLimitazioni.Rows(iLim).Item("Deroga")) Then
                                                                                                        If CBool(dtLimitazioni.Rows(iLim).Item("Deroga")) Then

                                                                                                            'Verifico che il regolamento sia Valido
                                                                                                            'Regolamenti Validi: Nessuno(1), 28/98(3), 2200/96(8), 28/99(9)

                                                                                                            Select Case TipoRegolamento1_3_8_9(CInt(Destinazioni(i_Regolamento, i)))
                                                                                                                Case True 'Ok

                                                                                                                    Dim dtLimitazioniBloccate As DataTable

                                                                                                                    dtLimitazioniBloccate = objDPI.Leggi_LimitazioniUsoxLimitazioniUsoDaBloccare(CInt(dtLimitazioni.Rows(iLim).Item("Id_Lu")),
                                                                                                                                                                                                        "",
                                                                                                                                                                                                        "",
                                                                                                                                                                                                        objParametri_Disciplinari)

                                                                                                                    If dtLimitazioniBloccate.Rows.Count <> 0 Then
                                                                                                                        'Do While Not RsLimitazioniBloccate.EOF
                                                                                                                        Dim iLB As Integer
                                                                                                                        For iLB = 0 To dtLimitazioniBloccate.Rows.Count - 1
                                                                                                                            ReDim Preserve LimitazioniBloccate(UBound(LimitazioniBloccate, 1) + 1)
                                                                                                                            LimitazioniBloccate(UBound(LimitazioniBloccate, 1) - 1) = Agro_SQL_SaveNum(dtLimitazioniBloccate.Rows(iLB).Item("Lu_DaBloccare_Cod"))
                                                                                                                        Next iLB
                                                                                                                    End If

                                                                                                                Case Else
                                                                                                                    bByPass = True

                                                                                                            End Select

                                                                                                        End If

                                                                                                    End If


                                                                                                    '===============================================================================
                                                                                                    'CONTROLLO ELASTICITA'
                                                                                                    '-------------------------------------------------------------------------------
                                                                                                    '(15/12/2016 fede) reintrodotte x gestire limitazioni su clutivar (x ora)
                                                                                                    'elasticita = 1; cul_cod = 1; 
                                                                                                    'elenco varietà coinvolte nella limitazione nella tabella LimitazioniUsoXCultivar; 
                                                                                                    'record in LimitazioniUsoxLimitazioniUsoDaBloccare x bloccare la limitazione su tette le altre varieta 
                                                                                                    '(es. melo trentino 2016 captano e dithianon 12/14 trattamenti ammessi a seconda della varietà)
                                                                                                    If Not IsDBNull(dtLimitazioni.Rows(iLim).Item("FlagElasticita")) Then
                                                                                                        If CBool(dtLimitazioni.Rows(iLim).Item("FlagElasticita")) Then

                                                                                                            'Verifico che il regolamento sia Valido
                                                                                                            'Regolamenti Validi: Nessuno(1), 28/98(3), 2200/96(8), 28/99(9)

                                                                                                            Select Case TipoRegolamento1_3_8_9(CInt(Destinazioni(i_Regolamento, i)))
                                                                                                                Case True 'Ok

                                                                                                                    'verifico se l'elasticità è legata alla varieta
                                                                                                                    'in tal caso verifico se la varieta corrente è coinvolta
                                                                                                                    If Not IsDBNull(dtLimitazioni.Rows(iLim).Item("cul_cod")) AndAlso CInt(dtLimitazioni.Rows(iLim).Item("cul_cod")) = 1 Then

                                                                                                                        Dim dtLimitazioniUsoXCultivar As DataTable
                                                                                                                        dtLimitazioniUsoXCultivar = objDPI.Leggi_LimitazioniUsoxCultivar(CInt(dtLimitazioni.Rows(iLim).Item("id_lu")),
                                                                                                                                                                                LastCul_Cod,
                                                                                                                                                                                "",
                                                                                                                                                                                "",
                                                                                                                                                                                objParametri_Disciplinari)

                                                                                                                        If dtLimitazioniUsoXCultivar.Rows.Count = 0 Then
                                                                                                                            bByPass = True
                                                                                                                        End If

                                                                                                                    End If

                                                                                                                    If Not bByPass Then

                                                                                                                        Dim dtLimitazioniBloccate As DataTable
                                                                                                                        dtLimitazioniBloccate = objDPI.Leggi_LimitazioniUsoxLimitazioniUsoDaBloccare(CInt(dtLimitazioni.Rows(iLim).Item("Id_Lu")),
                                                                                                                                                                                                            "",
                                                                                                                                                                                                            "",
                                                                                                                                                                                                            objParametri_Disciplinari)

                                                                                                                        If dtLimitazioniBloccate.Rows.Count <> 0 Then
                                                                                                                            'Do While Not RsLimitazioniBloccate.EOF
                                                                                                                            Dim iLB As Integer

                                                                                                                            For iLB = 0 To dtLimitazioniBloccate.Rows.Count - 1
                                                                                                                                ReDim Preserve LimitazioniBloccatexCultivar(UBound(LimitazioniBloccatexCultivar, 1) + 1)
                                                                                                                                LimitazioniBloccatexCultivar(UBound(LimitazioniBloccatexCultivar, 1) - 1) = Agro_SQL_SaveNum(dtLimitazioniBloccate.Rows(iLB).Item("Lu_DaBloccare_Cod")) & "|" & LastCul_Cod
                                                                                                                            Next iLB
                                                                                                                        End If
                                                                                                                    End If

                                                                                                                Case Else
                                                                                                                    bByPass = True

                                                                                                            End Select

                                                                                                        End If

                                                                                                    End If

                                                                                                End If

                                                                                                '====================================================================================================

                                                                                                'Verifico se il filtro è da bypassare poichè soggetto a limitazioni sulle colture sensibili
                                                                                                If Not bByPass Then

                                                                                                    '===============================================================================
                                                                                                    'CONTROLLO COLTURE SENSIBILI
                                                                                                    '-------------------------------------------------------------------------------
                                                                                                    bSensibilita = False

                                                                                                    If Not IsDBNull(dtLimitazioni.Rows(iLim).Item("Av_Cod_Riferimento")) AndAlso CInt(dtLimitazioni.Rows(iLim).Item("Av_Cod_Riferimento")) <> 0 Then
                                                                                                        'If Agro_SQL_SaveNum(dtLimitazioni.Rows(iLim).Item("Av_Cod_Riferimento")) <> 0 Then

                                                                                                        'Lettura delle Cultivar Sensibili
                                                                                                        Dim dtCultivar_Sensibili As DataTable
                                                                                                        Dim bSensibile As Boolean

                                                                                                        dtCultivar_Sensibili = objDPI.Leggi_Cultivar_Sensibili(CInt(dtLimitazioni.Rows(iLim).Item("Av_Cod_Riferimento")),
                                                                                                                                                                    "",
                                                                                                                                                                    "",
                                                                                                                                                                    objParametri_Disciplinari)

                                                                                                        bSensibilita = True
                                                                                                        'Verifico se la cultivar dell'impianto è compresa tra quelle sensibili
                                                                                                        bSensibile = False

                                                                                                        If dtCultivar_Sensibili.Rows.Count <> 0 Then

                                                                                                            'RsCultivar_Sensibili.Filter = "Cul_Cod = " & cint(Destinazioni(i_Cul_Cod, i))
                                                                                                            Dim Dr() As DataRow
                                                                                                            Dr = dtCultivar_Sensibili.Select("Cul_Cod = " & CInt(Destinazioni(i_Cul_Cod, i)))
                                                                                                            If Not Dr Is Nothing AndAlso Dr.Length > 0 Then
                                                                                                                bSensibile = True
                                                                                                            End If
                                                                                                        End If


                                                                                                        Select Case CInt(dtLimitazioni.Rows(iLim).Item("Flag_Sensibili"))
                                                                                                            Case 0 'Nessun vinolo di sensibilità

                                                                                                            Case 1 'Escluso Sensibili
                                                                                                                If bSensibile Then
                                                                                                                    bByPass = True 'Il vincolo deve essere bypassato poichè la coltura è sensibile
                                                                                                                End If

                                                                                                            Case 2 'Solo Sensibili
                                                                                                                If Not bSensibile Then
                                                                                                                    bByPass = True 'Il vincolo deve essere bypassato poichè la coltura non è sensibile
                                                                                                                End If

                                                                                                        End Select

                                                                                                    End If

                                                                                                End If


                                                                                                '===============================================================================
                                                                                                If Not bByPass Then

                                                                                                    '===============================================================================
                                                                                                    'CONTROLLO NOTE TRATTATMENTO
                                                                                                    '-------------------------------------------------------------------------------
                                                                                                    If Not IsDBNull(dtLimitazioni.Rows(iLim).Item("NoteTrattamento_Cod")) AndAlso CInt(dtLimitazioni.Rows(iLim).Item("NoteTrattamento_Cod")) <> 0 Then

                                                                                                        'Lettura delle Note Trattamento
                                                                                                        Dim dtNote_Trattamento As DataTable
                                                                                                        Dim strQuery As String

                                                                                                        dtNote_Trattamento = objDPI.Leggi_NoteTrattamento(CInt(dtLimitazioni.Rows(iLim).Item("NoteTrattamento_Cod")),
                                                                                                                                                                "",
                                                                                                                                                                "",
                                                                                                                                                                objParametri_Disciplinari)

                                                                                                        If dtNote_Trattamento.Rows.Count <> 0 Then

                                                                                                            bByPass = True
                                                                                                            strQuery = CStr(dtNote_Trattamento.Rows(0).Item("NoteTrattamento_Des"))

                                                                                                        End If

                                                                                                    End If


                                                                                                    If Not bByPass Then


                                                                                                        '================================================================================
                                                                                                        'CONTROLLO LINEE DI INTERVENTO (GRUPPO ESCLUSIVITA')
                                                                                                        '--------------------------------------------------------------------------------

                                                                                                        Applicabilita_GPAI = CInt(dtLimitazioni.Rows(iLim).Item("Flag_Usato_Gpai_PA_Ausiliari"))

                                                                                                        'Dim dtLineeIntervento As DataTable
                                                                                                        Dim Ge_Paa_Cod As Integer = 0
                                                                                                        Dim LineaIntervento As Integer = 0

                                                                                                        If Not IsDBNull(dtLimitazioni.Rows(iLim).Item("Ge_Paa_Cod")) Then
                                                                                                            Ge_Paa_Cod = CInt(dtLimitazioni.Rows(iLim).Item("Ge_Paa_Cod"))
                                                                                                        End If

                                                                                                        If Not IsDBNull(dtLimitazioni.Rows(iLim).Item("LineaIntervento")) Then
                                                                                                            LineaIntervento = CInt(dtLimitazioni.Rows(iLim).Item("LineaIntervento"))
                                                                                                        End If

                                                                                                        Select Case Ge_Paa_Cod

                                                                                                            Case Is > 0 'Esclusività presente

                                                                                                                If dtLineeIntervento.Rows.Count = 0 Then

                                                                                                                    'Lettura delle linee intervento valide (cioè quelle aventi medesimo ge_paa_cod)
                                                                                                                    dtLineeIntervento = objDPI.Leggi_LineeIntervento(Ge_Paa_Cod,
                                                                                                                                                                            0,
                                                                                                                                                                            "",
                                                                                                                                                                            "",
                                                                                                                                                                            objParametri_Disciplinari)
                                                                                                                ElseIf dtLineeIntervento.Rows.Count > 0 Then

                                                                                                                    'Verifico che la linea di intervento sia valida
                                                                                                                    'RSLineeIntervento.MoveFirst()
                                                                                                                    Applicabilita_GPAI = -1

                                                                                                                    'Do While Not RSLineeIntervento.EOF
                                                                                                                    Dim iLI As Integer
                                                                                                                    For iLI = 0 To dtLineeIntervento.Rows.Count - 1
                                                                                                                        If dtLineeIntervento.Rows(iLI).Item("LineaIntervento") = LineaIntervento Then
                                                                                                                            'Trovato
                                                                                                                            Applicabilita_GPAI = CInt(dtLimitazioni.Rows(iLim).Item("Flag_Usato_Gpai_PA_Ausiliari"))
                                                                                                                        End If
                                                                                                                    Next iLI
                                                                                                                Else

                                                                                                                    'Nessuna Linea di Intervento Valida Rimasta
                                                                                                                    Applicabilita_GPAI = -1
                                                                                                                End If

                                                                                                            Case Is = 0 'Esclusività Assente

                                                                                                        End Select



                                                                                                        '===============================================================================
                                                                                                        'CONTROLLO SULL'EPOCA
                                                                                                        '-------------------------------------------------------------------------------
                                                                                                        Da_Epoca_Cod = 0
                                                                                                        Da_Epoca_Des = ""
                                                                                                        A_Epoca_Cod = 0
                                                                                                        A_Epoca_Des = ""

                                                                                                        bEpoca_Setting = False

                                                                                                        If Not IsDBNull(dtLimitazioni.Rows(iLim).Item("Offset_GG_A_EP_COD")) Then
                                                                                                            Offset = CInt(dtLimitazioni.Rows(iLim).Item("Offset_GG_A_EP_COD"))
                                                                                                        Else
                                                                                                            Offset = 0
                                                                                                        End If

                                                                                                        Dim dtEpoca As DataTable
                                                                                                        If Not IsDBNull(dtLimitazioni.Rows(iLim).Item("Da_Ep_Cod")) AndAlso CInt(dtLimitazioni.Rows(iLim).Item("Da_Ep_Cod")) <> 0 Then
                                                                                                            'Vincolo su 'Epoca Da'
                                                                                                            dtEpoca = ObjEpoca.Leggi(CInt(dtLimitazioni.Rows(iLim).Item("Da_Ep_Cod")),
                                                                                                                                         AGRODATAINIZIO,
                                                                                                                                         AGRODATAFINE,
                                                                                                                                         AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                                                                                         "",
                                                                                                                                         "",
                                                                                                                                         objParametri_Matrice)

                                                                                                            If dtEpoca.Rows.Count <> 0 Then
                                                                                                                Da_Epoca_Cod = CInt(dtEpoca.Rows(0).Item("Ep_Cod"))
                                                                                                                Da_Epoca_Des = LCase(dtEpoca.Rows(0).Item("Descrizione"))
                                                                                                                bEpoca_Setting = True
                                                                                                            End If

                                                                                                            dtEpoca = Nothing
                                                                                                        End If


                                                                                                        If Not IsDBNull(dtLimitazioni.Rows(iLim).Item("A_Ep_Cod")) AndAlso CInt(dtLimitazioni.Rows(iLim).Item("A_Ep_Cod")) <> 0 Then
                                                                                                            'Vincolo su 'Epoca A'
                                                                                                            dtEpoca = ObjEpoca.Leggi(CInt(dtLimitazioni.Rows(iLim).Item("A_Ep_Cod")),
                                                                                                                                         AGRODATAINIZIO,
                                                                                                                                         AGRODATAFINE,
                                                                                                                                         AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                                                                                         "",
                                                                                                                                         "",
                                                                                                                                         objParametri_Matrice)

                                                                                                            If dtEpoca.Rows.Count <> 0 Then
                                                                                                                A_Epoca_Cod = CInt(dtEpoca.Rows(0).Item("Ep_Cod"))
                                                                                                                A_Epoca_Des = LCase(dtEpoca.Rows(0).Item("Descrizione"))
                                                                                                                bEpoca_Setting = True
                                                                                                            End If

                                                                                                            dtEpoca = Nothing

                                                                                                        End If


                                                                                                        'Verifico se è stato impostato un controllo sulle epoche e se non esiste una linea di intervento alternativa
                                                                                                        If bEpoca_Setting And LineaInterventoInesistente(Err_Code, Err_Des, dtLineeIntervento, strLineeIntervento, Ge_Paa_Cod, LineaIntervento) Then

                                                                                                            '==========================================================================================
                                                                                                            'Verifica Warning Conformità sulle epoche
                                                                                                            '------------------------------------------------------------------------------------------
                                                                                                            Warning_Code = enTipoWarning_Verifica.Epoche
                                                                                                            Warning_Des = "Warning Conformità Epoca " & Da_Epoca_Des
                                                                                                            bInserimentoWarningOttimizzato = True

                                                                                                            Inserisci_Warning(XmlDoc,
                                                                                                                                  XmlDatiWarnings,
                                                                                                                                  N_Warning,
                                                                                                                                  Warning_Code,
                                                                                                                                  Warning_Des,
                                                                                                                            CStr(Destinazioni(i_Piva, i)),
                                                                                                                            CInt(Destinazioni(i_Sa_Cod, i)),
                                                                                                                                  CInt(Destinazioni(i_Appezza, i)),
                                                                                                                                  CInt(Destinazioni(i_Id_Reg, i)),
                                                                                                                                  CStr(Destinazioni(i_Lotto, i)),
                                                                                                                                  Av_Gru,
                                                                                                                                  Av_Cod,
                                                                                                                                  Avversita_Des, "",
                                                                                                                                  Pro_Cod,
                                                                                                                                  Pro_Des,
                                                                                                                                  Pa_Cod,
                                                                                                                                  Pa_Des,
                                                                                                                                  Da_Epoca_Cod,
                                                                                                                                  Da_Epoca_Des,
                                                                                                                                  A_Epoca_Cod,
                                                                                                                                  A_Epoca_Des,
                                                                                                                                  Offset,
                                                                                                                                  0, 0, 0, 0, 0, 0,
                                                                                                                                  "", 0, 0, 0, "",
                                                                                                                                  CStr(Destinazioni(i_Validita_Inizio, i)),
                                                                                                                                  CStr(Destinazioni(i_Validita_Fine, i)),
                                                                                                                                  CDbl(Destinazioni(i_Sup_Trattata, i)),
                                                                                                                                  Titolo, Peso,
                                                                                                                                  0, 0, 0,
                                                                                                                                  "", 0, 0, 0, 0,
                                                                                                                                  "", 0, 0)

                                                                                                            N_Warning += 1

                                                                                                        End If



                                                                                                        '===============================================================================
                                                                                                        'CONTROLLO SULLE SINGOLE DATE
                                                                                                        '-------------------------------------------------------------------------------

                                                                                                        If IsDate(dtLimitazioni.Rows(iLim).Item("Dal")) Then
                                                                                                            'Vincolo su 'Data Da'
                                                                                                            Da_Data = DateAdd("d", Offset, CDate(dtLimitazioni.Rows(iLim).Item("Dal")))

                                                                                                            If Da_Data > Data Then
                                                                                                                'Intervento eseguito prima del dovuto
                                                                                                                Err_Code = 350
                                                                                                                'Err_Des = "L'intervento colturale sull'impianto lotto " & Destinazioni(4, i) & " non può essere eseguito prima del " & Format(Da_Data, "dd/mm/yyyy")
                                                                                                                Err_Des = "L'intervento colturale sull'impianto lotto " & Destinazioni(4, i) & " non può essere eseguito prima del " & Da_Data.ToShortDateString
                                                                                                            End If
                                                                                                        End If


                                                                                                        If IsDate(dtLimitazioni.Rows(iLim).Item("Al")) Then
                                                                                                            'Vincolo su 'Data A'
                                                                                                            A_Data = DateAdd("d", Offset, CDate(dtLimitazioni.Rows(iLim).Item("Al")))
                                                                                                            If A_Data < Data Then
