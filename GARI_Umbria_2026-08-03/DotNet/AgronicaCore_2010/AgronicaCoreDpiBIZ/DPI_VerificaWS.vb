                                End If

                                If Dt_Blocchi.Rows.Count > 0 Then

                                    For eb = 0 To Dt_Blocchi.Rows.Count - 1

                                        Dim Epoca_DA As Integer = 0
                                        Dim Stadio_Da As String = ""
                                        Dim Epoca_A As Integer = 0
                                        Dim Stadio_A As String = ""

                                        If Not IsDBNull(Dt_Blocchi.Rows(eb).Item("epoca_da")) AndAlso IsNumeric(Dt_Blocchi.Rows(eb).Item("epoca_da")) Then
                                            Epoca_DA = CInt(Dt_Blocchi.Rows(eb).Item("epoca_da"))
                                            Dim drEpocaDa() As DataRow = Dt_Stadi.Select("ep_cod=" & Epoca_DA)
                                            If Not drEpocaDa Is Nothing AndAlso drEpocaDa.Length > 0 Then
                                                Select Case drEpocaDa(0).Item("tipo_scala")
                                                    Case 2
                                                        Stadio_Da = drEpocaDa(0).Item("stadio_principale") & drEpocaDa(0).Item("seconda_cifra")
                                                    Case 3
                                                        Stadio_Da = drEpocaDa(0).Item("stadio_principale") & drEpocaDa(0).Item("seconda_cifra") & drEpocaDa(0).Item("terza_cifra")
                                                End Select
                                            End If
                                        End If

