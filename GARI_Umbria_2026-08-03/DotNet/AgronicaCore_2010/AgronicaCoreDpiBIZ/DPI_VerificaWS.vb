                        XmlDatiPrincipiAttivi.AppendChild(XmlPrincipioAttivo)

                        XmlPrincipioAttivo = Nothing

                    Next Riga

                    XmlDatiDiserbo.AppendChild(XmlDatiPrincipiAttivi)
