                                    bCoadiuvante = False
                                End If


                            End If 'Fine Caricamento Avversità





                            '------------------------------------------
                            '12/04/2022 Marco: Controllo Prodotto Vincolato Formulato

                            'Lettura tabella "Prodotti_Relazioni"
                            Dim dtProdotti_Relazioni As DataTable
                            Dim ObjProdotti_Relazioni_R As New AgronicaCoreMetaSchemaDAL.Prodotti_Relazioni_R
                            dtProdotti_Relazioni = ObjProdotti_Relazioni_R.Leggi_Vincolo_Formulati(Pro_Cod,
                                                                                                   AGRODATAINIZIO,
                                                                                                   AGRODATAFINE,
                                                                                                   AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                                                   "",
                                                                                                   "",
                                                                                                   objParametri_Matrice)


                            Dim ProCod_Dipendente As String = ""
                            Dim ProDes_Dipendente As String = ""
                            Dim i_ProCod_Dipendente As Integer = 0
                            Dim bVincoloOK As Boolean = True

                            If dtProdotti_Relazioni.Rows.Count > 0 Then

                                bVincoloOK = False

                                'Controllo Tipo Dipendenza
                                For iPR = 0 To dtProdotti_Relazioni.Rows.Count - 1

                                    Select Case dtProdotti_Relazioni.Rows(iPR).Item("Tipo_Dipendenza")

                                        Case 1 'Vincolante

                                            '--------------
                                            Dim i_DatiDettaglio_Relazione As Integer = 0

                                            ProCod_Dipendente = ProCod_Dipendente & If(Trim(ProCod_Dipendente) = "", "", ", ") & dtProdotti_Relazioni.Rows(iPR).Item("ProCod_Dipendente")
                                            ProDes_Dipendente = ProDes_Dipendente & If(Trim(ProDes_Dipendente) = "", "", ", ") & dtProdotti_Relazioni.Rows(iPR).Item("ProDes_Dipendente")
                                            i_ProCod_Dipendente = i_ProCod_Dipendente + 1

                                            Do While i_DatiDettaglio_Relazione < xDettagli.Count

                                                xDettaglio = xDettagli.Item(i_DatiDettaglio_Relazione)

                                                'Controllo Relazione Vincolante
                                                If CInt(dtProdotti_Relazioni.Rows(iPR).Item("ProCod_Dipendente")) = CInt(xDettaglio.GetAttribute("pro_cod")) Then
                                                    bVincoloOK = True
                                                End If

                                                i_DatiDettaglio_Relazione = i_DatiDettaglio_Relazione + 1

                                            Loop


                                        Case Else

                                    End Select

                                Next

