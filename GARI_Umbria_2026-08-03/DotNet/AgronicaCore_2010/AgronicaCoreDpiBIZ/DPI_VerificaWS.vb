                                                                        CStr(Destinazioni(i_Validita_Fine, i)),
                                                                        CDbl(Destinazioni(i_Sup_Trattata, i)),
                                                                        0, 0, 0, 0, 0,
                                                                        For_Veg_Av_Dos_Cod, 0,
                                                                        Num_Max_Interventi_Globali(e),
                                                                        Array_For_Veg_Av_Dos_Cod(e), Array_Gruppo_Dosaggi(e),
                                                                        "", 0, Dose_Max(e))

                                            Next
                                            N_Warning += 1
                                        Next
                                    End If

                                    If TipoTestata = 1 Then

