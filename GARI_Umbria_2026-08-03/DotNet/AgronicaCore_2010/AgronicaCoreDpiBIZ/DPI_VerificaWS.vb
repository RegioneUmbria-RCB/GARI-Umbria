                                            Qta_DistribuitaxEttaro = Qta_Distribuita / Sup_Totale
                                        Else

                                            'Evito il division by zero
                                            Qta_DistribuitaxEttaro = 0

                                        End If

                                        'Inserimento del Formulato nella Struttura di Appoggio 'Diserbo
                                        FormCaricaFormulato_2(Veg_Cod, Ep_Cod, Av_Gru, Av_Cod, Pro_Cod, Qta_DistribuitaxEttaro, Grfi_Cod, bCoadiuvante, dtFormulatixPA, Data, objParametri_Matrice)

                                    End If


                                Case False

                                    '--------------------------------------------------------------------------------------------
                                    '(26/10/2017 fede) anticipato CONTROLLO ETICHETTA
                                    Dim bProdottoE As Boolean = False

                                    'TODO: Controllare se è corretto così chiedendo alla Fede
                                    Dim xFiltroAggiuntivo As String = " Formulati.FR_COD = " & Pro_Cod.ToString

                                    If Lav_Cod = LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA Then

                                        If Veg_Cod <> 0 Then
                                            xFiltroAggiuntivo &= " AND ( FormulatixSpecieVegetali.Veg_Cod = " & Veg_Cod & "  "
                                            xFiltroAggiuntivo &= " OR  ( FormulatixSpecieVegetali.Grsp_Cod IN (Select Grsp_Cod From GruppoColturaleXSpecieVegetali "
                                            xFiltroAggiuntivo &= "      WHERE GruppoColturaleXSpecieVegetali.Veg_Cod = " & Veg_Cod & " ) ) "
                                            xFiltroAggiuntivo &= " OR  ( FormulatixSpecieVegetali.Veg_Cod = 0 AND FormulatixSpecieVegetali.Grsp_Cod = 0 )) "
                                        End If

                                    End If

                                    Dim dtProdottiE As DataTable

                                    dtProdottiE = ObjFormulatixClassifica.LeggiXClassificazione_PA("",
                                                                                            0,
                                                                                            Veg_Cod,
                                                                                            "",
                                                                                            Data,
                                                                                            Data,
                                                                                            AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                                            " Formulati.FR_COD = " & Pro_Cod.ToString,
                                                                                            "",
                                                                                            objParametri_Matrice)

                                    If dtProdottiE.Rows.Count <> 0 Then
                                        bProdottoE = True
                                    End If

                                    If Not bProdottoE Then

                                        'Prodotto fitosanitario non coerente con l'avversità riscontrata
                                        '--------------
                                        Err_Code = enTipoErrCode_Verifica.ProdottoNonRegistratoSuColtura
                                        Err_Des = "L'utilizzo del prodotto " & Pro_Des & " non è ammesso sulla coltura indicata."

                                    Else

                                        '============================================================================================
                                        'Verifica dose impiegata
                                        '--------------------------------------------------------------------------------------------
                                        Select Case TipoTestata

                                            Case enum_Disciplinare_Tipo_Testata.Diserbo, enum_Disciplinare_Tipo_Testata.Fitoregolatore

                                                'If TipoTestata = 1 Then

                                                'Determino la qta di formulato distribuito espresso in macro udm
                                                If Sup_Totale > 0 Then

                                                    ObjDPI_Dose_Difesa.Qta_Formulato(Qta_Distribuita, Udm_Cod_Utilizzato, Udm_Des, Mezzo_Des, Mezzo, Mezzo_Det, Udm_Cod, Dose_Ha, Dose_Hl, Acqua, Sup_Totale)
                                                    Qta_DistribuitaxEttaro = Qta_Distribuita / Sup_Totale
                                                Else

                                                    'Evito il division by zero
                                                    Qta_DistribuitaxEttaro = 0

