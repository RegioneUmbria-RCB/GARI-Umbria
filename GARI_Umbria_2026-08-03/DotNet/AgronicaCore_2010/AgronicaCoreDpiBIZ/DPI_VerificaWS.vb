    Private Sub DoseConsentitaDiserbo_New(ByVal Disciplinare_Cod As Integer,
                                        ByVal Id_RcDpi As Integer,
                                        ByVal Modulo As Integer,
                                        ByVal Ep_Cod As Integer,
                                        ByVal Gru_Cod As Integer,
                                        ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri)

        Dim DoseMax As Decimal
        Dim Qta_PA As Decimal
        Dim Qta_Pa_Peso As Decimal
        Dim Qta_Pa_Perc As Decimal
        Dim Qta_Pa_Perc1_Peso2 As Integer
        Dim Qta_PA_Des As String
        Dim DoseDPI As Decimal
        Dim DoseDPIMax As Decimal
        Dim DoseDPIAnno As Decimal
        Dim DoseDPI_Des As String

        Dim Qta_Formulato As Decimal
        Dim Qta_Formulato_Peso As Decimal
        Dim Qta_Formulato_Perc As Decimal
        Dim Qta_Formulato_Perc1_Peso2 As Integer
        Dim Qta As Decimal
        Dim Qta_Confronto As Decimal
        Dim Titolo As Decimal
        Dim Peso As Decimal

        Dim bPAValutabileSingolarmente As Boolean
        Dim bDoseImpostata As Boolean
        Dim bDoseAssenteDpi As Boolean
        Dim bMiscelaDIsciplinata As Boolean
        Dim RigaInfestanti As Integer
        Dim Riga As Integer

        Dim Av_Cod As Integer
        Dim Av_Gru As Integer
        Dim Avversita_Des As String

        Dim Fr_Cod As Integer
        Dim Pa_Cod As Integer
        Dim PercPa As Decimal
        Dim PesoPA As Decimal
        Dim PercAbb As Integer = 100

        Dim dtPAAusiliari As DataTable
        Dim dtVerifica As DataTable
        Dim dtMiscela As DataTable

        Dim Riga_Start As Integer
        Dim Riga_End As Integer
        Dim i As Integer
        Dim isPertinentePerTitoloPeso As Boolean
        Dim Row_Min As Integer
        Dim Col_Min_Des As Integer
        Dim Col_Min As Integer
        Dim RigaDiserbo As Integer
        Dim RigaPrincipiAttivi As Integer
        Dim Riga_Merge As Integer
        Dim strConsentito As String
        Dim strMiscela As String

        Dim ObjDPI_AD As New AgronicaCoreDpiDAL.Dpi_R

        For RigaInfestanti = 0 To UBound(Infestanti, 2) - 1

            'Impostazione Parametri Infestanti
            Av_Gru = Infestanti(COL_AV_GRU, RigaInfestanti)
            Av_Cod = Infestanti(COL_AV_COD, RigaInfestanti)
            Avversita_Des = Infestanti(COL_INFESTANTE_DES, RigaInfestanti)

            For Riga = 0 To UBound(PrincipiAttivi, 2) - 1

                If CInt(PrincipiAttivi(COL_PA_COADIUVANTE, Riga)) = 0 Then

                    Fr_Cod = CInt(PrincipiAttivi(COL_FR_COD, Riga))
                    Pa_Cod = CInt(PrincipiAttivi(COL_PA_COD, Riga))
                    Titolo = CDec(PrincipiAttivi(COL_TITOLO, Riga))
                    Peso = CDec(PrincipiAttivi(COL_PESO, Riga))

                    PercAbb = 100
                    PercPa = 0
                    PesoPA = 0

                    DoseMax = 0
                    bDoseImpostata = False
                    isPertinentePerTitoloPeso = False
                    bMiscelaDIsciplinata = False
                    bDoseAssenteDpi = False

                    RigaDiserbo = TrovaRiga_Diserbo(Fr_Cod, Pa_Cod)

                    Dim DoseMaxEtichetta As Decimal
                    DoseMaxEtichetta = PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, RigaDiserbo)

                    'Verifica la quantità di principio attivo distribuibile
                    'Ordinamento--> Precedenza alle non miscele
                    'RsDose.Sort = "Id_Paa_Misc Asc" 'Non modificare
                    dtPAAusiliari = ObjDPI_AD.Leggi_Infestanti(Id_RcDpi,
                                                            Disciplinare_Cod,
                                                            1,
                                                            0,
                                                            Av_Gru,
                                                            Av_Cod,
                                                            Pa_Cod,
                                                            0,
                                                            0,
                                                            "",
                                                            Modulo,
                                                            Ep_Cod,
                                                            "",
                                                            "Id_Paa_Misc Asc",
                                                            objParametri)


                    If dtPAAusiliari.Rows.Count > 0 Then

                        'Ricerca della dose + tollerante
                        Qta_PA = 0
                        Qta_Formulato = 0

                        Dim iPAA As Integer

                        For iPAA = 0 To dtPAAusiliari.Rows.Count - 1

                            'Reset Parametri
                            bPAValutabileSingolarmente = False

                            'Impostazione % PA Consentito
                            '(07/05/2016 fede) modifica x eliminazione dosaggi diserbo dpi
                            If Not IsDBNull(dtPAAusiliari.Rows(iPAA).Item("PercPA")) Then
                                PercPa = dtPAAusiliari.Rows(iPAA).Item("PercPA")
                            Else
                                bDoseAssenteDpi = True
                            End If

                            PesoPA = 0
                            If Not IsDBNull(dtPAAusiliari.Rows(iPAA).Item("PesoPA")) Then
                                PesoPA = dtPAAusiliari.Rows(iPAA).Item("PesoPA")
                            End If

                            '(17/05/2016 fede) modifica x introduzione campo apposito
                            If Not IsDBNull(dtPAAusiliari.Rows(iPAA).Item("PercAbb")) Then
                                PercAbb = dtPAAusiliari.Rows(iPAA).Item("PercAbb")
                            End If


                            If (Not isPertinentePerTitoloPeso) Or (PercPa = Titolo) Or ((PesoPA = Peso) And Peso <> 0 And PesoPA <> 0) Then

                                'Controllo se il titolo = percpa
                                'In questo caso ho trovato la riga di dpi dedicata al pa_cod  --> ricerca è valida solo per le restanti dosi aventi il medesimo percpa
                                If Titolo = PercPa Or PesoPA = Peso Then
                                    isPertinentePerTitoloPeso = True
                                End If

                                'Verifico l'esistenza di una miscela
                                If Not IsDBNull(dtPAAusiliari.Rows(iPAA).Item("Id_Paa_Misc")) AndAlso CInt(dtPAAusiliari.Rows(iPAA).Item("Id_Paa_Misc")) <> 0 Then

                                    If Not bMiscelaDIsciplinata Then

                                        '=======================================================================================================
                                        'Verifico se il principio miscelabile è presente nella scheda intervento
                                        dtMiscela = ObjDPI_AD.Leggi_PA_Miscela(Id_RcDpi,
                                                                                   Disciplinare_Cod,
                                                                                   Agro_SQL_SaveNum(dtPAAusiliari.Rows(iPAA).Item("Id_Paa_Misc")),
                                                                                   1,
                                                                                   0,
                                                                                   Av_Gru,
                                                                                   Av_Cod,
                                                                                   0,
                                                                                   0,
                                                                                   Modulo,
                                                                                   Ep_Cod,
                                                                                   "",
                                                                                   "",
                                                                                   objParametri)

                                        If dtMiscela.Rows.Count > 0 Then

                                            strMiscela = ""

                                            For RigaPrincipiAttivi = 0 To UBound(PrincipiAttivi, 2) - 1
                                                'Controllo che il principio attivo non sia quello in esame
                                                If CInt(PrincipiAttivi(COL_PA_COD, RigaPrincipiAttivi)) <> Pa_Cod Then
                                                    'Aggiornamento stringa pa_cod presenti in scheda eventualmete miscelabili
                                                    strMiscela = strMiscela & "Pa_Cod = " & CInt(PrincipiAttivi(COL_PA_COD, RigaPrincipiAttivi)) & " OR "
                                                End If
                                            Next

                                            If Trim(strMiscela) <> "" Then
                                                'Fine Formattazione
                                                strMiscela = Left(strMiscela, Len(strMiscela) - 3)
                                                'Applico il Filtro
                                                'RsMiscela.Filter = strMiscela
                                                'Verifico se in scheda è stato impostata una miscela disciplinata
                                                'bMiscela = Not RsMiscela.EOF
                                                Dim Dr() As DataRow
                                                Dr = dtMiscela.Select(strMiscela)
                                                If Dr.Length > 0 Then
                                                    bMiscelaDIsciplinata = True
                                                Else
                                                    bMiscelaDIsciplinata = False
                                                End If
                                            End If

                                        End If

                                    End If
                                    '=======================================================================================================

                                    If bMiscelaDIsciplinata Or Qta_Formulato = 0 Then

                                        'Qta_Formulato = 0 quando il pa si trova solo disponibile in miscela!

                                        'Il principio attivo è miscelabile

                                        'Lettura dei dettagli della miscela
                                        dtMiscela = ObjDPI_AD.Leggi_Miscela(Id_RcDpi,
                                                                                Disciplinare_Cod,
                                                                                Agro_SQL_SaveNum(dtPAAusiliari.Rows(iPAA).Item("Id_Paa_Misc")),
                                                                                1,
                                                                                0,
                                                                                Av_Gru,
                                                                                Av_Cod,
                                                                                0,
                                                                                0,
                                                                                Modulo,
                                                                                Ep_Cod,
                                                                                "",
                                                                                "",
                                                                                objParametri)

                                        If dtMiscela.Rows.Count <> 0 Then
                                            'Per il calcolo della dose considero il RsMiscela
                                            dtVerifica = dtMiscela.Copy
                                            bPAValutabileSingolarmente = True
                                        End If

                                    Else

                                        'Il pa si trova miscelato con un pa non presente in scheda
                                        bPAValutabileSingolarmente = False

                                    End If

                                Else

                                    Select Case bMiscelaDIsciplinata
                                        Case True
                                            'Il pa è in miscela--> non può essere valutato singolarmente
                                            bPAValutabileSingolarmente = False

                                        Case False
                                            'No Miscela

                                            'Per il calcolo della dose considero il dtDose
                                            dtVerifica = dtPAAusiliari.Copy
                                            bPAValutabileSingolarmente = True
                                    End Select

                                End If 'Fine Controllo Presenza Miscela


                                'Calcolo DOSI
                                If (Titolo <> 0 Or Peso <> 0) And bPAValutabileSingolarmente Then
                                    '
                                    DoseDPIAnno = 0
                                    DoseDPIMax = 0

                                    Select Case Gru_Cod
                                        '
                                        Case 1 'Arboree
                                            '(17/05/2016 fede) modifica x introduzione campo apposito
                                            If IsDBNull(dtVerifica.Rows(0).Item("Dose_Max_Anno")) Then
                                                'Provo RsDose
                                                If IsDBNull(dtPAAusiliari.Rows(iPAA).Item("Dose_Max_Anno")) Then
                                                    'Eccezione
                                                    DoseDPI = 0
                                                    DoseDPIAnno = 0
                                                Else
                                                    DoseDPI = dtPAAusiliari.Rows(iPAA).Item("Dose_Max_Anno") '* PercAbb / 100
                                                    DoseDPIAnno = dtPAAusiliari.Rows(iPAA).Item("Dose_Max_Anno") '* PercAbb / 100
                                                    DoseDPIMax = dtPAAusiliari.Rows(iPAA).Item("Dose_Max_Anno")
                                                End If
                                            Else
                                                DoseDPI = dtVerifica.Rows(0).Item("Dose_Max_Anno") '* PercAbb / 100
                                                DoseDPIAnno = dtVerifica.Rows(0).Item("Dose_Max_Anno") '* PercAbb / 100
                                                DoseDPIMax = dtVerifica.Rows(0).Item("Dose_Max_Anno")
                                            End If


                                        Case Else 'Erbacee, Orticole

                                            '(24/01/2019 fede) gestita PercAbb anche per erbacee ed orticole
                                            If IsDBNull(dtVerifica.Rows(0).Item("DoseMax")) Then
                                                'Provo RsDose
                                                If IsDBNull(dtPAAusiliari.Rows(iPAA).Item("DoseMax")) Then
                                                    'Eccezione
                                                    DoseDPI = 0
                                                Else
                                                    DoseDPI = dtPAAusiliari.Rows(iPAA).Item("DoseMax") '* PercAbb / 100
                                                    DoseDPIMax = dtPAAusiliari.Rows(iPAA).Item("DoseMax")
                                                End If
                                            Else
                                                DoseDPI = dtVerifica.Rows(0).Item("DoseMax") '* PercAbb / 100
                                                DoseDPIMax = dtVerifica.Rows(0).Item("DoseMax")
                                            End If

                                    End Select

                                    '(07/05/2016 fede) modifica x eliminazione dosaggi diserbo dpi
                                    Qta_PA = 0
                                    Qta_Pa_Perc = 0
                                    Qta_Pa_Peso = 0
                                    Qta_Pa_Perc1_Peso2 = 0

                                    If bDoseAssenteDpi = True Then

                                        bDoseImpostata = True

                                        '(24/01/2019 fede) in caso di assenza dose dpi prendo la dose di etichetta
                                        If DoseMaxEtichetta > 0 And PercAbb < 100 Then

                                            DoseDPI = DoseMaxEtichetta '* PercAbb / 100
                                            DoseDPIMax = DoseDPI
                                            PercPa = Titolo
                                            PesoPA = Peso

                                            Qta_Pa_Perc = (DoseDPI * PercPa / 100)
                                            Qta_Pa_Peso = (DoseDPI * PesoPA / 1000)

                                            If PesoPA <> 0 And Peso <> 0 Then
                                                Qta_Confronto = DoseDPI * PesoPA / 1000 ' Format((DoseDPI * PesoPA / 1000), "###,##0.0###")
                                                Qta_Pa_Perc1_Peso2 = 2
                                            Else
                                                'Calcolo la Quantità di Principio Attivo Consentita in caso di Titolo = PercPA
                                                'DoseDPI : 100 = QTA : PercPA
                                                Qta_Confronto = DoseDPI * PercPa / 100 'Format((DoseDPI * PercPa / 100), "###,##0.0###") 'Non Modificare
                                                Qta_Pa_Perc1_Peso2 = 1
                                            End If

                                            'Confronto le qta ed imposto la + tollerante
                                            If (Qta_Confronto > DoseMax And DoseDPI > 0) Or (PercPa = Titolo) Or ((PesoPA = Peso) And Peso <> 0 And PesoPA <> 0) Then

                                                Qta_PA = Qta_Confronto
                                                DoseMax = Qta_Confronto

                                                If Titolo > 0 Then
                                                    Qta_Formulato_Perc = (Qta_Pa_Perc / Titolo) * 100
                                                End If
                                                If Peso > 0 Then
                                                    Qta_Formulato_Peso = (Qta_Pa_Peso / Peso) * 1000
                                                End If
                                                'Calcolo della Qta di Formulato Consentito
                                                If PesoPA <> 0 And Peso <> 0 Then
                                                    Qta_Formulato = Format((Qta_PA / Peso) * 1000, "###,##0.0##")
                                                    Qta_Formulato_Perc1_Peso2 = 2
                                                Else
                                                    Qta_Formulato = Format((Qta_PA / Titolo) * 100, "###,##0.0##")
                                                    Qta_Formulato_Perc1_Peso2 = 1
                                                End If

                                                bDoseImpostata = True

                                            End If

                                        End If


                                    Else

                                        Qta_Pa_Perc = (DoseDPI * PercPa / 100)
                                        Qta_Pa_Peso = (DoseDPI * PesoPA / 1000)

                                        If PesoPA <> 0 And Peso <> 0 Then
                                            Qta_Confronto = Format((DoseDPI * PesoPA / 1000), "###,##0.0##")
                                            Qta_Pa_Perc1_Peso2 = 2
                                        Else
                                            'Calcolo la Quantità di Principio Attivo Consentita in caso di Titolo = PercPA
                                            'DoseDPI : 100 = QTA : PercPA
                                            'Qta_Confronto = Format((DoseDPI * PercPa / 100), "###,##0.0###") 'Non Modificare
                                            Qta_Confronto = Format((DoseDPI * PercPa / 100), "###,##0.0##") 'Non Modificare
                                            Qta_Pa_Perc1_Peso2 = 1
                                        End If

                                        'Confronto le qta ed imposto la + tollerante
                                        If (Qta_Confronto > DoseMax And DoseDPI > 0) Or (PercPa = Titolo) Or ((PesoPA = Peso) And Peso <> 0 And PesoPA <> 0) Then

                                            Qta_PA = Qta_Confronto
                                            DoseMax = Qta_Confronto

                                            If Titolo > 0 Then
                                                Qta_Formulato_Perc = (Qta_Pa_Perc / Titolo) * 100
                                            End If
                                            If Peso > 0 Then
                                                Qta_Formulato_Peso = (Qta_Pa_Peso / Peso) * 1000
                                            End If
                                            'Calcolo della Qta di Formulato Consentito
                                            If PesoPA <> 0 And Peso <> 0 Then
                                                Qta_Formulato = Format((Qta_PA / Peso) * 1000, "###,##0.0##")
                                                Qta_Formulato_Perc1_Peso2 = 2
                                            Else
                                                Qta_Formulato = Format((Qta_PA / Titolo) * 100, "###,##0.0##")
                                                Qta_Formulato_Perc1_Peso2 = 1
                                            End If

                                            bDoseImpostata = True

                                            'If PercAbb > 0 And PercAbb < 100 Then
                                            '    PrincipiAttivi(COL_DETTAGLIO, Riga) = "Dose di formulato commerciale calcolata per superificie già ridotta al " & PercAbb & "%"
                                            'End If

                                        End If


                                    End If

                                    PrincipiAttivi(COL_TITOLO_DPI, Riga) = Format(PercPa, "###,##0.00#")
                                    PrincipiAttivi(COL_PESO_DPI, Riga) = Format(PesoPA, "###,##0.00#")
                                    PrincipiAttivi(COL_PERC_ABB, Riga) = Format(PercAbb, "###,##0.00#")
                                    PrincipiAttivi(COL_DOSE_MAX_DPI, Riga) = Format(DoseDPIMax, "###,##0.00#")

                                    PrincipiAttivi(COL_QTA_PA_PERC, Riga) = Format(Qta_Pa_Perc, "###,##0.00#")
                                    PrincipiAttivi(COL_QTA_PA_PESO, Riga) = Format(Qta_Pa_Peso, "###,##0.00#")
                                    PrincipiAttivi(COL_QTA_PA_PERC1_PESO2, Riga) = Qta_Pa_Perc1_Peso2.ToString

                                    '(24/01/2019 fede) aggiunta nota su calcolo fatto
                                    PrincipiAttivi(COL_DETTAGLIO, Riga) = ""
                                    If PercAbb > 0 And PercAbb < 100 Then

                                        '2022-02-14
                                        PrincipiAttivi(COL_DETTAGLIO, Riga) = String.Format("Attenzione! E' possibile intervenire al massimo sul {0} % della superficie", PercAbb)

                                        'If bDoseAssenteDpi = True Then
                                        '    PrincipiAttivi(COL_DETTAGLIO, Riga) = "Dose di formulato commerciale calcolata da dose massima di etichetta per superificie già ridotta al " & PercAbb & "%"
                                        'Else
                                        '    PrincipiAttivi(COL_DETTAGLIO, Riga) = "Dose di formulato commerciale calcolata per superificie già ridotta al " & PercAbb & "%"
                                        'End If

                                    End If

                                End If 'Fine Controllo Titolo <> 0 And bPAConsentito

                            End If 'Fine Controllo bTitoloPercPA

                        Next

                        'RigaDiserbo = TrovaRiga_Diserbo(Fr_Cod, Pa_Cod)

                        'Calcolo della dose di principio attivo distribuito
                        If PesoPA <> 0 And Peso <> 0 Then
                            PrincipiAttivi(COL_QTA, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 1000) * Peso), "###,##0.00#")
                            PrincipiAttivi(COL_QTA_FRCOD_PERC1_PESO2, Riga) = 2
                        Else
                            PrincipiAttivi(COL_QTA, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 100) * Titolo), "###,##0.00#")
                            PrincipiAttivi(COL_QTA_FRCOD_PERC1_PESO2, Riga) = 1
                        End If




                        Select Case bDoseImpostata

                            Case True 'PRODOTTO CONSENTITO

                                'Inserimento risultati nelle griglie
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo) = Qta_Formulato
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_DES, RigaDiserbo) = Format(Qta_Formulato, "###,##0.0##")
                                If bDoseAssenteDpi = False Then
                                    PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = Qta_Formulato 'DoseDPIAnno
                                Else
                                    PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = 0
                                End If

                                PrincipiAttivi(COL_DOSE_CONSENTITA, Riga) = Qta_PA
                                PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga) = Qta_PA
                                If bDoseAssenteDpi = False Then
                                    PrincipiAttivi(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = Qta_PA 'DoseDPIAnno
                                Else
                                    PrincipiAttivi(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = 0
                                End If

                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PERC, RigaDiserbo) = Format(Qta_Formulato_Perc, "###,##0.0##")
                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PESO, RigaDiserbo) = Format(Qta_Formulato_Peso, "###,##0.0##")
                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PERC1_PESO2, RigaDiserbo) = Qta_Formulato_Perc1_Peso2

                                PrincipiAttiviFormulato(COL_QTA_PA_FRCOD_PERC, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 100) * Titolo), "###,##0.00#")
                                PrincipiAttiviFormulato(COL_QTA_PA_FRCOD_PESO, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 1000) * Peso), "###,##0.00#")


                            Case False 'PRODOTTO NON CONSENTITO

                                'Inserimento risultati nelle griglie
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo) = 0
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_DES, RigaDiserbo) = "Non Consentito"
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = 0

                                PrincipiAttivi(COL_DOSE_CONSENTITA, Riga) = 0
                                PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga) = "Non Consentito"
                                PrincipiAttivi(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = 0

                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PERC, RigaDiserbo) = Format(Qta_Formulato_Perc, "###,##0.0##")
                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PESO, RigaDiserbo) = Format(Qta_Formulato_Peso, "###,##0.0##")
                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PERC1_PESO2, RigaDiserbo) = Qta_Formulato 'DoseDPIAnno

                                PrincipiAttiviFormulato(COL_QTA_PA_FRCOD_PERC, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 100) * Titolo), "###,##0.00#")
                                PrincipiAttiviFormulato(COL_QTA_PA_FRCOD_PESO, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 1000) * Peso), "###,##0.00#")

                                PrincipiAttivi(COL_TITOLO_DPI, Riga) = 0
                                PrincipiAttivi(COL_PESO_DPI, Riga) = 0
                                PrincipiAttivi(COL_PERC_ABB, Riga) = 0
                                PrincipiAttivi(COL_DOSE_MAX_DPI, Riga) = 0
                                PrincipiAttivi(COL_QTA_PA_PERC, Riga) = 0
                                PrincipiAttivi(COL_QTA_PA_PESO, Riga) = 0
                                PrincipiAttivi(COL_QTA_PA_PERC1_PESO2, Riga) = 0

                        End Select


                    End If


                End If

            Next


        Next


        '----------------------------------------------------------------------------------------------
        'Standardizzazione 'Diserbo'
        Riga = 0

        Do While Riga < UBound(PrincipiAttiviFormulato, 2)

            Fr_Cod = CInt(PrincipiAttiviFormulato(COL_FR_COD, Riga))

            Riga_Start = Riga

            'Controllo che la dose di etichetta sia disponibile
            Qta_Formulato = PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, Riga)

            Row_Min = Riga

            Col_Min = COL_DOSE_ETICHETTA
            Col_Min_Des = COL_DOSE_ETICHETTA_DES

            For Riga_End = Riga_Start To UBound(PrincipiAttiviFormulato, 2) - 1

                If CInt(PrincipiAttiviFormulato(COL_FR_COD, Riga_End)) = Fr_Cod Then

                    Riga = Riga_End

                    'Stesso formulato
                    If PrincipiAttiviFormulato(COL_PA_COADIUVANTE, Riga_End) = 1 Then

                        If IsNumeric(PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, Riga_End)) Then
                            PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, Riga_End) = PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, Riga_End)
                            PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_DES, Riga_End) = PrincipiAttiviFormulato(COL_DOSE_ETICHETTA_DES, Riga_End)
                        Else
                            PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_DES, Riga_End) = "Indefinito"
                        End If

                        PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_ANNO, Riga_End) = 0

                    End If

                    If IsNumeric(PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, Riga_End)) Then
                        If Qta_Formulato > CDbl(PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, Riga_End)) Then

                            'Nuovo Minimo Disciplinare
                            Qta_Formulato = CDbl(PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, Riga_End))
                            Row_Min = Riga_End
                            Col_Min = COL_DOSE_CONSENTITA
                            Col_Min_Des = COL_DOSE_CONSENTITA_DES

                        End If

                    End If

                End If

            Next

            'Coloro il Risultato
            Select Case Col_Min
                Case COL_DOSE_CONSENTITA
                    strConsentito = "disciplinare."
                Case COL_DOSE_ETICHETTA
                    strConsentito = "etichetta."

                    'Si rende necessaria la modifica delle dosi sui principi attivi
                    For Riga_End = Riga_Start To UBound(PrincipiAttivi, 2) - 1

                        If CInt(PrincipiAttivi(COL_FR_COD, Riga_End)) = Fr_Cod Then

                            If Not IsNumeric(PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End)) Then
                                PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End) = 0
                            End If

                            Pa_Cod = CInt(PrincipiAttivi(COL_PA_COD, Riga_End))

                            'Se la dose consentita è quella di etichetta --> occorre rapportare tutti i
                            'quantitativi di pa all'interno della griglia dei totali poichè impostati
                            'sul disciplinare

                            RigaDiserbo = TrovaRiga_Diserbo(Fr_Cod, Pa_Cod)

                            If IsNumeric(PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo)) Then

                                PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End) = Format((CDbl(PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End)) * CDbl(PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, RigaDiserbo))) / CDbl(PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo)), "###,##0.000")
                                PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga_End) = PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End)

                            Else

                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo) = 100000
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo) = "Non Disponibile"
                                PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End) = 100000
                                PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga_End) = "Indefinito"

                            End If

                        End If

                    Next

            End Select


            For Riga_End = Riga_Start To UBound(PrincipiAttiviFormulato, 2) - 1

                If CInt(PrincipiAttiviFormulato(COL_FR_COD, Riga_End)) = Fr_Cod Then

                    'Indico la colonna con la dose minore
                    PrincipiAttiviFormulato(COL_DOSE_MINIMA, Riga_End) = Col_Min
                    PrincipiAttiviFormulato(COL_DOSE_MINIMA_DES, Riga_End) = Col_Min_Des

                    If CDbl(PrincipiAttiviFormulato(COL_QTA, Riga_End)) = 0 Then

                        'Prodotto Non Distribuito
                        PrincipiAttiviFormulato(COL_CONFORMITA, Riga_End) = 2

                    Else

                        If Qta_Formulato < CDbl(PrincipiAttiviFormulato(COL_QTA, Riga_End)) Then

                            'Non conforme
                            PrincipiAttiviFormulato(COL_CONFORMITA, Riga_End) = 0

                        Else
                            'Ok
                            PrincipiAttiviFormulato(COL_CONFORMITA, Riga_End) = 1

                        End If

                    End If

                End If

            Next

            Riga = Riga + 1

        Loop


        'Standardizzazione Principi Attivi
        For Riga = 0 To UBound(PrincipiAttivi, 2) - 1

            If PrincipiAttivi(COL_MERGE, Riga) = 1 Then

                Pa_Cod = PrincipiAttivi(COL_PA_COD, Riga)
                Qta_PA = 100000 'Dummy
                Qta = 0

                For Riga_Merge = 0 To UBound(PrincipiAttivi, 2) - 1

                    If Pa_Cod = PrincipiAttivi(COL_PA_COD, Riga_Merge) Then

                        'Aggiornamento Qta
                        Qta = Qta + PrincipiAttivi(COL_QTA, Riga_Merge)

                        If Qta_PA > PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_Merge) Then
                            'Aggiornamento (Nuovo Minimo)
                            Qta_PA = PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_Merge)
                            Qta_PA_Des = PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga_Merge)
                            Fr_Cod = PrincipiAttivi(COL_FR_COD, Riga_Merge)

                            RigaDiserbo = TrovaRiga_Diserbo(Fr_Cod, Pa_Cod)
                            DoseDPI = PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo)
                            DoseDPI_Des = PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_DES, RigaDiserbo)

                        End If

                    End If

                Next


                For Riga_Merge = 0 To UBound(PrincipiAttivi, 2) - 1

                    If Pa_Cod = PrincipiAttivi(COL_PA_COD, Riga_Merge) Then

                        'Allineamento Minimo per Tutti i PA_Cod Identici
                        PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_Merge) = Qta_PA
                        PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga_Merge) = Qta_PA_Des
                        PrincipiAttivi(COL_QTA, Riga_Merge) = Format(Qta, "###,##0.00#")

                        Fr_Cod = PrincipiAttivi(COL_FR_COD, Riga_Merge)

                    End If
                Next

            End If

        Next

    End Sub



    '##########################################################################################################
    '######### Routine per il calcolo della quantità consentita per ogni principio attivo  ####################
    '######### con riduzione su % abb (Vecchia versione)                                   ####################
    '##########################################################################################################

    Private Sub DoseConsentitaDiserbo(ByVal Disciplinare_Cod As Integer,
                                        ByVal Id_RcDpi As Integer,
                                        ByVal Modulo As Integer,
                                        ByVal Ep_Cod As Integer,
                                        ByVal Gru_Cod As Integer,
                                          ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri)

        Dim DoseMax As Decimal
        Dim Qta_PA As Decimal
        Dim Qta_Pa_Peso As Decimal
        Dim Qta_Pa_Perc As Decimal
        Dim Qta_Pa_Perc1_Peso2 As Integer
        Dim Qta_PA_Des As String
        Dim DoseDPI As Decimal
        Dim DoseDPIMax As Decimal
        Dim DoseDPIAnno As Decimal
        Dim DoseDPI_Des As String

        Dim Qta_Formulato As Decimal
        Dim Qta_Formulato_Peso As Decimal
        Dim Qta_Formulato_Perc As Decimal
        Dim Qta_Formulato_Perc1_Peso2 As Integer
        Dim Qta As Decimal
        Dim Qta_Confronto As Decimal
        Dim Titolo As Decimal
        Dim Peso As Decimal

        Dim bPAConsentito As Boolean
        Dim bDoseImpostata As Boolean
        Dim bDoseAssenteDpi As Boolean
        Dim bMiscela As Boolean
        Dim RigaInfestanti As Integer
        Dim Riga As Integer

        Dim Av_Cod As Integer
        Dim Av_Gru As Integer
        Dim Avversita_Des As String

        Dim Fr_Cod As Integer
        Dim Pa_Cod As Integer
        Dim PercPa As Decimal
        Dim PesoPA As Decimal
        Dim PercAbb As Integer = 100

        Dim dtDose As DataTable
        Dim dtCalcolo As DataTable
        Dim dtMiscela As DataTable

        Dim Riga_Start As Integer
        Dim Riga_End As Integer
        Dim i As Integer
        Dim bTitoloPercPA As Boolean
        Dim Row_Min As Integer
        Dim Col_Min_Des As Integer
        Dim Col_Min As Integer
        Dim RigaDiserbo As Integer
        Dim RigaPrincipiAttivi As Integer
        Dim Riga_Merge As Integer
        Dim strConsentito As String
        Dim strMiscela As String

        Dim ObjDPI_AD As New AgronicaCoreDpiDAL.Dpi_R

        For RigaInfestanti = 0 To UBound(Infestanti, 2) - 1

            'Impostazione Parametri Infestanti
            Av_Gru = Infestanti(COL_AV_GRU, RigaInfestanti)
            Av_Cod = Infestanti(COL_AV_COD, RigaInfestanti)
            Avversita_Des = Infestanti(COL_INFESTANTE_DES, RigaInfestanti)

            For Riga = 0 To UBound(PrincipiAttivi, 2) - 1

                If CInt(PrincipiAttivi(COL_PA_COADIUVANTE, Riga)) = 0 Then

                    Fr_Cod = CInt(PrincipiAttivi(COL_FR_COD, Riga))
                    Pa_Cod = CInt(PrincipiAttivi(COL_PA_COD, Riga))
                    Titolo = CDec(PrincipiAttivi(COL_TITOLO, Riga))
                    Peso = CDec(PrincipiAttivi(COL_PESO, Riga))

                    PercAbb = 100
                    PercPa = 0
                    PesoPA = 0

                    DoseMax = 0
                    bDoseImpostata = False
                    bTitoloPercPA = False
                    bMiscela = False
                    bDoseAssenteDpi = False

                    RigaDiserbo = TrovaRiga_Diserbo(Fr_Cod, Pa_Cod)

                    Dim DoseMaxEtichetta As Decimal
                    DoseMaxEtichetta = PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, RigaDiserbo)

                    'Verifica la quantità di principio attivo distribuibile
                    'Ordinamento--> Precedenza alle non miscele
                    'RsDose.Sort = "Id_Paa_Misc Asc" 'Non modificare
                    dtDose = ObjDPI_AD.Leggi_Infestanti(Id_RcDpi,
                                                            Disciplinare_Cod,
                                                            1,
                                                            0,
                                                            Av_Gru,
                                                            Av_Cod,
                                                            Pa_Cod,
                                                            0,
                                                            0,
                                                            "",
                                                            Modulo,
                                                            Ep_Cod,
                                                            "",
                                                            "Id_Paa_Misc Asc",
                                                            objParametri)


                    If dtDose.Rows.Count > 0 Then

                        'Ricerca della dose + tollerante
                        Qta_PA = 0
                        Qta_Formulato = 0

                        Dim iDose As Integer

                        For iDose = 0 To dtDose.Rows.Count - 1

                            'Reset Parametri
                            bPAConsentito = False

                            'Impostazione % PA Consentito
                            '(07/05/2016 fede) modifica x eliminazione dosaggi diserbo dpi
                            If Not IsDBNull(dtDose.Rows(iDose).Item("PercPA")) Then
                                PercPa = dtDose.Rows(iDose).Item("PercPA")
                            Else
                                bDoseAssenteDpi = True
                            End If

                            PesoPA = 0
                            If Not IsDBNull(dtDose.Rows(iDose).Item("PesoPA")) Then
                                PesoPA = dtDose.Rows(iDose).Item("PesoPA")
                            End If

                            '(17/05/2016 fede) modifica x introduzione campo apposito
                            If Not IsDBNull(dtDose.Rows(iDose).Item("PercAbb")) Then
                                PercAbb = dtDose.Rows(iDose).Item("PercAbb")
                            End If


                            If (Not bTitoloPercPA) Or (PercPa = Titolo) Or ((PesoPA = Peso) And Peso <> 0 And PesoPA <> 0) Then

                                'Controllo se il titolo = percpa
                                'In questo caso ho trovato la riga di dpi dedicata al pa_cod  --> ricerca è valida solo per le restanti dosi aventi il medesimo percpa
                                If Titolo = PercPa Or PesoPA = Peso Then
                                    bTitoloPercPA = True
                                End If

                                'Verifico l'esistenza di una miscela
                                If Not IsDBNull(dtDose.Rows(iDose).Item("Id_Paa_Misc")) AndAlso CInt(dtDose.Rows(iDose).Item("Id_Paa_Misc")) <> 0 Then

                                    If Not bMiscela Then

                                        '=======================================================================================================
                                        'Verifico se il principio miscelabile è presente nella scheda intervento
                                        dtMiscela = ObjDPI_AD.Leggi_PA_Miscela(Id_RcDpi,
                                                                                   Disciplinare_Cod,
                                                                                   Agro_SQL_SaveNum(dtDose.Rows(iDose).Item("Id_Paa_Misc")),
                                                                                   1,
                                                                                   0,
                                                                                   Av_Gru,
                                                                                   Av_Cod,
                                                                                   0,
                                                                                   0,
                                                                                   Modulo,
                                                                                   Ep_Cod,
                                                                                   "",
                                                                                   "",
                                                                                   objParametri)

                                        If dtMiscela.Rows.Count > 0 Then

                                            strMiscela = ""

                                            For RigaPrincipiAttivi = 0 To UBound(PrincipiAttivi, 2) - 1
                                                'Controllo che il principio attivo non sia quello in esame
                                                If CInt(PrincipiAttivi(COL_PA_COD, RigaPrincipiAttivi)) <> Pa_Cod Then
                                                    'Aggiornamento stringa pa_cod presenti in scheda eventualmete miscelabili
                                                    strMiscela = strMiscela & "Pa_Cod = " & CInt(PrincipiAttivi(COL_PA_COD, RigaPrincipiAttivi)) & " OR "
                                                End If
                                            Next

                                            If Trim(strMiscela) <> "" Then
                                                'Fine Formattazione
                                                strMiscela = Left(strMiscela, Len(strMiscela) - 3)
                                                'Applico il Filtro
                                                'RsMiscela.Filter = strMiscela
                                                'Verifico se in scheda è stato impostata una miscela disciplinata
                                                'bMiscela = Not RsMiscela.EOF
                                                Dim Dr() As DataRow
                                                Dr = dtMiscela.Select(strMiscela)
                                                If Dr.Length > 0 Then
                                                    bMiscela = True
                                                Else
                                                    bMiscela = False
                                                End If
                                            End If

                                        End If

                                    End If
                                    '=======================================================================================================

                                    If bMiscela Or Qta_Formulato = 0 Then

                                        'Qta_Formulato = 0 quando il pa si trova solo disponibile in miscela!

                                        'Il principio attivo è miscelabile

                                        'Lettura dei dettagli della miscela
                                        dtMiscela = ObjDPI_AD.Leggi_Miscela(Id_RcDpi,
                                                                                Disciplinare_Cod,
                                                                                Agro_SQL_SaveNum(dtDose.Rows(iDose).Item("Id_Paa_Misc")),
                                                                                1,
                                                                                0,
                                                                                Av_Gru,
                                                                                Av_Cod,
                                                                                0,
                                                                                0,
                                                                                Modulo,
                                                                                Ep_Cod,
                                                                                "",
                                                                                "",
                                                                                objParametri)

                                        If dtMiscela.Rows.Count <> 0 Then
                                            'Per il calcolo della dose considero il RsMiscela
                                            dtCalcolo = dtMiscela.Copy
                                            bPAConsentito = True
                                        End If

                                    Else

                                        'Il pa si trova miscelato con un pa non presente in scheda
                                        bPAConsentito = False

                                    End If

                                Else

                                    Select Case bMiscela
                                        Case True
                                            'Il pa è in miscela--> non può essere valutato singolarmente
                                            bPAConsentito = False

                                        Case False
                                            'No Miscela

                                            'Per il calcolo della dose considero il dtDose
                                            dtCalcolo = dtDose.Copy
                                            bPAConsentito = True
                                    End Select

                                End If 'Fine Controllo Presenza Miscela


                                'Calcolo DOSI
                                If (Titolo <> 0 Or Peso <> 0) And bPAConsentito Then
                                    '
                                    DoseDPIAnno = 0
                                    DoseDPIMax = 0

                                    Select Case Gru_Cod
                                        '
                                        Case 1 'Arboree
                                            '(17/05/2016 fede) modifica x introduzione campo apposito
                                            If IsDBNull(dtCalcolo.Rows(0).Item("Dose_Max_Anno")) Then
                                                'Provo RsDose
                                                If IsDBNull(dtDose.Rows(iDose).Item("Dose_Max_Anno")) Then
                                                    'Eccezione
                                                    DoseDPI = 0
                                                    DoseDPIAnno = 0
                                                Else
                                                    DoseDPI = dtDose.Rows(iDose).Item("Dose_Max_Anno") * PercAbb / 100
                                                    DoseDPIAnno = dtDose.Rows(iDose).Item("Dose_Max_Anno") * PercAbb / 100
                                                    DoseDPIMax = dtDose.Rows(iDose).Item("Dose_Max_Anno")
                                                End If
                                            Else
                                                DoseDPI = dtCalcolo.Rows(0).Item("Dose_Max_Anno") * PercAbb / 100
                                                DoseDPIAnno = dtCalcolo.Rows(0).Item("Dose_Max_Anno") * PercAbb / 100
                                                DoseDPIMax = dtCalcolo.Rows(0).Item("Dose_Max_Anno")
                                            End If


                                        Case Else 'Erbacee, Orticole

                                            '(24/01/2019 fede) gestita PercAbb anche per erbacee ed orticole
                                            If IsDBNull(dtCalcolo.Rows(0).Item("DoseMax")) Then
                                                'Provo RsDose
                                                If IsDBNull(dtDose.Rows(iDose).Item("DoseMax")) Then
                                                    'Eccezione
                                                    DoseDPI = 0
                                                Else
                                                    DoseDPI = dtDose.Rows(iDose).Item("DoseMax") * PercAbb / 100
                                                    DoseDPIMax = dtDose.Rows(iDose).Item("DoseMax")
                                                End If
                                            Else
                                                DoseDPI = dtCalcolo.Rows(0).Item("DoseMax") * PercAbb / 100
                                                DoseDPIMax = dtCalcolo.Rows(0).Item("DoseMax")
                                            End If

                                    End Select

                                    '(07/05/2016 fede) modifica x eliminazione dosaggi diserbo dpi
                                    Qta_PA = 0
                                    Qta_Pa_Perc = 0
                                    Qta_Pa_Peso = 0
                                    Qta_Pa_Perc1_Peso2 = 0

                                    If bDoseAssenteDpi = True Then

                                        bDoseImpostata = True

                                        '(24/01/2019 fede) in caso di assenza dose dpi prendo la dose di etichetta
                                        If DoseMaxEtichetta > 0 And PercAbb < 100 Then

                                            DoseDPI = DoseMaxEtichetta * PercAbb / 100
                                            PercPa = Titolo
                                            PesoPA = Peso

                                            Qta_Pa_Perc = (DoseDPI * PercPa / 100)
                                            Qta_Pa_Peso = (DoseDPI * PesoPA / 1000)

                                            If PesoPA <> 0 And Peso <> 0 Then
                                                Qta_Confronto = DoseDPI * PesoPA / 1000 ' Format((DoseDPI * PesoPA / 1000), "###,##0.0###")
                                                Qta_Pa_Perc1_Peso2 = 2
                                            Else
                                                'Calcolo la Quantità di Principio Attivo Consentita in caso di Titolo = PercPA
                                                'DoseDPI : 100 = QTA : PercPA
                                                Qta_Confronto = DoseDPI * PercPa / 100 'Format((DoseDPI * PercPa / 100), "###,##0.0###") 'Non Modificare
                                                Qta_Pa_Perc1_Peso2 = 1
                                            End If

                                            'Confronto le qta ed imposto la + tollerante
                                            If (Qta_Confronto > DoseMax And DoseDPI > 0) Or (PercPa = Titolo) Or ((PesoPA = Peso) And Peso <> 0 And PesoPA <> 0) Then

                                                Qta_PA = Qta_Confronto
                                                DoseMax = Qta_Confronto

                                                If Titolo > 0 Then
                                                    Qta_Formulato_Perc = (Qta_Pa_Perc / Titolo) * 100
                                                End If
                                                If Peso > 0 Then
                                                    Qta_Formulato_Peso = (Qta_Pa_Peso / Peso) * 1000
                                                End If
                                                'Calcolo della Qta di Formulato Consentito
                                                If PesoPA <> 0 And Peso <> 0 Then
                                                    Qta_Formulato = Format((Qta_PA / Peso) * 1000, "###,##0.0##")
                                                    Qta_Formulato_Perc1_Peso2 = 2
                                                Else
                                                    Qta_Formulato = Format((Qta_PA / Titolo) * 100, "###,##0.0##")
                                                    Qta_Formulato_Perc1_Peso2 = 1
                                                End If

                                                bDoseImpostata = True

                                            End If

                                        End If


                                    Else

                                        Qta_Pa_Perc = (DoseDPI * PercPa / 100)
                                        Qta_Pa_Peso = (DoseDPI * PesoPA / 1000)

                                        If PesoPA <> 0 And Peso <> 0 Then
                                            Qta_Confronto = Format((DoseDPI * PesoPA / 1000), "###,##0.0##")
                                            Qta_Pa_Perc1_Peso2 = 2
                                        Else
                                            'Calcolo la Quantità di Principio Attivo Consentita in caso di Titolo = PercPA
                                            'DoseDPI : 100 = QTA : PercPA
                                            'Qta_Confronto = Format((DoseDPI * PercPa / 100), "###,##0.0###") 'Non Modificare
                                            Qta_Confronto = Format((DoseDPI * PercPa / 100), "###,##0.0##") 'Non Modificare
                                            Qta_Pa_Perc1_Peso2 = 1
                                        End If

                                        'Confronto le qta ed imposto la + tollerante
                                        If (Qta_Confronto > DoseMax And DoseDPI > 0) Or (PercPa = Titolo) Or ((PesoPA = Peso) And Peso <> 0 And PesoPA <> 0) Then

                                            Qta_PA = Qta_Confronto
                                            DoseMax = Qta_Confronto

                                            If Titolo > 0 Then
                                                Qta_Formulato_Perc = (Qta_Pa_Perc / Titolo) * 100
                                            End If
                                            If Peso > 0 Then
                                                Qta_Formulato_Peso = (Qta_Pa_Peso / Peso) * 1000
                                            End If
                                            'Calcolo della Qta di Formulato Consentito
                                            If PesoPA <> 0 And Peso <> 0 Then
                                                Qta_Formulato = Format((Qta_PA / Peso) * 1000, "###,##0.0##")
                                                Qta_Formulato_Perc1_Peso2 = 2
                                            Else
                                                Qta_Formulato = Format((Qta_PA / Titolo) * 100, "###,##0.0##")
                                                Qta_Formulato_Perc1_Peso2 = 1
                                            End If

                                            bDoseImpostata = True

                                            'If PercAbb > 0 And PercAbb < 100 Then
                                            '    PrincipiAttivi(COL_DETTAGLIO, Riga) = "Dose di formulato commerciale calcolata per superificie già ridotta al " & PercAbb & "%"
                                            'End If

                                        End If


                                    End If

                                    PrincipiAttivi(COL_TITOLO_DPI, Riga) = Format(PercPa, "###,##0.00#")
                                    PrincipiAttivi(COL_PESO_DPI, Riga) = Format(PesoPA, "###,##0.00#")
                                    PrincipiAttivi(COL_PERC_ABB, Riga) = Format(PercAbb, "###,##0.00#")
                                    PrincipiAttivi(COL_DOSE_MAX_DPI, Riga) = Format(DoseDPIMax, "###,##0.00#")

                                    PrincipiAttivi(COL_QTA_PA_PERC, Riga) = Format(Qta_Pa_Perc, "###,##0.00#")
                                    PrincipiAttivi(COL_QTA_PA_PESO, Riga) = Format(Qta_Pa_Peso, "###,##0.00#")
                                    PrincipiAttivi(COL_QTA_PA_PERC1_PESO2, Riga) = Qta_Pa_Perc1_Peso2.ToString

                                    '(24/01/2019 fede) aggiunta nota su calcolo fatto
                                    PrincipiAttivi(COL_DETTAGLIO, Riga) = ""
                                    If PercAbb > 0 And PercAbb < 100 Then
                                        If bDoseAssenteDpi = True Then
                                            PrincipiAttivi(COL_DETTAGLIO, Riga) = "Dose di formulato commerciale calcolata da dose massima di etichetta per superificie già ridotta al " & PercAbb & "%"
                                        Else
                                            PrincipiAttivi(COL_DETTAGLIO, Riga) = "Dose di formulato commerciale calcolata per superificie già ridotta al " & PercAbb & "%"
                                        End If
                                    End If

                                End If 'Fine Controllo Titolo <> 0 And bPAConsentito

                            End If 'Fine Controllo bTitoloPercPA

                        Next

                        'RigaDiserbo = TrovaRiga_Diserbo(Fr_Cod, Pa_Cod)

                        'Calcolo della dose di principio attivo distribuito
                        If PesoPA <> 0 And Peso <> 0 Then
                            PrincipiAttivi(COL_QTA, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 1000) * Peso), "###,##0.00#")
                            PrincipiAttivi(COL_QTA_FRCOD_PERC1_PESO2, Riga) = 2
                        Else
                            PrincipiAttivi(COL_QTA, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 100) * Titolo), "###,##0.00#")
                            PrincipiAttivi(COL_QTA_FRCOD_PERC1_PESO2, Riga) = 1
                        End If




                        Select Case bDoseImpostata

                            Case True 'PRODOTTO CONSENTITO

                                'Inserimento risultati nelle griglie
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo) = Qta_Formulato
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_DES, RigaDiserbo) = Format(Qta_Formulato, "###,##0.0##")
                                If bDoseAssenteDpi = False Then
                                    PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = Qta_Formulato 'DoseDPIAnno
                                Else
                                    PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = 0
                                End If

                                PrincipiAttivi(COL_DOSE_CONSENTITA, Riga) = Qta_PA
                                PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga) = Qta_PA
                                If bDoseAssenteDpi = False Then
                                    PrincipiAttivi(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = Qta_PA 'DoseDPIAnno
                                Else
                                    PrincipiAttivi(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = 0
                                End If

                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PERC, RigaDiserbo) = Format(Qta_Formulato_Perc, "###,##0.0##")
                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PESO, RigaDiserbo) = Format(Qta_Formulato_Peso, "###,##0.0##")
                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PERC1_PESO2, RigaDiserbo) = Qta_Formulato_Perc1_Peso2

                                PrincipiAttiviFormulato(COL_QTA_PA_FRCOD_PERC, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 100) * Titolo), "###,##0.00#")
                                PrincipiAttiviFormulato(COL_QTA_PA_FRCOD_PESO, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 1000) * Peso), "###,##0.00#")


                            Case False 'PRODOTTO NON CONSENTITO

                                'Inserimento risultati nelle griglie
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo) = 0
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_DES, RigaDiserbo) = "Non Consentito"
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = 0

                                PrincipiAttivi(COL_DOSE_CONSENTITA, Riga) = 0
                                PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga) = "Non Consentito"
                                PrincipiAttivi(COL_DOSE_CONSENTITA_ANNO, RigaDiserbo) = 0

                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PERC, RigaDiserbo) = Format(Qta_Formulato_Perc, "###,##0.0##")
                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PESO, RigaDiserbo) = Format(Qta_Formulato_Peso, "###,##0.0##")
                                PrincipiAttiviFormulato(COL_QTA_FRCOD_PERC1_PESO2, RigaDiserbo) = Qta_Formulato 'DoseDPIAnno

                                PrincipiAttiviFormulato(COL_QTA_PA_FRCOD_PERC, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 100) * Titolo), "###,##0.00#")
                                PrincipiAttiviFormulato(COL_QTA_PA_FRCOD_PESO, Riga) = Format(((CDbl(PrincipiAttiviFormulato(COL_QTA, RigaDiserbo)) / 1000) * Peso), "###,##0.00#")

                                PrincipiAttivi(COL_TITOLO_DPI, Riga) = 0
                                PrincipiAttivi(COL_PESO_DPI, Riga) = 0
                                PrincipiAttivi(COL_PERC_ABB, Riga) = 0
                                PrincipiAttivi(COL_DOSE_MAX_DPI, Riga) = 0
                                PrincipiAttivi(COL_QTA_PA_PERC, Riga) = 0
                                PrincipiAttivi(COL_QTA_PA_PESO, Riga) = 0
                                PrincipiAttivi(COL_QTA_PA_PERC1_PESO2, Riga) = 0

                        End Select


                    End If

                End If

            Next


        Next


        '----------------------------------------------------------------------------------------------
        'Standardizzazione 'Diserbo'
        Riga = 0

        Do While Riga < UBound(PrincipiAttiviFormulato, 2)

            Fr_Cod = CInt(PrincipiAttiviFormulato(COL_FR_COD, Riga))

            Riga_Start = Riga

            'Controllo che la dose di etichetta sia disponibile
            Qta_Formulato = PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, Riga)

            Row_Min = Riga

            Col_Min = COL_DOSE_ETICHETTA
            Col_Min_Des = COL_DOSE_ETICHETTA_DES

            For Riga_End = Riga_Start To UBound(PrincipiAttiviFormulato, 2) - 1

                If CInt(PrincipiAttiviFormulato(COL_FR_COD, Riga_End)) = Fr_Cod Then

                    Riga = Riga_End

                    'Stesso formulato
                    If PrincipiAttiviFormulato(COL_PA_COADIUVANTE, Riga_End) = 1 Then

                        If IsNumeric(PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, Riga_End)) Then
                            PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, Riga_End) = PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, Riga_End)
                            PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_DES, Riga_End) = PrincipiAttiviFormulato(COL_DOSE_ETICHETTA_DES, Riga_End)
                        Else
                            PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_DES, Riga_End) = "Indefinito"
                        End If

                    End If

                    If IsNumeric(PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, Riga_End)) Then
                        If Qta_Formulato > CDbl(PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, Riga_End)) Then

                            'Nuovo Minimo Disciplinare
                            Qta_Formulato = CDbl(PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, Riga_End))
                            Row_Min = Riga_End
                            Col_Min = COL_DOSE_CONSENTITA
                            Col_Min_Des = COL_DOSE_CONSENTITA_DES

                        End If

                    End If

                End If

            Next

            'Coloro il Risultato
            Select Case Col_Min
                Case COL_DOSE_CONSENTITA
                    strConsentito = "disciplinare."
                Case COL_DOSE_ETICHETTA
                    strConsentito = "etichetta."

                    'Si rende necessaria la modifica delle dosi sui principi attivi
                    For Riga_End = Riga_Start To UBound(PrincipiAttivi, 2) - 1

                        If CInt(PrincipiAttivi(COL_FR_COD, Riga_End)) = Fr_Cod Then

                            If Not IsNumeric(PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End)) Then
                                PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End) = 0
                            End If

                            Pa_Cod = CInt(PrincipiAttivi(COL_PA_COD, Riga_End))

                            'Se la dose consentita è quella di etichetta --> occorre rapportare tutti i
                            'quantitativi di pa all'interno della griglia dei totali poichè impostati
                            'sul disciplinare

                            RigaDiserbo = TrovaRiga_Diserbo(Fr_Cod, Pa_Cod)

                            If IsNumeric(PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo)) Then

                                PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End) = Format((CDbl(PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End)) * CDbl(PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, RigaDiserbo))) / CDbl(PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo)), "###,##0.000")
                                PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga_End) = PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End)

                            Else

                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo) = 100000
                                PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo) = "Non Disponibile"
                                PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_End) = 100000
                                PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga_End) = "Indefinito"

                            End If

                        End If

                    Next

            End Select


            For Riga_End = Riga_Start To UBound(PrincipiAttiviFormulato, 2) - 1

                If CInt(PrincipiAttiviFormulato(COL_FR_COD, Riga_End)) = Fr_Cod Then

                    'Indico la colonna con la dose minore
                    PrincipiAttiviFormulato(COL_DOSE_MINIMA, Riga_End) = Col_Min
                    PrincipiAttiviFormulato(COL_DOSE_MINIMA_DES, Riga_End) = Col_Min_Des

                    If CDbl(PrincipiAttiviFormulato(COL_QTA, Riga_End)) = 0 Then

                        'Prodotto Non Distribuito
                        PrincipiAttiviFormulato(COL_CONFORMITA, Riga_End) = 2

                    Else

                        If Qta_Formulato < CDbl(PrincipiAttiviFormulato(COL_QTA, Riga_End)) Then

                            'Non conforme
                            PrincipiAttiviFormulato(COL_CONFORMITA, Riga_End) = 0

                        Else
                            'Ok
                            PrincipiAttiviFormulato(COL_CONFORMITA, Riga_End) = 1

                        End If

                    End If

                End If

            Next

            Riga = Riga + 1

        Loop


        'Standardizzazione Principi Attivi
        For Riga = 0 To UBound(PrincipiAttivi, 2) - 1

            If PrincipiAttivi(COL_MERGE, Riga) = 1 Then

                Pa_Cod = PrincipiAttivi(COL_PA_COD, Riga)
                Qta_PA = 100000 'Dummy
                Qta = 0

                For Riga_Merge = 0 To UBound(PrincipiAttivi, 2) - 1

                    If Pa_Cod = PrincipiAttivi(COL_PA_COD, Riga_Merge) Then

                        'Aggiornamento Qta
                        Qta = Qta + PrincipiAttivi(COL_QTA, Riga_Merge)

                        If Qta_PA > PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_Merge) Then
                            'Aggiornamento (Nuovo Minimo)
                            Qta_PA = PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_Merge)
                            Qta_PA_Des = PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga_Merge)
                            Fr_Cod = PrincipiAttivi(COL_FR_COD, Riga_Merge)

                            RigaDiserbo = TrovaRiga_Diserbo(Fr_Cod, Pa_Cod)
                            DoseDPI = PrincipiAttiviFormulato(COL_DOSE_CONSENTITA, RigaDiserbo)
                            DoseDPI_Des = PrincipiAttiviFormulato(COL_DOSE_CONSENTITA_DES, RigaDiserbo)

                        End If

                    End If

                Next


                For Riga_Merge = 0 To UBound(PrincipiAttivi, 2) - 1

                    If Pa_Cod = PrincipiAttivi(COL_PA_COD, Riga_Merge) Then

                        'Allineamento Minimo per Tutti i PA_Cod Identici
                        PrincipiAttivi(COL_DOSE_CONSENTITA, Riga_Merge) = Qta_PA
                        PrincipiAttivi(COL_DOSE_CONSENTITA_DES, Riga_Merge) = Qta_PA_Des
                        PrincipiAttivi(COL_QTA, Riga_Merge) = Format(Qta, "###,##0.00#")

                        Fr_Cod = PrincipiAttivi(COL_FR_COD, Riga_Merge)

                    End If
                Next

            End If

        Next

    End Sub






    '-------------------------------------------------------------------------------------------------------------
    'Trova la riga corrispondente al Fr_Cod all'interno della matrice 'Diserbo'
    Private Function TrovaRiga_Diserbo(ByVal Fr_Cod As Integer,
                                        ByVal Pa_Cod As Integer) As Integer

        Dim Riga As Integer

        For Riga = 0 To UBound(PrincipiAttiviFormulato, 2) - 1
            If Fr_Cod = PrincipiAttiviFormulato(COL_FR_COD, Riga) And
               Pa_Cod = PrincipiAttiviFormulato(COL_PA_COD, Riga) Then
                TrovaRiga_Diserbo = Riga
                Exit For
            End If
        Next

    End Function

    '-------------------------------------------------------------------------------------------------------------
    '    'Routine per il calcolo del numero di interventi associati ad un elenco di principi attivi eseguiti su un intervento in modalità insert
    '    'Nota: il numero di interventi non può essere logicamente > 1!.

    '    'Numero_Interventi = 0. Non esistono vincoli sui pa nell'intervento da inserire.
    '    'Numero_Interventi = 1. Esistono uno o + vincoli sui pa nell'intervento da inserire. Essendo la combinazione di pa presente in un unico intervento il max valore è 1.

    Private Function Numero_Interventi(ByVal Terna(,) As String,
                                    ByVal xDatiDettagli As XmlNodeList,
                                   ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                   ) As Integer


        Dim xDatiDettaglio As XmlElement
        Dim xDettagli As XmlNodeList
        Dim xDettaglio As XmlElement
        Dim i As Integer
        Dim i_DatiDettagli As Integer
        Dim i_DatiDettaglio As Integer
        Dim dtFormulatixPA As DataTable
        Dim Pro_Cod_Dettaglio As Integer
        Dim Av_Gru_Dettaglio As Integer
        Dim Av_Cod_Dettaglio As Integer

        'Conta il numero di interventi nel movimenti non in archivio
        Dim ObjFormulatixPA_R As New AgronicaCoreMetaSchemaDAL.FormulatixPrincipiAttivi_R

        i_DatiDettagli = 0
        Numero_Interventi = 0

        Do While i_DatiDettagli < xDatiDettagli.Count

            'Prelevo l'i-esimo Blocco di Dettagli (ne esiste 1 solo)
            xDatiDettaglio = xDatiDettagli.Item(i_DatiDettagli)

            xDettagli = xDatiDettaglio.GetElementsByTagName("Dettaglio")

            i_DatiDettaglio = 0

            Do While i_DatiDettaglio < xDettagli.Count

                'Prelevo l'i-esimo Dettaglio
                xDettaglio = xDettagli.Item(i_DatiDettaglio)

                '===================================================================
                'Lettura dell'avversità associata al prodotto
                '===================================================================
                Av_Gru_Dettaglio = Agro_SQL_SaveNum(xDettaglio.GetAttribute("av_gru"))
                Av_Cod_Dettaglio = Agro_SQL_SaveNum(xDettaglio.GetAttribute("av_cod"))
                Pro_Cod_Dettaglio = Agro_SQL_SaveNum(xDettaglio.GetAttribute("pro_cod"))

                'Lettura del Principio Attivo del Prodotto
                dtFormulatixPA = ObjFormulatixPA_R.Leggi(Pro_Cod_Dettaglio,
                                                         0,
                                                         AGRODATAINIZIO,
                                                         AGRODATAFINE,
                                                         AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                         "",
                                                         "",
                                                         objParametri)

                If dtFormulatixPA.Rows.Count <> 0 Then

                    'Do While Not rsFormulatixPA.EOF And Numero_Interventi = 0
                    Dim iFPA As Integer
                    For iFPA = 0 To dtFormulatixPA.Rows.Count - 1


                        'Scorro la Terna alla ricerca delle coppie
                        For i = 0 To UBound(Terna, 2) - 1

                            If CInt(Terna(2, i)) = Av_Cod_Dettaglio And
                               CInt(Terna(3, i)) = dtFormulatixPA.Rows(iFPA).Item("Pa_Cod") Then

                                Numero_Interventi = Numero_Interventi + 1

                            End If

                        Next i

                    Next iFPA

                End If

                i_DatiDettaglio = i_DatiDettaglio + 1

            Loop

            i_DatiDettagli = i_DatiDettagli + 1

        Loop


    End Function


