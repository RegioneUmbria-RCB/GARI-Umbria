                                                        End If

                                                        'Inserimento del Formulato nella Struttura di Appoggio 'Diserbo
                                                        FormCaricaFormulato(Veg_Cod, Ep_Cod, Av_Gru, Av_Cod, Pro_Cod, Qta_DistribuitaxEttaro, Grfi_Cod, bCoadiuvante, Data, objParametri_Matrice)


                                                    Case 0 'Difesa



                                                        'LimiteInterventi = 0
                                                        'UDM_COD_Limite = 0
                                                        'IntervalloTrattamenti_Min = 0
                                                        'IntervalloTrattamenti_Max = 0
                                                        IncludiOperazione = 0

