                                    '        'If Destinazioni(i_LunghezzaConfine_BufferZone, jk) > 0 And Destinazioni(i_Sup_Riduzione_BufferZone, jk) = 0 Then
                                    '        If CDec(Destinazioni(i_LunghezzaConfine_BufferZone, jk)) > 0 And (CDec(Destinazioni(i_Sup_Imp, jk)) = CDec(Destinazioni(i_Sup_Trattata, jk))) Then
