                                            Dim drEpocaA() As DataRow = Dt_Stadi.Select("ep_cod=" & Epoca_A)
                                            If Not drEpocaA Is Nothing AndAlso drEpocaA.Length > 0 Then
                                                Select Case drEpocaA(0).Item("tipo_scala")
                                                    Case 2
                                                        Stadio_A = drEpocaA(0).Item("stadio_principale") & drEpocaA(0).Item("seconda_cifra")
                                                    Case 3
                                                        Stadio_A = drEpocaA(0).Item("stadio_principale") & drEpocaA(0).Item("seconda_cifra") & drEpocaA(0).Item("terza_cifra")
                                                End Select
                                            End If
                                        End If


                                        For jk = 0 To UBound(Destinazioni, 2) - 1

