                                Err_Des = "La dose di principio attivo '" & PrincipiAttivi(COL_PA_DES, Riga) & "' distribuita (" & PrincipiAttivi(COL_QTA, Riga) & "/Ha) risulta essere eccessiva e non conforme il disciplinare (" & PrincipiAttivi(COL_DOSE_CONSENTITA, Riga) & ")."

