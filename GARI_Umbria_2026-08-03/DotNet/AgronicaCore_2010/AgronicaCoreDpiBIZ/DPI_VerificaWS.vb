    Private Function OttieniListaImpiantiDaArrayDestinazioni(destinazioni As String(,)) As List(Of Object)

        Dim retVal As New List(Of Object)
        Dim colonne As Integer = destinazioni.GetLength(0) - 1
        Dim righe As Integer = destinazioni.GetLength(1) - 1

        For r As Integer = 0 To righe - 1
            retVal.Add(New With
                        {
                            .SupImpianto = CDec(destinazioni(i_Sup_Imp, r)),
                            .SupTrattata = CDec(destinazioni(i_Sup_Trattata, r))
                        })
        Next

        Return retVal

    End Function

    Private Function Verifica_Perc_Abb(ByVal PrincipiAttivi As String(,),
                                     ByVal riga As Integer,
                                     ByVal destinazioni As String(,),
                                     ByVal xDettagli As XmlNodeList,
                                     ByRef messaggioErrore As String
                                     ) As Boolean

        messaggioErrore = String.Empty

        Dim sb As New StringBuilder
        Dim percAbb = CDec(PrincipiAttivi(COL_PERC_ABB, riga))
        Dim udm_cod As Integer = 0
        Dim udm_des As String = String.Empty
        Dim doseMaxDpi As Decimal = CDec(PrincipiAttivi(COL_DOSE_MAX_DPI, riga))
        Dim proCod = PrincipiAttivi(COL_FR_COD, riga)
        Dim DoseImpostata As Decimal = 0
        Dim qtaConsentitePerImpianto As New List(Of Decimal)


        Dim titolo As Decimal = CDec(PrincipiAttivi(COL_TITOLO, riga))
        Dim qtaTotaleProdottoDistribuita As Decimal = 0
        Dim qtaTotalePADistribuita As Decimal = 0
        Dim qtaMaxProdottoConsentita As Decimal = 0
        Dim qtaMaxPAConsentita As Decimal = 0
        Dim supTotaleTrattata As Decimal = 0
        Dim supTotaleTrattabile As Decimal = 0
        Dim principioAttivoDes As String = PrincipiAttivi(COL_PA_DES, riga)

        ' Ricavo la dose impostata per HA
        For xd As Integer = 0 To xDettagli.Count - 1
            Dim xDet = xDettagli.Item(xd)
            If xDet.Attributes("pro_cod").Value = proCod Then
                DoseImpostata = CDec(xDet.Attributes("dose").Value)
                udm_cod = CInt(xDet.Attributes("udm_cod").Value)
                Exit For
            End If
        Next

        Dim percAbbRispettata As Boolean = True

        ' Se Presente la Perc ABB ciclo per ogni impianto per verificare se la dose impostata * la superficie trattata di ogni impianto
        ' non sforra la dose massima consentita
        If percAbb > 0 AndAlso percAbb < 100 Then
            Dim impianti = OttieniListaImpiantiDaArrayDestinazioni(destinazioni).ToList

            For Each imp In impianti
                Dim supTrattabile = Agro_Math.ArrotondaVal_4(imp.SupImpianto * percAbb / 100)

                Dim qtaConfrontoDPI = supTrattabile * doseMaxDpi
                qtaConsentitePerImpianto.Add(qtaConfrontoDPI)

                Dim qtaConfrontoData = CDec(DoseImpostata * imp.SupTrattata)
                If Agro_Math.ArrotondaVal_4(qtaConfrontoData) > Agro_Math.ArrotondaVal_4(qtaConfrontoDPI) Then
                    percAbbRispettata = False
                End If
            Next

            If Not percAbbRispettata Then

                supTotaleTrattata = impianti.Sum(Function(i) CDec(i.SupTrattata))
                supTotaleTrattabile = (impianti.Sum(Function(i) CDec(i.SupImpianto))) * percAbb / 100
                qtaTotaleProdottoDistribuita = Agro_Math.ArrotondaVal_3(DoseImpostata * supTotaleTrattata)
                qtaTotalePADistribuita = Agro_Math.ArrotondaVal_3(qtaTotaleProdottoDistribuita * titolo / 100)
                qtaMaxProdottoConsentita = Agro_Math.ArrotondaVal_3(DoseImpostata * supTotaleTrattabile)
                qtaMaxPAConsentita = Agro_Math.ArrotondaVal_3(qtaMaxProdottoConsentita * titolo / 100)
                udm_des = Dammi_UDM_DES_X_Verifica_Perc_Abb(udm_cod)

                sb.AppendFormat("La quantita totale di prodotto distribuita ( {0} {3} di cui {1} {3} di '{2}') ", qtaTotaleProdottoDistribuita, qtaTotalePADistribuita, principioAttivoDes, udm_des)
                sb.AppendFormat("risulta essere eccessiva rispetto alla totale consentita da disciplinare ( {0} {3} di cui {1} {3} di '{2}'). ", qtaMaxProdottoConsentita, qtaMaxPAConsentita, principioAttivoDes, udm_des)
                sb.AppendFormat("E' necessario trattare al massimo il {0}% della superficie.", percAbb)
                messaggioErrore = sb.ToString

                PrincipiAttivi(COL_DOSE_CONSENTITA, riga) = qtaMaxProdottoConsentita
            End If

            Return percAbbRispettata

        Else
            Return True
        End If

    End Function

    Private Function Dammi_UDM_DES_X_Verifica_Perc_Abb(ByVal udm_cod As Integer) As String

        Select Case udm_cod

            Case 29
                Return "l"
            Case 104
                Return "cc"
            Case 101
                Return "ml"
            Case 2 'Kg
                Return "Kg"
            Case 3 'g
                Return "g"
            Case 4 'q
                Return "q"
            Case 304 't
                Return "t"
            Case Else
                Return "Indefinita"
        End Select

    End Function

    Private Sub CheckPolverulento(Pro_Cod As Integer, ByRef hasNoNPolverulenti As Boolean, ByRef hasPolverulenti As Boolean, objParametri_Matrice As AgronicaCoreParametri)
        Dim polverulento As Integer = 0
        Dim objFormulatixFormulazioni As New AgronicaCoreMetaSchemaDAL.FormulatixFormulazioni_R
        Dim dt_FormulatixFormulazioni = objFormulatixFormulazioni.Leggi_Polverulenti(Pro_Cod, "", AGRODATAINIZIO, AGRODATAFINE, "", "", objParametri_Matrice)
        If dt_FormulatixFormulazioni.Rows.Count > 0 Then
            If Not IsDBNull(dt_FormulatixFormulazioni.Rows(0).Item("polverulento")) Then
                polverulento = dt_FormulatixFormulazioni.Rows(0).Item("polverulento")
            End If
        End If

        If polverulento = 0 Then
            hasNoNPolverulenti = True
        Else
            hasPolverulenti = True
        End If
    End Sub

    Private Sub InserisciNonConformita_Polverulento(hasNoNPolverulenti As Boolean,
                                                        hasPolverulenti As Boolean,
                                                        ByRef DatiInseriti(,) As String,
