                                                        Av_Cod_Dose_Max = 0
                                                        Av_Gru_dose_Max = 0

                                                    Case enTipoWarning_Verifica.Dose_MaxAnno_xAvversita_Infestante

                                                        strAvversita_Dose_Max = Avversita_Des
                                                        Av_Cod_Dose_Max = Av_Cod
                                                        Av_Gru_dose_Max = Av_Gru


                                                    Case Else

