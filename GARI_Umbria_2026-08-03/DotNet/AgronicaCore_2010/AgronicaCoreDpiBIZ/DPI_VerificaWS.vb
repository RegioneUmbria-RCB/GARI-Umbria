                                            IncludiOperazione = 1
                                        Case Else
                                            IncludiOperazione = 0
                                    End Select

                                    Erase ArrayErr_Code, ArrayErr_Des, ArrayWarning_Code, ArrayWarning_Des
                                    Erase LimiteInterventi, UDM_COD_Limite, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max, Num_Max_Interventi_Globali, Array_For_Veg_Av_Dos_Cod, Array_Gruppo_Dosaggi, Dose_Max

                                    'Dim Av_Gru_Dose As Integer = 0
                                    'Dim Av_Cod_Dose As Integer = 0

                                    'If TipoTestata = 1 And Av_Cod = -3 And Av_Gru = -3 Then
                                    '    Av_Gru_Dose = -3
                                    '    Av_Cod_Dose = -3
                                    'End If

                                    ObjDPI_Dose_Difesa.Dose_Verifica_2(ArrayErr_Code, ArrayErr_Des,
