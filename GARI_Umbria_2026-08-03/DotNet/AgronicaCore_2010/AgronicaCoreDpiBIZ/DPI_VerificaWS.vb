    Private Function CheckBypassLimitazione(ByRef Elenco_Fr_Cod_Limitazione As String, ByVal Collegamento_Formulati As Integer, ByVal ID_Lu As Integer, ByVal Fr_Cod As Integer, ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri) As Boolean
        Dim bBypass As Boolean = False
        Dim ObjDPI_AD As New AgronicaCoreDpiDAL.Dpi_R
        Dim DTLimitazionixFormulati As New DataTable
        Dim xFiltro As String = ""

        Elenco_Fr_Cod_Limitazione = "" 'Inizializzazione

        Select Case Collegamento_Formulati

            Case 0

                bBypass = False

            Case 1, 2 'Includi/Escludi

                bBypass = True 'Inizializzazione
                DTLimitazionixFormulati = ObjDPI_AD.Leggi_LimitazioniUsoxFormulati_Deroghe(ID_Lu, "", "", objParametri)

                If DTLimitazionixFormulati.Rows.Count <> 0 Then

                    'Verifico che la condizione di inserimento sia soddisfatta
                    Dim Dr() As DataRow
                    If Collegamento_Formulati = 1 Then
                        xFiltro = "Fr_Cod = " & Fr_Cod
                    Else
                        xFiltro = "Fr_Cod <> " & Fr_Cod
                    End If

                    Dr = DTLimitazionixFormulati.Select(xFiltro)
                    If Not Dr Is Nothing AndAlso Dr.Length > 0 Then

                        bBypass = False

                        For Each dr_limitazioni As DataRow In DTLimitazionixFormulati.Rows
                            Elenco_Fr_Cod_Limitazione = Elenco_Fr_Cod_Limitazione & dr_limitazioni("Fr_Cod") & ","
                        Next

                        'Formatto ed Elimino la virgola
                        Elenco_Fr_Cod_Limitazione = "(" & Left(Elenco_Fr_Cod_Limitazione, Len(Elenco_Fr_Cod_Limitazione) - 1) & ")"

                    End If

                End If


            Case Else 'Non Gestito

                bBypass = False

        End Select

        Return bBypass


    End Function


