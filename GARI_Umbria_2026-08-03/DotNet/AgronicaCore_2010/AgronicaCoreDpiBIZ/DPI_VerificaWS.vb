                                                                                                                                                    CInt(dtId_Paa.Rows(iIP).Item("Id_Paa")))

                                                                                                                                End If

                                                                                                                            Next
                                                                                                                        End If

                                                                                                                    Next

                                                                                                                End If

                                                                                                            End If


                                                                                                        Case 1

                                                                                                            'Da fare

