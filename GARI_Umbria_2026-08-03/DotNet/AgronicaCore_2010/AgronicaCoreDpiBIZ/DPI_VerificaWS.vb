                                        Erase LimiteInterventi, UDM_COD_Limite, IntervalloTrattamenti_Min, IntervalloTrattamenti_Max, Num_Max_Interventi_Globali, Array_For_Veg_Av_Dos_Cod, Array_Gruppo_Dosaggi, Dose_Max

                                        ObjDPI_Dose_Difesa.Dose_Verifica_2(ArrayErr_Code, ArrayErr_Des,
                                                                           ArrayWarning_Code, ArrayWarning_Des,
                                                                           Lav_Cod,
                                                                           Veg_Cod,
                                                                           Pro_Cod,
                                                                           Pro_Des,
                                                                           Mezzo,
                                                                           Mezzo_Det,
                                                                           Udm_Cod,
                                                                           Dose_Ha,
                                                                           Dose_Hl,
                                                                           H2O, Acqua,
                                                                           Sup_Totale,
                                                                           Av_Gru,
                                                                           Av_Cod,
                                                                           Grfi_Cod,
                                                                           Avversita_Filtro,
                                                                           LimiteInterventi, UDM_COD_Limite,
                                                                           IntervalloTrattamenti_Min, IntervalloTrattamenti_Max,
                                                                           For_Veg_Av_Dos_Cod, Data,
                                                                           FormulatiXAllegatiNormative_IDRiga,
                                                                           TipoTestata, Gruppo_Dosaggi,
                                                                           Num_Max_Interventi_Globali, Array_For_Veg_Av_Dos_Cod, Array_Gruppo_Dosaggi,
                                                                           Dose_Max,
                                                                           objParametri_Matrice)


                                        If Not ArrayErr_Code Is Nothing AndAlso ArrayErr_Code.Length > 0 Then
                                            For e = 0 To ArrayErr_Code.Length - 1
                                                Dim dose As Decimal = If(Mezzo_Det = enum_MezzoLavorazione.Distribuzione_Ha, Dose_Ha, Dose_Hl)
                                                Inserisci_NonConformita(DatiInseriti,
                                                                        XmlDoc,
                                                                        XmlDatiNonConformi,
                                                                        ArrayErr_Code(e),
                                                                        ArrayErr_Des(e),
                                                                        "Rispettare la dose consigliata da etichetta.",
                                                                        Pro_Cod,
                                                                        Pro_Des,
                                                                        0,
