                                       CInt(Infestanti(COL_AV_COD, Riga)) = Av_Cod Then

                                            bDuplicato = True
                                            Exit For

                                        End If

                                    Next
                                    '================================================================

                                    If Not bDuplicato Then
                                        'Inserimento Infestante in Matrice di Appoggio 'Infestanti'
                                        ReDim Preserve Infestanti(nColonne, UBound(Infestanti, 2) + 1)
                                        Infestanti(COL_AV_GRU, UBound(Infestanti, 2) - 1) = Av_Gru
                                        Infestanti(COL_AV_COD, UBound(Infestanti, 2) - 1) = Av_Cod
                                        Infestanti(COL_INFESTANTE_DES, UBound(Infestanti, 2) - 1) = Avversita_Des
                                    End If

