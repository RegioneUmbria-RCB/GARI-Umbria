    Private Function ElencoPA(ByRef strPA As String,
                              ByVal Terna(,) As String,
                              ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                              ) As String

        Dim i As Int32

        strPA = ""

        For i = 0 To UBound(Terna, 2) - 1
            If Terna(3, i) <> "0" Then
                strPA = strPA & IIf(Trim(strPA) = "", "", ", ") & Terna(3, i)
            Else
                strPA = strPA & IIf(Trim(strPA) = "", "", ", ") & Terna(6, i)
            End If
        Next

        strPA = " (" & strPA & ")"

        '========================================================================================================

        Dim ObjPrincipiAttivi As New AgronicaCoreMetaSchemaDAL.PrincipiAttivi_R
        Dim DtPA As DataTable

        DtPA = ObjPrincipiAttivi.Leggi(0, AGRODATAINIZIO,
                                       AGRODATAFINE,
                                       AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                        " PA_COD IN " & strPA & " ",
                                        "", objParametri)


        ElencoPA = ""

        If DtPA.Rows.Count <> 0 Then
            Dim iPA As Integer
            For iPA = 0 To DtPA.Rows.Count - 1
                ElencoPA = ElencoPA & IIf(Trim(ElencoPA) = "", "", ", ") & LCase(DtPA.Rows(iPA).Item("Pa_Des"))
            Next
        End If


        'Distruggo gli oggetti
        ObjPrincipiAttivi = Nothing
        DtPA = Nothing


    End Function


    Private Function ElencoPA_conMiscele(ByVal strPA As String,
                           ByVal Terna(,) As String,
                           ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                           ) As String

        Dim i, j As Int32

        Dim PaCod As String = ""
        Dim ArrayPa() As String
        Dim ArrayMisc() As String

        ArrayPa = Split(Mid(strPA, 2, strPA.Length - 2), ",")
        If Not ArrayPa Is Nothing Then
            For i = 0 To ArrayPa.Length - 1
                If InStr(ArrayPa(i), "+") <> 0 Then
                    ArrayMisc = Split(ArrayPa(i), "+")
                    If Not ArrayMisc Is Nothing Then
                        For j = 0 To ArrayMisc.Length - 1
                            PaCod &= ArrayMisc(j) & ","
                        Next
                    End If
                Else
                    PaCod &= ArrayPa(i) & ","
                End If
            Next
        End If

        PaCod = " (" & Left(PaCod, PaCod.Length - 1) & ")"

        'For i = 0 To UBound(Terna, 2) - 1
        '    If Terna(3, i) <> "0" Then
        '        strPA = strPA & IIf(Trim(strPA) = "", "", ", ") & Terna(3, i)
        '    Else
        '        strPA = strPA & IIf(Trim(strPA) = "", "", ", ") & Terna(6, i)
        '    End If
        'Next

        'strPA = " (" & strPA & ")"

        '========================================================================================================

        Dim ObjPrincipiAttivi As New AgronicaCoreMetaSchemaDAL.PrincipiAttivi_R
        Dim DtPA As DataTable
        Dim DrPa() As DataRow

        DtPA = ObjPrincipiAttivi.Leggi(0, AGRODATAINIZIO,
                                       AGRODATAFINE,
                                       AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                        " PA_COD IN " & PaCod & " ",
                                        "", objParametri)


        Dim strElencoPA As String = ""
        Dim strMisc As String

        If DtPA.Rows.Count <> 0 Then

            For i = 0 To ArrayPa.Length - 1
                If InStr(ArrayPa(i), "+") <> 0 Then
                    strMisc = ""
                    ArrayMisc = Split(ArrayPa(i), "+")
                    If Not ArrayMisc Is Nothing Then
                        For j = 0 To ArrayMisc.Length - 1
                            DrPa = DtPA.Select("pa_cod=" & ArrayMisc(j))
                            If Not DrPa Is Nothing AndAlso DrPa.Length > 0 Then
                                strMisc &= LCase(DrPa(0).Item("pa_des")) & "+"
                            End If
                        Next
                    End If
                    If strMisc <> "" Then
                        strElencoPA &= Left(strMisc, strMisc.Length - 1) & ","
                    End If
                Else
                    DrPa = DtPA.Select("pa_cod=" & ArrayPa(i))
                    If Not DrPa Is Nothing AndAlso DrPa.Length > 0 Then
                        strElencoPA &= LCase(DrPa(0).Item("pa_des")) & ","
                    End If
                End If
            Next

            If strElencoPA <> "" Then
                Return Left(strElencoPA, strElencoPA.Length - 1)
            End If

        End If


        'Distruggo gli oggetti
        ObjPrincipiAttivi = Nothing
        DtPA = Nothing


    End Function





    Private Sub FormCaricaFormulato(ByVal Veg_Cod As Int32,
                                    ByVal Ep_Cod As Int32,
                                    ByVal Av_Gru As Int32,
                                    ByVal Av_Cod As Int32,
                                    ByVal Pro_Cod As Int32,
                                    ByVal Qta As Decimal,
                                    ByVal grfi_cod As Integer,
                                    ByVal bCoadiuvante As Boolean,
                                    ByVal Data As Date,
                                    ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                    )

        Dim Udm_Cod As Integer
        Dim Dose_min As Decimal
        Dim Dose_Max As Decimal
        Dim bFirst As Boolean
        Dim Descrizione As String


        Dim ObjPA As New AgronicaCoreMetaSchemaDAL.FormulatixPrincipiAttivi_R
        Dim ObjDose As New AgronicaCoreDpiBIZ.Dose_Difesa_Verifica_R
        Dim DtPA As DataTable

        DtPA = ObjPA.Leggi(Pro_Cod,
                            0,
                            AGRODATAINIZIO,
                            AGRODATAFINE,
                            AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                            "",
                            "Titolo Desc",
                            objParametri)

        If DtPA.Rows.Count <> 0 Then
            'Ordinamento per Titolo
            'rsPA.Sort = "Titolo Desc"
            bFirst = True

            Dim iPA As Integer
            For iPA = 0 To DtPA.Rows.Count - 1

                ReDim Preserve PrincipiAttiviFormulato(nColonne, UBound(PrincipiAttiviFormulato, 2) + 1)

                PrincipiAttiviFormulato(COL_FR_COD, UBound(PrincipiAttiviFormulato, 2) - 1) = Pro_Cod

                If bFirst Then

                    'Lettura della dose etichetta
                    ObjDose.Dose_Etichetta(Udm_Cod,
                                           Dose_min,
                                           Dose_Max,
                                           Descrizione,
                                           Pro_Cod,
                                           1,
                                           Veg_Cod,
                                           Av_Cod,
                                           Av_Gru,
                                           Ep_Cod,
                                            grfi_cod,
                                           bCoadiuvante,
                                           Data,
                                           objParametri)

                    PrincipiAttiviFormulato(COL_DOSE_ETICHETTA_DES, UBound(PrincipiAttiviFormulato, 2) - 1) = Descrizione

                    Select Case Udm_Cod
                        Case Is > 0
                            'Dose Etichetta Disponibile
                            PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, UBound(PrincipiAttiviFormulato, 2) - 1) = Dose_Max

                        Case Else
                            'Dose Etichetta Non Disponibile
                            PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, UBound(PrincipiAttiviFormulato, 2) - 1) = 100000  'Dummy
                    End Select

                    PrincipiAttiviFormulato(COL_UDM_COD, UBound(PrincipiAttiviFormulato, 2) - 1) = Udm_Cod

                    bFirst = False

                Else

                    'La dose di etichetta si trova nella riga precedente
                    PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, UBound(PrincipiAttiviFormulato, 2) - 1) = PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, UBound(PrincipiAttiviFormulato, 2) - 2)
                    PrincipiAttiviFormulato(COL_UDM_COD, UBound(PrincipiAttiviFormulato, 2) - 1) = PrincipiAttiviFormulato(COL_UDM_COD, UBound(PrincipiAttiviFormulato, 2) - 2)
                    PrincipiAttiviFormulato(COL_DOSE_ETICHETTA_DES, UBound(PrincipiAttiviFormulato, 2) - 1) = PrincipiAttiviFormulato(COL_DOSE_ETICHETTA_DES, UBound(PrincipiAttiviFormulato, 2) - 2)

                End If

                PrincipiAttiviFormulato(COL_FR_DES, UBound(PrincipiAttiviFormulato, 2) - 1) = DtPA.Rows(iPA).Item("Fr_Des")
                PrincipiAttiviFormulato(COL_AV_GRU, UBound(PrincipiAttiviFormulato, 2) - 1) = Av_Gru
                PrincipiAttiviFormulato(COL_AV_COD, UBound(PrincipiAttiviFormulato, 2) - 1) = Av_Cod
                PrincipiAttiviFormulato(COL_QTA, UBound(PrincipiAttiviFormulato, 2) - 1) = Format(Qta, "###,##0.00#")
                PrincipiAttiviFormulato(COL_PA_COD, UBound(PrincipiAttiviFormulato, 2) - 1) = DtPA.Rows(iPA).Item("Pa_Cod")
                PrincipiAttiviFormulato(COL_PA_DES, UBound(PrincipiAttiviFormulato, 2) - 1) = LCase(DtPA.Rows(iPA).Item("Pa_Des"))
                PrincipiAttiviFormulato(COL_TITOLO, UBound(PrincipiAttiviFormulato, 2) - 1) = DtPA.Rows(iPA).Item("Titolo")
                PrincipiAttiviFormulato(COL_PESO, UBound(PrincipiAttiviFormulato, 2) - 1) = DtPA.Rows(iPA).Item("Peso")

                If bCoadiuvante Then
                    'Coadiuvante
                    PrincipiAttiviFormulato(COL_PA_COADIUVANTE, UBound(PrincipiAttiviFormulato, 2) - 1) = 1
                Else
                    If Not IsDBNull(DtPA.Rows(iPA).Item("Pa_Co_Trattamento")) AndAlso IsNumeric(DtPA.Rows(iPA).Item("Pa_Co_Trattamento")) Then
                        PrincipiAttiviFormulato(COL_PA_COADIUVANTE, UBound(PrincipiAttiviFormulato, 2) - 1) = DtPA.Rows(iPA).Item("Pa_Co_Trattamento")
                    Else
                        PrincipiAttiviFormulato(COL_PA_COADIUVANTE, UBound(PrincipiAttiviFormulato, 2) - 1) = 0
                    End If
                End If

            Next iPA
        End If

        'Distrugo gli oggetti
        ObjPA = Nothing
        ObjDose = Nothing
        DtPA = Nothing

    End Sub

