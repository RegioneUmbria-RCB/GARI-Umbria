    Private Function LineaInterventoInesistente(ByRef Err_Code As Integer,
                                                ByRef Err_Des As String,
                                                ByRef dtLineeIntervento As DataTable,
                                                ByRef strLineeIntervento As String,
                                                ByVal Ge_Paa_Cod As Integer,
                                                ByVal LineaIntervento As Integer) As Boolean

        'Controllo Gruppo Esclusività
        Select Case Ge_Paa_Cod

            Case 0 'Nessun Gruppo Esclusività

                'Nessuna Linea Alternativa di Intervento (Errore Confermato)

                LineaInterventoInesistente = True

            Case Else


                'Elimino la Linea di Intervento dal Recordset delle Valide
                strLineeIntervento = strLineeIntervento & IIf(Trim(strLineeIntervento) = "", "", " AND ") & " LineaIntervento <> " & LineaIntervento
                'RSLineeIntervento.Filter = strLineeIntervento

                'Verifico che esista una linea intervento ancora valida
                'If RSLineeIntervento.EOF Then
                Dim Dr() As DataRow
                Dr = dtLineeIntervento.Select(strLineeIntervento)
                If Not Dr Is Nothing AndAlso Dr.Length > 0 Then


                    'Errore: Nessuna Linea Intervento Soddisfa i Requisiti
                    '                Err_Des = "Il numero di interventi effettuati con '" & ElencoPA(strPA, Terna, objCnManager, ConnessioneAlternativa) & "' nell'impianto lotto non rispetta nessuna linea di intervento consentita " & strPeriodo
                    '                Err_Code = 200
                    LineaInterventoInesistente = True

                    'Modifica Descrizione Errore
                    Err_Des = Err_Des & " (Nessuna linea di intervento consente la scelta effettuata)."

                Else

                    'Esiste ancora almeno una linea di intervento valida
                    LineaInterventoInesistente = False

                    'Reset errore
                    Err_Code = 0
                    Err_Des = ""

                End If

        End Select


    End Function

    Private Sub FormCheckTerna(ByRef Terna(,) As String,
                               ByVal Id_Paa As Integer,
                               ByVal Av_Gru As Integer,
                               ByVal Av_Cod As Integer,
                               ByVal Pa_Cod As Integer,
                               ByVal Ge_Paa_Cod As Integer,
                               ByVal LineaIntervento As Integer,
                               ByVal Pa_Cod_Misc As String)
        Dim i As Integer
        Dim bPresente As Boolean

        bPresente = False

        For i = 0 To UBound(Terna, 2) - 1

            If CInt(Terna(Terna_AvGru, i)) = Av_Gru And
               CInt(Terna(Terna_AvCod, i)) = Av_Cod And
               CInt(Terna(Terna_PaCod, i)) = Pa_Cod And
               CStr(Terna(Terna_PaCodMisc, i)) = Pa_Cod_Misc Then

                'Trovato Duplicato
                bPresente = True

                Exit For

            End If

        Next i

        If Not bPresente And (Av_Cod <> 0 Or Av_Gru <> 0) Then

            'Aggiungo i parametri
            ReDim Preserve Terna(Terna_PaCodMisc, UBound(Terna, 2) + 1)

            Terna(Terna_IdPaa, UBound(Terna, 2) - 1) = Id_Paa
            Terna(Terna_AvGru, UBound(Terna, 2) - 1) = Av_Gru
            Terna(Terna_AvCod, UBound(Terna, 2) - 1) = Av_Cod
            Terna(Terna_PaCod, UBound(Terna, 2) - 1) = Pa_Cod
            Terna(Terna_GePaaCod, UBound(Terna, 2) - 1) = Ge_Paa_Cod
            Terna(Terna_LineaIntervento, UBound(Terna, 2) - 1) = LineaIntervento
            Terna(Terna_PaCodMisc, UBound(Terna, 2) - 1) = Pa_Cod_Misc

        End If


    End Sub


    Private Sub FormCaricaPrincipiAttivi()

        Dim Av_Cod As Integer
        Dim Av_Gru As Integer
        Dim Pro_Cod As Integer
        Dim Pro_Des As String
        Dim Pa_Des As String
        Dim Pa_Cod As Integer
        Dim Pa_Co_Trattamento As Integer
        Dim Titolo As Decimal
        Dim Peso As Decimal
        Dim Qta As Decimal
        Dim Riga As Integer
        Dim i As Integer

        For Riga = 0 To UBound(PrincipiAttiviFormulato, 2) - 1

            Av_Cod = PrincipiAttiviFormulato(COL_AV_COD, Riga)
            Av_Gru = PrincipiAttiviFormulato(COL_AV_GRU, Riga)
            Pro_Cod = PrincipiAttiviFormulato(COL_FR_COD, Riga)
            Pro_Des = PrincipiAttiviFormulato(COL_FR_DES, Riga)
            Pa_Des = PrincipiAttiviFormulato(COL_PA_DES, Riga)
            Pa_Cod = PrincipiAttiviFormulato(COL_PA_COD, Riga)
            Titolo = PrincipiAttiviFormulato(COL_TITOLO, Riga)
            Peso = PrincipiAttiviFormulato(COL_PESO, Riga)

            Pa_Co_Trattamento = PrincipiAttiviFormulato(COL_PA_COADIUVANTE, Riga)

            i = TrovaRiga_PrincipiAttivi(Pro_Cod, Pa_Cod)

            PrincipiAttivi(COL_FR_COD, i) = Pro_Cod
            PrincipiAttivi(COL_PA_COD, i) = Pa_Cod
            PrincipiAttivi(COL_PA_DES, i) = Pa_Des
            PrincipiAttivi(COL_TITOLO, i) = Titolo
            PrincipiAttivi(COL_PESO, i) = Peso
            PrincipiAttivi(COL_PA_COADIUVANTE, i) = Pa_Co_Trattamento
            PrincipiAttivi(COL_QTA, i) = 0
            PrincipiAttivi(COL_AV_COD, i) = Av_Cod
            PrincipiAttivi(COL_AV_GRU, i) = Av_Gru

            'Impostazione Fr_Cod
            PrincipiAttivi(COL_FR_COD, i) = Pro_Cod
            PrincipiAttivi(COL_FR_DES, i) = Pro_Des

            Select Case Pa_Co_Trattamento

                Case 1 'Coadiuvante

                    PrincipiAttivi(COL_PA_COADIUVANTE_DES, i) = "Sì"
                    'Calcolo della dose di principio attivo distribuito

                    If Not IsNumeric(PrincipiAttivi(COL_QTA, i)) Then
                        PrincipiAttivi(COL_QTA, i) = 0
                    End If

                    If Not IsNumeric(PrincipiAttivi(COL_DOSE_CONSENTITA, i)) Then
                        PrincipiAttivi(COL_DOSE_CONSENTITA, i) = 100000 'Dummy
                        PrincipiAttivi(COL_DOSE_CONSENTITA_DES, i) = "Indefinito"
                    End If

                    If Peso = 0 Then
                        PrincipiAttivi(COL_QTA, i) = Format(PrincipiAttivi(COL_QTA, i) + ((CDbl(PrincipiAttiviFormulato(COL_QTA, Riga)) / 100) * Titolo), "###,##0.00#")
                    Else
                        PrincipiAttivi(COL_QTA, i) = Format(PrincipiAttivi(COL_QTA, i) + ((CDbl(PrincipiAttiviFormulato(COL_QTA, Riga)) / 1000) * Peso), "###,##0.00#")
                    End If


                    If IsNumeric(PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, Riga)) Then
                        If Peso = 0 Then
                            Qta = Format(((CDbl(PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, Riga)) / 100) * Titolo), "###,##0.00#")
                        Else
                            Qta = Format(((CDbl(PrincipiAttiviFormulato(COL_DOSE_ETICHETTA, Riga)) / 1000) * Peso), "###,##0.00#")
                        End If


                        If PrincipiAttivi(COL_DOSE_CONSENTITA, i) > Qta Then
                            'Nuovo Minimo
                            PrincipiAttivi(COL_DOSE_CONSENTITA, i) = Format(Qta, "###,##0.00#")
                            PrincipiAttivi(COL_DOSE_CONSENTITA_DES, i) = PrincipiAttivi(COL_DOSE_CONSENTITA, i)
                        End If

                    Else

                        PrincipiAttivi(COL_DOSE_CONSENTITA, i) = 100000 'Dummy
                        PrincipiAttivi(COL_DOSE_CONSENTITA_DES, i) = "Indefinito"
                    End If


                Case Else 'Non Coadiuvante
                    PrincipiAttivi(COL_PA_COADIUVANTE_DES, i) = "No"

                    'Ancora da determinare
                    PrincipiAttivi(COL_DOSE_CONSENTITA, i) = 100000 'Dummy
                    PrincipiAttivi(COL_DOSE_CONSENTITA_DES, i) = "Indefinito"

            End Select

        Next

    End Sub


    'Trova la riga corrispondente al Pa_Cod all'interno della griglia dei totali
    Private Function TrovaRiga_PrincipiAttivi(ByVal Fr_Cod As Integer,
                                            ByVal Pa_Cod As Integer
                                            ) As Integer

        Dim Riga As Integer
        Dim Trovato As Boolean

        Trovato = False 'Inizializzazione

        For Riga = 0 To UBound(PrincipiAttivi, 2) - 1

            If Fr_Cod = CInt(PrincipiAttivi(COL_FR_COD, Riga)) And
               Pa_Cod = CInt(PrincipiAttivi(COL_PA_COD, Riga)) Then
                Trovato = True
                TrovaRiga_PrincipiAttivi = Riga
                Exit For

            ElseIf Pa_Cod = CInt(PrincipiAttivi(COL_PA_COD, Riga)) Then

                PrincipiAttivi(COL_MERGE, Riga) = 1

            End If

        Next Riga


        If Not Trovato Then

            ReDim Preserve PrincipiAttivi(UBound(PrincipiAttivi, 1), UBound(PrincipiAttivi, 2) + 1)

            TrovaRiga_PrincipiAttivi = UBound(PrincipiAttivi, 2) - 1

            PrincipiAttivi(COL_MERGE, TrovaRiga_PrincipiAttivi) = 0

        End If

    End Function

