<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:impl="http://dispatcher.domest.it.sogei" xmlns:intf="http://dispatcher.domest.it.sogei" xmlns:tns2="http://dto.domest.it.sogei" xmlns:wsdlsoap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsi="http://ws-i.org/profiles/basic/1.1/xsd" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://dispatcher.domest.it.sogei">
 <wsdl:types>
  <schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://dto.domest.it.sogei" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
   <complexType name="MessageDTO">
    <sequence>
     <element name="inputObj" nillable="true" type="xsd:anyType"/>
     <element name="outputObj" nillable="true" type="xsd:anyType"/>
     <element name="serviceID" nillable="true" type="xsd:string"/>
     <element name="xmlList" nillable="true" type="tns2:ArrayOfXmlDTO"/>
    </sequence>
   </complexType>
   <complexType name="XmlDTO">
    <sequence>
     <element name="xml" type="xsd:base64Binary"/>
    </sequence>
   </complexType>
   <complexType name="ArrayOfXmlDTO">
    <sequence>
     <element maxOccurs="unbounded" minOccurs="0" name="XmlDTO" nillable="true" type="tns2:XmlDTO"/>
    </sequence>
   </complexType>
  </schema>
  <schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://dispatcher.domest.it.sogei" xmlns:tns2="http://dto.domest.it.sogei" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
   <import namespace="http://dto.domest.it.sogei"/>
   <element name="dispatcherResponse">
    <complexType>
     <sequence>
      <element name="dispatcherReturn" nillable="true" type="tns2:MessageDTO"/>
     </sequence>
    </complexType>
   </element>
   <element name="dispatcher">
    <complexType>
     <sequence>
      <element name="messaggio" nillable="true" type="tns2:MessageDTO"/>
     </sequence>
    </complexType>
   </element>
  </schema>
 </wsdl:types>

   <wsdl:message name="dispatcherResponse">
     <wsdl:part element="intf:dispatcherResponse" name="parameters"/>

  </wsdl:message>

   <wsdl:message name="dispatcherRequest">
     <wsdl:part element="intf:dispatcher" name="parameters"/>

  </wsdl:message>

   <wsdl:portType name="DispatcherBean">
     <wsdl:operation name="dispatcher">
       <wsdl:input message="intf:dispatcherRequest" name="dispatcherRequest"/>

       <wsdl:output message="intf:dispatcherResponse" name="dispatcherResponse"/>

    </wsdl:operation>

  </wsdl:portType>

   <wsdl:binding name="DispatcherBeanSoapBinding" type="intf:DispatcherBean">
 <wsaw:UsingAddressing xmlns:wsaw="http://www.w3.org/2006/05/addressing/wsdl" wsdl:required="false"/>

     <wsdlsoap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

     <wsdl:operation name="dispatcher">
       <wsdlsoap:operation soapAction="dispatcher"/>

       <wsdl:input name="dispatcherRequest">
         <wsdlsoap:body use="literal"/>

      </wsdl:input>

       <wsdl:output name="dispatcherResponse">
         <wsdlsoap:body use="literal"/>

      </wsdl:output>

    </wsdl:operation>

  </wsdl:binding>

   <wsdl:service name="DispatcherBeanService">
     <wsdl:port binding="intf:DispatcherBeanSoapBinding" name="DispatcherBean">
       <wsdlsoap:address location="https://wstest.agenziadogane.it/DomestRouter/services/DispatcherBean"/>
    </wsdl:port>

  </wsdl:service>

</wsdl:definitions>
