					<xs:sequence>
						<xs:element ref="ie:ConsigneeTrader"/>
						<xs:element ref="ie:ExciseMovementEad"/>
						<xs:element ref="ie:DestinationOffice"/>
						<xs:element ref="ie:AlertOrRejection"/>
