			<xs:element name="GuarantorTypeCode" type="tcl:GuarantorTypeCode"/>
			<xs:element name="ConsignorGuaranteeAccountCode" type="emcs:GuaranteeAccountCodeType"/>
			<xs:element name="ConsignorTypeGuarantee" type="emcs:TypeGuaranteeType"/>
			<xs:element name="ConsignorImportGuarantee" type="emcs:ImportGuaranteeType"/>
			<xs:element name="ConsigneeGuaranteeAccountCode" type="emcs:GuaranteeAccountCodeType"/>
			<xs:element name="ConsigneeTypeGuarantee" type="emcs:TypeGuaranteeType"/>
			<xs:element name="ConsigneeImportGuarantee" type="emcs:ImportGuaranteeType"/>
			<xs:element name="TransportGuaranteeAccountCode" type="emcs:GuaranteeAccountCodeType"/>
			<xs:element name="TransportTypeGuarantee" type="emcs:TypeGuaranteeType"/>
			<xs:element name="TransportImportGuarantee" type="emcs:ImportGuaranteeType"/>
			<xs:element name="OwnerGuaranteeAccountCode" type="emcs:GuaranteeAccountCodeType"/>
			<xs:element name="OwnerTypeGuarantee" type="emcs:TypeGuaranteeType"/>
			<xs:element name="OwnerImportGuarantee" type="emcs:ImportGuaranteeType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="GuarantorTraderType">
		<xs:sequence>
			<xs:element name="IterationTotal" type="tcl:IterationTotalType"/>
			<xs:element name="GuarantorBodyTrader" minOccurs="0" maxOccurs="2">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="IterationCode" type="tcl:IterationCodeType"/>
						<xs:element name="IterationNumber" type="tcl:IterationTotalType"/>
						<xs:element name="TraderExciseNumber" type="emcs:ExciseNumberType" minOccurs="0"/>
						<xs:element name="TraderName" type="emcs:TraderNameType"/>
						<xs:element name="StreetName" type="emcs:StreetNameType"/>
						<xs:element name="StreetNumber" type="emcs:StreetNumberType"/>
						<xs:element name="City" type="emcs:CityType"/>
						<xs:element name="Postcode" type="emcs:PostCodeType"/>
						<xs:element name="VatNumber" type="emcs:VatNumberType"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="language" type="emcs:LanguageCodeType" use="optional"/>
	</xs:complexType>
</xs:schema>
