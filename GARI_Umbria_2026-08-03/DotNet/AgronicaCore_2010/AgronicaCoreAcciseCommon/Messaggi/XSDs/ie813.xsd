	<xs:complexType name="LSDComplementaryInformationType">
		<xs:simpleContent>
			<xs:extension base="emcs:ComplementaryInformationType">
				<xs:attribute name="language" type="emcs:LanguageCodeType" use="optional"/>
			</xs:extension>
		</xs:simpleContent>
