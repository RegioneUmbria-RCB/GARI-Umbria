	<xs:complexType name="LSDSealInformationType">
		<xs:simpleContent>
			<xs:extension base="emcs:SealInformationType">
				<xs:attribute name="language" type="emcs:LanguageCodeType" use="optional"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
