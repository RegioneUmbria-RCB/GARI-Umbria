	</xs:complexType>
	<xs:complexType name="DeliveryPlaceTraderType">
		<xs:sequence>
			<xs:element name="Traderid" type="emcs:TraderidType" minOccurs="0"/>
			<xs:element name="TraderName" type="emcs:TraderNameType" minOccurs="0"/>
