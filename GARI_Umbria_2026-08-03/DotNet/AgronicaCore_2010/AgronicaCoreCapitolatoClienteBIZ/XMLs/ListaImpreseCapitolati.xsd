<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://ws_CapitolatoCliente_ListaImpreseCapitolati">
  <xs:element name="imprese">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" name="impresa">
          <xs:complexType>
            <xs:sequence>
              <xs:element maxOccurs="unbounded" name="capitolato">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:boolean">
                      <xs:attribute name="id" type="xs:unsignedByte" use="required" />
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="piva" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>