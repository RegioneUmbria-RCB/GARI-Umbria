    Public Function LeggiBaseCulture(ByVal Piva As String, ByVal sa_cod As String, ByVal APPEZZA As String, ByVal Data_InizioImpianto As String, ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri) As DataTable


        Dim Rs As DataTable
        Dim stbQueryColture As New System.Text.StringBuilder

        stbQueryColture.Remove(0, stbQueryColture.Length)
        stbQueryColture.Append(" SELECT SpecieVegetali.Veg_Des, Reg_Impianti.Validita_Inizio, Reg_Impianti.Validita_Fine, Reg_Impianti.CUL_COD, SpecieVegetali.Veg_Cod ")
        stbQueryColture.Append(" FROM Reg_Impianti LEFT OUTER JOIN ")
        stbQueryColture.Append(" Cultivar ON Cultivar.Cul_Cod = Reg_Impianti.CUL_COD LEFT OUTER JOIN ")
        stbQueryColture.Append(" SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod ")
        stbQueryColture.Append(" WHERE Reg_Impianti.PIVA = '" & Agro_SQL_SaveText(Piva) & "' ")
        stbQueryColture.Append(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(sa_cod) & " ")
        stbQueryColture.Append(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(APPEZZA) & " ")
        stbQueryColture.Append(" AND Reg_Impianti.Validita_Fine <= " & Agro_SQL_SaveDate(Data_InizioImpianto) & " ")
        stbQueryColture.Append(" ORDER BY Reg_Impianti.Validita_Inizio DESC ")


        Rs = EseguiQuery_Lettura(objParametri, stbQueryColture.ToString, "SchedaCampagna.CaricaDsErbacee")


        Return Rs

    End Function
