    Public Function Leggi_Data_Fioritura(ByVal Piva As String,
                                            ByVal Sa_Cod As Integer,
                                            ByVal Appezza As Integer,
                                            ByVal ID_Reg As Integer,
                                            ByVal FF_Classe As String,
                                            ByVal xFiltroAggiuntivo As String,
                                            ByVal xOrderBy As String,
                                            ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                            ) As String

        Const nomeRoutine = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_Data_Fioritura_Impianto()"

        '====================================================================================
        'Parametri opzionali :
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim Stb As New StringBuilder
        Dim dt As DataTable
        Dim dataFioritura As String = ""

        Try

            Stb.AppendLine(" SELECT TOP 1 CONVERT(varchar,Mov_Destinazioni.validita_inizio, 103) AS validita_inizio ")
            Stb.AppendLine(" FROM         Mov_Dettaglio_Tecnico INNER JOIN  ")
            Stb.AppendLine(" Movimenti_dettagli ON Mov_Dettaglio_Tecnico.Piva = Movimenti_dettagli.PIVA AND   ")
            Stb.AppendLine(" Mov_Dettaglio_Tecnico.Sa_Cod = Movimenti_dettagli.Sa_Cod AND   ")
            Stb.AppendLine(" Mov_Dettaglio_Tecnico.Id_Agenda = Movimenti_dettagli.Id_Agenda AND   ")
            Stb.AppendLine(" Mov_Dettaglio_Tecnico.Id_Mov = Movimenti_dettagli.Id_Mov AND   ")
            Stb.AppendLine(" Mov_Dettaglio_Tecnico.Id_Mov_Det = Movimenti_dettagli.Id_Mov_Det INNER JOIN   ")
            Stb.AppendLine(" Movimenti INNER JOIN   ")
            Stb.AppendLine(" Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND   ")
            Stb.AppendLine(" Movimenti.Id_Agenda = Agenda.Id_Agenda ON Movimenti_dettagli.PIVA = Movimenti.PIVA AND   ")
            Stb.AppendLine(" Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda AND   ")
            Stb.AppendLine(" Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov INNER JOIN   ")
            Stb.AppendLine(" Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND   ")
            Stb.AppendLine(" Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND   ")
            Stb.AppendLine(" Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND   ")
            Stb.AppendLine(" Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det  ")
            Stb.AppendLine(" WHERE Agenda.Lav_Cod = 79 AND Movimenti.Cau_Mov = '2100' ")

            If Piva <> "" Then
                Stb.AppendLine(" AND Mov_Destinazioni.Piva = " & Agro_SQL_SaveText_NULL(Piva) & " ")
            End If
            If Sa_Cod <> 0 Then
                Stb.AppendLine(" AND Mov_Destinazioni.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            End If
            If Appezza <> 0 Then
                Stb.AppendLine(" AND Mov_Destinazioni.Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
            End If
            If ID_Reg <> 0 Then
                Stb.AppendLine(" AND Mov_Destinazioni.Id_Destinazione = " & Agro_SQL_SaveNum(ID_Reg) & " ")
            End If
            If Not String.IsNullOrEmpty(FF_Classe) Then
                Stb.AppendLine(" AND  Mov_Dettaglio_Tecnico.FF_Classe IN (" & Agro_SQL_Save_Clausola_IN(FF_Classe) & ")  ")
            End If
            Stb.AppendLine(" AND  Movimenti_dettagli.contabilizzato >= 0 ")

            If xFiltroAggiuntivo <> "" Then
                Stb.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If

            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                Stb.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            Else
                Stb.AppendLine(" ORDER BY Mov_Destinazioni.validita_inizio DESC ")
            End If

            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, Stb.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

            If dt.Rows.Count > 0 Then
                dataFioritura = dt.Rows(0).Item("validita_inizio")
            End If

        Catch ex As Exception

            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)

        End Try

        Return dataFioritura

    End Function

    '##############################################################################################
    Public Function Leggi_ParticelleImpianti_xAgenda(ByVal Flag_ConDPI As Boolean,
                                                     ByVal Piva As String,
                                                     ByVal Sa_Cod As Integer,
                                                     ByVal Veg_Cod As Integer,
                                                     ByVal Cul_Cod As Integer,
                                                     ByVal Data As Date,
                                                     ByVal Grfi_Cod As Integer,
                                                     ByVal Flag_Protetto As Integer,
                                                     ByVal Id_Cod As Integer,
                                                     ByVal xFiltroAggiuntivo As String,
                                                     ByVal xOrderBy As String,
                                                     ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                                     ByVal leggiAncheBloccati As Boolean
                                                     ) As DataTable 'leggiAncheBloccati mettere di default False per non leggere i bloccati palmare/import

        Const nomeRoutine = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_ParticelleImpianti_xAgenda()"

        '====================================================================================
        'Parametri opzionali :
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable
        Dim i As Integer

        Try

            If Piva = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva obbligatorio)")
            End If

            'If Sa_Cod = 0 Then
            '    Throw New Exception("Parametro non corretto nella query (Sa_Cod obbligatorio)")
            'End If

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT  Reg_Impianti.PIVA, Reg_Impianti.SA_COD, Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG,  ")
            StrSQL.AppendLine("     CONVERT(VARCHAR, Reg_Impianti.Validita_Inizio, 103) AS Validita_Inizio, CONVERT(VARCHAR, Reg_Impianti.Validita_Fine, 103) AS Validita_Fine, Reg_Impianti.Sup_Imp, ")
            StrSQL.AppendLine("     ISNULL(Cultivar.Veg_Cod, 0) AS Veg_Cod,  ")
            StrSQL.AppendLine("     Reg_Impianti.CUL_COD,  ISNULL(Cultivar.Cul_Des, '') AS Cul_Des,  ")
            StrSQL.AppendLine("     Appezzamento.Campo_Cod,  ")
            StrSQL.AppendLine("     Appezzamento.SUP_APP, Appezzamento.APP_NOME,  ")
            StrSQL.AppendLine("     Reg_Impianti.GRFI_COD,   ")
            StrSQL.AppendLine("     Imprese_Progetti.Progetto_Cod, Imprese_Progetti.Progetto_Nome AS Progetto,  ")
            StrSQL.AppendLine("     Imprese_Progetti.Regolamento_Cod AS Regolamento,  ")
            StrSQL.AppendLine("     Imprese_Progetti.Disciplinare_Cod AS Finanziamento, Imprese_Progetti.Disciplinare_PubblicoPrivato,  ")
            StrSQL.AppendLine("     CONVERT(VARCHAR, Imprese_Progetti.Validita_Inizio, 103) AS Validita_Inizio_Distinta, CONVERT(VARCHAR, Imprese_Progetti.Validita_Fine, 103) AS Validita_Fine_Distinta, ")
            '--------------------------modifica 10/07/2012--------------------------
            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe.descrizione  ")
            StrSQL.AppendLine("      , '') as Codici_Anagrafe_Des , ")
            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe.codice  ")
            StrSQL.AppendLine("      , '') as Codice_Anagrafe , ")
            '---------------------------------------------------------------------------

            StrSQL.AppendLine(" ISNULL(AppezzamentiXParticelle.PROV, '') AS Prov, ISNULL(AppezzamentiXParticelle.COM, '') AS COM, ")
            StrSQL.AppendLine(" ISNULL(AppezzamentiXParticelle.Sezione, '') AS Sezione, ISNULL(AppezzamentiXParticelle.foglio, 0) AS foglio, ")
            StrSQL.AppendLine(" ISNULL(AppezzamentiXParticelle.numero, 0) AS numero, ISNULL(AppezzamentiXParticelle.subalterno, '') AS subalterno, ")
            StrSQL.AppendLine(" ISNULL(AppezzamentiXParticelle.AREA, 0) AS area ")

            If Flag_ConDPI = False Then
                'VERSIONE SENZA DPI
                StrSQL.AppendLine(" , ISNULL(SpecieVegetali.Veg_Des, '') AS Veg_Des ")
            End If

            StrSQL.AppendLine("  ")

            StrSQL.AppendLine("  FROM   Reg_Impianti  ")
            StrSQL.AppendLine("     INNER JOIN Appezzamento ON Reg_Impianti.PIVA = Appezzamento.PIVA AND Reg_Impianti.SA_COD = Appezzamento.SA_COD AND Reg_Impianti.APPEZZA = Appezzamento.APPEZZA  ")
            StrSQL.AppendLine("     INNER JOIN Imprese_Progetti ON Reg_Impianti.PIVA = Imprese_Progetti.Piva AND Reg_Impianti.SA_COD = Imprese_Progetti.Sa_Cod AND Reg_Impianti.APPEZZA = Imprese_Progetti.Appezza AND Reg_Impianti.ID_REG = Imprese_Progetti.Id_Reg  ")

            StrSQL.AppendLine("     INNER JOIN AppezzamentiXParticelle ON Appezzamento.PIVA = AppezzamentiXParticelle.PIVA AND Appezzamento.SA_COD = AppezzamentiXParticelle.SA_COD AND Appezzamento.APPEZZA = AppezzamentiXParticelle.APPEZZA ")

            StrSQL.AppendLine("     LEFT OUTER JOIN Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod  ")
            If Flag_ConDPI = False Then
                'VERSIONE SENZA DPI
                StrSQL.AppendLine("     LEFT OUTER JOIN SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.VEG_COD 	  ")
            End If

            '--------------------------modifica 10/07/2012--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  Reg_Impianti_Codici on Reg_Impianti.PIVA=Reg_Impianti_Codici.PIVA and Reg_Impianti.SA_COD=Reg_Impianti_Codici.SA_COD and Reg_Impianti.APPEZZA=Reg_Impianti_Codici.APPEZZA and Reg_Impianti.id_reg=Reg_Impianti_Codici.id_reg and Reg_Impianti_Codici.id_cod >2999 and Reg_Impianti_Codici.id_cod < 4000 ")
            StrSQL.AppendLine("     LEFT OUTER JOIN  Codici_Anagrafe  ")
            StrSQL.AppendLine("              on Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            '------------------------------------------------------------------------

            StrSQL.AppendLine("  ")

            StrSQL.AppendLine("  WHERE  Reg_Impianti.Piva       = '" & Agro_SQL_SaveText(Piva) & "' ")

            '--------------------------modifica 10/07/2012--------------------------
            If Id_Cod <> 0 Then
                StrSQL.AppendLine("     AND Codici_Anagrafe.codice =  " & Agro_SQL_SaveNum(Id_Cod) & "  ")
            End If
            '------------------------------------------------------------------------


            If Sa_Cod <> 0 Then
                StrSQL.AppendLine("         AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            Else
                'leggo se ci sono filtri sui centri
                Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                Dim FiltroCentri As String = ""
                Dim DtCentriVisibili As DataTable
                DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                    For i = 0 To DtCentriVisibili.Rows.Count - 1
                        FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                    Next
                    If FiltroCentri <> "" Then
                        StrSQL.AppendLine(" AND Reg_Impianti.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                    End If
                End If
            End If
            StrSQL.AppendLine("         AND Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine("         AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine("         AND Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine("         AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")
            If leggiAncheBloccati = False Then
                StrSQL.AppendLine("         AND Appezzamento.Blk_Flag <> - 1  ")
            End If


            If Flag_ConDPI = True Then
                'VERSIONE CON DPI
                If Grfi_Cod <> 0 Then
                    StrSQL.AppendLine("     AND Reg_Impianti.grfi_Cod = " & Agro_SQL_SaveNum(Grfi_Cod) & " ")
                End If
                Select Case Flag_Protetto
                    Case 1
                        StrSQL.AppendLine(" AND Reg_Impianti.Cop_Cod <> 0 AND Reg_Impianti.Cop_Cod <> 3 AND Reg_Impianti.Cop_Cod <> 4 AND Reg_Impianti.Cop_Cod <> 5 AND Reg_Impianti.Cop_Cod <> 6 ")
                    Case 0
                        StrSQL.AppendLine(" AND ( Reg_Impianti.Cop_Cod = 0 OR Reg_Impianti.Cop_Cod = 3 OR Reg_Impianti.Cop_Cod = 4 OR Reg_Impianti.Cop_Cod = 5 OR Reg_Impianti.Cop_Cod = 6 ) ")
                End Select
            End If

            If Veg_Cod <> 0 Then
                StrSQL.AppendLine("     AND Cultivar.Veg_Cod    = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
                If Cul_Cod <> 0 Then
                    StrSQL.AppendLine("     AND Cultivar.Cul_Cod    = " & Agro_SQL_SaveNum(Cul_Cod) & " ")
                End If
            Else
                'TERRENO NUDO
                StrSQL.AppendLine("     AND Reg_Impianti.CUL_COD = 0  ")
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            Else
                StrSQL.AppendLine(" ORDER BY App_Nome, Progetto ")
            End If


            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    '##############################################################################################
    'A differenza della precedente CUL_COD è tipo STRINGA
    Public Function Leggi_ParticelleImpianti_xAgenda2(ByVal Flag_ConDPI As Boolean,
