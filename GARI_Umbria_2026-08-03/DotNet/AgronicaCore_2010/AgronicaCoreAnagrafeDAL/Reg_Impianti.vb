            StrSQL.AppendLine("  FROM   Reg_Impianti  ")
            StrSQL.AppendLine("     INNER JOIN Imprese ON Reg_Impianti.PIVA = Imprese.PIVA  ")
            StrSQL.AppendLine("     INNER JOIN Centri_Aziendali ON Reg_Impianti.PIVA = Centri_Aziendali.PIVA AND Reg_Impianti.SA_COD = Centri_Aziendali.sa_cod  ")
            StrSQL.AppendLine("     INNER JOIN Appezzamento ON Reg_Impianti.PIVA = Appezzamento.PIVA AND Reg_Impianti.SA_COD = Appezzamento.SA_COD AND ")
            StrSQL.AppendLine("     Reg_Impianti.APPEZZA = Appezzamento.APPEZZA  ")
            StrSQL.AppendLine("     INNER JOIN Imprese_Progetti ON Reg_Impianti.PIVA = Imprese_Progetti.Piva AND Reg_Impianti.SA_COD = Imprese_Progetti.Sa_Cod AND  ")
            StrSQL.AppendLine("     Reg_Impianti.APPEZZA = Imprese_Progetti.Appezza AND Reg_Impianti.ID_REG = Imprese_Progetti.Id_Reg  ")

            StrSQL.AppendLine("     OUTER APPLY (SELECT TOP 1 Reg_ImpiantiXParcoMacchine.Mac_Cod, Parco_Macchine.Mac_Des, Parco_Macchine.Portata, Parco_Macchine.Efficienza, Parco_Macchine.IMP_COD as ImpCodMacchina")
            StrSQL.AppendLine("     FROM Reg_ImpiantiXParcoMacchine JOIN Parco_Macchine ON Parco_Macchine.Mac_Cod = Reg_ImpiantiXParcoMacchine.Mac_Cod ")
            StrSQL.AppendLine("     WHERE Reg_ImpiantiXParcoMacchine.Piva = Reg_Impianti.PIVA AND Reg_ImpiantiXParcoMacchine.Sa_Cod = Reg_Impianti.SA_COD ")
            StrSQL.AppendLine("     AND Reg_ImpiantiXParcoMacchine.Appezza = Reg_Impianti.APPEZZA AND Reg_ImpiantiXParcoMacchine.ID_Reg = Reg_Impianti.ID_REG) AS ripm")

            StrSQL.AppendLine("     LEFT OUTER JOIN Regolamenti ON Imprese_Progetti.Regolamento_Cod = Regolamenti.Reg_Cod  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN FasiFenologichexFioriture ON Cultivar.Veg_Cod = FasiFenologichexFioriture.VEG_COD ")
            StrSQL.AppendLine("     LEFT OUTER JOIN GruppoFinalita ON Reg_Impianti.GRFI_COD = GruppoFinalita.Grfi_Cod  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN Copertura ON Reg_Impianti.COP_COD = Copertura.Cop_Cod ")
            'If Flag_ConDPI = False Then
            'VERSIONE SENZA DPI
            StrSQL.AppendLine("     LEFT OUTER JOIN SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.VEG_COD 	  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN ImpiantiIrrigazioni ON Reg_Impianti.IMP_COD = ImpiantiIrrigazioni.Imp_Cod  ")

            StrSQL.AppendLine("     LEFT OUTER JOIN GruppoVarietale ON Reg_Impianti.GRVA_Cod_VEG = GruppoVarietale.Grva_Cod ")
            'End If

            StrSQL.AppendLine("     LEFT OUTER JOIN FormeAllevamento ON Reg_Impianti.Foral_Cod = FormeAllevamento.Foral_Cod ")
            StrSQL.AppendLine("     LEFT OUTER JOIN Portinnesti ON Reg_Impianti.Port_Cod = Portinnesti.Port_Cod ")


            '--------------------------modifica 10/07/2012--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  Reg_Impianti_Codici on Reg_Impianti.PIVA=Reg_Impianti_Codici.PIVA and Reg_Impianti.SA_COD=Reg_Impianti_Codici.SA_COD and Reg_Impianti.APPEZZA=Reg_Impianti_Codici.APPEZZA and Reg_Impianti.id_reg=Reg_Impianti_Codici.id_reg and Reg_Impianti_Codici.id_cod >2999 and Reg_Impianti_Codici.id_cod < 4000 ")
            StrSQL.AppendLine("     LEFT OUTER JOIN  Codici_Anagrafe  ")
            StrSQL.AppendLine("              on Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            '------------------------------------------------------------------------

            '-------------------CODICE APPEZZA BIOLOGICO 30/04/2013--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  Appezzamento_Codici Appezzamento_Codici_CodBioApp ")
            StrSQL.AppendLine("              on Appezzamento_Codici_CodBioApp.piva = Reg_Impianti.piva and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_CodBioApp.sa_cod = Reg_Impianti.sa_cod and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_CodBioApp.appezza = Reg_Impianti.appezza and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_CodBioApp.id_cod =   " & Agro_SQL_SaveNum(enum_CodiciAnagrafe.Codice_Appezza_Biologico) & "  ")
            '---------------------------------------------------------------------------



            '--------------CAPITOLATI Capitolato_Privato------------modifica 08/04/2013--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  Reg_Impianti_Codici Reg_Impianti_Codici_Capitolato_Privato on Reg_Impianti.PIVA=Reg_Impianti_Codici_Capitolato_Privato.PIVA and Reg_Impianti.SA_COD=Reg_Impianti_Codici_Capitolato_Privato.SA_COD and Reg_Impianti.APPEZZA=Reg_Impianti_Codici_Capitolato_Privato.APPEZZA and Reg_Impianti.id_reg=Reg_Impianti_Codici_Capitolato_Privato.id_reg and  Imprese_Progetti.progetto_cod=Reg_Impianti_Codici_Capitolato_Privato.progetto_cod ")
            StrSQL.AppendLine("     AND Reg_Impianti_Codici_Capitolato_Privato.id_cod =  " & Agro_SQL_SaveNum(enum_CodiciAnagrafe.Capitolato_Privato) & "  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN  Codici_Anagrafe Codici_Anagrafe_Capitolato_Privato ")
            StrSQL.AppendLine("              on Reg_Impianti_Codici_Capitolato_Privato.id_cod = Codici_Anagrafe_Capitolato_Privato.codice ")
            StrSQL.AppendLine("     LEFT OUTER JOIN  CAC_Codifica_InfoAggiuntive  ")
            StrSQL.AppendLine("              on CAC_Codifica_InfoAggiuntive.InfoAgg_Cod = Reg_Impianti_Codici_Capitolato_Privato.val_cod ")
            StrSQL.AppendLine("            and  CAC_Codifica_InfoAggiuntive.Piva_SuperUser = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "'  ")
            StrSQL.AppendLine("            and  CAC_Codifica_InfoAggiuntive.Argomento_Cod = 1 ")
            '------------------------------------------------------------------------

            '--------------------------modifica 26/07/2012--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  DPI_Regolamenti on Imprese_Progetti.Disciplinare_Cod=DPI_Regolamenti.COD_REGOLAMENTO AND Imprese_Progetti.Disciplinare_PubblicoPrivato=DPI_Regolamenti.Flag_Privato_Pubblico ")
            '------------------------------------------------------------------------

            '-------------------CODICE RIF NUMERICO APPEZz. 30/04/2013--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  Appezzamento_Codici Appezzamento_Codici_RifNumerico ")
            StrSQL.AppendLine("              on Appezzamento_Codici_RifNumerico.piva = Reg_Impianti.piva and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_RifNumerico.sa_cod = Reg_Impianti.sa_cod and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_RifNumerico.appezza = Reg_Impianti.appezza and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_RifNumerico.id_cod =   " & Agro_SQL_SaveNum(enum_CodiciAnagrafe.Riferimento_Alfanumerico_Appezzamento) & "  ")
            '---------------------------------------------------------------------------

            If visualizza_Kpin_BlockName Then
                'DRUDI 2020-05-05 KPIN E BLOCK NAME
                StrSQL.AppendLine(" LEFT OUTER JOIN Reg_Impianti_Codici Reg_Impianti_Codici_KPIN  ")
                StrSQL.AppendLine("         ON Reg_Impianti.PIVA=Reg_Impianti_Codici_KPIN.PIVA ")
                StrSQL.AppendLine("         AND Reg_Impianti.SA_COD=Reg_Impianti_Codici_KPIN.SA_COD ")
                StrSQL.AppendLine("         AND Reg_Impianti.APPEZZA=Reg_Impianti_Codici_KPIN.APPEZZA ")
                StrSQL.AppendLine("         AND Reg_Impianti.id_reg=Reg_Impianti_Codici_KPIN.id_reg ")
                StrSQL.AppendLine("         AND  Imprese_Progetti.progetto_cod=Reg_Impianti_Codici_KPIN.progetto_cod ")
                StrSQL.AppendLine("         AND Reg_Impianti_Codici_KPIN.id_cod =  1287 ")

                StrSQL.AppendLine(" LEFT OUTER JOIN Reg_Impianti_Codici Reg_Impianti_Codici_BlockName  ")
                StrSQL.AppendLine("         ON Reg_Impianti.PIVA=Reg_Impianti_Codici_BlockName.PIVA ")
                StrSQL.AppendLine("         AND Reg_Impianti.SA_COD=Reg_Impianti_Codici_BlockName.SA_COD ")
                StrSQL.AppendLine("         AND Reg_Impianti.APPEZZA=Reg_Impianti_Codici_BlockName.APPEZZA ")
                StrSQL.AppendLine("         AND Reg_Impianti.id_reg=Reg_Impianti_Codici_BlockName.id_reg ")
                StrSQL.AppendLine("         AND  Imprese_Progetti.progetto_cod=Reg_Impianti_Codici_BlockName.progetto_cod ")
                StrSQL.AppendLine("         AND Reg_Impianti_Codici_BlockName.id_cod =  1288 ")
            End If

            If visualizza_codici_imp_app_prj Then
                StrSQL.AppendLine(" LEFT OUTER JOIN Reg_Impianti_Codici Reg_Impianti_Codice  ")
                StrSQL.AppendLine("         ON Reg_Impianti.PIVA=Reg_Impianti_Codice.PIVA ")
                StrSQL.AppendLine("         AND Reg_Impianti.SA_COD=Reg_Impianti_Codice.SA_COD ")
                StrSQL.AppendLine("         AND Reg_Impianti.APPEZZA=Reg_Impianti_Codice.APPEZZA ")
                StrSQL.AppendLine("         AND Reg_Impianti.id_reg=Reg_Impianti_Codice.id_reg ")
                StrSQL.AppendLine("         AND  Reg_Impianti_Codice.progetto_Cod = 0 ")
                StrSQL.AppendLine("         AND Reg_Impianti_Codice.id_cod =  1300 ")
            End If

            '-------------------FOTO POLIGONO  22/08/2022 --------------------------
            If leggiStaticMap Then
                StrSQL.AppendLine(" LEFT JOIN gis_entita e ")
                StrSQL.AppendLine("     ON  Reg_Impianti.piva = e.piva ")
                StrSQL.AppendLine("     AND Reg_Impianti.sa_cod = e.sa_cod ")
                StrSQL.AppendLine("     AND Reg_Impianti.appezza = e.appezza    ")
                StrSQL.AppendLine("     AND Reg_Impianti.ID_REG = e.Id_Imp ")
                StrSQL.AppendLine("     AND e.TipoEntita_Cod IN (SELECT TipoEntita_Cod FROM GIS_TipoEntita WHERE LayerElementiGrafici_Cod = 19) ")
                StrSQL.AppendLine(" LEFT JOIN gis_elementigrafici gis ")
                StrSQL.AppendLine("     on   e.PivaSuperUser = gis.PivaSuperUser ")
                StrSQL.AppendLine("     AND  e.entita_cod = gis.Entita_Cod ")
                StrSQL.AppendLine("     AND gis.LayerElementiGrafici_Cod = 19")
            End If
            '---------------------------------------------------------------------------

            '------------------- LEGGO LO STATO COD --------------------------
            StrSQL.AppendLine("LEFT OUTER JOIN CentrixIndirizzi  ON CentrixIndirizzi.PIVA = Centri_Aziendali.PIVA AND CentrixIndirizzi.sa_cod = Centri_Aziendali.sa_cod AND CentrixIndirizzi.Tipo_Indirizzo = 1  ")
            StrSQL.AppendLine("LEFT OUTER JOIN Indirizzi AS ind ON ind.cod_indirizzo = CentrixIndirizzi.cod_indirizzo")
            '---------------------------------------------------------------------------

            '------------------- LEGGO DISTANZA TRA FILA E SU FILA IN METRI --------------------------
            StrSQL.AppendLine(" LEFT OUTER JOIN Reg_Impianti_Codici tra_fila_m ON Reg_Impianti.PIVA = tra_fila_m.PIVA AND Reg_Impianti.Sa_Cod = tra_fila_m.Sa_Cod AND Reg_Impianti.Appezza = tra_fila_m.Appezza AND Reg_Impianti.ID_Reg = tra_fila_m.ID_Reg AND tra_fila_m.id_Cod = 1061  ")
            StrSQL.AppendLine(" LEFT OUTER JOIN Reg_Impianti_Codici su_fila_m ON Reg_Impianti.PIVA = su_fila_m.PIVA AND Reg_Impianti.Sa_Cod = su_fila_m.Sa_Cod AND Reg_Impianti.Appezza = su_fila_m.Appezza AND Reg_Impianti.ID_Reg = su_fila_m.ID_Reg AND su_fila_m.id_Cod = 1063  ")
            '---------------------------------------------------------------------------

            StrSQL.AppendLine("  ")


            StrSQL.AppendLine("  WHERE  Reg_Impianti.Piva       = '" & Agro_SQL_SaveText(Piva) & "' ")



            '--------------------------modifica 10/07/2012--------------------------
            If Id_Cod <> 0 Then
                StrSQL.AppendLine("     AND Codici_Anagrafe.codice =  " & Agro_SQL_SaveNum(Id_Cod) & "  ")
            End If
            '------------------------------------------------------------------------

            '--------------CAPITOLATI Capitolato_Privato------------modifica 08/04/2013--------------------------

            '------------------------------------------------------------------------


            If Sa_Cod <> 0 Then
                StrSQL.AppendLine("         AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            Else
                'leggo se ci sono filtri sui centri
                Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                Dim FiltroCentri As String = ""
                Dim DtCentriVisibili As DataTable
                DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                    For i = 0 To DtCentriVisibili.Rows.Count - 1
                        FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                    Next
                    If FiltroCentri <> "" Then
                        StrSQL.AppendLine(" AND Reg_Impianti.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                    End If
                End If
            End If

            If Campo_Cod <> 0 Then
                StrSQL.AppendLine("         AND Appezzamento.campo_Cod = " & Agro_SQL_SaveNum(Campo_Cod) & " ")
            End If

            StrSQL.AppendLine("         AND Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine("         AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine("         AND Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine("         AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")

            If leggiAncheBloccati = False Then
                StrSQL.AppendLine("         AND Appezzamento.Blk_Flag <> - 1  ")
            End If



            If Flag_ConDPI = True Then
                'VERSIONE CON DPI
                If Grfi_Cod <> 0 Then
                    StrSQL.AppendLine("     AND Reg_Impianti.grfi_Cod = " & Agro_SQL_SaveNum(Grfi_Cod) & " ")
                End If
                '02/09/2014 esclusa dalla copertura cop_cod=1 (protezione grandine)
                '02/08/2017 esclusi i NULL 
                Select Case Flag_Protetto
                    Case 1
                        StrSQL.AppendLine(" AND Reg_Impianti.Cop_Cod <> 0 AND Reg_Impianti.Cop_Cod <> 1 AND Reg_Impianti.Cop_Cod <> 3 AND Reg_Impianti.Cop_Cod <> 4 AND Reg_Impianti.Cop_Cod <> 5 AND Reg_Impianti.Cop_Cod <> 6 AND Reg_Impianti.Cop_Cod is not null")
                    Case 0
                        StrSQL.AppendLine(" AND ( Reg_Impianti.Cop_Cod = 0 OR Reg_Impianti.Cop_Cod = 1 OR Reg_Impianti.Cop_Cod = 3 OR Reg_Impianti.Cop_Cod = 4 OR Reg_Impianti.Cop_Cod = 5 OR Reg_Impianti.Cop_Cod = 6 or Reg_Impianti.Cop_Cod is null ) ")
                End Select
            End If

            If Veg_Cod <> 0 Then
                StrSQL.AppendLine("     AND Cultivar.Veg_Cod    = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
                If Cul_Cod <> "" AndAlso Cul_Cod <> "0" Then
                    StrSQL.AppendLine("     AND Cultivar.Cul_Cod IN (" & Agro_SQL_Save_Clausola_IN(Cul_Cod, False) & ") ")
                End If
            Else
                'TERRENO NUDO
                If Flag_SoloTerreniNudi Then
                    StrSQL.AppendLine("     AND Reg_Impianti.CUL_COD = 0  ")
                    'escludo le destinazioni d'Uso
                    If Id_Cod = 0 Then
                        StrSQL.AppendLine(" AND NOT EXISTS (SELECT * FROM Reg_Impianti_Codici RIC WHERE Reg_Impianti.PIVA = RIC.PIVA  AND Reg_Impianti.SA_COD = RIC.sa_cod AND   Reg_Impianti.APPEZZA = RIC.appezza AND Reg_Impianti.ID_REG = RIC.Id_Reg  AND RIC.id_cod >= 3000 AND RIC.id_cod <= 4000 )  ")
                    End If
                End If
            End If

            'Escludo gli Impianti con flagCessata valorizzato a "1"
            StrSQL.AppendLine("  AND (Reg_Impianti.flagCessata = '0' OR Reg_Impianti.flagCessata IS NULL) ")

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            Else
                StrSQL.AppendLine(" ORDER BY App_Nome, Progetto ")
            End If

            If Controlla_Dichiarazione_Non_Utilizzo Then
                StrSQL.AppendLine(" drop table #Dichiarazione_Non_Utilizzo_Con_Impianti_cte")

                StrSQL.AppendLine(" drop table #Dichiarazione_Non_Utilizzo_cte")
            End If

            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    '##############################################################################################
    'Solo campi necessari a GiasApp
    Public Function Leggi_Impianti_APP(ByVal piva As String,
                                       ByVal Sa_Cod As Integer,
                                       ByVal Campo_Cod As Integer,
                                       ByVal Veg_Cod As Integer,
                                       ByVal Cul_Cod As String,
                                       ByVal Data As Date,
                                       ByVal LeggiStaticMap As Boolean,
                                       ByVal xFiltroAggiuntivo As String,
                                       ByVal xOrderBy As String,
                                       ByRef objParametri As AgronicaCoreParametri,
                                       ByVal leggiAncheBloccati As Boolean,
                                       Optional ByVal leggiSoloAttivi As Boolean = True
                                       ) As DataTable 'leggiAncheBloccati mettere di default False per non leggere i bloccati palmare/import

        Const nomeRoutine = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_Impianti_APP()"

        '====================================================================================
        'Parametri opzionali :
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable
        Dim i As Integer

        Try

            If String.IsNullOrWhiteSpace(piva) Then
                Throw New Exception("Parametro non corretto nella query (Piva obbligatorio)")
            End If

            'If Sa_Cod = 0 Then
            '    Throw New Exception("Parametro non corretto nella query (Sa_Cod obbligatorio)")
            'End If

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT DISTINCT")
            StrSQL.AppendLine("     Reg_Impianti.PIVA")
            StrSQL.AppendLine("     , Reg_Impianti.SA_COD")
            StrSQL.AppendLine("     , Reg_Impianti.APPEZZA")
            StrSQL.AppendLine("     , Reg_Impianti.ID_REG")
            StrSQL.AppendLine("     , Reg_Impianti.Validita_Inizio")
            StrSQL.AppendLine("     , Reg_Impianti.Validita_Fine")
            StrSQL.AppendLine("     , Reg_Impianti.Sup_Imp")
            StrSQL.AppendLine("     , ISNULL(Reg_Impianti.COP_COD, 0) AS Cop_Cod")
            StrSQL.AppendLine("     , ISNULL(Copertura.Cop_Des, '') AS Copertura")
            StrSQL.AppendLine("     , ISNULL(Reg_Impianti.COVER, 0) AS Cover")
            StrSQL.AppendLine("     , ISNULL(Cultivar.Veg_Cod, 0) AS Veg_Cod")
            StrSQL.AppendLine("     , Reg_Impianti.CUL_COD")
            StrSQL.AppendLine("     , ISNULL(Cultivar.Cul_Des, '') AS Cul_Des")
            StrSQL.AppendLine("     , ISNULL(Reg_Impianti.GRFI_COD, 0) AS Grfi_Cod")
            StrSQL.AppendLine("     , ISNULL(GruppoFinalita.Grfi_Des,'') AS Grfi_Des")
            StrSQL.AppendLine("     , COALESCE(Appezzamento.Blk_Flag, 0) AS Blk_Flag")
            StrSQL.AppendLine("     , COALESCE(Appezzamento.Blk_Inizio_Data, CONVERT(DateTime,'1900/01/01',120)) AS Blk_Inizio_Data")
            StrSQL.AppendLine("     , COALESCE(Appezzamento.Blk_Fine_Data, CONVERT(DateTime,'2100/12/31',120)) AS Blk_Fine_Data")
            StrSQL.AppendLine("     , COALESCE(Appezzamento.Blk_Inizio_Username, '') AS Blk_Inizio_Username")
            StrSQL.AppendLine("     , COALESCE(Appezzamento.Blk_Fine_Username, '') AS Blk_Fine_Username")
            StrSQL.AppendLine("     , COALESCE(Appezzamento.Blk_Inizio_Note, '') AS Blk_Inizio_Note")
            StrSQL.AppendLine("     , COALESCE(Appezzamento.Blk_Fine_Note, '') AS Blk_Fine_Note")
            StrSQL.AppendLine("     , Appezzamento.Campo_Cod")
            StrSQL.AppendLine("     , Appezzamento.SUP_APP")
            StrSQL.AppendLine("     , Appezzamento.APP_NOME")
            StrSQL.AppendLine("       + CASE WHEN ISNULL(Reg_Impianti_Codici_KPIN.val_cod, '')  = '' THEN '' ELSE '  KPin: ' + Reg_Impianti_Codici_KPIN.val_cod END ")
            StrSQL.AppendLine("       + CASE WHEN ISNULL(Reg_Impianti_Codici_BlockName.val_cod, '')  = '' THEN '' ELSE '  BlockName: ' + Reg_Impianti_Codici_BlockName.val_cod END ")
            StrSQL.AppendLine("       + CASE WHEN ISNULL(Imprese_Progetti.data_inizio_prevista, " & AGRODATAINIZIO & ")  = " & AGRODATAINIZIO & " THEN '' ELSE '  Start: ' + Convert(VARCHAR, Imprese_Progetti.data_inizio_prevista, 103) END AS APP_NOME")
            StrSQL.AppendLine("     , Imprese_Progetti.Progetto_Cod")
            StrSQL.AppendLine("     , Imprese_Progetti.Progetto_Nome AS Progetto")
            StrSQL.AppendLine("     , Imprese_Progetti.Regolamento_Cod AS Regolamento")
            StrSQL.AppendLine("     , ISNULL(Regolamenti.Reg_Des, '') AS Reg_Des")
            StrSQL.AppendLine("     , Imprese_Progetti.Validita_Inizio AS Validita_Inizio_Distinta")
            StrSQL.AppendLine("     , Imprese_Progetti.Validita_Fine AS Validita_Fine_Distinta")
            StrSQL.AppendLine("     , Imprese_Progetti.Produzione_Prevista")
            StrSQL.AppendLine("     , Reg_Impianti.Validita_Inizio AS Validita_Inizio_Impianto")
            StrSQL.AppendLine("     , Reg_Impianti.Validita_Fine AS Validita_Fine_Impianto")
            StrSQL.AppendLine("     , Appezzamento.Validita_Inizio AS Validita_Inizio_Appezza")
            StrSQL.AppendLine("     , Appezzamento.Validita_Fine AS Validita_Fine_Appezza")
            StrSQL.AppendLine("     , ISNULL (Codici_Anagrafe.descrizione, '') AS Codici_Anagrafe_Des")
            StrSQL.AppendLine("     , ISNULL (Codici_Anagrafe.codice, '') AS id_Cod")
            StrSQL.AppendLine("     , ISNULL ((Select campo_des from Campi      WHERE     (Appezzamento.PIVA = Campi.PIVA) AND (Appezzamento.sa_cod = Campi.sa_cod)")
            StrSQL.AppendLine("         AND (Appezzamento.Campo_Cod  = Campi.Campo_Cod )) , '') AS Campo_Des")
            StrSQL.AppendLine("     , Imprese.rag_soc, Centri_Aziendali.sa_nome")
            StrSQL.AppendLine("     , ISNULL(SpecieVegetali.Veg_Des, '') AS Veg_Des")
            StrSQL.AppendLine("     , ISNULL(ImpiantiIrrigazioni.Imp_Cod, 0) AS Imp_Cod")
            StrSQL.AppendLine("     , ISNULL(ImpiantiIrrigazioni.Imp_Des, '') AS Imp_Des")
            StrSQL.AppendLine("     , ISNULL(Reg_Impianti_Codici_Codice_Impianto.Val_Cod, '') AS Codici_Anagrafe_Impianto")
            StrSQL.AppendLine("     , ISNULL(Appezzamento_Codici.Val_Cod, '') As Codici_Anagrafe_Appezzamento")
            StrSQL.AppendLine("     , Coalesce (g.Poligono_GeoEntity_WKT, g.Poligono_GeoEntity.STAsText(), '') AS cartografia")
            StrSQL.AppendLine("     , ISNULL(Reg_Impianti.Agea_idColt, '') AS Agea_idColt")
            StrSQL.AppendLine("")

            If LeggiStaticMap Then
                StrSQL.AppendLine("     , (")
                StrSQL.AppendLine("          Select * from(select StaticMap as '*') Tbl")
                StrSQL.AppendLine("          For Xml path('')")
                StrSQL.AppendLine("     ) StaticMapBase64String")
                StrSQL.AppendLine("")
                StrSQL.AppendLine(", ISNULL(g.Entita_Cod, 0) AS Entita_Cod")
            End If

            StrSQL.AppendLine(" FROM Reg_Impianti")
            StrSQL.AppendLine("")
            StrSQL.AppendLine("     INNER JOIN Imprese ON Reg_Impianti.PIVA = Imprese.PIVA  ")
            StrSQL.AppendLine("")
            StrSQL.AppendLine("     INNER JOIN Centri_Aziendali ON Reg_Impianti.PIVA = Centri_Aziendali.PIVA AND Reg_Impianti.SA_COD = Centri_Aziendali.sa_cod  ")
            StrSQL.AppendLine("")
            StrSQL.AppendLine("     INNER JOIN Appezzamento ON Reg_Impianti.PIVA = Appezzamento.PIVA")
            StrSQL.AppendLine("         AND Reg_Impianti.SA_COD = Appezzamento.SA_COD")
            StrSQL.AppendLine("         AND Reg_Impianti.APPEZZA = Appezzamento.APPEZZA")
            StrSQL.AppendLine("")
            StrSQL.AppendLine("     INNER JOIN Imprese_Progetti ON Reg_Impianti.PIVA = Imprese_Progetti.Piva")
            StrSQL.AppendLine("         AND Reg_Impianti.SA_COD = Imprese_Progetti.Sa_Cod")
            StrSQL.AppendLine("         AND Reg_Impianti.APPEZZA = Imprese_Progetti.Appezza")
            StrSQL.AppendLine("         AND Reg_Impianti.ID_REG = Imprese_Progetti.Id_Reg")
            StrSQL.AppendLine("")

            StrSQL.AppendLine("     LEFT JOIN Reg_Impianti_Codici AS Reg_Impianti_Distinta on Reg_Impianti_Distinta.PIVA=Imprese_Progetti.PIVA and Reg_Impianti_Distinta.SA_COD=Imprese_Progetti.SA_COD and Reg_Impianti_Distinta.APPEZZA=Imprese_Progetti.APPEZZA and Reg_Impianti_Distinta.id_reg=Imprese_Progetti.id_reg and Reg_Impianti_Distinta.Progetto_Cod = Imprese_Progetti.Progetto_Cod and reg_impianti_distinta.id_cod = " & enum_CodiciAnagrafe.Distinta_Chiusa & " ")
            StrSQL.AppendLine("")
            StrSQL.AppendLine("     LEFT JOIN Appezzamento_Codici ON Appezzamento_Codici.PIVA=Reg_Impianti.PIVA and Appezzamento_Codici.SA_COD=Reg_Impianti.SA_COD and Appezzamento_Codici.APPEZZA=Reg_Impianti.APPEZZA and Appezzamento_Codici.id_cod = " & enum_CodiciAnagrafe.Riferimento_Alfanumerico_Appezzamento & " ")
            StrSQL.AppendLine("")

            StrSQL.AppendLine("     LEFT OUTER JOIN Regolamenti ON Imprese_Progetti.Regolamento_Cod = Regolamenti.Reg_Cod")
            StrSQL.AppendLine("")
            StrSQL.AppendLine("     LEFT OUTER JOIN Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod")
            StrSQL.AppendLine("")
            StrSQL.AppendLine("     LEFT OUTER JOIN GruppoFinalita ON Reg_Impianti.Grfi_Cod = GruppoFinalita.GRFI_COD")
            StrSQL.AppendLine("")
            StrSQL.AppendLine("     LEFT OUTER JOIN Copertura ON Reg_Impianti.COP_COD = Copertura.Cop_Cod ")
            StrSQL.AppendLine("")

            StrSQL.AppendLine("     LEFT OUTER JOIN SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.VEG_COD")
            StrSQL.AppendLine("")
            StrSQL.AppendLine("     LEFT OUTER JOIN ImpiantiIrrigazioni ON Reg_Impianti.IMP_COD = ImpiantiIrrigazioni.Imp_Cod")
            StrSQL.AppendLine("")

            StrSQL.AppendLine("     LEFT OUTER JOIN Reg_Impianti_Codici on Reg_Impianti.PIVA=Reg_Impianti_Codici.PIVA and Reg_Impianti.SA_COD=Reg_Impianti_Codici.SA_COD and Reg_Impianti.APPEZZA=Reg_Impianti_Codici.APPEZZA and Reg_Impianti.id_reg=Reg_Impianti_Codici.id_reg and Reg_Impianti_Codici.id_cod >2999 and Reg_Impianti_Codici.id_cod < 4000 ")
            StrSQL.AppendLine("")
            StrSQL.AppendLine("     LEFT OUTER JOIN Codici_Anagrafe on Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            StrSQL.AppendLine("")

            StrSQL.AppendLine("     LEFT OUTER JOIN  Reg_Impianti_Codici As Reg_Impianti_Codici_Codice_Impianto on Reg_Impianti.PIVA=Reg_Impianti_Codici_Codice_Impianto.PIVA and Reg_Impianti.SA_COD=Reg_Impianti_Codici_Codice_Impianto.SA_COD and Reg_Impianti.APPEZZA=Reg_Impianti_Codici_Codice_Impianto.APPEZZA and Reg_Impianti.id_reg=Reg_Impianti_Codici_Codice_Impianto.id_reg and Reg_Impianti_Codici_Codice_Impianto.id_cod = " & enum_CodiciAnagrafe.Codice_Impianto & " ")
            StrSQL.AppendLine("")


            'STEFANO 2020-05-05 KPIN E BLOCK NAME
            StrSQL.AppendLine(" LEFT OUTER JOIN Reg_Impianti_Codici Reg_Impianti_Codici_KPIN  ")
            StrSQL.AppendLine("         ON Reg_Impianti.PIVA=Reg_Impianti_Codici_KPIN.PIVA ")
            StrSQL.AppendLine("         AND Reg_Impianti.SA_COD=Reg_Impianti_Codici_KPIN.SA_COD ")
            StrSQL.AppendLine("         AND Reg_Impianti.APPEZZA=Reg_Impianti_Codici_KPIN.APPEZZA ")
            StrSQL.AppendLine("         AND Reg_Impianti.id_reg=Reg_Impianti_Codici_KPIN.id_reg ")
            StrSQL.AppendLine("         AND  Imprese_Progetti.progetto_cod=Reg_Impianti_Codici_KPIN.progetto_cod ")
            StrSQL.AppendLine("         AND Reg_Impianti_Codici_KPIN.id_cod =  1287 ")

            StrSQL.AppendLine(" LEFT OUTER JOIN Reg_Impianti_Codici Reg_Impianti_Codici_BlockName  ")
            StrSQL.AppendLine("         ON Reg_Impianti.PIVA=Reg_Impianti_Codici_BlockName.PIVA ")
            StrSQL.AppendLine("         AND Reg_Impianti.SA_COD=Reg_Impianti_Codici_BlockName.SA_COD ")
            StrSQL.AppendLine("         AND Reg_Impianti.APPEZZA=Reg_Impianti_Codici_BlockName.APPEZZA ")
            StrSQL.AppendLine("         AND Reg_Impianti.id_reg=Reg_Impianti_Codici_BlockName.id_reg ")
            StrSQL.AppendLine("         AND  Imprese_Progetti.progetto_cod=Reg_Impianti_Codici_BlockName.progetto_cod ")
            StrSQL.AppendLine("         AND Reg_Impianti_Codici_BlockName.id_cod =  1288 ")

            StrSQL.AppendLine("")

            'Mattia 18/03/2025: Rimosso check su permesso staticmap per lettura tabelle gis, in quanto non necessario
            StrSQL.AppendLine(" Left Join gis_entita e ")
            StrSQL.AppendLine("     On  Reg_Impianti.piva = e.piva ")
            StrSQL.AppendLine("     And Reg_Impianti.sa_cod = e.sa_cod ")
            StrSQL.AppendLine("     And Reg_Impianti.appezza = e.appezza    ")
            StrSQL.AppendLine("     And Reg_Impianti.ID_REG = e.Id_Imp ")
            StrSQL.AppendLine("     And e.ID_Agenda = 0 ")
            StrSQL.AppendLine(" Left Join gis_elementigrafici g ")
            StrSQL.AppendLine("     On   e.PivaSuperUser = g.PivaSuperUser ")
            StrSQL.AppendLine("     And  e.entita_cod = g.Entita_Cod ")
            StrSQL.AppendLine("     And g.LayerElementiGrafici_Cod = 19")

            StrSQL.AppendLine(String.Format(" WHERE  Reg_Impianti.Piva = '{0}' ", Agro_SQL_SaveText(piva)))

            StrSQL.AppendLine("     And ( reg_impianti_distinta.id_cod is null or reg_impianti_distinta.val_cod = '0' ) ")

            'StrSQL.AppendLine(" And ( isnull(reg_impianti_distinta.id_cod, 0) != " & CInt(enum_CodiciAnagrafe.Distinta_Chiusa) & " ")
            'StrSQL.AppendLine(" OR ( ")
            'StrSQL.AppendLine(" isnull(reg_impianti_distinta.id_cod, 0) = " & CInt(enum_CodiciAnagrafe.Distinta_Chiusa) & " And isnull(reg_impianti_distinta.val_cod, 0) = 0 ) ")
            'StrSQL.AppendLine(" ) ")

            If Sa_Cod <> 0 Then
                StrSQL.AppendLine(String.Format("     AND Reg_Impianti.Sa_Cod = {0}", Agro_SQL_SaveNum(Sa_Cod)))
            Else
                'leggo se ci sono filtri sui centri
                Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                Dim FiltroCentri As String = ""
                Dim DtCentriVisibili As DataTable
                DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(piva) & "'", "", objParametri)
                If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                    For i = 0 To DtCentriVisibili.Rows.Count - 1
                        FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                    Next
                    If FiltroCentri <> "" Then
                        StrSQL.AppendLine(" AND Reg_Impianti.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                    End If
                End If
            End If

            If Campo_Cod <> 0 Then
                StrSQL.AppendLine(String.Format("         AND Appezzamento.campo_Cod = {0}", Agro_SQL_SaveNum(Campo_Cod)))
            End If

            If leggiSoloAttivi Then
                StrSQL.AppendLine(String.Format("     AND Reg_Impianti.Validita_inizio <= {0}", Agro_SQL_SaveDate(Data)))
                StrSQL.AppendLine(String.Format("     AND Reg_Impianti.Validita_Fine >= {0}", Agro_SQL_SaveDate(Data)))
                StrSQL.AppendLine(String.Format("     AND Imprese_Progetti.Validita_inizio <= {0}", Agro_SQL_SaveDate(Data)))
                StrSQL.AppendLine(String.Format("     AND Imprese_Progetti.Validita_Fine >= {0}", Agro_SQL_SaveDate(Data)))
            Else
                StrSQL.AppendLine(String.Format("     AND Reg_Impianti.Validita_Fine >= {0} ", Agro_SQL_SaveDate(Data)))
                StrSQL.AppendLine(String.Format("     AND Imprese_Progetti.Validita_Fine >= {0} ", Agro_SQL_SaveDate(Data)))
            End If

            If Not leggiAncheBloccati Then
                StrSQL.AppendLine("     AND Appezzamento.Blk_Flag <> - 1")
            End If


            If Veg_Cod <> 0 Then
                StrSQL.AppendLine(String.Format("     AND Cultivar.Veg_Cod = {0}", Agro_SQL_SaveNum(Veg_Cod)))
                If Cul_Cod <> "" AndAlso Cul_Cod <> "0" Then
                    StrSQL.AppendLine("     AND Cultivar.Cul_Cod IN (" & Agro_SQL_Save_Clausola_IN(Cul_Cod, False) & ") ")
                End If
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            Else
                StrSQL.AppendLine(" ORDER BY App_Nome, Progetto ")
            End If


            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    Public Function Leggi_Operazioni_Impianti(ByVal Piva As String,
                                              ByVal Sa_Cod As Integer,
                                              ByVal Appezza As Integer,
                                              ByVal ID_Reg As Integer,
                                              ByVal xFiltroAggiuntivo As String,
