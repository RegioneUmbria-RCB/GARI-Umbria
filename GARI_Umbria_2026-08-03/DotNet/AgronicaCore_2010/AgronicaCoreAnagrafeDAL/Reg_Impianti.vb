                    strSql.AppendLine(" FROM PUA_Testata pua ")
                    strSql.AppendLine("     INNER JOIN Imprese i ON pua.Piva = i.PIVA ")
                    strSql.AppendLine("     INNER JOIN Centri_Aziendali c ON c.PIVA = i.PIVA  ")
                    strSql.AppendLine("     INNER JOIN Appezzamento a ON c.PIVA = a.PIVA and c.sa_cod = a.sa_cod  ")
                    strSql.AppendLine("     INNER JOIN Reg_Impianti r ON a.PIVA = r.PIVA and a.sa_cod = r.sa_cod and a.APPEZZA = r.APPEZZA ")
                    strSql.AppendLine("     INNER JOIN Imprese_Progetti ip ON ip.PIVA = r.PIVA and ip.sa_cod = r.sa_cod and ip.APPEZZA  = r.APPEZZA and ip.id_reg = r.ID_REG ")
