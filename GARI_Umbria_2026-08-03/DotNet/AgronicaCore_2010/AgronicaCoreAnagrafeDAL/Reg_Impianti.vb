    Public Function Leggi_Dati_Impianti_per_PianoConcimazione(ByVal Piva As String,
                                                              ByVal Sa_Cod As Integer,
                                                              ByVal Appezza As Integer,
                                                              ByVal Id_Reg As Integer,
                                                              ByVal Progetto_cod As Integer,
                                                              ByVal xFiltroAggiuntivo As String,
                                                              ByVal xOrderBy As String,
                                                              ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                                              ) As DataTable

        Const nomeRoutine = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Dati_Impianti_per_PianoConcimazione()"

        '====================================================================================
        'Parametri opzionali :
        '   Sa_Cod = 0           =>  si leggono tutti gli impianti dell'impresa
        '   Appezza = 0          =>  si leggono tutti gli impianti del centro aziendale
        '   Id_reg = 0           =>  si leggono tutti gli impianti dell'appezzamento
        '====================================================================================

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable

        Try

            StrSQL.Length = 0
            StrSQL.AppendLine(" select rag_soc , sa_nome , app_nome, sup_imp ,veg_des , cul_des , isnull(ip.validita_inizio," & Agro_SQL_SaveDate(AGRODATAINIZIO) & ") as validita_inizio, isnull(ip.validita_fine," & Agro_SQL_SaveDate(AGRODATAFINE) & ") as validita_fine,   ")
            StrSQL.AppendLine(" r.validita_inizio as validita_inizio_impianto , r.validita_fine as validita_fine_impianto, ")
            StrSQL.AppendLine(" r.grfi_cod, isnull(fin.Grfi_Des,'') as grfi_des, ")
            StrSQL.AppendLine(" a.campo_cod, isnull(ca.campo_Des,'') as campo_Des, ")
            StrSQL.AppendLine(" ip.regolamento_cod, isnull(reg.reg_des,'') as reg_des, ")
            StrSQL.AppendLine(" isnull(ip.Stato_Impianto, 0) As stato_impianto, ")
            StrSQL.AppendLine(" r.piva, r.sa_cod, r.appezza, r.id_reg, isnull(ip.progetto_cod,0) as progetto_cod, ")
            StrSQL.AppendLine(" isnull(s.veg_cod,0) as veg_cod, isnull(cu.cul_cod,0) as cul_cod, ")
            StrSQL.AppendLine(" Resa_Prevista, Resa_Effettiva, ")
            StrSQL.AppendLine("         ISNULL((SELECT TOP 1 Codici_Anagrafe.descrizione ")
            StrSQL.AppendLine("         FROM    Reg_Impianti_Codici INNER JOIN ")
            StrSQL.AppendLine("                 Codici_Anagrafe ON Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            StrSQL.AppendLine("         WHERE   (Reg_Impianti_Codici.id_cod >= 3000) And  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.id_cod < 4000) And  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.PIVA = r.PIVA) And ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.sa_cod = r.sa_cod)  ")
            StrSQL.AppendLine("         And     (Reg_Impianti_Codici.appezza = r.appezza)  ")
            StrSQL.AppendLine("         And     (Reg_Impianti_Codici.Id_Reg = r.ID_REG)),'')  ")
            StrSQL.AppendLine("         AS  DestinazioneUso, ")

            StrSQL.AppendLine("         ISNULL((SELECT TOP 1 Codici_Anagrafe.codice ")
            StrSQL.AppendLine("         FROM    Reg_Impianti_Codici INNER JOIN ")
            StrSQL.AppendLine("                 Codici_Anagrafe ON Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            StrSQL.AppendLine("         WHERE   (Reg_Impianti_Codici.id_cod >= 3000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.id_cod < 4000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.PIVA = r.PIVA) AND ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.sa_cod = r.sa_cod)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.appezza = r.appezza)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.Id_Reg = r.ID_REG)),0)  ")
            StrSQL.AppendLine("         AS  DestinazioneUsoCodice, ")


            '--- LIMITI APPORTI ---
            StrSQL.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            StrSQL.AppendLine("         FROM   Reg_Impianti_Codici ")
            StrSQL.AppendLine("         WHERE  Piva = ip.PIVA AND sa_cod = ip.sa_cod ")
            StrSQL.AppendLine("         AND appezza = ip.appezza AND Id_Reg = ip.id_reg ")
            StrSQL.AppendLine("         AND Progetto_Cod = ip.Progetto_Cod  ")
            StrSQL.AppendLine("         AND Reg_Impianti_Codici.id_cod=1050 ")
            StrSQL.AppendLine("         ), 0) AS N_Massimo, ")

            StrSQL.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            StrSQL.AppendLine("         FROM   Reg_Impianti_Codici ")
            StrSQL.AppendLine("         WHERE  Piva = ip.PIVA AND sa_cod = ip.sa_cod ")
            StrSQL.AppendLine("         AND appezza = ip.appezza AND Id_Reg = ip.id_reg ")
            StrSQL.AppendLine("         AND Progetto_Cod = ip.Progetto_Cod  ")
            StrSQL.AppendLine("         AND Reg_Impianti_Codici.id_cod=1051 ")
            StrSQL.AppendLine("         ), 0) AS P_Massimo, ")

            StrSQL.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            StrSQL.AppendLine("         FROM   Reg_Impianti_Codici ")
            StrSQL.AppendLine("         WHERE  Piva = ip.PIVA AND sa_cod = ip.sa_cod ")
            StrSQL.AppendLine("         AND appezza = ip.appezza AND Id_Reg = ip.id_reg ")
            StrSQL.AppendLine("         AND Progetto_Cod = ip.Progetto_Cod  ")
            StrSQL.AppendLine("         AND Reg_Impianti_Codici.id_cod=1052 ")
            StrSQL.AppendLine("         ), 0) AS K_Massimo ")


            StrSQL.AppendLine(" from imprese i ")
            StrSQL.AppendLine("     inner join Centri_Aziendali c on c.PIVA = i.PIVA  ")
            StrSQL.AppendLine("     inner join appezzamento a on a.PIVA = i.PIVA and c.sa_cod = a.sa_cod  ")
            StrSQL.AppendLine("     inner join reg_impianti r on r.PIVA = a.PIVA and r.sa_cod = a.sa_cod and r.APPEZZA  = a.APPEZZA ")
            StrSQL.AppendLine("     left join Imprese_Progetti ip on ip.PIVA = r.PIVA and ip.sa_cod = r.sa_cod and ip.APPEZZA  = r.APPEZZA and ip.id_reg = r.ID_REG ")
            StrSQL.AppendLine("     left join cultivar cu on cu.cul_cod = r.cul_cod  ")
            StrSQL.AppendLine("     left join SpecieVegetali s on s.Veg_Cod = cu.veg_cod  ")

            StrSQL.AppendLine("     left join regolamenti reg on reg.Reg_Cod = ip.regolamento_cod    ")
            StrSQL.AppendLine("     left join gruppofinalita fin on fin.Grfi_Cod = r.grfi_cod   ")

            StrSQL.AppendLine("     left join Campi ca ON a.piva = ca.piva and a.sa_cod = ca.sa_cod and a.Campo_Cod = ca.Campo_Cod")

            StrSQL.AppendLine(" WHERE   1=1 ")

            If Piva <> "" Then
                StrSQL.AppendLine(" AND   r.piva = '" & Agro_SQL_SaveText(Piva) & "'  ")
            End If
            If Sa_Cod <> 0 Then
                StrSQL.AppendLine(" AND     r.sa_cod = " & Agro_SQL_SaveNum(Sa_Cod) & "  ")
            End If
            If Appezza <> 0 Then
                StrSQL.AppendLine(" AND     r.Appezza = " & Agro_SQL_SaveNum(Appezza) & "  ")
            End If
            If Id_Reg <> 0 Then
                StrSQL.AppendLine(" AND     r.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & "  ")
            End If
            If Progetto_cod <> 0 Then
                StrSQL.AppendLine(" AND     ip.Progetto_cod = " & Agro_SQL_SaveNum(Progetto_cod) & "  ")
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If


            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, MessaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return dt

    End Function

    Public Function Leggi_Catasto_Impianti_per_PianoConcimazione(ByVal Piva As String,
                                                                 ByVal Sa_Cod As Integer,
                                                                 ByVal Appezza As Integer,
                                                                 ByVal Id_Reg As Integer,
                                                                 ByVal Progetto_cod As Integer,
                                                                 ByVal xFiltroAggiuntivo As String,
                                                                 ByVal xOrderBy As String,
                                                                 ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                                                 Optional defaultSezioneSubalterno As String = ""
                                                                 ) As DataTable

        Const nomeRoutine = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Catasto_Impianti_per_PianoConcimazione()"

        '====================================================================================
        'Parametri opzionali :
        '   Sa_Cod = 0           =>  si leggono tutti gli impianti dell'impresa
        '   Appezza = 0          =>  si leggono tutti gli impianti del centro aziendale
        '   Id_reg = 0           =>  si leggono tutti gli impianti dell'appezzamento
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable

        Try


            StrSQL.Length = 0
            'StrSQL.AppendLine("SELECT r.piva,r.sa_cod,r.appezza,ISNULL(PROV,'') AS PROV, ISNULL(COM,'') AS COM, ISNULL(Sezione,'') AS Sezione, ISNULL(Foglio,0) AS Foglio, ISNULL(Numero,0) AS Numero, ISNULL(Subalterno,'') AS Subalterno ")
            StrSQL.AppendLine(" SELECT DISTINCT ")
            StrSQL.AppendLine("     r.piva, r.sa_cod, r.appezza ")
            StrSQL.AppendLine("   , ISNULL(PROV, '') AS PROV, ISNULL(COM, '') AS COM ")
            StrSQL.AppendLine($", CASE ")
            If defaultSezioneSubalterno = "0" Then
                'se Sezione = '' --> converto in '0'
                StrSQL.AppendLine($"   WHEN ISNULL(Sezione, '{defaultSezioneSubalterno}') = '' THEN '{defaultSezioneSubalterno}' ")
            ElseIf defaultSezioneSubalterno = "" Then
                'se Sezione = '0' --> converto in ''
                StrSQL.AppendLine($"   WHEN ISNULL(Sezione, '{defaultSezioneSubalterno}') = '0' THEN '{defaultSezioneSubalterno}' ")
            End If
            StrSQL.AppendLine($"        ELSE Sezione END AS Sezione ")
            StrSQL.AppendLine("   , ISNULL(Foglio,0) AS Foglio, ISNULL(Numero,0) AS Numero ")
            StrSQL.AppendLine($", CASE WHEN ISNULL(Subalterno, '{defaultSezioneSubalterno}') = '{defaultSezioneSubalterno}' ")
            StrSQL.AppendLine($"        THEN '{defaultSezioneSubalterno}' ")
            If defaultSezioneSubalterno = "0" Then
                'se Subalterno = '' --> converto in '0'
                StrSQL.AppendLine($"   WHEN ISNULL(Subalterno, '{defaultSezioneSubalterno}') = '' THEN '{defaultSezioneSubalterno}' ")
            ElseIf defaultSezioneSubalterno = "" Then
                'se Subalterno = '0' --> converto in ''
                StrSQL.AppendLine($"   WHEN ISNULL(Subalterno, '{defaultSezioneSubalterno}') = '0' THEN '{defaultSezioneSubalterno}' ")
            End If
            StrSQL.AppendLine($"        ELSE Subalterno END AS Subalterno ")

            StrSQL.AppendLine(" FROM AppezzamentiXParticelle a ")
            StrSQL.AppendLine(" INNER JOIN reg_impianti r on r.PIVA = a.PIVA and r.sa_cod = a.sa_cod and r.APPEZZA  = a.APPEZZA ")
            StrSQL.AppendLine(" LEFT JOIN Imprese_Progetti ip on ip.PIVA = r.PIVA and ip.sa_cod = r.sa_cod and ip.APPEZZA  = r.APPEZZA and ip.id_reg = r.ID_REG ")
            StrSQL.AppendLine(" LEFT JOIN cultivar cu on cu.cul_cod = r.cul_cod  ")
            StrSQL.AppendLine(" LEFT JOIN SpecieVegetali s on s.Veg_Cod = cu.veg_cod  ")

            StrSQL.AppendLine(" WHERE 1 = 1 ")

            If Piva <> "" Then
                StrSQL.AppendLine(" AND r.piva = '" & Agro_SQL_SaveText(Piva) & "'  ")
            End If
            If Sa_Cod <> 0 Then
                StrSQL.AppendLine(" AND r.sa_cod = " & Agro_SQL_SaveNum(Sa_Cod) & "  ")
            End If
            If Appezza <> 0 Then
                StrSQL.AppendLine(" AND r.Appezza = " & Agro_SQL_SaveNum(Appezza) & "  ")
            End If
            If Id_Reg <> 0 Then
                StrSQL.AppendLine(" AND r.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & "  ")
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If


            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    Public Function Leggi_Dati_Impianti_per_PUA(ByVal Piva As String,
                                                ByVal Sa_Cod As Integer,
                                                ByVal Appezza As Integer,
                                                ByVal Id_Reg As Integer,
                                                ByVal Progetto_cod As Integer,
                                                ByVal Data As Date,
                                                ByVal xFiltroAggiuntivo As String,
                                                ByVal xOrderBy As String,
                                                ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                                ) As DataTable

        Const nomeRoutine = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Dati_Impianti_per_PUA()"

        '====================================================================================
        'Parametri opzionali :
        '   Sa_Cod = 0              =>  si leggono tutti gli impianti dell'impresa
        '   Appezza = 0             =>  si leggono tutti gli impianti del centro aziendale
        '   Id_reg = 0              =>  si leggono tutti gli impianti dell'appezzamento
        '   Data = AGRODATAINIZIO   =>  si leggono tutti gli impianti a prescindere dalla validità della distinta alla data
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim strSql As New StringBuilder
        Dim dt As DataTable

        Try

            strSql.Length = 0
            strSql.AppendLine(" SELECT rag_soc , sa_nome , app_nome, sup_imp , ISNULL(veg_des,'') AS Veg_Des , ISNULL(cul_des,'') AS Cul_Des , ")
            strSql.AppendLine(" isnull(ip.validita_inizio," & Agro_SQL_SaveDate(AGRODATAINIZIO) & ") as validita_inizio,  ")
            strSql.AppendLine(" isnull(ip.validita_fine," & Agro_SQL_SaveDate(AGRODATAFINE) & ") as validita_fine,   ")
            strSql.AppendLine(" r.validita_inizio as validita_inizio_impianto , r.validita_fine as validita_fine_impianto, ")
            strSql.AppendLine(" ISNULL(r.grfi_cod,0) AS Grfi_Cod, ISNULL(fin.Grfi_Des,'') as Grfi_Des, ")

            strSql.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            strSql.AppendLine("         FROM   Reg_Impianti_Codici ")
            strSql.AppendLine("         WHERE  Piva = ip.PIVA AND sa_cod = ip.sa_cod ")
            strSql.AppendLine("         AND appezza = ip.appezza AND Id_Reg = ip.id_reg ")
            strSql.AppendLine("         AND Progetto_Cod = ip.Progetto_Cod  ")
            strSql.AppendLine("         AND Reg_Impianti_Codici.id_cod = " & enum_CodiciAnagrafe.Finalita_Concimazione_Impianto)
            strSql.AppendLine("         ), -1) AS Grfi_Cod_Concimazione, ")

            strSql.AppendLine(" a.campo_cod, isnull(ca.campo_Des,'') as campo_Des, ")
            strSql.AppendLine(" ip.regolamento_cod, isnull(reg.reg_des,'') as reg_des, ")
            strSql.AppendLine(" r.piva, r.sa_cod, r.appezza, r.id_reg, isnull(ip.progetto_cod,0) as progetto_cod, ")
            strSql.AppendLine(" isnull(s.veg_cod,0) as veg_cod, isnull(cu.cul_cod,0) as cul_cod, ")

            strSql.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            strSql.AppendLine("         FROM   Reg_Impianti_Codici ")
            strSql.AppendLine("         WHERE  Piva = ip.PIVA AND sa_cod = ip.sa_cod ")
            strSql.AppendLine("         AND appezza = ip.appezza AND Id_Reg = ip.id_reg ")
            strSql.AppendLine("         AND Progetto_Cod = ip.Progetto_Cod  ")
            strSql.AppendLine("         AND Reg_Impianti_Codici.id_cod = " & enum_CodiciAnagrafe.Impianto_LimiteN)
            strSql.AppendLine("         ), -1) AS N_Fabbisogno, ")

            strSql.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            strSql.AppendLine("         FROM   Reg_Impianti_Codici ")
            strSql.AppendLine("         WHERE  Piva = ip.PIVA AND sa_cod = ip.sa_cod ")
            strSql.AppendLine("         AND appezza = ip.appezza AND Id_Reg = ip.id_reg ")
            strSql.AppendLine("         AND Progetto_Cod = ip.Progetto_Cod  ")
            strSql.AppendLine("         AND Reg_Impianti_Codici.id_cod = " & enum_CodiciAnagrafe.Impianto_LimiteN_Organico)
            strSql.AppendLine("         ), -1) AS N_Fabbisogno_Organico, ")

            strSql.AppendLine(" ISNULL(ip.Stato_Impianto,0) AS Stato_Impianto, ")
            strSql.AppendLine(" ISNULL(ip.Produzione_Prevista,0) AS Resa, ")

            strSql.AppendLine(" ISNULL(ip.FlagSecondoRaccolto,0) AS Ciclo_Cod, ")
            strSql.AppendLine(" CASE WHEN ip.FlagSecondoRaccolto = 0 THEN 'Principale' ELSE 'Secondario' END AS Ciclo_Des, ")

            strSql.AppendLine(" ISNULL(ap.PROV, '') AS PROV, ISNULL(ap.COM, '') AS COM, ISNULL(ap.SEZIONE, '') AS SEZIONE, ")
            strSql.AppendLine(" ISNULL(ap.FOGLIO, 0) AS FOGLIO, ISNULL(ap.NUMERO, 0) AS NUMERO, ISNULL(ap.SUBALTERNO, '') AS SUBALTERNO, ")

            strSql.AppendLine(" ISNULL(pva.Id,0) AS Id_PartVincoli, ")
            strSql.AppendLine(" ISNULL(pva.Analisi_Testata_Cod,0) AS Analisi_Testata_Cod, ")

            strSql.AppendLine(" ISNULL(at.Analisi_Testata_Des, 'Nessuna Analisi') + ")
            strSql.AppendLine("      CASE WHEN at.Analisi_Testata_Data_Inizio IS NOT NULL ")
            strSql.AppendLine("           THEN ' - (' + CONVERT(VARCHAR(10), at.Analisi_Testata_Data_Inizio, 103) + ')' ")
            strSql.AppendLine("           ELSE '' ")
            strSql.AppendLine("      END AS Analisi_Testata_Des, ")

            strSql.AppendLine(" ISNULL(pva.Veg_Cod_Prec,0) AS Veg_Cod_Prec, ")
            strSql.AppendLine(" ISNULL(pva.Id_Mat_O,0) AS Id_Mat_O, ")
            strSql.AppendLine(" ISNULL(pva.Id_Fre,0) AS Id_Fre, ")
            strSql.AppendLine(" ISNULL(pva.Ubicazione_Cod,0) AS Ubicazione_Cod, ")
            strSql.AppendLine(" ISNULL(pva.N_Distribuito,0) AS N_Distribuito, ")
            strSql.AppendLine(" ISNULL(pva.TipoAcqua_Cod,0) AS TipoAcqua_Cod, ")

            strSql.AppendLine(" ISNULL(pva.validita_inizio," & Agro_SQL_SaveDate(AGRODATAINIZIO) & ") as validita_inizio_partVincoli, ")
            strSql.AppendLine(" ISNULL(pva.validita_fine," & Agro_SQL_SaveDate(AGRODATAFINE) & ") as validita_fine_partVincoli,   ")

            strSql.AppendLine(" ISNULL(pe.Cul_Cod_Agea, '000') AS Cul_Cod_Agea, ")
            strSql.AppendLine(" ISNULL(pe.Uso_Cod_Agea, '000') AS Uso_Cod, ")
            strSql.AppendLine(" ISNULL(pe.Macrouso_Cod, '000') AS Macrouso_Cod, ")
            strSql.AppendLine(" ISNULL(pe.Occupazione_Cod_Agea, '000') AS Occupazione_Cod, ")
            strSql.AppendLine(" ISNULL(pe.Destinazione_Cod_Agea, '000') AS Destinazione_Cod, ")
            strSql.AppendLine(" ISNULL(pe.Qualita_Cod_Agea, '000') AS Qualita_Cod ")

            ' Giulia: 28/5/2019: Imprese_Progetti e AppezzamentiXParticelle sono in INNER JOIN perché i dati sono salvati lì dentro.
            '     ovviamente se qualcuno non le ha, non potrà usare il nuovo PUA
            strSql.AppendLine(" FROM imprese i ")
            strSql.AppendLine("     INNER JOIN Centri_Aziendali c on c.PIVA = i.PIVA  ")
            strSql.AppendLine("     INNER JOIN appezzamento a on a.PIVA = i.PIVA and c.sa_cod = a.sa_cod  ")
            strSql.AppendLine("     INNER JOIN reg_impianti r on r.PIVA = a.PIVA and r.sa_cod = a.sa_cod and r.APPEZZA  = a.APPEZZA ")

            strSql.AppendLine("     INNER JOIN Imprese_Progetti ip on ip.PIVA = r.PIVA and ip.sa_cod = r.sa_cod and ip.APPEZZA  = r.APPEZZA and ip.id_reg = r.ID_REG ")
            strSql.AppendLine("     INNER JOIN AppezzamentiXParticelle ap ON ap.PIVA = a.PIVA AND ap.SA_COD = a.SA_COD AND ap.APPEZZA = a.APPEZZA ")

            strSql.AppendLine("     LEFT JOIN Reg_Impianti_Programmazioni rip on r.PIVA = rip.Piva and r.SA_COD = rip.Sa_Cod and r.APPEZZA = rip.Appezza and r.ID_REG = rip.Id_Reg ")
            strSql.AppendLine("     LEFT JOIN Programmazione_Entita pe on rip.piva = pe.piva and rip.Programmazione_Cod = pe.Programmazione_Cod and rip.Programmazione_Entita_Cod = pe.Programmazione_Entita_Cod ")

            strSql.AppendLine("     LEFT JOIN ParticelleCatastalixVincoliAgronomici pva ON ap.PROV = pva.PROV AND ap.COM = pva.COM AND ap.SEZIONE = pva.SEZIONE AND ap.FOGLIO = pva.FOGLIO AND ap.NUMERO = pva.NUMERO AND ap.SUBALTERNO = pva.SUBALTERNO ")
            strSql.AppendLine("                    AND (ISNULL(pe.Cul_Cod_Agea, '000') = pva.Cul_Cod_Agea)  ")
            strSql.AppendLine("                    AND (ISNULL(pe.Uso_Cod_Agea, '000') = pva.Uso_Cod) ")
            strSql.AppendLine("                    AND (ISNULL(pe.Macrouso_Cod, '000') = pva.Macrouso_Cod) ")
            strSql.AppendLine("                    AND (ISNULL(pe.Occupazione_Cod_Agea, '000') = pva.Occupazione_Cod) ")
            strSql.AppendLine("                    AND (ISNULL(pe.Destinazione_Cod_Agea, '000') = pva.Destinazione_Cod) ")
            strSql.AppendLine("                    AND (ISNULL(pe.Qualita_Cod_Agea, '000') = pva.Qualita_Cod) ")

            strSql.AppendLine("     LEFT JOIN Analisi_Testata at ON at.Analisi_Testata_Cod = pva.Analisi_Testata_Cod ")

            strSql.AppendLine("     LEFT JOIN cultivar cu on cu.cul_cod = r.cul_cod  ")
            strSql.AppendLine("     LEFT JOIN SpecieVegetali s on s.Veg_Cod = cu.veg_cod  ")

            strSql.AppendLine("     LEFT JOIN Regolamenti reg on reg.Reg_Cod = ip.regolamento_cod    ")
            strSql.AppendLine("     LEFT JOIN GruppoFinalita fin on fin.Grfi_Cod = r.grfi_cod   ")

            strSql.AppendLine("     LEFT JOIN Campi ca ON a.piva = ca.piva and a.sa_cod = ca.sa_cod and a.Campo_Cod = ca.Campo_Cod")

            strSql.AppendLine(" WHERE   1=1 ")

            'Esclusione degli appezzamenti senza specie
            strSql.AppendLine(" AND   s.Veg_Cod IS NOT NULL AND s.Veg_Cod <> 0   ")

            If Piva <> "" Then
                strSql.AppendLine(" AND   r.piva = '" & Agro_SQL_SaveText(Piva) & "'  ")
            End If

            If Sa_Cod <> 0 Then
                strSql.AppendLine(" AND     r.sa_cod = " & Agro_SQL_SaveNum(Sa_Cod) & "  ")
            End If

            If Appezza <> 0 Then
                strSql.AppendLine(" AND     r.Appezza = " & Agro_SQL_SaveNum(Appezza) & "  ")
            End If

            If Id_Reg <> 0 Then
                strSql.AppendLine(" AND     r.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & "  ")
            End If

            If Progetto_cod <> 0 Then
                strSql.AppendLine(" AND     ip.Progetto_cod = " & Agro_SQL_SaveNum(Progetto_cod) & "  ")
            End If

            If Data <> AGRODATAINIZIO Then
                strSql.AppendLine(" AND     r.Validita_Inizio <= " & Agro_SQL_SaveDate(Data) & "  ")
                strSql.AppendLine(" AND     r.Validita_Fine   >= " & Agro_SQL_SaveDate(Data) & "  ")

                strSql.AppendLine(" AND     ip.Validita_Inizio <= " & Agro_SQL_SaveDate(Data) & "  ")
                strSql.AppendLine(" AND     ip.Validita_Fine   >= " & Agro_SQL_SaveDate(Data) & "  ")

                'StrSQL.AppendLine(" AND     rip.Validita_Inizio <= " & Agro_SQL_SaveDate(Data) & "  ")
                'StrSQL.AppendLine(" AND     rip.Validita_Fine   >= " & Agro_SQL_SaveDate(Data) & "  ")

                strSql.AppendLine(" AND     (pva.Validita_Inizio IS NULL OR pva.Validita_Inizio <= " & Agro_SQL_SaveDate(Data) & ")  ")
                strSql.AppendLine(" AND     (pva.Validita_Fine   IS NULL OR pva.Validita_Fine   >= " & Agro_SQL_SaveDate(Data) & ")  ")
            End If

            If xFiltroAggiuntivo <> "" Then
                strSql.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If


            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                strSql.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, strSql.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    Public Function Leggi_Dati_Impianti_per_PUA_NEW(ByVal Piva As String, ByVal Sa_Cod As Integer,
                                                    ByVal Pua_Cod As Integer,
                                                    ByVal Pua_Regolamento_Cod As Integer,
