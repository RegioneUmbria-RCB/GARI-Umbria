                    strSql.AppendLine("         AND appezza = ip.appezza AND Id_Reg = ip.id_reg ")
                    strSql.AppendLine("         AND Progetto_Cod = ip.Progetto_Cod  ")
                    strSql.AppendLine("         AND Reg_Impianti_Codici.id_cod = " & enum_CodiciAnagrafe.Impianto_LimiteN)
                    strSql.AppendLine("         ), -1) AS N_Fabbisogno, ")

                    strSql.AppendLine(" ISNULL((SELECT  top 1  Reg_Impianti_Codici.val_cod ")
                    strSql.AppendLine("         FROM   Reg_Impianti_Codici ")
                    strSql.AppendLine("         WHERE  Piva = ip.PIVA AND sa_cod = ip.sa_cod ")
                    strSql.AppendLine("         AND appezza = ip.appezza AND Id_Reg = ip.id_reg ")
                    strSql.AppendLine("         AND Progetto_Cod = ip.Progetto_Cod  ")
                    strSql.AppendLine("         AND Reg_Impianti_Codici.id_cod = " & enum_CodiciAnagrafe.Impianto_LimiteN_Organico)
                    strSql.AppendLine("         ), -1) AS N_Fabbisogno_Organico, ")

                    strSql.AppendLine(" ISNULL(ip.Stato_Impianto,0) AS Stato_Impianto, ")
                    strSql.AppendLine(" ISNULL(ip.Produzione_Prevista,0) AS Resa, ")

                    strSql.AppendLine(" ISNULL(ip.FlagSecondoRaccolto,0) AS Ciclo_Cod, ")
                    strSql.AppendLine(" CASE WHEN ip.FlagSecondoRaccolto = 0 THEN 'Principale' ELSE 'Secondario' END AS Ciclo_Des, ")

                    strSql.AppendLine(" ISNULL(ap.PROV, '') AS PROV, ISNULL(ap.COM, '') AS COM, ISNULL(ap.SEZIONE, '') AS SEZIONE, ")
                    strSql.AppendLine(" ISNULL(ap.FOGLIO, 0) AS FOGLIO, ISNULL(ap.NUMERO, 0) AS NUMERO, ISNULL(ap.SUBALTERNO, '') AS SUBALTERNO, ")

                    strSql.AppendLine(" ISNULL(istat.COMUNI_PROV, '') AS provincia, ISNULL(istat.LOCALITA, '') AS comune, ")
                    'strSql.AppendLine(" ISNULL(ImpreseXParticelle.Sup_Condotta, 0) AS Sup_Condotta,  ")
                    strSql.AppendLine(" ISNULL(ap.area, 0) AS Sup_AppxPart,  ")

                    If Leggi_SupCondotta = True Then
                        strSql.AppendLine(" ISNULL((SELECT TOP 1 Sup_Condotta ")
                        strSql.AppendLine("         FROM   ImpreseXParticelle ")
                        strSql.AppendLine("         where ap.PIVA = ImpreseXParticelle.PIVA AND ap.SA_COD = ImpreseXParticelle.SA_COD ")
                        strSql.AppendLine("         AND ImpreseXParticelle.PROV=ap.prov And ImpreseXParticelle.com=ap.com ")
                        strSql.AppendLine("         AND ImpreseXParticelle.sezione=ap.sezione And ImpreseXParticelle.foglio=ap.foglio  ")
                        strSql.AppendLine("         AND ImpreseXParticelle.numero=ap.numero And ImpreseXParticelle.subalterno=ap.subalterno  ")
                        strSql.AppendLine("         AND sup_condotta <> 0  ")
                        strSql.AppendLine("         order by validita_fine desc ")
                        strSql.AppendLine("         ), 0) AS Sup_Condotta, ")
                    End If


                    strSql.AppendLine(" ISNULL(av.Id,0) AS Id_AnaVincoli, ")
                    strSql.AppendLine(" ISNULL(av.Analisi_Testata_Cod,0) AS Analisi_Testata_Cod, ")

                    strSql.AppendLine(" ISNULL(at.Analisi_Testata_Des, 'Nessuna Analisi') + ")
                    strSql.AppendLine("      CASE WHEN at.Analisi_Testata_Data_Inizio IS NOT NULL ")
                    strSql.AppendLine("           THEN ' - (' + CONVERT(VARCHAR(10), at.Analisi_Testata_Data_Inizio, 103) + ')' ")
                    strSql.AppendLine("           ELSE '' ")
                    strSql.AppendLine("      END AS Analisi_Testata_Des, ")

                    strSql.AppendLine(" ISNULL((SELECT top 1 Analisi_Dettagli.Analisi_Dettaglio_Valore_1 ")
                    strSql.AppendLine("         FROM   Analisi_Dettagli ")
                    strSql.AppendLine("         WHERE  Analisi_Testata_cod = av.Analisi_Testata_Cod ")
                    strSql.AppendLine("         AND Analisi_Parametro_Cod = " & enum_AnalisiParametri.AnalisiParametri_Sabbia)
                    strSql.AppendLine("         ), 0) AS Sabbia, ")
                    strSql.AppendLine(" ISNULL((SELECT top 1 Analisi_Dettagli.Analisi_Dettaglio_Valore_1 ")
                    strSql.AppendLine("         FROM   Analisi_Dettagli ")
                    strSql.AppendLine("         WHERE  Analisi_Testata_cod = av.Analisi_Testata_Cod ")
                    strSql.AppendLine("         AND Analisi_Parametro_Cod = " & enum_AnalisiParametri.AnalisiParametri_Argilla)
                    strSql.AppendLine("         ), 0) AS Argilla, ")
                    strSql.AppendLine(" ISNULL((SELECT top 1 Analisi_Dettagli.Analisi_Dettaglio_Valore_1 ")
                    strSql.AppendLine("         FROM   Analisi_Dettagli ")
                    strSql.AppendLine("         WHERE  Analisi_Testata_cod = av.Analisi_Testata_Cod ")
                    strSql.AppendLine("         AND Analisi_Parametro_Cod = " & enum_AnalisiParametri.AnalisiParametri_SostanzaOrganica)
                    strSql.AppendLine("         ), 0) AS SO, ")

                    strSql.AppendLine(" ISNULL(av.Veg_Cod_Prec,0) AS Veg_Cod_Prec, ")
                    strSql.AppendLine(" ISNULL(av.Ubicazione_Cod,0) AS Ubicazione_Cod, ")
                    strSql.AppendLine(" ISNULL(av.TipoAcqua_Cod,0) AS TipoAcqua_Cod, ")
                    strSql.AppendLine(" ISNULL(av.N_FertilizzazioniPrecedenti,0) AS N_FertilizzazioniPrecedenti, ")

                    strSql.AppendLine(" 0 AS N_FabbisognoSoddisfatto, ")
                    strSql.AppendLine(" 0 AS N_FabbisognoSoddisfattoOrganico, ")
                    strSql.AppendLine(" 0 AS N_SoddisfattoDigestato, ")

                    strSql.AppendLine(" 0 AS N_TotaleSoddisfatto, ")
                    strSql.AppendLine(" 0 AS N_Zootecnico_Letame, ")
                    strSql.AppendLine(" 0 AS N_Zootecnico_Liquame ")

                    strSql.AppendLine(" FROM PUA_Testata pua ")
                    strSql.AppendLine("     INNER JOIN Imprese i ON pua.Piva = i.PIVA ")
                    strSql.AppendLine("     INNER JOIN Centri_Aziendali c ON c.PIVA = i.PIVA  ")
                    strSql.AppendLine("     INNER JOIN Appezzamento a ON c.PIVA = a.PIVA and c.sa_cod = a.sa_cod  ")
                    strSql.AppendLine("     INNER JOIN Reg_Impianti r ON a.PIVA = r.PIVA and a.sa_cod = r.sa_cod and a.APPEZZA = r.APPEZZA ")
                    strSql.AppendLine("     INNER JOIN Imprese_Progetti ip ON ip.PIVA = r.PIVA and ip.sa_cod = r.sa_cod and ip.APPEZZA  = r.APPEZZA and ip.id_reg = r.ID_REG ")

                    strSql.AppendLine("     LEFT JOIN AppezzamentiXParticelle ap ON a.PIVA = ap.PIVA AND a.SA_COD = ap.SA_COD AND a.APPEZZA = ap.APPEZZA ")
                    strSql.AppendLine("     LEFT JOIN istat  on istat.PROV=ap.prov And istat.com=ap.com ")

                    'strSql.AppendLine("     INNER JOIN AppezzamentiXParticelle ap ON ap.PIVA = a.PIVA AND ap.SA_COD = a.SA_COD AND ap.APPEZZA = a.APPEZZA ")
                    'strSql.AppendLine("     inner Join istat  on istat.PROV=ap.prov And istat.com=ap.com ")
                    'strSql.AppendLine("     inner Join ImpreseXParticelle on ap.PIVA = ImpreseXParticelle.PIVA AND ap.SA_COD = ImpreseXParticelle.SA_COD AND ImpreseXParticelle.PROV=ap.prov And ImpreseXParticelle.com=ap.com AND ImpreseXParticelle.sezione=ap.sezione And ImpreseXParticelle.foglio=ap.foglio AND ImpreseXParticelle.numero=ap.numero And ImpreseXParticelle.subalterno=ap.subalterno ")

                    strSql.AppendLine("     LEFT JOIN Anagrafe_VincoliAgronomici av ON ip.Piva = av.Piva AND ip.Sa_Cod = av.Sa_Cod AND ip.Appezza = av.Appezza AND ip.Id_Reg = av.Id_Reg AND ip.Progetto_Cod = av.Progetto_Cod ")
                    strSql.AppendLine("                                            AND pua.PUA_Cod = av.Pua_Cod AND pua.Regolamento_Cod = av.Regolamento_Cod ")

                    strSql.AppendLine("     LEFT JOIN Analisi_Testata at ON at.Analisi_Testata_Cod = av.Analisi_Testata_Cod ")
                    strSql.AppendLine("     LEFT JOIN Regolamenti reg ON reg.Reg_Cod = ip.Regolamento_Cod    ")
                    strSql.AppendLine("     LEFT JOIN Campi ca ON a.piva = ca.piva and a.sa_cod = ca.sa_cod and a.Campo_Cod = ca.Campo_Cod")
                    strSql.AppendLine("     Left Join reg_impianti_codici rc on rc.Piva = ip.PIVA And rc.sa_cod = ip.sa_cod And rc.appezza = ip.appezza And rc.Id_Reg = ip.id_reg ")
                    strSql.AppendLine("                 And rc.id_cod >=3000 And rc.id_cod<4000 ")
                    strSql.AppendLine("     Left Join Codici_Anagrafe cod on rc.id_cod=cod.codice ")

                    strSql.AppendLine(" WHERE   1=1 ")

                    'appezzamenti senza specie
                    strSql.AppendLine(" AND   r.cul_cod = 0 ")

                    strSql.AppendLine(" AND   r.Validita_Inizio  <= " & Agro_SQL_SaveDate(Data_Fine) & " ")
                    strSql.AppendLine(" AND   r.Validita_Fine    >= " & Agro_SQL_SaveDate(Data_Inizio) & " ")
                    strSql.AppendLine(" AND   ip.Validita_Inizio  <= " & Agro_SQL_SaveDate(Data_Fine) & " ")
                    strSql.AppendLine(" AND   ip.Validita_Fine    >= " & Agro_SQL_SaveDate(Data_Inizio) & " ")

                    If Piva <> "" Then
                        strSql.AppendLine(" AND     pua.Piva = '" & Agro_SQL_SaveText(Piva) & "'  ")
                    End If

                    If Sa_Cod <> 0 Then
                        strSql.AppendLine("         AND r.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
                    Else
                        'leggo se ci sono filtri sui centri
                        Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                        Dim FiltroCentri As String = ""
                        Dim DtCentriVisibili As DataTable
                        DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                        If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                            For i = 0 To DtCentriVisibili.Rows.Count - 1
                                FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                            Next
                            If FiltroCentri <> "" Then
                                strSql.AppendLine(" AND r.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                            End If
                        End If
                    End If


                    If Pua_Cod <> 0 Then
                        strSql.AppendLine(" AND     pua.Pua_Cod = " & Agro_SQL_SaveNum(Pua_Cod) & "  ")
                    End If

                    If Pua_Regolamento_Cod <> 0 Then
                        strSql.AppendLine(" AND     pua.Regolamento_Cod = " & Agro_SQL_SaveNum(Pua_Regolamento_Cod) & "  ")
                    End If


                    If xFiltroAggiuntivo <> "" Then
                        strSql.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
                    End If

            End Select


            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                strSql.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, strSql.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    Public Function Leggi_Dati_Impianti_IAF(ByVal Piva As String,
                                            ByVal Sa_Cod As String,
                                            ByVal Appezza As Integer,
                                            ByVal Id_Reg As Integer,
                                            ByVal Progetto_cod As Integer,
                                            ByVal Veg_Cod As Integer,
                                            ByVal xFiltroAggiuntivo As String,
                                            ByVal xOrderBy As String,
                                            ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                            ) As DataTable

        Const nomeRoutine = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Dati_Impianti_IAF()"

        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable

        Try

            StrSQL.Length = 0
            StrSQL.AppendLine(" select rag_soc , sa_nome , app_nome, sup_imp ,veg_des , cul_des , isnull(ip.validita_inizio," & Agro_SQL_SaveDate(AGRODATAINIZIO) & ") as validita_inizio, isnull(ip.validita_fine," & Agro_SQL_SaveDate(AGRODATAFINE) & ") as validita_fine,   ")
            StrSQL.AppendLine(" r.validita_inizio as validita_inizio_impianto , r.validita_fine as validita_fine_impianto, ")
            StrSQL.AppendLine(" r.sup_imp, r.grfi_cod, isnull(fin.Grfi_Des,'') as grfi_des, ")
            StrSQL.AppendLine(" a.campo_cod, isnull(ca.campo_Des,'') as campo_Des, ")
            StrSQL.AppendLine(" ip.regolamento_cod, isnull(reg.reg_des,'') as reg_des, ip.disciplinare_cod, ISNULL(DPI_Regolamenti.NomeEsteso,'Nessuno') AS disciplinare_des, ")
            StrSQL.AppendLine(" r.piva, r.sa_cod, r.appezza, r.id_reg, isnull(ip.progetto_cod,0) as progetto_cod, ")
            StrSQL.AppendLine(" isnull(s.veg_cod,0) as veg_cod, isnull(cu.cul_cod,0) as cul_cod, ")

            StrSQL.AppendLine("         ISNULL((SELECT TOP 1 Codici_Anagrafe.descrizione ")
            StrSQL.AppendLine("         FROM    Reg_Impianti_Codici INNER JOIN ")
            StrSQL.AppendLine("                 Codici_Anagrafe ON Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            StrSQL.AppendLine("         WHERE   (Reg_Impianti_Codici.id_cod >= 3000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.id_cod < 4000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.PIVA = r.PIVA) AND ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.sa_cod = r.sa_cod)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.appezza = r.appezza)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.Id_Reg = r.ID_REG)),'')  ")
            StrSQL.AppendLine("         AS  DestinazioneUso, ")

            StrSQL.AppendLine("         ISNULL((SELECT TOP 1 Codici_Anagrafe.codice ")
            StrSQL.AppendLine("         FROM    Reg_Impianti_Codici INNER JOIN ")
            StrSQL.AppendLine("                 Codici_Anagrafe ON Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            StrSQL.AppendLine("         WHERE   (Reg_Impianti_Codici.id_cod >= 3000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.id_cod < 4000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.PIVA = r.PIVA) AND ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.sa_cod = r.sa_cod)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.appezza = r.appezza)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.Id_Reg = r.ID_REG)),0)  ")
            StrSQL.AppendLine("         AS  DestinazioneUsoCodice, ")

            '--- LIMITI APPORTI ---
            StrSQL.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            StrSQL.AppendLine("         FROM   Reg_Impianti_Codici ")
            StrSQL.AppendLine("         WHERE  Piva = ip.PIVA AND sa_cod = ip.sa_cod ")
            StrSQL.AppendLine("         AND appezza = ip.appezza AND Id_Reg = ip.id_reg ")
            StrSQL.AppendLine("         AND Progetto_Cod = ip.Progetto_Cod  ")
            StrSQL.AppendLine("         AND Reg_Impianti_Codici.id_cod= 1296 ")
            StrSQL.AppendLine("         ), '') AS IAF ")

            StrSQL.AppendLine(" from imprese i ")
            StrSQL.AppendLine("     inner join Centri_Aziendali c on c.PIVA = i.PIVA  ")
            StrSQL.AppendLine("     inner join appezzamento a on a.PIVA = i.PIVA and c.sa_cod = a.sa_cod  ")
            StrSQL.AppendLine("     inner join reg_impianti r on r.PIVA = a.PIVA and r.sa_cod = a.sa_cod and r.APPEZZA  = a.APPEZZA ")
            StrSQL.AppendLine("     left join Imprese_Progetti ip on ip.PIVA = r.PIVA and ip.sa_cod = r.sa_cod and ip.APPEZZA  = r.APPEZZA and ip.id_reg = r.ID_REG ")
            StrSQL.AppendLine("     left join cultivar cu on cu.cul_cod = r.cul_cod  ")
            StrSQL.AppendLine("     left join SpecieVegetali s on s.Veg_Cod = cu.veg_cod  ")

            StrSQL.AppendLine("     left join regolamenti reg on reg.Reg_Cod = ip.regolamento_cod    ")
            StrSQL.AppendLine("     left join gruppofinalita fin on fin.Grfi_Cod = r.grfi_cod   ")

            StrSQL.AppendLine("     left join Campi ca ON a.piva = ca.piva and a.sa_cod = ca.sa_cod and a.Campo_Cod = ca.Campo_Cod")

            StrSQL.AppendLine("     left join  DPI_Regolamenti on ip.Disciplinare_Cod=DPI_Regolamenti.COD_REGOLAMENTO AND ip.Disciplinare_PubblicoPrivato=DPI_Regolamenti.Flag_Privato_Pubblico ")


            StrSQL.AppendLine(" WHERE   1=1 ")

            If Piva <> "" Then
                StrSQL.AppendLine(" AND   r.piva = '" & Agro_SQL_SaveText(Piva) & "'  ")
            End If


            If Sa_Cod <> "" AndAlso Sa_Cod <> "0" Then
                StrSQL.AppendLine(" AND r.Sa_Cod IN (" & Agro_SQL_Save_Clausola_IN(Sa_Cod, False) & ") ")
            End If

            If Appezza <> 0 Then
                StrSQL.AppendLine(" AND     r.Appezza = " & Agro_SQL_SaveNum(Appezza) & "  ")
            End If
            If Id_Reg <> 0 Then
                StrSQL.AppendLine(" AND     r.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & "  ")
            End If
            If Progetto_cod <> 0 Then
                StrSQL.AppendLine(" AND     ip.Progetto_cod = " & Agro_SQL_SaveNum(Progetto_cod) & "  ")
            End If


            If Veg_Cod <> 0 Then
                StrSQL.AppendLine("     AND cu.Veg_Cod    = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If


            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    '##############################################################################################
    'passati piu impianti recupera i dati  
    Public Function Leggi_Dati_Impianti_Distinte(
                            ByVal Piva() As String,
                            ByVal Sa_Cod() As Int32,
                            ByVal Appezza() As Int32,
                            ByVal Id_Reg() As Int32,
                                ByVal xFiltroAggiuntivo As String,
                                ByVal xOrderBy As String,
                                ByRef objParametri As AgronicaCoreParametri
                                ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Dati_Impianti_Distinte()"

        '====================================================================================
        'Parametri opzionali :
        '   Sa_Cod = 0           =>  si leggono tutti gli impianti dell'impresa
        '   Appezza = 0          =>  si leggono tutti gli impianti del centro aziendale
        '   Id_reg = 0           =>  si leggono tutti gli impianti dell'appezzamento
        '====================================================================================

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable
        Dim i As Integer
        Dim strFiltroImpianti As New System.Text.StringBuilder

        Try
            If objParametri.PivaSuperUser = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva_Superuser obbligatorio)")
            End If

            If Piva(0) = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva obbligatorio)")
            End If

            If Not (Piva.Length = Sa_Cod.Length AndAlso Sa_Cod.Length = Appezza.Length AndAlso Appezza.Length = Id_Reg.Length) Then
                Throw New Exception("Parametri non corretto nella query (I vettori devono avere stessa lunghezza)")
            End If

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT  Reg_Impianti.Piva,  Reg_Impianti.Sa_Cod, Reg_Impianti.Appezza, Reg_Impianti.Id_Reg, Reg_Impianti.Sup_Imp, ")
            StrSQL.AppendLine("         ISNULL(SpecieVegetali.Veg_Cod,0) AS Veg_Cod,  ")
            StrSQL.AppendLine("         ISNULL(SpecieVegetali.Veg_Des,'') AS Veg_Des,  ")
            StrSQL.AppendLine("         ISNULL(SpecieVegetali.Gru_Cod,0) AS Gru_Cod,  ")
            StrSQL.AppendLine("         ISNULL(GruppoVegetale.Gru_Des,'') AS Gru_Des,  ")
            StrSQL.AppendLine("         ISNULL(Reg_Impianti.Cul_Cod,'') AS Cul_Cod,  ")
            StrSQL.AppendLine("         ISNULL(Cultivar.Cul_Des,'') AS Cul_Des,  ")
            StrSQL.AppendLine("         ISNULL(GruppoVarietale.Grva_Des,'') AS Grva_Des,  ")
            StrSQL.AppendLine("         ISNULL(GruppoFinalita.Grfi_Cod,0) AS Grfi_Cod, ")
            StrSQL.AppendLine("         ISNULL(GruppoFinalita.Grfi_Des,'') AS Grfi_Des, ")
            StrSQL.AppendLine("         Appezzamento.APP_NOME, ")
            StrSQL.AppendLine("         ISNULL ((SELECT     TOP 1 Appezzamento_Codici.val_cod ")
            StrSQL.AppendLine("           FROM Appezzamento_Codici ")
            StrSQL.AppendLine("           WHERE     (Appezzamento_Codici.PIVA = Appezzamento.PIVA) ")
            StrSQL.AppendLine("           AND (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod)  ")
            StrSQL.AppendLine("           AND (Appezzamento_Codici.appezza = Appezzamento.appezza) ")
            StrSQL.AppendLine("           AND (Appezzamento_Codici.id_cod = 1104)), '') AS App_Nome_Breve, ")

            StrSQL.AppendLine("     ISNULL(Appezzamento.DistBZ_CorpiIdrici,0) AS DistBZ_CorpiIdrici, ")
            StrSQL.AppendLine("     ISNULL(Appezzamento.DistBZ_AreeResPub,0) AS DistBZ_AreeResPub,  ")
            StrSQL.AppendLine("     ISNULL(Appezzamento.DistBZ_Allevamenti,0) AS DistBZ_Allevamenti, ")
            StrSQL.AppendLine("     ISNULL(Appezzamento.DistBZ_VegNatNonColt,0) AS DistBZ_VegNatNonColt,  ")
            StrSQL.AppendLine("     ISNULL(Appezzamento.SupBZ_Riduzione,0) AS SupBZ_Riduzione, ")



            StrSQL.AppendLine("         ISNULL(ImpiantiIrrigazioni.Imp_Cod,0) AS Imp_Cod, ")
            StrSQL.AppendLine("         ISNULL(ImpiantiIrrigazioni.Imp_Des,'') AS Imp_Des, ")
            StrSQL.AppendLine("         ISNULL(Copertura.Cop_Cod,0) AS Cop_Cod, ")
            StrSQL.AppendLine("         ISNULL(Copertura.Cop_Des,'') AS Cop_Des, ")
            StrSQL.AppendLine("         ISNULL(FormeAllevamento.FORAL_COD,0) AS FORAL_COD, ")
            StrSQL.AppendLine("         ISNULL(FormeAllevamento.Foral_Des,'') AS Foral_Des, ")

            StrSQL.AppendLine("         Imprese_Progetti.Progetto_Cod, Imprese_Progetti.Progetto_Nome, ")
            StrSQL.AppendLine("         Imprese_Progetti.Stato_Impianto, Imprese_Progetti.Disciplinare_Cod,  ")
            StrSQL.AppendLine("         ISNULL(Imprese_Progetti.Regolamento_Cod, 0) AS Regolamento_Cod, ISNULL(Regolamenti.Reg_Des,'') AS Reg_Des, ")
            StrSQL.AppendLine("         Imprese_Progetti.Validita_inizio AS Validita_inizio_Distinta, Imprese_Progetti.Validita_Fine AS Validita_fine_Distinta, ")
            StrSQL.AppendLine("         Imprese_Progetti.Data_Inizio_Prevista AS Data_Semina_Prevista, Imprese_Progetti.Data_Fine_Prevista AS Data_Raccolta_Prevista, Imprese_Progetti.Data_Fioritura_Prevista, ")

            StrSQL.AppendLine("         ISNULL(Imprese_Progetti.p_ha,0) AS p_ha, ")

            StrSQL.AppendLine("         ISNULL((SELECT TOP 1 Codici_Anagrafe.descrizione ")
            StrSQL.AppendLine("         FROM    Reg_Impianti_Codici INNER JOIN ")
            StrSQL.AppendLine("                 Codici_Anagrafe ON Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            StrSQL.AppendLine("         WHERE   (Reg_Impianti_Codici.id_cod >= 3000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.id_cod < 4000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.PIVA = Reg_Impianti.PIVA) AND ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.sa_cod = Reg_Impianti.sa_cod)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.appezza = Reg_Impianti.appezza)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.Id_Reg = Reg_Impianti.ID_REG)),'')  ")
            StrSQL.AppendLine("         AS  DestinazioneUso, ")

            StrSQL.AppendLine("         ISNULL((SELECT TOP 1 Codici_Anagrafe.codice ")
            StrSQL.AppendLine("         FROM    Reg_Impianti_Codici INNER JOIN ")
            StrSQL.AppendLine("                 Codici_Anagrafe ON Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            StrSQL.AppendLine("         WHERE   (Reg_Impianti_Codici.id_cod >= 3000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.id_cod < 4000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.PIVA = Reg_Impianti.PIVA) AND ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.sa_cod = Reg_Impianti.sa_cod)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.appezza = Reg_Impianti.appezza)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.Id_Reg = Reg_Impianti.ID_REG)),0)  ")
            StrSQL.AppendLine("         AS  DestinazioneUsoCodice, ")

            StrSQL.AppendLine("         ISNULL(Campi.Campo_Cod,0) AS Campo_Cod, ")
            StrSQL.AppendLine("         ISNULL(Campi.Campo_Des,'') AS Campo_Des, ")
            StrSQL.AppendLine("         ISNULL(Centri_Aziendali.sa_nome,'') AS sa_nome ")

            StrSQL.AppendLine(" FROM         Campi RIGHT OUTER JOIN  ")
            StrSQL.AppendLine(" Appezzamento INNER JOIN  ")
            StrSQL.AppendLine(" Reg_Impianti ON Appezzamento.PIVA = Reg_Impianti.PIVA AND Appezzamento.SA_COD = Reg_Impianti.SA_COD AND   ")
            StrSQL.AppendLine(" Appezzamento.APPEZZA = Reg_Impianti.APPEZZA INNER JOIN  ")
            StrSQL.AppendLine(" Imprese_Progetti ON Reg_Impianti.PIVA = Imprese_Progetti.Piva AND Reg_Impianti.SA_COD = Imprese_Progetti.Sa_Cod AND   ")
            StrSQL.AppendLine(" Reg_Impianti.APPEZZA = Imprese_Progetti.Appezza AND Reg_Impianti.ID_REG = Imprese_Progetti.Id_Reg LEFT OUTER JOIN  ")
            StrSQL.AppendLine(" Regolamenti ON Imprese_Progetti.Regolamento_Cod = Regolamenti.Reg_Cod INNER JOIN  ")
            StrSQL.AppendLine(" Centri_Aziendali ON Appezzamento.PIVA = Centri_Aziendali.PIVA AND Appezzamento.SA_COD = Centri_Aziendali.sa_cod ON Campi.Piva = Appezzamento.PIVA AND   ")
            StrSQL.AppendLine(" Campi.Sa_Cod = Appezzamento.SA_COD AND Campi.Campo_Cod = Appezzamento.Campo_Cod LEFT OUTER JOIN  ")
            StrSQL.AppendLine(" FormeAllevamento ON Reg_Impianti.FORAL_COD = FormeAllevamento.Foral_Cod LEFT OUTER JOIN  ")
            StrSQL.AppendLine(" GruppoVarietale ON Reg_Impianti.GRVA_Cod_VEG = GruppoVarietale.Grva_Cod LEFT OUTER JOIN  ")
            StrSQL.AppendLine(" ImpiantiIrrigazioni ON Reg_Impianti.IMP_COD = ImpiantiIrrigazioni.Imp_Cod LEFT OUTER JOIN  ")
            StrSQL.AppendLine(" Copertura ON Reg_Impianti.COP_COD = Copertura.Cop_Cod LEFT OUTER JOIN  ")
            StrSQL.AppendLine(" GruppoFinalita ON Reg_Impianti.GRFI_COD = GruppoFinalita.Grfi_Cod LEFT OUTER JOIN  ")
            StrSQL.AppendLine(" GruppoVegetale INNER JOIN  ")
            StrSQL.AppendLine(" SpecieVegetali INNER JOIN  ")
            StrSQL.AppendLine(" Cultivar ON SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod ON GruppoVegetale.Gru_Cod = SpecieVegetali.Gru_Cod ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod  ")

            StrSQL.AppendLine(" WHERE   (Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & ") ")
            StrSQL.AppendLine(" AND     (Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & ") ")
            StrSQL.AppendLine(" AND     (Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & ") ")
            StrSQL.AppendLine(" AND     (Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & ") ")

            StrSQL.AppendLine(" AND     Reg_Impianti.[User] = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "' ")

            strFiltroImpianti.Length = 0

            For i = 0 To Piva.Length - 1
                strFiltroImpianti.AppendLine(" ( Reg_Impianti.PIVA = '" & Agro_SQL_SaveText(Trim(Piva(i))) & "' ")
                If Sa_Cod(i) <> 0 Then
                    strFiltroImpianti.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod(i)) & "  ")
                End If
                strFiltroImpianti.AppendLine(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(Appezza(i)) & "  ")
                If Id_Reg(i) <> 0 Then
                    strFiltroImpianti.AppendLine(" AND Reg_Impianti.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg(i)) & "   ")
                End If
                strFiltroImpianti.AppendLine(" ) OR ")
            Next

            If strFiltroImpianti.Length > 0 Then

                strFiltroImpianti.Remove(strFiltroImpianti.Length - 5, 5)
                StrSQL.AppendLine(" AND ( ")
                StrSQL.AppendLine(strFiltroImpianti.ToString)
                StrSQL.AppendLine(" ) ")

            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If

            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select

            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

    '######################################################################################
    Public Function NomeAppezzamentoFromRegImpianti(
                                ByVal Piva As String,
