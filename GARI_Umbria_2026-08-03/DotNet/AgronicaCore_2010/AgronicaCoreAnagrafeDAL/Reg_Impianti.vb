            stb.AppendLine("  inner Join Reg_Impianti_Codici KPIN ")
            stb.AppendLine("         On KPIN.PIVA = reg.PIVA ")
            stb.AppendLine("      And KPIN.sa_cod = reg.sa_Cod ")
            stb.AppendLine("      And KPIN.appezza = reg.appezza ")
            stb.AppendLine("      And KPIN.id_reg = reg.id_reg ")
            stb.AppendLine("      And KPIN.id_cod = 1287 ")
            stb.AppendLine("      And KPIN.Progetto_Cod = dist.progetto_Cod ")
            stb.AppendLine("  ")
            stb.AppendLine("  inner Join Reg_Impianti_Codici BLOCKname ")
            stb.AppendLine("         On BLOCKname.PIVA = reg.PIVA ")
            stb.AppendLine("      And BLOCKname.sa_cod = reg.sa_Cod ")
            stb.AppendLine("      And BLOCKname.appezza = reg.appezza ")
            stb.AppendLine("      And BLOCKname.id_reg = reg.id_reg ")
