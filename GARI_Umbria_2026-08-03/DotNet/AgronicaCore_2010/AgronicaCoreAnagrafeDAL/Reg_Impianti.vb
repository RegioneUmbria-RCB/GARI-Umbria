    Public Function SommaProduzione_SPV(ByVal PIVA As String,
                                        ByVal Veg_Cod As Integer,
                                        ByVal Cul_Cod As Integer,
                                        ByVal Validita_Inizio As Date,
                                        ByVal Validita_Fine As Date,
                                        ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                        ByVal Mat_Cod As Integer,
                                        Optional ByVal xFiltroAggiuntivo As String = ""
                                        ) As Decimal

        Dim NomeRoutine As String = "AgronicaCoreAnagrafeDAL.Reg_Impianti.SommaProduzione_SPV()"


        Dim messaggioErrore As String = ""
        Dim strSql As New StringBuilder
        Dim dt As DataTable


        Try
            strSql.Length = 0
            strSql.Append(" SELECT sum(Mov_Destinazioni.Qta/1000) as Produzione_SPV ")
            strSql.Append(" FROM Agenda, Movimenti, Movimenti_Dettagli, Mov_Destinazioni, Reg_Impianti, Imprese_Progetti")
            strSql.Append(" WHERE Mov_Destinazioni.Appezza = Reg_Impianti.Appezza")
            strSql.Append(" and Reg_Impianti.Piva = Agenda.Piva")
            strSql.Append(" and Reg_Impianti.Sa_Cod = Agenda.Sa_Cod")
            strSql.Append(" and Reg_Impianti.Appezza = Mov_Destinazioni.Appezza ")
            strSql.Append(" and Reg_Impianti.Id_Reg = Mov_Destinazioni.Id_Destinazione ")
            strSql.Append(" and Agenda.Id_Agenda = mov_Destinazioni.Id_Agenda")
            strSql.Append(" and Agenda.Id_Agenda = Movimenti.Id_Agenda")
            strSql.Append(" and Movimenti.Id_Mov = Movimenti_Dettagli.Id_Mov")
            strSql.Append(" and Movimenti_Dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det")
            strSql.Append(" and Movimenti.Data_Movimento <= " & Agro_SQL_SaveDate(Validita_Fine) & " ")
            strSql.Append(" and Movimenti.Data_Movimento >= " & Agro_SQL_SaveDate(Validita_Inizio) & " ")
            strSql.AppendLine(" AND   Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Trim(PIVA)) & "'")
            strSql.AppendLine(" AND   Imprese_Progetti.Piva = Reg_Impianti.Piva ")
            strSql.AppendLine(" AND   Imprese_Progetti.Sa_Cod = Reg_Impianti.Sa_Cod ")
            strSql.AppendLine(" AND   Imprese_Progetti.Appezza = Reg_Impianti.Appezza ")
            strSql.AppendLine(" AND   Imprese_Progetti.Id_Reg = Reg_Impianti.Id_Reg ")
            strSql.Append(" AND Mov_destinazioni.Tipo_Destinazione = 0 ")
            strSql.Append(" AND Agenda.Lav_Cod = 125 ")
            strSql.Append(" AND Movimenti.Cau_Mov = '2200' ")
            strSql.Append(" AND Imprese_Progetti.Validita_Fine >= Movimenti.Data_Movimento ")
            strSql.Append(" AND Imprese_Progetti.Validita_Inizio <= Movimenti.Data_Movimento ")

            If Mat_Cod <> 0 Then
                strSql.Append(" and Movimenti_Dettagli.Mat_Cod = " & Mat_Cod & " ")
            End If

            'Controllo Specie Vegetale
            Select Case Veg_Cod
                Case -1000 'Dummy --> Tutti
                Case 0 'Terreno Nudo
                    strSql.AppendLine(" AND Reg_Impianti.Cul_Cod = 0 ")
                Case Else
                    If Cul_Cod = 0 Then
                        'Filtro Veg_Cod
                        strSql.AppendLine(" AND Reg_Impianti.Cul_Cod In (Select Cul_Cod From Cultivar Where Veg_Cod = " & Veg_Cod & ") ")
                    Else
                        'Filtro Cul_Cod
                        strSql.AppendLine(" AND Reg_Impianti.Cul_Cod = " & Cul_Cod & " ")
                    End If
            End Select



            If xFiltroAggiuntivo <> "" Then
                strSql.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If


            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    strSql.Append(" AND   Movimenti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    strSql.Append(" AND   Movimenti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select



            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, strSql.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & messaggioErrore)
        End Try

        If IsDBNull(dt.Rows(0).Item("Produzione_SPV")) Then
            Return 0
        End If
        Return CDbl(dt.Rows(0).Item("Produzione_SPV"))


    End Function

