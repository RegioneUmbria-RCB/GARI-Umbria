                StrSQL.AppendLine("        And AppezzamentiXParticelle.Sezione = Analisi_EntitaxTestata.Sezione And AppezzamentiXParticelle.foglio = Analisi_EntitaxTestata.foglio ")
                StrSQL.AppendLine("        And AppezzamentiXParticelle.numero = Analisi_EntitaxTestata.numero And AppezzamentiXParticelle.subalterno = Analisi_EntitaxTestata.subalterno ),0) As id_ClasseTessitura ")
            Else
