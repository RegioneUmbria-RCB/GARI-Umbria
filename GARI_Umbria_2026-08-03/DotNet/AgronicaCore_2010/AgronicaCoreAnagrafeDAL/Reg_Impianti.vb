                                              ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                              ) As DataTable

        Const nomeRoutine = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_Operazioni_Impianti()"

        '====================================================================================
        'Parametri opzionali :
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim Stb As New StringBuilder
        Dim dt As DataTable

        Try

            Stb.AppendLine(" Select ")
            Stb.AppendLine(" DISTINCT Mov_Destinazioni.Piva, ")
            Stb.AppendLine(" Mov_Destinazioni.Sa_Cod, ")
            Stb.AppendLine(" Mov_Destinazioni.Id_Agenda, ")
            Stb.AppendLine(" Agenda.Lav_Cod, ")
            Stb.AppendLine(" Agenda.des_lib, ")
