                            Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
                    End Select
                    '--------------------------------------------------------------------------
                    If xOrderBy <> "" Then
                        StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
                    Else
                        StrSQL.AppendLine(" ORDER BY Validita_Inizio Desc ")
                    End If



                Case enumSelezioneVariabile.Selezione_TabellaCompleta

                    '---------------------------------------------
                    StrSQL.Length = 0
                    StrSQL.AppendLine(" SELECT * ")
                    StrSQL.AppendLine(" FROM  Reg_Impianti ")

                    StrSQL.AppendLine(" WHERE   Validita_inizio < " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & " ")
                    StrSQL.AppendLine(" AND     Validita_Fine > " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & " ")

                    StrSQL.AppendLine(" AND     Piva = '" & Agro_SQL_SaveText(Piva) & "' ")
                    StrSQL.AppendLine(" AND     [User] = '" & Agro_SQL_SaveText(PivaSuperuser) & "' ")

                    If Not LeggiSuAzienda Then
                        StrSQL.AppendLine(" AND Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
                        StrSQL.AppendLine(" AND Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
                    End If


                    If objParametri.FinestraTemporaleInizio <> New Date AndAlso objParametri.FinestraTemporaleFine <> New Date Then
                        'Escludo gli impianti che non si intersecano con quello di partenza cioè quelli che sono
                        'precedenti e quelli che sono successivi al periodo selezionato
                        StrSQL.AppendLine(" AND  NOT ( (Validita_Inizio < " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio))
                        StrSQL.AppendLine(" AND  Validita_Fine < " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & ") ")
                        StrSQL.AppendLine(" OR  (Validita_Fine > " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine))
                        StrSQL.AppendLine(" AND  Validita_Inizio > " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & ") ) ")
                    End If


                    If Id_Reg <> 0 Then
                        StrSQL.AppendLine(" AND Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & " ")
                    End If



                    If xFiltroAggiuntivo <> "" Then
                        StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
                    End If
                    '--------------------------------------------------------------------------
                    Select Case objParametri.FlagVisibilita
                        Case enumVisibilita.Visibilita_SoloNonCancellati
                            StrSQL.AppendLine(" AND   Inviato >=0 ")
                        Case enumVisibilita.Visibilita_SoloCancellati
                            StrSQL.AppendLine(" AND   Inviato =-1 ")
                        Case enumVisibilita.Visibilita_Tutti
                            '...................................
                        Case Else
                            Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
                    End Select
                    '--------------------------------------------------------------------------
                    If xOrderBy <> "" Then
                        StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
                    Else
                        StrSQL.AppendLine(" ORDER BY Validita_Inizio Desc ")
                    End If


                Case AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_JoinDescrizioni
                    '
                    '---------------------------------------------
                    StrSQL.Length = 0
                    StrSQL.AppendLine(" SELECT * ")
                    StrSQL.AppendLine(" FROM  Reg_Impianti r ")

                    StrSQL.AppendLine(" WHERE   r.Validita_inizio < " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & " ")
                    StrSQL.AppendLine(" AND     r.Validita_Fine > " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & " ")

                    StrSQL.AppendLine(" AND     r.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

                    If Not LeggiSuAzienda Then
                        StrSQL.AppendLine(" AND r.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
                        StrSQL.AppendLine(" AND r.Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
                    End If




                    If objParametri.FinestraTemporaleInizio <> New Date AndAlso objParametri.FinestraTemporaleFine <> New Date Then
                        'Escludo gli impianti che non si intersecano con quello di partenza cioè quelli che sono
                        'precedenti e quelli che sono successivi al periodo selezionato
                        StrSQL.AppendLine(" AND  NOT ( (r.Validita_Inizio < " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio))
                        StrSQL.AppendLine(" AND  r.Validita_Fine < " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & ") ")
                        StrSQL.AppendLine(" OR  (r.Validita_Fine > " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine))
                        StrSQL.AppendLine(" AND  r.Validita_Inizio > " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & ") ) ")
                    End If


                    If Id_Reg <> 0 Then
                        StrSQL.AppendLine(" AND r.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & " ")
                    End If



                    If xFiltroAggiuntivo <> "" Then
                        StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
                    End If
                    '--------------------------------------------------------------------------
                    Select Case objParametri.FlagVisibilita
                        Case enumVisibilita.Visibilita_SoloNonCancellati
                            StrSQL.AppendLine(" AND   r.Inviato >=0 ")
                        Case enumVisibilita.Visibilita_SoloCancellati
                            StrSQL.AppendLine(" AND   r.Inviato =-1 ")
                        Case enumVisibilita.Visibilita_Tutti
                            '...................................
                        Case Else
                            Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
                    End Select
                    '--------------------------------------------------------------------------
                    If xOrderBy <> "" Then
                        StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
                    Else
                        StrSQL.AppendLine(" ORDER BY r.Validita_Inizio Desc ")
                    End If


                Case AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_JoinCompleta
                    '
                    '
                    '
                    '


            End Select



            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try
        Return DT

    End Function

    '##############################################################################################
    'passati piu impianti recupera i dati  
    Public Function Leggi_Dati_Impianti(
                            ByVal Piva() As String,
                            ByVal Sa_Cod() As Int32,
                            ByVal Appezza() As Int32,
                            ByVal Id_Reg() As Int32,
                            ByVal Data_Inizio As Date, ByVal Data_Fine As Date,
                                ByVal xFiltroAggiuntivo As String,
                                ByVal xOrderBy As String,
                                ByRef objParametri As AgronicaCoreParametri
                                ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Dati_Impianti()"

        '====================================================================================
        'Parametri opzionali :
        '   Sa_Cod = 0           =>  si leggono tutti gli impianti dell'impresa
        '   Appezza = 0          =>  si leggono tutti gli impianti del centro aziendale
        '   Id_reg = 0           =>  si leggono tutti gli impianti dell'appezzamento
        '====================================================================================

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable
        Dim i As Integer
        Dim strFiltroImpianti As New System.Text.StringBuilder

        Try
            If objParametri.PivaSuperUser = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva_Superuser obbligatorio)")
            End If

            If Piva(0) = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva obbligatorio)")
            End If

            If Not (Piva.Length = Sa_Cod.Length AndAlso Sa_Cod.Length = Appezza.Length AndAlso Appezza.Length = Id_Reg.Length) Then
                Throw New Exception("Parametri non corretto nella query (I vettori devono avere stessa lunghezza)")
            End If

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT  Reg_Impianti.Piva,  Reg_Impianti.Sa_Cod, Reg_Impianti.Appezza, Reg_Impianti.Id_Reg, Reg_Impianti.Sup_Imp, ")
            StrSQL.AppendLine("         ISNULL(SpecieVegetali.Veg_Cod,0) AS Veg_Cod,  ")
            StrSQL.AppendLine("         ISNULL(SpecieVegetali.Veg_Des,'') AS Veg_Des,  ")
            StrSQL.AppendLine("         ISNULL(SpecieVegetali.Gru_Cod,0) AS Gru_Cod,  ")
            StrSQL.AppendLine("         ISNULL(GruppoVegetale.Gru_Des,'') AS Gru_Des,  ")
            StrSQL.AppendLine("         ISNULL(Reg_Impianti.Cul_Cod,'') AS Cul_Cod,  ")
            StrSQL.AppendLine("         ISNULL(Cultivar.Cul_Des,'') AS Cul_Des,  ")
            StrSQL.AppendLine("         ISNULL(GruppoVarietale.Grva_Des,'') AS Grva_Des,  ")
            StrSQL.AppendLine("         ISNULL(GruppoFinalita.Grfi_Cod,0) AS Grfi_Cod, ")
            StrSQL.AppendLine("         ISNULL(GruppoFinalita.Grfi_Des,'') AS Grfi_Des, ")
            StrSQL.AppendLine("         Appezzamento.APP_NOME, ")
            StrSQL.AppendLine(" ISNULL ((SELECT     TOP 1 Appezzamento_Codici.val_cod ")
            StrSQL.AppendLine("           FROM Appezzamento_Codici ")
            StrSQL.AppendLine("           WHERE     (Appezzamento_Codici.PIVA = Appezzamento.PIVA) ")
            StrSQL.AppendLine("           AND (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod)  ")
            StrSQL.AppendLine("           AND (Appezzamento_Codici.appezza = Appezzamento.appezza) ")
            StrSQL.AppendLine("           AND (Appezzamento_Codici.id_cod = 1104)), '') AS App_Nome_Breve, ")
            StrSQL.AppendLine("         ISNULL(ImpiantiIrrigazioni.Imp_Cod,0) AS Imp_Cod, ")
            StrSQL.AppendLine("         ISNULL(ImpiantiIrrigazioni.Imp_Des,'') AS Imp_Des, ")
            StrSQL.AppendLine("         ISNULL(Copertura.Cop_Cod,0) AS Cop_Cod, ")
            StrSQL.AppendLine("         ISNULL(Copertura.Cop_Des,'') AS Cop_Des, ")
            StrSQL.AppendLine("         ISNULL(Centri_Aziendali.sa_nome,'') AS sa_nome, ")
            StrSQL.AppendLine("         ISNULL(Campi.Campo_Des,'') AS Campo_Des ")

            '(12/11/2018 fede) aggiunta lettura fase corrente
            StrSQL.AppendLine("    , ISNULL  ((SELECT    TOP 1 Mov_Dettaglio_Tecnico.ff_classe   ")
            StrSQL.AppendLine("         FROM         Movimenti_dettagli INNER JOIN  ")
            StrSQL.AppendLine("                 Movimenti INNER JOIN  ")
            StrSQL.AppendLine("                 Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND Movimenti.Id_Agenda = Agenda.Id_Agenda ON   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.PIVA = Movimenti.PIVA AND Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod AND   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda AND Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov INNER JOIN  ")
            StrSQL.AppendLine("                 Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda And Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov And  ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det  ")
            StrSQL.AppendLine("                 INNER Join ")
            StrSQL.AppendLine("                   Mov_Dettaglio_Tecnico ON Movimenti_dettagli.PIVA = Mov_Dettaglio_Tecnico.Piva AND Movimenti_dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det AND Movimenti_dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov AND Movimenti_dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda AND Movimenti_dettagli.Sa_Cod = Mov_Dettaglio_Tecnico.Sa_Cod  ")
            StrSQL.AppendLine("         WHERE   (Agenda.Lav_Cod = 79) AND (Movimenti.Cau_Mov = '2100') AND (Mov_Destinazioni.PIVA = Reg_Impianti.PIVA) AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.Sa_Cod = Reg_Impianti.sa_cod AND Mov_Destinazioni.APPEZZA = Reg_Impianti.APPEZZA AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.ID_destinazione = Reg_Impianti.ID_REG   ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento >= Imprese_Progetti.Validita_Inizio  ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento <= Imprese_Progetti.Validita_Fine  ")
            StrSQL.AppendLine("                 AND Mov_Destinazioni.validita_inizio <= " & Agro_SQL_SaveDate(Data_Inizio) & " ")
            StrSQL.AppendLine("         ORDER BY Mov_Destinazioni.validita_inizio desc), '') AS Fase_Cod_Corrente, ")

            StrSQL.AppendLine("     ISNULL  ((SELECT    TOP 1 CONVERT(VARCHAR,Mov_Destinazioni.Validita_Inizio, 103)   ")
            StrSQL.AppendLine("         FROM         Movimenti_dettagli INNER JOIN  ")
            StrSQL.AppendLine("                 Movimenti INNER JOIN  ")
            StrSQL.AppendLine("                 Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND Movimenti.Id_Agenda = Agenda.Id_Agenda ON   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.PIVA = Movimenti.PIVA AND Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod AND   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda AND Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov INNER JOIN  ")
            StrSQL.AppendLine("                 Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda And Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov And  ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det  ")
            StrSQL.AppendLine("                 INNER Join ")
            StrSQL.AppendLine("                   Mov_Dettaglio_Tecnico ON Movimenti_dettagli.PIVA = Mov_Dettaglio_Tecnico.Piva AND Movimenti_dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det AND Movimenti_dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov AND Movimenti_dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda AND Movimenti_dettagli.Sa_Cod = Mov_Dettaglio_Tecnico.Sa_Cod  ")
            StrSQL.AppendLine("         WHERE   (Agenda.Lav_Cod = 79) AND (Movimenti.Cau_Mov = '2100') AND (Mov_Destinazioni.PIVA = Reg_Impianti.PIVA) AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.Sa_Cod = Reg_Impianti.sa_cod AND Mov_Destinazioni.APPEZZA = Reg_Impianti.APPEZZA AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.ID_destinazione = Reg_Impianti.ID_REG   ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento >= Imprese_Progetti.Validita_Inizio  ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento <= Imprese_Progetti.Validita_Fine  ")
            StrSQL.AppendLine("                 AND Mov_Destinazioni.validita_inizio <= " & Agro_SQL_SaveDate(Data_Inizio) & " ")
            StrSQL.AppendLine("         ORDER BY Mov_Destinazioni.validita_inizio desc), '') AS Data_Fase_Corrente ")




            StrSQL.AppendLine(" FROM    GruppoFinalita RIGHT OUTER JOIN ")
            StrSQL.AppendLine("         Appezzamento INNER JOIN ")
            StrSQL.AppendLine("         Reg_Impianti ON Appezzamento.PIVA = Reg_Impianti.PIVA AND Appezzamento.SA_COD = Reg_Impianti.SA_COD AND ")
            StrSQL.AppendLine("         Appezzamento.APPEZZA = Reg_Impianti.APPEZZA INNER JOIN ")

            StrSQL.AppendLine("         Imprese_Progetti ON Imprese_Progetti.PIVA = Reg_Impianti.PIVA AND Imprese_Progetti.SA_COD = Reg_Impianti.SA_COD AND ")
            StrSQL.AppendLine("         Imprese_Progetti.APPEZZA = Reg_Impianti.APPEZZA AND Imprese_Progetti.id_reg = Reg_Impianti.id_reg INNER JOIN ")

            StrSQL.AppendLine("         Centri_Aziendali ON Appezzamento.PIVA = Centri_Aziendali.PIVA AND Appezzamento.SA_COD = Centri_Aziendali.sa_cod LEFT OUTER JOIN ")
            StrSQL.AppendLine("         Campi ON Appezzamento.PIVA = Campi.Piva AND Appezzamento.SA_COD = Campi.Sa_Cod AND Appezzamento.Campo_Cod = Campi.Campo_Cod LEFT OUTER JOIN ")

            StrSQL.AppendLine("         GruppoVarietale ON Reg_Impianti.GRVA_Cod_VEG = GruppoVarietale.Grva_Cod LEFT OUTER JOIN ")
            StrSQL.AppendLine("         ImpiantiIrrigazioni ON Reg_Impianti.IMP_COD = ImpiantiIrrigazioni.Imp_Cod LEFT OUTER JOIN ")
            StrSQL.AppendLine("         Copertura ON Reg_Impianti.COP_COD = Copertura.Cop_Cod ON GruppoFinalita.Grfi_Cod = Reg_Impianti.GRFI_COD LEFT OUTER JOIN ")
            StrSQL.AppendLine("         GruppoVegetale INNER JOIN ")
            StrSQL.AppendLine("         SpecieVegetali INNER JOIN ")
            StrSQL.AppendLine("         Cultivar ON SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod ON GruppoVegetale.Gru_Cod = SpecieVegetali.Gru_Cod ON  ")
            StrSQL.AppendLine("         Reg_Impianti.CUL_COD = Cultivar.Cul_Cod  ")

            StrSQL.AppendLine(" WHERE   (Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(Data_Fine) & ") ")
            StrSQL.AppendLine(" AND     (Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(Data_Inizio) & ") ")
            StrSQL.AppendLine(" AND   (Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(Data_Fine) & ") ")
            StrSQL.AppendLine(" AND     (Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(Data_Inizio) & ") ")

            StrSQL.AppendLine(" AND     Reg_Impianti.[User] = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "' ")

            strFiltroImpianti.Length = 0

            For i = 0 To Piva.Length - 1
                strFiltroImpianti.AppendLine(" ( Reg_Impianti.PIVA = '" & Agro_SQL_SaveText(Trim(Piva(i))) & "' ")
                strFiltroImpianti.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod(i)) & "  ")
                strFiltroImpianti.AppendLine(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(Appezza(i)) & "  ")
                strFiltroImpianti.AppendLine(" AND Reg_Impianti.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg(i)) & " )  ")
                strFiltroImpianti.AppendLine(" OR ")
            Next

            If strFiltroImpianti.Length > 0 Then

                strFiltroImpianti.Remove(strFiltroImpianti.Length - 5, 5)
                StrSQL.AppendLine(" AND ( ")
                StrSQL.AppendLine(strFiltroImpianti.ToString)
                StrSQL.AppendLine(" ) ")

            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

    '##############################################################################################
    'passati piu impianti recupera i dati  
    Public Function Leggi_Dati_Impianti_piu_distinta(ByVal Piva As String,
                                                     ByVal Sa_Cod As Integer,
                                                     ByVal Appezza As Integer,
                                                     ByVal Id_Reg As Integer,
                                                     ByVal Progetto_cod As Integer,
                                                     ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                                     ) As DataTable

        Const nomeRoutine = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Dati_Impianti_piu_distinta()"

        '====================================================================================
        'Parametri opzionali :
        '   Sa_Cod = 0           =>  si leggono tutti gli impianti dell'impresa
        '   Appezza = 0          =>  si leggono tutti gli impianti del centro aziendale
        '   Id_reg = 0           =>  si leggono tutti gli impianti dell'appezzamento
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable

        Try

            StrSQL.Length = 0
            StrSQL.AppendLine(" select rag_soc , sa_nome , app_nome, sup_imp ,isnull(veg_des,'') AS veg_des , isnull(cul_des,'') as cul_des , ip.validita_inizio  , ip.validita_fine,   ")
            StrSQL.AppendLine(" r.validita_inizio as validita_inizio_impianto , r.validita_fine as validita_fine_impianto, ")
            StrSQL.AppendLine(" r.grfi_cod, isnull(fin.Grfi_Des,'') as grfi_des, ")
            StrSQL.AppendLine(" a.campo_cod, isnull(ca.campo_Des,'') as campo_Des, ")
            StrSQL.AppendLine(" ip.regolamento_cod, isnull(reg.reg_des,'') as reg_des ")

            StrSQL.AppendLine("  ,       ISNULL((SELECT TOP 1 Codici_Anagrafe.descrizione ")
            StrSQL.AppendLine("         FROM    Reg_Impianti_Codici INNER JOIN ")
            StrSQL.AppendLine("                 Codici_Anagrafe ON Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            StrSQL.AppendLine("         WHERE   (Reg_Impianti_Codici.id_cod >= 3000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.id_cod < 4000) AND  ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.PIVA = r.PIVA) AND ")
            StrSQL.AppendLine("                 (Reg_Impianti_Codici.sa_cod = r.sa_cod)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.appezza = r.appezza)  ")
            StrSQL.AppendLine("         AND     (Reg_Impianti_Codici.Id_Reg = r.ID_REG)),'')  ")
            StrSQL.AppendLine("         AS  DestinazioneUso ")

            StrSQL.AppendLine(" from imprese i ")
            StrSQL.AppendLine("     inner join Centri_Aziendali c on c.PIVA = i.PIVA  ")
            StrSQL.AppendLine("     inner join appezzamento a on a.PIVA = i.PIVA and c.sa_cod = a.sa_cod  ")
            StrSQL.AppendLine("     inner join reg_impianti r on r.PIVA = a.PIVA and r.sa_cod = a.sa_cod and r.APPEZZA  = a.APPEZZA ")
            StrSQL.AppendLine("     inner join Imprese_Progetti ip on ip.PIVA = r.PIVA and ip.sa_cod = r.sa_cod and ip.APPEZZA  = r.APPEZZA and ip.id_reg = r.ID_REG ")
            StrSQL.AppendLine("     left join cultivar cu on cu.cul_cod = r.cul_cod  ")
            StrSQL.AppendLine("     left join SpecieVegetali s on s.Veg_Cod = cu.veg_cod  ")

            StrSQL.AppendLine("     left join regolamenti reg on reg.Reg_Cod = ip.regolamento_cod    ")
            StrSQL.AppendLine("     left join gruppofinalita fin on fin.Grfi_Cod = r.grfi_cod   ")

            StrSQL.AppendLine("     left join Campi ca ON a.piva = ca.piva and a.sa_cod = ca.sa_cod and a.Campo_Cod = ca.Campo_Cod")

            StrSQL.AppendLine(" WHERE   r.piva = '" & Agro_SQL_SaveText(Piva) & "'  ")
            StrSQL.AppendLine(" AND     r.sa_cod = " & Agro_SQL_SaveNum(Sa_Cod) & "  ")
            StrSQL.AppendLine(" AND     r.Appezza = " & Agro_SQL_SaveNum(Appezza) & "  ")
            StrSQL.AppendLine(" AND     r.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & "  ")
