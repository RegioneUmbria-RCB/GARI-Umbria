    Public Function RiepilogoSuperficiMultiazienda(
                                ByVal ListPiva() As String,
                                ByVal ListSa_cod() As Int32,
                                ByVal ListAppezza() As Int32,
                                ByVal ListId_reg() As Int32,
                                ByVal GroupParam() As Boolean,
                                ByVal dataValiditaProgetto As Date,
                                    ByVal xFiltroAggiuntivo As String,
                                    ByVal xOrderBy As String,
                                    ByRef objParametri As AgronicaCoreParametri
                                    ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.riepilogoSuperficiMultiazienda()"

        If ((ListPiva.Length <> ListSa_cod.Length) AndAlso (ListSa_cod.Length <> ListAppezza.Length) AndAlso (ListAppezza.Length <> ListId_reg.Length)) Then
            Throw New Exception("Parametri ListPiva, ListSa_cod, ListAppezza, ListId_reg non corretti ")
        End If

        '-------------------------------STRINGA OR----------------------------------------------------
        'costruisco la stringa per la selezione delle chiavi selezionate
        'Dim imax As Integer = Math.Min(Math.Min(ListPiva.Length, ListSa_cod.Length), Math.Min(ListAppezza.Length, ListId_reg.Length)) -1
        Dim imax = ListPiva.Length - 1
        Dim i As Integer = 0
        Dim StrSQLOrID As New StringBuilder
        StrSQLOrID.Length = 0
        For i = 0 To imax
            If i = 0 Then
                StrSQLOrID.AppendLine(" (  ( ")
            Else
                StrSQLOrID.AppendLine(" OR ( ")
            End If
            StrSQLOrID.AppendLine(" Reg_Impianti.PIVA = '" & Agro_SQL_SaveText(Trim(ListPiva(i))) & "' ")
            StrSQLOrID.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(ListSa_cod(i)) & "  ")
            StrSQLOrID.AppendLine(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(ListAppezza(i)) & "  ")
            StrSQLOrID.AppendLine(" AND Reg_Impianti.Id_Reg = " & Agro_SQL_SaveNum(ListId_reg(i)) & "  ")
            StrSQLOrID.AppendLine(" ) ")
            If i = imax Then
                StrSQLOrID.AppendLine(" ) ")
            End If
        Next

        '---------------------------------------------------------------------------------------------


        '-------------------------------STRINGA Select----------------------------------------------------

        Dim StrSQLSelect As New StringBuilder
        StrSQLSelect.Length = 0

        If GroupParam(0) Then
            StrSQLSelect.AppendLine(" Reg_Impianti.PIVA as Partita_IVA , ")
            StrSQLSelect.AppendLine(" CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Reg_Impianti.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale, ")
        End If

        If GroupParam(1) Then
            StrSQLSelect.AppendLine(" Imprese.rag_soc as RagioneSociale , ")
        End If

        If GroupParam(2) Then
            StrSQLSelect.AppendLine(" Centri_Aziendali.sa_nome as CentroAziendale , ")
        End If

        If GroupParam(3) Then
            'StrSQLSelect.AppendLine("    ISNULL(SpecieVegetali.Veg_Cod,0) AS Veg_Cod , ")
            StrSQLSelect.AppendLine(" ISNULL(SpecieVegetali.Veg_Des,'') AS Specie , ")
        End If

        If GroupParam(4) Then
            'StrSQLSelect.AppendLine("    ISNULL(Cultivar.Cul_Cod,'0') AS Cul_Cod , ")
            StrSQLSelect.AppendLine(" ISNULL(Cultivar.Cul_Des,'') AS Varieta , ")
        End If

        If GroupParam(5) Then
            StrSQLSelect.AppendLine(" sum(Reg_Impianti.Sup_Imp) as Superficie , ")
            'StrSQLSelect.AppendLine("    sum(Reg_Impianti.P_HA) as Piante , ")
        End If

        If GroupParam(6) Then
            StrSQLSelect.AppendLine(" ISNULL( sum(Reg_Impianti.Sup_Imp * Imprese_Progetti.P_HA),'') as NumeroPiante , ")
        End If

        If GroupParam(7) Then
            StrSQLSelect.AppendLine(" ISNULL(Copertura.Cop_Des, '') AS Copertura , ")
        End If

        If GroupParam(8) Then
            StrSQLSelect.AppendLine(" ISNULL(GruppoFinalita.Grfi_Des, '') AS Finalita , ")
        End If

        '---------------------------------------------------------------------------------------------


        '-------------------------------STRINGA Group By----------------------------------------------------
        Dim StrSQLGroupBy As New StringBuilder
        StrSQLGroupBy.Length = 0
        If GroupParam(0) Then
            If StrSQLGroupBy.Length <> 0 Then
                StrSQLGroupBy.AppendLine(" , ")
            Else
                StrSQLGroupBy.AppendLine("  GROUP BY  ")
            End If
            StrSQLGroupBy.AppendLine(" Reg_Impianti.PIVA  ")
        End If
        If GroupParam(0) Then
            If StrSQLGroupBy.Length <> 0 Then
                StrSQLGroupBy.AppendLine(" , ")
            Else
                StrSQLGroupBy.AppendLine("  GROUP BY  ")
            End If
            StrSQLGroupBy.AppendLine(" Imprese.partitaIvaReale  ")
        End If
        If GroupParam(1) Then
            If StrSQLGroupBy.Length <> 0 Then
                StrSQLGroupBy.AppendLine(" , ")
            Else
                StrSQLGroupBy.AppendLine("  GROUP BY  ")
            End If
            StrSQLGroupBy.AppendLine(" Imprese.rag_soc ")
        End If
        If GroupParam(2) Then
            If StrSQLGroupBy.Length <> 0 Then
                StrSQLGroupBy.AppendLine(" , ")
            Else
                StrSQLGroupBy.AppendLine("  GROUP BY  ")
            End If
            StrSQLGroupBy.AppendLine(" Centri_Aziendali.sa_nome ")
        End If
        If GroupParam(3) Then
            If StrSQLGroupBy.Length <> 0 Then
                StrSQLGroupBy.AppendLine(" , ")
            Else
                StrSQLGroupBy.AppendLine("  GROUP BY  ")
            End If
            StrSQLGroupBy.AppendLine(" SpecieVegetali.Veg_Des ")
        End If
        If GroupParam(4) Then
            If StrSQLGroupBy.Length <> 0 Then
                StrSQLGroupBy.AppendLine(" , ")
            Else
                StrSQLGroupBy.AppendLine("  GROUP BY  ")
            End If
            StrSQLGroupBy.AppendLine(" Cultivar.Cul_Des  ")
        End If
        If GroupParam(5) Then

        End If
        If GroupParam(6) Then

        End If

        If GroupParam(7) Then
            If StrSQLGroupBy.Length <> 0 Then
                StrSQLGroupBy.AppendLine(" , ")
            Else
                StrSQLGroupBy.AppendLine("  GROUP BY  ")
            End If
            StrSQLGroupBy.AppendLine(" Copertura.Cop_Des  ")
        End If

        If GroupParam(8) Then
            If StrSQLGroupBy.Length <> 0 Then
                StrSQLGroupBy.AppendLine(" , ")
            Else
                StrSQLGroupBy.AppendLine("  GROUP BY  ")
            End If
            StrSQLGroupBy.AppendLine(" GruppoFinalita.Grfi_Des  ")
        End If

        '---------------------------------------------------------------------------------------------


        '-------------------------------STRINGA Order By----------------------------------------------------
        Dim StrSQLOrderBy As New StringBuilder
        StrSQLOrderBy.Length = 0

        If GroupParam(1) Then
            If StrSQLOrderBy.Length <> 0 Then
                StrSQLOrderBy.AppendLine(" , ")
            Else
                StrSQLOrderBy.AppendLine(" ORDER BY  ")
            End If
            StrSQLOrderBy.AppendLine(" Imprese.rag_soc  ")
        End If
        If GroupParam(0) Then
            If StrSQLOrderBy.Length <> 0 Then
                StrSQLOrderBy.AppendLine(" , ")
            Else
                StrSQLOrderBy.AppendLine(" ORDER BY  ")
            End If
            StrSQLOrderBy.AppendLine(" Reg_Impianti.PIVA  ")
        End If
        If GroupParam(2) Then
            If StrSQLOrderBy.Length <> 0 Then
                StrSQLOrderBy.AppendLine(" , ")
            Else
                StrSQLOrderBy.AppendLine(" ORDER BY  ")
            End If
            StrSQLOrderBy.AppendLine(" Centri_Aziendali.sa_nome  ")
        End If
        If GroupParam(3) Then
            If StrSQLOrderBy.Length <> 0 Then
                StrSQLOrderBy.AppendLine(" , ")
            Else
                StrSQLOrderBy.AppendLine(" ORDER BY  ")
            End If
            StrSQLOrderBy.AppendLine(" SpecieVegetali.Veg_Des  ")
        End If
        If GroupParam(4) Then
            If StrSQLOrderBy.Length <> 0 Then
                StrSQLOrderBy.AppendLine(" , ")
            Else
                StrSQLOrderBy.AppendLine(" ORDER BY  ")
            End If
            StrSQLOrderBy.AppendLine(" Cultivar.Cul_Des  ")
        End If
        If GroupParam(5) Then
            If StrSQLOrderBy.Length <> 0 Then
                StrSQLOrderBy.AppendLine(" , ")
            Else
                StrSQLOrderBy.AppendLine(" ORDER BY  ")
            End If
            StrSQLOrderBy.AppendLine("  Superficie  ")
        End If
        If GroupParam(6) Then
            If StrSQLOrderBy.Length <> 0 Then
                StrSQLOrderBy.AppendLine(" , ")
            Else
                StrSQLOrderBy.AppendLine(" ORDER BY  ")
            End If
            StrSQLOrderBy.AppendLine("  NumeroPiante  ")
        End If
        If GroupParam(7) Then
            If StrSQLOrderBy.Length <> 0 Then
                StrSQLOrderBy.AppendLine(" , ")
            Else
                StrSQLOrderBy.AppendLine(" ORDER BY  ")
            End If
            StrSQLOrderBy.AppendLine("  Copertura  ")
        End If
        If GroupParam(8) Then

        End If
        '---------------------------------------------------------------------------------------------




        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable

        Try


            'SELECT     Imprese.rag_soc AS RagioneSociale, Centri_Aziendali.sa_nome AS CentroAziendale, ISNULL(SpecieVegetali.Veg_Des, '') AS Specie, 
            '                      ISNULL(Cultivar.Cul_Des, '') AS Varietà, SUM(Reg_Impianti.Sup_Imp) AS Superficie, ISNULL(SUM(Reg_Impianti.Sup_Imp * 'Imprese_Progetti.P_HA), 0) 
            '                      AS NumeroPiante, ISNULL(Copertura.Cop_Des, '') AS Copertura
            'FROM         Reg_Impianti INNER JOIN
            '                      Imprese ON Reg_Impianti.PIVA = Imprese.PIVA INNER JOIN
            '                      Centri_Aziendali ON Reg_Impianti.PIVA = Centri_Aziendali.PIVA AND Reg_Impianti.SA_COD = Centri_Aziendali.sa_cod LEFT OUTER JOIN
            '                      Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod INNER JOIN
            '                      SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod LEFT OUTER JOIN
            '                      Copertura ON Reg_Impianti.COP_COD = Copertura.Cop_Cod LEFT OUTER JOIN
            '                      Imprese_Progetti ON Reg_Impianti.ID_REG = Imprese_Progetti.Id_Reg AND Reg_Impianti.PIVA = Imprese_Progetti.Piva AND 
            '                      Reg_Impianti.APPEZZA = Imprese_Progetti.Appezza AND Reg_Impianti.SA_COD = Imprese_Progetti.Sa_Cod
            'WHERE Imprese_Progetti.Validita_Inizio<getdate() AND Imprese_Progetti.Validita_Fine>getdate()
            'GROUP BY Reg_Impianti.PIVA, Reg_Impianti.SA_COD, Imprese.rag_soc, Centri_Aziendali.sa_nome, SpecieVegetali.Veg_Cod, SpecieVegetali.Veg_Des, 
            '                      Cultivar.Cul_Cod, Cultivar.Cul_Des, Copertura.Cop_Des
            'ORDER BY RagioneSociale, CentroAziendale


            If objParametri.PivaSuperUser = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva_Superuser obbligatorio)")
            End If


            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT ")

            StrSQL.AppendLine(StrSQLSelect.ToString)

            StrSQL.AppendLine(" count(*) as Numero_Appezzamenti ")

            StrSQL.AppendLine(" FROM    Reg_Impianti ")
            StrSQL.AppendLine("         INNER JOIN ")
            StrSQL.AppendLine("             Imprese ON Reg_Impianti.PIVA = Imprese.PIVA ")
            StrSQL.AppendLine("         INNER JOIN ")
            StrSQL.AppendLine("             Centri_Aziendali ON Reg_Impianti.PIVA = Centri_Aziendali.PIVA AND Reg_Impianti.SA_COD = Centri_Aziendali.sa_cod  ")
            StrSQL.AppendLine("         LEFT OUTER JOIN ")
            StrSQL.AppendLine("             Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod ")
            StrSQL.AppendLine("         INNER JOIN ")
            StrSQL.AppendLine("             SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod ")
            StrSQL.AppendLine("         LEFT OUTER JOIN ")
            StrSQL.AppendLine("             GruppoFinalita ON Reg_Impianti.Grfi_Cod = GruppoFinalita.Grfi_Cod ")
            StrSQL.AppendLine("         LEFT OUTER JOIN ")
            StrSQL.AppendLine("             Copertura ON Reg_Impianti.COP_COD = Copertura.Cop_Cod ")
            StrSQL.AppendLine("         LEFT OUTER JOIN ")
            StrSQL.AppendLine("             Imprese_Progetti ON Reg_Impianti.ID_REG = Imprese_Progetti.Id_Reg AND Reg_Impianti.PIVA = Imprese_Progetti.Piva AND ")
            StrSQL.AppendLine("             Reg_Impianti.APPEZZA = Imprese_Progetti.Appezza AND Reg_Impianti.SA_COD = Imprese_Progetti.Sa_Cod ")



            StrSQL.AppendLine(" WHERE   (Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(dataValiditaProgetto) & ") ")
            StrSQL.AppendLine(" AND     (Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(dataValiditaProgetto) & ") ")

            'modifica 30 05 13 raddoppiava le superfici degli impianti con due progetti
            'metteva una riga per ciscun progetto
            StrSQL.AppendLine(" AND   (Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(dataValiditaProgetto) & ") ")
            StrSQL.AppendLine(" AND     (Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(dataValiditaProgetto) & ") ")

            If GroupParam(7) Then
                StrSQL.AppendLine(" AND ( Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(dataValiditaProgetto) & ")   ")
                StrSQL.AppendLine(" AND ( Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(dataValiditaProgetto) & ")   ")
            End If

            StrSQL.AppendLine(" AND     Reg_Impianti.[User] = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "' ")

            'filtro per impianti selezionati
            If StrSQLOrID.Length <> 0 Then
                StrSQL.AppendLine(" AND " & StrSQLOrID.ToString)
            Else
                'tutti gli impianti
                'non devo passare piu di 4000 record altrimenti StrSQLOrID troppo lunga e va in overflow il server
            End If





            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If

            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------

            StrSQL.AppendLine(StrSQLGroupBy.ToString)

            '----------------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            Else
                StrSQL.AppendLine(StrSQLOrderBy.ToString)
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try
        Return DT

    End Function

