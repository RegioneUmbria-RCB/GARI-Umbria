            StrSQL.AppendLine("         ISNULL(rcod_interbrina.val_cod,'') AS Interbina, ISNULL(rcod_germinabilita.val_cod,'') AS Germinabilita, ")
            StrSQL.AppendLine("         Imprese_Progetti.progetto_cod, Imprese_Progetti.progetto_Nome, Imprese_Progetti.regolamento_cod, Imprese_Progetti.disciplinare_cod, Imprese_Progetti.Disciplinare_PubblicoPrivato, Imprese_Progetti.p_ha,  Imprese_Progetti.validita_inizio as validita_inizio_distinta, Imprese_Progetti.validita_fine as validita_fine_distinta,")
            StrSQL.AppendLine("         ISNULL(( SELECT TOP 1 1  ")
            StrSQL.AppendLine("                     From mov_destinazioni md  ")
            StrSQL.AppendLine("                     INNER Join agenda a ")
            StrSQL.AppendLine("                     On a.PIVA=md.Piva ")
            StrSQL.AppendLine("                     And a.Id_Agenda=md.Id_Agenda ")
            StrSQL.AppendLine("                     WHERE Reg_Impianti.PIVA = md.Piva ")
            StrSQL.AppendLine("                     And Reg_Impianti.SA_COD=md.Sa_Cod ")
            StrSQL.AppendLine("                     And Reg_Impianti.APPEZZA=md.Appezza ")
            StrSQL.AppendLine("                     And Reg_Impianti.ID_REG=md.Id_Destinazione ")
            StrSQL.AppendLine("                     And (Lav_Cod = " & LAVCOD_SEMINA & " Or lav_cod=" & LAVCOD_TRAPIANTO & " Or Lav_Cod=" & LAVCOD_SOVESCIO & " Or Lav_Cod=" & LAVCOD_TRAPIANTO_IN_SERRA & " Or Lav_Cod=" & LAVCOD_SOD_SEDDING & ")) , 0 ")
            StrSQL.AppendLine("          ) AS esisteSeminaTrapianto  ")

            StrSQL.AppendLine(" FROM   ")
            StrSQL.AppendLine("     Appezzamento ")

            StrSQL.AppendLine("     INNER JOIN ")
            StrSQL.AppendLine("         Reg_Impianti ON ")
            StrSQL.AppendLine("             Reg_Impianti.PIVA = Appezzamento.PIVA AND  ")
            StrSQL.AppendLine("             Reg_Impianti.SA_COD = Appezzamento.SA_COD AND ")
            StrSQL.AppendLine("             Reg_Impianti.APPEZZA = Appezzamento.APPEZZA ")

            StrSQL.AppendLine("     INNER JOIN Centri_Aziendali ")
            StrSQL.AppendLine("             ON Centri_Aziendali.Piva = Appezzamento.Piva AND Centri_Aziendali.Sa_Cod = Appezzamento.Sa_Cod")

            StrSQL.AppendLine("     INNER JOIN Imprese ")
            StrSQL.AppendLine("            ON Appezzamento.Piva = Imprese.Piva")

            StrSQL.AppendLine("     INNER JOIN ")
            StrSQL.AppendLine("         GruppoFinalita ON Reg_Impianti.GRFI_COD = GruppoFinalita.Grfi_Cod ")

            If filtraSpecie = True Then

