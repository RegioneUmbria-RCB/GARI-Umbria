            sql.AppendLine("AND Entita_Cod = 2 --Centro")
            sql.AppendLine("AND Piva = '" & Agro_SQL_SaveText(Piva) & "'")
            sql.AppendLine()
            sql.AppendLine("DECLARE @CNT INT = (SELECT COUNT(*) FROM @TBL)")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("DECLARE @ImpiantiValidi TABLE(PIVA NVARCHAR(25), Sa_Cod INT, Appezza INT, Id_Reg INT, Cop_Cod INT, Validita_Inizio DATETIME, Validita_Fine DATETIME, Data_Inizio_Prevista DATETIME) ")
            sql.AppendLine("INSERT INTO @ImpiantiValidi ")
            sql.AppendLine("SELECT piva, sa_cod, appezza, id_reg, COP_COD, Validita_Inizio, Validita_Fine, Data_Inizio_Prevista FROM ( ")
            sql.AppendLine("	SELECT piva, sa_cod, appezza, id_reg, COP_COD, Validita_Inizio, Validita_Fine, Data_Inizio_Prevista, NumRow = ROW_NUMBER() OVER (PARTITION BY PIVA, Sa_Cod, Appezza, Id_Reg ORDER BY PIVA, Sa_Cod, Appezza, Id_Reg) FROM ( ")
            sql.AppendLine("		SELECT imp.piva, imp.sa_cod, imp.appezza, imp.id_reg, imp.COP_COD, iprog.Validita_Inizio, iprog.Validita_Fine, iprog.Data_Inizio_Prevista ")
            sql.AppendLine("		FROM Reg_Impianti imp ")
            sql.AppendLine("		INNER JOIN Imprese_Progetti iprog ON iprog.piva = imp.piva AND iprog.sa_cod = imp.sa_cod AND iprog.appezza = imp.appezza AND iprog.id_reg = imp.id_reg ")
            sql.AppendLine("		WHERE imp.Piva = '" & Agro_SQL_SaveText(Piva) & "' AND imp.[USER] = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "' ")
            sql.AppendLine("		AND iprog.Validita_inizio <= GETDATE() AND GETDATE() <= iprog.Validita_Fine ")
            sql.AppendLine("		AND (@CNT = 0 OR (imp.SA_COD IN (SELECT * FROM @tbl))) ")

            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    sql.AppendLine("		AND imp.Inviato >= 0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    sql.AppendLine("		AND imp.Inviato = -1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select

            sql.AppendLine("	) T ")
            sql.AppendLine(") T WHERE NumRow = 1 ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("DECLARE @TmpAnalisi TABLE(PIVA NVARCHAR(25), SA_COD INT, APPEZZA INT, ID_REG INT, Sabbia FLOAT, Limo FLOAT, Argilla FLOAT) ")
            sql.AppendLine()
            sql.AppendLine("; WITH IMPIANTI_X_ANALISI_CTE AS ( ")
            sql.AppendLine("	SELECT DISTINCT imp.PIVA, imp.SA_COD, imp.APPEZZA, imp.ID_REG, app.Campo_Cod, axp.PROV, axp.COM, axp.SEZIONE, axp.FOGLIO, axp.NUMERO, axp.SUBALTERNO ")
            sql.AppendLine("	FROM @ImpiantiValidi imp ")
            sql.AppendLine("	INNER JOIN appezzamento app ON app.PIVA = imp.PIVA AND app.SA_COD = imp.SA_COD AND app.APPEZZA = imp.APPEZZA ")
            sql.AppendLine("	LEFT JOIN AppezzamentiXParticelle axp ON axp.PIVA = app.PIVA AND axp.SA_COD = app.SA_COD AND axp.APPEZZA = app.APPEZZA ")
            sql.AppendLine(") ")
            sql.AppendLine()
            sql.AppendLine("INSERT INTO @TmpAnalisi  ")
            sql.AppendLine("SELECT PIVA, SA_COD, APPEZZA, ID_REG, sabbia, limo, argilla ")
            sql.AppendLine("FROM ( ")
            sql.AppendLine("	SELECT PIVA, SA_COD, APPEZZA, ID_REG, [Rank], a.data_analisi, a.sabbia, a.limo, a.argilla ")
            sql.AppendLine("		, pos = ROW_NUMBER() OVER (PARTITION BY PIVA, SA_COD, APPEZZA, ID_REG ORDER BY PIVA, SA_COD, APPEZZA, ID_REG, [Rank], data_analisi DESC) ")
            sql.AppendLine("	FROM ( ")
            sql.AppendLine("		SELECT DISTINCT PIVA, SA_COD, APPEZZA, ID_REG, [Rank], testata_cod ")
            sql.AppendLine("		FROM ")
            sql.AppendLine("		( ")
            sql.AppendLine("			SELECT [Rank] = 1, imp.*, testata_cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("			FROM IMPIANTI_X_ANALISI_CTE imp ")
            sql.AppendLine("			LEFT JOIN ( ")
            sql.AppendLine("				SELECT Piva, Sa_Cod, Appezza, Id_Imp, Analisi_Testata_Cod FROM Analisi_EntitaxTestata WHERE Analisi_Entita_Cod = 5 ")
            sql.AppendLine("			) a ON a.Piva = imp.PIVA AND a.Sa_Cod = imp.SA_COD AND a.Appezza = imp.APPEZZA AND a.Id_Imp = imp.ID_REG ")
            sql.AppendLine()
            sql.AppendLine("			UNION ALL ")
            sql.AppendLine()
            sql.AppendLine("			SELECT [Rank] = 2, imp.*, testata_cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("			FROM IMPIANTI_X_ANALISI_CTE imp ")
            sql.AppendLine("			LEFT JOIN ( ")
            sql.AppendLine("				SELECT Piva, Sa_Cod, Appezza, Analisi_Testata_Cod FROM Analisi_EntitaxTestata WHERE Analisi_Entita_Cod = 4 ")
            sql.AppendLine("			) a ON a.Piva = imp.PIVA AND a.Sa_Cod = imp.SA_COD AND a.Appezza = imp.APPEZZA ")
            sql.AppendLine()
            sql.AppendLine("			UNION ALL ")
            sql.AppendLine()
            sql.AppendLine("			SELECT [Rank] = 3, imp.*, testata_cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("			FROM IMPIANTI_X_ANALISI_CTE imp ")
            sql.AppendLine("			LEFT JOIN ( ")
            sql.AppendLine("				SELECT Piva, Sa_Cod, Campo_Cod, Analisi_Testata_Cod FROM Analisi_EntitaxTestata WHERE Analisi_Entita_Cod = 3 ")
            sql.AppendLine("			) a ON a.Piva = imp.PIVA AND a.Sa_Cod = imp.SA_COD AND a.Campo_Cod = imp.Campo_Cod ")
            sql.AppendLine()
            sql.AppendLine("			UNION ALL ")
            sql.AppendLine()
            sql.AppendLine("			SELECT [Rank] = 4, imp.*, testata_cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("			FROM IMPIANTI_X_ANALISI_CTE imp ")
            sql.AppendLine("			LEFT JOIN ( ")
            sql.AppendLine("				SELECT prov, com, sezione, foglio, numero, subalterno, Analisi_Testata_Cod FROM Analisi_EntitaxTestata WHERE Analisi_Entita_Cod = 7 ")
            sql.AppendLine("			) a ON a.prov = imp.PROV AND a.Com = imp.COM AND a.Sezione = imp.SEZIONE AND a.Foglio = imp.FOGLIO AND a.Numero = imp.NUMERO AND a.Subalterno = imp.SUBALTERNO ")
            sql.AppendLine()
            sql.AppendLine("			UNION ALL ")
            sql.AppendLine()
            sql.AppendLine("			SELECT [Rank] = 5, imp.*, testata_cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("			FROM IMPIANTI_X_ANALISI_CTE imp ")
            sql.AppendLine("			LEFT JOIN ( ")
            sql.AppendLine("				SELECT Piva, Sa_Cod, Analisi_Testata_Cod FROM Analisi_EntitaxTestata WHERE Analisi_Entita_Cod = 2 ")
            sql.AppendLine("			) a ON a.Piva = imp.PIVA AND a.Sa_Cod = imp.SA_COD ")
            sql.AppendLine()
            sql.AppendLine("			UNION ALL ")
            sql.AppendLine()
            sql.AppendLine("			SELECT [Rank] = 6, imp.*, testata_cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("			FROM IMPIANTI_X_ANALISI_CTE imp ")
            sql.AppendLine("			LEFT JOIN ( ")
            sql.AppendLine("				SELECT Piva, Analisi_Testata_Cod FROM Analisi_EntitaxTestata WHERE Analisi_Entita_Cod = 1 ")
            sql.AppendLine("			) a ON a.Piva = imp.PIVA  ")
            sql.AppendLine("		) T	")
            sql.AppendLine("	) T ")
            sql.AppendLine("	INNER JOIN ( ")
            sql.AppendLine("		SELECT  ")
            sql.AppendLine("			testata_cod = testata.Analisi_Testata_Cod ")
            sql.AppendLine("			, data_analisi = testata.Analisi_Testata_Data_Inizio ")
            sql.AppendLine("			, sabbia = dett_sabbia.Analisi_Dettaglio_Valore_1 ")
            sql.AppendLine("			, limo = dett_limo.Analisi_Dettaglio_Valore_1 ")
            sql.AppendLine("			, argilla = dett_argilla.Analisi_Dettaglio_Valore_1 ")
            sql.AppendLine("		FROM Analisi_Dettagli dett_sabbia ")
            sql.AppendLine("		LEFT JOIN Analisi_Dettagli dett_limo ON dett_limo.Analisi_Testata_Cod = dett_sabbia.Analisi_Testata_Cod AND dett_limo.Analisi_Parametro_Cod = " & enum_AnalisiParametri.AnalisiParametri_Limo)
            sql.AppendLine("		LEFT JOIN Analisi_Dettagli dett_argilla ON dett_argilla.Analisi_Testata_Cod = dett_sabbia.Analisi_Testata_Cod AND dett_argilla.Analisi_Parametro_Cod = " & enum_AnalisiParametri.AnalisiParametri_Argilla)
            sql.AppendLine("		INNER JOIN Analisi_Testata testata ON testata.Analisi_Superuser = dett_sabbia.Analisi_SuperUser AND testata.Analisi_Testata_Cod = dett_sabbia.Analisi_Testata_Cod ")
            sql.AppendLine("		WHERE dett_sabbia.Analisi_Parametro_Cod = " & enum_AnalisiParametri.AnalisiParametri_Sabbia)
            sql.AppendLine("		AND testata.Analisi_Testata_Data_Inizio <= GETDATE() AND GETDATE() <= testata.Analisi_Testata_Data_Fine ")
            sql.AppendLine("	) A ON A.testata_cod = T.testata_cod ")
            sql.AppendLine(") T ")
            sql.AppendLine("WHERE pos = 1 ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine(";WITH IMPIANTI_CTE AS ( ")
            sql.AppendLine()
            sql.AppendLine("	SELECT rimp.piva, rimp.sa_cod, rimp.appezza, rimp.id_reg, veg.veg_cod, cul.cul_cod, rimp.GRFI_COD, rimp.GRVA_COD_VEG, app.campo_cod, rimp.imp_cod ")
            sql.AppendLine("		, ca.sa_nome ")
            sql.AppendLine("		, app.app_nome ")
            sql.AppendLine("		, veg.veg_des ")
            sql.AppendLine("		, cul.cul_des ")
            sql.AppendLine("		, GruppoVegetale = gveg.Gru_Des ")
            sql.AppendLine("		, TraFila = CAST(REPLACE(rimpc1.val_cod, ',', '.') AS FLOAT) ")
            sql.AppendLine("		, SuFila = CAST(REPLACE(rimpc2.val_cod, ',', '.') AS FLOAT) ")
            sql.AppendLine("		, CondTraFila = cttf.TECN_DES ")
            sql.AppendLine("		, app_x = CASE WHEN COALESCE(app.x, 0) = 0 THEN NULL ELSE app.x END ")
            sql.AppendLine("		, app_y = CASE WHEN COALESCE(app.y, 0) = 0 THEN NULL ELSE app.y END ")
            sql.AppendLine("		, ca_lat = CASE WHEN COALESCE(ca.lat, 0) = 0 THEN NULL ELSE ca.lat END ")
            sql.AppendLine("		, ca_lng = CASE WHEN COALESCE(ca.long, 0) = 0 THEN NULL ELSE ca.long END ")
            sql.AppendLine("		, InizioImpianto = rimp.Validita_Inizio ")
            sql.AppendLine("		, rimp.sup_imp ")
            sql.AppendLine("        , CUAA = COALESCE(i_c.val_cod, '') ")
            sql.AppendLine("		, Pendenza = app.PENDE ")
            sql.AppendLine("		, Vigoria = COALESCE(pinn.Port_Vig, -1) ")
            sql.AppendLine("		, Irri_Imp_Cod = COALESCE(txirri.Cli_Irri_Cod, -1) ")
            sql.AppendLine("		, Irri_Imp_Des = COALESCE(txirri.Cli_Irri_Des, '') ")
            sql.AppendLine("		, Irri_Plot_Id = COALESCE(appcod.val_cod, 0) ")
            sql.AppendLine("		, Irri_Crop_Id = COALESCE(rimpc3.val_cod, 0) ")
            sql.AppendLine("		, FF_Start = COALESCE(stadi.FF_Start_Cod, 0) ")
            sql.AppendLine("		, imp.Validita_Inizio ")
            sql.AppendLine("		, imp.Validita_Fine ")
            sql.AppendLine("		, imp.Data_Inizio_Prevista ")
            sql.AppendLine("        , imp.Cop_Cod")
            sql.AppendLine()
            sql.AppendLine("	FROM @ImpiantiValidi imp ")
            sql.AppendLine("	INNER JOIN Reg_Impianti			    	rimp	ON rimp.PIVA = imp.PIVA AND rimp.SA_COD = imp.Sa_Cod AND rimp.APPEZZA = imp.Appezza AND rimp.ID_REG = imp.Id_Reg ")
            sql.AppendLine("	INNER JOIN Appezzamento			    	app		ON app.piva = imp.piva AND app.sa_cod = imp.SA_COD AND app.APPEZZA = imp.APPEZZA ")
            sql.AppendLine("	INNER JOIN Centri_Aziendali		    	ca		ON imp.sa_cod = ca.sa_cod AND imp.piva = ca.piva ")
            sql.AppendLine("	INNER JOIN cultivar				    	cul		ON cul.Cul_Cod = rimp.CUL_COD ")
            sql.AppendLine("	INNER JOIN SpecieVegetali		    	veg		ON veg.Veg_Cod = cul.veg_cod ")
            sql.AppendLine("	INNER JOIN GruppoVegetale		    	gveg	ON gveg.Gru_Cod = veg.Gru_Cod ")
            sql.AppendLine("	LEFT JOIN Portinnesti			    	pinn	ON pinn.Port_Cod = rimp.PORT_COD ")
            sql.AppendLine("	LEFT JOIN Reg_Impianti_Codici	    	rimpc1	ON rimpc1.PIVA = rimp.PIVA AND rimpc1.sa_cod = rimp.SA_COD AND rimpc1.appezza = rimp.APPEZZA AND rimpc1.Id_Reg = rimp.ID_REG AND rimpc1.id_cod = " & enum_CodiciAnagrafe.Impianto_TraFila_Maschio)
            sql.AppendLine("	LEFT JOIN Reg_Impianti_Codici	    	rimpc2	ON rimpc2.PIVA = rimp.PIVA AND rimpc2.sa_cod = rimp.SA_COD AND rimpc2.appezza = rimp.APPEZZA AND rimpc2.Id_Reg = rimp.ID_REG AND rimpc2.id_cod = " & enum_CodiciAnagrafe.Impianto_SuFila_Maschio)
            sql.AppendLine("	LEFT JOIN ConduzioneTerrenoTraFila  	cttf	ON cttf.GRU_COD = veg.Gru_Cod AND cttf.TECN_COD = rimp.TECN_COD ")
            sql.AppendLine("    LEFT JOIN Imprese_Codici		    	i_c		ON i_c.PIVA = imp.PIVA AND i_c.id_cod = 1010 ")
            sql.AppendLine("	LEFT JOIN @TBL_TX_IMPCOD		    	txirri	ON txirri.GIAS_Imp_Cod = rimp.IMP_COD ")
            sql.AppendLine("	LEFT JOIN Appezzamento_Codici	    	appcod	ON appcod.PIVA = rimp.PIVA AND appcod.sa_cod = rimp.SA_COD AND appcod.appezza = rimp.APPEZZA AND appcod.id_cod = 2225 ")
            sql.AppendLine("	LEFT JOIN Reg_Impianti_Codici	    	rimpc3	ON rimpc3.PIVA = rimp.PIVA AND rimpc3.sa_cod = rimp.SA_COD AND rimpc3.appezza = rimp.APPEZZA AND rimpc3.Id_Reg = rimp.ID_REG AND rimpc3.id_cod = 2225 ")
            sql.AppendLine("	LEFT JOIN @TBL_FF_Start                 stadi	ON stadi.Veg_Cod = veg.Veg_Cod ")
            sql.AppendLine()
            sql.AppendLine("), ")
            sql.AppendLine()

            Dim semina As String = String.Join(", ", {LAVCOD_SEMINA.ToString, LAVCOD_TRAPIANTO.ToString, LAVCOD_SOVESCIO.ToString, LAVCOD_SOD_SEDDING.ToString})
            Dim irrigazione As String = String.Join(", ", {LAVCOD_IRRIGAZIONE.ToString, LAVCOD_FERTIRRIGAZIONE.ToString})

            sql.AppendLine("AGENDA_CTE AS ( ")
            sql.AppendLine()
            sql.AppendLine("	SELECT ")
            sql.AppendLine("		OpSemina = CASE WHEN ag.Lav_Cod IN (" & irrigazione & ") THEN 0 ELSE 1 END ")
            sql.AppendLine("		, ag.PIVA ")
            sql.AppendLine("		, ag.sa_cod ")
            sql.AppendLine("		, movdes.appezza ")
            sql.AppendLine("		, id_reg = movdes.id_destinazione ")
            sql.AppendLine("		, DataMovimento = mov.Data_Movimento ")
            sql.AppendLine("		, irri_m3_x_ha = movdes.Qta")
            sql.AppendLine("		--, quota = movdes.QuotaDistribuzione ")
            sql.AppendLine("	FROM Agenda ag ")
            sql.AppendLine("	INNER JOIN Movimenti			mov		ON	mov.PIVA = ag.PIVA AND ")
            sql.AppendLine("												mov.Sa_Cod = ag.Sa_Cod AND ")
            sql.AppendLine("												mov.Id_Agenda = ag.Id_Agenda ")
            sql.AppendLine("	INNER JOIN Movimenti_dettagli	movdet	ON	movdet.PIVA = mov.PIVA AND ")
            sql.AppendLine("												movdet.Sa_Cod = mov.Sa_Cod AND ")
            sql.AppendLine("												movdet.Id_Agenda = mov.Id_Agenda AND ")
            sql.AppendLine("												movdet.Id_Mov = mov.Id_Mov ")
            sql.AppendLine("	INNER JOIN Mov_Destinazioni		movdes	ON	movdes.Piva = movdet.PIVA AND ")
            sql.AppendLine("												movdes.Sa_Cod = movdet.Sa_Cod AND ")
            sql.AppendLine("												movdes.Id_Agenda = movdet.Id_Agenda AND ")
            sql.AppendLine("												movdes.Id_Mov = movdet.Id_Mov AND ")
            sql.AppendLine("												movdes.Id_Mov_Det = movdet.Id_Mov_Det ")
            sql.AppendLine("	WHERE ag.PIVA = '" & Agro_SQL_SaveText(Piva) & "' AND mov.Cau_Mov = '" & CAU_LAVORAZIONE & "' AND (ag.Lav_Cod IN (" & semina & ") OR ag.Lav_Cod IN (" & irrigazione & ")) ")
            sql.AppendLine()
            sql.AppendLine("), ")
            sql.AppendLine()
            sql.AppendLine("RILIEVO_FASE_CTE AS ( ")
            sql.AppendLine()
            sql.AppendLine("	SELECT ")
            sql.AppendLine("		ag.PIVA ")
            sql.AppendLine("		, ag.sa_cod ")
            sql.AppendLine("		, dest.appezza ")
            sql.AppendLine("		, id_reg = dest.id_destinazione ")
            sql.AppendLine("		, ff_cod = tecn.FF_Classe ")
            sql.AppendLine("		, DataRilievo = dest.validita_inizio ")
            sql.AppendLine("	FROM Agenda ag ")
            sql.AppendLine("	INNER JOIN Movimenti				mov		ON	mov.PIVA = ag.PIVA AND mov.Sa_Cod = ag.Sa_Cod AND mov.Id_Agenda = ag.Id_Agenda ")
            sql.AppendLine("	INNER JOIN Movimenti_dettagli		dett	ON	dett.PIVA = mov.PIVA AND dett.Sa_Cod = mov.Sa_Cod AND dett.Id_Agenda = mov.Id_Agenda AND dett.Id_Mov = mov.Id_Mov ")
            sql.AppendLine("	INNER JOIN Mov_Destinazioni			dest	ON	dest.Piva = dett.PIVA AND dest.Sa_Cod = dett.Sa_Cod AND dest.Id_Agenda = dett.Id_Agenda AND dest.Id_Mov = dett.Id_Mov AND dest.Id_Mov_Det = dett.Id_Mov_Det ")
            sql.AppendLine("	INNER JOIN Mov_Dettaglio_Tecnico	tecn	ON	tecn.Piva = ag.PIVA AND tecn.Id_Agenda = ag.Id_Agenda ")
            sql.AppendLine("	INNER JOIN IMPIANTI_CTE				imp		ON	imp.PIVA = ag.PIVA AND imp.Sa_Cod = ag.sa_cod AND imp.Appezza = dest.appezza AND imp.id_reg = dest.Id_Destinazione ")
            sql.AppendLine("													AND imp.FF_Start = tecn.FF_Classe AND imp.Validita_Inizio <= dest.validita_inizio AND dest.validita_inizio <= imp.Validita_Fine ")
            sql.AppendLine("	WHERE mov.Cau_Mov = '" & CAU_RILIEVO_CAMPO & "' AND ag.Lav_Cod = " & LAVCOD_FASI_FENOLOGICHE.ToString & " AND tecn.FF_Classe <> 0 ")
            sql.AppendLine()
            sql.AppendLine(") ")
            sql.AppendLine()
            sql.AppendLine("SELECT ")
            sql.AppendLine("    CUAA = imp.CUAA ")
            sql.AppendLine("	, Centro = imp.sa_nome ")
            sql.AppendLine("	, Campo = COALESCE(campi.campo_des, '') ")
            sql.AppendLine("	, Impianto = imp.app_nome ")
            sql.AppendLine("	, Coltura = imp.veg_des ")
            sql.AppendLine("	, Varieta = imp.cul_des ")
            sql.AppendLine("	, Veg_Cod = imp.veg_cod ")
            sql.AppendLine("	, Cul_Cod = imp.cul_cod ")
            sql.AppendLine("	, GruppoVegetale = imp.GruppoVegetale ")
            sql.AppendLine("	, TraFila = COALESCE(imp.TraFila, 0) ")
            sql.AppendLine("	, SuFila = COALESCE(imp.SuFila, 0) ")
            sql.AppendLine("	, CondTraFila = COALESCE(imp.CondTraFila, '') ")
            sql.AppendLine("	, DataRilievo = ril.DataRilievo ")
            sql.AppendLine("	, DataSemina = semina.DataSemina ")
            sql.AppendLine("	, DataSeminaPrevista = imp.Data_Inizio_Prevista ")
            sql.AppendLine("	, DataInizioImpianto = imp.InizioImpianto ")
            sql.AppendLine("	, Sup_Imp = imp.sup_imp ")
            sql.AppendLine("	, Lat = COALESCE(gis.Lat, app_x, ca_lat) ")
            sql.AppendLine("	, Lng = COALESCE(gis.Lng, app_y, ca_lng) ")
            sql.AppendLine("	, Indirizzo = COALESCE(axi.Indirizzo, cxi.indirizzo, '') ")
            sql.AppendLine("	, Irri_Veg_Cod = COALESCE(txveg.Cli_Veg_Cod, -1) ")
            sql.AppendLine("	, Irri_Veg_Des = COALESCE(txveg.Cli_Veg_Des, '') ")
            sql.AppendLine("	, Irri_Imp_Cod = imp.Irri_Imp_Cod ")
            sql.AppendLine("	, Irri_Imp_Des = imp.Irri_Imp_Des ")
            sql.AppendLine("	, Stazioni_Meteo  = COALESCE(meteo.stazioni, '') ")
            sql.AppendLine("	, Irrigazioni = COALESCE(Irri.Irrigazioni, '') ")
            If fertirrigoDetails Then
                sql.AppendLine("    , Fertilizzazioni = COALESCE(fertilizzazioni.JSON_Fertilizzazioni, '') ")
                sql.AppendLine("    , FertiRecipe = COALESCE(npkImpianti.npkImpianti_JSON, '') ")
            End If

            sql.AppendLine("	, Pendenza = imp.Pendenza ")
            sql.AppendLine("	, Vigoria = imp.Vigoria ")
            sql.AppendLine("	, ana.Sabbia ")
            sql.AppendLine("	, ana.Limo ")
            sql.AppendLine("	, ana.Argilla ")
            sql.AppendLine("	, GIAS_PIva = imp.PIVA ")
            sql.AppendLine("	, GIAS_SaCod = imp.SA_COD ")
            sql.AppendLine("	, GIAS_Appezza = imp.APPEZZA ")
            sql.AppendLine("	, GIAS_IdReg = imp.ID_REG ")
            sql.AppendLine("	, imp.Irri_Plot_Id ")
            sql.AppendLine("	, imp.Irri_Crop_Id ")
            sql.AppendLine("    , imp.Cop_Cod ")
            sql.AppendLine("    , Cop_Cod_Irriframe = ccc.Cop_Cod_Cliente")
            sql.AppendLine()
            sql.AppendLine("FROM IMPIANTI_CTE imp ")
            sql.AppendLine()
            sql.AppendLine("LEFT JOIN ( --Data rilievo fase fenologica start ")
            sql.AppendLine("	SELECT PIVA, Sa_Cod, Appezza, id_reg, ")
            sql.AppendLine("		DataRilievo, NumRow = ROW_NUMBER() OVER (partition by PIVA, Sa_Cod, Appezza, id_reg, ff_cod ORDER BY DataRilievo DESC) ")
            sql.AppendLine("	FROM RILIEVO_FASE_CTE ")
            sql.AppendLine(") ril ON ril.PIVA = imp.PIVA AND ril.Sa_Cod = imp.sa_cod AND ril.Appezza = imp.appezza AND ril.id_reg = imp.id_reg AND ril.NumRow = 1 ")
            sql.AppendLine()
            sql.AppendLine("LEFT JOIN ( --Data semina/trapianto ")
            sql.AppendLine("	SELECT PIVA, sa_cod, appezza, id_reg ")
            sql.AppendLine("		, DataSemina = DataMovimento, NumRow = ROW_NUMBER() OVER (partition by PIVA, sa_cod, appezza, id_reg ORDER BY DataMovimento DESC) ")
            sql.AppendLine("	FROM AGENDA_CTE ")
            sql.AppendLine("	WHERE OpSemina = 1 ")
            sql.AppendLine(") semina on semina.piva = imp.piva AND semina.sa_cod = imp.sa_cod AND semina.appezza = imp.appezza AND semina.id_reg = imp.id_reg AND semina.NumRow = 1 ")
            sql.AppendLine()
            sql.AppendLine("LEFT JOIN ( --Irrigazioni ")
            sql.AppendLine("	SELECT DISTINCT PIVA, sa_cod, appezza, id_reg, ")
            sql.AppendLine("		Irrigazioni = '[' + STUFF( ")
            sql.AppendLine("		( ")
            sql.AppendLine("			SELECT ',{""DataIrri"": ""' + CONVERT(VARCHAR(25), DataMovimento, 23) + '"", ""VolumeMM"": ' + CAST(irri_m3_x_ha * 0.1 / imp.sup_imp AS VARCHAR(15)) + ' }' ")
            sql.AppendLine("			FROM AGENDA_CTE ag ")
            sql.AppendLine("			INNER JOIN IMPIANTI_CTE imp ON imp.PIVA = ag.PIVA AND imp.Sa_Cod = ag.SA_COD AND imp.Appezza = ag.APPEZZA AND imp.id_reg = ag.ID_REG ")
            sql.AppendLine("			WHERE ag.OpSemina = 0 AND ag.PIVA = T1.PIVA AND ag.sa_cod = T1.Sa_Cod AND ag.appezza = T1.Appezza AND ag.id_reg = t1.id_reg AND imp.sup_imp > 0 ") 'errore division by zero se l'impianto ha superfice nulla
            sql.AppendLine("            ORDER BY DataMovimento ")
            sql.AppendLine("			FOR XML PATH ('') ")
            sql.AppendLine("		), 1, 1, '') + ']' ")
            sql.AppendLine("	FROM AGENDA_CTE T1 ")
            sql.AppendLine(") Irri ON Irri.PIVA = imp.PIVA AND Irri.Sa_Cod = imp.SA_COD AND Irri.Appezza = imp.APPEZZA AND Irri.id_reg = imp.ID_REG ")
            sql.AppendLine()

            If fertirrigoDetails Then
                Dim fertilizzazioni As String = String.Join(", ", {LAVCOD_FERTIRRIGAZIONE.ToString, LAVCOD_DISTRIBUZIONE_CONCIME.ToString, LAVCOD_CONCIMAZIONE_FOGLIARE.ToString, LAVCOD_DISTRIBUZIONE_AMMENDANTI.ToString, LAVCOD_SARCHIATURA_CONCIMAZIONE.ToString, LAVCOD_TRATTAMENTO_ANTIBUTTERATURA.ToString})
                sql.AppendLine("LEFT Join(")
                sql.AppendLine("SELECT imp.PIVA, imp.Sa_Cod, imp.APPEZZA, imp.ID_REG,")
                sql.AppendLine("    JSON_Fertilizzazioni = '[' + STUFF((")
                sql.AppendLine("        SELECT ',{""TitoloN"": ' + CAST(F.N as VARCHAR(12)) + ', ""TitoloP"": ' + CAST(F.P2O5 as VARCHAR(12)) + ', ""TitoloK"": ' + CAST(F.K2O as VARCHAR(12)) + ', ""DoseKg"": ' + CAST(MDI.Qta as VARCHAR(12)) +")
                sql.AppendLine("        ', ""NomeCommercialeDescri"": ""' + F.Fer_Des + '""' + ', ""Data"": ""' + CONVERT(VARCHAR(25), M.Data_Movimento, 23) + '""}' From Mov_Destinazioni MDI")
                sql.AppendLine("         Left Join Movimenti M ON M.Id_Mov = MDI.Id_Mov ")
                sql.AppendLine("        Left Join Agenda A ON MDI.Id_Agenda = A.Id_Agenda")
                sql.AppendLine("        Left Join Movimenti_dettagli MDet ON MDet.Id_Mov = MDI.Id_Mov And MDet.Id_Mov_Det = MDI.Id_Mov_Det")
                sql.AppendLine("        Left Join Fertilizzanti F ON MDet.Pro_Cod = F.Fer_Cod")
                sql.AppendLine($"       WHERE A.Lav_Cod In ({fertilizzazioni}) And MDet.Elem_Cod = 3 And M.Cau_Mov = 2300")
                sql.AppendLine("            And imp.PIVA = MDI.piva And imp.Sa_Cod = MDI.sa_cod And imp.APPEZZA = MDI.Appezza And imp.ID_REG = MDI.Id_Destinazione")
                sql.AppendLine("        For Xml PATH('') ), 1, 1, '') + ']'")
                sql.AppendLine("        From IMPIANTI_CTE imp")
                sql.AppendLine(") fertilizzazioni ON")
                sql.AppendLine("imp.PIVA = fertilizzazioni.PIVA And imp.SA_COD = fertilizzazioni.SA_COD")
                sql.AppendLine("And imp.APPEZZA = fertilizzazioni.APPEZZA And imp.ID_REG = fertilizzazioni.ID_REG")
                sql.AppendLine()


                sql.AppendLine("LEFT JOIN (")
                sql.AppendLine("    SELECT imp.PIVA, imp.Sa_Cod, imp.APPEZZA, imp.ID_REG,")
                sql.AppendLine("    npkImpianti_JSON =  CONCAT(")
                sql.AppendLine("        '{""N_Ammesso"": ', ")
                sql.AppendLine($"        COALESCE((SELECT CAST(val_cod as VARCHAR(12)) FROM Reg_Impianti_Codici impC WHERE id_cod = {CInt(TipiEnumerativi.enum_CodiciAnagrafe.Impianto_LimiteN)} and impC.PIVA = imp.PIVA and impC.sa_cod = imp.SA_COD and impC.appezza = imp.APPEZZA and impc.Id_Reg = imp.ID_REG), '0'), ")
                sql.AppendLine("        ', ""P_Ammesso"": ', ")
                sql.AppendLine($"        COALESCE((SELECT CAST(val_cod as VARCHAR(12)) FROM Reg_Impianti_Codici impC WHERE id_cod = {CInt(TipiEnumerativi.enum_CodiciAnagrafe.Impianto_LimiteP)} and impC.PIVA = imp.PIVA and impC.sa_cod = imp.SA_COD and impC.appezza = imp.APPEZZA and impc.Id_Reg = imp.ID_REG), '0'), ")
                sql.AppendLine("        ', ""K_Ammesso"": ', ")
                sql.AppendLine($"        COALESCE((SELECT CAST(val_cod as VARCHAR(12)) FROM Reg_Impianti_Codici impC WHERE id_cod = {CInt(TipiEnumerativi.enum_CodiciAnagrafe.Impianto_LimiteK)} and impC.PIVA = imp.PIVA and impC.sa_cod = imp.SA_COD and impC.appezza = imp.APPEZZA and impc.Id_Reg = imp.ID_REG), '0'), ")
                sql.AppendLine("        '}')")
                sql.AppendLine("    FROM IMPIANTI_CTE imp ")
                sql.AppendLine(") npkImpianti ON npkImpianti.PIVA = imp.PIVA AND npkImpianti.SA_COD = imp.SA_COD AND npkImpianti.APPEZZA = imp.APPEZZA AND npkImpianti.ID_REG = imp.ID_REG ")
                sql.AppendLine()
            End If


            sql.AppendLine("LEFT JOIN ( --Coordinate GIS ")
            sql.AppendLine("    SELECT DISTINCT ge.piva, ge.sa_cod, ge.appezza, ")
            sql.AppendLine("		Lat = geography::STGeomFromText(geg.Poligono_GeoEntity.EnvelopeCenter().ToString(), 4326).Lat, ")
            sql.AppendLine("		Lng = geography::STGeomFromText(geg.Poligono_GeoEntity.EnvelopeCenter().ToString(), 4326).Long ")
            sql.AppendLine("	FROM Gis_ElementiGrafici geg ")
            sql.AppendLine("	INNER JOIN Gis_Entita ge ON ge.Entita_Cod = geg.Entita_Cod ")
            sql.AppendLine("	WHERE LayerElementiGrafici_Cod IN (1, 19) ")
            sql.AppendLine(") gis ON gis.Piva = imp.PIVA AND gis.Sa_Cod = imp.SA_COD AND gis.Appezza = imp.APPEZZA ")
            sql.AppendLine()
            sql.AppendLine("LEFT JOIN ( --Indirizzo appezzamento ")
            sql.AppendLine("	SELECT axi.PIVA , axi.sa_cod, axi.appezza, ")
            sql.AppendLine("		Indirizzo = '{ ""Indirizzo"": ""' + ind.ind_des + '"", ""Fraz"": ""' + ind.frz_des + '"", ""CAP"": ""' + ISTAT.CAP + '"", ""Comune"": ""' + ISTAT.LOCALITA + '"", ""Prov"": ""' + ISTAT.COMUNI_PROV +'"" }' ")
            sql.AppendLine("	FROM AppezzamentixIndirizzi axi ")
            sql.AppendLine("	INNER JOIN Indirizzi ind ON ind.cod_indirizzo = axi.cod_indirizzo ")
            sql.AppendLine("    INNER JOIN ISTAT ON ISTAT.PROV = ind.pro_cod_istat AND ISTAT.COM = ind.com_cod_istat ")
            sql.AppendLine(") axi ON axi.PIVA = imp.PIVA AND axi.sa_cod = imp.SA_COD AND axi.appezza = imp.APPEZZA ")
            sql.AppendLine()
            sql.AppendLine("LEFT JOIN ( --Indirizzo centro ")
            sql.AppendLine("	SELECT cxi.PIVA , cxi.sa_cod, ")
            sql.AppendLine("		Indirizzo = '{ ""Indirizzo"": ""' + ind.ind_des + '"", ""Fraz"": ""' + ind.frz_des + '"", ""CAP"": ""' + ISTAT.CAP + '"", ""Comune"": ""' + ISTAT.LOCALITA + '"", ""Prov"": ""' + ISTAT.COMUNI_PROV +'"" }' ")
            sql.AppendLine("	FROM CentrixIndirizzi cxi ")
            sql.AppendLine("	INNER JOIN Indirizzi ind ON ind.cod_indirizzo = cxi.cod_indirizzo ")
            sql.AppendLine("    INNER JOIN ISTAT ON ISTAT.PROV = ind.pro_cod_istat AND ISTAT.COM = ind.com_cod_istat ")
            sql.AppendLine(") cxi ON cxi.PIVA = imp.PIVA AND cxi.sa_cod = imp.sa_cod ")
            sql.AppendLine()
            sql.AppendLine("LEFT JOIN Campi ON campi.piva = imp.PIVA AND campi.Sa_Cod = imp.sa_cod AND campi.campo_cod = imp.Campo_Cod ")
            sql.AppendLine()
            sql.AppendLine("LEFT JOIN ( --Per origine dati meteo proprietari ")
            sql.AppendLine("    SELECT DISTINCT piva, sa_cod ")
            sql.AppendLine("		, stazioni = '[' + STUFF( ")
            sql.AppendLine("	    	( ")
            sql.AppendLine("    		SELECT ',{""Sorgente"": ' + CAST(Tipo_Sorgente AS VARCHAR(10)) + ', ""Stazione"": ' + CAST(Stazione_Cod AS VARCHAR(10)) + ' }' ")
            sql.AppendLine("    		FROM DSS_Stazioni_X_Irriga --DSS_Centri_Aziendali_Agronica_Stazioni_Meteo ")
            sql.AppendLine("        	WHERE piva = T.piva AND sa_cod = T.sa_cod ")
            sql.AppendLine("    		FOR XML PATH ('') ")
            sql.AppendLine("            ) ")
            sql.AppendLine("		    , 1, 1, '') + ']' ")
            sql.AppendLine("    FROM DSS_Stazioni_X_Irriga T --DSS_Centri_Aziendali_Agronica_Stazioni_Meteo T ")
            sql.AppendLine(") meteo ON meteo.piva = imp.PIVA AND meteo.sa_cod = imp.sa_cod ")
            sql.AppendLine()
            sql.AppendLine("LEFT JOIN ( --Trascodifica veg_cod ")
            sql.AppendLine("	SELECT ")
            sql.AppendLine("		x_piva = piva ")
            sql.AppendLine("		, x_sa_cod = sa_cod ")
            sql.AppendLine("		, x_appezza = appezza ")
            sql.AppendLine("		, x_id_reg = ID_REG ")
            sql.AppendLine("		, Cli_Veg_Cod ")
            sql.AppendLine("		, Cli_Veg_Des ")
            sql.AppendLine("	FROM ( ")
            sql.AppendLine("		SELECT NumRow = ROW_NUMBER() OVER (PARTITION BY piva, sa_cod, appezza, id_reg ORDER BY piva, sa_cod, appezza, id_reg, vmatch), * ")
            sql.AppendLine("		FROM ( ")
            sql.AppendLine("			SELECT vmatch = 1, * --Match con Veg_Cod, Grfi_Cod e Grva_Cod ")
            sql.AppendLine("			FROM IMPIANTI_CTE imp ")
            sql.AppendLine("			INNER JOIN ( ")
            sql.AppendLine("				SELECT * FROM ( ")
            sql.AppendLine("					SELECT *, NR = ROW_NUMBER() OVER (PARTITION BY GIAS_Veg_Cod, GIAS_Grfi_Cod, GIAS_Grva_Cod ORDER BY GIAS_Veg_Cod, GIAS_Grfi_Cod, GIAS_Grva_Cod, Cli_Veg_Cod) ")
            sql.AppendLine("					FROM @TBL_TX_VEGCOD ")
            sql.AppendLine("				) T WHERE NR = 1 ")
            sql.AppendLine("			) txcod ON txcod.GIAS_Veg_Cod = imp.Veg_Cod AND txcod.GIAS_Grfi_Cod = imp.GRFI_COD AND txcod.GIAS_Grva_Cod = imp.GRVA_Cod_VEG ")
            sql.AppendLine()
            sql.AppendLine("			UNION ALL ")
            sql.AppendLine()
            sql.AppendLine("			SELECT vmatch = 2, * --Match con Veg_Cod e Grfi_Cod ")
            sql.AppendLine("			FROM IMPIANTI_CTE imp ")
            sql.AppendLine("			INNER JOIN ( ")
            sql.AppendLine("				SELECT * FROM ( ")
            sql.AppendLine("					SELECT *, NR = ROW_NUMBER() OVER (PARTITION BY GIAS_Veg_Cod, GIAS_Grfi_Cod ORDER BY GIAS_Veg_Cod, GIAS_Grfi_Cod, Cli_Veg_Cod) ")
            sql.AppendLine("					FROM @TBL_TX_VEGCOD ")
            sql.AppendLine("				) T WHERE NR = 1 ")
            sql.AppendLine("			) txcod ON txcod.GIAS_Veg_Cod = imp.Veg_Cod AND txcod.GIAS_Grfi_Cod = imp.GRFI_COD ")
            sql.AppendLine()
            sql.AppendLine("			UNION ALL ")
            sql.AppendLine()
            sql.AppendLine("			SELECT vmatch = 3, * --Match con Veg_Cod e Grva_Cod ")
            sql.AppendLine("			FROM IMPIANTI_CTE imp ")
            sql.AppendLine("			INNER JOIN ( ")
            sql.AppendLine("				SELECT * FROM ( ")
            sql.AppendLine("					SELECT *, NR = ROW_NUMBER() OVER (PARTITION BY GIAS_Veg_Cod, GIAS_Grva_Cod ORDER BY GIAS_Veg_Cod, GIAS_Grva_Cod, Cli_Veg_Cod) ")
            sql.AppendLine("					FROM @TBL_TX_VEGCOD ")
            sql.AppendLine("				) T WHERE NR = 1 ")
            sql.AppendLine("			) txcod ON txcod.GIAS_Veg_Cod = imp.Veg_Cod AND txcod.GIAS_Grva_Cod = imp.GRVA_Cod_VEG ")
            sql.AppendLine()
            sql.AppendLine("			UNION ALL ")
            sql.AppendLine()
            sql.AppendLine("			SELECT vmatch = 4, * --Match con Veg_Cod ")
            sql.AppendLine("			FROM IMPIANTI_CTE imp ")
            sql.AppendLine("			INNER JOIN ( ")
            sql.AppendLine("				SELECT * FROM ( ")
            sql.AppendLine("					SELECT *, NR = ROW_NUMBER() OVER (PARTITION BY GIAS_Veg_Cod ORDER BY GIAS_Veg_Cod, Cli_Veg_Cod) ")
            sql.AppendLine("					FROM @TBL_TX_VEGCOD ")
            sql.AppendLine("				) T WHERE NR = 1 ")
            sql.AppendLine("			) txcod on txcod.GIAS_Veg_Cod = imp.Veg_Cod ")
            sql.AppendLine("		) T ")
            sql.AppendLine("	) T1 ")
            sql.AppendLine("	WHERE NumRow = 1 ")
            sql.AppendLine(") txveg ON txveg.x_piva = imp.piva AND txveg.x_sa_cod = imp.SA_COD AND txveg.x_appezza = imp.APPEZZA AND txveg.x_id_reg = imp.ID_REG ")
            sql.AppendLine()
            sql.AppendLine("LEFT JOIN @TmpAnalisi ana ON ana.PIVA = imp.PIVA AND ana.SA_COD = imp.SA_COD AND ana.APPEZZA = imp.APPEZZA AND ana.ID_REG = imp.ID_REG ")
            sql.AppendLine()
            sql.AppendLine("LEFT JOIN Codifica_Coperture_Clienti ccc ON ccc.Cop_cod = imp.Cop_Cod and Codice_Cliente = 2116 ")
            sql.AppendLine()
            sql.AppendLine("ORDER BY imp.sa_nome, imp.app_nome ")

            DT = EseguiQuery_Lettura(objParametri, sql.ToString, NomeRoutine)

        Catch ex As Exception

            Dim MessaggioErrore As String = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing

            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT
    End Function

    Public Function Leggi_x_DSS_Irrigazione_V2(piva As String, sa_cod As Integer, appezza As Integer, id_reg As Integer, fertiDetails As Boolean, ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_x_DSS_Irrigazione_V2()"
        Dim DT As DataTable

        Try
            Dim sql As New System.Text.StringBuilder

            sql.Clear()

            sql.AppendLine("SET NOCOUNT ON")
            sql.AppendLine()
            sql.AppendLine($"DECLARE @PIVA_SUPERUSER NVARCHAR(25) = '{Agro_SQL_SaveText(objParametri.PivaSuperUser)}'")
            sql.AppendLine($"DECLARE @PIVA NVARCHAR(25) = '{Agro_SQL_SaveText(piva)}'")
            sql.AppendLine($"DECLARE @USERNAME VARCHAR(255) = '{Agro_SQL_SaveText(objParametri.UtenteUsername)}'")
            sql.AppendLine($"DECLARE @FLAGFERTI BIT = {IIf(fertiDetails, "1", "0")}")
            sql.AppendLine($"DECLARE @SA_COD INT = {Agro_SQL_SaveNum(sa_cod)}")
            sql.AppendLine($"DECLARE @APPEZZA INT = {Agro_SQL_SaveNum(appezza)}")
            sql.AppendLine($"DECLARE @ID_REG INT = {Agro_SQL_SaveNum(id_reg)}")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("DECLARE @TBL TABLE(SA_COD INT)")
            sql.AppendLine("INSERT INTO @TBL")
            sql.AppendLine("SELECT Sa_cod")
            sql.AppendLine("FROM Utenti_Visibilita_Appoggio (NOLOCK)")
            sql.AppendLine("WHERE PivaSuperUser = @PIVA_SUPERUSER AND Username = @USERNAME AND Piva = @PIVA AND Entita_Cod = 2 --Centro")
            sql.AppendLine()
            sql.AppendLine("DECLARE @CNT INT = (SELECT COUNT(*) FROM @TBL) ")
            sql.AppendLine()
            sql.AppendLine("DECLARE @ImpiantiValidi TABLE( ")
            sql.AppendLine("	PIVA NVARCHAR(25) ")
            sql.AppendLine("	, Sa_Cod INT ")
            sql.AppendLine("	, Appezza INT ")
            sql.AppendLine("	, Campo_Cod INT ")
            sql.AppendLine("	, Id_Reg INT ")
            sql.AppendLine("	, Progetto_Cod INT ")
            sql.AppendLine("	, Veg_Cod INT ")
            sql.AppendLine("	, Cul_Cod INT ")
            sql.AppendLine("	, Grfi_Cod INT ")
            sql.AppendLine("	, Grva_Cod INT ")
            sql.AppendLine("	, Tecn_Cod INT ")
            sql.AppendLine("	, Port_Cod INT ")
            sql.AppendLine("	, Imp_Cod INT ")
            sql.AppendLine("	, Cop_Cod INT ")
            sql.AppendLine("	, Superficie FLOAT ")
            sql.AppendLine("	, Validita_Inizio DATETIME ")
            sql.AppendLine("	, Validita_Fine DATETIME ")
            sql.AppendLine("	, Irri_Veg_Cod INT ")
            sql.AppendLine("	, Irri_Veg_Des VARCHAR(MAX) ")
            sql.AppendLine("	, Irri_Imp_Cod INT ")
            sql.AppendLine("	, Irri_Imp_Des VARCHAR(MAX) ")
            sql.AppendLine("	, Irri_Cop_Cod INT ")
            sql.AppendLine("	, Irri_Cop_Des VARCHAR(MAX) ")
            sql.AppendLine("	, FF_Start_Cod INT ")
            sql.AppendLine("	, Mac_Cod INT ")
            sql.AppendLine("	, Mac_Imp_Cod INT ")
            sql.AppendLine("	, Portata FLOAT ")
            sql.AppendLine("	, DataInizioImpianto DATETIME ")
            sql.AppendLine("	, DataSeminaPrevista DATETIME ")
            sql.AppendLine("	, DataSemina DATETIME ")
            sql.AppendLine("	, DataStart DATETIME ")
            sql.AppendLine("	, Irrigazioni VARCHAR(MAX) ")
            sql.AppendLine("	, Fertilizzazioni VARCHAR(MAX) ")
            sql.AppendLine("	, FertiRecipe VARCHAR(MAX) ")
            sql.AppendLine("	, StazioneMeteo VARCHAR(MAX) ")
            sql.AppendLine("	, Sabbia FLOAT ")
            sql.AppendLine("	, Limo FLOAT ")
            sql.AppendLine("	, Argilla FLOAT ")
            sql.AppendLine("	, Indirizzo_Cod INT ")
            sql.AppendLine(") ")
            sql.AppendLine("INSERT INTO @ImpiantiValidi ")
            sql.AppendLine("SELECT ")
            sql.AppendLine("	piva ")
            sql.AppendLine("	, sa_cod ")
            sql.AppendLine("	, appezza ")
            sql.AppendLine("	, Campo_Cod ")
            sql.AppendLine("	, id_reg ")
            sql.AppendLine("	, progetto_cod ")
            sql.AppendLine("	, Veg_Cod ")
            sql.AppendLine("	, CUL_COD ")
            sql.AppendLine("	, GRFI_COD ")
            sql.AppendLine("	, GRVA_COD_VEG ")
            sql.AppendLine("	, TECN_COD ")
            sql.AppendLine("	, PORT_COD ")
            sql.AppendLine("	, imp_cod ")
            sql.AppendLine("	, COP_COD ")
            sql.AppendLine("	, Superficie = Sup_Imp ")
            sql.AppendLine("	, Validita_Inizio ")
            sql.AppendLine("	, Validita_Fine ")
            sql.AppendLine("	, Irri_Veg_Cod = NULL ")
            sql.AppendLine("	, Irri_Veg_Des = NULL ")
            sql.AppendLine("	, Irri_Imp_Cod = NULL ")
            sql.AppendLine("	, Irri_Imp_Des = NULL ")
            sql.AppendLine("	, Irri_Cop_Cod = NULL ")
            sql.AppendLine("	, Irri_Cop_Des = NULL ")
            sql.AppendLine("	, FF_Start_Cod = Cod_SS ")
            sql.AppendLine("	, Mac_Cod ")
            sql.AppendLine("	, Mac_imp_cod ")
            sql.AppendLine("	, Portata ")
            sql.AppendLine("	, DataInizioImpianto = Validita_Inizio ")
            sql.AppendLine("	, DataSeminaPrevista = Data_Inizio_Prevista ")
            sql.AppendLine("	, DataSemina = NULL ")
            sql.AppendLine("	, DataStart = NULL ")
            sql.AppendLine("	, Irrigazioni = NULL ")
            sql.AppendLine("	, Fertilizzazioni = NULL ")
            sql.AppendLine("	, FertiRecipe = NULL ")
            sql.AppendLine("	, StazioneMeteo = NULL ")
            sql.AppendLine("	, Sabbia = NULL ")
            sql.AppendLine("	, Limo = NULL ")
            sql.AppendLine("	, Argilla = NULL ")
            sql.AppendLine("	, Indirizzo_Cod = NULL ")
            sql.AppendLine("FROM ( ")
            sql.AppendLine("	SELECT ")
            sql.AppendLine("		imp.piva ")
            sql.AppendLine("		, imp.sa_cod ")
            sql.AppendLine("		, imp.appezza ")
            sql.AppendLine("		, app.Campo_Cod ")
            sql.AppendLine("		, imp.id_reg ")
            sql.AppendLine("		, iprog.progetto_cod ")
            sql.AppendLine("		, cult.Veg_Cod ")
            sql.AppendLine("		, imp.CUL_COD ")
            sql.AppendLine("		, imp.GRFI_COD ")
            sql.AppendLine("		, imp.GRVA_COD_VEG ")
            sql.AppendLine("		, imp.TECN_COD ")
            sql.AppendLine("		, imp.PORT_COD ")
            sql.AppendLine("		, imp.imp_cod ")
            sql.AppendLine("		, imp.COP_COD ")
            sql.AppendLine("		, imp.Sup_Imp ")
            sql.AppendLine("		, pm.Mac_Cod ")
            sql.AppendLine("		, Mac_imp_cod = pm.imp_cod ")
            sql.AppendLine("		, pm.Portata ")
            sql.AppendLine("		, iprog.Validita_Inizio ")
            sql.AppendLine("		, iprog.Validita_Fine ")
            sql.AppendLine("		, iprog.Data_Inizio_Prevista ")
            sql.AppendLine("		, ss.Cod_SS ")
            sql.AppendLine("		, Pos = ROW_NUMBER() OVER (PARTITION BY imp.PIVA, imp.Sa_Cod, imp.Appezza, imp.Id_Reg ORDER BY imp.PIVA, imp.Sa_Cod, imp.Appezza, imp.Id_Reg) ")
            sql.AppendLine("	FROM Reg_Impianti imp ")
            sql.AppendLine("	INNER JOIN appezzamento app ON app.PIVA = imp.PIVA AND app.SA_COD = imp.SA_COD AND app.APPEZZA = imp.APPEZZA ")
            sql.AppendLine("	INNER JOIN Imprese_Progetti iprog ON iprog.piva = imp.piva AND iprog.sa_cod = imp.sa_cod AND iprog.appezza = imp.appezza AND iprog.id_reg = imp.id_reg ")
            sql.AppendLine("	INNER JOIN Cultivar cult ON cult.Cul_Cod = imp.CUL_COD ")
            sql.AppendLine("	LEFT JOIN SpecieVegetaliXStadiCrescita ss ON ss.Veg_Cod = cult.Veg_Cod AND ss.Flag_RipresaVegetativa = 1 ")
            sql.AppendLine("	LEFT JOIN Stadi_Crescita_BBCH sc ON ss.ID_BBCH = sc.ID_BBCH ")
            sql.AppendLine("	LEFT JOIN Reg_ImpiantiXParcoMacchine impxpm ON imp.flagImpiantoIsMacchina = 1 AND impxpm.PIVA = imp.PIVA AND impxpm.SA_COD = imp.SA_COD AND impxpm.APPEZZA = imp.APPEZZA AND impxpm.ID_Reg = imp.ID_Reg ")
            sql.AppendLine("	LEFT JOIN Parco_Macchine pm ON pm.Mac_Cod = impxpm.Mac_Cod ")
            sql.AppendLine("	WHERE imp.Piva = @PIVA AND imp.[USER] = @PIVA_SUPERUSER ")
            sql.AppendLine("		AND iprog.Validita_inizio <= GETDATE() AND GETDATE() <= iprog.Validita_Fine ")
            sql.AppendLine("		AND (@CNT = 0 OR (imp.SA_COD IN (SELECT * FROM @tbl))) ")

            If sa_cod > 0 Then
                sql.AppendLine("		AND imp.SA_COD = @SA_COD")
            End If

            If appezza > 0 Then
                sql.AppendLine("		AND imp.APPEZZA = @APPEZZA")
            End If

            If id_reg > 0 Then
                sql.AppendLine("		AND imp.ID_REG = @ID_REG")
            End If

            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    sql.AppendLine("		AND imp.Inviato >= 0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    sql.AppendLine("		AND imp.Inviato = -1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select

            sql.AppendLine(") T WHERE Pos = 1 ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("/*******************************************")
            sql.AppendLine("TRASCODIFICA SPECIE VEGETALI ")
            sql.AppendLine("********************************************/")
            sql.AppendLine()
            sql.AppendLine("DECLARE @TBL_TX_VEGCOD_NOTIRR TABLE(GIAS_Veg_Cod INT, GIAS_Grfi_Cod INT, GIAS_Grva_Cod INT, Cli_Veg_Cod INT, Cli_Cul_Cod INT, Cli_Veg_Des VARCHAR(MAX))")
            sql.AppendLine("INSERT INTO @TBL_TX_VEGCOD_NOTIRR")
            sql.AppendLine("SELECT Veg_cod, Grfi_cod, Grva_cod, Veg_Cod_Cliente, Cul_Cod_Cliente, Veg_Des_Cliente")
            sql.AppendLine("    FROM Codifica_SpecieVegetali_Clienti svc")
            sql.AppendLine("    INNER JOIN SpecieVegetaliNonIrrigabili nirr ON nirr.VegCod = svc.Veg_Cod")
            sql.AppendLine("        AND (CASE nirr.CulCod WHEN 0 THEN svc.Cul_cod ELSE nirr.CulCod END) = svc.Cul_cod")
            sql.AppendLine("        AND (CASE nirr.GrfiCod WHEN 0 THEN svc.Grfi_cod ELSE nirr.GrfiCod END) = svc.Grfi_cod")
            sql.AppendLine("        AND (CASE nirr.GrvaCod WHEN 0 THEN svc.Grva_cod ELSE nirr.GrvaCod END) = svc.Grva_cod")
            sql.AppendLine("        AND (CASE nirr.GrspCod WHEN 0 THEN svc.Grsp_cod ELSE nirr.GrspCod END) = svc.Grsp_cod")
            sql.AppendLine("        AND (CASE nirr.MetodoProduzioneCod WHEN 0 THEN svc.Metodo_Produzione_cod ELSE nirr.MetodoProduzioneCod END) = svc.Metodo_Produzione_cod")
            sql.AppendLine("        AND (CASE nirr.RegCod WHEN 0 THEN svc.Reg_cod ELSE nirr.RegCod END) = svc.Reg_cod")
            sql.AppendLine("        AND (CASE nirr.IdCod WHEN 0 THEN svc.Id_cod ELSE nirr.IdCod END) = svc.Id_cod")
            sql.AppendLine("    WHERE svc.Codice_Cliente = 2116")
            sql.AppendLine()
            sql.AppendLine("DECLARE @TBL_TX_VEGCOD TABLE(GIAS_Veg_Cod INT, GIAS_Grfi_Cod INT, GIAS_Grva_Cod INT, Cli_Veg_Cod INT, Cli_Cul_Cod INT, Cli_Veg_Des VARCHAR(MAX)) ")
            sql.AppendLine("INSERT INTO @TBL_TX_VEGCOD ")
            sql.AppendLine("    SELECT Veg_cod, Grfi_cod, Grva_cod, Veg_Cod_Cliente, Cul_Cod_Cliente, Veg_Des_Cliente ")
            sql.AppendLine("    FROM Codifica_SpecieVegetali_Clienti ")
            sql.AppendLine("    WHERE Codice_Cliente = 2116 ")
            sql.AppendLine("EXCEPT")
            sql.AppendLine("    SELECT * FROM @TBL_TX_VEGCOD_NOTIRR")
            sql.AppendLine()
            sql.AppendLine("--Match con Veg_Cod, Grfi_Cod e Grva_Cod ")
            sql.AppendLine("UPDATE iv SET iv.Irri_Veg_Cod = tx.Cli_Veg_Cod, iv.Irri_Veg_Des = tx.Cli_Veg_Des ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN ")
            sql.AppendLine("( ")
            sql.AppendLine("	SELECT * FROM ( ")
            sql.AppendLine("		SELECT GIAS_Veg_Cod, GIAS_Grfi_Cod, GIAS_Grva_Cod, Cli_Veg_Cod, Cli_Veg_Des, Pos = ROW_NUMBER() OVER (PARTITION BY GIAS_Veg_Cod, GIAS_Grfi_Cod, GIAS_Grva_Cod ORDER BY GIAS_Veg_Cod, GIAS_Grfi_Cod, GIAS_Grva_Cod, Cli_Veg_Cod) ")
            sql.AppendLine("		FROM @TBL_TX_VEGCOD ")
            sql.AppendLine("	) T WHERE Pos = 1 ")
            sql.AppendLine(") tx ON tx.GIAS_Veg_Cod = iv.Veg_Cod AND tx.GIAS_Grfi_Cod = iv.Grfi_Cod AND tx.GIAS_Grva_Cod = iv.Grva_Cod ")
            sql.AppendLine("WHERE iv.Irri_Veg_Cod IS NULL ")
            sql.AppendLine()
            sql.AppendLine("--Match con Veg_Cod e Grfi_Cod ")
            sql.AppendLine("UPDATE iv SET iv.Irri_Veg_Cod = tx.Cli_Veg_Cod, iv.Irri_Veg_Des = tx.Cli_Veg_Des ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN ")
            sql.AppendLine("( ")
            sql.AppendLine("	SELECT * FROM ( ")
            sql.AppendLine("		SELECT GIAS_Veg_Cod, GIAS_Grfi_Cod, Cli_Veg_Cod, Cli_Veg_Des, Pos = ROW_NUMBER() OVER (PARTITION BY GIAS_Veg_Cod, GIAS_Grfi_Cod ORDER BY GIAS_Veg_Cod, GIAS_Grfi_Cod, Cli_Veg_Cod) ")
            sql.AppendLine("		FROM @TBL_TX_VEGCOD ")
            sql.AppendLine("	) T WHERE Pos = 1 ")
            sql.AppendLine(") tx ON tx.GIAS_Veg_Cod = iv.Veg_Cod AND tx.GIAS_Grfi_Cod = iv.Grfi_Cod ")
            sql.AppendLine("WHERE iv.Irri_Veg_Cod IS NULL ")
            sql.AppendLine()
            sql.AppendLine("--Match con Veg_Cod e Grva_Cod ")
            sql.AppendLine("UPDATE iv SET iv.Irri_Veg_Cod = tx.Cli_Veg_Cod, iv.Irri_Veg_Des = tx.Cli_Veg_Des ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN ")
            sql.AppendLine("( ")
            sql.AppendLine("	SELECT * FROM ( ")
            sql.AppendLine("		SELECT GIAS_Veg_Cod, GIAS_Grva_Cod, Cli_Veg_Cod, Cli_Veg_Des, Pos = ROW_NUMBER() OVER (PARTITION BY GIAS_Veg_Cod, GIAS_Grva_Cod ORDER BY GIAS_Veg_Cod, GIAS_Grva_Cod, Cli_Veg_Cod) ")
            sql.AppendLine("		FROM @TBL_TX_VEGCOD ")
            sql.AppendLine("	) T WHERE Pos = 1 ")
            sql.AppendLine(") tx ON tx.GIAS_Veg_Cod = iv.Veg_Cod AND tx.GIAS_Grva_Cod = iv.Grva_Cod ")
            sql.AppendLine("WHERE iv.Irri_Veg_Cod IS NULL")
            sql.AppendLine()
            sql.AppendLine("--Match con Veg_Cod ")
            sql.AppendLine("UPDATE iv SET iv.Irri_Veg_Cod = tx.Cli_Veg_Cod, iv.Irri_Veg_Des = tx.Cli_Veg_Des ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN ")
            sql.AppendLine("( ")
            sql.AppendLine("	SELECT * FROM ( ")
            sql.AppendLine("		SELECT GIAS_Veg_Cod, Cli_Veg_Cod, Cli_Veg_Des, Pos = ROW_NUMBER() OVER (PARTITION BY GIAS_Veg_Cod ORDER BY GIAS_Veg_Cod, Cli_Veg_Cod) ")
            sql.AppendLine("		FROM @TBL_TX_VEGCOD ")
            sql.AppendLine("	) T WHERE Pos = 1 ")
            sql.AppendLine(") tx ON tx.GIAS_Veg_Cod = iv.Veg_Cod ")
            sql.AppendLine("WHERE iv.Irri_Veg_Cod IS NULL ")
            sql.AppendLine()
            sql.AppendLine("DELETE FROM @ImpiantiValidi WHERE Irri_Veg_Cod IS NULL ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("/*******************************************")
            sql.AppendLine("TRASCODIFICA IMPIANTI IRRIGUI")
            sql.AppendLine("********************************************/")
            sql.AppendLine()
            sql.AppendLine("UPDATE iv SET iv.Irri_Imp_Cod = tx.Imp_Cod_Cliente, iv.Irri_Imp_Des = tx.Imp_Des_Cliente ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN Codifica_ImpiantiIrrigui_Clienti tx ON tx.Imp_cod = COALESCE(iv.Mac_Imp_cod, iv.Imp_cod) AND tx.Codice_Cliente = 2116 ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("/*******************************************")
            sql.AppendLine("TRASCODIFICA COPERTURA")
            sql.AppendLine("********************************************/")
            sql.AppendLine()
            sql.AppendLine("UPDATE iv SET iv.Irri_Cop_Cod = tx.Cop_Cod_Cliente, iv.Irri_Cop_Des = tx.Cop_Des_Cliente ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("LEFT JOIN Codifica_Coperture_Clienti tx ON tx.Cop_cod = iv.Cop_Cod AND Codice_Cliente = 2116 ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("/*******************************************")
            sql.AppendLine("OPERAZIONE DI SEMINA/TRAPIANTO")
            sql.AppendLine("********************************************/")
            sql.AppendLine()
            sql.AppendLine("UPDATE iv SET iv.DataSemina = T.DataSemina ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN ( ")
            sql.AppendLine("	SELECT iv.PIVA, iv.Sa_Cod, iv.Appezza, iv.Id_Reg, DataSemina = m.Data_Movimento, Pos = ROW_NUMBER() OVER (PARTITION BY iv.PIVA, Iv.Sa_Cod, iv.Appezza, iv.Id_Reg ORDER BY m.Data_Movimento DESC) ")
            sql.AppendLine("	FROM Agenda a ")
            sql.AppendLine("	INNER JOIN Movimenti m ON m.PIVA = a.PIVA AND m.Sa_Cod = a.Sa_Cod AND m.Id_Agenda = a.Id_Agenda ")
            sql.AppendLine("	INNER JOIN Movimenti_dettagli d ON d.PIVA = m.PIVA AND d.Sa_Cod = m.Sa_Cod AND d.Id_Agenda = m.Id_Agenda AND d.Id_Mov = m.Id_Mov ")
            sql.AppendLine("	INNER JOIN Mov_Destinazioni s ON s.Piva = d.PIVA AND s.Sa_Cod = d.Sa_Cod AND s.Id_Agenda = d.Id_Agenda AND s.Id_Mov = d.Id_Mov AND s.Id_Mov_Det = d.Id_Mov_Det ")
            sql.AppendLine("	INNER JOIN @ImpiantiValidi iv ON iv.PIVA = a.PIVA AND iv.Sa_Cod = a.sa_cod AND iv.Appezza = s.appezza AND iv.id_reg = s.Id_Destinazione ")
            sql.AppendLine($"	WHERE m.Cau_Mov = '{CAU_LAVORAZIONE}' ")
            sql.AppendLine($"		AND a.Lav_Cod IN ({String.Join(", ", New Integer() {LAVCOD_SEMINA, LAVCOD_TRAPIANTO, LAVCOD_SOVESCIO, LAVCOD_SOD_SEDDING})}) ")
            sql.AppendLine(") T ON T.PIVA = iv.PIVA AND T.Sa_Cod = iv.Sa_Cod AND T.Appezza = iv.Appezza AND T.Id_Reg = iv.Id_Reg AND T.Pos = 1 ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("/*******************************************")
            sql.AppendLine("RILIEVO FASE FENOLOGICA DATA START")
            sql.AppendLine("********************************************/")
            sql.AppendLine()
            sql.AppendLine("UPDATE iv SET iv.DataStart = s.validita_inizio ")
            sql.AppendLine("FROM Agenda a ")
            sql.AppendLine("INNER JOIN Movimenti m ON m.PIVA = a.PIVA AND m.Sa_Cod = a.Sa_Cod AND m.Id_Agenda = a.Id_Agenda ")
            sql.AppendLine("INNER JOIN Movimenti_dettagli d ON d.PIVA = m.PIVA AND d.Sa_Cod = m.Sa_Cod AND d.Id_Agenda = m.Id_Agenda AND d.Id_Mov = m.Id_Mov ")
            sql.AppendLine("INNER JOIN Mov_Destinazioni s ON s.Piva = d.PIVA AND s.Sa_Cod = d.Sa_Cod AND s.Id_Agenda = d.Id_Agenda AND s.Id_Mov = d.Id_Mov AND s.Id_Mov_Det = d.Id_Mov_Det ")
            sql.AppendLine("INNER JOIN Mov_Dettaglio_Tecnico t ON t.Piva = a.PIVA AND t.Id_Agenda = a.Id_Agenda ")
            sql.AppendLine("INNER JOIN @ImpiantiValidi iv ON iv.PIVA = a.PIVA AND iv.Sa_Cod = a.sa_cod AND iv.Appezza = s.appezza AND iv.id_reg = s.Id_Destinazione ")
            sql.AppendLine("	AND iv.FF_Start_Cod = t.FF_Classe AND iv.Validita_Inizio <= s.validita_inizio AND s.validita_inizio <= iv.Validita_Fine ")
            sql.AppendLine($"WHERE m.Cau_Mov = '{CAU_RILIEVO_CAMPO}' ")
            sql.AppendLine($"	AND a.Lav_Cod = {LAVCOD_FASI_FENOLOGICHE} ")
            sql.AppendLine("	AND t.FF_Classe <> 0 ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("/*******************************************")
            sql.AppendLine("IRRIGAZIONI")
            sql.AppendLine("********************************************/")
            sql.AppendLine()
            sql.AppendLine(";WITH Irrigazioni_CTE AS ( ")
            sql.AppendLine("	SELECT ")
            sql.AppendLine("		a.PIVA ")
            sql.AppendLine("		, a.sa_cod ")
            sql.AppendLine("		, s.appezza ")
            sql.AppendLine("		, id_reg = s.id_destinazione ")
            sql.AppendLine("		, DataIrrigazione = m.Data_Movimento ")
            sql.AppendLine("		, irri_m3_x_ha = s.Qta ")
            sql.AppendLine("		, Superficie ")
            sql.AppendLine("	FROM Agenda a ")
            sql.AppendLine("	INNER JOIN Movimenti m ON m.PIVA = a.PIVA AND m.Sa_Cod = a.Sa_Cod AND m.Id_Agenda = a.Id_Agenda ")
            sql.AppendLine("	INNER JOIN Movimenti_dettagli d ON d.PIVA = m.PIVA AND d.Sa_Cod = m.Sa_Cod AND d.Id_Agenda = m.Id_Agenda AND d.Id_Mov = m.Id_Mov ")
            sql.AppendLine("	INNER JOIN Mov_Destinazioni s ON s.Piva = d.PIVA AND s.Sa_Cod = d.Sa_Cod AND s.Id_Agenda = d.Id_Agenda AND s.Id_Mov = d.Id_Mov AND s.Id_Mov_Det = d.Id_Mov_Det ")
            sql.AppendLine("	INNER JOIN @ImpiantiValidi iv ON iv.PIVA = a.PIVA AND iv.Sa_Cod = a.Sa_Cod AND iv.Appezza = s.Appezza AND iv.id_reg = s.Id_Destinazione ")
            sql.AppendLine($"	WHERE a.PIVA = @PIVA AND m.Cau_Mov = '{CAU_LAVORAZIONE}' ")
            sql.AppendLine($"		AND a.Lav_Cod IN ({String.Join(", ", New Integer() {LAVCOD_IRRIGAZIONE, LAVCOD_FERTIRRIGAZIONE})}) ")
            sql.AppendLine("		AND Superficie > 0 ")
            sql.AppendLine(") ")
            sql.AppendLine()
            sql.AppendLine("UPDATE iv SET iv.Irrigazioni = T.Irrigazioni ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN ( ")
            sql.AppendLine("	SELECT DISTINCT piva, sa_cod, appezza, id_reg, Irrigazioni = '[' + ")
            sql.AppendLine("		STUFF( ")
            sql.AppendLine("		(SELECT ',{""DataIrri"": ""' + CONVERT(VARCHAR(25), DataIrrigazione, 23) + '"", ""VolumeMM"": ' + CAST(irri_m3_x_ha * 0.1 / Superficie AS VARCHAR(15)) + ' }' ")
            sql.AppendLine("		FROM Irrigazioni_CTE i0 ")
            sql.AppendLine("		WHERE i0.PIVA = i1.PIVA AND i0.sa_cod = i1.Sa_Cod AND i0.appezza = i1.Appezza AND i0.id_reg = i1.id_reg ")
            sql.AppendLine("		ORDER BY DataIrrigazione ")
            sql.AppendLine("		FOR XML PATH ('')), 1, 1, '') ")
            sql.AppendLine("		+ ']' ")
            sql.AppendLine("	FROM Irrigazioni_CTE i1 ")
            sql.AppendLine(") T ON T.PIVA = iv.PIVA AND T.Sa_Cod = iv.Sa_Cod AND T.Appezza = iv.Appezza AND T.id_reg = iv.Id_Reg ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("/*******************************************")
            sql.AppendLine("FERTILIZZAZIONI")
            sql.AppendLine("********************************************/")
            sql.AppendLine()
            sql.AppendLine("IF @FLAGFERTI = 1 ")
            sql.AppendLine("BEGIN ")
            sql.AppendLine("	;WITH Fertilizzazioni_CTE AS ( ")
            sql.AppendLine("		SELECT ")
            sql.AppendLine("			MDI.piva ")
            sql.AppendLine("			, MDI.sa_cod ")
            sql.AppendLine("			, MDI.Appezza ")
            sql.AppendLine("			, Id_Reg = MDI.Id_Destinazione ")
            sql.AppendLine("			, TitoloN = F.N")
            sql.AppendLine("			, TitoloP = F.P2O5 ")
            sql.AppendLine("			, TitoloK = F.K2O ")
            sql.AppendLine("			, DoseKg = MDI.Qta ")
            sql.AppendLine("			, NomeCommercialeDescri = F.Fer_Des ")
            sql.AppendLine("			, [Data] = M.Data_Movimento ")
            sql.AppendLine("		FROM Mov_Destinazioni MDI ")
            sql.AppendLine("		INNER JOIN @ImpiantiValidi iv ON iv.PIVA = MDI.piva AND iv.Sa_Cod = MDI.Sa_Cod AND iv.Appezza = MDI.Appezza AND iv.Id_Reg = MDI.Id_Destinazione ")
            sql.AppendLine("		INNER JOIN Movimenti M ON M.Id_Mov = MDI.Id_Mov ")
            sql.AppendLine("		INNER JOIN Agenda A ON MDI.Id_Agenda = A.Id_Agenda ")
            sql.AppendLine("		INNER JOIN Movimenti_dettagli MDet ON MDet.Id_Mov = MDI.Id_Mov And MDet.Id_Mov_Det = MDI.Id_Mov_Det ")
            sql.AppendLine("		INNER JOIN Fertilizzanti F ON MDet.Pro_Cod = F.Fer_Cod ")
            sql.AppendLine($"		WHERE M.Cau_Mov = '{CAU_LAVORAZIONE}'")
            sql.AppendLine($"			AND	A.Lav_Cod In ({String.Join(", ", New Integer() {LAVCOD_FERTIRRIGAZIONE, LAVCOD_DISTRIBUZIONE_CONCIME, LAVCOD_CONCIMAZIONE_FOGLIARE, LAVCOD_DISTRIBUZIONE_AMMENDANTI, LAVCOD_SARCHIATURA_CONCIMAZIONE, LAVCOD_TRATTAMENTO_ANTIBUTTERATURA})}) ")
            sql.AppendLine("			AND MDet.Elem_Cod = 3 ")
            sql.AppendLine("	)")
            sql.AppendLine()
            sql.AppendLine("	UPDATE iv SET iv.Fertilizzazioni = T.Fertilizzazioni ")
            sql.AppendLine("	FROM @ImpiantiValidi iv")
            sql.AppendLine("	INNER JOIN (")
            sql.AppendLine("		SELECT DISTINCT piva, sa_cod, appezza, id_reg, Fertilizzazioni = '[' + ")
            sql.AppendLine("			STUFF( ")
            sql.AppendLine("			(SELECT ")
            sql.AppendLine("				',{""TitoloN"": ' + CAST(TitoloN AS VARCHAR(12)) + ")
            sql.AppendLine("				', ""TitoloP"": ' + CAST(TitoloP AS VARCHAR(12)) + ")
            sql.AppendLine("				', ""TitoloK"": ' + CAST(TitoloK AS VARCHAR(12)) + ")
            sql.AppendLine("				', ""DoseKg"": ' + CAST(DoseKg AS VARCHAR(12)) + ")
            sql.AppendLine("				', ""NomeCommercialeDescri"": ""' + NomeCommercialeDescri + '""' + ")
            sql.AppendLine("				', ""Data"": ""' + CONVERT(VARCHAR(25), [Data], 23) + '""}' ")
            sql.AppendLine("			FROM Fertilizzazioni_CTE f0")
            sql.AppendLine("			WHERE f0.PIVA = f1.PIVA AND f0.sa_cod = f1.Sa_Cod AND f0.appezza = f1.Appezza AND f0.id_reg = f1.id_reg ")
            sql.AppendLine("			ORDER BY [Data]")
            sql.AppendLine("			FOR XML PATH ('')), 1, 1, '') ")
            sql.AppendLine("			+ ']' ")
            sql.AppendLine("		FROM Fertilizzazioni_CTE f1")
            sql.AppendLine("	) T ON T.PIVA = iv.PIVA AND T.Sa_Cod = iv.Sa_Cod AND T.Appezza = iv.Appezza AND T.id_reg = iv.Id_Reg")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine(";WITH NPK_CTE AS ( ")
            sql.AppendLine("		SELECT iv.PIVA, iv.Sa_Cod, iv.Appezza, iv.Id_Reg ")
            sql.AppendLine("			, N_Ammesso = CAST(REPLACE(N.val_Cod, ',', '.') AS FLOAT) ")
            sql.AppendLine("			, P_Ammesso = CAST(REPLACE(P.val_Cod, ',', '.') AS FLOAT) ")
            sql.AppendLine("			, K_Ammesso = CAST(REPLACE(K.val_Cod, ',', '.') AS FLOAT) ")
            sql.AppendLine("		FROM @ImpiantiValidi iv ")
            sql.AppendLine("		INNER JOIN ( ")
            sql.AppendLine("			SELECT ric.PIVA, ric.sa_cod, ric.appezza, ric.Id_Reg, val_cod ")
            sql.AppendLine($"			FROM Reg_Impianti_Codici ric WHERE id_cod = {CInt(enum_CodiciAnagrafe.Impianto_LimiteN)} ")
            sql.AppendLine("		) N ON iv.PIVA = N.PIVA AND iv.SA_COD = N.sa_cod AND iv.Appezza = N.appezza AND iv.ID_REG = N.Id_Reg ")
            sql.AppendLine("		INNER JOIN ( ")
            sql.AppendLine("			SELECT ric.PIVA, ric.sa_cod, ric.appezza, ric.Id_Reg, val_cod ")
            sql.AppendLine($"			FROM Reg_Impianti_Codici ric WHERE id_cod = {CInt(enum_CodiciAnagrafe.Impianto_LimiteP)} ")
            sql.AppendLine("		) P ON iv.PIVA = P.PIVA AND iv.SA_COD = P.sa_cod AND iv.Appezza = P.appezza AND iv.ID_REG = P.Id_Reg ")
            sql.AppendLine("		INNER JOIN ( ")
            sql.AppendLine("			SELECT ric.PIVA, ric.sa_cod, ric.appezza, ric.Id_Reg, val_cod ")
            sql.AppendLine($"			FROM Reg_Impianti_Codici ric WHERE id_cod = {CInt(enum_CodiciAnagrafe.Impianto_LimiteK)} ")
            sql.AppendLine("		) K ON iv.PIVA = K.PIVA AND iv.SA_COD = K.sa_cod AND iv.Appezza = K.appezza AND iv.ID_REG = K.Id_Reg ")
            sql.AppendLine("	) ")
            sql.AppendLine()
            sql.AppendLine("	UPDATE iv SET iv.FertiRecipe = T.JSON_NPK")
            sql.AppendLine("	FROM @ImpiantiValidi iv")
            sql.AppendLine("	INNER JOIN (")
            sql.AppendLine("		SELECT ")
            sql.AppendLine("			PIVA, Sa_Cod, Appezza, Id_Reg, JSON_NPK = '{""N_Ammesso"": ' + CAST(N_Ammesso AS VARCHAR(15)) + ', ""P_Ammesso"": ' + CAST(P_Ammesso AS VARCHAR(15)) + ', ""K_Ammesso"": ' + CAST(K_Ammesso AS VARCHAR(15)) + '}' ")
            sql.AppendLine("		FROM NPK_CTE")
            sql.AppendLine("	) T ON T.PIVA = iv.PIVA AND T.Sa_Cod = iv.Sa_Cod AND T.Appezza = iv.Appezza AND T.id_reg = iv.Id_Reg")
            sql.AppendLine()
            sql.AppendLine("END ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("/*******************************************")
            sql.AppendLine("STAZIONI METEO CONFIGURATE")
            sql.AppendLine("********************************************/")
            sql.AppendLine()
            sql.AppendLine("UPDATE iv Set iv.StazioneMeteo = T.Stazione ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN ( ")
            sql.AppendLine("	SELECT PIVA, Sa_Cod, Stazione = '{""Sorgente"": ' + CAST(Tipo_Sorgente AS VARCHAR(10)) + ', ""Stazione"": ' + CAST(Stazione_Cod AS VARCHAR(10)) + ' }' ")
            sql.AppendLine("	FROM ( ")
            sql.AppendLine("		SELECT PIVA, Sa_Cod, Tipo_Sorgente, Stazione_Cod, Pos = ROW_NUMBER() OVER (PARTITION BY PIVA, Sa_Cod ORDER BY Stazione_Cod) ")
            sql.AppendLine("		FROM DSS_Stazioni_X_Irriga ")
            sql.AppendLine("	) T WHERE Pos = 1 ")
            sql.AppendLine(") T ON T.PIVA = iv.PIVA AND T.Sa_Cod = iv.Sa_Cod ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("/*******************************************")
            sql.AppendLine("ANALISI DEL TERRENO")
            sql.AppendLine("********************************************/")
            sql.AppendLine()
            sql.AppendLine("DECLARE @TblAnalisi TABLE(PIVA NVARCHAR(25), SA_COD INT, APPEZZA INT, ID_REG INT, Testata_Cod INT) ")
            sql.AppendLine()
            sql.AppendLine("INSERT INTO @TblAnalisi	")
            sql.AppendLine("SELECT iv.PIVA, iv.Sa_Cod, iv.Appezza, iv.Id_Reg, Testata_Cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN Analisi_EntitaxTestata a ON a.Piva = iv.PIVA AND a.Sa_Cod = iv.Sa_Cod AND a.Appezza = iv.Appezza AND a.Id_Imp = iv.Id_Reg AND a.Analisi_Entita_Cod = 5 ")
            sql.AppendLine()
            sql.AppendLine("INSERT INTO @TblAnalisi ")
            sql.AppendLine("SELECT iv.PIVA, iv.Sa_Cod, iv.Appezza, iv.Id_Reg, Testata_Cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("LEFT JOIN @TblAnalisi t ON t.Piva = iv.PIVA AND t.Sa_Cod = iv.Sa_Cod AND t.Appezza = iv.Appezza AND t.ID_REG = iv.Id_Reg ")
            sql.AppendLine("INNER JOIN Analisi_EntitaxTestata a ON a.Piva = iv.PIVA AND a.Sa_Cod = iv.Sa_Cod AND a.Appezza = iv.Appezza AND a.Analisi_Entita_Cod = 4 ")
            sql.AppendLine("WHERE t.PIVA IS NULL ")
            sql.AppendLine()
            sql.AppendLine("INSERT INTO @TblAnalisi ")
            sql.AppendLine("SELECT iv.PIVA, iv.Sa_Cod, iv.Appezza, iv.Id_Reg, Testata_Cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("LEFT JOIN @TblAnalisi t ON t.Piva = iv.PIVA AND t.Sa_Cod = iv.Sa_Cod AND t.Appezza = iv.Appezza AND t.ID_REG = iv.Id_Reg ")
            sql.AppendLine("INNER JOIN Analisi_EntitaxTestata a ON a.Piva = iv.PIVA AND a.Sa_Cod = iv.Sa_Cod AND a.Campo_Cod = iv.Campo_Cod AND a.Analisi_Entita_Cod = 3 ")
            sql.AppendLine("WHERE t.PIVA IS NULL ")
            sql.AppendLine()
            sql.AppendLine("INSERT INTO @TblAnalisi ")
            sql.AppendLine("SELECT iv.PIVA, iv.Sa_Cod, iv.Appezza, iv.Id_Reg, Testata_Cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("LEFT JOIN @TblAnalisi t ON t.Piva = iv.PIVA AND t.Sa_Cod = iv.Sa_Cod AND t.Appezza = iv.Appezza AND t.ID_REG = iv.Id_Reg ")
            sql.AppendLine("INNER JOIN AppezzamentiXParticelle axp ON axp.PIVA = iv.PIVA AND axp.SA_COD = iv.SA_COD AND axp.APPEZZA = iv.APPEZZA ")
            sql.AppendLine("INNER JOIN Analisi_EntitaxTestata a ON a.prov = axp.PROV AND a.Com = axp.COM AND a.Sezione = axp.SEZIONE AND a.Foglio = axp.FOGLIO AND a.Numero = axp.NUMERO AND a.Subalterno = axp.SUBALTERNO AND a.Analisi_Entita_Cod = 7 ")
            sql.AppendLine("WHERE t.PIVA IS NULL ")
            sql.AppendLine()
            sql.AppendLine("INSERT INTO @TblAnalisi ")
            sql.AppendLine("SELECT iv.PIVA, iv.Sa_Cod, iv.Appezza, iv.Id_Reg, Testata_Cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("LEFT JOIN @TblAnalisi t ON t.Piva = iv.PIVA AND t.Sa_Cod = iv.Sa_Cod AND t.Appezza = iv.Appezza AND t.ID_REG = iv.Id_Reg ")
            sql.AppendLine("INNER JOIN Analisi_EntitaxTestata a ON a.Piva = iv.PIVA AND a.Sa_Cod = iv.Sa_Cod AND a.Analisi_Entita_Cod = 2 ")
            sql.AppendLine("WHERE t.PIVA IS NULL ")
            sql.AppendLine()
            sql.AppendLine("INSERT INTO @TblAnalisi ")
            sql.AppendLine("SELECT iv.PIVA, iv.Sa_Cod, iv.Appezza, iv.Id_Reg, Testata_Cod = a.Analisi_Testata_Cod ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("LEFT JOIN @TblAnalisi t ON t.Piva = iv.PIVA AND t.Sa_Cod = iv.Sa_Cod AND t.Appezza = iv.Appezza AND t.ID_REG = iv.Id_Reg ")
            sql.AppendLine("INNER JOIN Analisi_EntitaxTestata a ON a.Piva = iv.PIVA AND a.Analisi_Entita_Cod = 1 ")
            sql.AppendLine("WHERE t.PIVA IS NULL ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("UPDATE iv SET iv.Sabbia = T.Sabbia, iv.Limo = T.Limo, iv.Argilla = T.Argilla ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN ( ")
            sql.AppendLine("	SELECT PIVA, SA_COD, APPEZZA, ID_REG, Sabbia, Limo, Argilla FROM ( ")
            sql.AppendLine("		SELECT ")
            sql.AppendLine("			a.PIVA, a.SA_COD, a.APPEZZA, a.ID_REG ")
            sql.AppendLine("			--, data_analisi = t.Analisi_Testata_Data_Inizio ")
            sql.AppendLine("			, Sabbia = sabbia.Analisi_Dettaglio_Valore_1 ")
            sql.AppendLine("			, Limo = limo.Analisi_Dettaglio_Valore_1 ")
            sql.AppendLine("			, Argilla = argilla.Analisi_Dettaglio_Valore_1 ")
            sql.AppendLine("			, pos = ROW_NUMBER() OVER (PARTITION BY a.PIVA, a.SA_COD, a.APPEZZA, a.ID_REG ORDER BY a.PIVA, a.SA_COD, a.APPEZZA, a.ID_REG, t.Analisi_Testata_Data_Inizio DESC) ")
            sql.AppendLine("		FROM @TblAnalisi a ")
            sql.AppendLine("		INNER JOIN Analisi_Testata t ON t.Analisi_Testata_Cod = a.Testata_Cod ")
            sql.AppendLine($"		INNER JOIN Analisi_Dettagli sabbia ON sabbia.Analisi_SuperUser = t.Analisi_Superuser AND sabbia.Analisi_Testata_Cod = t.Analisi_Testata_Cod AND sabbia.Analisi_Parametro_Cod = {CInt(enum_AnalisiParametri.AnalisiParametri_Sabbia)} ")
            sql.AppendLine($"		LEFT JOIN Analisi_Dettagli limo ON limo.Analisi_Testata_Cod = sabbia.Analisi_Testata_Cod AND limo.Analisi_Parametro_Cod = {CInt(enum_AnalisiParametri.AnalisiParametri_Limo)} ")
            sql.AppendLine($"		LEFT JOIN Analisi_Dettagli argilla ON argilla.Analisi_Testata_Cod = sabbia.Analisi_Testata_Cod AND argilla.Analisi_Parametro_Cod = {CInt(enum_AnalisiParametri.AnalisiParametri_Argilla)} ")
            sql.AppendLine("		WHERE t.Analisi_Testata_Data_Inizio <= GETDATE() AND GETDATE() <= t.Analisi_Testata_Data_Fine ")
            sql.AppendLine("	) T WHERE pos = 1 ")
            sql.AppendLine(") T ON T.PIVA = iv.PIVA AND T.Sa_Cod = iv.Sa_Cod AND T.Appezza = iv.Appezza AND T.id_reg = iv.Id_Reg ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("/*******************************************")
            sql.AppendLine("INDIRIZZI")
            sql.AppendLine("********************************************/")
            sql.AppendLine()
            sql.AppendLine("UPDATE iv set Indirizzo_Cod = axi.cod_indirizzo ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN AppezzamentixIndirizzi axi ON axi.PIVA = iv.PIVA AND axi.sa_cod = iv.sa_cod AND axi.appezza = iv.Appezza ")
            sql.AppendLine()
            sql.AppendLine("UPDATE iv set Indirizzo_Cod = cxi.cod_indirizzo ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("INNER JOIN CentrixIndirizzi cxi ON cxi.PIVA = iv.PIVA AND cxi.sa_cod = iv.sa_cod ")
            sql.AppendLine("WHERE iv.Indirizzo_Cod IS NULL ")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("SELECT ")
            sql.AppendLine("	CUAA = COALESCE(i_c.val_cod, '') ")
            sql.AppendLine("	, Id_Centro = iv.SA_COD ")
            sql.AppendLine("	, Id_Campo = COALESCE(iv.Campo_Cod, 0) ")
            sql.AppendLine("	, Veg_Cod = iv.veg_cod ")
            sql.AppendLine("	, Cul_Cod = iv.cul_cod ")
            sql.AppendLine("	, Centro = centri.sa_nome ")
            sql.AppendLine("	, Campo = COALESCE(campi.campo_des, '') ")
            sql.AppendLine("	, Impianto = app.app_nome ")
            sql.AppendLine("	, Coltura = veg.veg_des ")
            sql.AppendLine("	, Varieta = cul.cul_des ")
            sql.AppendLine("	, GruppoVegetale = grveg.Gru_Des ")
            sql.AppendLine("	, TraFila = sesto.trafila ")
            sql.AppendLine("	, SuFila = sesto.sufila ")
            sql.AppendLine("	, CondTraFila = condu.TECN_DES ")
            sql.AppendLine("	, DataRilievo = iv.DataStart ")
            sql.AppendLine("	, DataSemina = iv.DataSemina ")
            sql.AppendLine("	, DataSeminaPrevista = IIF(iv.DataSeminaPrevista >= iv.Validita_Inizio, iv.DataSeminaPrevista, NULL) ")
            sql.AppendLine("	, DataInizioImpianto = iv.Validita_Inizio ")
            sql.AppendLine("	, Sup_Imp = iv.Superficie ")
            sql.AppendLine("	, Lat = COALESCE(gis.Lat, IIF(COALESCE(app.x, 0) = 0, NULL, app.x), IIF(COALESCE(centri.lat, 0) = 0, NULL, centri.lat)) ")
            sql.AppendLine("	, Lng = COALESCE(gis.Lng, IIF(COALESCE(app.y, 0) = 0, NULL, app.y), IIF(COALESCE(centri.long, 0) = 0, NULL, centri.long)) ")
            sql.AppendLine("	, Indirizzo = indi.Indirizzo ")
            sql.AppendLine("	, Irri_Veg_Cod = iv.Irri_Veg_Cod ")
            sql.AppendLine("	, Irri_Veg_Des = iv.Irri_Veg_Des ")
            sql.AppendLine("	, Irri_Imp_Cod = iv.Irri_Imp_Cod ")
            sql.AppendLine("	, Irri_Imp_Des = iv.Irri_Imp_Des ")
            sql.AppendLine("	, StazioneMeteo = iv.StazioneMeteo ")
            sql.AppendLine("	, Irrigazioni = iv.Irrigazioni ")
            sql.AppendLine("	, Fertilizzazioni = iv.Fertilizzazioni ")
            sql.AppendLine("	, FertiRecipe = iv.FertiRecipe ")
            sql.AppendLine("	, Pendenza = app.PENDE ")
            sql.AppendLine("	, Vigoria = pinn.Port_Vig ")
            sql.AppendLine("	, iv.Sabbia ")
            sql.AppendLine("	, iv.Limo ")
            sql.AppendLine("	, iv.Argilla ")
            sql.AppendLine("	, GIAS_PIva = iv.PIVA ")
            sql.AppendLine("	, GIAS_SaCod = iv.SA_COD ")
            sql.AppendLine("	, GIAS_Appezza = iv.APPEZZA ")
            sql.AppendLine("	, GIAS_IdReg = iv.ID_REG ")
            sql.AppendLine("	, GIAS_ProgettoCod = iv.Progetto_Cod ")
            sql.AppendLine("	, Irri_Plot_Id = appcod.val_cod ")
            sql.AppendLine("	, Irri_Crop_Id = impcod.val_cod ")
            sql.AppendLine("    , iv.Cop_Cod ")
            sql.AppendLine("    , Cop_Cod_Irriframe = iv.Irri_Cop_Cod ")
            sql.AppendLine("    , iv.Mac_Cod ")
            sql.AppendLine("    , iv.Portata ")
            sql.AppendLine("FROM @ImpiantiValidi iv ")
            sql.AppendLine("LEFT JOIN Imprese_Codici i_c ON i_c.PIVA = iv.PIVA AND i_c.id_cod = 1010 ")
            sql.AppendLine("INNER JOIN Appezzamento app ON app.piva = iv.piva AND app.sa_cod = iv.SA_COD AND app.APPEZZA = iv.APPEZZA ")
            sql.AppendLine("INNER JOIN Centri_Aziendali centri ON iv.Sa_Cod = centri.sa_cod AND iv.PIVA = centri.PIVA ")
            sql.AppendLine("LEFT JOIN Campi ON campi.piva = iv.PIVA AND campi.Sa_Cod = iv.sa_cod AND campi.campo_cod = iv.Campo_Cod ")
            sql.AppendLine("INNER JOIN SpecieVegetali veg ON veg.Veg_Cod = iv.Veg_Cod ")
            sql.AppendLine("INNER JOIN Cultivar cul ON cul.Cul_Cod = iv.Cul_Cod ")
            sql.AppendLine("INNER JOIN GruppoVegetale grveg	ON grveg.Gru_Cod = veg.Gru_Cod ")
            sql.AppendLine("LEFT JOIN ( --Sesto impianto ")
            sql.AppendLine("	SELECT T1.PIVA, T1.sa_cod, T1.appezza, T1.Id_Reg, trafila, sufila ")
            sql.AppendLine("	FROM ( ")
            sql.AppendLine("		SELECT PIVA, sa_cod, appezza, Id_Reg, trafila = CAST(REPLACE(val_cod, ',', '.') AS FLOAT) ")
            sql.AppendLine("		FROM Reg_Impianti_Codici ")
            sql.AppendLine($"		WHERE id_cod = {CInt(enum_CodiciAnagrafe.Impianto_TraFila_Maschio)} AND PIVA = @PIVA")
            sql.AppendLine("	) T1")
            sql.AppendLine("	INNER JOIN (")
            sql.AppendLine("		SELECT PIVA, sa_cod, appezza, Id_Reg, sufila = CAST(REPLACE(val_cod, ',', '.') AS FLOAT)")
            sql.AppendLine("		FROM Reg_Impianti_Codici")
            sql.AppendLine($"		WHERE id_cod = {CInt(enum_CodiciAnagrafe.Impianto_SuFila_Maschio)} AND PIVA = @PIVA")
            sql.AppendLine("	) T2 ON T2.PIVA = T1.PIVA AND T2.sa_cod = T1.sa_cod AND T2.appezza = T1.appezza AND T2.Id_Reg = T1.Id_Reg")
            sql.AppendLine(") sesto ON sesto.PIVA = iv.PIVA AND sesto.sa_cod = iv.SA_COD AND sesto.appezza = iv.APPEZZA AND sesto.Id_Reg = iv.ID_REG ")
            sql.AppendLine("LEFT JOIN ConduzioneTerrenoTraFila condu ON condu.GRU_COD = veg.Gru_Cod AND condu.TECN_COD = iv.Tecn_Cod ")
            sql.AppendLine("LEFT JOIN Portinnesti pinn ON pinn.Port_Cod = iv.Port_Cod ")
            sql.AppendLine("LEFT JOIN ( --Coordinate GIS ")
            sql.AppendLine("	SELECT Piva, Sa_Cod, Appezza, Lat = pt.Lat, Lng = pt.Long ")
            sql.AppendLine("	FROM ( ")
            sql.AppendLine("		Select ge.piva, ge.sa_cod, ge.appezza, pt = geg.Poligono_GeoEntity.EnvelopeCenter(), pos = ROW_NUMBER() OVER (PARTITION BY ge.PIVA, ge.SA_COD, ge.Appezza ORDER BY ge.PIVA, ge.SA_COD, ge.APPEZZA, LayerElementiGrafici_Cod DESC) ")
            sql.AppendLine("		FROM Gis_ElementiGrafici geg ")
            sql.AppendLine("		INNER JOIN Gis_Entita ge On ge.Entita_Cod = geg.Entita_Cod ")
            sql.AppendLine("		WHERE ge.Piva = @PIVA AND LayerElementiGrafici_Cod In (1, 19) --1 -> Appezzamenti, 19 -> Impianti ")
            sql.AppendLine("	) T WHERE pos = 1 ")
            sql.AppendLine(") gis On gis.Piva = iv.PIVA And gis.Sa_Cod = iv.SA_COD And gis.Appezza = iv.APPEZZA ")
            sql.AppendLine("LEFT JOIN ( ")
            sql.AppendLine("	Select cod_indirizzo, Indirizzo = '{ ""Indirizzo"": ""' + indi.ind_des + '"", ""Fraz"": ""' + indi.frz_des + '"", ""CAP"": ""' + ISTAT.CAP + '"", ""Comune"": ""' + ISTAT.LOCALITA + '"", ""Prov"": ""' + ISTAT.COMUNI_PROV +'"" }' ")
            sql.AppendLine("	FROM Indirizzi indi ")
            sql.AppendLine("	INNER JOIN ISTAT ON ISTAT.PROV = indi.pro_cod_istat AND ISTAT.COM = indi.com_cod_istat ")
            sql.AppendLine(") indi ON indi.cod_indirizzo = iv.Indirizzo_Cod ")
            sql.AppendLine("LEFT JOIN Appezzamento_Codici appcod ON appcod.PIVA = iv.PIVA AND appcod.sa_cod = iv.SA_COD AND appcod.appezza = iv.APPEZZA AND appcod.id_cod = 2225 ")
            sql.AppendLine("LEFT JOIN Reg_Impianti_Codici impcod ON impcod.PIVA = iv.PIVA AND impcod.sa_cod = iv.SA_COD AND impcod.appezza = iv.APPEZZA AND impcod.Id_Reg = iv.ID_REG AND impcod.id_cod = 2225 ")

            DT = EseguiQuery_Lettura(objParametri, sql.ToString, NomeRoutine)

        Catch ex As Exception

            Dim MessaggioErrore As String = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing

            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT
    End Function

    Public Function Leggi_x_DSS_Difesa(Piva As String, vegcod_flt As Integer(), ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_x_DSS_Difesa()"
        Dim DT As DataTable

        Try

            Dim sql As New System.Text.StringBuilder

            sql.Clear()

            sql.AppendLine("SET NOCOUNT ON")
            sql.AppendLine()
            sql.AppendLine("DECLARE @PIVA_SUPERUSER VARCHAR(25) = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "'")
            sql.AppendLine("DECLARE @PIVA VARCHAR(25) = '" & Agro_SQL_SaveText(Piva) & "'")
            sql.AppendLine("DECLARE @USER VARCHAR(MAX) = '" & Agro_SQL_SaveText(objParametri.UtenteUsername) & "'")
            sql.AppendLine("DECLARE @DATAVAL DATETIME = GETDATE()")
            sql.AppendLine()
            sql.AppendLine("DECLARE @VEGCOD_FLTTBL TABLE(Veg_Cod INTEGER)")
            If vegcod_flt.Length > 0 Then
                sql.AppendLine("INSERT INTO @VEGCOD_FLTTBL VALUES")
                sql.AppendLine(String.Join("," & vbCrLf, vegcod_flt.Select(Function(i) "(" & i.ToString() & ")")))
            End If
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("DECLARE @TBL TABLE(SA_COD INT)")
            sql.AppendLine("INSERT INTO @TBL")
            sql.AppendLine("SELECT Sa_cod FROM Utenti_Visibilita_Appoggio (NOLOCK) ")
            sql.AppendLine("WHERE PivaSuperUser = @PIVA_SUPERUSER AND Username = @USER AND Piva = @PIVA AND Entita_Cod = 2 --Centro")
            sql.AppendLine()
            sql.AppendLine("DECLARE @CNT INT = (SELECT COUNT(*) FROM @TBL)")
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("; WITH IMPIANTI_VALIDI_CTE AS ( ")
            sql.AppendLine("	SELECT PIVA, SA_COD, APPEZZA, ID_REG ")
            sql.AppendLine("	FROM ( ")
            sql.AppendLine("		SELECT PIVA, SA_COD, APPEZZA, ID_REG, NR = ROW_NUMBER() OVER (PARTITION BY PIVA, SA_COD, APPEZZA, ID_REG ORDER BY PIVA, SA_COD, APPEZZA, ID_REG) ")
            sql.AppendLine("		FROM ( ")
            sql.AppendLine("			SELECT i.PIVA, i.SA_COD, i.APPEZZA, i.ID_REG ")
            sql.AppendLine("			FROM Reg_Impianti i ")
            sql.AppendLine("			INNER JOIN Imprese_Progetti p ON p.Piva = i.PIVA AND p.Sa_Cod = i.SA_COD AND p.Appezza = i.APPEZZA AND p.Id_Reg = i.ID_REG ")
            sql.AppendLine("            WHERE i.PIVA = @PIVA AND i.[USER] = @PIVA_SUPERUSER ")
            sql.AppendLine("			AND p.Validita_Inizio <= @DATAVAL AND @DATAVAL <= p.Validita_Fine ")
            sql.AppendLine("            AND (@CNT = 0 OR (i.SA_COD IN (SELECT * FROM @TBL))) ")
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    sql.AppendLine("		    AND i.Inviato >= 0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    sql.AppendLine("		    AND i.Inviato = -1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            sql.AppendLine("		) T ")
            sql.AppendLine("	) T WHERE NR = 1 ")
            sql.AppendLine(") ")
            sql.AppendLine()
            sql.AppendLine("SELECT Id, veg_cod, lat, lng, centro_des, app_des, veg_des, cul_des, PIVA, SA_COD, APPEZZA, ID_REG FROM (")
            sql.AppendLine("	SELECT ")
            sql.AppendLine("		Id = ROW_NUMBER() OVER (ORDER BY NEWID())")
            sql.AppendLine("		, veg.veg_cod ")
            sql.AppendLine("		, lat = COALESCE(g.Poligono_GeoEntity.EnvelopeCenter().Lat, CASE WHEN COALESCE(app.x, 0) = 0 THEN NULL ELSE app.x END, CASE WHEN COALESCE(ca.lat, 0) = 0 THEN NULL ELSE ca.lat END) ")
            sql.AppendLine("		, lng = COALESCE(g.Poligono_GeoEntity.EnvelopeCenter().Long, CASE WHEN COALESCE(app.y, 0) = 0 THEN NULL ELSE app.y END, CASE WHEN COALESCE(ca.long, 0) = 0 THEN NULL ELSE ca.long END) ")
            sql.AppendLine("		, centro_des = ca.sa_nome ")
            sql.AppendLine("		, app_des = app.APP_NOME ")
            sql.AppendLine("		, veg.veg_des ")
            sql.AppendLine("		, cul.cul_des ")
            sql.AppendLine("		, rimp.PIVA ")
            sql.AppendLine("		, rimp.SA_COD ")
            sql.AppendLine("		, rimp.APPEZZA ")
            sql.AppendLine("		, rimp.ID_REG ")
            sql.AppendLine("		, g.LayerElementiGrafici_Cod ")
            sql.AppendLine("	FROM Reg_Impianti rimp ")
            sql.AppendLine("	INNER JOIN IMPIANTI_VALIDI_CTE iv ON iv.PIVA = rimp.PIVA AND iv.SA_COD = rimp.SA_COD AND iv.APPEZZA = rimp.APPEZZA AND iv.ID_REG = rimp.ID_REG ")
            sql.AppendLine("	INNER JOIN Appezzamento app ON app.piva = rimp.piva AND app.sa_cod = rimp.SA_COD AND app.APPEZZA = rimp.APPEZZA ")
            sql.AppendLine("	INNER JOIN Centri_Aziendali	ca ON rimp.sa_cod = ca.sa_cod AND rimp.piva = ca.piva ")
            sql.AppendLine("	INNER JOIN Cultivar cul ON cul.Cul_Cod = rimp.CUL_COD ")
            sql.AppendLine("	INNER JOIN SpecieVegetali veg ON veg.Veg_Cod = cul.veg_cod ")
            sql.AppendLine("	INNER JOIN @VEGCOD_FLTTBL flt ON flt.Veg_Cod = veg.Veg_Cod ")
            sql.AppendLine("	LEFT JOIN GIS_Entita e ON e.Piva = rimp.PIVA AND e.Sa_Cod = rimp.SA_COD AND e.Appezza = rimp.APPEZZA AND e.Id_Imp = rimp.ID_REG ")
            sql.AppendLine("	LEFT JOIN GIS_ElementiGrafici g ON g.PivaSuperUser = e.PivaSuperUser AND e.Entita_Cod = g.Entita_Cod ")
            sql.AppendLine(") T WHERE lat IS NOT NULL AND lng IS NOT NULL AND LayerElementiGrafici_Cod = 19 --impianti")

            DT = EseguiQuery_Lettura(objParametri, sql.ToString, NomeRoutine)

        Catch ex As Exception

            Dim MessaggioErrore As String = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing

            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)

        End Try

        Return DT
    End Function

    '##############################################################################################
    'legge reg_impianti con tutte le tabelle di metaschema 
    'union tra terreni nudi e impianti con coltura
    'sui terreni nudi fa: Reg_Impianti_Codici.id_cod AS Veg_Cod, Codici_Anagrafe.Descrizione AS Veg_Des
    Public Function Leggi_DatiColturali_Impianto(ByVal Flag_Verifica_UtentiVisibilitaAppoggio As Boolean,
                                                 ByVal Piva As String,
                                                ByVal Sa_Cod As Int32,
                                                ByVal Appezza As Int32,
                                                ByVal Id_Reg As Int32,
                                                ByVal Veg_Cod As Int32,
                                                ByVal Cul_Cod As Int32,
                                                ByVal Grfi_Cod As Int32,
                                                ByVal Grva_Cod As Int32,
                                                ByVal Port_Cod As Int32,
                                                ByVal Foral_Cod As Int32,
                                                ByVal Cop_Cod As Int32,
                                                ByVal xFiltroAggiuntivo As String,
                                                ByVal xOrderBy As String,
                                                ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                                ) As DataTable


        Dim NomeRoutine As String = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_DatiColturali_Impianto()"

        '====================================================================================
        'Parametri opzionali :
        '   piva = ""           =>  si leggono tutti gli impianti
        '   Sa_Cod = 0           =>  si leggono tutti gli impianti dell'impresa
        '   Appezza = 0          =>  si leggono tutti gli impianti del centro aziendale
        '   Id_reg = 0           =>  si leggono tutti gli impianti dell'appezzamento
        '   Cul_Cod = 0          =>  non si filtra x varietà
        '   Veg_Cod = 0          =>  non si filtra x specie
        '   Grfi_Cod = 0         =>  non si filtra x finalità
        'ecc
        '====================================================================================

        Dim MessaggioErrore As String = ""
        'Dim StrSQL As New System.Text.StringBuilder
        Dim StrSQLSel1 As New System.Text.StringBuilder
        Dim StrSQLSel2 As New System.Text.StringBuilder
        Dim StrGlobale As New System.Text.StringBuilder
        Dim StrWhere As New System.Text.StringBuilder
        Dim DT As DataTable

        Try

            StrSQLSel1.AppendLine(" SELECT Reg_Impianti.Piva, Reg_Impianti.sa_Cod, Reg_Impianti.Appezza, Reg_Impianti.Id_reg, Reg_Impianti.Sup_Imp, Reg_Impianti.Validita_Inizio, Reg_Impianti.Validita_Fine,    " & vbCrLf)
            StrSQLSel1.AppendLine(" 0 AS Cul_Cod, '' AS Cul_Des, 0 AS Veg_Cod, '' AS Veg_Des, Reg_Impianti_Codici.id_cod AS DestUso_Cod, Codici_Anagrafe.Descrizione AS DestUso_Des, 0 AS Grfi_Cod, '' AS Grfi_Des, 0 AS Grva_Cod, '' AS Grva_Des, " & vbCrLf)
            StrSQLSel1.AppendLine(" 0 AS Port_cod, '' AS Port_Des, 0 AS Foral_Cod, '' AS Foral_Des, 0 AS Imp_Cod, '' AS imp_Des, " & vbCrLf)
            StrSQLSel1.AppendLine(" 0 AS Cop_Cod, '' AS Cop_Des, 0 as Tra_Fila, 0 as Su_Fila " & vbCrLf)
            StrSQLSel1.AppendLine(" FROM Reg_Impianti " & vbCrLf)
            StrSQLSel1.AppendLine(" INNER JOIN Reg_Impianti_Codici ON Reg_Impianti.PIVA = Reg_Impianti_Codici.PIVA AND Reg_Impianti.SA_COD = Reg_Impianti_Codici.SA_COD AND Reg_Impianti.APPEZZA = Reg_Impianti_Codici.APPEZZA AND Reg_Impianti.ID_REG = Reg_Impianti_Codici.ID_REG AND Reg_Impianti_Codici.Progetto_Cod = 0  " & vbCrLf)
            StrSQLSel1.AppendLine(" INNER JOIN Codici_Anagrafe ON Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            StrSQLSel1.AppendLine(" AND Codici_Anagrafe.gruppo = 'TERRENO' ")


            StrSQLSel2.AppendLine(" SELECT Reg_Impianti.Piva, Reg_Impianti.sa_Cod, Reg_Impianti.Appezza, Reg_Impianti.Id_reg, Reg_Impianti.Sup_Imp, Reg_Impianti.Validita_Inizio, Reg_Impianti.Validita_Fine,    " & vbCrLf)
            StrSQLSel2.AppendLine(" Cultivar.Cul_Cod, Cultivar.Cul_Des, SpecieVegetali.Veg_Cod, SpecieVegetali.Veg_Des, 0 AS DestUso_Cod, '' as DestUso_Des, GruppoFinalita.Grfi_Cod, GruppoFinalita.Grfi_Des, ISNULL(GruppoVarietale.Grva_Cod,0) AS Grva_Cod, ISNULL(GruppoVarietale.Grva_Des,'') AS Grva_Des, " & vbCrLf)
            StrSQLSel2.AppendLine(" ISNULL(Portinnesti.Port_cod,0) AS Port_cod, ISNULL(Portinnesti.Port_Des,'') AS Port_Des, ISNULL(FormeAllevamento.Foral_Cod,0) AS Foral_Cod, ISNULL(FormeAllevamento.Foral_Des,'') AS Foral_Des, ISNULL(ImpiantiIrrigazioni.Imp_Cod,0) AS Imp_Cod, ISNULL(ImpiantiIrrigazioni.imp_Des,'') AS imp_Des, " & vbCrLf)
            StrSQLSel2.AppendLine(" ISNULL(Copertura.Cop_Cod,0) AS Cop_Cod, ISNULL(Copertura.Cop_Des,'') AS Cop_Des, Tra_Fila, Su_Fila " & vbCrLf)
            StrSQLSel2.AppendLine(" FROM Reg_Impianti " & vbCrLf)
            StrSQLSel2.AppendLine(" INNER JOIN Cultivar ON Cultivar.Cul_Cod = Reg_Impianti.Cul_Cod " & vbCrLf)
            StrSQLSel2.AppendLine(" INNER JOIN SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod " & vbCrLf)
            StrSQLSel2.AppendLine(" INNER JOIN GruppoFinalita ON Reg_Impianti.Grfi_Cod = GruppoFinalita.Grfi_Cod  " & vbCrLf)
            StrSQLSel2.AppendLine(" LEFT JOIN GruppoVarietale ON GruppoVarietale.Grva_Cod = Reg_Impianti.Grva_Cod_Veg  " & vbCrLf)
            StrSQLSel2.AppendLine(" LEFT JOIN Portinnesti ON Portinnesti.Port_Cod = Reg_Impianti.Port_Cod  " & vbCrLf)
            StrSQLSel2.AppendLine(" LEFT JOIN FormeAllevamento ON FormeAllevamento.Foral_Cod = Reg_Impianti.Foral_Cod  " & vbCrLf)
            StrSQLSel2.AppendLine(" LEFT JOIN ImpiantiIrrigazioni ON ImpiantiIrrigazioni.Imp_Cod = Reg_Impianti.Imp_Cod  " & vbCrLf)
            StrSQLSel2.AppendLine(" LEFT JOIN Copertura ON Copertura.Cop_Cod = Reg_Impianti.Cop_Cod  " & vbCrLf)

            StrWhere.AppendLine(" WHERE 1=1 " & vbCrLf)

            If Piva <> "" Then
                StrWhere.AppendLine(" AND     Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Piva) & "' " & vbCrLf)
            End If

            If Sa_Cod <> 0 Then
                StrWhere.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " " & vbCrLf)
            Else
                'questa parte la metto sotto flag, così viene effettuata la lettura solo quando necessario
                'ad esempio non serve in fase di esportazione vs sistemi esterni
                If Flag_Verifica_UtentiVisibilitaAppoggio Then
                    'leggo se ci sono filtri sui centri
                    Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                    Dim FiltroCentri As String = ""
                    Dim DtCentriVisibili As DataTable
                    DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                    If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                        For i = 0 To DtCentriVisibili.Rows.Count - 1
                            FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                        Next
                        If FiltroCentri <> "" Then
                            StrWhere.AppendLine(" AND Reg_Impianti.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                        End If
                    End If
                End If
            End If

            If Appezza <> 0 Then
                StrWhere.AppendLine(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(Appezza) & " " & vbCrLf)
            End If

            If Id_Reg <> 0 Then
                StrWhere.AppendLine(" AND Reg_Impianti.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & " " & vbCrLf)
            End If

            If xFiltroAggiuntivo <> "" Then
                StrWhere.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri) & vbCrLf)
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrWhere.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrWhere.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select

            '=====================================================

            StrGlobale.Length = 0

            StrGlobale.Append(StrSQLSel1)
            StrGlobale.Append(StrWhere)
            StrGlobale.AppendLine(" AND Reg_Impianti.Cul_Cod = 0 " & vbCrLf)

            StrGlobale.AppendLine("  " & vbCrLf)
            StrGlobale.AppendLine(" UNION ALL " & vbCrLf)
            StrGlobale.AppendLine("  " & vbCrLf)

            StrGlobale.Append(StrSQLSel2)
            StrGlobale.Append(StrWhere)

            If Cul_Cod <> 0 Then
                StrGlobale.AppendLine(" AND Cultivar.Cul_Cod = " & Agro_SQL_SaveNum(Cul_Cod) & " " & vbCrLf)
            End If

            If Veg_Cod <> 0 Then
                StrGlobale.AppendLine(" AND SpecieVegetali.Veg_Cod = " & Agro_SQL_SaveNum(Veg_Cod) & " " & vbCrLf)
            End If

            If Grfi_Cod <> 0 Then
                StrGlobale.AppendLine(" AND Reg_Impianti.Grfi_Cod = " & Agro_SQL_SaveNum(Grfi_Cod) & " " & vbCrLf)
            End If

            If Grva_Cod <> 0 Then
                StrGlobale.AppendLine(" AND GruppoVarietale.Grva_Cod = " & Agro_SQL_SaveNum(Grva_Cod) & " " & vbCrLf)
            End If

            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrGlobale.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrGlobale.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

    Public Function Leggi_x_GestioneEsercizi(
                       ByVal Piva As String,
                       ByVal Sa_Cod As Integer,
                       ByVal Appezza As Integer,
                       ByVal Id_Reg As Integer,
                       ByVal Campo_Cod As Integer,
                       ByVal xFiltroAggiuntivo As String,
                       ByVal xOrderBy As String,
                       ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
               ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.LeggixGestioneEsercizi()"

        '====================================================================================
        'Parametri opzionali :
        '   Sa_Cod = 0           =>  si leggono tutti gli impianti dell'impresa
        '   Appezza = 0          =>  si leggono tutti gli impianti del centro aziendale
        '   Id_reg = 0           =>  si leggono tutti gli impianti dell'appezzamento
        '====================================================================================

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable
        Dim i As Integer

        Try
            If objParametri.PivaSuperUser = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva_Superuser obbligatorio)")
            End If

            'If Piva = "" Then
            '    Throw New Exception("Parametro non corretto nella query (Piva obbligatorio)")
            'End If

            StrSQL.AppendLine(" SELECT  r.PIVA + '_' + CAST(r.SA_COD AS nvarchar(10)) + '_' + CAST(r.APPEZZA AS nvarchar(10)) + '_' + CAST(r.id_reg AS nvarchar(10)) + '_' + CAST(p.Progetto_Cod AS nvarchar(10)) AS chiave, ")
            StrSQL.AppendLine(" a.app_nome, r.PIVA, r.SA_COD, r.APPEZZA, r.ID_REG, p.Progetto_Nome, p.Progetto_Des, p.Progetto_Cod, p.Validita_Inizio, p.Validita_Fine, ")
            StrSQL.AppendLine(" c.cul_des, r.cul_cod, s.veg_des, s.veg_cod, gru_des, r.grfi_cod, gf.grfi_des, r.grva_cod_veg, grva_des, r.p_ha, r.sup_imp,  ")
            StrSQL.AppendLine(" DATEDIFF(day,p.Validita_Inizio,p.Validita_Fine) as Durata, ")
            StrSQL.AppendLine(" r.Validita_Inizio as Validita_Inizio_Impianto, r.Validita_Fine as Validita_Fine_Impianto, ")
            StrSQL.AppendLine(" a.Validita_Inizio as Validita_Inizio_Appezzamento, a.Validita_Fine as Validita_Fine_Appezzamento, ")
            StrSQL.AppendLine(" (select [User] from utenti where CODICE_FISCALE = r.Username_Modifica ) as utente_modifica , r.Data_Modifica,  ")
            StrSQL.AppendLine(" (select [User] from utenti where CODICE_FISCALE = r.Username_Creazione ) as utente_creazione , r.Data_Creazione,  ")
            StrSQL.AppendLine(" i.rag_soc, ca.Sa_Nome, Campi.Campo_Cod, Campi.Campo_Des, codiceImpianto.val_cod as Codice_Impianto, ")
            StrSQL.AppendLine(" CASE WHEN distintaChiusa.val_cod = '1' THEN 'SI' ELSE 'NO'END as Distinta_Chiusa,  ")
            StrSQL.AppendLine(" ISNULL(c.cul_des, '') as varieta, ISNULL(Codici_Anagrafe.descrizione, 'Terreno Nudo') as codice_anagrafe, ")
            StrSQL.AppendLine(" CASE r.cul_Cod WHEN 0 THEN  ISNULL(Codici_Anagrafe.descrizione, 'Terreno Nudo') ELSE s.Veg_Des + ' - ' + c.Cul_Des END AS utilizzo ")

            StrSQL.AppendLine(" FROM  Imprese_Progetti p INNER JOIN Imprese i ON p.Piva = i.Piva ")
            StrSQL.AppendLine(" INNER JOIN Reg_Impianti r ON p.Piva = r.Piva AND p.Sa_Cod = r.Sa_Cod AND p.Appezza = r.Appezza AND p.Id_Reg = r.Id_Reg   ")
            StrSQL.AppendLine(" INNER JOIN Appezzamento a on a.piva  = r.piva and a.sa_cod = r.SA_COD and a.APPEZZA = r.APPEZZA   ")
            StrSQL.AppendLine(" LEFT JOIN cultivar c on c.Cul_Cod = r.CUL_COD   ")
            StrSQL.AppendLine(" LEFT JOIN SpecieVegetali s on s.Veg_Cod = c.veg_cod   ")
            StrSQL.AppendLine(" LEFT JOIN GruppoVegetale g on g.gru_cod = s.Gru_Cod   ")
            StrSQL.AppendLine(" LEFT JOIN GruppoFinalita gf on gf.Grfi_Cod = r.GRFI_COD  ")
            StrSQL.AppendLine(" LEFT JOIN GruppoVarietale gv on gv.Grva_Cod = r.GRVA_Cod_VEG   ")
            StrSQL.AppendLine(" LEFT JOIN Centri_Aziendali ca on r.sa_cod = ca.sa_cod AND r.piva = ca.piva   ")
            StrSQL.AppendLine(" LEFT JOIN Campi on a.sa_cod = Campi.sa_cod AND a.piva = Campi.piva AND a.Campo_Cod = Campi.Campo_Cod  ")
            StrSQL.AppendLine(" LEFT JOIN Reg_Impianti_Codici codiceImpianto ON r.PIVA = codiceImpianto.PIVA AND r.Sa_Cod = codiceImpianto.Sa_Cod AND r.Appezza = codiceImpianto.Appezza AND r.ID_Reg = codiceImpianto.ID_Reg AND codiceImpianto.id_Cod = 1300 ")
            StrSQL.AppendLine(" LEFT JOIN Reg_Impianti_Codici distintaChiusa ON r.PIVA = distintaChiusa.PIVA AND r.Sa_Cod = distintaChiusa.Sa_Cod AND r.Appezza = distintaChiusa.Appezza AND r.ID_Reg = distintaChiusa.ID_Reg AND p.Progetto_Cod = distintaChiusa.Progetto_Cod AND distintaChiusa.id_Cod = 1301 ")
            StrSQL.AppendLine(" LEFT JOIN Reg_Impianti_Codici destinazione ON r.PIVA = destinazione.PIVA AND r.Sa_Cod = destinazione.Sa_Cod AND r.Appezza = destinazione.Appezza AND r.ID_Reg = destinazione.ID_Reg AND destinazione.id_Cod >= 3000 AND destinazione.id_Cod < 4000 ")
            StrSQL.AppendLine(" LEFT JOIN Codici_Anagrafe ON destinazione.id_cod = Codici_Anagrafe.codice ")

            StrSQL.AppendLine(" WHERE   p.Validita_inizio <= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & " ")
            StrSQL.AppendLine(" AND    p.Validita_Fine >= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & " ")
            'StrSQL.AppendLine(" AND     r.[User] = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "' ")

            If Piva <> "" Then

                StrSQL.AppendLine(" AND p.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

                If Sa_Cod <> 0 Then
                    StrSQL.AppendLine(" AND p.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
                Else
                    'leggo se ci sono filtri sui centri
                    Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                    Dim FiltroCentri As String = ""
                    Dim DtCentriVisibili As DataTable
                    DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                    If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                        For i = 0 To DtCentriVisibili.Rows.Count - 1
                            FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                        Next
                        If FiltroCentri <> "" Then
                            StrSQL.AppendLine(" AND p.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                        End If
                    End If
                End If

                If Appezza <> 0 Then
                    StrSQL.AppendLine(" AND p.Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
                End If

                If Id_Reg <> 0 Then
                    StrSQL.AppendLine(" AND p.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & " ")
                End If

                If Campo_Cod <> 0 Then
                    StrSQL.AppendLine(" AND Campi.Campo_Cod = " & Agro_SQL_SaveNum(Campo_Cod) & " ")
                End If

            Else

                Dim FiltroImprese As String = ""
                Dim UtentiVisibilitaLeggi As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                Dim ImpreseVisibili As DataTable = UtentiVisibilitaLeggi.Leggi(enum_TipoEntita.Impresa, "", "", objParametri)
                If ImpreseVisibili IsNot Nothing AndAlso ImpreseVisibili.Rows.Count > 0 Then
                    For i = 0 To ImpreseVisibili.Rows.Count - 1
                        FiltroImprese &= "'" & Agro_SQL_SaveText(ImpreseVisibili.Rows(i).Item("Piva")) & "',"
                    Next
                    If FiltroImprese <> "" Then
                        StrSQL.AppendLine(" AND p.Piva IN (" & Left(FiltroImprese, FiltroImprese.Length - 1) & ") ")
                    End If
                End If

            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If

            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   p.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   p.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            Else
                StrSQL.AppendLine(" ORDER BY p.Validita_Inizio Desc ")
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

