            StrSQL.AppendLine("  FROM   Reg_Impianti  ")
            StrSQL.AppendLine("     INNER JOIN Appezzamento ON Reg_Impianti.PIVA = Appezzamento.PIVA And Reg_Impianti.SA_COD = Appezzamento.SA_COD And Reg_Impianti.APPEZZA = Appezzamento.APPEZZA  ")
            StrSQL.AppendLine("     INNER JOIN Imprese_Progetti On Reg_Impianti.PIVA = Imprese_Progetti.Piva And Reg_Impianti.SA_COD = Imprese_Progetti.Sa_Cod And Reg_Impianti.APPEZZA = Imprese_Progetti.Appezza And Reg_Impianti.ID_REG = Imprese_Progetti.Id_Reg  ")

            StrSQL.AppendLine("     INNER JOIN AppezzamentiXParticelle On Appezzamento.PIVA = AppezzamentiXParticelle.PIVA And Appezzamento.SA_COD = AppezzamentiXParticelle.SA_COD And Appezzamento.APPEZZA = AppezzamentiXParticelle.APPEZZA ")

