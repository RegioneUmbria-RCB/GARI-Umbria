                    End If

                    If Veg_Cod <> 0 Then
                        StrSQL.AppendLine(" AND SpecieVegetali.Veg_Cod = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
                    End If

                    If xFiltroAggiuntivo <> "" Then
                        StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
                    End If
                    '--------------------------------------------------------------------------
                    Select Case objParametri.FlagVisibilita
                        Case enumVisibilita.Visibilita_SoloNonCancellati
                            StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                            StrSQL.AppendLine(" AND   Cultivar.Inviato >=0 ")
                            StrSQL.AppendLine(" AND   SpecieVegetali.Inviato >=0 ")
                        Case enumVisibilita.Visibilita_SoloCancellati
                            StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                            StrSQL.AppendLine(" AND   Cultivar.Inviato =-1 ")
                            StrSQL.AppendLine(" AND   SpecieVegetali.Inviato =-1 ")
                        Case enumVisibilita.Visibilita_Tutti
                            '...................................
                        Case Else
                            Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
                    End Select
                    '--------------------------------------------------------------------------
                    If xOrderBy <> "" Then
                        StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
                    Else
                        'Nota: Questo ordinamento è importante per la gestione del campo.
                        'Viene letto l'impianto più RECENTE dell'appezzamento associato al campo
                        StrSQL.AppendLine(" ORDER BY Veg_Des, Cul_Des ")
                    End If


                Case AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta
                    StrSQL.Length = 0
                    StrSQL.AppendLine(" SELECT Appezzamento.APP_NOME, Reg_Impianti.Piva, Reg_Impianti.sa_Cod, Reg_Impianti.Appezza, Reg_Impianti.Id_reg, Reg_Impianti.Sup_Imp, Reg_Impianti.Validita_Inizio, Reg_Impianti.Validita_Fine,    ")
                    StrSQL.AppendLine(" Cultivar.Cul_Cod, Cultivar.Cul_Des, SpecieVegetali.Veg_Cod, SpecieVegetali.Veg_Des  ,gru_cod ")
                    StrSQL.AppendLine(" FROM Reg_Impianti ")
                    StrSQL.AppendLine(" INNER JOIN Appezzamento ON Reg_Impianti.PIVA = Appezzamento.PIVA AND Reg_Impianti.SA_COD = Appezzamento.SA_COD AND Reg_Impianti.APPEZZA = Appezzamento.APPEZZA ")
                    StrSQL.AppendLine(" INNER JOIN Cultivar ON Cultivar.Cul_Cod = Reg_Impianti.Cul_Cod ")
                    StrSQL.AppendLine(" INNER JOIN SpecieVegetali on Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod ")

                    StrSQL.AppendLine(" WHERE   Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & " ")
                    StrSQL.AppendLine(" AND     Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & " ")

                    StrSQL.AppendLine(" AND     Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")
                    StrSQL.AppendLine(" AND     Reg_Impianti.[User] = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "' ")

                    If Sa_Cod <> 0 Then
                        StrSQL.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
                    Else
                        'leggo se ci sono filtri sui centri
                        Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                        Dim FiltroCentri As String = ""
                        Dim DtCentriVisibili As DataTable
                        DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                        If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                            For i = 0 To DtCentriVisibili.Rows.Count - 1
                                FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                            Next
                            If FiltroCentri <> "" Then
                                StrSQL.AppendLine(" AND Reg_Impianti.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                            End If
                        End If
                    End If

                    If Appezza <> 0 Then
                        StrSQL.AppendLine(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
                    End If

                    If Id_Reg <> 0 Then
                        StrSQL.AppendLine(" AND Reg_Impianti.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & " ")
                    End If

                    If Cul_Cod <> 0 Then
                        StrSQL.AppendLine(" AND Cultivar.Cul_Cod = " & Agro_SQL_SaveNum(Cul_Cod) & " ")
                    End If

                    If Veg_Cod <> 0 Then
                        StrSQL.AppendLine(" AND SpecieVegetali.Veg_Cod = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
                    End If

                    If xFiltroAggiuntivo <> "" Then
                        StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
                    End If
                    '--------------------------------------------------------------------------
                    Select Case objParametri.FlagVisibilita
                        Case enumVisibilita.Visibilita_SoloNonCancellati
                            StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                            StrSQL.AppendLine(" AND   Cultivar.Inviato >=0 ")
                            StrSQL.AppendLine(" AND   SpecieVegetali.Inviato >=0 ")
                        Case enumVisibilita.Visibilita_SoloCancellati
                            StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                            StrSQL.AppendLine(" AND   Cultivar.Inviato =-1 ")
                            StrSQL.AppendLine(" AND   SpecieVegetali.Inviato =-1 ")
                        Case enumVisibilita.Visibilita_Tutti
                            '...................................
                        Case Else
                            Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
                    End Select
                    '--------------------------------------------------------------------------
                    If xOrderBy <> "" Then
                        StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
                    Else
                        'Nota: Questo ordinamento è importante per la gestione del campo.
                        'Viene letto l'impianto più RECENTE dell'appezzamento associato al campo
                        StrSQL.AppendLine(" ORDER BY Veg_Des, Cul_Des ")
                    End If

                Case AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_JoinDescrizioni



                Case AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_JoinCompleta
                    '
                    '
                    '
                    '


            End Select



            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

    Public Function LeggixImputazione(ByVal PivaSuperuser As String,
                                      ByVal Piva As String,
                                      ByVal strId_Agenda As String,
                                      ByVal Data As Date,
                                      ByVal Elem_Cod As Integer,
                                      ByVal Mat_Cod As Integer,
                                      ByVal filtro_impianti As Integer,
                                      ByVal xFiltroAggiuntivo As String,
                                      ByVal xOrderBy As String,
                                      ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                      ) As DataTable

        Const nomeRoutine = "AnagrafeDAL.Reg_Impianti_Read.LeggixImputazione()"

        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable

        Try

            '---------------------------------------------
            '1° Parte: Impianti Non associati ad agenda
            StrSQL.Length = 0
            StrSQL.AppendLine(" (SELECT Distinct 0 as Qta, Centri_Aziendali.Sa_Nome, Appezzamento.Appezza, Appezzamento.App_Nome, IsNull(Campi.Campo_Cod, 0) As Campo_Cod, IsNull(Campi.Campo_Des,'') as Campo_Des, IsNull(Cultivar.Cul_Des,'') as Cul_Des, " &
                              " Reg_Impianti.*,  Imprese_Progetti.Progetto_Cod ,  Imprese_Progetti.Progetto_Nome, SpecieVegetali.Veg_Cod, SpecieVegetali.Veg_Des, " &
                              " IsNull(Reg_Impianti_Codici_KPIN.Val_Cod, 0) as KPIN, IsNull(Reg_Impianti_Codici_BLOCK.Val_Cod, 0) as BLOCK ")
            StrSQL.AppendLine(" From SpecieVegetali, Centri_Aziendali, Materie_Prime, Cultivar, Imprese_Progetti, Appezzamento ")
            StrSQL.AppendLine(" Left Outer Join Campi On (    Campi.Piva = Appezzamento.Piva ")
            StrSQL.AppendLine(" And Campi.Sa_Cod = Appezzamento.Sa_Cod ")
            StrSQL.AppendLine(" And Campi.Campo_Cod = Appezzamento.Campo_Cod),  Reg_Impianti ")

            StrSQL.AppendLine(" Left Outer Join Reg_Impianti_Codici as Reg_Impianti_Codici_KPIN On ( Reg_Impianti_Codici_KPIN.Id_Cod = 1287 ")
            StrSQL.AppendLine(" And Reg_Impianti.Piva = Reg_Impianti_Codici_KPIN.Piva ")
            StrSQL.AppendLine(" And Reg_Impianti.Sa_Cod = Reg_Impianti_Codici_KPIN.Sa_Cod ")
            StrSQL.AppendLine(" And Reg_Impianti.Appezza = Reg_Impianti_Codici_KPIN.Appezza ")
            StrSQL.AppendLine(" And Reg_Impianti.Id_Reg = Reg_Impianti_Codici_KPIN.Id_Reg ) ")

            StrSQL.AppendLine(" Left Outer Join Reg_Impianti_Codici as Reg_Impianti_Codici_BLOCK On ( Reg_Impianti_Codici_BLOCK.Id_Cod = 1288 ")
            StrSQL.AppendLine(" And Reg_Impianti.Piva = Reg_Impianti_Codici_BLOCK.Piva ")
            StrSQL.AppendLine(" And Reg_Impianti.Sa_Cod = Reg_Impianti_Codici_BLOCK.Sa_Cod ")
            StrSQL.AppendLine(" And Reg_Impianti.Appezza = Reg_Impianti_Codici_BLOCK.Appezza ")
            StrSQL.AppendLine(" And Reg_Impianti.Id_Reg = Reg_Impianti_Codici_BLOCK.Id_Reg ) ")

            StrSQL.AppendLine(" WHERE   Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine(" And     Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")


            StrSQL.AppendLine(" And Reg_Impianti.Cul_Cod In (Select Cul_Cod From Cultivar As C2 Where C2.Veg_Cod = Materie_Prime.Veg_Cod) ")
            StrSQL.AppendLine(" And Reg_Impianti.Cul_Cod = Cultivar.Cul_Cod ")
            StrSQL.AppendLine(" And Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod ")

            'Impostazione filtro_impianti
            Select Case filtro_impianti

                Case 0 'Regolamento

                    StrSQL.AppendLine(" And Reg_Impianti.Cul_Cod = Materie_Prime.Cul_Cod ")
                    StrSQL.AppendLine(" And Imprese_Progetti.Regolamento_Cod = Materie_Prime.Regolamento ")

                Case 1  'Varietà

                    StrSQL.AppendLine(" And Reg_Impianti.Cul_Cod = Materie_Prime.Cul_Cod ")


                Case Else 'Specie Vegetale

                    'Fatto Sopra

            End Select


            StrSQL.AppendLine(" And Materie_Prime.Elem_Cod = " & Agro_SQL_SaveNum(Elem_Cod))
            StrSQL.AppendLine(" And Materie_Prime.Mat_Cod = " & Agro_SQL_SaveNum(Mat_Cod))
            StrSQL.AppendLine(" And Centri_aziendali.Piva = Appezzamento.Piva ")
            StrSQL.AppendLine(" And Centri_aziendali.Sa_Cod = Appezzamento.Sa_Cod ")

            StrSQL.AppendLine(" And Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Piva) & "'")

            StrSQL.AppendLine(" And Reg_Impianti.Piva = Appezzamento.Piva ")
            StrSQL.AppendLine(" And Reg_Impianti.Sa_Cod = Appezzamento.Sa_Cod ")
            StrSQL.AppendLine(" And Reg_Impianti.Appezza = Appezzamento.Appezza ")
            StrSQL.AppendLine(" And Reg_Impianti.Cul_Cod = Cultivar.Cul_Cod ")

            StrSQL.AppendLine(" And Reg_impianti.Piva = Imprese_Progetti.Piva ")
            StrSQL.AppendLine(" And Reg_impianti.Sa_Cod = Imprese_Progetti.Sa_Cod ")
            StrSQL.AppendLine(" And Reg_impianti.Appezza = Imprese_Progetti.Appezza ")
            StrSQL.AppendLine(" And Reg_impianti.Id_Reg = Imprese_Progetti.Id_Reg ")

            StrSQL.AppendLine(" And   Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine(" And   Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")

            Select Case Trim(strId_Agenda)

                Case ""

                    'Chiudo la query
                    StrSQL.AppendLine(" )")

                Case Else

                    '2° Parte: Escludo gli impianti associati all'agenda
                    StrSQL.AppendLine(" And Not Exists ")
                    StrSQL.AppendLine(" ( SELECT * From Mov_Destinazioni, Reg_Impianti As RI ")
                    StrSQL.AppendLine(" Where Mov_Destinazioni.Piva = '" & Agro_SQL_SaveText(Piva) & "'")
                    StrSQL.AppendLine(" And Mov_Destinazioni.Id_Agenda In (" & Agro_SQL_Save_Clausola_IN(strId_Agenda) & ") ")
                    StrSQL.AppendLine(" And Mov_Destinazioni.Tipo_Destinazione = 0 ")
                    StrSQL.AppendLine(" And RI.Piva = Mov_Destinazioni.Piva ")
                    StrSQL.AppendLine(" And RI.Sa_Cod = Mov_Destinazioni.Sa_Cod ")
                    StrSQL.AppendLine(" And RI.Appezza = Mov_Destinazioni.Appezza ")
                    StrSQL.AppendLine(" And RI.Id_Reg = Mov_Destinazioni.Id_Destinazione ")
                    StrSQL.AppendLine(" And RI.Piva = Reg_Impianti.Piva ")
                    StrSQL.AppendLine(" And RI.Sa_Cod = Reg_Impianti.Sa_Cod ")
                    StrSQL.AppendLine(" And RI.Appezza = Reg_Impianti.Appezza ")
                    StrSQL.AppendLine(" And RI.Id_Reg = Reg_Impianti.Id_Reg ")

                    '3° Parte Unione con Impianti da Agenda
                    StrSQL.AppendLine(" )) UNION ALL ")

                    StrSQL.AppendLine(" (SELECT Distinct Mov_Destinazioni.Qta as Qta, Centri_Aziendali.Sa_Nome, Appezzamento.Appezza, Appezzamento.App_Nome, IsNull(Campi.Campo_Cod, 0) As Campo_Cod, IsNull(Campi.Campo_Des,'') as Campo_Des, IsNull(Cultivar.Cul_Des,'') as Cul_Des, " &
                              " Reg_Impianti.*,  Imprese_Progetti.Progetto_Cod ,  Imprese_Progetti.Progetto_Nome, SpecieVegetali.Veg_Cod, SpecieVegetali.Veg_Des, " &
                              " IsNull(Reg_Impianti_Codici_KPIN.Val_Cod, 0) as KPIN, IsNull(Reg_Impianti_Codici_BLOCK.Val_Cod, 0) as BLOCK ")
                    StrSQL.AppendLine(" From Mov_Destinazioni, SpecieVegetali, Centri_Aziendali, Materie_Prime, Cultivar, Imprese_Progetti, Appezzamento ")
                    StrSQL.AppendLine(" Left Outer Join Campi On (    Campi.Piva = Appezzamento.Piva ")
                    StrSQL.AppendLine(" And Campi.Sa_Cod = Appezzamento.Sa_Cod ")
                    StrSQL.AppendLine(" And Campi.Campo_Cod = Appezzamento.Campo_Cod), Reg_Impianti ")

                    StrSQL.AppendLine(" Left Outer Join Reg_Impianti_Codici as Reg_Impianti_Codici_KPIN On ( Reg_Impianti_Codici_KPIN.Id_Cod = 1287 ")
                    StrSQL.AppendLine(" And Reg_Impianti.Piva = Reg_Impianti_Codici_KPIN.Piva ")
                    StrSQL.AppendLine(" And Reg_Impianti.Sa_Cod = Reg_Impianti_Codici_KPIN.Sa_Cod ")
                    StrSQL.AppendLine(" And Reg_Impianti.Appezza = Reg_Impianti_Codici_KPIN.Appezza ")
                    StrSQL.AppendLine(" And Reg_Impianti.Id_Reg = Reg_Impianti_Codici_KPIN.Id_Reg ) ")

                    StrSQL.AppendLine(" Left Outer Join Reg_Impianti_Codici as Reg_Impianti_Codici_BLOCK On ( Reg_Impianti_Codici_BLOCK.Id_Cod = 1288 ")
                    StrSQL.AppendLine(" And Reg_Impianti.Piva = Reg_Impianti_Codici_BLOCK.Piva ")
                    StrSQL.AppendLine(" And Reg_Impianti.Sa_Cod = Reg_Impianti_Codici_BLOCK.Sa_Cod ")
                    StrSQL.AppendLine(" And Reg_Impianti.Appezza = Reg_Impianti_Codici_BLOCK.Appezza ")
                    StrSQL.AppendLine(" And Reg_Impianti.Id_Reg = Reg_Impianti_Codici_BLOCK.Id_Reg ) ")

                    StrSQL.AppendLine(" WHERE   Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
                    StrSQL.AppendLine(" And     Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")

                    'Collegamento a Specie Vegetale
                    StrSQL.AppendLine(" And Reg_Impianti.Cul_Cod In (Select Cul_Cod From Cultivar as C2 Where C2.Veg_Cod = Materie_Prime.Veg_Cod) ")
                    StrSQL.AppendLine(" And Reg_Impianti.Cul_Cod = Cultivar.Cul_Cod ")
                    StrSQL.AppendLine(" And Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod ")

                    StrSQL.AppendLine(" And Materie_Prime.Elem_Cod = " & Agro_SQL_SaveNum(Elem_Cod))
                    StrSQL.AppendLine(" And Materie_Prime.Mat_Cod = " & Agro_SQL_SaveNum(Mat_Cod))
                    StrSQL.AppendLine(" And Centri_aziendali.Piva = Appezzamento.Piva ")
                    StrSQL.AppendLine(" And Centri_aziendali.Sa_Cod = Appezzamento.Sa_Cod ")

                    StrSQL.AppendLine(" And Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Piva) & "'")

                    StrSQL.AppendLine(" And Reg_Impianti.Piva = Appezzamento.Piva ")
                    StrSQL.AppendLine(" And Reg_Impianti.Sa_Cod = Appezzamento.Sa_Cod ")
                    StrSQL.AppendLine(" And Reg_Impianti.Appezza = Appezzamento.Appezza ")
                    StrSQL.AppendLine(" And Reg_Impianti.Cul_Cod = Cultivar.Cul_Cod ")

                    StrSQL.AppendLine(" And Reg_impianti.Piva = Imprese_Progetti.Piva ")
                    StrSQL.AppendLine(" And Reg_impianti.Sa_Cod = Imprese_Progetti.Sa_Cod ")
                    StrSQL.AppendLine(" And Reg_impianti.Appezza = Imprese_Progetti.Appezza ")
                    StrSQL.AppendLine(" And Reg_impianti.Id_Reg = Imprese_Progetti.Id_Reg ")

                    StrSQL.AppendLine(" And   Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
                    StrSQL.AppendLine(" And   Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")

                    StrSQL.AppendLine(" And   Mov_Destinazioni.Piva = '" & Agro_SQL_SaveText(Piva) & "'")
                    StrSQL.AppendLine(" And   Mov_Destinazioni.Id_Agenda In (" & Agro_SQL_Save_Clausola_IN(strId_Agenda) & ") ")

                    StrSQL.AppendLine(" And Mov_Destinazioni.Tipo_Destinazione = 0 ")
                    StrSQL.AppendLine(" And Reg_impianti.Piva = Mov_Destinazioni.Piva ")
                    StrSQL.AppendLine(" And Reg_impianti.Sa_Cod = Mov_Destinazioni.Sa_Cod ")
                    StrSQL.AppendLine(" And Reg_impianti.Appezza = Mov_Destinazioni.Appezza ")
                    StrSQL.AppendLine(" And Reg_impianti.Id_Reg = Mov_Destinazioni.Id_Destinazione ")
                    StrSQL.AppendLine(" )")


            End Select

            'Nota:      Ordinamento per Qta desc in modo da visul
            StrSQL.AppendLine(" ORDER BY Qta Desc, Cul_Des Asc ")

            '---------------------------------------------

            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] :    " & messaggioErrore)
        End Try

        Return dt

    End Function

    Public Function Leggi_Specie(ByVal Piva As String,
                                        ByVal Sa_Cod As String,
                                        ByVal Appezza As Int32,
                                        ByVal Id_Reg As Int32,
                                        ByVal Veg_Cod As Int32,
                                        ByVal Cul_Cod As Int32,
                                        ByVal xFiltroAggiuntivo As String,
                                        ByVal xOrderBy As String,
                                        ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                        ) As DataTable


        Dim NomeRoutine As String = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_Specie()"

        '====================================================================================
        'Parametri opzionali :
        '   Sa_Cod = 0           =>  si leggono tutti gli impianti dell'impresa
        '   Appezza = 0          =>  si leggono tutti gli impianti del centro aziendale
        '   Id_reg = 0           =>  si leggono tutti gli impianti dell'appezzamento
        '   Cul_Cod = 0          =>  non si filtra x varietà
        '   Veg_Cod = 0          =>  non si filtra x specie
        '====================================================================================

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable
        Dim i As Integer

        Try
            If Piva = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva obbligatorio)")
            End If

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT DISTINCT SpecieVegetali.Veg_Cod, SpecieVegetali.Veg_Des, gru_cod   ")
            StrSQL.AppendLine(" FROM Reg_Impianti ")
            StrSQL.AppendLine(" INNER JOIN Cultivar ON Cultivar.Cul_Cod = Reg_Impianti.Cul_Cod ")
            StrSQL.AppendLine(" INNER JOIN SpecieVegetali on Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod ")

            StrSQL.AppendLine(" WHERE   Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & " ")
            StrSQL.AppendLine(" AND     Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & " ")

            StrSQL.AppendLine(" AND     Piva = '" & Agro_SQL_SaveText(Piva) & "' ")
            StrSQL.AppendLine(" AND     [User] = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "' ")

            If Sa_Cod <> "" AndAlso Sa_Cod <> "0" Then
                StrSQL.AppendLine(" AND Reg_Impianti.Sa_Cod IN (" & Agro_SQL_Save_Clausola_IN(Sa_Cod, False) & ") ")
            Else
                'leggo se ci sono filtri sui centri
                Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                Dim FiltroCentri As String = ""
                Dim DtCentriVisibili As DataTable
                DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                    For i = 0 To DtCentriVisibili.Rows.Count - 1
                        FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                    Next
                    If FiltroCentri <> "" Then
                        StrSQL.AppendLine(" AND Reg_Impianti.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                    End If
                End If
            End If

            If Appezza <> 0 Then
                StrSQL.AppendLine(" AND Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
            End If

            If Id_Reg <> 0 Then
                StrSQL.AppendLine(" AND Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & " ")
            End If

            If Cul_Cod <> 0 Then
                StrSQL.AppendLine(" AND Cultivar.Cul_Cod = " & Agro_SQL_SaveNum(Cul_Cod) & " ")
            End If

            If Veg_Cod <> 0 Then
                StrSQL.AppendLine(" AND SpecieVegetali.Veg_Cod = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                    StrSQL.AppendLine(" AND   Cultivar.Inviato >=0 ")
                    StrSQL.AppendLine(" AND   SpecieVegetali.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                    StrSQL.AppendLine(" AND   Cultivar.Inviato =-1 ")
                    StrSQL.AppendLine(" AND   SpecieVegetali.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            Else
                'Nota: Questo ordinamento è importante per la gestione del campo.
                'Viene letto l'impianto più RECENTE dell'appezzamento associato al campo
                StrSQL.AppendLine(" ORDER BY Veg_Des ")
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

    '##############################################################################################
    'legge reg_impianti in inner join con cultivar e specie
    Public Function Leggi_SpecieVarieta_usateinReg_Impianti_Programmazione_Entita(ByVal Piva As String,
                                        ByVal xFiltroAggiuntivo As String,
                                        ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                        ) As DataTable


        Dim NomeRoutine As String = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_SpecieVarieta()"

        '====================================================================================
        'Parametri opzionali :
        '   Sa_Cod = 0           =>  si leggono tutti gli impianti dell'impresa
        '   Appezza = 0          =>  si leggono tutti gli impianti del centro aziendale
        '   Id_reg = 0           =>  si leggono tutti gli impianti dell'appezzamento
        '   Cul_Cod = 0          =>  non si filtra x varietà
        '   Veg_Cod = 0          =>  non si filtra x specie
        '====================================================================================

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable

        Try


            StrSQL.Length = 0
            StrSQL.AppendLine(" (  ")

            StrSQL.AppendLine(" select distinct specievegetali.veg_cod ,specievegetali.veg_des  from reg_impianti   ")
            StrSQL.AppendLine(" left join Cultivar on Reg_Impianti.cul_cod =Cultivar.cul_cod   ")
            StrSQL.AppendLine(" left join specievegetali  on specievegetali.veg_cod = Cultivar.veg_cod    ")

            StrSQL.AppendLine(" WHERE   (Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & " ")
            StrSQL.AppendLine(" AND     Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & " )")


            If Piva <> "" Then
                StrSQL.AppendLine(" AND reg_impianti.piva = '" & Agro_SQL_SaveText(Piva) & "' ")
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND  reg_impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select


            StrSQL.AppendLine(" union ")


            StrSQL.AppendLine(" select distinct specievegetali.veg_cod ,specievegetali.veg_des from programmazione_entita ")
            StrSQL.AppendLine(" left join Cultivar on programmazione_entita.cul_cod =Cultivar.cul_cod ")
            StrSQL.AppendLine(" left join specievegetali  on specievegetali.veg_cod = Cultivar.veg_cod  ")

            StrSQL.AppendLine(" WHERE    (programmazione_entita.Validita_inizio <= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & " ")
            StrSQL.AppendLine(" AND     programmazione_entita.Validita_Fine >= " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & " )")

            If Piva <> "" Then
                StrSQL.AppendLine(" AND programmazione_entita.Piva='" & Agro_SQL_SaveText(Piva) & "' ")
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND  programmazione_entita.Inviato >=0  ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND  programmazione_entita.Inviato = -1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select


            StrSQL.AppendLine(")  ORDER BY Veg_Des ")

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

    '##############################################################################################
