            StrSQL.AppendLine("     CONVERT(VARCHAR, Reg_Impianti.Validita_Inizio, 103) AS Validita_Inizio, CONVERT(VARCHAR, Reg_Impianti.Validita_Fine, 103) AS Validita_Fine, Reg_Impianti.Sup_Imp, ")
