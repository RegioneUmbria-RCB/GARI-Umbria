                    strSql.AppendLine(" GROUP BY Ricette_Destinazioni.Ricetta_SuperUser, Ricette_Destinazioni.Piva, Ricette_Destinazioni.sa_cod, Ricette_Destinazioni.appezza, Ricette_Destinazioni.id_reg, Imprese_Progetti.progetto_cod   ")

                    strSql.AppendLine(" ) no ")

                    strSql.AppendLine(" 	 On  no.piva = ip.piva ")
                    strSql.AppendLine(" And no.sa_cod = ip.sa_cod  ")
                    strSql.AppendLine(" And no.appezza = ip.Appezza ")
                    strSql.AppendLine(" And no.id_reg = ip.Id_Reg  ")
                    strSql.AppendLine(" And no.progetto_cod = ip.Progetto_Cod  ")
                    strSql.AppendLine(" And no.Ricetta_SuperUser = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "'")



                    If HashFerCodDigestati IsNot Nothing Then

                        Dim strSql_d As New StringBuilder

                        For Each fer_cod_d In HashFerCodDigestati.Keys
                            If strSql_d.Length = 0 Then
