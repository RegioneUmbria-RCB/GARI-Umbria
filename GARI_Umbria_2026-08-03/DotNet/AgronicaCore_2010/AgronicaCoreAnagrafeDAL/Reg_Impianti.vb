    Public Function LeggixReportProduzioneColturaCampo(ByVal Padre As String,
                                                       ByVal Id_Budget As Integer,
                                                       ByVal includiAziendeFiglie As Integer,
                                                       ByVal Validita_Inizio As Date,
                                                       ByVal Validita_Fine As Date,
                                                       ByVal xOrderBy As String,
                                                       ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                                       ) As DataTable

        Const nomeRoutine = "AnagrafeDAL.Reg_Impianti_Read.LeggixReportProduzioneColturaCampo()"

        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable
        Dim dt_aziende_padre As DataTable
        Dim filtro_piva_padre As String = ""
        Dim TabellaPrefisso As String = ""

        Try


            If Id_Budget <> 0 Then
                TabellaPrefisso = "Budget_"
            End If

            If Padre <> "" Then

                'Comprendo anche l'azienda padre
                filtro_piva_padre = "'" & Padre & "'"

                If includiAziendeFiglie = 1 Then

                    StrSQL.AppendLine(" select figlio from GerarchiaImprese where padre = '" & Agro_SQL_SaveText(Padre) & "' or padre in (select figlio from GerarchiaImprese where padre = '" & Agro_SQL_SaveText(Padre) & "')")

                    '-------------------------------------------------------------------------------
                    dt_aziende_padre = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
                    '-------------------------------------------------------------------------------

                    If dt_aziende_padre IsNot Nothing AndAlso dt_aziende_padre.Rows.Count > 0 Then
                        For Each r In dt_aziende_padre.Rows
                            filtro_piva_padre &= ",'" & r.Item("figlio") & "'"
                        Next
                    End If

                End If

            End If




            StrSQL.Length = 0
            StrSQL.AppendLine(" Select Distinct gi.Padre, i.rag_soc, ri.PIVA, ri.SA_COD, ri.APPEZZA, ri.ID_REG " &
                              " , isnull(sv.Veg_cod, 0) as Veg_Cod, isnull(sv.Veg_Des, '') as Specie, isnull(ri.CUL_COD, 0) as Cul_Cod, isnull(c.Cul_Des, '') as Varieta " &
                              " , ri.GRFI_COD, gf.Grfi_Des as Finalita ")
            StrSQL.AppendLine(" , a.APP_NOME, a.Campo_Cod, ca.Campo_Des ")
            StrSQL.AppendLine(" , a.SUP_APP, ri.Sup_Imp, isnull(RC.Val_Cod, 0) as Potenziale_Metanigeno ")
            StrSQL.AppendLine(" , ri.Validita_Inizio as Val_Inizio_Impianto, ri.Validita_Fine as Val_Fine_Impianto ")
            StrSQL.AppendLine(" , ip.Progetto_Cod, ip.Progetto_Nome, ip.Progetto_Des, ip.FlagSecondoRaccolto ")
            StrSQL.AppendLine(" , ip.Validita_Inizio as Val_Inizio_Esercizio, ip.Validita_Fine as Val_Fine_Esercizio,  ip.Produzione_Prevista ")

            StrSQL.AppendLine(" From " & TabellaPrefisso & "Reg_Impianti ri ")
            StrSQL.AppendLine(" inner Join Imprese i on ri.piva = i.piva ")
            StrSQL.AppendLine(" inner Join " & TabellaPrefisso & "Appezzamento a on ri.PIVA = a.Piva And ri.SA_COD = a.Sa_Cod And ri.APPEZZA = a.Appezza ")
            StrSQL.AppendLine(" Left Join " & TabellaPrefisso & "Campi ca ON a.PIVA = ca.Piva And a.SA_COD = ca.Sa_Cod And a.Campo_Cod = ca.Campo_Cod ")

            StrSQL.AppendLine(" Left Join GerarchiaImprese gi on i.piva = gi.Figlio ")
            StrSQL.AppendLine(" Left Join Cultivar c on ri.CUL_COD = c.Cul_Cod ")
            StrSQL.AppendLine(" Left Join SpecieVegetali sv on c.Veg_Cod = sv.Veg_Cod ")
            StrSQL.AppendLine(" Left Join GruppoFinalita gf on ri.GRFI_COD = gf.Grfi_Cod ")
            StrSQL.AppendLine(" Inner Join " & TabellaPrefisso & "Imprese_Progetti ip on ri.PIVA = ip.Piva And ri.SA_COD = ip.Sa_Cod And ri.APPEZZA = ip.Appezza And ri.ID_REG = ip.Id_Reg ")

            StrSQL.AppendLine(" LEFT JOIN " & TabellaPrefisso & "Reg_Impianti_Codici RC ")
            StrSQL.AppendLine("   ON ri.piva = RC.piva ")
            StrSQL.AppendLine("   AND ri.SA_COD = RC.sa_cod ")
            StrSQL.AppendLine("   AND ri.APPEZZA = RC.appezza ")
            StrSQL.AppendLine("   AND ri.ID_REG = RC.Id_Reg ")
            StrSQL.AppendLine("   AND RC.id_cod = 1339 ")


            StrSQL.AppendLine(" WHERE ip.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine) & " ")
            StrSQL.AppendLine(" AND ip.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio) & " ")
            StrSQL.AppendLine(" AND ri.Cul_Cod <> 0 ")

            'Considero solo il primo in periodo temporale (evito il doppio conteggio di una sup
            StrSQL.AppendLine(" AND   IP.Progetto_Cod In (Select Top 1 Progetto_Cod  From " & TabellaPrefisso & "Imprese_Progetti IP2 ")
            StrSQL.AppendLine("                         Where   IP2.Validita_inizio <= " & Agro_SQL_SaveDate(Validita_Fine) & " ")
            StrSQL.AppendLine("                         AND     IP2.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio) & " ")
            StrSQL.AppendLine("                         AND     IP2.Piva = ri.Piva ")
            StrSQL.AppendLine("                         AND     IP2.Sa_Cod = ri.Sa_Cod ")
            StrSQL.AppendLine("                         AND     IP2.Appezza = ri.Appezza ")
            StrSQL.AppendLine("                         AND     IP2.Id_Reg = ri.Id_Reg  )")

            If Trim(filtro_piva_padre) <> "" Then
                'Costruzione stringa con apici
                StrSQL.AppendLine(" And ri.piva In (" & Agro_SQL_Save_Clausola_IN(filtro_piva_padre, True) & ") ")
            End If

            If Id_Budget <> 0 Then
                StrSQL.Append(" And " & TabellaPrefisso & "Reg_impianti.Id_Budget = " & Agro_SQL_SaveNum(Id_Budget) & " ")
            End If

            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '---------------------------------------------

            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] :    " & messaggioErrore)
        End Try

        Return dt

    End Function

    Public Function Leggi_CoopPadri_Impianti(ByVal listaPiva As List(Of String),
                       ByVal filtroImpianti As String,
                       ByVal tipo_selezione As String,
                       ByVal xOrderBy As String,
                       ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
               ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_CoopPadri_Impianti()"

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable

        'Formatto il filtro per la query SQL in base agli impianti/aziende forniti/e
        Select Case tipo_selezione
            Case "impianto"
                filtroImpianti = filtroImpianti.Replace("Reg_Impianti", "Reg_Impianti_Codici")
            Case "azienda"
                filtroImpianti = filtroImpianti.Replace("Imprese", "Reg_Impianti_Codici")
        End Select

        Try

            StrSQL.Length = 0

            If listaPiva Is Nothing OrElse listaPiva.Count = 0 Then
                Throw New Exception("La lista di PIVA è vuota.")
            End If

            ConnessioniTransazioni.ApriConnessione(True, objParametri)

            TempChiaviMassivo.CreaTabellaTemp_FiltroPiva(listaPiva, NomeRoutine, objParametri)

            StrSQL.AppendLine("         SELECT         ")
            StrSQL.AppendLine("         ISNULL(ImpreseReferenti.rag_soc, '') as rag_soc_padre,         ")
            StrSQL.AppendLine("         ISNULL(Reg_Impianti_Codici.PIVA, '') AS piva_padre,         ")
            StrSQL.AppendLine("         ISNULL(Indirizzi.ind_des, '') AS ind_coop,         ")
            StrSQL.AppendLine("         ISNULL(ISTAT.LOCALITA, '') AS com_coop,         ")
            StrSQL.AppendLine("         ISNULL(ISTAT.COMUNI_PROV, '')  AS prov_coop,         ")
            StrSQL.AppendLine("         ISNULL(ISTAT.CAP, '') AS cap_coop,         ")
            StrSQL.AppendLine("         ISNULL(GerarchiaImprese.LibroSoci_Codice, '') as codice_libro_soci,         ")
            StrSQL.AppendLine("         ISNULL(GerarchiaImprese.LibroSoci_DataIscrizione, '01/01/1900') as data_libro_soci         ")
            StrSQL.AppendLine("         From Reg_Impianti_Codici         ")

            StrSQL.AppendLine("         INNER JOIN #TempPiva tmp ON tmp.Piva = Reg_Impianti_Codici.Piva COLLATE DATABASE_DEFAULT         ")
            StrSQL.AppendLine("         JOIN Imprese AS ImpreseReferenti ON ImpreseReferenti.PIVA = Reg_Impianti_Codici.val_cod         ")
            StrSQL.AppendLine("         LEFT JOIN GerarchiaImprese ON GerarchiaImprese.Padre = ImpreseReferenti.PIVA AND GerarchiaImprese.Figlio = Reg_Impianti_Codici.Piva         ")
            StrSQL.AppendLine("         LEFT JOIN ImpresexIndirizzi ON ImpresexIndirizzi.PIVA = ImpreseReferenti.PIVA         ")
            StrSQL.AppendLine("         LEFT JOIN Indirizzi ON ImpresexIndirizzi.cod_indirizzo = Indirizzi.cod_indirizzo         ")
            StrSQL.AppendLine("         LEFT JOIN ISTAT ON ISTAT.PROV = Indirizzi.pro_cod_istat AND ISTAT.COM = Indirizzi.com_cod_istat         ")

            StrSQL.AppendLine("         WHERE 1 = 1         ")
            StrSQL.AppendLine($"        AND Reg_Impianti_Codici.id_cod = {CInt(enum_CodiciAnagrafe.Organismo_Referente)}         ")

            If filtroImpianti <> "" Then
                StrSQL.AppendLine(" " & filtroImpianti & " ")
            End If

            StrSQL.AppendLine("         GROUP BY         ")
            StrSQL.AppendLine("         ImpreseReferenti.rag_soc,         ")
            StrSQL.AppendLine("         Reg_Impianti_Codici.PIVA,         ")
            StrSQL.AppendLine("         ImpreseReferenti.rag_soc,         ")
            StrSQL.AppendLine("         ImpreseReferenti.PIVA,         ")
            StrSQL.AppendLine("         Indirizzi.ind_des,         ")
            StrSQL.AppendLine("         ISTAT.LOCALITA,         ")
            StrSQL.AppendLine("         ISTAT.COMUNI_PROV,         ")
            StrSQL.AppendLine("         ISTAT.CAP,         ")
            StrSQL.AppendLine("         GerarchiaImprese.LibroSoci_Codice,         ")
            StrSQL.AppendLine("         GerarchiaImprese.LibroSoci_DataIscrizione         ")

            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

            ' Eliminazione tabella temporanea
            TempChiaviMassivo.EliminaTabellaTemp_FiltroPiva(NomeRoutine, objParametri)

            'commit transazione
            ConnessioniTransazioni.ChiudiTransazione(1, objParametri)

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            'rollback transazione
            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazione(2, objParametri)
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        Finally
            ConnessioniTransazioni.ChiudiConnessione(objParametri)
        End Try

        Return DT

    End Function

    Function Imp_Cod_Irrigazione_From_Impianto(ByVal Piva As String, ByVal Sa_Cod As Integer, ByVal Appezza As Integer, ByVal ID_Reg As Integer, ByVal objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri) As Integer
        Dim NomeRoutine As String = "AgronicaCoreAnagrafeDAL.Reg_Impianti.Imp_Cod_Irrigazione_From_Impianto()"

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable

        Try
            StrSQL.Length = 0

            StrSQL.AppendLine(" SELECT IMP_COD  ")
            StrSQL.AppendLine(" FROM  Reg_Impianti ")
            StrSQL.AppendLine(" WHERE Reg_Impianti.Validita_inizio < " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & " ")
            StrSQL.AppendLine(" AND   Reg_Impianti.Validita_Fine > " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & " ")

            If Piva <> "" Then
                StrSQL.AppendLine(" AND  Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Trim(Piva)) & "'")
            End If

            If Sa_Cod <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            End If

            If Appezza <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
            End If

            If ID_Reg <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.Id_Reg = " & Agro_SQL_SaveNum(ID_Reg) & " ")
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception

            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)

        End Try

        If IsDBNull(DT.Rows(0).Item("IMP_COD")) Then
            Return -1
        End If
        Return CInt(DT.Rows(0).Item("IMP_COD"))
    End Function

