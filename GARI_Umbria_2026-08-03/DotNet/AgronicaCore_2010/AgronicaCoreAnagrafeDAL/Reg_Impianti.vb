            StrSQL.AppendLine("   ,Volatilizzazione  =  " & Agro_SQL_SaveNum(Volatilizzazione) & " ")
            StrSQL.AppendLine("   ,GrVa_Cod_Veg      =  " & Agro_SQL_SaveNum(GrVa_Cod_Veg) & " ")
            StrSQL.AppendLine("   ,ProfonditaLav     =  " & Agro_SQL_SaveNum(Profonditalav) & " ")
            StrSQL.AppendLine("   ,Id_Campo          =  " & Agro_SQL_SaveNum(Id_Campo) & " ")
            StrSQL.AppendLine("   ,Su_Cod            =  " & IIf(Agro_SQL_SaveNum(Su_Cod, False) = -1, "Null", Agro_SQL_SaveNum(Su_Cod)) & " ")
            StrSQL.AppendLine("   ,Cop_Cod           =  " & IIf(Agro_SQL_SaveNum(Cop_Cod, False) = -1, "Null", Agro_SQL_SaveNum(Cop_Cod)) & " ")
            StrSQL.AppendLine("   ,Cover             =  " & Agro_SQL_SaveNum(Cover) & " ")
            StrSQL.AppendLine("   ,Monitorato        =  " & Agro_SQL_SaveNum(Monitorato) & " ")
