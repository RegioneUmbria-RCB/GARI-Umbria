            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT Appezzamento.APP_NOME, Appezzamento.Campo_Cod, Reg_Impianti.Piva, Reg_Impianti.sa_Cod, Reg_Impianti.Appezza, Reg_Impianti.Id_reg, Reg_Impianti.Sup_Imp, Reg_Impianti.Validita_Inizio, Reg_Impianti.Validita_Fine,    ")
