                          ByVal xOrderBy As String,
                          ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri,
                            Optional ByVal filtraSpecie As Boolean = True
                          ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_ImpiantiConSpecieSelezionata_PerSemina()"

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable
        Dim i As Integer
        Dim strFiltroImpianti As New System.Text.StringBuilder

        Try
            If objParametri.PivaSuperUser = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva_Superuser obbligatorio)")
            End If

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT  ")
            StrSQL.AppendLine("         Reg_Impianti.Piva, Reg_Impianti.sa_cod, Reg_Impianti.appezza, Reg_Impianti.id_reg, Reg_Impianti.sup_imp, Reg_Impianti.grfi_cod, Reg_Impianti.validita_inizio,Reg_Impianti.validita_fine,")
            StrSQL.AppendLine("         Centri_Aziendali.sa_Nome, Imprese.rag_soc, ")
            StrSQL.AppendLine("         Cultivar.Veg_Cod, SpecieVegetali.Veg_Des, ")
            StrSQL.AppendLine("         Cultivar.Cul_Cod, Cultivar.Cul_Des, ")
