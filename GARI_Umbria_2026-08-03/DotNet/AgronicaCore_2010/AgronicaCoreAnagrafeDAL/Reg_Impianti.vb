    Public Function SommaSuperficie_SPV(ByVal Piva As String,
                                        ByVal Veg_Cod As Integer,
                                        ByVal Cul_Cod As Integer,
                                        ByVal Validita_Inizio As Date,
                                        ByVal Validita_Fine As Date,
                                        ByVal Mat_Cod_Raccolta As Integer,
                                        ByVal bEscludi_Impianti_Raccolti As Boolean,
                                        ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                       ) As Decimal


        Dim NomeRoutine As String = "AgronicaCoreAnagrafeDAL.Reg_Impianti.SommaSuperficie_SPV()"

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable

        Try
            StrSQL.Length = 0

            StrSQL.AppendLine(" SELECT sum(Sup_Imp) as Sup_Imp_SPV  ")
            StrSQL.AppendLine(" FROM  Reg_Impianti ")
            StrSQL.AppendLine(" WHERE Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Trim(Piva)) & "'")

            StrSQL.AppendLine(" AND   Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(Validita_Fine) & " ")
            StrSQL.AppendLine(" AND   Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio) & " ")

            'Controllo Specie Vegetale
            Select Case Veg_Cod
                Case -1000 'Dummy --> Tutti
                Case 0 'Terreno Nudo
                    StrSQL.AppendLine(" AND Reg_Impianti.Cul_Cod = 0 ")
                Case Else
                    If Cul_Cod = 0 Then
                        StrSQL.AppendLine(" AND Reg_Impianti.Cul_Cod In (Select Cul_Cod From Cultivar Where Veg_Cod = " & Veg_Cod & ") ")
                    Else
                        StrSQL.AppendLine(" AND Reg_Impianti.Cul_Cod = " & Cul_Cod & " ")
                    End If

            End Select

            'Controllo Superficie Impianti Raccolti per Mat_Cod
            If Mat_Cod_Raccolta <> 0 Then

                StrSQL.AppendLine(" AND  Exists (Select * From Agenda, Movimenti_Dettagli, Mov_Destinazioni ")
                StrSQL.AppendLine(" Where Lav_Cod = 125 And Tipo_Destinazione = 0 ")
                StrSQL.AppendLine(" AND Movimenti_Dettagli.Mat_Cod = " & Mat_Cod_Raccolta & " ")
                StrSQL.AppendLine(" And   Agenda.Piva = Movimenti_Dettagli.Piva ")
                StrSQL.AppendLine(" And   Agenda.Id_Agenda = Movimenti_Dettagli.Id_Agenda ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Piva = Movimenti_Dettagli.Piva ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Id_Agenda = Movimenti_Dettagli.Id_Agenda ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Id_Mov_Det = Movimenti_Dettagli.Id_Mov_Det ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Piva = Reg_Impianti.Piva ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Sa_Cod = Reg_Impianti.Sa_Cod ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Appezza = Reg_Impianti.Appezza ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Id_Destinazione = Reg_Impianti.Id_Reg) ")

            ElseIf bEscludi_Impianti_Raccolti Then

                StrSQL.AppendLine(" AND  Not Exists (Select * From Agenda, Movimenti_Dettagli, Mov_Destinazioni ")
                StrSQL.AppendLine(" Where Lav_Cod = 125 And Tipo_Destinazione = 0 ")
                StrSQL.AppendLine(" And   Agenda.Piva = Movimenti_Dettagli.Piva ")
                StrSQL.AppendLine(" And   Agenda.Id_Agenda = Movimenti_Dettagli.Id_Agenda ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Piva = Movimenti_Dettagli.Piva ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Id_Agenda = Movimenti_Dettagli.Id_Agenda ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Id_Mov_Det = Movimenti_Dettagli.Id_Mov_Det ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Piva = Reg_Impianti.Piva ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Sa_Cod = Reg_Impianti.Sa_Cod ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Appezza = Reg_Impianti.Appezza ")
                StrSQL.AppendLine(" And   Mov_Destinazioni.Id_Destinazione = Reg_Impianti.Id_Reg) ")


            End If




            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception

            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] :   " & MessaggioErrore)

        End Try

        If IsDBNull(DT.Rows(0).Item("Sup_Imp_SPV")) Then
            Return 0
        End If
        Return CDbl(DT.Rows(0).Item("Sup_Imp_SPV"))

    End Function

    Public Function SommaResaPrevista_SPV(ByVal Piva As String,
                                          ByVal id_budget As Integer,
                                          ByVal Veg_Cod As Integer,
                                          ByVal Cul_Cod As Integer,
                                          ByVal validita_inizio As Date,
                                          ByVal validita_fine As Date,
                                          ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                          Optional ByVal xFiltroAggiuntivo As String = ""
                                          ) As Decimal

        Dim NomeRoutine As String = "AgronicaCoreAnagrafeDAL.Reg_Impianti.SommaResaPrevista_SPV()"

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable
        Dim TabellaPrefisso As String = ""

        Try

            If id_budget <> 0 Then
                TabellaPrefisso = "Budget_"
            End If

            StrSQL.Length = 0

            StrSQL.AppendLine(" SELECT sum(Produzione_Prevista/1000 * " & TabellaPrefisso & "Reg_Impianti.Sup_Imp) as Resa_Prevista_SPV  ")
            StrSQL.AppendLine(" FROM  " & TabellaPrefisso & "Reg_Impianti, " & TabellaPrefisso & "Imprese_Progetti ")
            StrSQL.AppendLine(" WHERE " & TabellaPrefisso & "Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Trim(Piva)) & "'")

            StrSQL.AppendLine(" AND   " & TabellaPrefisso & "Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(validita_fine) & " ")
            StrSQL.AppendLine(" AND   " & TabellaPrefisso & "Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(validita_inizio) & " ")

            StrSQL.AppendLine(" AND   " & TabellaPrefisso & "Imprese_Progetti.Piva = " & TabellaPrefisso & "Reg_Impianti.Piva ")
            StrSQL.AppendLine(" AND   " & TabellaPrefisso & "Imprese_Progetti.Sa_Cod = " & TabellaPrefisso & "Reg_Impianti.Sa_Cod ")
            StrSQL.AppendLine(" AND   " & TabellaPrefisso & "Imprese_Progetti.Appezza = " & TabellaPrefisso & "Reg_Impianti.Appezza ")
            StrSQL.AppendLine(" AND   " & TabellaPrefisso & "Imprese_Progetti.Id_Reg = " & TabellaPrefisso & "Reg_Impianti.Id_Reg ")

            'Considero solo il primo in periodo temporale (evito il doppio conteggio di una sup
            StrSQL.AppendLine(" AND   " & TabellaPrefisso & "Imprese_Progetti.Progetto_Cod In (Select Top 1 Progetto_Cod  From " & TabellaPrefisso & "Imprese_Progetti IP ")
            StrSQL.AppendLine("                         Where   IP.Validita_inizio <= " & Agro_SQL_SaveDate(validita_fine) & " ")
            StrSQL.AppendLine("                         AND     IP.Validita_Fine >= " & Agro_SQL_SaveDate(validita_inizio) & " ")
            StrSQL.AppendLine("                         AND   IP.Piva = " & TabellaPrefisso & "Reg_Impianti.Piva ")
            StrSQL.AppendLine("                         AND   IP.Sa_Cod = " & TabellaPrefisso & "Reg_Impianti.Sa_Cod ")
            StrSQL.AppendLine("                         AND   IP.Appezza = " & TabellaPrefisso & "Reg_Impianti.Appezza ")
            StrSQL.AppendLine("                         AND   IP.Id_Reg = " & TabellaPrefisso & "Reg_Impianti.Id_Reg  )")

            Select Case id_budget

                Case 0

                    'Escludo gli impianti raccolta (per la quali verrà considerata la qta raccolta)
                    StrSQL.AppendLine(" AND   Not Exists (Select * From Agenda, Mov_Destinazioni ")
                    StrSQL.AppendLine(" Where Agenda.Piva = Mov_Destinazioni.Piva ")
                    StrSQL.AppendLine(" And   Agenda.Id_Agenda = Mov_Destinazioni.Id_Agenda ")
                    StrSQL.AppendLine(" And   Lav_Cod = 125 And Tipo_Destinazione = 0 ")
                    StrSQL.AppendLine(" And   Mov_Destinazioni.Piva = " & TabellaPrefisso & "Reg_Impianti.Piva ")
                    StrSQL.AppendLine(" And   Mov_Destinazioni.Sa_Cod = " & TabellaPrefisso & "Reg_Impianti.Sa_Cod ")
                    StrSQL.AppendLine(" And   Mov_Destinazioni.Appezza = " & TabellaPrefisso & "Reg_Impianti.Appezza ")
                    StrSQL.AppendLine(" And   Mov_Destinazioni.Id_Destinazione = " & TabellaPrefisso & "Reg_Impianti.Id_Reg ) ")


                Case Else

                    If id_budget <> 0 Then
                        StrSQL.Append(" And " & TabellaPrefisso & "Reg_impianti.Id_Budget = " & Agro_SQL_SaveNum(id_budget) & " ")
                    End If


            End Select


            'Controllo Specie Vegetale
            Select Case Veg_Cod
                Case -1000 'Dummy --> Tutti                    
                Case 0 'Terreno Nudo
                    StrSQL.AppendLine(" And " & TabellaPrefisso & "Reg_Impianti.Cul_Cod = 0 ")
                Case Else
                    If Cul_Cod = 0 Then
                        'Filtro Veg_Cod
                        StrSQL.AppendLine(" And " & TabellaPrefisso & "Reg_Impianti.Cul_Cod In (Select Cul_Cod From Cultivar Where Veg_Cod = " & Veg_Cod & ") ")
                    Else
                        'Filtro Cul_Cod
                        StrSQL.AppendLine(" And " & TabellaPrefisso & "Reg_Impianti.Cul_Cod = " & Cul_Cod & " ")
                    End If

            End Select


            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception

            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] :   " & MessaggioErrore)

        End Try

        If IsDBNull(DT.Rows(0).Item("Resa_Prevista_SPV")) Then
            Return 0
        End If
        Return CDbl(DT.Rows(0).Item("Resa_Prevista_SPV"))

    End Function

    'Lettura dei Mat_Cod, Sup Trattata e Qta  relativi a raccolte
    Public Function LeggiProduzione_SPV(ByVal PIVA As String,
                                        ByVal Veg_Cod As Integer,
                                        ByVal Cul_Cod As Integer,
                                        ByVal Validita_Inizio As Date,
                                        ByVal Validita_Fine As Date,
                                        ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                        Optional ByVal xOrderBy As String = "",
                                        Optional ByVal xFiltroAggiuntivo As String = ""
                                        ) As DataTable

        Dim NomeRoutine As String = "AgronicaCoreAnagrafeDAL.Reg_Impianti.LeggiProduzione_SPV()"

        Dim messaggioErrore As String = ""
        Dim strSql As New StringBuilder
        Dim dt As DataTable

        Try
            strSql.Length = 0
            strSql.Append(" SELECT Distinct Materie_Prime.Mat_Cod, Materie_Prime.Mat_Des, Isnull(Materie_Prime.Priorita, 0) as Priorita, Mov_Destinazioni.Qta2, Mov_Destinazioni.Qta,  ")
            strSql.Append(" Mov_Destinazioni.Piva, Mov_Destinazioni.Id_Agenda, Mov_Destinazioni.Sa_Cod, Mov_Destinazioni.Appezza, Mov_Destinazioni.Id_Destinazione ")
            strSql.Append(" FROM Agenda, Movimenti, Movimenti_Dettagli, Mov_Destinazioni, Reg_Impianti, Materie_Prime ")
            strSql.Append(" WHERE Agenda.Lav_Cod = 125 And Tipo_Destinazione = 0")
            strSql.Append(" And Agenda.Piva = Movimenti.Piva")
            strSql.Append(" And Agenda.Id_Agenda = Movimenti.Id_Agenda")
            strSql.Append(" And Movimenti.Piva = Movimenti_Dettagli.Piva")
            strSql.Append(" And Movimenti.Id_Agenda = Movimenti_Dettagli.Id_Agenda")
            strSql.Append(" And Movimenti.Id_Mov = Movimenti_Dettagli.Id_Mov")
            strSql.Append(" And Movimenti_Dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det")
            strSql.Append(" And Movimenti_Dettagli.Elem_Cod = Materie_Prime.Elem_Cod")
            strSql.Append(" And Movimenti_Dettagli.Mat_Cod = Materie_Prime.Mat_Cod")
            strSql.Append(" And Movimenti.Data_Movimento <= " & Agro_SQL_SaveDate(Validita_Fine) & " ")
            strSql.Append(" And Movimenti.Data_Movimento >= " & Agro_SQL_SaveDate(Validita_Inizio) & " ")
            strSql.AppendLine(" And Mov_destinazioni.Piva = Reg_Impianti.Piva ")
            strSql.AppendLine(" And Mov_destinazioni.Sa_Cod = Reg_Impianti.Sa_Cod ")
            strSql.AppendLine(" And Mov_destinazioni.Appezza = Reg_Impianti.Appezza ")
            strSql.AppendLine(" And Mov_destinazioni.Id_Destinazione = Reg_Impianti.Id_Reg ")

            If Trim(PIVA) <> "" Then
                strSql.AppendLine(" And   Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Trim(PIVA)) & "'")
            End If

            'Controllo Specie Vegetale
            Select Case Veg_Cod
                Case -1000 'Dummy --> Tutti
                Case 0 'Terreno Nudo
                    strSql.AppendLine(" AND Reg_Impianti.Cul_Cod = 0 ")
                Case Else
                    If Cul_Cod = 0 Then
                        'Filtro sul Veg_Cod
                        strSql.AppendLine(" AND Reg_Impianti.Cul_Cod In (Select Cul_Cod From Cultivar Where Veg_Cod = " & Veg_Cod & ") ")
                    Else
                        'Filtro sul Cul_Cod
                        strSql.AppendLine(" AND Reg_Impianti.Cul_Cod = " & Cul_Cod & " ")
                    End If

            End Select

            If xFiltroAggiuntivo <> "" Then
                strSql.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If

            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    strSql.Append(" AND   Movimenti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    strSql.Append(" AND   Movimenti.Inviato =-1 ")
