                    strSql.AppendLine(" GROUP BY Ricette_Destinazioni.Ricetta_SuperUser, Ricette_Destinazioni.Piva, Ricette_Destinazioni.sa_cod, Ricette_Destinazioni.appezza, Ricette_Destinazioni.id_reg, Imprese_Progetti.progetto_cod   ")

                    strSql.AppendLine(" ) n ")

                    strSql.AppendLine(" 	 On  n.piva = ip.piva ")
                    strSql.AppendLine(" And n.sa_cod = ip.sa_cod  ")
                    strSql.AppendLine(" And n.appezza = ip.Appezza ")
                    strSql.AppendLine(" And  n.id_reg = ip.Id_Reg  ")
                    strSql.AppendLine(" And n.progetto_cod = ip.Progetto_Cod  ")
                    strSql.AppendLine(" And n.Ricetta_SuperUser = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "'")



                    strSql.AppendLine(" Left Join ( ")

                    strSql.AppendLine(" Select Ricette_Destinazioni.Ricetta_SuperUser, Ricette_Destinazioni.Piva, Ricette_Destinazioni.sa_cod,Ricette_Destinazioni.appezza, Ricette_Destinazioni.id_reg, Imprese_Progetti.progetto_cod  ")
                    strSql.AppendLine(" ,ISNULL( SUM (   ")
                    strSql.AppendLine(" Case    ")
                    strSql.AppendLine(" WHEN Ricette_Dettagli.extra_int = 2 Then Ricette_Dettagli.qta   ")
                    strSql.AppendLine(" WHEN Ricette_Dettagli.extra_int = 29 Then Ricette_Dettagli.qta   ")
                    strSql.AppendLine(" WHEN Ricette_Dettagli.extra_int = 19 Then Ricette_Dettagli.qta*1000   ")
