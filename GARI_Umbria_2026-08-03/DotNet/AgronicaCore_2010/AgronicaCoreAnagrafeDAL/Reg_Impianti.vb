            End If

            If Veg_Cod <> 0 Then
                StrSQL.AppendLine(" AND SpecieVegetali.Veg_Cod = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
            End If

            If Grfi_Cod <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.Grfi_Cod = " & Agro_SQL_SaveNum(Grfi_Cod) & " ")
