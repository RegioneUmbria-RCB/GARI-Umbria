    Public Function LeggiDescrImpianti(ByVal IdTestataTemp As Integer, ByVal anno As String, ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri) As DataTable


        Dim dt As DataTable
        Dim strSQL As New System.Text.StringBuilder
        Dim dataInizio = Date.Parse("01/01/" & anno)
        Dim dataFine = Date.Parse("31/12/" & anno)

        strSQL.Length = 0
        strSQL.AppendLine("select DISTINCT SpecieVegetali.Veg_Des,")
        strSQL.AppendLine("GruppoFinalita.Grfi_Cod,")
        strSQL.AppendLine("GruppoFinalita.Grfi_Des,")
        strSQL.AppendLine("ISNULL(GruppoVarietale.Grva_Des,'') AS Grva_Des,")
        strSQL.AppendLine("ISNULL((SELECT TOP 1 val_cod FROM reg_impianti_codici")
        strSQL.AppendLine("WHERE reg_impianti_codici.piva = Reg_impianti.piva")
        strSQL.AppendLine("AND reg_impianti_codici.appezza = reg_impianti.appezza")
        strSQL.AppendLine("AND  Reg_Impianti_Codici.id_reg = Reg_Impianti.ID_REG")
        strSQL.AppendLine("AND Reg_Impianti_Codici.id_cod = 1107), '') AS Dettaglio_Specie_Cod,")
        strSQL.AppendLine("ISNULL((SELECT TOP 1 val_cod FROM Reg_Impianti_Codici")
        strSQL.AppendLine("WHERE Reg_Impianti_Codici.Piva = Imprese_Progetti.PIVA")
        strSQL.AppendLine("AND Reg_Impianti_Codici.sa_cod = Imprese_Progetti.sa_cod")
        strSQL.AppendLine("AND Reg_Impianti_Codici.appezza = Imprese_Progetti.APPEZZA")
        strSQL.AppendLine("AND Reg_Impianti_Codici.id_reg = Imprese_Progetti.ID_REG")
        strSQL.AppendLine("AND Reg_Impianti_Codici.Progetto_Cod = Imprese_Progetti.Progetto_Cod")
        strSQL.AppendLine("AND Reg_Impianti_Codici.id_cod = 1093")
        strSQL.AppendFormat("AND Imprese_Progetti.validita_inizio <= {0} ", Agro_SQL_SaveDate(dataFine)).AppendLine()
        strSQL.AppendFormat("AND Imprese_Progetti.validita_fine >= {0}", Agro_SQL_SaveDate(dataInizio)).AppendLine()
        strSQL.AppendLine("), '') AS Capitolato_Cod")
        strSQL.AppendLine("from reg_impianti")
        strSQL.AppendLine("INNER JOIN Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod")
        strSQL.AppendLine("INNER JOIN Imprese_Progetti ON Imprese_Progetti.PIVA = Reg_Impianti.PIVA AND Imprese_Progetti.SA_COD = Reg_Impianti.SA_COD AND  Imprese_Progetti.APPEZZA = Reg_Impianti.APPEZZA AND  Imprese_Progetti.id_reg = Reg_Impianti.id_reg")
        strSQL.AppendLine("INNER JOIN SpecieVegetali ON  Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod")
        strSQL.AppendLine("INNER JOIN  GruppoFinalita ON Reg_Impianti.GRFI_COD = GruppoFinalita.Grfi_Cod")
        strSQL.AppendLine("LEFT OUTER JOIN GruppoVarietale ON Reg_Impianti.GRVA_Cod_VEG = GruppoVarietale.Grva_Cod")

        strSQL.AppendLine("INNER JOIN  __tmp_FiltroImpianti tmp ON ")
        strSQL.AppendLine("(Reg_Impianti.piva = tmp.piva AND Reg_Impianti.sa_cod = tmp.sa_Cod ")
        strSQL.Append("AND Reg_Impianti.appezza = tmp.appezza AND Reg_Impianti.id_reg = tmp.id_reg AND tmp.idTestataTemp = ").
            Append(Agro_SQL_SaveNum(IdTestataTemp)).
            AppendLine(")")

        dt = EseguiQuery_Lettura(objParametri, strSQL.ToString, "Reg_Impianti.LeggiDescrImpianti")


        Return dt

    End Function

    Public Function Leggi_Join_Appezzamento_Esercizio(
                   ByVal Piva As String,
                   ByVal Validita_Inizio As Date,
                   ByVal Validita_Fine As Date,
                   ByVal xFiltroAggiuntivo As String,
                   ByVal xOrderBy As String,
                   ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
           ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Join_Appezzamento_Esercizio()"

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable

        Try

            StrSQL.Length = 0
            StrSQL.AppendLine(" Select Reg_Impianti.*, Imprese_Progetti.Progetto_Cod, Appezzamento.Agea_codiBarrScheVali, Appezzamento.App_Nome, Appezzamento.Agea_idSchedaValidazione,Appezzamento.Agea_codiBarrScheVali,")
            StrSQL.AppendLine(" Appezzamento.Agea_identificativoIsola,Appezzamento.Agea_identificativoAppezzamento,Appezzamento.Agea_identificativoPianoColtivazione  ")
            StrSQL.AppendLine(" FROM Reg_Impianti WITH(NOLOCK)")
            StrSQL.AppendLine(" INNER JOIN Appezzamento WITH(NOLOCK)")
            StrSQL.AppendLine(" On Appezzamento.Piva = Reg_Impianti.Piva ")
            StrSQL.AppendLine(" And Appezzamento.Sa_Cod = Reg_Impianti.Sa_Cod ")
            StrSQL.AppendLine(" And Appezzamento.Appezza = Reg_Impianti.Appezza ")
            StrSQL.AppendLine(" INNER JOIN Imprese_Progetti WITH(NOLOCK)")
            StrSQL.AppendLine(" On Imprese_Progetti.Piva = Reg_Impianti.Piva ")
            StrSQL.AppendLine(" And Imprese_Progetti.Sa_Cod = Reg_Impianti.Sa_Cod ")
            StrSQL.AppendLine(" And Imprese_Progetti.Appezza = Reg_Impianti.Appezza ")
            StrSQL.AppendLine(" And Imprese_Progetti.Id_Reg = Reg_Impianti.Id_Reg ")
            StrSQL.AppendLine(" WHERE 1 = 1 ")

            If Piva <> "" Then
                StrSQL.AppendLine(" And  Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")
            End If

            If Validita_Inizio <> AGRODATAINIZIO Then
                StrSQL.AppendLine(" AND  Appezzamento.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio) & " ")
            End If

            If Validita_Fine <> AGRODATAFINE Then
                StrSQL.AppendLine(" AND  Appezzamento.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine) & " ")
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If

            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------


        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        Finally
            'Utility.VerificaChiudiConnessione(objParametri, flagConnessione)
        End Try

        Return DT

    End Function

    Public Function Leggi_x_ParametriAgenda(ByVal filtroProgetti As List(Of Integer), ByRef objParametri As AgronicaCoreParametri, Optional ByVal joinConTabellaCampi As Boolean = False) As DataTable

        Const nomeRoutine = "AnagrafeDAL.Reg_Impianti_Read.Leggi_x_PDC()"
        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable

        Dim objImpreseProgetti As New AgronicaCoreAnagrafeDAL.Impresa_Progetti_R
        Try

            ConnessioniTransazioni.ApriConnessione(True, objParametri)

            EseguiQuery_Scrittura(objParametri, objImpreseProgetti.CreaTabellaTemp_FiltroProgetti(), nomeRoutine)

            If Not IsNothing(filtroProgetti) AndAlso filtroProgetti.Any Then
                Dim chunks = ChunkBy(Of Integer)(filtroProgetti, 1000)
                For Each chunk In chunks
                    StrSQL.Append(" INSERT INTO #TempProgetti (Progetto_Cod) VALUES ")
                    For Each p As Integer In chunk
                        StrSQL.AppendLine(String.Format("({0}),", p))
                    Next
                    Dim strSqlInsert As String = StrSQL.ToString
                    strSqlInsert = strSqlInsert.Remove(strSqlInsert.LastIndexOf(","))
                    StrSQL.Clear()
                    EseguiQuery_Scrittura(objParametri, strSqlInsert, nomeRoutine)
                Next
            End If

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT  ")
            StrSQL.AppendLine("     Imprese_Progetti.progetto_cod, rag_soc, sa_nome, app_nome, Cultivar.veg_cod, veg_des, Cultivar.cul_cod, cul_des, sup_imp, ")
            StrSQL.AppendLine("     Reg_Impianti.grfi_cod, Reg_Impianti.Validita_Inizio, Reg_Impianti.Validita_Fine, Imprese_Progetti.Validita_Inizio as Validita_Inizio_Distinta, Imprese_Progetti.Validita_Fine as Validita_Fine_Distinta ")

            If joinConTabellaCampi Then
                StrSQL.AppendLine("     , Campi.Campo_Cod, Campi.Campo_Des ")
            End If

            StrSQL.AppendLine(" FROM Imprese_Progetti ")
            StrSQL.AppendLine(" JOIN Reg_Impianti ON ")
            StrSQL.AppendLine("     Reg_Impianti.PIVA = Imprese_Progetti.PIVA ")
            StrSQL.AppendLine(" AND Reg_Impianti.SA_COD = Imprese_Progetti.SA_COD ")
            StrSQL.AppendLine(" AND Reg_Impianti.APPEZZA = Imprese_Progetti.APPEZZA ")
            StrSQL.AppendLine(" AND Reg_Impianti.ID_REG = Imprese_Progetti.ID_REG ")
            StrSQL.AppendLine(" JOIN Appezzamento ON ")
            StrSQL.AppendLine("     Appezzamento.PIVA = Imprese_Progetti.PIVA ")
            StrSQL.AppendLine(" AND Appezzamento.SA_COD = Imprese_Progetti.SA_COD ")
            StrSQL.AppendLine(" AND Appezzamento.APPEZZA = Imprese_Progetti.APPEZZA ")
            StrSQL.AppendLine(" JOIN Centri_Aziendali ON ")
            StrSQL.AppendLine("     Centri_Aziendali.PIVA = Imprese_Progetti.Piva ")
            StrSQL.AppendLine(" AND Centri_Aziendali.sa_cod = Imprese_Progetti.sa_cod ")
            StrSQL.AppendLine(" JOIN Imprese ON ")
            StrSQL.AppendLine("     Imprese.PIVA = Imprese_Progetti.Piva ")
            StrSQL.AppendLine(" LEFT JOIN Cultivar ON ")
            StrSQL.AppendLine("     Reg_Impianti.Cul_Cod = Cultivar.Cul_Cod ")
            StrSQL.AppendLine(" LEFT JOIN SpecieVegetali ON ")
            StrSQL.AppendLine("     SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod ")

            If joinConTabellaCampi Then
                StrSQL.AppendLine(" LEFT JOIN Campi ON ")
                StrSQL.AppendLine("     Appezzamento.sa_cod = Campi.sa_cod AND Appezzamento.piva = Campi.piva AND Appezzamento.Campo_Cod = Campi.Campo_Cod")
            End If

            StrSQL.AppendLine(" INNER JOIN #TempProgetti tempP ON ")
            StrSQL.AppendLine("     Imprese_Progetti.Progetto_Cod = tempP.Progetto_Cod ")

            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

            ' Eliminazione tabella temporanea
            EseguiQuery_Scrittura(objParametri, objImpreseProgetti.EliminaTabellaTemp_FiltroProgetti, nomeRoutine)

            'commit transazione
            ConnessioniTransazioni.ChiudiTransazione(1, objParametri)

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    Public Function Leggi_NDistribuito_PerImpianto(chiaviList As List(Of (String, Integer, Integer, Integer)),
                                                   Pua_Regolamento_Cod As Integer,
                                                   filtroFerCodOrganici As String,
                                                   HashFerCodDigestati As Hashtable,
                                                   HashFerCodLetami As Hashtable,
                                                   HashFerCodLiquami As Hashtable,
                                                   ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                                   ) As DataTable

        Const nomeRoutine = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Dati_Impianti_per_PUA()"

        Dim messaggioErrore As String = ""
        Dim strSql As New StringBuilder
        Dim DT As DataTable

        Dim joinDigestati As Boolean = False
        Dim joinLetami As Boolean = False
        Dim joinLiquami As Boolean = False

        Try

            ConnessioniTransazioni.ApriConnessione(True, objParametri)

            TempChiaviMassivo.CreaTabellaTemp_FiltroImpianti(chiaviList, nomeRoutine, objParametri)

            Dim strSqlConversione As New StringBuilder
            strSqlConversione.Length = 0
            strSqlConversione.AppendLine($"         CASE WHEN Movimenti_Dettagli.extra_int = {CInt(enum_UnitaMisura.KG)} THEN Movimenti_Dettagli.qta ")
            strSqlConversione.AppendLine($"              WHEN Movimenti_Dettagli.extra_int = {CInt(enum_UnitaMisura.Litri)} THEN Movimenti_Dettagli.qta ")
            strSqlConversione.AppendLine($"              WHEN Movimenti_Dettagli.extra_int = {CInt(enum_UnitaMisura.Metri_Cubi)} THEN Movimenti_Dettagli.qta * 1000 ")
            strSqlConversione.AppendLine($"              WHEN Movimenti_Dettagli.extra_int = {CInt(enum_UnitaMisura.Tonnellate)} THEN Movimenti_Dettagli.qta * 1000 ")
            strSqlConversione.AppendLine($"              WHEN Movimenti_Dettagli.extra_int = {CInt(enum_UnitaMisura.Quintali)} THEN Movimenti_Dettagli.qta * 100 ")
            strSqlConversione.AppendLine($"              WHEN Movimenti_Dettagli.extra_int = {CInt(enum_UnitaMisura.CentimetriCubi)} THEN Movimenti_Dettagli.qta / 1000 ")
            strSqlConversione.AppendLine($"              WHEN Movimenti_Dettagli.extra_int = {CInt(enum_UnitaMisura.Millilitri)} THEN Movimenti_Dettagli.qta / 1000 ")
            strSqlConversione.AppendLine($"              WHEN Movimenti_Dettagli.extra_int = {CInt(enum_UnitaMisura.Grammi)} THEN Movimenti_Dettagli.qta / 1000 ")
            strSqlConversione.AppendLine("              ELSE 0 ")

            Dim strJoinTempImpianto As New StringBuilder
            strJoinTempImpianto.Length = 0
            strJoinTempImpianto.AppendLine(" INNER JOIN #TempImpianto TempImpianto ON ")
            strJoinTempImpianto.AppendLine("    Mov_Destinazioni.piva = TempImpianto.Piva ")
            strJoinTempImpianto.AppendLine(" AND Mov_Destinazioni.sa_Cod = TempImpianto.sa_Cod ")
            strJoinTempImpianto.AppendLine(" AND Mov_Destinazioni.appezza = TempImpianto.appezza ")
            strJoinTempImpianto.AppendLine(" AND Mov_Destinazioni.Id_Destinazione = TempImpianto.id_reg ")


            strSql.Length = 0
            strSql.AppendLine(" SELECT Piva, Sa_Cod, Appezza, ID_Reg, Id_Cod, Val_Cod ")
            strSql.AppendLine(" INTO #Codici ")
            strSql.AppendLine(" FROM Reg_Impianti_Codici ")
            strSql.AppendLine($" WHERE id_cod IN ({CInt(enum_CodiceAnagrafe_Clienti.Demetra)}) ")

#Region "N_FabbisognoSoddisfatto"
            strSql.AppendLine(" SELECT ")
            strSql.AppendLine("   Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod,Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione AS Id_Reg ")
            strSql.AppendLine("   , ISNULL(SUM( ")
            strSql.AppendLine(strSqlConversione.ToString())
            strSql.AppendLine("         END * Mov_Dettaglio_Tecnico.N / 100 * Mov_Dettaglio_Tecnico.efficienza), 0 ")
            strSql.AppendLine(" ) AS N_FabbisognoSoddisfatto ")
            strSql.AppendLine(" INTO #N ")
            strSql.AppendLine(" FROM Movimenti_Dettagli ")
            strSql.AppendLine(" INNER JOIN Agenda ON Movimenti_Dettagli.Id_Agenda = Agenda.Id_Agenda ")
            strSql.AppendLine(" INNER JOIN Mov_Dettaglio_Tecnico ON ")
            strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det ")
            strSql.AppendLine(" INNER JOIN Mov_Destinazioni ON ")
            strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Destinazioni.Id_Mov ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
            strSql.AppendLine(strJoinTempImpianto.ToString())
            strSql.AppendLine(" GROUP BY Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod, Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione ")
#End Region

#Region "N_FabbisognoSoddisfattoOrganico"
            strSql.AppendLine(" SELECT ")
            strSql.AppendLine("    Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod,Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione AS Id_Reg ")
            strSql.AppendLine("    , ISNULL(SUM( ")
            strSql.AppendLine(strSqlConversione.ToString())
            strSql.AppendLine("          END * Mov_Dettaglio_Tecnico.N / 100), 0 ")
            strSql.AppendLine(" ) AS N_FabbisognoSoddisfattoOrganico ")
            strSql.AppendLine(" INTO #N_Org ")
            strSql.AppendLine(" FROM Movimenti_Dettagli ")
            strSql.AppendLine(" INNER JOIN Agenda ON Movimenti_Dettagli.Id_Agenda = Agenda.Id_Agenda ")
            strSql.AppendLine(" INNER JOIN Mov_Dettaglio_Tecnico ON ")
            strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det ")
            strSql.AppendLine($" AND Movimenti_Dettagli.Elem_Cod = {CInt(CostantiPersonalizzate.FERTILIZZANTI)} ")
            strSql.AppendLine($" AND Movimenti_Dettagli.Pro_Cod IN {filtroFerCodOrganici} ")
            strSql.AppendLine(" INNER JOIN Mov_Destinazioni ON ")
            strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Destinazioni.Id_Mov ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
            strSql.AppendLine(strJoinTempImpianto.ToString())
            strSql.AppendLine(" GROUP BY  Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod, Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione ")
#End Region

#Region "N_SoddisfattoDigestato"
            If HashFerCodDigestati IsNot Nothing AndAlso HashFerCodDigestati.Count > 0 Then
                joinDigestati = True
                Dim listFiltroDigestati As New List(Of String)

                strSql.AppendLine(" SELECT Fer_Cod, Percentuale ")
                strSql.AppendLine(" INTO #Digestati ")
                strSql.AppendLine(" FROM ( ")

                For Each fer_cod_d In HashFerCodDigestati.Keys
                    listFiltroDigestati.Add("   SELECT " & fer_cod_d & " AS Fer_Cod, " & HashFerCodDigestati(fer_cod_d).ToString.Replace(",", ".") & " AS Percentuale ")
                Next

                strSql.AppendLine(String.Join(vbCrLf & "   UNION " & vbCrLf, listFiltroDigestati))

                strSql.AppendLine(" ) Digestati ")

                strSql.AppendLine(" SELECT ")
                strSql.AppendLine("    Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod,Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione AS Id_Reg ")
                strSql.AppendLine("    , ISNULL(SUM( ")
                strSql.AppendLine(strSqlConversione.ToString())
                strSql.AppendLine("          END * Mov_Dettaglio_Tecnico.N / 100 * Digestati.Percentuale / 100), 0 ")
                strSql.AppendLine(" ) AS N_SoddisfattoDigestato ")
                strSql.AppendLine(" INTO #N_Dig ")
                strSql.AppendLine(" FROM Movimenti_Dettagli ")
                strSql.AppendLine(" INNER JOIN Agenda ON Movimenti_Dettagli.Id_Agenda = Agenda.Id_Agenda ")
                strSql.AppendLine(" INNER JOIN Mov_Dettaglio_Tecnico ON ")
                strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det ")
                strSql.AppendLine($" AND Movimenti_Dettagli.Elem_Cod = {CInt(CostantiPersonalizzate.FERTILIZZANTI)} ")
                strSql.AppendLine(" INNER JOIN #Digestati Digestati ON Digestati.Fer_Cod = Movimenti_Dettagli.Pro_Cod ")
                strSql.AppendLine(" INNER JOIN Mov_Destinazioni ON ")
                strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Destinazioni.Id_Mov ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
                strSql.AppendLine(strJoinTempImpianto.ToString())
                strSql.AppendLine(" GROUP BY  Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod, Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione ")
            End If
#End Region

#Region "N_TotaleSoddisfatto"
            strSql.AppendLine(" SELECT ")
            strSql.AppendLine("    Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod,Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione AS Id_Reg ")
            strSql.AppendLine("    , ISNULL(SUM( ")
            strSql.AppendLine(strSqlConversione.ToString())
            strSql.AppendLine("          END * Mov_Dettaglio_Tecnico.N / 100), 0 ")
            strSql.AppendLine(" ) AS N_TotaleSoddisfatto ")
            strSql.AppendLine(" INTO #N_Tot ")
            strSql.AppendLine(" FROM Movimenti_Dettagli ")
            strSql.AppendLine(" INNER JOIN Agenda ON Movimenti_Dettagli.Id_Agenda = Agenda.Id_Agenda ")
            strSql.AppendLine(" INNER JOIN Mov_Dettaglio_Tecnico ON ")
            strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det ")
            strSql.AppendLine(" INNER JOIN Mov_Destinazioni ON ")
            strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Destinazioni.Id_Mov ")
            strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
            strSql.AppendLine(strJoinTempImpianto.ToString())
            strSql.AppendLine(" GROUP BY  Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod, Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione ")
#End Region

#Region "N_Zootecnico_Letame"
            If HashFerCodLetami IsNot Nothing AndAlso HashFerCodLetami.Count > 0 Then
                joinLetami = True
                Dim listFiltroLetami As New List(Of String)

                strSql.AppendLine(" SELECT Fer_Cod_Let, Percentuale_Let ")
                strSql.AppendLine(" INTO #Letami ")
                strSql.AppendLine(" FROM ( ")
                For Each fer_cod_let In HashFerCodLetami.Keys
                    listFiltroLetami.Add("   SELECT " & fer_cod_let & " AS Fer_Cod_Let, " & HashFerCodLetami(fer_cod_let).ToString.Replace(",", ".") & " AS Percentuale_Let ")
                Next

                strSql.AppendLine(String.Join(vbCrLf & "   UNION " & vbCrLf, listFiltroLetami))
                strSql.AppendLine(" ) Letami ")

                strSql.AppendLine(" SELECT ")
                strSql.AppendLine("    Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod,Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione AS Id_Reg ")
                strSql.AppendLine("    , ISNULL(SUM( ")
                strSql.AppendLine(strSqlConversione.ToString())
                strSql.AppendLine("          END * Mov_Dettaglio_Tecnico.N / 100 * Letami.Percentuale_Let / 100), 0 ")
                strSql.AppendLine(" ) AS N_Zootecnico_Letame ")
                strSql.AppendLine(" INTO #N_Let ")
                strSql.AppendLine(" FROM Movimenti_Dettagli ")
                strSql.AppendLine(" INNER JOIN Agenda ON Movimenti_Dettagli.Id_Agenda = Agenda.Id_Agenda ")
                strSql.AppendLine(" INNER JOIN Mov_Dettaglio_Tecnico ON ")
                strSql.AppendLine("    Movimenti_Dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det ")
                strSql.AppendLine($" AND Movimenti_Dettagli.Elem_Cod = {CInt(CostantiPersonalizzate.FERTILIZZANTI)} ")
                strSql.AppendLine(" INNER JOIN #Letami Letami ON Letami.Fer_Cod_Let = Movimenti_Dettagli.Pro_Cod ")
                strSql.AppendLine(" INNER JOIN Mov_Destinazioni ON ")
                strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Destinazioni.Id_Mov ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
                strSql.AppendLine(strJoinTempImpianto.ToString())
                strSql.AppendLine(" GROUP BY  Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod, Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione ")
            End If
#End Region

#Region "N_Zootecnico_Liquame"

            If HashFerCodLiquami IsNot Nothing AndAlso HashFerCodLiquami.Count > 0 Then
                joinLiquami = True
                Dim listFiltroLiquami As New List(Of String)

                strSql.AppendLine(" SELECT Fer_Cod_Liq, Percentuale_Liq ")
                strSql.AppendLine(" INTO #Liquami ")
                strSql.AppendLine(" FROM ( ")

                For Each fer_cod_liq In HashFerCodLiquami.Keys
                    listFiltroLiquami.Add("   SELECT " & fer_cod_liq & " AS Fer_Cod_Liq, " & HashFerCodLiquami(fer_cod_liq).ToString.Replace(",", ".") & " AS Percentuale_Liq ")
                Next

                strSql.AppendLine(String.Join(vbCrLf & "   UNION " & vbCrLf, listFiltroLiquami))
                strSql.AppendLine(" ) Liquami ")

                strSql.AppendLine(" SELECT ")
                strSql.AppendLine("    Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod,Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione AS Id_Reg ")
                strSql.AppendLine("    , ISNULL(SUM( ")
                strSql.AppendLine(strSqlConversione.ToString())
                strSql.AppendLine("          END * Mov_Dettaglio_Tecnico.N / 100 * Liquami.Percentuale_Liq / 100), 0 ")
                strSql.AppendLine(" ) AS N_Zootecnico_Liquame ")
                strSql.AppendLine(" INTO #N_Liq ")
                strSql.AppendLine(" FROM Movimenti_Dettagli ")
                strSql.AppendLine(" INNER JOIN Agenda ON Movimenti_Dettagli.Id_Agenda = Agenda.Id_Agenda ")
                strSql.AppendLine(" INNER JOIN Mov_Dettaglio_Tecnico ON ")
                strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det ")
                strSql.AppendLine($" AND Movimenti_Dettagli.Elem_Cod = {CInt(CostantiPersonalizzate.FERTILIZZANTI)} ")
                strSql.AppendLine(" INNER JOIN #Liquami Liquami ON Liquami.Fer_Cod_Liq = Movimenti_Dettagli.Pro_Cod ")
                strSql.AppendLine(" INNER JOIN Mov_Destinazioni ON ")
                strSql.AppendLine("     Movimenti_Dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov = Mov_Destinazioni.Id_Mov ")
                strSql.AppendLine(" AND Movimenti_Dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
                strSql.AppendLine(strJoinTempImpianto.ToString())
                strSql.AppendLine(" GROUP BY Mov_Destinazioni.Piva, Mov_Destinazioni.sa_cod, Mov_Destinazioni.appezza, Mov_Destinazioni.Id_Destinazione ")
            End If
#End Region

            strSql.AppendLine(" SELECT ")
            strSql.AppendLine("      TempImpianto.Piva, TempImpianto.Sa_Cod, TempImpianto.Appezza, TempImpianto.Id_Reg ")
            strSql.AppendLine("    , CodiceAGEA.Val_Cod AS Chiave_AGEA ")
            strSql.AppendLine("    , ISNULL(N.N_FabbisognoSoddisfatto,0) AS N_FabbisognoSoddisfatto ")
            strSql.AppendLine("    , ISNULL(N_Org.N_FabbisognoSoddisfattoOrganico,0) AS N_FabbisognoSoddisfattoOrganico ")
            strSql.AppendLine("    , ISNULL(N_Tot.N_TotaleSoddisfatto, 0) AS N_TotaleSoddisfatto ")

            If joinDigestati Then
                strSql.AppendLine("    , ISNULL(N_Dig.N_SoddisfattoDigestato, 0) AS N_SoddisfattoDigestato ")
            Else
                strSql.AppendLine("    , 0 AS N_SoddisfattoDigestato ")

            End If

            If joinLetami Then
                strSql.AppendLine("    , ISNULL(N_Let.N_Zootecnico_Letame, 0) AS N_Zootecnico_Letame ")
            Else
                strSql.AppendLine("    , 0 AS N_Zootecnico_Letame ")
            End If

            If joinLiquami Then
                strSql.AppendLine("    , ISNULL(N_Liq.N_Zootecnico_Liquame,0) AS N_Zootecnico_Liquame ")
            Else
                strSql.AppendLine("    , 0 AS N_Zootecnico_Liquame ")
            End If

            strSql.AppendLine(" FROM #TempImpianto TempImpianto ")
            strSql.AppendLine(" LEFT JOIN #N N ON ")
            strSql.AppendLine("     N.Piva = TempImpianto.PIVA ")
            strSql.AppendLine(" AND N.Sa_Cod = TempImpianto.SA_COD ")
            strSql.AppendLine(" AND N.Appezza = TempImpianto.Appezza ")
            strSql.AppendLine(" AND N.Id_Reg = TempImpianto.Id_Reg ")

            strSql.AppendLine(" LEFT JOIN #N_Org N_Org ON ")
            strSql.AppendLine("     N_Org.Piva = TempImpianto.PIVA ")
            strSql.AppendLine(" AND N_Org.Sa_Cod = TempImpianto.SA_COD ")
            strSql.AppendLine(" AND N_Org.Appezza = TempImpianto.Appezza ")
            strSql.AppendLine(" AND N_Org.Id_Reg = TempImpianto.Id_Reg ")

            strSql.AppendLine(" LEFT JOIN #N_Tot N_Tot ON ")
            strSql.AppendLine("     N_Tot.Piva = TempImpianto.PIVA ")
            strSql.AppendLine(" AND N_Tot.Sa_Cod = TempImpianto.SA_COD ")
            strSql.AppendLine(" AND N_Tot.Appezza = TempImpianto.Appezza ")
            strSql.AppendLine(" AND N_Tot.Id_Reg = TempImpianto.Id_Reg ")

            If joinDigestati Then
                strSql.AppendLine(" LEFT JOIN #N_Dig N_Dig ON ")
                strSql.AppendLine("     N_Dig.Piva = TempImpianto.PIVA ")
                strSql.AppendLine(" AND N_Dig.Sa_Cod = TempImpianto.SA_COD ")
                strSql.AppendLine(" AND N_Dig.Appezza = TempImpianto.Appezza ")
                strSql.AppendLine(" AND N_Dig.Id_Reg = TempImpianto.Id_Reg ")
            End If

            If joinLetami Then
                strSql.AppendLine(" LEFT JOIN #N_Let N_Let ON ")
                strSql.AppendLine("     N_Let.Piva = TempImpianto.PIVA ")
                strSql.AppendLine(" AND N_Let.Sa_Cod = TempImpianto.SA_COD ")
                strSql.AppendLine(" AND N_Let.Appezza = TempImpianto.Appezza ")
                strSql.AppendLine(" AND N_Let.Id_Reg = TempImpianto.Id_Reg ")
            End If

            If joinLiquami Then
                strSql.AppendLine(" LEFT JOIN #N_Liq N_Liq ON ")
                strSql.AppendLine("     N_Liq.Piva = TempImpianto.PIVA ")
                strSql.AppendLine(" AND N_Liq.Sa_Cod = TempImpianto.SA_COD ")
                strSql.AppendLine(" AND N_Liq.Appezza = TempImpianto.Appezza ")
                strSql.AppendLine(" AND N_Liq.Id_Reg = TempImpianto.Id_Reg ")
            End If

            'sostiuire con inner
            strSql.AppendLine(" JOIN #Codici CodiceAGEA ON ")
            strSql.AppendLine("     CodiceAGEA.PIVA = TempImpianto.PIVA ")
            strSql.AppendLine(" AND CodiceAGEA.sa_cod = TempImpianto.SA_COD ")
            strSql.AppendLine(" AND CodiceAGEA.appezza = TempImpianto.APPEZZA ")
            strSql.AppendLine(" AND CodiceAGEA.Id_Reg = TempImpianto.ID_REG ")

            strSql.AppendLine(" WHERE 1 = 1 ")



            strSql.AppendLine(" IF OBJECT_ID('tempdb.#Codici') IS NOT NULL DROP TABLE #Codici ")

            strSql.AppendLine(" IF OBJECT_ID('tempdb..#N') IS NOT NULL DROP TABLE #N ")
            strSql.AppendLine(" IF OBJECT_ID('tempdb..#N_Dig') IS NOT NULL DROP TABLE #N_Dig ")
            strSql.AppendLine(" IF OBJECT_ID('tempdb..#N_Org') IS NOT NULL DROP TABLE #N_Org ")
            strSql.AppendLine(" IF OBJECT_ID('tempdb..#N_Tot') IS NOT NULL DROP TABLE #N_Tot ")
            strSql.AppendLine(" IF OBJECT_ID('tempdb..#N_Let') IS NOT NULL DROP TABLE #N_Let ")
            strSql.AppendLine(" IF OBJECT_ID('tempdb..#N_Liq') IS NOT NULL DROP TABLE #N_Liq ")

            strSql.AppendLine(" IF OBJECT_ID('tempdb..#Digestati') IS NOT NULL DROP TABLE #Digestati ")
            strSql.AppendLine(" IF OBJECT_ID('tempdb..#Letami') IS NOT NULL DROP TABLE #Letami ")
            strSql.AppendLine(" IF OBJECT_ID('tempdb..#Liquami') IS NOT NULL DROP TABLE #Liquami ")

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, strSql.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

            ' Eliminazione tabella temporanea
            TempChiaviMassivo.EliminaTabellaTemp_FiltroImpianti(nomeRoutine, objParametri)
            'commit transazione
            ConnessioniTransazioni.ChiudiTransazione(1, objParametri)

        Catch ex As Exception
            ' Rollback
            ConnessioniTransazioni.ChiudiTransazione(2, objParametri)

            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            DT = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)

        Finally
            ConnessioniTransazioni.ChiudiConnessione(objParametri)
        End Try

        Return DT

    End Function

    Public Function LeggiImpianto_ControlliAnagrafica(ByVal Piva As String,
                                                      ByVal Sa_Cod As Integer,
                                                      ByVal Appezza As Integer,
                                                      ByVal Id_Reg As Integer,
                                                      ByRef objParametri As AgronicaCoreParametri
                                                      ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.LeggiImpianto_ControlliAnagrafica()"

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable

        Try

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT ")
            StrSQL.AppendLine("       Reg_Impianti.Piva ")
            StrSQL.AppendLine("     , Reg_Impianti.Sa_Cod ")
            StrSQL.AppendLine("     , Reg_Impianti.Appezza ")
            StrSQL.AppendLine("     , Reg_Impianti.Id_Reg ")
            StrSQL.AppendLine("     , Reg_Impianti.Validita_Inizio ")
            StrSQL.AppendLine("     , Reg_Impianti.Validita_Fine ")

            StrSQL.AppendLine("     , Reg_Impianti.Cul_Cod ")
            StrSQL.AppendLine("     , ISNULL(SpecieVegetali.Veg_Des,'') AS Veg_Des ")
            StrSQL.AppendLine("     , ISNULL(Cultivar.Cul_Des,'') AS Cul_Des ")
            StrSQL.AppendLine("     , Appezzamento.APP_NOME ")
            StrSQL.AppendLine("     , ISNULL(DestinazioneUsoDes.descrizione, '') AS destinazioneUso ")

            StrSQL.AppendLine(" FROM Reg_Impianti ")
            StrSQL.AppendLine(" INNER JOIN Appezzamento ON ")
            StrSQL.AppendLine("     Appezzamento.PIVA = Reg_Impianti.PIVA ")
            StrSQL.AppendLine(" AND Appezzamento.SA_COD = Reg_Impianti.SA_COD ")
            StrSQL.AppendLine(" AND Appezzamento.APPEZZA = Reg_Impianti.APPEZZA ")
            StrSQL.AppendLine(" LEFT JOIN Cultivar ON ")
            StrSQL.AppendLine("     Reg_Impianti.CUL_COD = Cultivar.Cul_Cod ")
            StrSQL.AppendLine(" LEFT JOIN SpecieVegetali ON ")
            StrSQL.AppendLine("     SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod ")

            StrSQL.AppendLine(" LEFT JOIN Reg_Impianti_Codici DestinazioneUsoCod ON ")
            StrSQL.AppendLine("     DestinazioneUsoCod.PIVA = Reg_Impianti.PIVA ")
            StrSQL.AppendLine(" AND DestinazioneUsoCod.sa_cod = Reg_Impianti.sa_cod ")
            StrSQL.AppendLine(" AND DestinazioneUsoCod.appezza = Reg_Impianti.appezza ")
            StrSQL.AppendLine(" AND DestinazioneUsoCod.ID_REG = Reg_Impianti.Id_Reg ")
            StrSQL.AppendLine(" AND DestinazioneUsoCod.id_cod >=3000 and DestinazioneUsoCod.id_cod<4000 ")
            StrSQL.AppendLine(" LEFT JOIN Codici_Anagrafe DestinazioneUsoDes ON DestinazioneUsoDes.codice = DestinazioneUsoCod.id_cod ")


            StrSQL.AppendLine(" WHERE 1 = 1")

            If Piva <> "" Then
                StrSQL.AppendLine(" AND Reg_Impianti.PIVA = '" & Agro_SQL_SaveText(Trim(Piva)) & "' ")
            End If

            If Sa_Cod <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            End If

            If Appezza <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
            End If

            If Id_Reg <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & " ")
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

    Public Function Leggi_Join_Appezzamento(
                   ByVal Piva As String,
                   ByVal Validita_Inizio As Date,
                   ByVal Validita_Fine As Date,
                   ByVal xFiltroAggiuntivo As String,
                   ByVal xOrderBy As String,
                   ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
           ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Join_Appezzamento()"

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable

        Try

            StrSQL.Length = 0
            StrSQL.AppendLine(" Select Reg_Impianti.*, Appezzamento.Agea_codiBarrScheVali, Appezzamento.App_Nome, Appezzamento.Agea_idSchedaValidazione,Appezzamento.Agea_codiBarrScheVali,")
            StrSQL.AppendLine(" Appezzamento.Agea_identificativoIsola,Appezzamento.Agea_identificativoAppezzamento,Appezzamento.Agea_identificativoPianoColtivazione  ")
            StrSQL.AppendLine(" FROM Reg_Impianti WITH(NOLOCK)")
            StrSQL.AppendLine(" INNER JOIN Appezzamento WITH(NOLOCK)")
            StrSQL.AppendLine(" On Appezzamento.Piva = Reg_Impianti.Piva ")
            StrSQL.AppendLine(" And Appezzamento.Sa_Cod = Reg_Impianti.Sa_Cod ")
            StrSQL.AppendLine(" And Appezzamento.Appezza = Reg_Impianti.Appezza ")
            StrSQL.AppendLine(" WHERE 1 = 1 ")

            If Piva <> "" Then
                StrSQL.AppendLine(" And  Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")
            End If

            If Validita_Inizio <> AGRODATAINIZIO Then
                StrSQL.AppendLine(" AND  Appezzamento.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio) & " ")
            End If

            If Validita_Fine <> AGRODATAFINE Then
                StrSQL.AppendLine(" AND  Appezzamento.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine) & " ")
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If

            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------


        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

End Class


