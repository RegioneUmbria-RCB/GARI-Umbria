    Public Function Leggi_ImpiantiConTerrenoNudo(
                            ByVal Piva As String,
                            ByVal Sa_Cod As Integer,
                            ByVal Data_Selezionata As Date,
                            ByVal Semina As Boolean,
                                ByVal xFiltroAggiuntivo As String,
                                ByVal xOrderBy As String,
                                ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_ImpiantiConTerrenoNudo()"


        Dim Inizio As Date
        Dim Fine As Date

        If Not Semina Then
            Inizio = Data_Selezionata
            Fine = Data_Selezionata
        Else
            Inizio = Data_Selezionata
            Fine = #12/31/2100#
        End If

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable
        Dim i As Integer
        Dim strFiltroImpianti As New System.Text.StringBuilder

        Try
            If objParametri.PivaSuperUser = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva_Superuser obbligatorio)")
            End If


            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT   ")
            StrSQL.AppendLine("         R.*,  ")
            StrSQL.AppendLine("         A.Sup_App,  ")
            StrSQL.AppendLine("         A.App_Nome, ")
            StrSQL.AppendLine("         A.Campo_Cod, ")
            StrSQL.AppendLine("         '' as Cul_Des,  ")
            StrSQL.AppendLine("         '' as Reg_Des,  ")
            StrSQL.AppendLine("         '' as Grfi_Des ")
            StrSQL.AppendLine(" FROM    ")
            StrSQL.AppendLine("          Reg_Impianti as R , ")
            StrSQL.AppendLine("          Appezzamento as A  ")

            StrSQL.AppendLine(" WHERE   (R.CUL_COD = " & 0 & ") ")
            StrSQL.AppendLine("         AND     (R.Validita_Inizio <= " & Agro_SQL_SaveDate(Inizio) & ") ")
            StrSQL.AppendLine("         AND     (R.Validita_Fine >= " & Agro_SQL_SaveDate(Fine) & ")")
            StrSQL.AppendLine("         AND     (R.Piva = A.Piva)")
            StrSQL.AppendLine("         AND     (R.Sa_Cod = A.Sa_Cod)")
            StrSQL.AppendLine("         AND     (R.Appezza = A.Appezza)")


            If Piva <> "" Then
                StrSQL.AppendLine(" AND  R.Piva = '" & Agro_SQL_SaveText(Trim(Piva)) & "'")
            End If

            If Sa_Cod <> 0 Then
                StrSQL.AppendLine(" AND R.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            Else
                'leggo se ci sono filtri sui centri
                Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                Dim FiltroCentri As String = ""
                Dim DtCentriVisibili As DataTable
                DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                    For i = 0 To DtCentriVisibili.Rows.Count - 1
                        FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                    Next
                    If FiltroCentri <> "" Then
                        StrSQL.AppendLine(" AND R.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                    End If
                End If
            End If


            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   R.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   R.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

    Public Function Leggi_ImpiantiConTerrenoNudo_PerSemina(
                            ByVal Piva As String,
                            ByVal Sa_Cod As Integer,
                            ByVal Data_Selezionata As Date,
                            ByVal Semina As Boolean,
                            ByVal xFiltroAggiuntivo As String,
                            ByVal xOrderBy As String,
                            ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                            ) As DataTable

        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_ImpiantiConTerrenoNudo_PerSemina()"


        Dim Inizio As Date
        Dim Fine As Date

        If Not Semina Then
            Inizio = Data_Selezionata
            Fine = Data_Selezionata
        Else
            Inizio = Data_Selezionata
            Fine = #12/31/2100#
        End If

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable
        Dim i As Integer
        Dim strFiltroImpianti As New System.Text.StringBuilder

        Try
            If objParametri.PivaSuperUser = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva_Superuser obbligatorio)")
            End If

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT  Reg_Impianti.Piva, Reg_Impianti.sa_cod, Reg_Impianti.appezza, Reg_Impianti.id_reg, Reg_Impianti.sup_imp, Reg_Impianti.cul_cod, Reg_Impianti.Grfi_cod, Reg_Impianti.validita_inizio, Reg_Impianti.validita_fine ")
            StrSQL.AppendLine(" , A.Sup_App, A.App_Nome, A.Campo_Cod, A.Blk_Flag, A.validita_inizio as validita_inizio_app, A.validita_fine as validita_fine_app ")
            StrSQL.AppendLine(" , ISNULL(Appezzamento_Codici.val_cod,'1') AS MetodoProduttivo ")
            StrSQL.AppendLine(" , CA.sa_cod, CA.sa_Nome, I.rag_soc, ISNULL(CMP.campo_des,'') AS campo_des")
            StrSQL.AppendLine(" , ISNULL(REG.Reg_Des,'') AS Reg_Des, ISNULL(GRF.Grfi_Des,'') AS Grfi_Des ")
            StrSQL.AppendLine(" , IP.progetto_cod, IP.progetto_nome, IP.cau_progetto ")
            StrSQL.AppendLine(" , IP.Regolamento_Cod, IP.Disciplinare_Cod, IP.Disciplinare_PubblicoPrivato, IP.p_ha, IP.validita_inizio as validita_inizio_distinta, IP.validita_fine as validita_fine_distinta ")
            StrSQL.AppendLine(" , ISNULL(RC.id_cod, 0) AS DestinazioneTerreniNudi_Cod ")
            StrSQL.AppendLine(" , ISNULL(CODANA.descrizione, 'Terreno Nudo') AS Veg_Des, ")

            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe.descrizione, '') as Codici_Anagrafe_Des ,  ")

            StrSQL.AppendLine("         ISNULL(( SELECT TOP 1 1  ")
            StrSQL.AppendLine("                     From mov_destinazioni md  ")
            StrSQL.AppendLine("                     INNER Join agenda a ")
            StrSQL.AppendLine("                     On a.PIVA=md.Piva ")
            StrSQL.AppendLine("                     And a.Id_Agenda=md.Id_Agenda ")
            StrSQL.AppendLine("                     WHERE Reg_Impianti.PIVA = md.Piva ")
            StrSQL.AppendLine("                     And Reg_Impianti.SA_COD=md.Sa_Cod ")
            StrSQL.AppendLine("                     And Reg_Impianti.APPEZZA=md.Appezza ")
            StrSQL.AppendLine("                     And Reg_Impianti.ID_REG=md.Id_Destinazione ")
            StrSQL.AppendLine("                     And (Lav_Cod = " & LAVCOD_SEMINA & " Or lav_cod=" & LAVCOD_TRAPIANTO & " Or Lav_Cod=" & LAVCOD_SOVESCIO & " Or Lav_Cod=" & LAVCOD_TRAPIANTO_IN_SERRA & " Or Lav_Cod=" & LAVCOD_SOD_SEDDING & ")) , 0 ")
            StrSQL.AppendLine("          ) AS esisteSeminaTrapianto  ")

            StrSQL.AppendLine(" FROM Reg_Impianti ")
            StrSQL.AppendLine(" INNER JOIN Appezzamento as A ")
            StrSQL.AppendLine("    ON Reg_Impianti.Piva = A.Piva AND Reg_Impianti.Sa_Cod = A.Sa_Cod AND Reg_Impianti.Appezza = A.Appezza")
            StrSQL.AppendLine(" INNER JOIN Centri_Aziendali as CA")
            StrSQL.AppendLine("    ON CA.Piva = A.Piva AND CA.Sa_Cod = A.Sa_Cod")
            StrSQL.AppendLine(" INNER JOIN Imprese as I")
            StrSQL.AppendLine("    ON I.Piva = CA.Piva")
            StrSQL.AppendLine(" LEFT JOIN Campi as CMP")
            StrSQL.AppendLine("    ON CMP.Piva = A.Piva AND CMP.Sa_Cod = A.Sa_Cod AND CMP.campo_cod = A.campo_cod")
            StrSQL.AppendLine(" INNER JOIN Imprese_Progetti as IP")
            StrSQL.AppendLine("    ON IP.Piva = Reg_Impianti.Piva AND IP.Sa_Cod = Reg_Impianti.Sa_Cod AND IP.Appezza = Reg_Impianti.Appezza AND IP.id_reg = Reg_Impianti.id_reg")
            StrSQL.AppendLine("    AND IP.Validita_Inizio <= " & Agro_SQL_SaveDate(Data_Selezionata) & " ")
            StrSQL.AppendLine("    AND IP.Validita_Fine >= " & Agro_SQL_SaveDate(Data_Selezionata) & " ")
            StrSQL.AppendLine(" LEFT JOIN Regolamenti REG")
            StrSQL.AppendLine("    ON IP.Regolamento_Cod = REG.Reg_Cod ")
            StrSQL.AppendLine(" LEFT JOIN GruppoFinalita GRF")
            StrSQL.AppendLine("    ON IP.Stato_Impianto = GRF.Grfi_Cod ")
            StrSQL.AppendLine(" LEFT JOIN Reg_Impianti_Codici RC ")
            StrSQL.AppendLine("   ON Reg_Impianti.piva = RC.piva ")
            StrSQL.AppendLine("   AND Reg_Impianti.SA_COD = RC.sa_cod ")
            StrSQL.AppendLine("   AND Reg_Impianti.APPEZZA = RC.appezza ")
            StrSQL.AppendLine("   AND Reg_Impianti.ID_REG = RC.Id_Reg ")
            StrSQL.AppendLine("   AND Reg_Impianti.Cul_Cod=0 ")
            StrSQL.AppendLine("   AND RC.id_cod BETWEEN 3000 And 3999 ")
            StrSQL.AppendLine(" LEFT JOIN Codici_Anagrafe CODANA")
            StrSQL.AppendLine("   ON CODANA.codice = RC.id_cod ")

            StrSQL.AppendLine("     LEFT OUTER JOIN ")
            StrSQL.AppendLine("         Appezzamento_Codici ON ")
            StrSQL.AppendLine("             Appezzamento_Codici.piva = A.piva AND ")
            StrSQL.AppendLine("             Appezzamento_Codici.sa_cod = A.sa_cod AND ")
            StrSQL.AppendLine("             Appezzamento_Codici.appezza = A.appezza AND ")
            StrSQL.AppendLine("             Appezzamento_Codici.id_cod = " & enum_CodiciAnagrafe.MetodoDiProduzione)

            StrSQL.AppendLine("     LEFT OUTER JOIN  Reg_Impianti_Codici on Reg_Impianti.PIVA=Reg_Impianti_Codici.PIVA and Reg_Impianti.SA_COD=Reg_Impianti_Codici.SA_COD and Reg_Impianti.APPEZZA=Reg_Impianti_Codici.APPEZZA and Reg_Impianti.id_reg=Reg_Impianti_Codici.id_reg and Reg_Impianti_Codici.id_cod >2999 and Reg_Impianti_Codici.id_cod < 4000 ")
            StrSQL.AppendLine("     LEFT OUTER JOIN  Codici_Anagrafe on Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")

            StrSQL.AppendLine(" WHERE   Reg_Impianti.CUL_COD = 0 ")
            StrSQL.AppendLine(" AND     Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(Inizio))
            StrSQL.AppendLine(" AND     Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(Fine))

            If Piva <> "" Then
                StrSQL.AppendLine(" AND Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Trim(Piva)) & "'")
            End If

            If Sa_Cod <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            Else
                'leggo se ci sono filtri sui centri
                Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                Dim FiltroCentri As String = ""
                Dim DtCentriVisibili As DataTable
                DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                    For i = 0 To DtCentriVisibili.Rows.Count - 1
                        FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                    Next
                    If FiltroCentri <> "" Then
                        StrSQL.AppendLine(" AND Reg_Impianti.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                    End If
                End If
            End If


            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
