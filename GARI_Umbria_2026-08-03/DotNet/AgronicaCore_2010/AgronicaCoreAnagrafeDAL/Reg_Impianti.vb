                                                          New Json2TmpTable.column("FF_Start_Cod", "INT", "Cod_SS")
                                                          }, json_ff_start))
            sql.AppendLine()
            sql.AppendLine()
            sql.AppendLine("DECLARE @TBL TABLE(SA_COD INT)")
            sql.AppendLine("INSERT INTO @TBL")
            sql.AppendLine("SELECT Sa_cod")
            sql.AppendLine("FROM Utenti_Visibilita_Appoggio (NOLOCK) ")
            sql.AppendLine("WHERE PivaSuperUser = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "'")
