                End If
                '02/09/2014 esclusa dalla copertura cop_cod=1 (protezione grandine)
                Select Case Flag_Protetto
                    Case 1
                        StrSQL.AppendLine(" AND Reg_Impianti.Cop_Cod <> 0 AND Reg_Impianti.Cop_Cod <> 1 AND Reg_Impianti.Cop_Cod <> 3 AND Reg_Impianti.Cop_Cod <> 4 AND Reg_Impianti.Cop_Cod <> 5 AND Reg_Impianti.Cop_Cod <> 6 ")
