                        StrSQL.AppendLine("     AND Cultivar.Cul_Cod  IN (" & Agro_SQL_Save_Clausola_IN(Cul_Cod, False) & ") ")
                    End If
                Else
                    'TERRENO NUDO
                    StrSQL.AppendLine("     AND Reg_Impianti.CUL_COD = 0  ")
