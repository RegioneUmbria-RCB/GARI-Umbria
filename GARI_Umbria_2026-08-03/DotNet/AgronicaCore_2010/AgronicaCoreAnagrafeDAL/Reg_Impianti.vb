            'sbagliato, il regolamento è quello presente nella distinta, in Imprese_Progetti
            'StrSQL.AppendLine("         Regolamenti ON Reg_Impianti.REGOLAMENTO = Regolamenti.Reg_Cod ON Cultivar.Cul_Cod = Reg_Impianti.CUL_COD ")

            StrSQL.AppendLine(" WHERE  1=1   ")

            If Data_Selezionata <> AGRODATAINIZIO Then
                'impianti validi in quella data
                StrSQL.AppendLine(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(Data_Selezionata))
