            StrSQL.AppendLine("     CONVERT(VARCHAR, Imprese_Progetti.Validita_Inizio, 103) AS Validita_Inizio_Distinta, CONVERT(VARCHAR, Imprese_Progetti.Validita_Fine, 103) AS Validita_Fine_Distinta, ")
            '--------------------------modifica 10/07/2012--------------------------
            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe.descrizione  ")
            StrSQL.AppendLine("      , '') as Codici_Anagrafe_Des , ")
            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe.codice  ")
