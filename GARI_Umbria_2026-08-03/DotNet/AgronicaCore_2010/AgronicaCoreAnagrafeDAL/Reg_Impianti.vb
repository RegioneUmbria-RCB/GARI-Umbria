    Public Function Codice_Anagrafe_from_PivaSaCodAppezzaIdImp(ByVal Piva As String,
                                                    ByVal Sa_Cod As Integer,
                                                    ByVal Appezza As Integer,
                                                    ByVal Id_Reg As Integer,
                                                    ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                                    ) As String

        Dim objImpianti As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
        Dim DT As DataTable
        Dim rval As String = ""

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim NomeRoutine As String = "Codice_Anagrafe_from_PivaSaCodAppezzaIdImp"
        Try

            StrSQL.Length = 0

            StrSQL.AppendLine(" SELECT Reg_Impianti.PIVA, Reg_Impianti.SA_COD, Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG, Reg_Impianti_Codici.id_cod, Codici_Anagrafe.descrizione  ")
            StrSQL.AppendLine(" FROM Reg_Impianti ")
            StrSQL.AppendLine(" LEFT JOIN Reg_Impianti_Codici ON Reg_Impianti.PIVA = Reg_Impianti_Codici.PIVA And ")
            StrSQL.AppendLine("                                  Reg_Impianti.SA_COD = Reg_Impianti_Codici.sa_cod And ")
            StrSQL.AppendLine("                                  Reg_Impianti.APPEZZA = Reg_Impianti_Codici.appezza And ")
            StrSQL.AppendLine("                                  Reg_Impianti.ID_REG = Reg_Impianti_Codici.Id_Reg And ")
            StrSQL.AppendLine("                                  Reg_Impianti_Codici.id_cod > 3000 And ")
            StrSQL.AppendLine("                                  Reg_Impianti_Codici.id_cod < 4000 And ")
            StrSQL.AppendLine("                                  Reg_Impianti_Codici.Progetto_Cod = 0 ")
            StrSQL.AppendLine(" LEFT JOIN Codici_Anagrafe ON Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice")


            If Piva <> "" Then
                StrSQL.AppendLine(" WHERE Reg_Impianti.PIVA = '" & Agro_SQL_SaveText(Trim(Piva)) & "' ")
            End If

            If Sa_Cod <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & "  ")
            End If

            If Appezza <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(Appezza) & "  ")
            End If

            If Id_Reg <> 0 Then
                StrSQL.AppendLine(" AND Reg_Impianti.ID_Reg =  " & Agro_SQL_SaveNum(Id_Reg) & " ")
            End If

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

            If DT.Rows.Count > 0 Then
                If Not IsDBNull(DT.Rows(0).Item("Descrizione")) Then
                    Return DT.Rows(0).Item("Descrizione")
                End If
            End If

        Catch ex As Exception

            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)

        End Try


        Return rval

    End Function

