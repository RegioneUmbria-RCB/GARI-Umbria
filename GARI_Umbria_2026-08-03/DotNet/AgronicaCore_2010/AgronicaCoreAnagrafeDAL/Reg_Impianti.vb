    Public Function Leggi_Intersezioni(
                                ByVal PivaSuperuser As String,
                                ByVal Piva As String,
                                ByVal Sa_Cod As Int32,
                                ByVal Appezza As Int32,
                                ByVal Id_Reg As Int32,
                                    ByVal xSelezioneVariabile As AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile,
                                    ByVal xFiltroAggiuntivo As String,
                                    ByVal xOrderBy As String,
                                    ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                Optional ByVal LeggiSuAzienda As Boolean = False
                                    ) As DataTable




        Dim NomeRoutine As String = "AnagrafeDAL.Reg_Impianti_Read.Leggi_Intersezioni()"

        '====================================================================================
        'Parametri opzionali :
        '   Id_reg = 0           =>  si leggono tutti gli impianti dell'appezzamento
        '
        '   objConnessione = nothing    =>  viene creata (e distrutta) con StringaConnessione
        '   DirectoryLOG = ""           =>  viene usato il valore di default
        '   FileLOG = ""                =>  viene usato il valore di default
        '====================================================================================

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable

        Try

            If PivaSuperuser = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva_Superuser obbligatorio)")
            End If

            If Piva = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva obbligatorio)")
            End If

            If Sa_Cod = 0 AndAlso Not LeggiSuAzienda Then
                Throw New Exception("Parametro non corretto nella query (Sa_Cod obbligatorio)")
            End If

            If Appezza = 0 AndAlso Not LeggiSuAzienda Then
                Throw New Exception("Parametro non corretto nella query (Appezza obbligatorio)")
            End If



            Select Case xSelezioneVariabile

                Case enumSelezioneVariabile.Selezione_TabellaDatiMinimi

                    '---------------------------------------------
                    StrSQL.Length = 0
                    StrSQL.AppendLine(" SELECT * ")
                    StrSQL.AppendLine(" FROM  Reg_Impianti ")

                    StrSQL.AppendLine(" WHERE   Validita_inizio < " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & " ")
                    StrSQL.AppendLine(" AND     Validita_Fine > " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & " ")

                    StrSQL.AppendLine(" AND     Piva = '" & Agro_SQL_SaveText(Piva) & "' ")
                    StrSQL.AppendLine(" AND     [User] = '" & Agro_SQL_SaveText(PivaSuperuser) & "' ")

                    If Not LeggiSuAzienda Then
                        StrSQL.AppendLine(" AND Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
                        StrSQL.AppendLine(" AND Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
                    End If




                    If objParametri.FinestraTemporaleInizio <> New Date AndAlso objParametri.FinestraTemporaleFine <> New Date Then
                        'Escludo gli impianti che non si intersecano con quello di partenza cioè quelli che sono
                        'precedenti e quelli che sono successivi al periodo selezionato
                        StrSQL.AppendLine(" AND  NOT ( (Validita_Inizio < " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio))
                        StrSQL.AppendLine(" AND  Validita_Fine < " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleInizio) & ") ")
                        StrSQL.AppendLine(" OR  (Validita_Fine > " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine))
                        StrSQL.AppendLine(" AND  Validita_Inizio > " & Agro_SQL_SaveDate(objParametri.FinestraTemporaleFine) & ") ) ")
                    End If


                    If Id_Reg <> 0 Then
                        StrSQL.AppendLine(" AND Id_Reg = " & Agro_SQL_SaveNum(Id_Reg) & " ")
                    End If



                    If xFiltroAggiuntivo <> "" Then
                        StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
                    End If
                    '--------------------------------------------------------------------------
                    Select Case objParametri.FlagVisibilita
                        Case enumVisibilita.Visibilita_SoloNonCancellati
                            StrSQL.AppendLine(" AND   Inviato >=0 ")
                        Case enumVisibilita.Visibilita_SoloCancellati
                            StrSQL.AppendLine(" AND   Inviato =-1 ")
                        Case enumVisibilita.Visibilita_Tutti
                            '...................................
