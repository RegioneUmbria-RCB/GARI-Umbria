Public Class Reg_Impianti_Read
    Inherits AgronicaCoreDataProvider.DataProvider

    ''' <summary>
    ''' 
    ''' </summary>
    ''' <param name="Piva"></param>
    ''' <param name="Sa_Cod"></param>
    ''' <param name="Appezza"></param>
    ''' <param name="id_reg"></param>
    ''' <param name="xFiltroAggiuntivo"></param>
    ''' <param name="xOrderBy"></param>
    ''' <param name="objParametri"></param>
    ''' <param name="leggiAncheBloccati"></param>
    ''' <returns></returns>
    Public Function TipoNodoAlebroAnagrafeDaChiaviImpianto(
            ByVal Piva As String,
            ByVal Sa_Cod As Integer,
            ByVal Appezza As Integer,
            ByVal id_reg As Integer,
            ByVal xFiltroAggiuntivo As String,
            ByVal xOrderBy As String,
            ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
    ) As DataTable


        Const nomeRoutine = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_Impianti_xAgenda()"

        '====================================================================================
        'Parametri opzionali :
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim stb As New StringBuilder
        Dim dt As DataTable

        Try

            stb.Length = 0
            stb.AppendLine(" Select ")
            stb.AppendLine("    Case when g.gru_Cod = 1 then 7 else ")
            stb.AppendLine("        Case when g.gru_cod = 2 then 8 else ")
            stb.AppendLine("            Case when g.gru_cod = 3 then 9 else 19 end ")
            stb.AppendLine("        End")
            stb.AppendLine(" End As TipoNodoAlberoAnagrafe")
            stb.AppendLine(" ")
            stb.AppendLine("From Reg_Impianti r")
            stb.AppendLine("    inner Join Cultivar c")
            stb.AppendLine("        On c.Cul_Cod = r.CUL_COD")
            stb.AppendLine("    inner Join SpecieVegetali veg")
            stb.AppendLine("        On veg.Veg_Cod = c.Veg_Cod")
            stb.AppendLine("    inner Join GruppoVegetale g")
            stb.AppendLine("        On g.Gru_Cod = veg.Gru_Cod")
            stb.AppendLine("               ")
            stb.AppendLine("where Piva = '" & Agro_SQL_SaveText(Piva) & "'")
            stb.AppendLine("And Sa_Cod =  " & Agro_SQL_SaveNum(Sa_Cod))
            stb.AppendLine("And appezza = " & Agro_SQL_SaveNum(Appezza))
            stb.AppendLine("And ID_REG =  " & Agro_SQL_SaveNum(id_reg))

            If xFiltroAggiuntivo <> "" Then
                stb.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    stb.AppendLine(" AND   r.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    stb.AppendLine(" AND   r.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                stb.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            End If


            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, stb.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    '##############################################################################################
    'Questa query mette insieme le due stored procedure utilizzate 
    'per caricare la griglia degli impianti nelle op. di agenda
    'Flag_ConDPI serve per distinguere la query da versione SENZA DPI a quella CON
    'Grfi_Cod e Flag_Protetto servono solo nella versione con i DPI
    Public Function Leggi_Impianti_xAgenda(ByVal Flag_ConDPI As Boolean,
                                           ByVal Piva As String,
                                           ByVal Sa_Cod As Integer,
                                           ByVal Campo_Cod As Integer,
                                           ByVal Veg_Cod As Integer,
                                           ByVal Cul_Cod As Integer,
                                           ByVal Data As Date,
                                           ByVal Grfi_Cod As Integer,
                                           ByVal Flag_Protetto As Boolean,
                                           ByVal Flag_SoloTerreniNudi As Boolean,
                                           ByVal Id_Cod As Integer,
                                           ByVal xFiltroAggiuntivo As String,
                                           ByVal xOrderBy As String,
                                           ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                           ByVal leggiAncheBloccati As Boolean
                                           ) As DataTable 'leggiAncheBloccati mettere di default False per non leggere i bloccati palmare/import


        Const nomeRoutine = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_Impianti_xAgenda()"

        '====================================================================================
        'Parametri opzionali :
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable
        Dim i As Integer

        Try

            If Piva = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva obbligatorio)")
            End If

            'If Sa_Cod = 0 Then
            '    Throw New Exception("Parametro non corretto nella query (Sa_Cod obbligatorio)")
            'End If

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT  Reg_Impianti.PIVA, Reg_Impianti.SA_COD, Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG,  ")
            StrSQL.AppendLine("     CONVERT(VARCHAR, Reg_Impianti.Validita_Inizio, 103) AS Validita_Inizio, CONVERT(VARCHAR, Reg_Impianti.Validita_Fine, 103) AS Validita_Fine, Reg_Impianti.Sup_Imp, ISNULL(Imprese_Progetti.P_Ha, 0) AS P_HA, ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.COP_COD, 0) AS Cop_Cod, ISNULL(Copertura.Cop_Des, '') AS Copertura, ")
            StrSQL.AppendLine("     Reg_Impianti.Data_Inizio_Portinnesto, Reg_Impianti.Data_Inizio_Innesto, Reg_Impianti.Data_Inizio_Produzione, Reg_Impianti.Piante_Maschi_InSesto,   ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.IMP_COD, 0) AS Imp_Cod,  ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.Foral_Cod, 0) AS Foral_Cod,  ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.Port_Cod, 0) AS Port_Cod,  ")
            StrSQL.AppendLine("     ISNULL(Cultivar.Veg_Cod, 0) AS Veg_Cod,  ")
            StrSQL.AppendLine("     Reg_Impianti.CUL_COD,  ISNULL(Cultivar.Cul_Des, '') AS Cul_Des,  ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.GRVA_Cod_VEG,0) AS GRVA_Cod_VEG,   ")
            StrSQL.AppendLine("     Appezzamento.Campo_Cod,  ")
            StrSQL.AppendLine("     Appezzamento.SUP_APP, Appezzamento.APP_NOME,  ")
            StrSQL.AppendLine("     Reg_Impianti.GRFI_COD, ISNULL(GruppoFinalita.Grfi_Des,'') AS Grfi_Des,  ")
            StrSQL.AppendLine("     Imprese_Progetti.Progetto_Cod, Imprese_Progetti.Progetto_Nome AS Progetto,  ")
            StrSQL.AppendLine("     Imprese_Progetti.Regolamento_Cod AS Regolamento, ISNULL(Regolamenti.Reg_Des, '') AS Reg_Des,  ")
            StrSQL.AppendLine("     Imprese_Progetti.Disciplinare_Cod AS Finanziamento, Imprese_Progetti.Disciplinare_PubblicoPrivato, DPI_Regolamenti.NomeEsteso AS Disciplinare, 0 AS id_rcdpi, '' AS info,  ")
            StrSQL.AppendLine("     CONVERT(VARCHAR, Imprese_Progetti.Validita_Inizio, 103) AS Validita_Inizio_Distinta, CONVERT(VARCHAR, Imprese_Progetti.Validita_Fine, 103) AS Validita_Fine_Distinta, ")
            'per codici anagrafe
            '--------------------------modifica 10/07/2012--------------------------
            'StrSQL.AppendLine("     ISNULL ((Select Codici_Anagrafe.descrizione from Codici_Anagrafe inner join ")
            'StrSQL.AppendLine("               Reg_Impianti_Codici on Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            'StrSQL.AppendLine("                 WHERE     (PIVA = Reg_Impianti.PIVA) AND (sa_cod = Reg_Impianti.sa_cod) AND (appezza = Reg_Impianti.appezza) AND (Id_Reg = Reg_Impianti.id_reg)")
            'StrSQL.AppendLine("                             and id_cod >2999 and id_cod < 4000 ) ")
            'StrSQL.AppendLine("      , '') as Codici_Anagrafe_Des , ")
            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe.descrizione  ")
            StrSQL.AppendLine("      , '') as Codici_Anagrafe_Des , ")
            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe.codice  ")
            StrSQL.AppendLine("      , '') as Codice_Anagrafe , ")
            '---------------------------------------------------------------------------

            '-------------------CODICE APPEZZA BIOLOGICO 30/04/2013--------------------------
            StrSQL.AppendLine("     ISNULL (Appezzamento_Codici_CodBioApp.Val_Cod  ")
            StrSQL.AppendLine("      , '') as CodBioApp , ")
            '---------------------------------------------------------------------------
            '-------------------CODICE RIF NUMERICO APPEZz. 30/04/2013--------------------------
            StrSQL.AppendLine("     ISNULL (Appezzamento_Codici_RifNumerico.Val_Cod  ")
            StrSQL.AppendLine("      , '') as RifNumerico , ")
            '---------------------------------------------------------------------------

            '--------------CAPITOLATI Capitolato_Privato------------modifica 08/04/2013--------------------------
            'qui c'è il codice capitolato, devo recuperare descrizioneCAC_Codifica_InfoAggiuntive
            StrSQL.AppendLine("     ISNULL (CAC_Codifica_InfoAggiuntive.InfoAgg_Des  ")
            StrSQL.AppendLine("      , '') as Capitolato_Privato_Des , ")
            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe_Capitolato_Privato.codice  ")
            StrSQL.AppendLine("      , '') as Capitolato_Privato_Codice , ")
            '---------------------------------------------------------------------------



            StrSQL.AppendLine("     ISNULL(CONVERT(VARCHAR, Imprese_Progetti.Data_Inizio_Prevista, 103),'') AS Data_Semina_Prevista, ")
            StrSQL.AppendLine("     ISNULL(CONVERT(VARCHAR, Imprese_Progetti.Data_Fine_Prevista, 103),'') AS Data_Raccolta_Prevista,  ")
            StrSQL.AppendLine("     ISNULL(CONVERT(VARCHAR, Imprese_Progetti.Data_Fioritura_Prevista, 103),'') AS Data_Fioritura_Prevista,  ")

            StrSQL.AppendLine("     FasiFenologichexFioriture.FF_COD,  ")

            StrSQL.AppendLine("     ISNULL ((Select campo_des from Campi      WHERE     (Appezzamento.PIVA = Campi.PIVA) AND (Appezzamento.sa_cod = Campi.sa_cod) ")
            StrSQL.AppendLine("     AND (Appezzamento.Campo_Cod  = Campi.Campo_Cod )) , '') as Campo_Des ,  ")


            'data semina
            StrSQL.AppendLine("     ISNULL ((SELECT TOP 1 CONVERT(VARCHAR, Movimenti.Data_Movimento, 103) ")
            StrSQL.AppendLine("         FROM    Agenda INNER JOIN ")
            StrSQL.AppendLine("                 Movimenti ON Agenda.PIVA = Movimenti.PIVA AND Agenda.Sa_Cod = Movimenti.Sa_Cod AND  ")
            StrSQL.AppendLine("                 Agenda.Id_Agenda = Movimenti.Id_Agenda INNER JOIN ")
            StrSQL.AppendLine("                 Movimenti_dettagli ON Movimenti.PIVA = Movimenti_dettagli.PIVA AND Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND ")
            StrSQL.AppendLine("                 Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda AND Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov INNER JOIN ")
            StrSQL.AppendLine("                 Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND  ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
            StrSQL.AppendLine("         WHERE   (Agenda.Lav_Cod = 2 OR Agenda.Lav_Cod = 71) AND dbo.Movimenti.Cau_Mov = '2300' AND Mov_Destinazioni.Piva = Reg_Impianti.PIVA AND ")
            StrSQL.AppendLine("                 Mov_Destinazioni.sa_cod = Reg_Impianti.sa_cod AND Mov_Destinazioni.appezza = Reg_Impianti.APPEZZA AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.Id_Destinazione = Reg_Impianti.ID_REG ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento >= Imprese_Progetti.Validita_Inizio  ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento <= Imprese_Progetti.Validita_Fine  ")
            StrSQL.AppendLine("         ORDER BY Movimenti.Data_Movimento), '') AS Data_Semina, ")

            'data raccolta
            StrSQL.AppendLine("     ISNULL ((SELECT TOP 1 CONVERT(VARCHAR, Movimenti.Data_Movimento, 103) ")
            StrSQL.AppendLine("         FROM    Agenda INNER JOIN ")
            StrSQL.AppendLine("                 Movimenti ON Agenda.PIVA = Movimenti.PIVA AND Agenda.Sa_Cod = Movimenti.Sa_Cod AND  ")
            StrSQL.AppendLine("                 Agenda.Id_Agenda = Movimenti.Id_Agenda INNER JOIN ")
            StrSQL.AppendLine("                 Movimenti_dettagli ON Movimenti.PIVA = Movimenti_dettagli.PIVA AND Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND ")
            StrSQL.AppendLine("                 Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda AND Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov INNER JOIN ")
            StrSQL.AppendLine("                 Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND  ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
            StrSQL.AppendLine("         WHERE   (Agenda.Lav_Cod = 125) AND dbo.Movimenti.Cau_Mov = '2200' AND Mov_Destinazioni.Piva = Reg_Impianti.PIVA AND ")
            StrSQL.AppendLine("                 Mov_Destinazioni.sa_cod = Reg_Impianti.sa_cod AND Mov_Destinazioni.appezza = Reg_Impianti.APPEZZA AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.Id_Destinazione = Reg_Impianti.ID_REG ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento >= Imprese_Progetti.Validita_Inizio  ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento <= Imprese_Progetti.Validita_Fine  ")
            StrSQL.AppendLine("         ORDER BY Movimenti.Data_Movimento), '') AS Data_Raccolta, ")



            'data fioritura
            StrSQL.AppendLine("     ISNULL  ((SELECT    TOP 1 CONVERT(VARCHAR,Mov_Destinazioni.Validita_Inizio, 103)   ")
            StrSQL.AppendLine("         FROM         Movimenti_dettagli INNER JOIN  ")
            StrSQL.AppendLine("                 Movimenti INNER JOIN  ")
            StrSQL.AppendLine("                 Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND Movimenti.Id_Agenda = Agenda.Id_Agenda ON   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.PIVA = Movimenti.PIVA AND Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod AND   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda AND Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov INNER JOIN  ")
            StrSQL.AppendLine("                 Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda And Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov And  ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det  ")
            StrSQL.AppendLine("                 INNER Join ")
            StrSQL.AppendLine("                   Mov_Dettaglio_Tecnico ON Movimenti_dettagli.PIVA = Mov_Dettaglio_Tecnico.Piva AND Movimenti_dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det AND Movimenti_dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov AND Movimenti_dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda AND Movimenti_dettagli.Sa_Cod = Mov_Dettaglio_Tecnico.Sa_Cod  ")
            StrSQL.AppendLine("         WHERE   (Agenda.Lav_Cod = 79) AND (Movimenti.Cau_Mov = '2100') AND (Mov_Destinazioni.PIVA = Reg_Impianti.PIVA) AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.Sa_Cod = Reg_Impianti.sa_cod AND Mov_Destinazioni.APPEZZA = Reg_Impianti.APPEZZA AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.ID_destinazione = Reg_Impianti.ID_REG AND  ")
            StrSQL.AppendLine("                 Mov_Dettaglio_Tecnico.FF_Classe = FasiFenologichexFioriture.FF_COD ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento >= Imprese_Progetti.Validita_Inizio  ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento <= Imprese_Progetti.Validita_Fine  ")
            StrSQL.AppendLine("         ORDER BY Mov_Destinazioni.validita_inizio), '') AS Data_Fioritura, ")

            '--- LIMITI APPORTI ---
            StrSQL.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            StrSQL.AppendLine("         FROM   Reg_Impianti_Codici ")
            StrSQL.AppendLine("         WHERE  Piva = Imprese_Progetti.PIVA AND sa_cod = Imprese_Progetti.sa_cod ")
            StrSQL.AppendLine("         AND appezza = Imprese_Progetti.appezza AND Id_Reg = Imprese_Progetti.id_reg ")
            StrSQL.AppendLine("         AND Progetto_Cod = Imprese_Progetti.Progetto_Cod  ")
            StrSQL.AppendLine("         AND Reg_Impianti_Codici.id_cod=1050 ")
            StrSQL.AppendLine("         ), '') AS N_Massimo, ")
            StrSQL.AppendLine("         '' AS N_Distribuito, ")
            StrSQL.AppendLine("         '' AS N_Residuo, ")
            StrSQL.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            StrSQL.AppendLine("         FROM   Reg_Impianti_Codici ")
            StrSQL.AppendLine("         WHERE  Piva = Imprese_Progetti.PIVA AND sa_cod = Imprese_Progetti.sa_cod ")
            StrSQL.AppendLine("         AND appezza = Imprese_Progetti.appezza AND Id_Reg = Imprese_Progetti.id_reg ")
            StrSQL.AppendLine("         AND Progetto_Cod = Imprese_Progetti.Progetto_Cod  ")
            StrSQL.AppendLine("         AND Reg_Impianti_Codici.id_cod=1051 ")
            StrSQL.AppendLine("         ), '') AS P_Massimo, ")
            StrSQL.AppendLine("         '' AS P_Distribuito, ")
            StrSQL.AppendLine("         '' AS P_Residuo, ")
            StrSQL.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            StrSQL.AppendLine("         FROM   Reg_Impianti_Codici ")
            StrSQL.AppendLine("         WHERE  Piva = Imprese_Progetti.PIVA AND sa_cod = Imprese_Progetti.sa_cod ")
            StrSQL.AppendLine("         AND appezza = Imprese_Progetti.appezza AND Id_Reg = Imprese_Progetti.id_reg ")
            StrSQL.AppendLine("         AND Progetto_Cod = Imprese_Progetti.Progetto_Cod  ")
            StrSQL.AppendLine("         AND Reg_Impianti_Codici.id_cod=1052 ")
            StrSQL.AppendLine("         ), '') AS K_Massimo, ")
            StrSQL.AppendLine("         '' AS K_Distribuito, ")
            StrSQL.AppendLine("         '' AS K_Residuo, ")
            StrSQL.AppendLine("     ISNULL ((Select Reg_Impianti_Codici.val_cod ")
            StrSQL.AppendLine("         FROM   Reg_Impianti_Codici ")
            StrSQL.AppendLine("         WHERE  Piva = Imprese_Progetti.PIVA AND sa_cod = Imprese_Progetti.sa_cod ")
            StrSQL.AppendLine("         AND appezza = Imprese_Progetti.appezza AND Id_Reg = Imprese_Progetti.id_reg ")
            StrSQL.AppendLine("         AND Progetto_Cod = Imprese_Progetti.Progetto_Cod  ")
            StrSQL.AppendLine("         AND Reg_Impianti_Codici.id_cod=1053 ")
            StrSQL.AppendLine("         ), '') AS Mg_Massimo, ")
            StrSQL.AppendLine("         '' AS Mg_Distribuito, ")
            StrSQL.AppendLine("         '' AS Mg_Residuo, ")

            StrSQL.AppendLine("     ISNULL ((Select agea.Veg_Des_Agea    " & vbCrLf)
            StrSQL.AppendLine("           FROM   Reg_Impianti_Codici veg1  " & vbCrLf)
            StrSQL.AppendLine("             inner join reg_impianti_codici cul1  " & vbCrLf)
            StrSQL.AppendLine("                 on veg1.piva = cul1.piva  " & vbCrLf)
            StrSQL.AppendLine("                 and veg1.sa_cod = cul1.sa_cod  " & vbCrLf)
            StrSQL.AppendLine("                 and veg1.appezza = cul1.appezza  " & vbCrLf)
            StrSQL.AppendLine("                 and veg1.Id_Reg  = cul1.Id_Reg   " & vbCrLf)
            StrSQL.AppendLine("                 and veg1.progetto_cod = cul1.progetto_cod  " & vbCrLf)
            StrSQL.AppendLine("                 and veg1.id_cod = 1133  " & vbCrLf)
            StrSQL.AppendLine("                 and cul1.id_cod = 1134  " & vbCrLf)
            StrSQL.AppendLine("            inner join Codifica_SpecieVegetali_Agea agea     " & vbCrLf)
            StrSQL.AppendLine("                on agea.Veg_Cod_Agea = veg1.val_cod   " & vbCrLf)
            StrSQL.AppendLine("                and agea.Cul_Cod_Agea = cul1.val_cod   " & vbCrLf)
            StrSQL.AppendLine("             WHERE " & vbCrLf)
            StrSQL.AppendLine("             cul1.Piva = Imprese_Progetti.PIVA " & vbCrLf)
            StrSQL.AppendLine("              AND cul1.sa_cod = Imprese_Progetti.sa_cod   " & vbCrLf)
            StrSQL.AppendLine("              AND cul1.appezza = Imprese_Progetti.appezza   " & vbCrLf)
            StrSQL.AppendLine("              AND cul1.Id_Reg = Imprese_Progetti.id_reg   " & vbCrLf)
            StrSQL.AppendLine("              AND cul1.Progetto_Cod = Imprese_Progetti.Progetto_Cod    " & vbCrLf)
            StrSQL.AppendLine("              AND cul1.id_cod=1134   " & vbCrLf)
            StrSQL.AppendLine("           ), '') AS SpecieAgea, " & vbCrLf)

            StrSQL.AppendLine("         ISNULL ((Select agea.Cul_des_agea   " & vbCrLf)
            StrSQL.AppendLine("           FROM   Reg_Impianti_Codici veg1  " & vbCrLf)
            StrSQL.AppendLine("             inner join reg_impianti_codici cul1  " & vbCrLf)
            StrSQL.AppendLine("                 on veg1.piva = cul1.piva  " & vbCrLf)
            StrSQL.AppendLine("                 and veg1.sa_cod = cul1.sa_cod  " & vbCrLf)
            StrSQL.AppendLine("                 and veg1.appezza = cul1.appezza  " & vbCrLf)
            StrSQL.AppendLine("                 and veg1.Id_Reg  = cul1.Id_Reg   " & vbCrLf)
            StrSQL.AppendLine("                 and veg1.progetto_cod = cul1.progetto_cod  " & vbCrLf)
            StrSQL.AppendLine("                 and veg1.id_cod = 1133  " & vbCrLf)
            StrSQL.AppendLine("                 and cul1.id_cod = 1134  " & vbCrLf)
            StrSQL.AppendLine("            inner join Codifica_SpecieVegetali_Agea agea     " & vbCrLf)
            StrSQL.AppendLine("                on agea.Veg_Cod_Agea = veg1.val_cod   " & vbCrLf)
            StrSQL.AppendLine("                and agea.Cul_Cod_Agea = cul1.val_cod   " & vbCrLf)
            StrSQL.AppendLine("             WHERE " & vbCrLf)
            StrSQL.AppendLine("             cul1.Piva = Imprese_Progetti.PIVA " & vbCrLf)
            StrSQL.AppendLine("              AND cul1.sa_cod = Imprese_Progetti.sa_cod   " & vbCrLf)
            StrSQL.AppendLine("              AND cul1.appezza = Imprese_Progetti.appezza   " & vbCrLf)
            StrSQL.AppendLine("              AND cul1.Id_Reg = Imprese_Progetti.id_reg   " & vbCrLf)
            StrSQL.AppendLine("              AND cul1.Progetto_Cod = Imprese_Progetti.Progetto_Cod    " & vbCrLf)
            StrSQL.AppendLine("              AND cul1.id_cod=1134   " & vbCrLf)
            StrSQL.AppendLine("           ), '') AS CultivarAgea, " & vbCrLf)

            StrSQL.AppendLine("     Imprese.rag_soc, Centri_Aziendali.sa_nome ")

            If Flag_ConDPI = False Then
                'VERSIONE SENZA DPI
                StrSQL.AppendLine(" , ISNULL(SpecieVegetali.Veg_Des, '') AS Veg_Des, ")
                StrSQL.AppendLine(" ISNULL(ImpiantiIrrigazioni.Imp_Des, '') AS Imp_Des, ")
                StrSQL.AppendLine(" ISNULL(FormeAllevamento.Foral_Des, '') AS Foral_Des, ")
                StrSQL.AppendLine(" ISNULL(Portinnesti.Port_Des, '') AS Port_Des, ")
                StrSQL.AppendLine(" ISNULL(GruppoVarietale.Grva_Des, '') AS Grva_Des  ")
            End If
            StrSQL.AppendLine("  ")


            StrSQL.AppendLine("  FROM   Reg_Impianti  ")
            StrSQL.AppendLine("     INNER JOIN Imprese ON Reg_Impianti.PIVA = Imprese.PIVA  ")
            StrSQL.AppendLine("     INNER JOIN Centri_Aziendali ON Reg_Impianti.PIVA = Centri_Aziendali.PIVA AND Reg_Impianti.SA_COD = Centri_Aziendali.sa_cod  ")
            StrSQL.AppendLine("     INNER JOIN Appezzamento ON Reg_Impianti.PIVA = Appezzamento.PIVA AND Reg_Impianti.SA_COD = Appezzamento.SA_COD AND ")
            StrSQL.AppendLine("     Reg_Impianti.APPEZZA = Appezzamento.APPEZZA  ")
            StrSQL.AppendLine("     INNER JOIN Imprese_Progetti ON Reg_Impianti.PIVA = Imprese_Progetti.Piva AND Reg_Impianti.SA_COD = Imprese_Progetti.Sa_Cod AND  ")
            StrSQL.AppendLine("     Reg_Impianti.APPEZZA = Imprese_Progetti.Appezza AND Reg_Impianti.ID_REG = Imprese_Progetti.Id_Reg  ")


            StrSQL.AppendLine("     LEFT OUTER JOIN Regolamenti ON Imprese_Progetti.Regolamento_Cod = Regolamenti.Reg_Cod  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN FasiFenologichexFioriture ON Cultivar.Veg_Cod = FasiFenologichexFioriture.VEG_COD ")
            StrSQL.AppendLine("     LEFT OUTER JOIN GruppoFinalita ON Reg_Impianti.GRFI_COD = GruppoFinalita.Grfi_Cod  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN Copertura ON Reg_Impianti.COP_COD = Copertura.Cop_Cod ")
            If Flag_ConDPI = False Then
                'VERSIONE SENZA DPI
                StrSQL.AppendLine("     LEFT OUTER JOIN SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.VEG_COD 	  ")
                StrSQL.AppendLine("     LEFT OUTER JOIN ImpiantiIrrigazioni ON Reg_Impianti.IMP_COD = ImpiantiIrrigazioni.Imp_Cod  ")
                StrSQL.AppendLine("     LEFT OUTER JOIN FormeAllevamento ON Reg_Impianti.Foral_Cod = FormeAllevamento.Foral_Cod ")
                StrSQL.AppendLine("     LEFT OUTER JOIN Portinnesti ON Reg_Impianti.Port_Cod = Portinnesti.Port_Cod ")
                StrSQL.AppendLine("     LEFT OUTER JOIN GruppoVarietale ON Reg_Impianti.GRVA_Cod_VEG = GruppoVarietale.Grva_Cod ")
            End If


            '--------------------------modifica 10/07/2012--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  Reg_Impianti_Codici on Reg_Impianti.PIVA=Reg_Impianti_Codici.PIVA and Reg_Impianti.SA_COD=Reg_Impianti_Codici.SA_COD and Reg_Impianti.APPEZZA=Reg_Impianti_Codici.APPEZZA and Reg_Impianti.id_reg=Reg_Impianti_Codici.id_reg and Reg_Impianti_Codici.id_cod >2999 and Reg_Impianti_Codici.id_cod < 4000 ")
            StrSQL.AppendLine("     LEFT OUTER JOIN  Codici_Anagrafe  ")
            StrSQL.AppendLine("              on Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            '------------------------------------------------------------------------

            '-------------------CODICE APPEZZA BIOLOGICO 30/04/2013--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  Appezzamento_Codici Appezzamento_Codici_CodBioApp ")
            StrSQL.AppendLine("              on Appezzamento_Codici_CodBioApp.piva = Reg_Impianti.piva and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_CodBioApp.sa_cod = Reg_Impianti.sa_cod and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_CodBioApp.appezza = Reg_Impianti.appezza and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_CodBioApp.id_cod =   " & Agro_SQL_SaveNum(enum_CodiciAnagrafe.Codice_Appezza_Biologico) & "  ")
            '---------------------------------------------------------------------------
            '-------------------CODICE RIF NUMERICO APPEZz. 30/04/2013--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  Appezzamento_Codici Appezzamento_Codici_RifNumerico ")
            StrSQL.AppendLine("              on Appezzamento_Codici_RifNumerico.piva = Reg_Impianti.piva and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_RifNumerico.sa_cod = Reg_Impianti.sa_cod and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_RifNumerico.appezza = Reg_Impianti.appezza and ")
            StrSQL.AppendLine("                 Appezzamento_Codici_RifNumerico.id_cod =   " & Agro_SQL_SaveNum(enum_CodiciAnagrafe.Riferimento_Alfanumerico_Appezzamento) & "  ")
            '---------------------------------------------------------------------------



            '--------------CAPITOLATI Capitolato_Privato------------modifica 08/04/2013--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  Reg_Impianti_Codici Reg_Impianti_Codici_Capitolato_Privato on Reg_Impianti.PIVA=Reg_Impianti_Codici_Capitolato_Privato.PIVA and Reg_Impianti.SA_COD=Reg_Impianti_Codici_Capitolato_Privato.SA_COD and Reg_Impianti.APPEZZA=Reg_Impianti_Codici_Capitolato_Privato.APPEZZA and Reg_Impianti.id_reg=Reg_Impianti_Codici_Capitolato_Privato.id_reg and  Imprese_Progetti.progetto_cod=Reg_Impianti_Codici_Capitolato_Privato.progetto_cod ")
            StrSQL.AppendLine("     AND Reg_Impianti_Codici_Capitolato_Privato.id_cod =  " & Agro_SQL_SaveNum(enum_CodiciAnagrafe.Capitolato_Privato) & "  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN  Codici_Anagrafe Codici_Anagrafe_Capitolato_Privato ")
            StrSQL.AppendLine("              on Reg_Impianti_Codici_Capitolato_Privato.id_cod = Codici_Anagrafe_Capitolato_Privato.codice ")
            StrSQL.AppendLine("     LEFT OUTER JOIN  CAC_Codifica_InfoAggiuntive  ")
            StrSQL.AppendLine("              on CAC_Codifica_InfoAggiuntive.InfoAgg_Cod = Reg_Impianti_Codici_Capitolato_Privato.val_cod ")
            StrSQL.AppendLine("            and  CAC_Codifica_InfoAggiuntive.Piva_SuperUser = '" & Agro_SQL_SaveText(objParametri.PivaSuperUser) & "'  ")
            StrSQL.AppendLine("            and  CAC_Codifica_InfoAggiuntive.Argomento_Cod = 1 ")
            '------------------------------------------------------------------------

            '--------------------------modifica 26/07/2012--------------------------
            StrSQL.AppendLine("     LEFT OUTER JOIN  DPI_Regolamenti on Imprese_Progetti.Disciplinare_Cod=DPI_Regolamenti.COD_REGOLAMENTO AND Imprese_Progetti.Disciplinare_PubblicoPrivato=DPI_Regolamenti.Flag_Privato_Pubblico ")
            '------------------------------------------------------------------------



            StrSQL.AppendLine("  ")


            StrSQL.AppendLine("  WHERE  Reg_Impianti.Piva       = '" & Agro_SQL_SaveText(Piva) & "' ")



            '--------------------------modifica 10/07/2012--------------------------
            If Id_Cod <> 0 Then
                StrSQL.AppendLine("     AND Codici_Anagrafe.codice =  " & Agro_SQL_SaveNum(Id_Cod) & "  ")
            End If
            '------------------------------------------------------------------------

            '--------------CAPITOLATI Capitolato_Privato------------modifica 08/04/2013--------------------------

            '------------------------------------------------------------------------


            If Sa_Cod <> 0 Then
                StrSQL.AppendLine("         AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            Else
                'leggo se ci sono filtri sui centri
                Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                Dim FiltroCentri As String = ""
                Dim DtCentriVisibili As DataTable
                DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                    For i = 0 To DtCentriVisibili.Rows.Count - 1
                        FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                    Next
                    If FiltroCentri <> "" Then
                        StrSQL.AppendLine(" AND Reg_Impianti.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                    End If
                End If
            End If

            If Campo_Cod <> 0 Then
                StrSQL.AppendLine("         AND Appezzamento.campo_Cod = " & Agro_SQL_SaveNum(Campo_Cod) & " ")
            End If

            StrSQL.AppendLine("         AND Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine("         AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine("         AND Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
            StrSQL.AppendLine("         AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")

            If leggiAncheBloccati = False Then
                StrSQL.AppendLine("         AND Appezzamento.Blk_Flag <> - 1  ")
            End If



            If Flag_ConDPI = True Then
                'VERSIONE CON DPI
                If Grfi_Cod <> 0 Then
                    StrSQL.AppendLine("     AND Reg_Impianti.grfi_Cod = " & Agro_SQL_SaveNum(Grfi_Cod) & " ")
                End If
                Select Case Flag_Protetto
                    Case 1
                        StrSQL.AppendLine(" AND Reg_Impianti.Cop_Cod <> 0 AND Reg_Impianti.Cop_Cod <> 3 AND Reg_Impianti.Cop_Cod <> 4 AND Reg_Impianti.Cop_Cod <> 5 AND Reg_Impianti.Cop_Cod <> 6 ")
                    Case 0
                        StrSQL.AppendLine(" AND ( Reg_Impianti.Cop_Cod = 0 OR Reg_Impianti.Cop_Cod = 3 OR Reg_Impianti.Cop_Cod = 4 OR Reg_Impianti.Cop_Cod = 5 OR Reg_Impianti.Cop_Cod = 6 ) ")
                End Select
            End If

            If Veg_Cod <> 0 Then
                StrSQL.AppendLine("     AND Cultivar.Veg_Cod    = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
                If Cul_Cod <> 0 Then
                    StrSQL.AppendLine("     AND Cultivar.Cul_Cod    = " & Agro_SQL_SaveNum(Cul_Cod) & " ")
                End If
            Else
                'TERRENO NUDO
                If Flag_SoloTerreniNudi = True Then
                    StrSQL.AppendLine("     AND Reg_Impianti.CUL_COD = 0  ")
                End If
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            Else
                StrSQL.AppendLine(" ORDER BY Sa_Nome, App_Nome, Progetto ")
            End If


            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    '##############################################################################################
    'A differenza della precedente VEG_COD e DATA sono di tipo STRINGA
    'In tal modo è possibile non dover obbligatoriamente filtrare gli impianti per specie e data!!!
    Public Function Leggi_Impianti_xAgenda2(ByVal Flag_ConDPI As Boolean,
                                            ByVal Piva As String,
                                            ByVal Sa_Cod As Integer,
                                            ByVal Veg_Cod As String,
                                            ByVal Cul_Cod As Integer,
                                            ByVal Data As String,
                                            ByVal Grfi_Cod As Integer,
                                            ByVal Flag_Protetto As Integer,
                                            ByVal xFiltroAggiuntivo As String,
                                            ByVal xOrderBy As String,
                                            ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                            ByVal leggiAncheBloccati As Boolean
                                            ) As DataTable 'leggiAncheBloccati mettere di default False per non leggere i bloccati palmare/import

        Const nomeRoutine = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_Impianti_xAgenda2()"

        '====================================================================================
        'Parametri opzionali :
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable
        Dim i As Integer

        Try

            If Piva = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva obbligatorio)")
            End If

            'If Sa_Cod = 0 Then
            '    Throw New Exception("Parametro non corretto nella query (Sa_Cod obbligatorio)")
            'End If

            StrSQL.Length = 0
            StrSQL.AppendLine(" SELECT  Reg_Impianti.PIVA, Reg_Impianti.SA_COD, Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG,  ")
            StrSQL.AppendLine("     CONVERT(VARCHAR, Reg_Impianti.Validita_Inizio, 103) AS Validita_Inizio, CONVERT(VARCHAR, Reg_Impianti.Validita_Fine, 103) AS Validita_Fine, Reg_Impianti.Sup_Imp, ISNULL(Imprese_Progetti.P_Ha,0) AS P_HA, ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.COP_COD, 0) AS Cop_Cod, ISNULL(Copertura.Cop_Des, '') AS Copertura, ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.IMP_COD, 0) AS Imp_Cod,  ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.Foral_Cod, 0) AS Foral_Cod,  ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.Port_Cod, 0) AS Port_Cod,  ")
            StrSQL.AppendLine("     ISNULL(Cultivar.Veg_Cod, 0) AS Veg_Cod,  ")
            StrSQL.AppendLine("     Reg_Impianti.CUL_COD,  ISNULL(Cultivar.Cul_Des, '') AS Cul_Des,  ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.GRVA_Cod_VEG,0) AS GRVA_Cod_VEG,   ")
            StrSQL.AppendLine("     Appezzamento.Campo_Cod,  ")
            StrSQL.AppendLine("     Appezzamento.SUP_APP, Appezzamento.APP_NOME,  ")
            StrSQL.AppendLine("     Reg_Impianti.GRFI_COD, ISNULL(GruppoFinalita.Grfi_Des,'') AS Grfi_Des,  ")
            StrSQL.AppendLine("     Imprese_Progetti.Progetto_Cod, Imprese_Progetti.Progetto_Nome AS Progetto,  ")
            StrSQL.AppendLine("     Imprese_Progetti.Regolamento_Cod AS Regolamento, ISNULL(Regolamenti.Reg_Des, '') AS Reg_Des,  ")
            StrSQL.AppendLine("     Imprese_Progetti.Disciplinare_Cod AS Finanziamento, Imprese_Progetti.Disciplinare_PubblicoPrivato, '' AS Disciplinare, 0 AS id_rcdpi, '' AS info,  ")
            StrSQL.AppendLine("     CONVERT(VARCHAR, Imprese_Progetti.Validita_Inizio, 103) AS Validita_Inizio_Distinta, CONVERT(VARCHAR, Imprese_Progetti.Validita_Fine, 103) AS Validita_Fine_Distinta, ")
            'per codici anagrafe
            StrSQL.AppendLine("     ISNULL ((Select Codici_Anagrafe.descrizione from Codici_Anagrafe inner join ")
            StrSQL.AppendLine("               Reg_Impianti_Codici on Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            StrSQL.AppendLine("                 WHERE     (PIVA = Reg_Impianti.PIVA) AND (sa_cod = Reg_Impianti.sa_cod) AND (appezza = Reg_Impianti.appezza) AND (Id_Reg = Reg_Impianti.id_reg)")
            StrSQL.AppendLine("                             and id_cod >2999 and id_cod < 4000 ) ")
            StrSQL.AppendLine("      , '') as Codici_Anagrafe_Des , ")

            StrSQL.AppendLine("     ISNULL(CONVERT(VARCHAR, Imprese_Progetti.Data_Inizio_Prevista, 103),'') AS Data_Semina_Prevista, ")
            StrSQL.AppendLine("     ISNULL(CONVERT(VARCHAR, Imprese_Progetti.Data_Fine_Prevista, 103),'') AS Data_Raccolta_Prevista,  ")
            StrSQL.AppendLine("     ISNULL(CONVERT(VARCHAR, Imprese_Progetti.Data_Fioritura_Prevista, 103),'') AS Data_Fioritura_Prevista,  ")

            StrSQL.AppendLine("     FasiFenologichexFioriture.FF_COD,  ")

            StrSQL.AppendLine("     ISNULL ((Select campo_des from Campi      WHERE     (Appezzamento.PIVA = Campi.PIVA) AND (Appezzamento.sa_cod = Campi.sa_cod) ")
            StrSQL.AppendLine("     AND (Appezzamento.Campo_Cod  = Campi.Campo_Cod )) , '') as Campo_Des ,  ")


            'data semina
            StrSQL.AppendLine("     ISNULL ((SELECT TOP 1 CONVERT(VARCHAR, Movimenti.Data_Movimento, 103) ")
            StrSQL.AppendLine("         FROM    Agenda INNER JOIN ")
            StrSQL.AppendLine("                 Movimenti ON Agenda.PIVA = Movimenti.PIVA AND Agenda.Sa_Cod = Movimenti.Sa_Cod AND  ")
            StrSQL.AppendLine("                 Agenda.Id_Agenda = Movimenti.Id_Agenda INNER JOIN ")
            StrSQL.AppendLine("                 Movimenti_dettagli ON Movimenti.PIVA = Movimenti_dettagli.PIVA AND Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND ")
            StrSQL.AppendLine("                 Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda AND Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov INNER JOIN ")
            StrSQL.AppendLine("                 Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND  ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
            StrSQL.AppendLine("         WHERE   (Agenda.Lav_Cod = 2 OR Agenda.Lav_Cod = 71) AND dbo.Movimenti.Cau_Mov = '2300' AND Mov_Destinazioni.Piva = Reg_Impianti.PIVA AND ")
            StrSQL.AppendLine("                 Mov_Destinazioni.sa_cod = Reg_Impianti.sa_cod AND Mov_Destinazioni.appezza = Reg_Impianti.APPEZZA AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.Id_Destinazione = Reg_Impianti.ID_REG ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento >= Imprese_Progetti.Validita_Inizio  ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento <= Imprese_Progetti.Validita_Fine  ")
            StrSQL.AppendLine("         ORDER BY Movimenti.Data_Movimento), '') AS Data_Semina, ")

            'data raccolta
            StrSQL.AppendLine("     ISNULL ((SELECT TOP 1 CONVERT(VARCHAR, Movimenti.Data_Movimento, 103) ")
            StrSQL.AppendLine("         FROM    Agenda INNER JOIN ")
            StrSQL.AppendLine("                 Movimenti ON Agenda.PIVA = Movimenti.PIVA AND Agenda.Sa_Cod = Movimenti.Sa_Cod AND  ")
            StrSQL.AppendLine("                 Agenda.Id_Agenda = Movimenti.Id_Agenda INNER JOIN ")
            StrSQL.AppendLine("                 Movimenti_dettagli ON Movimenti.PIVA = Movimenti_dettagli.PIVA AND Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND ")
            StrSQL.AppendLine("                 Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda AND Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov INNER JOIN ")
            StrSQL.AppendLine("                 Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND  ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
            StrSQL.AppendLine("         WHERE   (Agenda.Lav_Cod = 125) AND dbo.Movimenti.Cau_Mov = '2200' AND Mov_Destinazioni.Piva = Reg_Impianti.PIVA AND ")
            StrSQL.AppendLine("                 Mov_Destinazioni.sa_cod = Reg_Impianti.sa_cod AND Mov_Destinazioni.appezza = Reg_Impianti.APPEZZA AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.Id_Destinazione = Reg_Impianti.ID_REG ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento >= Imprese_Progetti.Validita_Inizio  ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento <= Imprese_Progetti.Validita_Fine  ")
            StrSQL.AppendLine("         ORDER BY Movimenti.Data_Movimento), '') AS Data_Raccolta, ")



            'data fioritura
            StrSQL.AppendLine("     ISNULL  ((SELECT    TOP 1 CONVERT(VARCHAR,Mov_Destinazioni.Validita_Inizio, 103)   ")
            StrSQL.AppendLine("         FROM         Movimenti_dettagli INNER JOIN  ")
            StrSQL.AppendLine("                 Movimenti INNER JOIN  ")
            StrSQL.AppendLine("                 Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND Movimenti.Id_Agenda = Agenda.Id_Agenda ON   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.PIVA = Movimenti.PIVA AND Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod AND   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda AND Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov INNER JOIN  ")
            StrSQL.AppendLine("                 Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND   ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda And Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov And  ")
            StrSQL.AppendLine("                 Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det  ")
            StrSQL.AppendLine("                 INNER Join ")
            StrSQL.AppendLine("                   Mov_Dettaglio_Tecnico ON Movimenti_dettagli.PIVA = Mov_Dettaglio_Tecnico.Piva AND Movimenti_dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det AND Movimenti_dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov AND Movimenti_dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda AND Movimenti_dettagli.Sa_Cod = Mov_Dettaglio_Tecnico.Sa_Cod  ")
            StrSQL.AppendLine("         WHERE   (Agenda.Lav_Cod = 79) AND (Movimenti.Cau_Mov = '2100') AND (Mov_Destinazioni.PIVA = Reg_Impianti.PIVA) AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.Sa_Cod = Reg_Impianti.sa_cod AND Mov_Destinazioni.APPEZZA = Reg_Impianti.APPEZZA AND  ")
            StrSQL.AppendLine("                 Mov_Destinazioni.ID_destinazione = Reg_Impianti.ID_REG AND  ")
            StrSQL.AppendLine("                 Mov_Dettaglio_Tecnico.FF_Classe = FasiFenologichexFioriture.FF_COD ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento >= Imprese_Progetti.Validita_Inizio  ")
            StrSQL.AppendLine("                  AND Movimenti.Data_Movimento <= Imprese_Progetti.Validita_Fine  ")
            StrSQL.AppendLine("         ORDER BY Mov_Destinazioni.validita_inizio), '') AS Data_Fioritura, ")


            StrSQL.AppendLine("     Imprese.rag_soc, Centri_Aziendali.sa_nome ")
            If Flag_ConDPI = False Then
                'VERSIONE SENZA DPI
                StrSQL.AppendLine(" , ISNULL(SpecieVegetali.Veg_Des, '') AS Veg_Des, ")
                StrSQL.AppendLine(" ISNULL(ImpiantiIrrigazioni.Imp_Des, '') AS Imp_Des, ")
                StrSQL.AppendLine(" ISNULL(FormeAllevamento.Foral_Des, '') AS Foral_Des, ")
                StrSQL.AppendLine(" ISNULL(Portinnesti.Port_Des, '') AS Port_Des, ")
                StrSQL.AppendLine(" ISNULL(GruppoVarietale.Grva_Des, '') AS Grva_Des  ")
            End If
            StrSQL.AppendLine("  ")


            StrSQL.AppendLine("  FROM   Reg_Impianti  ")
            StrSQL.AppendLine("     INNER JOIN Imprese ON Reg_Impianti.PIVA = Imprese.PIVA  ")
            StrSQL.AppendLine("     INNER JOIN Centri_Aziendali ON Reg_Impianti.PIVA = Centri_Aziendali.PIVA AND Reg_Impianti.SA_COD = Centri_Aziendali.sa_cod  ")
            StrSQL.AppendLine("     INNER JOIN Appezzamento ON Reg_Impianti.PIVA = Appezzamento.PIVA AND Reg_Impianti.SA_COD = Appezzamento.SA_COD AND ")
            StrSQL.AppendLine("     Reg_Impianti.APPEZZA = Appezzamento.APPEZZA  ")
            StrSQL.AppendLine("     INNER JOIN Imprese_Progetti ON Reg_Impianti.PIVA = Imprese_Progetti.Piva AND Reg_Impianti.SA_COD = Imprese_Progetti.Sa_Cod AND  ")
            StrSQL.AppendLine("     Reg_Impianti.APPEZZA = Imprese_Progetti.Appezza AND Reg_Impianti.ID_REG = Imprese_Progetti.Id_Reg  ")


            StrSQL.AppendLine("     LEFT OUTER JOIN Regolamenti ON Imprese_Progetti.Regolamento_Cod = Regolamenti.Reg_Cod  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN FasiFenologichexFioriture ON Cultivar.Veg_Cod = FasiFenologichexFioriture.VEG_COD ")
            StrSQL.AppendLine("     LEFT OUTER JOIN GruppoFinalita ON Reg_Impianti.GRFI_COD = GruppoFinalita.Grfi_Cod  ")
            StrSQL.AppendLine("     LEFT OUTER JOIN Copertura ON Reg_Impianti.COP_COD = Copertura.Cop_Cod ")
            If Flag_ConDPI = False Then
                'VERSIONE SENZA DPI
                StrSQL.AppendLine("     LEFT OUTER JOIN SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.VEG_COD 	  ")
                StrSQL.AppendLine("     LEFT OUTER JOIN ImpiantiIrrigazioni ON Reg_Impianti.IMP_COD = ImpiantiIrrigazioni.Imp_Cod  ")
                StrSQL.AppendLine("     LEFT OUTER JOIN FormeAllevamento ON Reg_Impianti.Foral_Cod = FormeAllevamento.Foral_Cod ")
                StrSQL.AppendLine("     LEFT OUTER JOIN Portinnesti ON Reg_Impianti.Port_Cod = Portinnesti.Port_Cod ")
                StrSQL.AppendLine("     LEFT OUTER JOIN GruppoVarietale ON Reg_Impianti.GRVA_Cod_VEG = GruppoVarietale.Grva_Cod ")
            End If
            StrSQL.AppendLine("  ")


            StrSQL.AppendLine("  WHERE  Reg_Impianti.Piva       = '" & Agro_SQL_SaveText(Piva) & "' ")
            If Sa_Cod <> 0 Then
                StrSQL.AppendLine("         AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            Else
                'leggo se ci sono filtri sui centri
                Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
                Dim FiltroCentri As String = ""
                Dim DtCentriVisibili As DataTable
                DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, " Piva='" & Agro_SQL_SaveText(Piva) & "'", "", objParametri)
                If DtCentriVisibili IsNot Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                    For i = 0 To DtCentriVisibili.Rows.Count - 1
                        FiltroCentri &= DtCentriVisibili.Rows(i).Item("sa_cod") & ","
                    Next
                    If FiltroCentri <> "" Then
                        StrSQL.AppendLine(" AND Reg_Impianti.sa_cod IN (" & Agro_SQL_Save_Clausola_IN(Left(FiltroCentri, FiltroCentri.Length - 1), False) & ") ")
                    End If
                End If
            End If

            If Data <> "" Then
                StrSQL.AppendLine("         AND Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
                StrSQL.AppendLine("         AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")
                StrSQL.AppendLine("         AND Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
                StrSQL.AppendLine("         AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")
                If leggiAncheBloccati = False Then
                    StrSQL.AppendLine("         AND Appezzamento.Blk_Flag <> - 1  ")
                End If

            End If

            If Flag_ConDPI = True Then
                'VERSIONE CON DPI
                If Grfi_Cod <> 0 Then
                    StrSQL.AppendLine("     AND Reg_Impianti.grfi_Cod = " & Agro_SQL_SaveNum(Grfi_Cod) & " ")
                End If
                Select Case Flag_Protetto
                    Case 1
                        StrSQL.AppendLine(" AND Reg_Impianti.Cop_Cod <> 0 AND Reg_Impianti.Cop_Cod <> 3 AND Reg_Impianti.Cop_Cod <> 4 AND Reg_Impianti.Cop_Cod <> 5 AND Reg_Impianti.Cop_Cod <> 6 ")
                    Case 0
                        StrSQL.AppendLine(" AND ( Reg_Impianti.Cop_Cod = 0 OR Reg_Impianti.Cop_Cod = 3 OR Reg_Impianti.Cop_Cod = 4 OR Reg_Impianti.Cop_Cod = 5 OR Reg_Impianti.Cop_Cod = 6 ) ")
                End Select
            End If

            If Veg_Cod <> "" Then
                If Veg_Cod <> "0" Then
                    StrSQL.AppendLine("     AND Cultivar.Veg_Cod    = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
                    If Cul_Cod <> 0 Then
                        StrSQL.AppendLine("     AND Cultivar.Cul_Cod    = " & Agro_SQL_SaveNum(Cul_Cod) & " ")
                    End If
                Else
                    'TERRENO NUDO
                    StrSQL.AppendLine("     AND Reg_Impianti.CUL_COD = 0  ")
                End If
            End If

            If xFiltroAggiuntivo <> "" Then
                StrSQL.AppendLine(" AND " & Agro_SQL_Save_xFiltroAggiuntivo(xFiltroAggiuntivo, , objParametri))
            End If
            '--------------------------------------------------------------------------
            Select Case objParametri.FlagVisibilita
                Case enumVisibilita.Visibilita_SoloNonCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato >=0 ")
                Case enumVisibilita.Visibilita_SoloCancellati
                    StrSQL.AppendLine(" AND   Reg_Impianti.Inviato =-1 ")
                Case enumVisibilita.Visibilita_Tutti
                    '...................................
                Case Else
                    Throw New Exception("Parametro non corretto nella query (FlagVisibilita)")
            End Select
            '--------------------------------------------------------------------------
            If xOrderBy <> "" Then
                StrSQL.AppendLine(" ORDER BY " & Agro_SQL_Save_xOrderBy(xOrderBy, objParametri))
            Else
                StrSQL.AppendLine(" ORDER BY App_Nome, Progetto ")
            End If


            '--------------------------------------------------------------------------
            dt = EseguiQuery_Lettura(objParametri, StrSQL.ToString, nomeRoutine)
            '--------------------------------------------------------------------------

        Catch ex As Exception
            messaggioErrore = ex.Message
            Scrivi_LOG(objParametri, nomeRoutine, messaggioErrore)
            dt = Nothing
            Throw New Exception("[" & nomeRoutine & "] : " & messaggioErrore)
        End Try

        Return dt

    End Function

    '##############################################################################################
    'A differenza della precedente CUL_COD è tipo STRINGA
    Public Function Leggi_Impianti_xAgenda3(ByVal Flag_ConDPI As Boolean,
                                            ByVal Piva As String,
                                            ByVal Sa_Cod As Integer,
                                            ByVal Campo_Cod As Integer,
                                            ByVal Veg_Cod As Integer,
                                            ByVal Cul_Cod As String,
                                            ByVal Data As Date,
                                            ByVal Grfi_Cod As Integer,
                                            ByVal Flag_Protetto As Integer,
                                            ByVal Flag_SoloTerreniNudi As Boolean,
                                            ByVal Id_Cod As Integer,
                                            ByVal xFiltroAggiuntivo As String,
                                            ByVal xOrderBy As String,
                                            ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                            ByVal leggiAncheBloccati As Boolean,
                                            Optional ByVal visualizza_Kpin_BlockName As Boolean = False,
                                            Optional ByVal visualizza_codici_imp_app_prj As Boolean = False,
                                            Optional ByVal strFFCodFioritura As String = " (-1) ",
                                            Optional ByVal leggiStaticMap As Boolean = False,
                                            Optional ByVal Controlla_Dichiarazione_Non_Utilizzo As Boolean = False
                                            ) As DataTable 'leggiAncheBloccati mettere di default False per non leggere i bloccati palmare/import

        Const nomeRoutine = "AgronicaCoreAnagrafeDAL.Reg_Impianti_Read.Leggi_Impianti_xAgenda3()"

        '====================================================================================
        'Parametri opzionali :
        '====================================================================================

        Dim messaggioErrore As String = ""
        Dim StrSQL As New StringBuilder
        Dim dt As DataTable
        Dim i As Integer

        Try

            If Piva = "" Then
                Throw New Exception("Parametro non corretto nella query (Piva obbligatorio)")
            End If

            'If Sa_Cod = 0 Then
            '    Throw New Exception("Parametro non corretto nella query (Sa_Cod obbligatorio)")
            'End If

            StrSQL.Length = 0

            StrSQL.AppendLine(" SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;")


            If Controlla_Dichiarazione_Non_Utilizzo Then
                StrSQL.AppendLine("If Not OBJECT_ID('tempdb.dbo.#Dichiarazione_Non_Utilizzo_Con_Impianti_cte') IS NULL ")
                StrSQL.AppendLine(" BEGIN")
                StrSQL.AppendLine(" drop Table #Dichiarazione_Non_Utilizzo_Con_Impianti_cte ")
                StrSQL.AppendLine("End;")
                StrSQL.AppendLine(" ")
                StrSQL.AppendLine("If Not OBJECT_ID('tempdb.dbo.#Dichiarazione_Non_Utilizzo_cte') IS NULL ")
                StrSQL.AppendLine(" BEGIN")
                StrSQL.AppendLine(" drop Table #Dichiarazione_Non_Utilizzo_cte ")
                StrSQL.AppendLine("End;")
                StrSQL.AppendLine(" ")

                StrSQL.AppendLine("With Dichiarazione_Non_Utilizzo_Con_Impianti_cte As ")
                StrSQL.AppendLine(" (")
                StrSQL.AppendLine("	 SELECT Agenda.Id_Agenda FROM Agenda ")
                StrSQL.AppendLine("    inner join Movimenti on Agenda.id_Agenda = Movimenti.id_agenda")
                StrSQL.AppendLine("    inner join Movimenti_dettagli on Movimenti_dettagli.id_agenda = Movimenti.id_agenda AND")
                StrSQL.AppendLine("    Movimenti_dettagli.id_mov = Movimenti.id_mov")
                StrSQL.AppendLine("    inner join Mov_Destinazioni on Movimenti_dettagli.id_agenda = Mov_Destinazioni.Id_Agenda AND")
                StrSQL.AppendLine("    Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov and Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det")
                StrSQL.AppendLine("    inner join Reg_Impianti on Reg_Impianti.PIVA = Mov_Destinazioni.Piva and Reg_Impianti.SA_COD = Mov_Destinazioni.Sa_Cod and")
                StrSQL.AppendLine("    Reg_Impianti.APPEZZA = Mov_Destinazioni.APPEZZA and Reg_Impianti.Id_Reg = Mov_Destinazioni.Id_Destinazione")
                StrSQL.AppendLine("	where Mov_Destinazioni.Tipo_Destinazione = 0 And Agenda.lav_Cod IN (165,166) AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "'")
                StrSQL.AppendLine(" )")

                StrSQL.AppendLine(" SELECT * INTO #Dichiarazione_Non_Utilizzo_Con_Impianti_cte FROM Dichiarazione_Non_Utilizzo_Con_Impianti_cte;")

                StrSQL.AppendLine("With Dichiarazione_Non_Utilizzo_cte As")
                StrSQL.AppendLine(" ( ")
                StrSQL.AppendLine("	select Agenda.Lav_Cod, Imprese_Progetti.PIVA, Imprese_Progetti.Sa_Cod, Imprese_Progetti.Appezza, Imprese_Progetti.Id_Reg, Imprese_Progetti.Progetto_Cod ")
                StrSQL.AppendLine("	from Agenda")
                StrSQL.AppendLine("	inner join Movimenti on Agenda.id_Agenda = Movimenti.id_agenda")
                StrSQL.AppendLine("	inner join Movimenti_dettagli on Movimenti_dettagli.id_agenda = Movimenti.id_agenda AND")
                StrSQL.AppendLine("	Movimenti_dettagli.id_mov = Movimenti.id_mov")
                StrSQL.AppendLine("	inner join Mov_Destinazioni on Movimenti_dettagli.id_agenda = Mov_Destinazioni.Id_Agenda AND")
                StrSQL.AppendLine("	Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov and Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det")
                StrSQL.AppendLine("	inner join Reg_Impianti on Reg_Impianti.PIVA = Mov_Destinazioni.Piva and Reg_Impianti.SA_COD = Mov_Destinazioni.Sa_Cod and")
                StrSQL.AppendLine("	Reg_Impianti.APPEZZA = Mov_Destinazioni.APPEZZA and Reg_Impianti.Id_Reg = Mov_Destinazioni.Id_Destinazione")
                StrSQL.AppendLine("   left outer join Cultivar on Cultivar.Cul_Cod = Reg_Impianti.Cul_Cod")
                StrSQL.AppendLine("   left outer join  Reg_Impianti_Codici on Reg_Impianti.PIVA=Reg_Impianti_Codici.PIVA And Reg_Impianti.SA_COD=Reg_Impianti_Codici.SA_COD And Reg_Impianti.APPEZZA=Reg_Impianti_Codici.APPEZZA And Reg_Impianti.id_reg=Reg_Impianti_Codici.id_reg And Reg_Impianti_Codici.id_cod >2999 And Reg_Impianti_Codici.id_cod < 4000")
                StrSQL.AppendLine("   left outer join Codici_Anagrafe on Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice")
                StrSQL.AppendLine("	inner join Imprese_Progetti on Imprese_Progetti.PIVA = Mov_Destinazioni.Piva and Imprese_Progetti.SA_COD = Mov_Destinazioni.Sa_Cod and")
                StrSQL.AppendLine("	Imprese_Progetti.APPEZZA = Mov_Destinazioni.APPEZZA and Imprese_Progetti.Id_Reg = Mov_Destinazioni.Id_Destinazione")
                StrSQL.AppendLine("	where Mov_Destinazioni.Tipo_Destinazione = 0 And Agenda.lav_Cod IN (165,166) AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "'")
                StrSQL.AppendLine("	AND Reg_Impianti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
                StrSQL.AppendLine("	AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")
                StrSQL.AppendLine("	AND Imprese_Progetti.Validita_inizio <= " & Agro_SQL_SaveDate(Data) & " ")
                StrSQL.AppendLine("	AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(Data) & " ")

                If Veg_Cod <> 0 Then
                    StrSQL.AppendLine("    AND Cultivar.Veg_Cod = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
                End If

                If Id_Cod <> 0 Then
                    StrSQL.AppendLine("   AND Codici_Anagrafe.codice =  " & Agro_SQL_SaveNum(Id_Cod) & "  ")
                End If

                StrSQL.AppendLine("	UNION")
                StrSQL.AppendLine("	select Agenda.Lav_Cod, Imprese_Progetti.PIVA, Imprese_Progetti.Sa_Cod, Imprese_Progetti.Appezza, Imprese_Progetti.Id_Reg, Imprese_Progetti.Progetto_Cod ")
                StrSQL.AppendLine("	from Agenda")
                StrSQL.AppendLine("   inner join Centri_Aziendali on Centri_Aziendali.PIVA = Agenda.PIVA and Centri_Aziendali.Sa_Cod = Agenda.Sa_Cod")
                StrSQL.AppendLine("   inner join Appezzamento on Appezzamento.Piva = Agenda.Piva AND Appezzamento.Sa_Cod = Agenda.Sa_Cod")
                StrSQL.AppendLine("   inner join Reg_Impianti on Appezzamento.Piva = Reg_Impianti.Piva AND Appezzamento.Sa_Cod = Reg_Impianti.Sa_Cod AND Appezzamento.APPEZZA = Reg_Impianti.APPEZZA")
                StrSQL.AppendLine("   inner join Imprese_Progetti on Reg_Impianti.Piva = Imprese_Progetti.Piva AND Reg_Impianti.SA_COD = Imprese_Progetti.SA_COD AND Reg_Impianti.APPEZZA = Imprese_Progetti.APPEZZA AND Imprese_Progetti.Id_Reg = Reg_Impianti.Id_Reg")
                StrSQL.AppendLine("     	where Agenda.lav_Cod In (165, 166) And Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' AND Agenda.Sa_Cod <> 0 AND")
                StrSQL.AppendLine("   Reg_Impianti.Validita_inizio <= Agenda.Validita_Inizio")
                StrSQL.AppendLine("   AND Reg_Impianti.Validita_Fine >= Agenda.Validita_Inizio")
                StrSQL.AppendLine("   AND Imprese_Progetti.Validita_inizio <= Agenda.Validita_Inizio")
                StrSQL.AppendLine("   AND Imprese_Progetti.Validita_Fine >= Agenda.Validita_Inizio AND")
                StrSQL.AppendLine("	Agenda.Id_Agenda NOT IN ( ")
                StrSQL.AppendLine("	 SELECT s.Id_Agenda FROM #Dichiarazione_Non_Utilizzo_Con_Impianti_cte s")
                StrSQL.AppendLine(" )")
                StrSQL.AppendLine(" )")

                StrSQL.AppendLine(" SELECT * INTO #Dichiarazione_Non_Utilizzo_cte FROM Dichiarazione_Non_Utilizzo_cte")
            End If

            StrSQL.AppendLine(" SELECT  Reg_Impianti.PIVA, Reg_Impianti.SA_COD, Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG,  ")
            StrSQL.AppendLine("     CONVERT(VARCHAR, Reg_Impianti.Validita_Inizio, 103) AS Validita_Inizio, CONVERT(VARCHAR, Reg_Impianti.Validita_Fine, 103) AS Validita_Fine, Reg_Impianti.Sup_Imp,  ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.COP_COD, 0) AS Cop_Cod, ISNULL(Copertura.Cop_Des, '') AS Copertura, ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.IMP_COD, 0) AS Imp_Cod,  ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.Foral_Cod, 0) AS Foral_Cod,  ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.Port_Cod, 0) AS Port_Cod,  ")
            StrSQL.AppendLine("     ISNULL(Cultivar.Veg_Cod, 0) AS Veg_Cod,  ")
            StrSQL.AppendLine("     Reg_Impianti.CUL_COD,  ISNULL(Cultivar.Cul_Des, '') AS Cul_Des,  ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.GRVA_Cod_VEG,0) AS GRVA_Cod_VEG,   ")
            StrSQL.AppendLine("     Appezzamento.Campo_Cod,  ")
            StrSQL.AppendLine("     Appezzamento.SUP_APP, Appezzamento.APP_NOME, ")
            StrSQL.AppendLine("     ISNULL(Appezzamento.DistBZ_CorpiIdrici,0) AS DistBZ_CorpiIdrici, ")
            StrSQL.AppendLine("     ISNULL(Appezzamento.DistBZ_AreeResPub,0) AS DistBZ_AreeResPub,  ")
            StrSQL.AppendLine("     ISNULL(Appezzamento.DistBZ_Allevamenti,0) AS DistBZ_Allevamenti, ")
            StrSQL.AppendLine("     ISNULL(Appezzamento.DistBZ_VegNatNonColt,0) AS DistBZ_VegNatNonColt,  ")
            StrSQL.AppendLine("     ISNULL(Appezzamento.SupBZ_Riduzione,0) AS SupBZ_Riduzione, ")
            StrSQL.AppendLine("     CONVERT(VARCHAR, Appezzamento.Validita_inizio, 103) AS Validita_inizio_Appezzamento, CONVERT(VARCHAR, Appezzamento.Validita_Fine, 103) AS Validita_fine_Appezzamento, ")
            StrSQL.AppendLine("     ISNULL(Reg_Impianti.GRFI_COD,0) AS GRFI_COD, ISNULL(GruppoFinalita.Grfi_Des,'') AS Grfi_Des,  ")
            StrSQL.AppendLine("     ROUND(Imprese_Progetti.P_Ha*Reg_Impianti.Sup_Imp, 0) AS P_Impianto, ")
            StrSQL.AppendLine("     ISNULL(tra_fila_m.val_cod, 0) AS TRA_FILA, ISNULL(su_fila_m.val_cod, 0) AS SU_FILA, ")
            StrSQL.AppendLine("     Imprese_Progetti.Progetto_Cod, Imprese_Progetti.Progetto_Nome AS Progetto,  ")
            StrSQL.AppendLine("     ISNULL(Imprese_Progetti.Stato_Impianto, 102) As Stato_Impianto, ")
            StrSQL.AppendLine("     Imprese_Progetti.Regolamento_Cod AS Regolamento, ISNULL(Regolamenti.Reg_Des, '') AS Reg_Des,  ")
            StrSQL.AppendLine("     Imprese_Progetti.Disciplinare_Cod AS Finanziamento, Imprese_Progetti.Disciplinare_PubblicoPrivato, DPI_Regolamenti.NomeEsteso AS Disciplinare, ISNULL(DPI_Regolamenti.COD_REGOLAMENTO, 0) AS Disciplinare_Cod, 0 AS id_rcdpi, '' AS info,  ")
            StrSQL.AppendLine("     CONVERT(VARCHAR, Imprese_Progetti.Validita_Inizio, 103) AS Validita_Inizio_Distinta, CONVERT(VARCHAR, Imprese_Progetti.Validita_Fine, 103) AS Validita_Fine_Distinta, ")
            'per codici anagrafe
            '--------------------------modifica 10/07/2012--------------------------
            'StrSQL.AppendLine("     ISNULL ((Select Codici_Anagrafe.descrizione from Codici_Anagrafe inner join ")
            'StrSQL.AppendLine("               Reg_Impianti_Codici on Reg_Impianti_Codici.id_cod = Codici_Anagrafe.codice ")
            'StrSQL.AppendLine("                 WHERE     (PIVA = Reg_Impianti.PIVA) AND (sa_cod = Reg_Impianti.sa_cod) AND (appezza = Reg_Impianti.appezza) AND (Id_Reg = Reg_Impianti.id_reg)")
            'StrSQL.AppendLine("                             and id_cod >2999 and id_cod < 4000 ) ")
            'StrSQL.AppendLine("      , '') as Codici_Anagrafe_Des , ")
            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe.descrizione  ")
            StrSQL.AppendLine("      , '') as Codici_Anagrafe_Des , ")
            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe.codice  ")
            StrSQL.AppendLine("      , '') as Codice_Anagrafe , ")
            '---------------------------------------------------------------------------

            '-------------------CODICE APPEZZA BIOLOGICO 30/04/2013--------------------------
            StrSQL.AppendLine("     ISNULL (Appezzamento_Codici_CodBioApp.Val_Cod  ")
            StrSQL.AppendLine("      , '') as CodBioApp , ")
            '---------------------------------------------------------------------------


            '--------------CAPITOLATI Capitolato_Privato------------modifica 08/04/2013--------------------------
            'quic è il codice capitolato, devo recuperare descrizioneCAC_Codifica_InfoAggiuntive
            StrSQL.AppendLine("     ISNULL (CAC_Codifica_InfoAggiuntive.InfoAgg_Des  ")
            StrSQL.AppendLine("      , '') as Capitolato_Privato_Des , ")
            StrSQL.AppendLine("     ISNULL (Codici_Anagrafe_Capitolato_Privato.codice  ")
            StrSQL.AppendLine("      , '') as Capitolato_Privato_Codice , ")
            '---------------------------------------------------------------------------



            StrSQL.AppendLine("     ISNULL(CONVERT(VARCHAR, Imprese_Progetti.Data_Inizio_Prevista, 103),'') AS Data_Semina_Prevista, ")
            StrSQL.AppendLine("     ISNULL(CONVERT(VARCHAR, Imprese_Progetti.Data_Fine_Prevista, 103),'') AS Data_Raccolta_Prevista,  ")
            StrSQL.AppendLine("     ISNULL(CONVERT(VARCHAR, Imprese_Progetti.Data_Fioritura_Prevista, 103),'') AS Data_Fioritura_Prevista,  ")

            StrSQL.AppendLine("     FasiFenologichexFioriture.FF_COD,  ")

            StrSQL.AppendLine("     ISNULL ((Select campo_des from Campi      WHERE     (Appezzamento.PIVA = Campi.PIVA) AND (Appezzamento.sa_cod = Campi.sa_cod) ")
            StrSQL.AppendLine("     AND (Appezzamento.Campo_Cod  = Campi.Campo_Cod )) , '') as Campo_Des ,  ")


            'data semina
            StrSQL.AppendLine("     ISNULL ((SELECT TOP 1 CONVERT(VARCHAR, Movimenti.Data_Movimento, 103) ")
            StrSQL.AppendLine("         FROM    Agenda INNER JOIN ")
