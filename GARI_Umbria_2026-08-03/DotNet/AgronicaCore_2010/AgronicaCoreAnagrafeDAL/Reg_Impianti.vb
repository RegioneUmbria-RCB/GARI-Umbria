    Function ricavaProgressivoConsociazioneSePresente(ByVal Piva As String,
                                       ByVal Sa_Cod As Integer,
                                       ByVal Appezza As Integer,
                                       ByVal ID_Reg As Integer,
                                        ByRef ID_Consociazione As Integer,
                                        ByRef Tot_Consociati As Integer,
                                        ByRef Sigla_Consociazione As String,
                                       ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                       ) As Boolean


        Dim NomeRoutine As String = "AgronicaCoreAnagrafeDAL.Reg_Impianti.ricavaSiglaProgressivaConsociazioneSePresente()"

        Dim MessaggioErrore As String = ""
        Dim StrSQL As New System.Text.StringBuilder
        Dim DT As DataTable

        ID_Consociazione = 0
        Tot_Consociati = 0
        Sigla_Consociazione = ""

        Try
            StrSQL.Length = 0

            StrSQL.AppendLine(" SELECT Id_Consociazione  ")
            StrSQL.AppendLine(" FROM  Reg_Impianti ")
            StrSQL.AppendLine(" WHERE ")

            'If Piva <> "" Then
            StrSQL.AppendLine(" Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Trim(Piva)) & "'")
            'End If

            'If Sa_Cod <> 0 Then
            StrSQL.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            'End If

            'If Appezza <> 0 Then
            StrSQL.AppendLine(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
            ' End If

            'If ID_Reg <> 0 Then
            StrSQL.AppendLine(" AND Reg_Impianti.Id_Reg = " & Agro_SQL_SaveNum(ID_Reg) & " ")
            ' End If


            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------


            'se dt vuoto ritorno false
            If DT.Rows.Count = 0 Then
                Return False
            End If

            ID_Consociazione = DT.Rows(0).Item("Id_Consociazione")

            'se non ci sono consociati ritorno  false stringa vuota
            If ID_Consociazione = 0 Then
                Return False
            End If

            '--------------------------------------------------------------------------
            '--------------------------------------------------------------------------
            '--------------------------------------------------------------------------


            'leggo tutti gli impianti consociati, con quell'Id_Consociazione
            StrSQL.Length = 0

            StrSQL.AppendLine(" SELECT * ")
            StrSQL.AppendLine(" FROM  Reg_Impianti ")
            StrSQL.AppendLine(" WHERE ")

            'If Piva <> "" Then
            StrSQL.AppendLine(" Reg_Impianti.Piva = '" & Agro_SQL_SaveText(Trim(Piva)) & "'")
            'End If

            'If Sa_Cod <> 0 Then
            StrSQL.AppendLine(" AND Reg_Impianti.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " ")
            'End If

            'If Appezza <> 0 Then
            StrSQL.AppendLine(" AND Reg_Impianti.Appezza = " & Agro_SQL_SaveNum(Appezza) & " ")
            ' End If


            StrSQL.AppendLine(" AND Reg_Impianti.Id_Consociazione = " & Agro_SQL_SaveNum(ID_Consociazione) & " ")


            StrSQL.AppendLine(" order by Id_Reg asc ")

            '--------------------------------------------------------------------------
            DT = EseguiQuery_Lettura(objParametri, StrSQL.ToString, NomeRoutine)
            '--------------------------------------------------------------------------

            Dim i As Integer = 0
            For i = 0 To DT.Rows.Count - 1
                If DT.Rows(i).Item("Id_Reg") = ID_Reg Then
                    Tot_Consociati = DT.Rows.Count
                    ID_Consociazione = i + 1
                    Sigla_Consociazione = "" & ID_Consociazione & "-" & DT.Rows.Count
                    Return True
                End If
            Next

            Return False

        Catch ex As Exception

            MessaggioErrore = ex.Message
            Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            'Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
            Return False
        End Try

        Return False

    End Function

