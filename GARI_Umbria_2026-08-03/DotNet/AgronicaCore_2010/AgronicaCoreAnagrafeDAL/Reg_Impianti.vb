            DT = Nothing
            Throw New Exception("[" & NomeRoutine & "] : " & MessaggioErrore)
        End Try

        Return DT

    End Function

    Private Class Json2TmpTable
        Public Class column
            Public tblField As String
            Public tblType As String
            Public jsonProp As String
            Public Sub New(f As String, t As String, j As String)
                tblField = f
                tblType = t
                jsonProp = j
            End Sub
        End Class
        Public Shared Function DeclareAndInsert(tblName As String, tblStruct As column(), jarr As String) As String

            Dim tblfields As New List(Of String)
            Dim lfmt As New List(Of String)

            Dim l0 As Integer = tblStruct.Count
            Dim i0 As Integer = 0

            While i0 < l0

                tblfields.Add(tblStruct(i0).tblField & " " & tblStruct(i0).tblType)

                Dim fmt As String = "{" & i0.ToString & "}"
                If tblStruct(i0).tblType.ToUpper <> "INT" Then

                    fmt = "'" & fmt & "'"
                End If

                lfmt.Add(fmt)

                i0 += 1
            End While

            Dim rowfmt As String = "(" & String.Join(", ", lfmt) & ")"

            Dim sql As New StringBuilder
            sql.Clear()

            sql.AppendLine("DECLARE @" & tblName & " TABLE(" & String.Join(", ", tblfields) & ")")

            If Not String.IsNullOrEmpty(jarr) Then

                Dim arr = JArray.Parse(jarr)

                If arr.Count > 0 Then

                    Dim rows As New List(Of String)
                    Dim fields(tblStruct.Count - 1) As String

                    For Each obj In arr

                        For p = 0 To tblStruct.Count - 1

                            fields(p) = obj(tblStruct(p).jsonProp).ToString
                        Next

                        rows.Add(String.Format(rowfmt, fields))
                    Next

                    sql.AppendLine("INSERT INTO @" & tblName & " VALUES")
                    sql.AppendLine(String.Join(", " & vbCrLf, rows))
                End If
            End If

            Return sql.ToString
        End Function
    End Class

    Public Function Leggi_x_DSS_Irrigazione(Piva As String, json_tx_vegcod As String, json_tx_irricod As String, json_ff_start As String, ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri, Optional fertirrigoDetails As Boolean = False) As DataTable

