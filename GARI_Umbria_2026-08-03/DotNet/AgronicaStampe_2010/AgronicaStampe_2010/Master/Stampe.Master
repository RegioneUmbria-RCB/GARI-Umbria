        <% End If%>
    
    
        <link href="../App_Styles/showLoading.css" rel="Stylesheet" type="text/css" />
        <link href="../App_Styles/Site.css" rel="stylesheet" type="text/css" />
    
    
    <% Else%>
        
        
        <!--Release-->
        <!--STYLE, CSS-->
        <% If FrameworkClient = "jqueryUI" Then%>
            <link href="../App_Styles/jquery-ui-1.8.16.custom.css" rel="Stylesheet" type="text/css" />
            <link href="../App_Styles/jquery.bubblepopup.v2.3.1.css" rel="stylesheet" type="text/css" />
        <% End If%>

        
        <% If FrameworkClient = "bootstrap" Then%>
            <link href="../App_Styles/jquery-ui-1.8.16.custom.css" rel="Stylesheet" type="text/css" />
