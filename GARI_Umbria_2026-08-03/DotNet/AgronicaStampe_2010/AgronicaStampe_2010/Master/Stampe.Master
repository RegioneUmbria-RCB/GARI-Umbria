            <script type="text/javascript" src="<%= ResolveClientUrl("~/App_Scripts/bootstrap-datepicker.js?" & Application("GiasVersioneCorrente").ToString) %>"></script>
            <script type="text/javascript" src="<%= ResolveClientUrl("~/App_Scripts/bootswatch.js?" & Application("GiasVersioneCorrente").ToString) %>"></script>            
