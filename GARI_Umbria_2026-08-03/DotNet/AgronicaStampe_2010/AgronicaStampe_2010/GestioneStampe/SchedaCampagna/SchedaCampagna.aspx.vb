        Catch ex As Exception
            'Commentato perchè in questa stampa manca la gestione log errori
            'Log_errori += "- Salvataggio report temporaneo: " + vbCrLf + ex.Message + vbCrLf
        End Try
        Return reportTemporano
    End Function

