    Public Sub CaricaDsCentriAziendali()

        Dim drR As DS_Centri.DS_CentriRow
        Dim objCentri As New AgronicaCoreAnagrafeDAL.CentriAziendali_Read
        Dim objCentrixRubrica As New AgronicaCoreAnagrafeDAL.CentrixRubrica_Read
        Dim DtCentri As DataTable
        Dim DtRecapiti As DataTable
        Dim i, j, k As Integer
        Dim strRecapiti As String = String.Empty
        Dim codiceMaxLength As Integer
        Dim resto As Integer
        Dim countLength As Integer = 0

        Dim sw As Stopwatch = StartWatch("CaricaDsCentriAziendali")

        '10/04/2019: aggiunto filtro per scartare centri dismessi che non rientrano nel range di stampa
        objParametri_Server.ImpostaFinestre_con_SalvataggioTemporale(Qs_DataInizio, Qs_DataFine)

        Dim xFiltro_TipoIndirizzo As String = "Tipo_Indirizzo = 1"
        DtCentri = objCentri.Leggi(Piva, 0,
                                   AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_JoinDescrizioni,
                                   strFiltroCentri & If(strFiltroCentri <> "", "AND " & xFiltro_TipoIndirizzo, xFiltro_TipoIndirizzo), "", objParametri_Server)

        objParametri_Server.ResettaFinestra()

        HTCentri = New Hashtable

        codiceMaxLength = CInt(DtCentri.Rows.Count / 26)
        resto = DtCentri.Rows.Count Mod 26
        If resto > 0 Then
            codiceMaxLength += 1
        End If

        If Not DtCentri Is Nothing AndAlso DtCentri.Rows.Count > 0 Then

            For i = 0 To DtCentri.Rows.Count - 1

                If Not HTCentri.ContainsKey(String.Format("{0}{1}", DtCentri.Rows(i).Item("PIVA"), DtCentri.Rows(i).Item("Sa_Cod"))) Then

                    HTCentri.Add(String.Format("{0}{1}", DtCentri.Rows(i).Item("PIVA"), DtCentri.Rows(i).Item("Sa_Cod")), "")

                    strRecapiti = String.Empty

                    drR = DSCentri._DS_Centri.NewDS_CentriRow

                    drR.Item("PIVA") = CStr(DtCentri.Rows(i).Item("Piva"))
                    drR.Item("PivaReale") = CStr(DtCentri.Rows(i).Item("PivaReale"))
                    drR.Item("Sa_Cod") = CInt(DtCentri.Rows(i).Item("Sa_Cod"))
                    drR.Item("Sa_Nome") = CStr(DtCentri.Rows(i).Item("Sa_Nome"))
                    drR.Item("Indirizzo") = CStr(DtCentri.Rows(i).Item("ind_des"))
                    drR.Item("CAP") = CStr(DtCentri.Rows(i).Item("CAP"))
                    drR.Item("Comune") = CStr(DtCentri.Rows(i).Item("com_des"))
                    drR.Item("Provincia") = CStr(DtCentri.Rows(i).Item("pro_cod"))


                    '##########     CODIFICA DEI CENTRI AZIENDALI PER LA SCHEDA DI CAMPAGNA MULTICENTRO     ########

                    If i <> 0 AndAlso i Mod 26 = 0 Then
                        countLength += 1
                    End If

                    For k = 0 To countLength
                        drR.Item("Codice") = String.Format("{0}{1}", drR.Item("Codice"), Chr((i Mod 26) + 65))
                    Next


                    HTCentri(String.Format("{0}{1}", DtCentri.Rows(i).Item("PIVA"), DtCentri.Rows(i).Item("Sa_Cod"))) = drR.Item("Codice")

                    '#########      FINE CODIFICA   ##########################


                    'Recupero i recapiti del centro aziendale
                    DtRecapiti = objCentrixRubrica.Anagrafica_Centri_Rubrica_Leggi(Nothing, Piva,
                                                                                CInt(DtCentri.Rows(i).Item("Sa_Cod")),
                                                                                AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaDatiMinimi,
                                                                                "", "", objParametri_Server)

                    If Not DtRecapiti Is Nothing AndAlso DtRecapiti.Rows.Count > 0 Then

                        'Genero una stringa con tutti i recapiti del centro
                        For j = 0 To DtRecapiti.Rows.Count - 1

                            strRecapiti = String.Format("{0}{1}: {2}", strRecapiti, CStr(DtRecapiti.Rows(j).Item("descr")), CStr(DtRecapiti.Rows(j).Item("numero")))

                            If j <> DtRecapiti.Rows.Count - 1 Then
                                strRecapiti = String.Format("{0}{1}", strRecapiti, vbCrLf)
                            End If
                        Next
                    End If

                    drR.Item("Recapiti") = strRecapiti

                    DSCentri._DS_Centri.AddDS_CentriRow(drR)

                End If
            Next

            DSCentri._DS_Centri.Columns("Piva").ColumnName = "Piva_old"
            DSCentri._DS_Centri.Columns("PivaReale").ColumnName = "Piva"
            DSCentri._DS_Centri.Columns("Piva_old").ColumnName = "PivaReale"

        End If

        EndWatch(sw, "CaricaDsCentriAziendali")


    End Sub

