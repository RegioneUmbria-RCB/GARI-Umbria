            RsRaccolta = objSql.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "CaricaDsRilievoProduzioneRaccoltaNEW")
            'Catch ex As Exception
            '    strErr = ex.Message
            'End Try

