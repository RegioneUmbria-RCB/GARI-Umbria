    Public Sub CaricaDsPatentinoRow(ByVal Dr As DataRow)

        Dim drR As DS_Patentino.DS_PatentinoRow
        Dim i, j As Integer
        Dim strRecapiti As String = String.Empty

        drR = DSPatentino.DS_Patentino.NewDS_PatentinoRow

        drR.Item("Nome") = CStr(Dr.Item("Nome"))
        drR.Item("Cognome") = CStr(Dr.Item("Cognome"))

        If CStr(Dr.Item("Rag_Soc")) <> "" Then
            drR.Item("Rag_Soc") = CStr(Dr.Item("Rag_Soc"))
        Else
            drR.Item("Rag_Soc") = String.Format("{0} {1}", CStr(Dr.Item("Nome")), CStr(Dr.Item("Cognome")))
        End If

        If Dr.Item("Cau_Mov") = CAU_IMPUTAZIONE_TERZISTI Then
            drR.Item("Rag_Soc") &= " (Terzista)"
        End If

        drR.Item("N_Patentino") = CStr(Dr.Item("Patentino"))
        If CDate(Dr.Item("Data_Rilascio_Patentino")).ToShortDateString <> "01/01/1900" Then
            drR.Item("Data_Rilascio") = CDate(Dr.Item("Data_Rilascio_Patentino")).ToShortDateString
        Else
            drR.Item("Data_Rilascio") = ""
        End If
        If CDate(Dr.Item("Data_Scadenza_Patentino")).ToShortDateString <> "31/12/2100" Then
            drR.Item("Data_Scadenza") = CDate(Dr.Item("Data_Scadenza_Patentino")).ToShortDateString
        Else
            drR.Item("Data_Scadenza") = ""
        End If

        DSPatentino.DS_Patentino.AddDS_PatentinoRow(drR)

    End Sub

