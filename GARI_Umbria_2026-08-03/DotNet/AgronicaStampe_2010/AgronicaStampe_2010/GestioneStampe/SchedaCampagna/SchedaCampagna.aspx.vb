    '###########################################################################
    'riempie il ds x il Rilevi Avversità e Ausiliari
    Private Sub CaricaDSRilAvvAus(ByVal Flag_Multicentro As Boolean,
                                  ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna,
                                  ByVal Flag_Nasc_DataUltMan As Boolean,
                                  ByVal Flag_Multispecie As Boolean
                                    )

        'Dim objSql As New Codex_Utility.Sql
        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String
        Dim stbQ As New System.Text.StringBuilder
        Dim i As Integer
        Dim App_Nome As String
        Dim Num_Appezzamento As Double
        Dim objNum As New AgronicaCoreDataProvider.UtilityProvider

        Dim Flag_MostraSoloSignificativi As Boolean = Not IsNothing(Session("MostraValoriSignificativiNeiRilievi")) AndAlso Session("MostraValoriSignificativiNeiRilievi") = True

        Dim Rs As DataTable



        Dim sw As Stopwatch = StartWatch("CaricaDsCaricaDSRilAvvAus")

        'query x reperire i dati

        stbQ.Append(" SELECT Agenda.Id_Agenda, " & vbCrLf)
        stbQ.Append(" CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) AS Data_Creazione, Movimenti.Mov_Desc, SpecieVegetali.Veg_Des, Cultivar.Cul_Des, ")
        stbQ.Append(" Reg_Impianti.PIVA, ")
        stbQ.Append(" CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Reg_Impianti.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale, ")
        stbQ.Append(" Reg_Impianti.SA_COD, Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG, Appezzamento.APP_NOME, ")

        '---------------Modifica per gestione erbe infestanti
        'stbQ.Append(" Mov_Dettaglio_Tecnico.Av_Cod, Avversita.Av_Des_Vol, ")
        stbQ.Append(" (case Agenda.Lav_Cod  ")
        stbQ.Append(" 	when 113 then Mov_Dettaglio_Tecnico.Av_Cod  ")
        stbQ.Append(" 	when 119 then Mov_Dettaglio_Tecnico.Av_Gru  ")
        stbQ.Append(" 	else 0  ")
        stbQ.Append(" end)as Av_Cod,  ")

        stbQ.Append(" (case Agenda.Lav_Cod  ")
        stbQ.Append(" 	when 113 then Avversita.Av_Des_Vol ")
        stbQ.Append(" 	when 119 then GruppoAvversita.Av_Gru_Des ")
        stbQ.Append(" 	else 'Non Specificato' ")
        stbQ.Append(" end) collate latin1_general_CI_AS as Av_Des_Vol, ")
        '----------------------

        stbQ.Append(" Mov_Destinazioni.Qta, Movimenti_dettagli.Udm_Cod , ")

        'Se udm des non c'è allora probabilmente ho registrato rilievo erbe prima della modifica che inserisce 
        'unità di misura. 
        stbQ.Append(" ISNULL(UnitaMisura.UDM_DES, 'n. piante per metroquadro') as UDM_DES, ")

        'campo_des
        stbQ.Append(" ISNULL(( SELECT top 1 Campi.Campo_Des " & vbCrLf)
        stbQ.Append(" FROM Campi " & vbCrLf)
        stbQ.Append(" WHERE Campi.Piva = Appezzamento.PIVA AND Campi.Sa_Cod = Appezzamento.SA_COD AND " & vbCrLf)
        stbQ.Append(" Campi.Campo_Cod = Appezzamento.Campo_Cod " & vbCrLf)
        stbQ.Append(" ),'') AS Campo_Nome, " & vbCrLf)


        stbQ.Append(" ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici  ")
        stbQ.Append("       where (Appezzamento_Codici.PIVA = Appezzamento.PIVA) ")
        stbQ.Append("       and (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) ")
        stbQ.Append("       and (Appezzamento_Codici.appezza = Appezzamento.appezza) ")
        stbQ.Append("       and (Appezzamento_Codici.id_cod = 1104) ), '') AS App_Nome_Breve, ")

        stbQ.Append(" ISNULL((SELECT TOP 1 Imprese_Progetti.Progetto_Nome FROM Imprese_Progetti " & vbCrLf)
        stbQ.Append("       WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
        stbQ.Append(" 	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
        stbQ.Append(" 	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
        stbQ.Append(" 	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG  " & vbCrLf)

        'se ho scelto una data unica per la stampa..
        If Qs_DataStampa <> "" Then
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
        Else
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
        End If

        stbQ.Append(" 	     ORDER BY Imprese_Progetti.Validita_Inizio DESC ), '') AS Lotto " & vbCrLf)

        stbQ.Append(" FROM Agenda INNER JOIN ")
        stbQ.Append(" Movimenti ON Agenda.Id_Agenda = Movimenti.Id_Agenda AND Agenda.PIVA = Movimenti.PIVA AND  ")
        stbQ.Append(" Agenda.Sa_Cod = Movimenti.Sa_Cod INNER JOIN ")
        stbQ.Append(" Movimenti_dettagli ON Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov AND Movimenti.PIVA = Movimenti_dettagli.PIVA AND  ")
        stbQ.Append(" Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda INNER JOIN ")
        stbQ.Append(" Mov_Dettaglio_Tecnico ON Movimenti_dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov AND  ")
        stbQ.Append(" Movimenti_dettagli.PIVA = Mov_Dettaglio_Tecnico.Piva AND Movimenti_dettagli.Sa_Cod = Mov_Dettaglio_Tecnico.Sa_Cod AND  ")
        stbQ.Append(" Movimenti_dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda AND Movimenti_dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det INNER JOIN ")
        stbQ.Append(" Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND  ")
        stbQ.Append(" Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND  ")
        stbQ.Append(" Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND  ")
        stbQ.Append(" Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det INNER JOIN ")
        stbQ.Append(" Appezzamento ON Mov_Destinazioni.Piva = Appezzamento.PIVA AND Mov_Destinazioni.Sa_Cod = Appezzamento.SA_COD AND  ")
        stbQ.Append(" Mov_Destinazioni.Appezza = Appezzamento.APPEZZA INNER JOIN ")
        stbQ.Append(" Reg_Impianti ON Mov_Destinazioni.Piva = Reg_Impianti.PIVA AND Mov_Destinazioni.Sa_Cod = Reg_Impianti.SA_COD AND  ")
        stbQ.Append(" Mov_Destinazioni.Id_Destinazione = Reg_Impianti.ID_REG AND Mov_Destinazioni.Appezza = Reg_Impianti.APPEZZA INNER JOIN ")
        stbQ.Append(" Imprese On Imprese.Piva = Reg_Impianti.PIVA ")
        stbQ.Append(" INNER JOIN Cultivar On Cultivar.Cul_Cod = Reg_Impianti.CUL_COD INNER JOIN ")
        stbQ.Append(" SpecieVegetali On SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod  ")
        'stbQ.Append(" LEFT JOIN Imprese_Progetti On Imprese_Progetti.Piva = Reg_Impianti.PIVA And Imprese_Progetti.Sa_Cod = Reg_Impianti.SA_COD And  " & vbCrLf)
        'stbQ.Append(" Imprese_Progetti.Appezza = Reg_Impianti.APPEZZA And Imprese_Progetti.Id_Reg = Reg_Impianti.ID_REG " & vbCrLf)

        '---------------Modifica per gestione erbe infestanti
        'stbQ.Append(" INNER JOIN Avversita On Mov_Dettaglio_Tecnico.Av_Cod = Avversita.Av_Cod  ")
        stbQ.Append(" 		Left JOIN  Avversita On Mov_Dettaglio_Tecnico.Av_Cod = Avversita.Av_Cod   ")
        stbQ.Append(" 		Left JOIN  GruppoAvversita On Mov_Dettaglio_Tecnico.Av_Gru = GruppoAvversita.Av_Gru  ")
        '----------------------

        stbQ.Append(" LEFT JOIN UnitaMisura On Movimenti_dettagli.Udm_Cod = UnitaMisura.Udm_Cod ")

        If IDTestataTemp <> 0 Then

            stbQ.Append(" inner Join __tmp_FiltroImpianti f ")
            stbQ.Append(" On  Reg_Impianti.PIVA = f.piva  ")
            stbQ.Append(" And Reg_Impianti.SA_COD = f.sa_cod ")
            stbQ.Append(" And Reg_Impianti.APPEZZA = f.appezza ")
            stbQ.Append(" And Reg_Impianti.ID_REG = f.id_reg ")
            stbQ.Append("       And f.idTestataTemp = " & IDTestataTemp)
            stbQ.Append("       And f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
            stbQ.Append("       And f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

        End If

        '---------------Modifica per gestione erbe infestanti (119)
        stbQ.Append(" WHERE  Agenda.Lav_Cod In (113, 119) ")
        '----------------------

        If Not Flag_Multispecie Then
            If Veg_Cod = "0" Then
                stbQ.Append(" and Reg_Impianti.cul_cod = 0 ")
            Else
                If TerrenoNudoIncluso = False Then
                    stbQ.Append(" AND SpecieVegetali.VEG_COD = " & Veg_Cod)
                Else
                    stbQ.Append(" AND (SpecieVegetali.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) ")
                End If
            End If
        End If


        stbQ.Append(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

        If Not Flag_Multicentro Then
            stbQ.Append(" AND Agenda.sa_cod = " & Sa_Cod & " ")
