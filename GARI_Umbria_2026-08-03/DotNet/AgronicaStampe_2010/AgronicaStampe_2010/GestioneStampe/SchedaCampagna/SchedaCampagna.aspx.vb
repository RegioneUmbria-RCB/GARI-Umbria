    Private Sub CaricaDsSemine(ByVal Flag_MultiSpecie As Boolean, ByVal Flag_Multicentro As Boolean, ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna)

        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String
        Dim stbQuery As New System.Text.StringBuilder
        Dim objnote As New AgronicaCoreContabDAL.AgendaxNote_R
        Dim Reg_Impianti_Codici_R As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Codici_R

        Dim Id_Agenda_Prec As Integer = 0


        Dim sw As Stopwatch = StartWatch("CaricaDsSemine")

        'Variabile usata per stampare dati delle patate aggiuntive 
        Dim stampaPerPatate As Boolean = False
        If TipoReport = enum_TipoReport.Eurep_Gap_Semplificata OrElse TipoReport = enum_TipoReport.Eurep_Gap_Multicentro _
            OrElse TipoReport = enum_TipoReport.SchedaCampagna_Multicentro_ACA Then
            stampaPerPatate = True
        End If

        Dim i, appIndex As Integer

        Dim App_Nome As String
        Dim Num_Appezzamento As Double

        Try

            Dim DefaultCopy() As StampeDefault

            If Not defaults Is Nothing Then
                ReDim DefaultCopy(defaults.Length - 1)
                Array.Copy(defaults, DefaultCopy, defaults.Length)
            End If


            stbQuery.Append(" SELECT ") 'tolto distinct per fare vedere righe lotti gestite ora in semina  stbQuery.Append(" SELECT DISTINCT ")
            stbQuery.Append(" Movimenti_dettagli.lotto as lottoseme, " & vbCrLf) 'aggiunto per semina che gestisce ora lotti seme

            '19/11/2018 MAGA
            'cul_des gestita meglio per leggere anche le destinazioni d'uso
            'se il mat_des è valorizzato però glielo mette sopra
            'stbQuery.Append("  Cultivar.cul_des,  " & vbCrLf)
            stbQuery.Append(" case when reg_impianti.cul_cod = 0 then " & vbCrLf)
            stbQuery.Append("           ( ISNULL( (SELECT TOP 1 descrizione " & vbCrLf)
            stbQuery.Append("                       FROM Reg_Impianti_Codici RIC " & vbCrLf)
            stbQuery.Append("                       INNER JOIN Codici_Anagrafe Cod ON  RIC.id_cod= Cod.codice " & vbCrLf)
            stbQuery.Append("                       where progetto_cod=0 " & vbCrLf)
            stbQuery.Append("                       and id_cod >= 3000 and id_cod < 4000 " & vbCrLf)
            stbQuery.Append("                       and piva=Reg_Impianti.piva and sa_cod=Reg_Impianti.sa_cod " & vbCrLf)
            stbQuery.Append("                       and appezza= Reg_Impianti.appezza and id_reg=Reg_Impianti.id_reg " & vbCrLf)
            stbQuery.Append("                       ), 'Terreno nudo')  )" & vbCrLf)
            stbQuery.Append(" else  ( " & vbCrLf)
            stbQuery.Append("       SELECT veg_des + ' ' + cul_des " & vbCrLf)
            stbQuery.Append("       FROM SpecieVegetali " & vbCrLf)
            stbQuery.Append("       INNER JOIN Cultivar ON  SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod " & vbCrLf)
            stbQuery.Append("       where Cultivar.Cul_Cod = Reg_Impianti.cul_cod " & vbCrLf)
            stbQuery.Append("       ) " & vbCrLf)
            stbQuery.Append("  end AS cul_des, " & vbCrLf)

            '26/11/2018: sostituito Movimenti.Data_Movimento alla validita_inizio dell'agenda
            'stbQuery.Append(" CONVERT(varchar, Agenda.Validita_Inizio, 103) AS DataSemina, " & vbCrLf)
            '08/04/2025: aggiunta anche l'ora movimento alla data movimento.
            stbQuery.Append(" CAST(Movimenti.Data_Movimento As DATETIME) + CAST(TRY_CAST(Movimenti.Ora As TIME) As DATETIME) AS DataSemina, " & vbCrLf)
            stbQuery.Append(" Mov_Destinazioni.Qta, " & vbCrLf)
            stbQuery.Append(" Movimenti_dettagli.Udm_Cod, UnitaMisura.UDM_SIM, ISNULL(Materie_Prime.Cod_Articolo, '') AS Cod_Articolo, ISNULL(Materie_Prime.Mat_Cod, 0) AS Mat_Cod, ISNULL(Materie_Prime.Mat_Des, '') AS Mat_Des," & vbCrLf)

            '04/08/2023 Casanova: Ora viene stampata la Superficie Trattata non quella anagrafica anche per la Semina
            stbQuery.Append(" Mov_Destinazioni.Qta2 AS sup_imp, ")

            stbQuery.Append(" CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Reg_Impianti.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale,")
            stbQuery.Append(" Reg_Impianti.PIVA, Reg_Impianti.SA_COD, Centri_Aziendali.Sa_Nome, Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG, " & vbCrLf)
            stbQuery.Append(" Agenda.Id_Agenda, Agenda.Lav_Cod, Appezzamento.APP_NOME, " & vbCrLf)

            stbQuery.Append("ISNULL((SELECT TOP 1 Imprese_Progetti.Progetto_Nome FROM Imprese_Progetti " & vbCrLf)
            stbQuery.Append("        WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA ")
            stbQuery.Append("	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod ")
            stbQuery.Append("	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA ")
            stbQuery.Append("	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG " & vbCrLf)
            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQuery.Append("	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
                stbQuery.Append("	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            Else
                stbQuery.Append("	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
                stbQuery.Append("	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
            End If
            stbQuery.Append("	     ORDER BY Imprese_Progetti.Validita_Inizio DESC), '') AS Lotto, " & vbCrLf)

            'campo_des
            stbQuery.Append(" ISNULL(( SELECT top 1 Campi.Campo_Des " & vbCrLf)
            stbQuery.Append(" FROM Campi " & vbCrLf)
            stbQuery.Append(" WHERE Campi.Piva = Appezzamento.PIVA AND Campi.Sa_Cod = Appezzamento.SA_COD AND " & vbCrLf)
            stbQuery.Append(" Campi.Campo_Cod = Appezzamento.Campo_Cod " & vbCrLf)
            stbQuery.Append(" ),'') AS Campo_Nome, " & vbCrLf)

            stbQuery.Append(" ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici  " & vbCrLf)
            stbQuery.Append("       where (Appezzamento_Codici.PIVA = Appezzamento.PIVA) ")
            stbQuery.Append("       and (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) ")
            stbQuery.Append("       and (Appezzamento_Codici.appezza = Appezzamento.appezza) ")
            stbQuery.Append("       and (Appezzamento_Codici.id_cod = 1104) ), '') AS App_Nome_Breve, " & vbCrLf)

            'Note      
            'stbQ.Append(" ISNULL(Note_Intervento.Nota_Des,'') AS Nota_Des, " & vbCrLf)
            stbQuery.Append(" ISNULL(Movimenti.Mov_Desc,'') AS Note " & vbCrLf)

            stbQuery.Append("  " & vbCrLf)
            stbQuery.Append(" , '' AS Ordinamento_Coltura, '01/01/1900' AS Ordinamento_Data, '' AS Ordinamento_Centro, '' AS Ordinamento_AppezzaNomeBreve " & vbCrLf)
            stbQuery.Append("  " & vbCrLf)

            stbQuery.Append(" FROM Reg_Impianti " & vbCrLf)
            stbQuery.Append(" INNER JOIN Imprese  " & vbCrLf)
            stbQuery.Append(" ON Reg_Impianti.PIVA = Imprese.PIVA" & vbCrLf)
            stbQuery.Append(" INNER JOIN Mov_Destinazioni  " & vbCrLf)
            stbQuery.Append(" ON Reg_Impianti.PIVA = Mov_Destinazioni.Piva AND Reg_Impianti.SA_COD = Mov_Destinazioni.Sa_Cod AND Reg_Impianti.APPEZZA = Mov_Destinazioni.Appezza AND ")
            stbQuery.Append(" Reg_Impianti.ID_REG = Mov_Destinazioni.Id_Destinazione  " & vbCrLf)
            stbQuery.Append(" INNER JOIN Movimenti_dettagli  ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND " & vbCrLf)
            stbQuery.Append(" Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND ")
            stbQuery.Append(" Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det AND ")
            stbQuery.Append(" Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov " & vbCrLf)
            stbQuery.Append(" INNER JOIN Movimenti ON Movimenti_dettagli.PIVA = Movimenti.PIVA AND Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod AND ")
            stbQuery.Append(" Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda AND Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov  " & vbCrLf)
            stbQuery.Append(" INNER JOIN  Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND ")
            stbQuery.Append(" Movimenti.Id_Agenda = Agenda.Id_Agenda " & vbCrLf)
            stbQuery.Append(" INNER JOIN  UnitaMisura ON Movimenti_dettagli.Udm_Cod = UnitaMisura.UDM_COD  " & vbCrLf)
            stbQuery.Append(" INNER JOIN Appezzamento ON Mov_Destinazioni.Piva = Appezzamento.PIVA AND Mov_Destinazioni.Sa_Cod = Appezzamento.SA_COD AND ")
            stbQuery.Append(" Mov_Destinazioni.Appezza = Appezzamento.APPEZZA " & vbCrLf)
            stbQuery.Append(" LEFT OUTER JOIN  Materie_Prime ON Movimenti_dettagli.Elem_Cod = Materie_Prime.Elem_Cod AND ")
            stbQuery.Append(" Movimenti_dettagli.Mat_Cod = Materie_Prime.Mat_Cod  " & vbCrLf)
            stbQuery.Append(" INNER JOIN Centri_Aziendali ON Reg_Impianti.Piva = Centri_Aziendali.Piva AND ")
            stbQuery.Append(" Reg_Impianti.Sa_Cod = Centri_Aziendali.Sa_Cod " & vbCrLf)
            If Not Flag_MultiSpecie And Veg_Cod <> "0" Then
                stbQuery.Append(" LEFT OUTER JOIN Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod " & vbCrLf)
                stbQuery.Append(" LEFT OUTER JOIN SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod " & vbCrLf)
            End If

            If IDTestataTemp <> 0 Then

                stbQuery.Append(" inner Join __tmp_FiltroImpianti f ")
                stbQuery.Append(" On  Reg_Impianti.PIVA = f.piva  ")
                stbQuery.Append(" And Reg_Impianti.SA_COD = f.sa_cod ")
                stbQuery.Append(" And Reg_Impianti.APPEZZA = f.appezza ")
                stbQuery.Append(" And Reg_Impianti.ID_REG = f.id_reg ")
                stbQuery.Append("       And f.idTestataTemp = " & IDTestataTemp)
                stbQuery.Append("       And f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
                stbQuery.Append("       And f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

            End If

            stbQuery.Append(" WHERE Agenda.Lav_Cod IN (2, 71, 160) AND Movimenti.Cau_Mov = '2300' " & vbCrLf)

            If Not Flag_MultiSpecie Then
                If Veg_Cod = "0" Then
                    stbQuery.Append(" and Reg_Impianti.cul_cod = 0 " & vbCrLf)
                Else
                    If TerrenoNudoIncluso = False Then
                        stbQuery.Append(" AND SpecieVegetali.VEG_COD = " & Veg_Cod & vbCrLf)
                    Else
                        stbQuery.Append(" AND (SpecieVegetali.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) " & vbCrLf)
                    End If
                End If
            End If

            stbQuery.Append(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' " & vbCrLf)

            If Not Flag_Multicentro Then
                stbQuery.Append(" AND Agenda.sa_cod = " & Sa_Cod & " " & vbCrLf)
            End If

            'stbQuery.Append(strFiltroImpianti & vbCrLf)

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQuery.Append(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
                stbQuery.Append(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
                stbQuery.Append(" AND Movimenti.Data_Movimento = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            Else
                stbQuery.Append(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
                stbQuery.Append(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)

                stbQuery.Append(" AND Movimenti.Data_Movimento <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
                stbQuery.Append(" AND Movimenti.Data_Movimento >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
            End If

            stbQuery.Append(" AND Movimenti_dettagli.contabilizzato >= 0 " & vbCrLf)

            '27/11/2018: non si può modificare l'order by altrimenti si sfancula tutto
            'gestito allora l'ordinamento solo alla fine sul dataset popolato
            'stbQuery.Append(" ORDER BY Agenda.Validita_Inizio, Agenda.Id_Agenda, sa_nome, app_nome " & vbCrLf)
            stbQuery.Append(" ORDER BY Data_Movimento, Agenda.Id_Agenda, sa_nome, app_nome " & vbCrLf)

            ''26/11/2018: gestita scelta dell'ordinamento:
            'Select Case tipo_ordinamento
            '    Case 0
            '        stbQuery.Append(" ORDER BY Movimenti.Data_Movimento, Agenda.Id_Agenda, sa_nome, app_nome " & vbCrLf)
            '    Case 1
            '        stbQuery.Append(" ORDER BY cul_des, Movimenti.Data_Movimento, Agenda.Id_Agenda, sa_nome, app_nome " & vbCrLf)
            '    Case Else
            '        stbQuery.Append(" ORDER BY Movimenti.Data_Movimento, Agenda.Id_Agenda, sa_nome, app_nome " & vbCrLf)
            'End Select

            'strErr = Nothing
            'Try
            objSql.EseguiQuery_Lettura(objParametri_Server, stbQuery.ToString, "SchedaCampagna.CaricaDsSemine", DsSemine, DsSemine._DS_Semine.TableName)
            'Catch ex As Exception
            'strErr = ex.Message
            'End Try

            'If IsNothing(strErr) Then

            If Not IsNothing(DsSemine) Then

                For i = 0 To DsSemine._DS_Semine.Rows.Count - 1

                    '19/11/2018: introdotto controllo per evitare di sovrascrivere con ""
                    If DsSemine._DS_Semine.Rows(i).Item("Mat_Des") <> "" Then
                        '26/11/2018: nel caso di ordinamento per cul_des, magari il risultato potrà non essere ordinato se il mat_des è diverso
                        'Modifica 27/07/2012 
                        'al posto della varieta nella stampa della semina metto il mat_des
                        'così per il sovescio si vede anche la specie usata
                        DsSemine._DS_Semine.Rows(i).Item("Cul_Des") = DsSemine._DS_Semine.Rows(i).Item("Mat_Des")
                    End If

                    '19/11/2018
                    If CStr(DsSemine._DS_Semine.Rows(i).Item("lottoseme")).ToLower = "indefinito" Then
                        DsSemine._DS_Semine.Rows(i).Item("lottoseme") = ""
                    End If
                    If CStr(DsSemine._DS_Semine.Rows(i).Item("udm_sim")).ToLower = "non definito" Then
                        DsSemine._DS_Semine.Rows(i).Item("udm_sim") = ""
                    End If

                    DsSemine._DS_Semine.Rows(i).Item("DataSemina") = Formatta_Data_Movimento(DsSemine._DS_Semine.Rows(i).Item("DataSemina"))

                    DsSemine._DS_Semine.Rows(i).Item("app_nome_breve") = CodiceAppezzamento(DsSemine._DS_Semine.Rows(i).Item("piva"),
                                                                                           DsSemine._DS_Semine.Rows(i).Item("sa_cod"),
                                                                                           DsSemine._DS_Semine.Rows(i).Item("Campo_Nome"),
                                                                                           DsSemine._DS_Semine.Rows(i).Item("appezza"),
                                                                                           TipoCodAppezzamento,
                                                                                           DsSemine._DS_Semine.Rows(i).Item("app_nome"),
                                                                                           DsSemine._DS_Semine.Rows(i).Item("app_nome_breve"),
                                                                                           -1,
                                                                                           lotto:=DsSemine._DS_Semine.Rows(i).Item("Lotto"))

                    Dim NoteChecked As String = ""
                    If Id_Agenda_Prec <> CInt(DsSemine._DS_Semine.Rows(i).Item("Id_Agenda")) Then
                        Id_Agenda_Prec = CInt(DsSemine._DS_Semine.Rows(i).Item("Id_Agenda"))
                        NoteChecked = objnote.ElencoDescrizioniInStringa(Id_Agenda_Prec, AGRODATAINIZIO, AGRODATAFINE, "", "", objParametri_Server)
                    End If
                    DsSemine._DS_Semine.Rows(i).Item("Note") = NoteChecked & CStr(DsSemine._DS_Semine.Rows(i).Item("Note"))

                    DsSemine._DS_Semine.Rows(i).Item("Note") = "App. " & DsSemine._DS_Semine.Rows(i).Item("app_nome_breve") & vbCrLf & DsSemine._DS_Semine.Rows(i).Item("Note")

                    '----------------------------------------------------------
                    '---                Impianti Codici                     ---
                    '----------------------------------------------------------

                    '  Galassi, 07/08/2017 11.56.41: Inserisco le info aggiuntive di CaricaDSSemina2 su questo report nelle note
                    If stampaPerPatate Then
                        Dim filtro As String = "( (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_Parti_Tuberi_Patate) +
                                ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_Taglio_Tuberi_Patate) +
                                ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_TraFila_Maschio) +
                                ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_SuFila_Maschio) +
                                ") )"
                        Dim rs = Reg_Impianti_Codici_R.Leggi(CStr(Piva),
                                            CInt(DsSemine._DS_Semine.Rows(i).Item("sa_cod")),
                                            CInt(DsSemine._DS_Semine.Rows(i).Item("appezza")),
                                            CInt(DsSemine._DS_Semine.Rows(i).Item("id_reg")),
                                            "", 0, "", AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                            filtro, "", objParametri_Server)

                        'In ogni caso imposto = ""
                        Dim PartiTuberi As String = ""
                        Dim TagliatoIntero As String = ""
                        Dim SuFila As String = ""
                        Dim TraFila As String = ""


                        If Not IsNothing(rs) AndAlso rs.Rows.Count <> 0 Then
                            For j = 0 To rs.Rows.Count - 1

                                Select Case rs.Rows(j).Item("id_cod")

                                    Case enum_CodiciAnagrafe.Impianto_Parti_Tuberi_Patate

                                        PartiTuberi = "Parti: " & rs.Rows(j).Item("val_cod") & " "

                                    Case enum_CodiciAnagrafe.Impianto_Taglio_Tuberi_Patate


                                        TagliatoIntero = "Seme: "
                                        Select Case rs.Rows(j).Item("val_cod")
                                            Case "I"
                                                TagliatoIntero += "intero "
                                            Case "T"
                                                TagliatoIntero += "tagliato "
                                            Case Else
                                                TagliatoIntero = ""
                                        End Select

                                    Case enum_CodiciAnagrafe.Impianto_SuFila_Maschio

                                        SuFila = "su fila: " & rs.Rows(j).Item("val_cod") & " "

                                    Case enum_CodiciAnagrafe.Impianto_TraFila_Maschio

                                        TraFila = "tra fila: " & rs.Rows(j).Item("val_cod") & " "

                                End Select

                            Next

                            If PartiTuberi <> "" Or TagliatoIntero <> "" Then
                                DsSemine._DS_Semine.Rows(i).Item("Note") += vbCrLf & TagliatoIntero & PartiTuberi
                            End If
                            If SuFila <> "" Or TraFila <> "" Then
                                DsSemine._DS_Semine.Rows(i).Item("Note") += vbCrLf & "Distanza (m) " & SuFila & TraFila
                            End If
                        End If
                    End If



                    '----------------------------------------------
                    'per id consociazione
                    Try

                        Dim objImp As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
                        Dim ID_Consociazione As Integer
                        Dim Tot_Consociati As Integer
                        Dim Sigla_Consociazione As String
                        If ControllaProgressivoConsociazione(DsSemine._DS_Semine.Rows(i).Item("piva"),
                                                                                           DsSemine._DS_Semine.Rows(i).Item("sa_cod"),
                                                                                            DsSemine._DS_Semine.Rows(i).Item("APPEZZA"), DsSemine._DS_Semine.Rows(i).Item("ID_REG"), ID_Consociazione, Tot_Consociati, Sigla_Consociazione, objParametri_Server) Then
                            DsSemine._DS_Semine.Rows(i).Item("App_Nome_Breve") &= "/" & Sigla_Consociazione & ""
                            'DsSemine.DS_Semine.Rows(i).Item("App_Nome_Breve") &= "/" & ID_Consociazione & ""
                        End If

                    Catch ex As Exception

                    End Try

                    '----------------------------------------------
                    ' x ORDINAMENTO
                    DsSemine._DS_Semine.Rows(i).Item("Ordinamento_Coltura") = DsSemine._DS_Semine.Rows(i).Item("cul_des")
                    DsSemine._DS_Semine.Rows(i).Item("Ordinamento_Data") = CDate(DsSemine._DS_Semine.Rows(i).Item("DataSemina"))
                    DsSemine._DS_Semine.Rows(i).Item("Ordinamento_Centro") = DsSemine._DS_Semine.Rows(i).Item("sa_nome")
                    DsSemine._DS_Semine.Rows(i).Item("Ordinamento_AppezzaNomeBreve") = DsSemine._DS_Semine.Rows(i).Item("app_nome_breve")
                    '----------------------------------------------

                    If i > 0 Then

                        '  Galassi, 10/11/2016 12:09:40: per Romagnoli
                        inserisciTraGliIdAgendaMovimentati(DsSemine._DS_Semine.Rows(i - 1).Item("id_agenda"))

                        If DsSemine._DS_Semine.Rows(i).Item("id_agenda") = DsSemine._DS_Semine.Rows(i - 1).Item("id_agenda") Then

                            DsSemine._DS_Semine.Rows(i).Item("DataSemina") = ""

                            If DsSemine._DS_Semine.Rows(i).Item("piva") = DsSemine._DS_Semine.Rows(i - 1).Item("piva") And
                               DsSemine._DS_Semine.Rows(i).Item("sa_cod") = DsSemine._DS_Semine.Rows(i - 1).Item("sa_cod") And
                               DsSemine._DS_Semine.Rows(i).Item("appezza") = DsSemine._DS_Semine.Rows(i - 1).Item("appezza") And
                               DsSemine._DS_Semine.Rows(i).Item("id_reg") = DsSemine._DS_Semine.Rows(i - 1).Item("id_reg") Then

                                DsSemine._DS_Semine.Rows(i).Item("sa_nome") = ""
                                DsSemine._DS_Semine.Rows(i).Item("sup_imp") = 0
                                '19/11/19: commentato cul_des, altrimenti non si vedevano tutte le varietà delle sementi/piantine
                                'DsSemine._DS_Semine.Rows(i).Item("cul_des") = ""
                                DsSemine._DS_Semine.Rows(i).Item("app_nome") = ""
                                DsSemine._DS_Semine.Rows(i).Item("app_nome_breve") = ""
                                'lotto è quello dell'impianto
                                DsSemine._DS_Semine.Rows(i).Item("lotto") = ""
                                DsSemine._DS_Semine.Rows(i).Item("Note") = ""

                            End If

                        End If
                    End If

                    If Not DefaultCopy Is Nothing Then
                        For appIndex = 0 To DefaultCopy.Length - 1

                            If Not DefaultCopy(appIndex) Is Nothing AndAlso CInt(DsSemine._DS_Semine.Rows(i).Item("appezza")) = DefaultCopy(appIndex).Appezza Then

                                DefaultCopy(appIndex) = Nothing
                            End If
                        Next
                    End If


                Next

                Dim InserisciSeminaPrevista As Boolean

                'Per gli appezzamenti per cui non sono state registrate semine, aggiungo una riga con
                'data semina prevista
                If Not defaults Is Nothing AndAlso
                      defaults.Length > 0 AndAlso
                            DsSemine._DS_Semine.Rows.Count < defaults.Length Then

                    For i = 0 To defaults.Length - 1

                        InserisciSeminaPrevista = False

                        If Not DefaultCopy(i) Is Nothing AndAlso defaults(i).Data_Semina <> AGRODATAINIZIO Then

                            'se ho scelto una data unica per la stampa..
                            If Qs_DataStampa <> "" Then
                                If CDate(defaults(i).Data_Semina) >= CDate(Qs_DataStampa) And
                                  CDate(defaults(i).Data_Semina) <= CDate(Qs_DataStampa) Then
                                    InserisciSeminaPrevista = True
                                End If
                            Else
                                If CDate(defaults(i).Data_Semina) >= CDate(Qs_DataInizio) And
                                   CDate(defaults(i).Data_Semina) <= CDate(Qs_DataFine) Then
                                    InserisciSeminaPrevista = True
                                End If
                            End If

                            If InserisciSeminaPrevista = True Then

                                Dim newRow = DsSemine._DS_Semine.NewDS_SemineRow()

                                newRow.DataSemina = defaults(i).Data_Semina
                                newRow.Ordinamento_Data = CDate(newRow.DataSemina)

                                newRow.Lotto = defaults(i).Lotto
                                'If Not HTCentri Is Nothing Then
                                '    newRow.App_Nome_Breve = String.Format("{0}/{1}", HTCentri.Item(String.Format("{0}{1}", CStr(defaults(i).Piva), CStr(defaults(i).Sa_Cod))), CStr(defaults(i).Num_App))
                                'Else
                                '    newRow.App_Nome_Breve = CStr(defaults(i).Num_App)
                                'End If
                                Dim app As New AgronicaCoreAnagrafeDAL.Appezzamento_Read
                                Dim obj As New AgronicaCoreAnagrafeDAL.Appezzamento_Codici_R
                                Dim newRow_Appezza_Nome As String = app.AppezzamentoNome_from_Appezza(defaults(i).Piva, defaults(i).Sa_Cod, defaults(i).Appezza, objParametri_Server)
                                newRow.App_Nome_Breve = obj.RiferimentoAlfanumerico_from_Appezza(defaults(i).Piva, defaults(i).Sa_Cod, defaults(i).Appezza, "", objParametri_Server)

                                newRow.App_Nome_Breve = CodiceAppezzamento(defaults(i).Piva, defaults(i).Sa_Cod, defaults(i).Campo_Nome, defaults(i).Appezza,
                                                                         TipoCodAppezzamento,
                                                                         newRow_Appezza_Nome, newRow.App_Nome_Breve, -1)

                                newRow.Ordinamento_AppezzaNomeBreve = newRow.App_Nome_Breve

                                '28/11/2018: per le schede multispecie visualizzato tutto
                                newRow.Cul_Des = Trim(defaults(i).Veg_Des & " " & defaults(i).Cul_Des & " " & defaults(i).Dest_Uso)
                                newRow.Ordinamento_Coltura = newRow.Cul_Des
                                newRow.Ordinamento_Centro = ""

                                newRow.Sup_Imp = defaults(i).Sup_HA_App
                                newRow.Piva = defaults(i).Piva
                                newRow.Sa_Cod = defaults(i).Sa_Cod

                                newRow.Note = "App. " + newRow.App_Nome_Breve


                                '----------------------------------------------------------
                                '---                Impianti Codici                     ---
                                '----------------------------------------------------------

                                '  Galassi, 08/08/2017 15.13.41: Inserisco le info aggiuntive di CaricaDSSemina2 su questo report nelle note anche per quelle previste
                                If stampaPerPatate Then
                                    Dim filtro As String = "( (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_Parti_Tuberi_Patate) +
                                            ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_Taglio_Tuberi_Patate) +
                                            ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_TraFila_Maschio) +
                                            ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_SuFila_Maschio) +
                                            ") )"
                                    Dim rs = Reg_Impianti_Codici_R.Leggi(CStr(defaults(i).Piva),
                                                        CInt(defaults(i).Sa_Cod),
                                                        CInt(defaults(i).Appezza),
                                                        CInt(defaults(i).Id_Reg),
                                                        "", 0, "", AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                        filtro, "", objParametri_Server)

                                    'In ogni caso imposto = ""
                                    Dim PartiTuberi As String = ""
                                    Dim TagliatoIntero As String = ""
                                    Dim SuFila As String = ""
                                    Dim TraFila As String = ""


                                    If Not IsNothing(rs) AndAlso rs.Rows.Count <> 0 Then
                                        For j = 0 To rs.Rows.Count - 1

                                            Select Case rs.Rows(j).Item("id_cod")

                                                Case enum_CodiciAnagrafe.Impianto_Parti_Tuberi_Patate

                                                    PartiTuberi = "Parti: " & rs.Rows(j).Item("val_cod") & " "

                                                Case enum_CodiciAnagrafe.Impianto_Taglio_Tuberi_Patate


                                                    TagliatoIntero = "Seme: "
                                                    Select Case rs.Rows(j).Item("val_cod")
                                                        Case "I"
                                                            TagliatoIntero += "intero "
                                                        Case "T"
                                                            TagliatoIntero += "tagliato "
                                                        Case Else
                                                            TagliatoIntero = ""
                                                    End Select

                                                Case enum_CodiciAnagrafe.Impianto_SuFila_Maschio

                                                    SuFila = "su fila: " & rs.Rows(j).Item("val_cod") & " "

                                                Case enum_CodiciAnagrafe.Impianto_TraFila_Maschio

                                                    TraFila = "tra fila: " & rs.Rows(j).Item("val_cod") & " "

                                            End Select

                                        Next

                                        If PartiTuberi <> "" Or TagliatoIntero <> "" Then
                                            newRow.Note += vbCrLf & TagliatoIntero & PartiTuberi
                                        End If
                                        If SuFila <> "" Or TraFila <> "" Then
                                            newRow.Note += vbCrLf & "Distanza (m) " & SuFila & TraFila
                                        End If
                                    End If
                                End If

                                DsSemine._DS_Semine.Rows.Add(newRow)

                            End If

                        End If

                    Next


                    Select Case tipo_ordinamento
                        Case 1

                            Dim Righe_Old As Integer
                            Righe_Old = DsSemine._DS_Semine.Count

                            If Righe_Old > 1 Then

                                'For Each dr In DsSemine._DS_Semine.Select("", "Cul_Des, DataSemina, sa_nome, App_Nome_Breve")
                                For Each dr In DsSemine._DS_Semine.Select("", "Ordinamento_Coltura, Ordinamento_Data, Ordinamento_Centro, Ordinamento_AppezzaNomeBreve")
                                    DsSemine._DS_Semine.ImportRow(dr)
                                Next

                                'è importante fare questa istruzione prima del delete!!!!
                                'rendo permanenti le modifiche sul ds
                                DsSemine._DS_Semine.AcceptChanges()

                                For i = 0 To Righe_Old - 1
                                    DsSemine._DS_Semine.Rows(i).Delete()
                                Next

                                'rendo permanenti le modifiche sul ds
                                DsSemine._DS_Semine.AcceptChanges()

                                DsSemine._DS_Semine.Columns("Piva").ColumnName = "Piva_old"
                                DsSemine._DS_Semine.Columns("PivaReale").ColumnName = "Piva"
                                DsSemine._DS_Semine.Columns("Piva_old").ColumnName = "PivaReale"

                            End If

                    End Select

                End If

            End If
            'Else
            '   Throw New Exception(strErr)
            'End If

        Catch ex As Exception
            Log_Errori &= "CaricaDsSemine: " & vbCrLf & ex.Message & vbCrLf
            Throw New Exception(Log_Errori)
        End Try

        EndWatch(sw, "CaricaDsSemine")

    End Sub




    'query x caricare i dati x le concimazioni..
    Private Sub CaricaDsConcimazioni(ByVal Flag_Multispecie As Boolean,
                                     ByVal Flag_Multicentro As Boolean, ByVal Flag_Nasc_Resp As Boolean,
                                     ByVal Flag_Nasc_Oper As Boolean, ByVal Flag_Nasc_Macc As Boolean,
                                     ByVal Flag_Nasc_DataFirma As Boolean, ByVal Flag_Nasc_NumRic As Boolean,
                                     ByVal Flag_Nasc_DataUltMan As Boolean,
                                     ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna)


        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String

        Dim i, j, c As Integer

        Dim stbQuery As New System.Text.StringBuilder


        Dim sw As Stopwatch = StartWatch("CaricaDsConcimazioni")

        stbQuery.AppendLine("IF NOT OBJECT_ID('tempdb.dbo.#fioriture_cte') IS NULL ")
        stbQuery.AppendLine("BEGIN ")
        stbQuery.AppendLine("DROP TABLE #fioriture_cte ")
        stbQuery.AppendLine("END;")

        stbQuery.AppendLine(" With fioriture_cte As ")
        stbQuery.AppendLine(" ( ")
        stbQuery.AppendLine(" Select ")
        stbQuery.AppendLine(" Mov_Destinazioni.validita_inizio, Mov_Destinazioni.Sa_cod, ")
        stbQuery.AppendLine(" Mov_Destinazioni.Appezza, Mov_Destinazioni.Id_Destinazione, Mov_Destinazioni.id_agenda, ")
        stbQuery.AppendLine(" convert(nvarchar(50), Mov_Destinazioni.Sa_cod) + '-' + convert(nvarchar(50),Mov_Destinazioni.Appezza) + '-' + convert(nvarchar(50),Mov_Destinazioni.Id_Destinazione) as Chiave ")
        stbQuery.AppendLine(" FROM ")
        stbQuery.AppendLine(" mov_Dettaglio_Tecnico INNER JOIN ")
        stbQuery.AppendLine(" Movimenti_dettagli ON Mov_Dettaglio_Tecnico.Piva = Movimenti_dettagli.PIVA ")
        stbQuery.AppendLine(" And ")
        stbQuery.AppendLine(" Mov_Dettaglio_Tecnico.Sa_Cod = Movimenti_dettagli.Sa_Cod And ")
        stbQuery.AppendLine(" Mov_Dettaglio_Tecnico.Id_Agenda = Movimenti_dettagli.Id_Agenda And ")
        stbQuery.AppendLine(" Mov_Dettaglio_Tecnico.Id_Mov = Movimenti_dettagli.Id_Mov And ")
        stbQuery.AppendLine(" Mov_Dettaglio_Tecnico.Id_Mov_Det = Movimenti_dettagli.Id_Mov_Det ")
        stbQuery.AppendLine(" INNER Join Movimenti ")
        stbQuery.AppendLine(" INNER Join Agenda ON Movimenti.PIVA = Agenda.PIVA And Movimenti.Sa_Cod = Agenda.Sa_Cod And ")
        stbQuery.AppendLine(" Movimenti.Id_Agenda = Agenda.Id_Agenda On Movimenti_dettagli.PIVA = Movimenti.PIVA And ")
        stbQuery.AppendLine(" Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod And Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda And ")
        stbQuery.AppendLine(" Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov ")
        stbQuery.AppendLine(" INNER Join  Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva ")
        stbQuery.AppendLine(" And ")
        stbQuery.AppendLine(" Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod And Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda And ")
        stbQuery.AppendLine(" Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov And ")
        stbQuery.AppendLine(" Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
        stbQuery.AppendLine(" WHERE(Agenda.Lav_Cod = 79)   And (Movimenti.Cau_Mov = '2100') ")
        stbQuery.AppendLine(" And (Mov_Destinazioni.PIVA = '" & Agro_SQL_SaveText(Piva) & "') ")

        '(10/12/2018 fede) aggiunti codici bbch
        If strFF_Cod <> "" Or strFF_Cod_BBCH <> "" Then
            stbQuery.AppendLine(" And  (Mov_Dettaglio_Tecnico.FF_Classe IN (" & Agro_SQL_Save_Clausola_IN(strFF_Cod, False) & ") ")
            stbQuery.AppendLine(" Or Mov_Dettaglio_Tecnico.FF_Classe IN (" & Agro_SQL_Save_Clausola_IN(strFF_Cod_BBCH, False) & ")) ")
        End If
        stbQuery.AppendLine("  ) ")
        stbQuery.AppendLine(" SELECT * INTO #fioriture_cte FROM fioriture_cte ")
        stbQuery.AppendLine(" CREATE INDEX IDX_Fioriture_CTE_Chiave ON #fioriture_cte(chiave);")


        stbQuery.AppendLine(" SELECT DISTINCT ")
        stbQuery.AppendLine(" Centri_Aziendali.Sa_nome, ")
        stbQuery.AppendLine(" ISNULL(SpecieVegetali.veg_cod, 0) AS veg_cod, ")
        stbQuery.AppendLine(" ISNULL(Cultivar.CUL_DES,'') AS CUL_DES, ")

        '26/11/2018 introdotta lettura destinazione d'uso in query invece che lettura separata dopo (serve la dest uso per l'eventuale ordinamento per coltura)
        'stbQuery.Append(" ISNULL(veg_des, '') AS veg_Des, ")
        stbQuery.AppendLine(" CASE WHEN reg_impianti.cul_cod = 0 THEN ")
        stbQuery.AppendLine("           ( ISNULL( (SELECT TOP 1 descrizione ")
        stbQuery.AppendLine("                       FROM Reg_Impianti_Codici RIC ")
        stbQuery.AppendLine("                       INNER JOIN Codici_Anagrafe Cod")
        stbQuery.AppendLine("                       ON  RIC.id_cod= Cod.codice ")
        stbQuery.AppendLine("                       WHERE progetto_cod = 0 ")
        stbQuery.AppendLine("                       AND id_cod >= 3000 And id_cod < 4000 ")
        stbQuery.AppendLine("                       AND piva=Reg_Impianti.piva And sa_cod=Reg_Impianti.sa_cod ")
        stbQuery.AppendLine("                       AND appezza= Reg_Impianti.appezza And id_reg=Reg_Impianti.id_reg ")
        stbQuery.AppendLine("                       ), 'Terreno nudo')  )")
        stbQuery.AppendLine(" ELSE  ( ")
        stbQuery.AppendLine("       veg_des  ")
        stbQuery.AppendLine("       )  ")
        stbQuery.AppendLine("  end AS veg_des, ")

        stbQuery.AppendLine(" Mov_Destinazioni.Qta2 AS Sup_Trattata, ")

        stbQuery.AppendLine(" ISNULL(fertilizzanti.fer_cod,0) AS fer_cod, ISNULL(fertilizzanti.FER_DES,'') AS FER_DES, ")
        stbQuery.AppendLine(" ISNULL(fertilizzanti.N,0) AS N, ISNULL(fertilizzanti.P2O5,0) AS P2O5, ISNULL(fertilizzanti.K2O,0) AS K2O, ISNULL(fertilizzanti.MgO,0) AS MgO, ")
        stbQuery.AppendLine(" ISNULL(Materie_Prime.Mat_Des,'') AS fer_des_1, ISNULL(Materie_Prime.Mat_Cod,0) AS fer_cod_1, ")
        stbQuery.AppendLine(" ISNULL(Materie_Prime.N,0) AS N_1, ISNULL(Materie_Prime.P2O5,0) AS P2O5_1, ISNULL(Materie_Prime.K2O,0) AS K2O_1, ISNULL(Materie_Prime.MgO,0) AS MgO_1, ")
        stbQuery.AppendLine(" Agenda.des_lib, Imprese_Progetti.Progetto_Nome as Lotto, ")
        '08/04/2025: aggiunta anche l'ora movimento alla data movimento.
        stbQuery.AppendLine(" CONVERT(varchar, Movimenti.Data_Movimento,103) as Data_Creazione, CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) As Data_Movimento, Movimenti.Mov_Desc, ")
        stbQuery.AppendLine(" CONVERT(varchar, Agenda.Data_Creazione,103) As Data_Registrazione, ")

        stbQuery.AppendLine(" Movimenti.Mezzo, ISNULL(Mov_Dettaglio_Tecnico_1.Qta_Ril,0) As Qta_Ril, unitamisura.UDM_DES, ")
        stbQuery.AppendLine(" Reg_Impianti.sup_imp As SUP_APP, ")

        stbQuery.AppendLine(" Movimenti_dettagli.Qta, ")
        stbQuery.AppendLine(" Operazioni.lav_cod, Operazioni.lav_des, unitamisura.UDM_COD, Movimenti_dettagli.Extra_Int, ")
        stbQuery.AppendLine(" Appezzamento.Piva,   ")
        stbQuery.AppendLine(" (Select TOP 1 CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Imprese.PIVA ELSE Imprese.partitaIvaReale END AS Piva  ")
        stbQuery.AppendLine(" FROM Imprese  ")
        stbQuery.AppendLine(" WHERE Imprese.PIVA = Appezzamento.PIVA) AS PivaReale,   ")
        stbQuery.AppendLine(" Appezzamento.APPEZZA, Appezzamento.APP_NOME, Appezzamento.sa_cod, Reg_Impianti.ID_REG, Agenda.Id_Agenda,  ")

        stbQuery.AppendLine(" ISNULL((Select TOP 1 Appezzamento_Codici.val_cod ")
        stbQuery.AppendLine(" FROM Appezzamento_Codici  ")
        stbQuery.AppendLine(" WHERE (Appezzamento_Codici.PIVA = Appezzamento.PIVA) ")
        stbQuery.AppendLine(" And (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) ")
        stbQuery.AppendLine(" And (Appezzamento_Codici.appezza = Appezzamento.appezza) ")
        stbQuery.AppendLine(" And (Appezzamento_Codici.id_cod = 1104) ), '') AS App_Nome_Breve, ")

        'stbQuery.Append(" ISNULL((SELECT TOP 1 Mov_Destinazioni.validita_inizio ")
        'stbQuery.Append("           FROM         Mov_Dettaglio_Tecnico INNER JOIN  ")
        'stbQuery.Append("                       Movimenti_dettagli ON Mov_Dettaglio_Tecnico.Piva = Movimenti_dettagli.PIVA AND  ")
        'stbQuery.Append("                       Mov_Dettaglio_Tecnico.Sa_Cod = Movimenti_dettagli.Sa_Cod AND  ")
        'stbQuery.Append("                       Mov_Dettaglio_Tecnico.Id_Agenda = Movimenti_dettagli.Id_Agenda AND  ")
        'stbQuery.Append("                       Mov_Dettaglio_Tecnico.Id_Mov = Movimenti_dettagli.Id_Mov AND  ")
        'stbQuery.Append("                       Mov_Dettaglio_Tecnico.Id_Mov_Det = Movimenti_dettagli.Id_Mov_Det INNER JOIN  ")
        'stbQuery.Append("                       Movimenti INNER JOIN  ")
        'stbQuery.Append("                       Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND  ")
        'stbQuery.Append("                       Movimenti.Id_Agenda = Agenda.Id_Agenda ON Movimenti_dettagli.PIVA = Movimenti.PIVA AND  ")
        'stbQuery.Append("                       Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda AND  ")
        'stbQuery.Append("                       Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov INNER JOIN  ")
        'stbQuery.Append("                       Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND  ")
        'stbQuery.Append("                       Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND  ")
        'stbQuery.Append("                       Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND  ")
        'stbQuery.Append("                       Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det  ")
        'stbQuery.Append(" WHERE     (Agenda.Lav_Cod = 79)  ")
        'stbQuery.Append(" AND (Movimenti.Cau_Mov = '2100')  ")
        'stbQuery.Append(" AND (Mov_Destinazioni.PIVA = '" & Piva & "')  ")
        'stbQuery.Append(" AND Mov_Destinazioni.Sa_Cod = Appezzamento.sa_cod ")
        'stbQuery.Append(" AND Mov_Destinazioni.APPEZZA = Appezzamento.APPEZZA ")
        'stbQuery.Append(" AND Mov_Destinazioni.ID_destinazione = Reg_Impianti.ID_REG ")
        '(10/12/2018 fede) aggiunti codici bbch
        'If strFF_Cod <> "" Or strFF_Cod_BBCH <> "" Then
        '    stbQuery.Append(" AND  ((Mov_Dettaglio_Tecnico.FF_Classe IN (" & Agro_SQL_Save_Clausola_IN(strFF_Cod, False) & ")) OR (Mov_Dettaglio_Tecnico.FF_Classe IN (" & Agro_SQL_Save_Clausola_IN(strFF_Cod_BBCH, False) & "))  ) ")
        '    stbQuery.Append("  ),'') AS Data_Fioritura, ")
        'Else
        '    stbQuery.Append("  ),'') AS Data_Fioritura, ")
        'End If

        stbQuery.AppendLine(" ISNULL( ")
        stbQuery.AppendLine(" ( ")
        stbQuery.AppendLine(" Select top 1 f.Validita_inizio ")
        stbQuery.AppendLine(" From #fioriture_cte f ")
        stbQuery.AppendLine(" Where chiave = Convert(nvarchar(50), Reg_Impianti.sa_cod) + '-' + convert(nvarchar(50), Reg_Impianti.appezza) + '-' + convert(nvarchar(50), Reg_Impianti.ID_REG) ")
        'stbQuery.Append(" Where f.sa_cod = Reg_Impianti.SA_COD and f.appezza = Reg_Impianti.APPEZZA and f.Id_Destinazione = Reg_Impianti.id_reg ")
        stbQuery.AppendLine(" ),'') AS Data_Fioritura, ")

        'If strFF_Cod <> "" Then
        '    stbQuery.Append(" AND  (Mov_Dettaglio_Tecnico.FF_Classe IN (" & Agro_SQL_Save_Clausola_IN(strFF_Cod, False) & ")) ),'') AS Data_Fioritura, ")
        'Else
        '    stbQuery.Append("  ),'') AS Data_Fioritura, ")
        'End If

        stbQuery.AppendLine(" ISNULL(Mov_Dettaglio_Tecnico.N,0) AS N_Operazione, ISNULL(Mov_Dettaglio_Tecnico.P,0) AS P2O5_Operazione,  ")
        stbQuery.AppendLine(" ISNULL(Mov_Dettaglio_Tecnico.K,0) AS K2O_Operazione, ISNULL(Mov_Dettaglio_Tecnico.Mg,0) AS MgO_Operazione, ")
        stbQuery.AppendLine(" ISNULL(Mov_Dettaglio_Tecnico.Efficienza,1) AS Efficienza,  ")
        stbQuery.AppendLine(" ISNULL(Movimenti.Extra_Int,0) AS Epoca_Cod, ISNULL(EpocheModalita.EM_Des,'') AS Epoca_Des, ISNULL(Movimenti.num_protocollo,0) AS Regolamento_Cod, ")

        'Ricetta 
        stbQuery.AppendLine(" ISNULL(RicettexAgenda.Ricetta_Cod,0) AS Ricetta_Cod, ")

        'campo_des
        stbQuery.AppendLine(" ISNULL(( SELECT top 1 Campi.Campo_Des ")
        stbQuery.AppendLine(" FROM Campi ")
        stbQuery.AppendLine(" WHERE Campi.Piva = Appezzamento.PIVA AND Campi.Sa_Cod = Appezzamento.SA_COD ")
        stbQuery.AppendLine(" AND Campi.Campo_Cod = Appezzamento.Campo_Cod ")
        stbQuery.AppendLine(" ),'') AS Campo_Nome, ")

        'Note      
        stbQuery.AppendLine(" ISNULL(Note_Intervento.Nota_Des,'') AS Nota_Des, ")
        stbQuery.AppendLine(" '' AS Ordinamento_Coltura, '' AS Ordinamento_Data, '' AS Ordinamento_Prodotto, '' AS Ordinamento_Centro, '' AS Ordinamento_AppezzaNomeBreve, ")

        'Modaliltà applicazione e Nr domanda ACA
        stbQuery.AppendLine("Movimenti.Modalita_Applicazione,")
        stbQuery.AppendLine("ModAppl.Modalita_Applicazione_Descrizione,")
        stbQuery.AppendLine("CodiciACA.Nr_domanda_ACA")

        stbQuery.AppendLine("FROM  Materie_Prime")
        stbQuery.AppendLine("RIGHT OUTER JOIN Mov_Dettaglio_Tecnico AS Mov_Dettaglio_Tecnico")
        stbQuery.AppendLine("RIGHT OUTER JOIN Reg_Impianti")
        stbQuery.AppendLine("INNER JOIN Appezzamento")
        stbQuery.AppendLine("INNER JOIN Mov_Destinazioni AS Mov_Destinazioni")
        stbQuery.AppendLine("ON Appezzamento.PIVA = Mov_Destinazioni.Piva")
        stbQuery.AppendLine("AND Appezzamento.SA_COD = Mov_Destinazioni.Sa_Cod")
        stbQuery.AppendLine("AND Appezzamento.APPEZZA = Mov_Destinazioni.Appezza")
        stbQuery.AppendLine("On Reg_Impianti.PIVA = Mov_Destinazioni.Piva ")
        stbQuery.AppendLine("AND Reg_Impianti.SA_COD = Mov_Destinazioni.Sa_Cod")
        stbQuery.AppendLine("AND Reg_Impianti.ID_REG = Mov_Destinazioni.Id_Destinazione ")
        stbQuery.AppendLine("AND Reg_Impianti.APPEZZA = Mov_Destinazioni.Appezza")
        stbQuery.AppendLine("LEFT OUTER JOIN Imprese_Progetti")
        stbQuery.AppendLine("ON Imprese_Progetti.Piva = Reg_Impianti.PIVA")
        stbQuery.AppendLine("AND Imprese_Progetti.Sa_Cod = Reg_Impianti.SA_COD")
        stbQuery.AppendLine("AND Imprese_Progetti.Appezza = Reg_Impianti.APPEZZA")
        stbQuery.AppendLine("AND Imprese_Progetti.Id_Reg = Reg_Impianti.ID_REG")

        stbQuery.AppendLine("INNER JOIN Agenda AS Agenda")
        stbQuery.AppendLine("INNER JOIN Movimenti AS Movimenti")
        stbQuery.AppendLine("ON Agenda.Id_Agenda = Movimenti.Id_Agenda")
        stbQuery.AppendLine("AND Agenda.PIVA = Movimenti.PIVA ")
        stbQuery.AppendLine("AND Agenda.Sa_Cod = Movimenti.Sa_Cod ")
        stbQuery.AppendLine("INNER JOIN Movimenti_dettagli AS Movimenti_dettagli")
        stbQuery.AppendLine("ON Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov")
        stbQuery.AppendLine("AND Movimenti.PIVA = Movimenti_dettagli.PIVA")
        stbQuery.AppendLine("AND Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod")
        stbQuery.AppendLine("AND Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda")

        'Modalità applicazione
        stbQuery.AppendLine("LEFT OUTER JOIN (")
        stbQuery.AppendLine("SELECT Codice, AGEA_Des As Modalita_Applicazione_Descrizione")
        stbQuery.AppendLine("FROM Modalita_Applicazione_Globali")
        stbQuery.AppendLine("UNION")
        stbQuery.AppendLine("SELECT Codice, Descrizione_Personalizzata")
        stbQuery.AppendLine("FROM Modalita_Applicazione")
        stbQuery.AppendLine(") As ModAppl")
        stbQuery.AppendLine("ON Movimenti.Modalita_Applicazione = ModAppl.Codice")


        stbQuery.AppendLine("INNER JOIN UnitaMisura AS unitamisura")
        stbQuery.AppendLine("ON Movimenti_dettagli.Udm_Cod = unitamisura.UDM_COD")
        stbQuery.AppendLine("INNER JOIN Operazioni")
        stbQuery.AppendLine("ON Agenda.Lav_Cod = Operazioni.LAV_COD")
        stbQuery.AppendLine("ON Mov_Destinazioni.Piva = Movimenti_dettagli.PIVA")
        stbQuery.AppendLine("AND Mov_Destinazioni.Sa_Cod = Movimenti_dettagli.Sa_Cod")
        stbQuery.AppendLine("AND Mov_Destinazioni.Id_Agenda = Movimenti_dettagli.Id_Agenda")
        stbQuery.AppendLine("AND Mov_Destinazioni.Id_Mov = Movimenti_dettagli.Id_Mov")
        stbQuery.AppendLine("AND Mov_Destinazioni.Id_Mov_Det = Movimenti_dettagli.Id_Mov_Det")
        stbQuery.AppendLine("ON Mov_Dettaglio_Tecnico.Id_Mov_Det = Movimenti_dettagli.Id_Mov_Det")
        stbQuery.AppendLine("AND Mov_Dettaglio_Tecnico.Piva = Movimenti_dettagli.PIVA")
        stbQuery.AppendLine("AND Mov_Dettaglio_Tecnico.Sa_Cod = Movimenti_dettagli.Sa_Cod")
        stbQuery.AppendLine("And Mov_Dettaglio_Tecnico.Id_Agenda = Movimenti_dettagli.Id_Agenda")
        stbQuery.AppendLine("And Mov_Dettaglio_Tecnico.Id_Mov = Movimenti_dettagli.Id_Mov")
        stbQuery.AppendLine("ON Materie_Prime.Elem_Cod = Movimenti_dettagli.Elem_Cod")
        stbQuery.AppendLine("And Materie_Prime.Mat_Cod = Movimenti_dettagli.Mat_Cod")
        stbQuery.AppendLine("LEFT OUTER JOIN Fertilizzanti AS fertilizzanti")
        stbQuery.AppendLine("ON Movimenti_dettagli.Pro_Cod = fertilizzanti.Fer_Cod")
        stbQuery.AppendLine("LEFT OUTER JOIN SpecieVegetali")
        stbQuery.AppendLine("INNER JOIN Cultivar")
        stbQuery.AppendLine("ON SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod")
        stbQuery.AppendLine("ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod")
        stbQuery.AppendLine("INNER JOIN Centri_Aziendali")
        stbQuery.AppendLine("ON Centri_Aziendali.PIVA = Appezzamento.PIVA")
        stbQuery.AppendLine("And Centri_Aziendali.sa_cod = Appezzamento.SA_COD")
        stbQuery.AppendLine("LEFT OUTER JOIN Mov_Dettaglio_Tecnico AS Mov_Dettaglio_Tecnico_1")
        stbQuery.AppendLine("ON Movimenti.PIVA = Mov_Dettaglio_Tecnico_1.Piva")
        stbQuery.AppendLine("And Movimenti.Sa_Cod = Mov_Dettaglio_Tecnico_1.Sa_Cod")
        stbQuery.AppendLine("And Movimenti.Id_Agenda = Mov_Dettaglio_Tecnico_1.Id_Agenda")
        stbQuery.AppendLine("And Movimenti.Id_Mov = Mov_Dettaglio_Tecnico_1.Id_Mov")
        stbQuery.AppendLine("LEFT OUTER JOIN EpocheModalita")
        stbQuery.AppendLine("ON Movimenti.Extra_Int = EpocheModalita.EM_Cod")
        stbQuery.AppendLine("LEFT OUTER JOIN RicettexAgenda")
        stbQuery.AppendLine("ON Agenda.Id_Agenda = RicettexAgenda.Id_Agenda")
        stbQuery.AppendLine("LEFT OUTER JOIN AgendaxNote")
        stbQuery.AppendLine("ON Agenda.Id_Agenda = AgendaxNote.Id_Agenda")
        stbQuery.AppendLine("LEFT OUTER JOIN Note_Intervento")
        stbQuery.AppendLine("ON AgendaxNote.Nota_Cod = Note_Intervento.Nota_Cod  ")

        'Nr domanda ACA
        stbQuery.AppendLine(" LEFT JOIN (")
        If sql2017 Then
            stbQuery.AppendLine(" SELECT ipc.Piva, ipc.ProgettoCod, ipc.ContributoTipo,")
            stbQuery.AppendLine("        STRING_AGG(aca.ContributoDes, ', ') Nr_domanda_ACA")
            stbQuery.AppendLine(" FROM Imprese_ProgettiXContributi ipc")
            stbQuery.AppendLine(" JOIN  Contributi aca")
            stbQuery.AppendLine($" ON ipc.ContributoTipo = {CInt(ContributeType.ACA)}")
            stbQuery.AppendLine(" AND ipc.ContributoTipo = aca.Tipo")
            stbQuery.AppendLine(" AND ipc.ContributoCod = aca.ContributoCod")
            stbQuery.AppendLine(" GROUP BY ipc.Piva, ipc.ProgettoCod, ipc.ContributoTipo")
        Else
            stbQuery.AppendLine(" SELECT ipc_outer.Piva, ipc_outer.ProgettoCod, ipc_outer.ContributoTipo, ")
            stbQuery.AppendLine("        STUFF((SELECT ', ' + aca.ContributoDes FROM Imprese_ProgettiXContributi ipc")
            stbQuery.AppendLine("        INNER JOIN Contributi aca ON ipc.ContributoCod = aca.ContributoCod AND ipc.ContributoTipo = aca.Tipo ")
            stbQuery.AppendLine("        WHERE ipc.Piva = ipc_outer.Piva AND ipc.ProgettoCod = ipc_outer.ProgettoCod AND ipc.ContributoTipo = ipc_outer.ContributoTipo ")
            stbQuery.AppendLine("        FOR XML PATH('')), 1, 2, '') AS Nr_domanda_ACA")
            stbQuery.AppendLine(" FROM ")
            stbQuery.AppendLine($" (SELECT DISTINCT Piva, ProgettoCod, ContributoTipo FROM Imprese_ProgettiXContributi WHERE ContributoTipo = {CInt(ContributeType.ACA)}) ipc_outer")
        End If
        stbQuery.AppendLine(" ) CodiciACA")
        stbQuery.AppendLine(" ON Imprese_Progetti.Piva = CodiciACA.Piva")
        stbQuery.AppendLine(" AND Imprese_Progetti.Progetto_Cod = CodiciACA.ProgettoCod")

        'stbQuery.AppendLine("LEFT OUTER JOIN Reg_Impianti_Codici")
        'stbQuery.AppendLine("ON Reg_Impianti_Codici.PIVA = Imprese_Progetti.Piva")
        'stbQuery.AppendLine("AND Reg_Impianti_Codici.sa_cod = Imprese_Progetti.sa_cod")
        'stbQuery.AppendLine("AND Reg_Impianti_Codici.appezza = Imprese_Progetti.APPEZZA ")
        'stbQuery.AppendLine("AND Reg_Impianti_Codici.id_reg = Imprese_Progetti.ID_REG")
        'stbQuery.AppendLine("AND Reg_Impianti_Codici.Progetto_Cod = Imprese_Progetti.Progetto_Cod")
        'stbQuery.AppendLine($"AND Reg_Impianti_Codici.id_cod = {CInt(enum_CodiciAnagrafe.Impianto_Nr_domanda_ACA)}")
        'stbQuery.AppendLine("AND Imprese_Progetti.validita_inizio <= Agenda.Validita_Inizio")
        'stbQuery.AppendLine("AND Imprese_Progetti.validita_fine >= Agenda.Validita_Inizio")

        If IDTestataTemp <> 0 Then

            stbQuery.AppendLine("INNER JOIN __tmp_FiltroImpianti f ")
            stbQuery.AppendLine("ON Reg_Impianti.PIVA = f.piva  ")
            stbQuery.AppendLine("And Reg_Impianti.SA_COD = f.sa_cod ")
            stbQuery.AppendLine("And Reg_Impianti.APPEZZA = f.appezza ")
            stbQuery.AppendLine("And Reg_Impianti.ID_REG = f.id_reg ")
            stbQuery.AppendLine("And f.idTestataTemp = " & IDTestataTemp)
            stbQuery.AppendLine("And f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
