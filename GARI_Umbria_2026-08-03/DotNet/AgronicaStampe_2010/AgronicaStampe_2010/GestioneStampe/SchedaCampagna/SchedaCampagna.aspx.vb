            ReDim DefaultCopy(defaults.Length - 1)
            Array.Copy(defaults, DefaultCopy, defaults.Length)
        End If

        x = 0


        Dim swP As Stopwatch = StartWatch("CaricaDsRilievoProduzioneRaccoltaNEW")

        Try

            stbQ.Remove(0, stbQ.Length)

            stbQ.Append(" SELECT " & vbCrLf)
            stbQ.Append(" Agenda.Id_Agenda, Agenda.PIVA,  " & vbCrLf)
            stbQ.Append(" CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Agenda.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale, " & vbCrLf)
            stbQ.Append(" Agenda.Sa_Cod, Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG, " & vbCrLf)
            stbQ.Append(" Reg_Impianti.sup_imp, Mov_Destinazioni.Qta2 as sup_trattata,  " & vbCrLf)
            stbQ.Append(" Appezzamento.APP_NOME, " & vbCrLf)

            '27/11/2018 MAGA
            'veg_des e cul_des unificate e lette anche le destinazioni d'uso
            'stbQ.Append(" Cultivar.Cul_Des, " & vbCrLf)
            stbQ.Append(" Reg_Impianti.cul_cod, " & vbCrLf)
            stbQ.Append(" case when Reg_Impianti.cul_cod = 0 then " & vbCrLf)
            stbQ.Append("           ( ISNULL( (SELECT TOP 1 descrizione " & vbCrLf)
            stbQ.Append("                       FROM Reg_Impianti_Codici RIC " & vbCrLf)
            stbQ.Append("                       INNER JOIN Codici_Anagrafe Cod ON  RIC.id_cod= Cod.codice " & vbCrLf)
            stbQ.Append("                       where progetto_cod=0 " & vbCrLf)
            stbQ.Append("                       and id_cod >= 3000 and id_cod < 4000 " & vbCrLf)
            stbQ.Append("                       and piva=Reg_Impianti.piva and sa_cod=Reg_Impianti.sa_cod " & vbCrLf)
            stbQ.Append("                       and appezza= Reg_Impianti.appezza and id_reg=Reg_Impianti.id_reg " & vbCrLf)
            stbQ.Append("                       ), 'Terreno nudo')  )" & vbCrLf)
            stbQ.Append(" else  ( " & vbCrLf)
            stbQ.Append("       SELECT veg_des + ' ' +  cul_des " & vbCrLf)
            stbQ.Append("       FROM SpecieVegetali " & vbCrLf)
            stbQ.Append("       INNER JOIN Cultivar ON  SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod " & vbCrLf)
            stbQ.Append("       where Cultivar.Cul_Cod = Reg_Impianti.cul_cod " & vbCrLf)
            stbQ.Append("       ) " & vbCrLf)
            stbQ.Append("  end AS cul_des, " & vbCrLf)

            stbQ.Append(" UnitaMisura.UDM_SIM, Mov_Destinazioni.Qta, Movimenti_dettagli.Cal_Cod, '' AS CAL_DES, " & vbCrLf)

            'MODIFICA DEL 12/08/2014: il convert a varchar (fatto per togliere gli zeri nell'anteprima crystal)
            'provoca l'ordinamento alfabetico delle date invece che cronologico
            'introdotto nuovo campo data letto per l'ordinamento
            'MODIFICA DEL 31/01/2025: aggiunto il campo "Ora_Movimento" in lettura per popolare il report.
            stbQ.Append(" Movimenti.Data_Movimento AS Data_Movimento_Ordinamento, " & vbCrLf)
            stbQ.Append(" CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) AS Data_Movimento, " & vbCrLf)

            stbQ.Append(" ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici  " & vbCrLf)
            stbQ.Append("       where (Appezzamento_Codici.PIVA = Appezzamento.PIVA) " & vbCrLf)
            stbQ.Append("       and (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) " & vbCrLf)
            stbQ.Append("       and (Appezzamento_Codici.appezza = Appezzamento.appezza) " & vbCrLf)
            stbQ.Append("       and (Appezzamento_Codici.id_cod = 1104) ), '') AS App_Nome_Breve, " & vbCrLf)

            'campo_des
            stbQ.Append(" ISNULL(( SELECT top 1 Campi.Campo_Des " & vbCrLf)
            stbQ.Append(" FROM Campi " & vbCrLf)
            stbQ.Append(" WHERE Campi.Piva = Appezzamento.PIVA AND Campi.Sa_Cod = Appezzamento.SA_COD AND " & vbCrLf)
            stbQ.Append(" Campi.Campo_Cod = Appezzamento.Campo_Cod " & vbCrLf)
            stbQ.Append(" ),'') AS Campo_Nome, " & vbCrLf)

            stbQ.Append(" ISNULL((SELECT TOP 1 Imprese_Progetti.Progetto_Nome FROM Imprese_Progetti " & vbCrLf)
            stbQ.Append("       WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG  " & vbCrLf)

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            Else
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
            End If

            stbQ.Append(" 	     ORDER BY Imprese_Progetti.Validita_Inizio DESC ), '') AS Lotto, " & vbCrLf)

            'Note      
            'stbQ.Append(" ISNULL(Note_Intervento.Nota_Des,'') AS Nota_Des, " & vbCrLf)
