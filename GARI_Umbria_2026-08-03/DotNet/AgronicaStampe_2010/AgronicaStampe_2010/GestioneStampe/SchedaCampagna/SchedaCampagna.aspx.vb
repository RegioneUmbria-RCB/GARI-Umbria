    Private Sub AggiungiRigheVuote_Trattamenti(ByVal nRighe As Integer)

        Dim Riga As DS_Trattamenti2.DT_Trattamenti2Row
        Dim i As Integer
        Dim Anno As String
        Dim nRecords As Integer

        Anno = Ricava_Anno(Qs_DataStampa, Qs_DataInizio, Qs_DataFine)

        nRecords = DsTratta.DT_Trattamenti2.Select("Veg_Cod=0").Length

        If nRighe > nRecords Then
            For i = 0 To nRighe - nRecords - 1
                'Creo la nuova riga
                Riga = DsTratta.DT_Trattamenti2.NewDT_Trattamenti2Row

                Riga.Veg_Cod = 0
                Riga.Veg_Des = ""

                DsTratta.DT_Trattamenti2.Rows.Add(Riga)
            Next
        End If

    End Sub

