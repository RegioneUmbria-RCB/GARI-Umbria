    Private Sub LogoClienteCarica(ByRef LogoCliente() As Byte)

        Dim path As String = ""
        Dim objWebConfig As New AgronicaCoreGestioneRichieste.AgroWebConfig

        If objWebConfig.Path_Directory_Loghi_Cliente <> "" Then
            If objWebConfig.Path_Directory_Loghi_Cliente.EndsWith("\") = False Then
                objWebConfig.Path_Directory_Loghi_Cliente += "\"
            End If
            If System.IO.File.Exists(objWebConfig.Path_Directory_Loghi_Cliente & objParametri_Server.PivaSuperUser & "_Logo_SchedaCampagna.bmp") = True Then
                path = objWebConfig.Path_Directory_Loghi_Cliente & objParametri_Server.PivaSuperUser & "_Logo_SchedaCampagna.bmp"
            ElseIf System.IO.File.Exists(objWebConfig.Path_Directory_Loghi_Cliente & objParametri_Server.PivaSuperUser & "_Logo_SchedaCampagna.jpg") = True Then
                path = objWebConfig.Path_Directory_Loghi_Cliente & objParametri_Server.PivaSuperUser & "_Logo_SchedaCampagna.jpg"
            ElseIf System.IO.File.Exists(objWebConfig.Path_Directory_Loghi_Cliente & objParametri_Server.PivaSuperUser & "_Logo_SchedaCampagna.png") = True Then
                path = objWebConfig.Path_Directory_Loghi_Cliente & objParametri_Server.PivaSuperUser & "_Logo_SchedaCampagna.png"
            End If

            If System.IO.File.Exists(path) = True Then
                Dim bmpF As System.Drawing.Bitmap = New System.Drawing.Bitmap(path)
                Dim c As New System.Drawing.ImageConverter
                LogoCliente = c.ConvertTo(bmpF, GetType(Byte()))
            Else
                'di default inserisco un'immagine bianca come logo
                Dim bmpImg As System.Drawing.Bitmap = New System.Drawing.Bitmap(1, 1)
                bmpImg.SetPixel(0, 0, Drawing.Color.White)
                Dim cx As New System.Drawing.ImageConverter
                LogoCliente = cx.ConvertTo(bmpImg, GetType(Byte()))
            End If
        End If
    End Sub



    Private Function GetParametroStr(ByVal parametriExtra As String, ByVal toSeek As String, ByVal valDefault As String) As String

        Const nomeRoutine = "ParametriExtra.GetParametroStr"
        Dim parametro As String = ""

        Try
            Dim vPara As String() = parametriExtra.Split("|")

            Dim item As String = Array.Find(vPara, Function(x) x.StartsWith(toSeek & "="))

            If item IsNot Nothing Then
                parametro = item.Split("=")(1)
            ElseIf valDefault IsNot Nothing Then
                parametro = valDefault
            End If

        Catch ex As Exception
            Throw New Exception("[" & nomeRoutine & "] " & toSeek & " : " & ex.Message)
        End Try

        Return parametro
    End Function

