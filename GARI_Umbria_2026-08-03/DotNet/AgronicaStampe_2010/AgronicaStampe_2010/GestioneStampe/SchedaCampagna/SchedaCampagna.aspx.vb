                Dim strCodiciTerreno As String = ""

                Dim tecnicoImpresa As String = IIf(flag_mostra_TecnRif, ImpreseCodici_Read.TecnicoRiferimento_from_PIVA(Piva, objParametri_Server), "")

                '----------------------------------------------
