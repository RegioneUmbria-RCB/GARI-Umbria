            'Dim objParametriIngressoOLD As New AgronicaCoreMetaSchemaBIZ.FasiFenologiche_input
            'Dim objParametriUscitaOLD As AgronicaCoreMetaSchemaBIZ.FasiFenologiche_output
            'Dim objFasi_WS As New AgronicaCoreWebService.FasiFenologiche_WS

            'objParametriIngressoNEW.Veg_Cod = Veg_Cod
            'objParametriIngressoOLD.Veg_Cod = Veg_Cod
            'objParametriIngressoOLD.strOrdinamento = "Progressivo ASC"
            'Try
            '    objParametriUscitaNEW = objFasi_WS.FasiFenologiche(objParametriIngressoNEW)

            'Catch ex As Exception
            '    objParametriUscitaNEW = Nothing
            'End Try
            'Try
            '    objParametriUscitaOLD = objFasi_WS.FasiFenologiche_OLD(objParametriIngressoOLD)

            'Catch ex As Exception
            '    objParametriUscitaOLD = Nothing
            'End Try
#End Region

            For i = 0 To DsFasiFenologiche.FasiFenologiche.Rows.Count - 1

                DsFasiFenologiche.FasiFenologiche.Rows(i).Item("app_nome_breve") = CodiceAppezzamento(DsFasiFenologiche.FasiFenologiche.Rows(i).Item("piva"),
                                                                                                      DsFasiFenologiche.FasiFenologiche.Rows(i).Item("sa_cod"),
                                                                                                      DsFasiFenologiche.FasiFenologiche.Rows(i).Item("Campo_Nome"),
                                                                                                      DsFasiFenologiche.FasiFenologiche.Rows(i).Item("appezza"),
                                                                                                      TipoCodAppezzamento,
                                                                                                      DsFasiFenologiche.FasiFenologiche.Rows(i).Item("app_nome"),
                                                                                                      DsFasiFenologiche.FasiFenologiche.Rows(i).Item("app_nome_breve"), -1,
                                                                                                      lotto:=DsFasiFenologiche.FasiFenologiche.Rows(i).Item("Lotto"))
                '----------------------------------------------
                'per id consociazione

                If DsFasiFenologiche.FasiFenologiche.Rows(i).Item("ff_cod") <> 0 Then
                    If DsFasiFenologiche.FasiFenologiche.Rows(i).Item("ff_des") Is Nothing OrElse DsFasiFenologiche.FasiFenologiche.Rows(i).Item("ff_des").ToString.Trim = "" Then

                        DsFasiFenologiche.FasiFenologiche.Rows(i).Item("ff_des") = DsFasiFenologiche.FasiFenologiche.Rows(i).Item("FaseFenologicaDes")
#Region "LETTURA WS FASI RIMOSSA"
                        ''Prendo la descrizione dal WS Fasi fenologiche nuova gestione
