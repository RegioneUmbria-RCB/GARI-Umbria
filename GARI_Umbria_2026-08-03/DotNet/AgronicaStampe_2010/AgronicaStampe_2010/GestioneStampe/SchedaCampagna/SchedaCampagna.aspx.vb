    Private Sub StampaSchedaMultiSpecie()

        Dim Anno, Anno1, Anno2, Differenza As String
        'rptStampa_Multispecie.SetDataSource(DsErbacee)

        'modifica del 7 agosto 2014
        'rptStampa_Multispecie.OpenSubreport("Erbacee.rpt").SetDataSource(DsErbacee)
        rptStampa_Multispecie.OpenSubreport("Rpt_Erbacee.rpt").SetDataSource(DsErbacee)
        rptStampa_Multispecie.OpenSubreport("Rpt_Arboree.rpt").SetDataSource(DsArboree)
        rptStampa_Multispecie.OpenSubreport("Rpt_UsoNonAgricolo.rpt").SetDataSource(DsUsoNonAgricolo)
        rptStampa_Multispecie.OpenSubreport("Rpt_CentriAziendali.rpt").SetDataSource(DSCentri)
        rptStampa_Multispecie.OpenSubreport("Rpt_Patentino.rpt").SetDataSource(DSPatentino)
        rptStampa_Multispecie.OpenSubreport("Rpt_FasiFeno_Multi.rpt").SetDataSource(DsFasiFenologiche)
        rptStampa_Multispecie.OpenSubreport("Rpt_Trappole_Multi.rpt").SetDataSource(DsTrappola)
        rptStampa_Multispecie.OpenSubreport("Rpt_RilieviAvversitaTrappole_Multi.rpt").SetDataSource(DsRilievi)
        rptStampa_Multispecie.OpenSubreport("Rpt_RilieviAvversita_Verticale_Multi.rpt").SetDataSource(DsRilieviAvversitaAusiliari)
        rptStampa_Multispecie.OpenSubreport("Rpt_RilievoIndiciMaturita_Multi.rpt").SetDataSource(DsRilievoIndiciMaturita)
        rptStampa_Multispecie.OpenSubreport("Rpt_Visite_Verticale_Multi.rpt").SetDataSource(DSVisite)
        rptStampa_Multispecie.OpenSubreport("Rpt_TrattamentiPostRaccolta_Multi.rpt").SetDataSource(DsTrattaPostRaccolta)

        rptStampa_Multispecie.SetDataSource(DSLogo)

        'se ho scelto un giorno metto un solo anno
        If Qs_DataStampa <> "" Then
            Anno = CStr(Year(CDate(Qs_DataStampa)))
        Else
            'se ho scelto un intervallo..
            Anno1 = CStr(Year(Qs_DataInizio))
            Anno2 = CStr(Year(Qs_DataFine))

            Differenza = DateDiff(DateInterval.Year, CDate(Qs_DataInizio), CDate(Qs_DataFine))
            'metto un anno se l'intervallo è inferiore ad un anno
            If Differenza = 0 Then
                Anno = Anno1
            Else
                'altrimenti metto i due anni dell'intervallo
                Anno = Anno1 & " - " & Anno2
            End If
        End If

        Dim objImp As New AgronicaCoreAnagrafeDAL.Imprese_Read
        Dim pivaReale As String = objImp.Leggi_PivaReale(Piva, objParametri_Server)

        CType(rptStampa_Multispecie.Section1.ReportObjects("TextAnno"), CrystalDecisions.CrystalReports.Engine.TextObject).Text = Anno
        CType(rptStampa_Multispecie.Section3.ReportObjects("TextAnno2"), CrystalDecisions.CrystalReports.Engine.TextObject).Text = Anno
        CType(rptStampa_Multispecie.Section1.ReportObjects("TextPiva"), CrystalDecisions.CrystalReports.Engine.TextObject).Text = AgronicaCoreStampeDAL.Stampe_QDC.Pulisci_Piva_Fittizia(pivaReale)

        Dim DtImprese As DataTable
        Dim objImprese As New AgronicaCoreAnagrafeDAL.Imprese_Read
        '  Dim RagSoc As String = objImprese.RagSoc_from_Piva(Piva, objParametri_Server)

        DtImprese = objImprese.RecuperaDatiImpresa_From_Piva(Piva, "", Nothing,
                                                              AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                              "", "", objParametri_Server)

        If Not DtImprese Is Nothing AndAlso DtImprese.Rows.Count > 0 Then
            CType(rptStampa_Multispecie.Section1.ReportObjects("TextAzienda"), CrystalDecisions.CrystalReports.Engine.TextObject).Text = DtImprese.Rows(0).Item("rag_soc")
            CType(rptStampa_Multispecie.Section3.ReportObjects("TextAzienda2"), CrystalDecisions.CrystalReports.Engine.TextObject).Text = DtImprese.Rows(0).Item("rag_soc")
            CType(rptStampa_Multispecie.Section1.ReportObjects("TextIndirizzo"), CrystalDecisions.CrystalReports.Engine.TextObject).Text = DtImprese.Rows(0).Item("ind_des")
            CType(rptStampa_Multispecie.Section1.ReportObjects("TextComune"), CrystalDecisions.CrystalReports.Engine.TextObject).Text = DtImprese.Rows(0).Item("localita")
            CType(rptStampa_Multispecie.Section1.ReportObjects("TextCAP"), CrystalDecisions.CrystalReports.Engine.TextObject).Text = DtImprese.Rows(0).Item("CAP")
            CType(rptStampa_Multispecie.Section1.ReportObjects("TextProvincia"), CrystalDecisions.CrystalReports.Engine.TextObject).Text = DtImprese.Rows(0).Item("COMUNI_PROV")
            Select Case DtImprese.Rows(0).Item("COMUNI_PROV")
                Case "FC", "RA", "RN", "BO", "MO", "RE", "PR", "PC", "FE"
