    Private Function costruisciQueryVisiteNuova(ByVal NomeDBUtenti As String,
                                           ByVal Piva As String,
                                           ByVal Flag_Multicentro As Boolean,
                                           ByVal Sa_Cod As Integer,
                                           ByVal QS_DataStampa As String,
                                           ByVal Qs_DataInizio As String,
                                           ByVal Qs_DataFine As Date)

        Dim stb As New System.Text.StringBuilder

        stb.Length = 0
        stb.AppendLine(" SELECT DISTINCT Agenda.Piva , '' as Rag_Soc, Agenda.Sa_Cod, '' as Sa_Nome, Agenda.Id_Agenda,  Agenda.Lav_Cod , Agenda.Des_Lib AS Lav_Des,  ")
        stb.AppendLine(" Movimenti.Data_Movimento,convert(time,Movimenti.Ora, 8) as ora, Movimenti.Mov_Desc AS Note, movimenti_dettagli.mov_det_des AS note2, ")
        stb.AppendLine(" Movimenti.Cod_RisUm,  CASE Contatti.Id_CF WHEN 0 THEN ISNULL(Contatti.Cognome,'') + ' ' + ISNULL(Contatti.Nome,'') ELSE ISNULL(Contatti.Rag_Soc,'') END AS Tecnico, ")
        stb.AppendLine("agenda.username_creazione, UD.nome + ' ' + UD.cognome As utente ,")
        stb.AppendLine("'' AS Operazione ")
        stb.AppendLine(" FROM  Agenda  ")
        stb.AppendLine(" INNER JOIN Movimenti ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND Movimenti.Id_Agenda = Agenda.Id_Agenda ")
        stb.AppendLine(" INNER JOIN Movimenti_dettagli ON Movimenti.PIVA = Movimenti_dettagli.PIVA AND Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda AND Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov  ")
        stb.AppendLine(" LEFT OUTER JOIN   Risorse_Umane   ON Risorse_Umane.Cod_RisUm = Movimenti.Cod_RisUm  ")
        stb.AppendLine(" LEFT OUTER JOIN Contatti ON  Contatti.piva = Risorse_Umane.piva AND Contatti.Cod_Contatto = Risorse_Umane.Cod_Contatto ")
        stb.AppendLine(" INNER JOIN " & NomeDBUtenti & ".dbo.Utenti_Dettagli UD on  UD.CodFisc = agenda.username_Creazione ")
        stb.AppendLine(" WHERE Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")
        stb.AppendLine(" AND Agenda.Lav_Cod = " & LAVCOD_ALTRE_OPERAZIONI.ToString)
        If Not Flag_Multicentro Then
            stb.AppendLine(" AND (Agenda.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " OR Agenda.Sa_Cod = 0) ")
        End If
        'se ho scelto una data unica per la stampa..
        If QS_DataStampa <> "" Then
            stb.AppendLine(" AND Movimenti.Data_Movimento = " & Agro_SQL_SaveDate(CDate(QS_DataStampa)) & " ")
        Else
            stb.AppendLine(" AND Movimenti.Data_Movimento <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stb.AppendLine(" AND Movimenti.Data_Movimento >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")
        End If
        stb.AppendLine(" AND EXISTS ( ")
        stb.AppendLine("               SELECT 1 ")
        stb.AppendLine("               FROM Mov_Dettagli_Riferimenti ")
        stb.AppendLine("               WHERE Mov_Dettagli_Riferimenti.lav_cod_rif = Agenda.lav_cod ")
        stb.AppendLine("               AND Mov_Dettagli_Riferimenti.piva_rif = Agenda.piva ")
        stb.AppendLine("               AND Mov_Dettagli_Riferimenti.id_agenda_rif = Agenda.id_agenda ")
        stb.AppendLine("               AND Mov_Dettagli_Riferimenti.lav_cod = " & LAVCOD_VISITA.ToString)
        stb.AppendLine("               ) ")

        Return stb
    End Function

    Private Function costruisciQueryVisiteNuovaConSpecie(ByVal Piva As String,
                                                         ByVal Qs_DataInizio As String,
                                                         ByVal Qs_DataFine As String,
                                                         ByVal Veg_Cod As String,
                                                         ByVal Id_Cod As String)

        Dim stb As New System.Text.StringBuilder

        stb.Length = 0
        stb.AppendLine(" SELECT DISTINCT ")
        stb.AppendLine("agenda.Piva, ")
        stb.AppendLine("i.rag_soc, ")
        stb.AppendLine("agenda.Sa_Cod, ")
        stb.AppendLine("CASE agenda.Sa_Cod WHEN -1 THEN '' ELSE ca.Sa_Nome END AS 'Sa_Nome', ")
        stb.AppendLine("agenda.Id_Agenda, ")
        stb.AppendLine("agenda.Lav_Cod,")
        stb.AppendLine("agenda.Des_Lib AS Lav_Des,")
        stb.AppendLine("Mov_Destinazioni.Data_Movimento,")
        stb.AppendLine("RIGHT('0' + CAST(DATEPART(hh,Mov_Destinazioni.Ora) AS varchar),2) + ':' + RIGHT('0' + CAST(DATEPART(mi,Mov_Destinazioni.Ora) AS varchar),2) AS Ora_Movimento, ")
        stb.AppendLine("Mov_Destinazioni.Mov_Desc as Note,")
        stb.AppendLine("md.Mov_Det_Des AS note2, ")
        stb.AppendLine("0,")
        stb.AppendLine("c.Cognome + ' ' + c.Nome AS Tecnico, ")
        stb.AppendLine("agenda.username_creazione, ")
        stb.AppendLine("'' As utente , ")
        stb.AppendLine("ISNULL(att.[Desc], o.LAV_DES) AS Operazione ")

        stb.AppendLine("FROM Agenda agenda ")
        stb.AppendLine("INNER JOIN Movimenti Mov_Destinazioni ON agenda.PIVA = Mov_Destinazioni.PIVA AND agenda.Sa_Cod = Mov_Destinazioni.Sa_Cod AND agenda.Id_Agenda = Mov_Destinazioni.Id_Agenda AND Mov_Destinazioni.Cau_Mov <> '6852' ")
        stb.AppendLine("LEFT JOIN Movimenti_dettagli md ON Mov_Destinazioni.PIVA = md.PIVA And Mov_Destinazioni.Id_Agenda = md.Id_Agenda AND Mov_Destinazioni.Id_mov = md.Id_mov ")
        stb.AppendLine("INNER JOIN Operazioni o ON o.lav_cod = agenda.Lav_Cod ")
        stb.AppendLine("LEFT  JOIN Attivita att ON att.id_attivita = agenda.id_attivita ")
        stb.AppendLine("INNER JOIN Imprese i ON i.PIVA = agenda.PIVA ")
        stb.AppendLine("LEFT  JOIN Centri_Aziendali ca ON ca.PIVA = agenda.PIVA AND ca.sa_cod = agenda.sa_cod ")
        stb.AppendLine("INNER JOIN Movimenti m_assegnatario ON m_assegnatario.Piva=agenda.Piva AND m_assegnatario.Sa_Cod=agenda.Sa_Cod AND m_assegnatario.id_Agenda=agenda.id_Agenda AND m_assegnatario.Cau_Mov='6852' ")
        stb.AppendLine("INNER JOIN Movimenti_dettagli md_assegnatario ON m_assegnatario.Piva=md_assegnatario.Piva AND m_assegnatario.Sa_Cod=md_assegnatario.Sa_Cod AND m_assegnatario.id_Agenda=md_assegnatario.id_Agenda AND m_assegnatario.id_mov=md_assegnatario.id_mov ")
        stb.AppendLine("INNER JOIN Risorse_Umane ru ON ru.Cod_RisUm = md_assegnatario.mat_cod ")
        stb.AppendLine("INNER JOIN Contatti c ON c.Cod_Contatto = ru.Cod_Contatto AND c.Piva = ru.Piva ")
        stb.AppendLine("LEFT OUTER JOIN Mov_Destinazioni mdest ON agenda.Piva = mdest.Piva AND agenda.id_Agenda = mdest.Id_Agenda And mdest.Sa_Cod = agenda.Sa_Cod and md.id_mov = mdest.id_mov and md.Id_Mov_Det = mdest.Id_Mov_Det and mdest.Tipo_Destinazione = 0 ")
        stb.AppendLine("LEFT OUTER JOIN Reg_Impianti ON Reg_Impianti.PIVA = mdest.Piva AND Reg_Impianti.SA_COD = mdest.Sa_Cod AND Reg_Impianti.APPEZZA = mdest.Appezza AND Reg_Impianti.ID_REG = mdest.Id_Destinazione ")
        stb.AppendLine("LEFT OUTER JOIN Reg_Impianti_Codici ric ON ric.PIVA = mdest.Piva AND ric.SA_COD = mdest.Sa_Cod AND ric.APPEZZA = mdest.Appezza AND ric.ID_REG = mdest.Id_Destinazione AND ric.id_cod between 3000 and 3999 ")
        stb.AppendLine("LEFT OUTER JOIN Appezzamento ON Reg_Impianti.PIVA = Appezzamento.Piva AND Reg_Impianti.SA_COD = Appezzamento.Sa_Cod AND Reg_Impianti.APPEZZA = Appezzamento.Appezza ")
        stb.AppendLine("LEFT OUTER JOIN Cultivar on Reg_Impianti.CUL_COD = Cultivar.Cul_Cod ")
        stb.AppendLine("LEFT OUTER JOIN SpecieVegetali on ((md.Dettaglio_VegCod <> 0 AND SpecieVegetali.Veg_Cod = md.Dettaglio_VegCod) OR SpecieVegetali.Veg_Cod = Cultivar.veg_cod) ")
        stb.AppendLine("LEFT OUTER JOIN Codici_Anagrafe on ((md.Dettaglio_IdCod <> 0 AND Codici_Anagrafe.codice = md.Dettaglio_IdCod) OR Codici_Anagrafe.codice = ric.id_cod) ")
        stb.AppendLine("WHERE agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")
        stb.AppendLine("AND agenda.Lav_Cod = 5007 ")
        stb.AppendLine("AND Mov_Destinazioni.Data_Movimento between " + Agro_SQL_SaveDate(Qs_DataInizio) + " AND " + Agro_SQL_SaveDate(Qs_DataFine) + " ")

        If Veg_Cod <> "" AndAlso Veg_Cod <> "0" Then
            stb.AppendLine(" AND SpecieVegetali.Veg_Cod = " & Agro_SQL_SaveNum(Veg_Cod) & " ")
        End If

        If Id_Cod <> "" AndAlso Id_Cod <> "0" Then
            stb.AppendLine(" AND Codici_Anagrafe.codice = " & Agro_SQL_SaveNum(Id_Cod) & " ")
        End If

        Return stb
    End Function


