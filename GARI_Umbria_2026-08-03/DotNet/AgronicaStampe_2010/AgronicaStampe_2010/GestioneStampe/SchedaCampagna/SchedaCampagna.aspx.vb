    Private Sub CaricaDsDichiarazioni(ByVal Flag_Multispecie As Boolean,
                                      ByVal Flag_Multicentro As Boolean,
                                      Optional ByVal NonUtilizzo_Nessuno0_Fito1_Ferti2_Tutti3 As Integer = 0)

        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String
        Dim stbQ As New System.Text.StringBuilder


        Dim sw As Stopwatch = StartWatch("CaricaDsDichiarazioni")

        Try

            'Agenda.Validita_Inizio 
            stbQ.AppendLine(" SELECT Agenda.PIVA, Agenda.Sa_Cod, Agenda.Id_Agenda, Agenda.Lav_Cod, Agenda.des_lib, CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) As Data_Movimento, Centri_Aziendali.Sa_Nome, ")
            stbQ.AppendLine(" CONVERT(varchar, Agenda.Data_Creazione, 103) AS Data_Registrazione, a.APP_NOME, COALESCE(sv.Veg_Des, Codici_Anagrafe.descrizione) As SpecieDestUso, ")

            stbQ.Append(" ISNULL((SELECT TOP 1 Imprese_Progetti.Progetto_Nome FROM Imprese_Progetti " & vbCrLf)
            stbQ.Append("       WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
