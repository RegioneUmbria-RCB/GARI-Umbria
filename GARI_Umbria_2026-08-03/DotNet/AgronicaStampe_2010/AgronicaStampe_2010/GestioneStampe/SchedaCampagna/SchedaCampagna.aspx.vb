        stbQ.Append(" -- legge LAVCOD_MANUTENZIONE_MACCHINE e LAVCOD_REVISIONE_MACCHINE " & vbCrLf)
        stbQ.Append(" SELECT parco_macchine.mac_cod, Agenda.Lav_Cod, agenda.Validita_Inizio as data, Movimenti.Scadenza, " & vbCrLf)
        stbQ.Append("  Operazioni.LAV_DES as operazione, " & vbCrLf)
        stbQ.Append("  Macchine.CLASS_DESC, Parco_Macchine.Mac_Des, Parco_Macchine.note, Movimenti.Doc_Numero,   " & vbCrLf)
        stbQ.Append("  Contatti.Rag_Soc, Contatti.Cognome, Contatti.Nome,   " & vbCrLf)

