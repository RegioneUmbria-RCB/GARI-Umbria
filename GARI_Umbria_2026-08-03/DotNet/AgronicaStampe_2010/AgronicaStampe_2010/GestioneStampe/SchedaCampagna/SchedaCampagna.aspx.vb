                    stbQ.Append(" AND (SpecieVegetali.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) ")
                End If
            End If
        End If


        stbQ.Append(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

        If Not Flag_Multicentro Then
            stbQ.Append(" AND Agenda.sa_cod = " & Sa_Cod & " ")
        End If


        'If strAppezza <> "" And strId_Reg <> "" Then
        '    stbQ.Append(" AND Reg_Impianti.APPEZZA IN (" & strAppezza & ") ")
        '    stbQ.Append(" AND Reg_Impianti.ID_REG IN (" & strId_Reg & ") ")
        'End If

