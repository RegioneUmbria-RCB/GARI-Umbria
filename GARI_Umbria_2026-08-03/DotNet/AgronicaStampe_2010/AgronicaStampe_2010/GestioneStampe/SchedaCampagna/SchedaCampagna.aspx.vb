                                                    End If
                                                End If
                                            End If

                                        End If

                                        Num_Operatori += 1

                                    Else
                                        'CAU_IMPUTAZIONE_TECNICO_RESPONSABILE
                                        strResponsabili &= nomeContatto & ","

                                        Num_Responsabili += 1

                                    End If

                                Else
                                    'è un record macchinario
                                    strMacchine += DtTemp.Rows(j).Item("CLASS_DESC")

                                    If DtTemp.Rows(j).Item("Modello") <> "" Then
                                        strMacchine += " - Modello " & DtTemp.Rows(j).Item("Modello")
                                    End If

                                    If DtTemp.Rows(j).Item("Ditta_Des") <> "" Then
                                        strMacchine += " - Marca " & DtTemp.Rows(j).Item("Ditta_Des")
                                    End If

                                    If Flag_Nasc_DataUltMan = False AndAlso DtTemp.Rows(j).Item("Ultima_Manutenzione") <> "01/01/1900" Then
                                        strMacchine += " - Ultima Manutenzione " & DtTemp.Rows(j).Item("Ultima_Manutenzione")
                                    End If

                                    strMacchine += ","

                                    'If DtTemp.Rows(j).Item("Modello") <> "" And DtTemp.Rows(j).Item("Ultima_Manutenzione") <> "01/01/1900" Then
                                    '    strMacchine += DtTemp.Rows(j).Item("CLASS_DESC") & " (Modello " + DtTemp.Rows(j).Item("Modello")

                                    '    If Not Flag_Nasc_DataUltMan Then
                                    '        strMacchine &= "; Ultima Manutenzione " & DtTemp.Rows(j).Item("Ultima_Manutenzione") & "),"
                                    '    Else
                                    '        strMacchine &= "),"
                                    '    End If

                                    'ElseIf DtTemp.Rows(j).Item("Modello") <> "" And DtTemp.Rows(j).Item("Ultima_Manutenzione") = "01/01/1900" Then
                                    '    strMacchine &= DtTemp.Rows(j).Item("CLASS_DESC") & " (Modello " + DtTemp.Rows(j).Item("Modello") & "),"
                                    'ElseIf DtTemp.Rows(j).Item("Modello") = "" And DtTemp.Rows(j).Item("Ultima_Manutenzione") <> "01/01/1900" Then

                                    '    strMacchine &= DtTemp.Rows(j).Item("CLASS_DESC")

                                    '    If Not Flag_Nasc_DataUltMan Then
                                    '        strMacchine &= " (Ultima Manutenzione " & DtTemp.Rows(j).Item("Ultima_Manutenzione") & "),"
                                    '    Else
                                    '        strMacchine &= "),"
                                    '    End If

                                    'ElseIf DtTemp.Rows(j).Item("Modello") = "" And DtTemp.Rows(j).Item("Ultima_Manutenzione") = "01/01/1900" Then
                                    '    strMacchine &= DtTemp.Rows(j).Item("CLASS_DESC") & ","
                                    'End If

                                    Num_Macchine += 1

                                End If

                            Next

                        End If 'dt costi accessori

                        If Num_Responsabili > 0 AndAlso Not Flag_Nasc_Resp Then
                            strCosti1 = "Autorizzato da : " & Left(strResponsabili, strResponsabili.Length - 1)

                            'If Not Flag_Nasc_DataFirma Then
                            '    If Trim(strCosti1) <> "" Then
                            '        strCosti1 &= vbCrLf & "Firma ___________"
                            '    Else
                            '        strCosti1 = "Firma ___________"
                            '    End If
                            'Else
                            '    strCosti1 &= vbCrLf
                            'End If

                        End If

                        'flagDataFirma = False

                        If (Num_Operatori > 0 AndAlso Not Flag_Nasc_Oper) Then

                            If Trim(strCosti1) <> "" Then
                                strCosti1 = String.Format("{0}{1}Eseguito da : {2}", strCosti1, vbCrLf, Left(strOperatori, strOperatori.Length - 1))
                            Else
                                strCosti1 = String.Format("Eseguito da : {0}", Left(strOperatori, strOperatori.Length - 1))
                            End If
                            'flagDataFirma = True

                        End If

                        If (Num_Macchine > 0 AndAlso Not Flag_Nasc_Macc) Then

                            If Trim(strCosti) <> "" Then
                                strCosti = String.Format("{0}{1}Eseguito con : {2}", strCosti, vbCrLf, Left(strMacchine, strMacchine.Length - 1))
                            Else
                                strCosti = String.Format("Eseguito con : {0}", Left(strMacchine, strMacchine.Length - 1))
                            End If

                        End If

                        If flagDataFirma AndAlso Not Flag_Nasc_DataFirma Then
                            If Trim(strCosti1) <> "" Then
                                strCosti1 &= vbCrLf & "Firma Terzista ___________"
                            Else
                                strCosti1 = "Firma Terzista ___________"
                            End If
                        End If

                        If Trim(strCosti) <> "" Then
                            If Trim(strTot) <> "" Then
                                strTot &= vbCrLf & strCosti
                            Else
                                strTot = strCosti
                            End If
                        End If


                        '''''''''''''''''''''''''''''''''''''''''''''''
                        ''' FINE ricetta Cod ''''''''''''''''''''''''''
                        '''''''''''''''''''''''''''''''''''''''''''''''

                        drConcLav(0).costi_accessori = strTot
                        drConcLav(0).costi_accessori1 = strCosti1

                    End If 'verifica report
                    '(     If TipoReport = enum_TipoReport.SchedaCampagna_Multi Or _
                    '    TipoReport = enum_TipoReport.RegistroTrattamenti_VenetoUnico Or _
                    '    TipoReport = enum_TipoReport.RegistroTrattamenti_Veneto Or _
                    '    TipoReport = enum_TipoReport.SchedaCampagna_Multicentro Or _
                    '    TipoReport = enum_TipoReport.Eurep_Gap_Multicentro Or _
                    '    TipoReport = enum_TipoReport.Prov_Aut_Trento Then)

                    'se la query è stata eseguita sopra è inutile rifarla
                    If IsNothing(DtTemp) Then
                        DtTemp = objCostiAccessori.CostiAccessori_from_IdAgenda2(Piva, CInt(strId_Agenda(i)), drConcLav(0).Data_Movimento, drConcLav(0).Data_Movimento, "", "", objParametri_Server)
                    End If
                    If Not DtTemp Is Nothing AndAlso DtTemp.Rows.Count > 0 Then
                        For j = 0 To DtTemp.Rows.Count - 1
                            key_pat = CStr(DtTemp.Rows(j).Item("Cod_RisUm")) & "|" & DtTemp.Rows(j).Item("Patentino")
                            If Not Hash_Patentino.ContainsKey(key_pat) AndAlso DtTemp.Rows(j).Item("Patentino") <> "" Then
                                Hash_Patentino.Add(key_pat, 0)
                                CaricaDsPatentinoRow(DtTemp.Rows(j))
                            End If
                        Next

                    End If

                    DtTemp = Nothing

                    'calcolo la somma delle superfici delgli appezzamenti
                    'poichè ho le avversita in questo caso in select distinct..
                    'le sup_app sono ripetute + volte per ogni appezzamento
                    'x questo faccio le select su ogni appezzamento
                    'se è un padre devo sommare le superfici dei figli selezionati

                    strAppezzamenti = ""
                    Sup_Tot = 0.0
                    Sup_TrattataTot = 0.0


                    Dim drMatCod() As DS_TrattamentiPost.DT_TrattamentiPostRow = ds.DT_TrattamentiPost.Select("id_agenda=" & strId_Agenda(i) & " AND Mat_Cod<>0 AND Elem_Cod IN (201,210)")

                    If drMatCod.Length > 0 Then
                        For s = 0 To drMatCod.Length - 1
                            If Not Hash_MatCod.ContainsKey(drMatCod(s).Cod_Progetto) Then
                                Hash_MatCod.Add(drMatCod(s).Cod_Progetto, "")
                                Sup_TrattataTot += CDec(drMatCod(s).Qta)
                            End If
                        Next
                    End If

                    'trasformo in quintali
                    If Sup_TrattataTot > 0 Then
                        Sup_TrattataTot = Sup_TrattataTot / 100
                    End If
                    Sup_TrattataTot_Operazione = Sup_TrattataTot

                    '   '07/11/2018: fabri ha deliberato di arrotondare a 4 fino alle centiare
                    'drConcLav(0).Sup_Trattata = CStr(Math.Round(Sup_TrattataTot, 3)) 'Sup_TrattataTot
                    drConcLav(0).Sup_Trattata = CStr(AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(Sup_TrattataTot, 4))

                    '--------------------------------------------------------------
                    'ACQUA
                    '--------------------------------------------------------------
                    drAcqua = ds.DT_TrattamentiPost.Select("id_agenda=" & strId_Agenda(i) & " And qta_ril<>0")

                    If Not drAcqua Is Nothing And drAcqua.Length > 0 Then

                        'se l'acqua è negativa è stata inserita /q
                        'allora la moltiplico x la sup
                        If CDec(drAcqua(0).Qta_Ril) < 0 Then

                            Acqua = Math.Abs(CDec(drAcqua(0).Qta_Ril)) * Sup_TrattataTot

                            If Not Session("VisualizzaAcquaHa") Is Nothing Then

                                If Session("VisualizzaAcquaHa") = True Then

                                    strAcqua = Format(Math.Abs(CDec(drAcqua(0).Qta_Ril)), "0.00").ToString & "/Ha"

                                    strAcqua = Format(Math.Abs(CDec(drAcqua(0).Qta_Ril)), "0.00").ToString & "/Ha"

                                Else
                                    strAcqua = Acqua.ToString
                                End If

                            End If

                        Else

                            'se l'acqua è positiva è stata TOTALE
                            'allora la fraziono sulla superficie scelta x la stampa
                            'If Sup_Tot_Operazione = 0 Then
                            If Sup_TrattataTot_Operazione = 0 Then

                                Dim objMovDest As New AgronicaCoreContabDAL.Mov_Destinazioni_R

                                Sup_TrattataTot_Operazione = objMovDest.SupTotTrattata_from_IdAgenda2(CInt(drAcqua(0).id_agenda), "", objParametri_Server)
                                If Sup_TrattataTot_Operazione = 0 Then
                                    Sup_TrattataTot_Operazione = objMovDest.SupTot_from_IdAgenda2(CInt(drAcqua(0).id_agenda), "", objParametri_Server)
                                End If

                                objMovDest = Nothing

                                Acqua = drAcqua(0).Qta_Ril * (Sup_TrattataTot / Sup_TrattataTot_Operazione)

                            End If

                            If Not Session("VisualizzaAcquaHa") Is Nothing Then

                                If Session("VisualizzaAcquaHa") = True Then
                                    strAcqua = Format(CDec(Acqua / Sup_TrattataTot_Operazione), "0.00").ToString & "/Ha"
                                Else
                                    strAcqua = Acqua.ToString
                                End If

                            End If


                        End If


                    Else
                        strAcqua = "0"
                    End If


                    'Controllo se devo arrotondare l'acqua all'intero superiore
                    If Flag_Arr_Acqua Then

                        If IsNumeric(strAcqua) Then
                            AcquaNoRound = CDec(strAcqua)

                            'Se l'acqua non è intera la arrotondo
                            If AcquaNoRound - Int(AcquaNoRound) > 0 Then
                                strAcqua = (Int(AcquaNoRound) + 1).ToString()
                            End If
                        End If


                    End If


                    '--------------------------------------------------------------
                    'PRODOTTI
                    '--------------------------------------------------------------

                    'Prodotti (escludo i mat_cod)
                    drPro = dtApp.Select("id_agenda=" & strId_Agenda(i) & " AND elem_cod=191 ", "pro_cod")

                    Avversita = ""
                    GruppoAvversita = ""
                    strPriAtt = ""

                    Dim nRighe As Integer = 0
                    Dim Av_Cod As Integer
                    Dim Pro_Cod As Integer
                    Dim Av_Gru As Integer



                    If Not drPro Is Nothing AndAlso drPro.Length <> 0 Then

                        Pro_Cod = 0

                        For c = 0 To drPro.Length - 1

                            Avversita = ""
                            GruppoAvversita = ""
                            Av_Cod = 0
                            Av_Gru = 0

                            '09/09/2013 per vedere acqua e carenza anche su altre righe
                            'Dim acquaOld As decimal = 0.0
                            'Dim strAcquaold As String = ""
                            'Dim strCarenza As String = "0"
                            'Dim strDataPrimaRacc As String = ""
                            'acquaOld = 0.0
                            'strAcquaold = ""
                            'strCarenza = "0"
                            'strDataPrimaRacc = ""


                            If Pro_Cod <> drPro(c).Pro_Cod Then

                                Pro_Cod = drPro(c).Pro_Cod

                                '------------------------------------------
                                'CASO VECCHIO SENZA DPI
                                'CASO NUOVO CON NESSUN FILTRO PRODOTTI
                                'I prodotti non sono legati alle avversità
                                '(estraggo perciò le avversità solo la prima volta
                                'e le indico solo nella prima riga)
                                '------------------------------------------
                                If drConcLav(0).Num_Protocollo = 0 Then

                                    If nRighe = 0 Then

                                        'reperisco le avversità relative a tutta l'operazione ..
                                        drAvv = dtApp.Select("id_agenda=" & strId_Agenda(i) &
                                                            " AND av_cod <> 0 AND qta_ril=0 " &
                                                            " AND Id_Mov_Det_Tecnico = 0 ", "av_cod")

                                        'reperisco i gruppi avversità relativi a tutta l'operazione ..
                                        drAvvGru = dtApp.Select("id_agenda=" & strId_Agenda(i) &
                                                                " AND av_gru <> 0 AND qta_ril=0 " &
                                                                " AND Id_Mov_Det_Tecnico = 0 ", "av_gru")

                                        If Not drAvv Is Nothing AndAlso drAvv.Length <> 0 Then
                                            For y = 0 To drAvv.Length - 1
                                                If drAvv(y).av_cod = -1 AndAlso drConcLav(y).LAV_COD = 116 Then
                                                    'distribuzione insertti senza avversita, 
                                                    'IMPOLLINAZIONE
                                                    Avversita += "PER IMPOLLINAZIONE, NESSUNA AVVERSITA'" + ", "
                                                    Exit For
                                                End If
                                                If Av_Cod <> drAvv(y).av_cod Then
                                                    Av_Cod = drAvv(y).av_cod
                                                    Avversita += drAvv(y).av_des_vol + ", "
                                                End If
                                            Next
                                            If Avversita <> "" Then
                                                Avversita = Left(Avversita, Avversita.Length - 2)
                                            End If
                                        End If

                                        If Not drAvvGru Is Nothing AndAlso drAvvGru.Length <> 0 Then
                                            For y = 0 To drAvvGru.Length - 1
                                                If Av_Gru <> drAvvGru(y).av_gru Then
                                                    Av_Gru = drAvvGru(y).av_gru
                                                    GruppoAvversita += drAvvGru(y).av_gru_des + ", "
                                                End If
                                            Next
                                            If GruppoAvversita <> "" Then
                                                GruppoAvversita = Left(GruppoAvversita, GruppoAvversita.Length - 2)
                                            End If
                                        End If

                                        If Avversita <> "" And GruppoAvversita <> "" Then
                                            drConcLav(nRighe).avv_elenco = Avversita + ", " + GruppoAvversita
                                        ElseIf Avversita <> "" And GruppoAvversita = "" Then
                                            drConcLav(nRighe).avv_elenco = Avversita
                                        ElseIf Avversita = "" And GruppoAvversita <> "" Then
                                            drConcLav(nRighe).avv_elenco = GruppoAvversita
                                        End If

                                    Else

                                        drConcLav(nRighe).avv_elenco = ""

                                    End If

                                Else

                                    '--------------------------------------
                                    'DISCIPLINARE
                                    'CASO NUOVO CON ETICHETTE
                                    'I prodotti sono legati alle avversità
                                    '(estraggo le avversità per ogni riga)
                                    '--------------------------------------

                                    'reperisco le avversità relative al formulato corrente..
                                    drAvv = dtApp.Select("id_agenda=" & strId_Agenda(i) &
                                                        " AND av_cod <> 0 AND qta_ril=0 " &
                                                        " AND Id_Mov_Det_Tecnico = Id_Mov_Det_Dettagli " &
                                                        " AND pro_cod=" & drPro(c).Pro_Cod, "av_cod")

                                    'reperisco i gruppi avversità relativi al formulato corrente..
                                    drAvvGru = dtApp.Select("id_agenda=" & strId_Agenda(i) &
                                                            " AND av_gru <> 0 AND qta_ril=0 " &
                                                            " AND Id_Mov_Det_Tecnico = Id_Mov_Det_Dettagli " &
                                                            " AND pro_cod=" & drPro(c).Pro_Cod, "av_gru")



                                    If Not drAvv Is Nothing AndAlso drAvv.Length <> 0 Then
                                        For y = 0 To drAvv.Length - 1
                                            If Av_Cod <> drAvv(y).av_cod Then
                                                Av_Cod = drAvv(y).av_cod
                                                Avversita += drAvv(y).av_des_vol + ", "
                                            End If
                                        Next
                                        If Avversita <> "" Then
                                            Avversita = Left(Avversita, Avversita.Length - 2)
                                        End If
                                    End If

                                    If Not drAvvGru Is Nothing AndAlso drAvvGru.Length <> 0 Then
                                        For y = 0 To drAvvGru.Length - 1
                                            If Av_Gru <> drAvvGru(y).av_gru Then
                                                Av_Gru = drAvvGru(y).av_gru
                                                GruppoAvversita += drAvvGru(y).av_gru_des + ", "
                                            End If
                                        Next
                                        If GruppoAvversita <> "" Then
                                            GruppoAvversita = Left(GruppoAvversita, GruppoAvversita.Length - 2)
                                        End If
                                    End If

                                    If Avversita <> "" And GruppoAvversita <> "" Then
                                        drConcLav(nRighe).avv_elenco = Avversita + ", " + GruppoAvversita
                                    ElseIf Avversita <> "" And GruppoAvversita = "" Then
                                        drConcLav(nRighe).avv_elenco = Avversita
                                    ElseIf Avversita = "" And GruppoAvversita <> "" Then
                                        drConcLav(nRighe).avv_elenco = GruppoAvversita
                                    End If

                                End If

                                drConcLav(nRighe).Qta_Ril = Acqua
                                drConcLav(nRighe).Acqua = strAcqua

                                drConcLav(nRighe).carenza = drPro(c).carenza

                                ''09/09/2013 per vedere acqua e carenza anche su altre righe
                                'acquaOld = Acqua
                                'strAcquaold = strAcqua


                                Select Case drPro(c).Elem_Cod

                                    Case 191 'FORMULATI

                                        drConcLav(nRighe).FR_DES = drPro(c).FR_DES & " (" & drPro(c).Pro_Cod & ")"


                                        'trasformo la dose salvata in kg o l
                                        Select Case CInt(drPro(c).Extra_Int)
                                            Case enum_UnitaMisura.KG 'kg
                                                drConcLav(nRighe).Qta = drPro(c).Qta
                                                drConcLav(nRighe).UDM_DES = " kg"
                                            Case enum_UnitaMisura.Grammi  'g
                                                drConcLav(nRighe).Qta = drPro(c).Qta / 1000
                                                drConcLav(nRighe).UDM_DES = " kg"
                                            Case enum_UnitaMisura.Milligrammi  'mg
                                                drConcLav(nRighe).Qta = drPro(c).Qta / 1000000
                                                drConcLav(nRighe).UDM_DES = " kg"
                                            Case enum_UnitaMisura.Quintali  'q
                                                drConcLav(nRighe).Qta = drPro(c).Qta * 100
                                                drConcLav(nRighe).UDM_DES = " kg"
                                            Case enum_UnitaMisura.Litri 'l
                                                drConcLav(nRighe).Qta = drPro(c).Qta
                                                drConcLav(nRighe).UDM_DES = " l"
                                            Case enum_UnitaMisura.Tonnellate  't
                                                drConcLav(nRighe).Qta = drPro(c).Qta * 1000
                                                drConcLav(nRighe).UDM_DES = " kg"
                                            Case enum_UnitaMisura.CentimetriCubi  'cc
                                                drConcLav(nRighe).Qta = drPro(c).Qta / 1000
                                                drConcLav(nRighe).UDM_DES = " l"
                                            Case enum_UnitaMisura.Millilitri  'ml
                                                drConcLav(nRighe).Qta = drPro(c).Qta / 1000
                                                drConcLav(nRighe).UDM_DES = " l"
                                            Case enum_UnitaMisura.Metri_Cubi  'mc
                                                drConcLav(nRighe).Qta = drPro(c).Qta * 1000
                                                drConcLav(nRighe).UDM_DES = " l"
                                            Case Else
                                                'drConcLav(nRighe).Qta = drPro(c).Qta * 1000
                                                'metto una stringa vuota altrimenti se sono in casi non 
                                                'passati prima (come chilogrammi per ettaro)
                                                'dopo quando faccio ds.DT_Trattamenti2.Rows(s).Item("dose1") = CStr(Math.Round(cdec(ds.DT_Trattamenti2.Rows(s).Item("dose1").Split(" ")(0)), CInt(Qs_arrotonda)) & " " & ds.DT_Trattamenti2.Rows(s).Item("dose1").Split(" ")(1))
                                                'prende anche la stringa 0,5chilogrammi non esendoci lo spazio
                                                'non andrà bene la visualizzazione ma almeno non va in crash
                                                drConcLav(nRighe).UDM_DES = " " & drConcLav(nRighe).UDM_DES.Trim.Replace(" ", "_")
                                        End Select


                                        Select Case CInt(drPro(c).mezzo)
                                            Case 0   'qtà x ettolitro
                                                drConcLav(nRighe).Qta_Ril = drConcLav(nRighe).Qta * Acqua
                                                drConcLav(nRighe).Qta = Math.Round(drConcLav(nRighe).Qta, 5)
                                                drConcLav(nRighe).Dose = drConcLav(nRighe).Qta & drConcLav(nRighe).UDM_DES & "/hl"
                                            Case 1  'qtà x quintale
                                                drConcLav(nRighe).Qta_Ril = drConcLav(nRighe).Qta * Sup_TrattataTot
                                                drConcLav(nRighe).Qta = Math.Round(drConcLav(nRighe).Qta, 5)
                                                drConcLav(nRighe).Dose = drConcLav(nRighe).Qta & drConcLav(nRighe).UDM_DES & "/q"
                                        End Select

                                        drConcLav(nRighe).Qta_Ril = Math.Round(CDec(drConcLav(nRighe).Qta_Ril), 5)

                                        'se sono salvati in movimenti_dettagli leggo le descrizioni in locale
                                        'se non sono salvati in movimenti_dettagli li ho letti dal web service
                                        'se non ho il collegamento non li indico
                                        Dim Pa_Des As String
                                        If PrincipiSalvati = False Then
                                            If Not DtPrincipi Is Nothing Then
                                                Dim objAgroWs As New AgronicaCoreWebService.AgroWs
                                                'Pa_Des = Replace(SchedeMagazzinoHelper.ComposizioneFormulatiDescrizionePrincipiAttivi(objParametri_Server, drPro(c).Pro_Cod, DtPrincipi), "     ", " ").Trim
                                                Pa_Des = Replace(objAgroWs.ComposizioneFormulatiDescrizionePrincipiAttivi(objParametri_Server, drPro(c).Pro_Cod, DtPrincipi), "     ", " ").Trim
                                                drConcLav(nRighe).pa_des = Pa_Des 'SchedeMagazzinoHelper.ComposizioneFormulatiDescrizionePrincipiAttivi(objParametri_Server, drPro(c).Pro_Cod, DtPrincipi).Trim
                                                'drConcLav(nRighe).ClasseToss = SchedeMagazzinoHelper.ComposizioneFormulatiClasseTossicologica(objParametri_Server, drPro(c).Pro_Cod, DtPrincipi).Trim
                                                drConcLav(nRighe).ClasseToss = objAgroWs.ComposizioneFormulatiClasseTossicologica(objParametri_Server, drPro(c).Pro_Cod, DtPrincipi).Trim
                                                objAgroWs = Nothing
                                            Else
                                                drConcLav(nRighe).pa_des = ""
                                                drConcLav(nRighe).ClasseToss = ""
                                            End If
                                        Else
                                            strPriAtt = ""
                                            Dim strPa_Cod As String = ""
                                            strPa_Cod = drPro(c).pa_des
                                            'strPa_Cod = drConcLav(nRighe).pa_des
                                            Dim Principi() As String
                                            Dim p As Integer
                                            Dim Principio As String
                                            Dim Titolo As String
                                            Dim DrPrincipio() As DataRow

                                            If strPa_Cod <> "" Then
                                                Principi = Split(strPa_Cod, "|")
                                                If Not Principi Is Nothing Then
                                                    For p = 0 To Principi.Length - 1
                                                        Principio = Principi(p)
                                                        If Split(Principio, "§")(0) <> "" Then
                                                            DrPrincipio = DtPrincipiDes.Select("pa_cod=" & Split(Principio, "§")(0))
                                                            If Not DrPrincipio Is Nothing AndAlso DrPrincipio.Length > 0 Then
                                                                Pa_Des = DrPrincipio(0).Item("pa_des")
                                                            End If
                                                        End If
                                                        Titolo = Split(Principio, "§")(1)
                                                        If CDec(Titolo) <> 0 Then
                                                            strPriAtt &= Titolo.ToString & " % - " & Pa_Des & vbCrLf
                                                        Else
                                                            strPriAtt &= "(" & Pa_Des & ")" & vbCrLf
                                                        End If
                                                    Next
                                                End If
                                            End If

                                            drConcLav(nRighe).pa_des = strPriAtt
                                            drConcLav(nRighe).ClasseToss = Replace(drConcLav(nRighe).ClasseToss, "|", ",")
                                        End If


                                End Select

                                drConcLav(nRighe).Mov_Desc = strNote

                                If nRighe <> 0 Then
                                    drConcLav(nRighe).Mov_Desc = ""
                                    drConcLav(nRighe).costi_accessori = ""
                                    'drConcLav(nRighe).Qta_Ril = 0
                                    drConcLav(nRighe).Acqua = ""
                                    drConcLav(nRighe).Veg_Des = ""
                                    drConcLav(nRighe).Sup_Trattata = ""
                                    drConcLav(nRighe).Cul_Des = ""
                                    drConcLav(nRighe).Veg_Des_e_Cul_Des = ""
                                End If



                                ''09/09/2013 per vedere acqua e carenza anche su altre righe
                                'drConcLav(nRighe).Qta_Ril = acquaOld
                                'drConcLav(nRighe).Acqua = strAcquaold

                                drConcLav(nRighe).Veg_Cod = Veg_Cod

                                drConcLav(nRighe).Cul_Cod = Cul_Cod

                                drConcLav(nRighe).Veg_Des = Veg_Des

                                drConcLav(nRighe).Cul_Des = Cul_Des

                                'Visualizza la Specie e la Varietà insieme
                                drConcLav(nRighe).Veg_Des_e_Cul_Des = drConcLav(nRighe).Veg_Des & " " & drConcLav(nRighe).Cul_Des

                                drConcLav(nRighe).Data_Movimento = Formatta_Data_Movimento(drConcLav(nRighe).Data_Movimento)

                                'Inserisco la nuova riga
                                ds.DT_TrattamentiPost.ImportRow(drConcLav(nRighe))

                                nRighe += 1

                            End If



                        Next 'CICLO I PRODOTTI



                    End If

                    'eliminerò le vecchie righe..
                    For y = 0 To drConcLav.Length - 1
                        drConcLav(y).Veg_Des = "-1"
                    Next

                End If ' prodotto

            Next 'ciclo id_agenda


            For s = 0 To ds.DT_TrattamentiPost.Count - 1
                If Not IsDBNull(ds.DT_TrattamentiPost.Rows(s).Item("veg_des")) Then
                    If ds.DT_TrattamentiPost.Rows(s).Item("veg_des") = "-1" Then
                        ds.DT_TrattamentiPost.Rows(s).Delete()
                    End If
                End If

            Next

            ds.DT_TrattamentiPost.AcceptChanges()



            'arrotondamenti
            For s = 0 To ds.DT_TrattamentiPost.Count - 1
                If CInt(Qs_arrotonda) <> -1 Then
                    ds.DT_TrattamentiPost.Rows(s).Item("dose") = CStr(Math.Round(CDec(ds.DT_TrattamentiPost.Rows(s).Item("dose").Split(" ")(0)), CInt(Qs_arrotonda)) & " " & ds.DT_TrattamentiPost.Rows(s).Item("dose").Split(" ")(1))
                    ds.DT_TrattamentiPost.Rows(s).Item("Qta_Ril") = Math.Round(CDec(ds.DT_TrattamentiPost.Rows(s).Item("Qta_Ril")), CInt(Qs_arrotonda))
                    If IsNumeric(ds.DT_TrattamentiPost.Rows(s).Item("Acqua")) = False Then
                        If ds.DT_TrattamentiPost.Rows(s).Item("Acqua") <> "" AndAlso InStr(ds.DT_TrattamentiPost.Rows(s).Item("Acqua"), "/") > 0 Then
                            ds.DT_TrattamentiPost.Rows(s).Item("Acqua") = CStr(Math.Round(CDec(CStr(ds.DT_TrattamentiPost.Rows(s).Item("Acqua")).Split("/")(0)), CInt(Qs_arrotonda))) & "/" & ds.DT_TrattamentiPost.Rows(s).Item("Acqua").Split("/")(1)
                        End If
                    Else
                        ds.DT_TrattamentiPost.Rows(s).Item("Acqua") = CStr(Math.Round(CDec(CStr(ds.DT_TrattamentiPost.Rows(s).Item("Acqua"))), CInt(Qs_arrotonda)))
                    End If



                End If

            Next

            '--------------------------------------------------------------------------------------
            'ORDINO IL DATASET
            '(per farlo importo nell'ordine le datarow ordinate e poi elimino le vecchie righe)
            '--------------------------------------------------------------------------------------

            Righe_Old = ds.DT_TrattamentiPost.Count

            For Each dr In ds.DT_TrattamentiPost.Select("", "Data_Movimento")

                ds.DT_TrattamentiPost.ImportRow(dr)

            Next

            For s = 0 To Righe_Old - 1
                ds.DT_TrattamentiPost.Rows(s).Delete()
            Next

            'rendo permanenti le modifiche sul ds
            ds.DT_TrattamentiPost.AcceptChanges()

        End If 'controllo sui lav_cod


    End Function


    '###########################################################################
    Private Sub CaricaDsFasiFenologiche(ByVal Flag_Multicentro As Boolean, ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna, ByVal Flag_Multispecie As Boolean)

        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String
        Dim stbQ As New System.Text.StringBuilder

        Dim App_Nome As String
        Dim Num_Appezzamento As Double

        Dim appIndex As Integer

        Dim DefaultCopy() As StampeDefault


        Dim sw As Stopwatch = StartWatch("CaricaDsFasiFenologiche")


        If Not defaults Is Nothing Then
            ReDim DefaultCopy(defaults.Length - 1)
            Array.Copy(defaults, DefaultCopy, defaults.Length)
        End If

        'costruisco la query
        'stbQ.AppendLine(" SELECT FasiFenologiche.FF_DES, CONVERT(varchar,Mov_Destinazioni.validita_inizio, 103) AS Data_ril, Cultivar.Cul_Des, ")
        stbQ.AppendLine(" SELECT ISNULL(Mov_Dettaglio_Tecnico.Extra_str, '') AS FF_DES, ISNULL(Mov_Dettaglio_Tecnico.FF_Classe, 0) AS FF_COD, Mov_Destinazioni.validita_inizio AS Data_ril, SpecieVegetali.Veg_Des, Cultivar.Cul_Des, ")
        stbQ.AppendLine(" Appezzamento.App_Nome, Centri_Aziendali.Sa_Nome, Mov_Destinazioni.appezza, Mov_Destinazioni.id_destinazione, Mov_Destinazioni.piva, ")
        stbQ.AppendLine(" CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Mov_Destinazioni.piva ELSE Imprese.partitaIvaReale END AS PivaReale, ")
        stbQ.AppendLine(" Mov_Destinazioni.sa_cod, Agenda.id_agenda, ")

        'campo_des
        stbQ.AppendLine(" ISNULL(( SELECT top 1 Campi.Campo_Des ")
        stbQ.AppendLine("          FROM Campi ")
        stbQ.AppendLine("          WHERE Campi.Piva = Appezzamento.PIVA AND Campi.Sa_Cod = Appezzamento.SA_COD AND ")
        stbQ.AppendLine("          Campi.Campo_Cod = Appezzamento.Campo_Cod ")
        stbQ.AppendLine(" ), '') AS Campo_Nome, ")

        stbQ.AppendLine(" ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici  ")
        stbQ.AppendLine("          WHERE (Appezzamento_Codici.PIVA = Appezzamento.PIVA) ")
        stbQ.AppendLine("          AND (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) ")
        stbQ.AppendLine("          AND (Appezzamento_Codici.appezza = Appezzamento.appezza) ")
        stbQ.AppendLine("          AND (Appezzamento_Codici.id_cod = 1104)  ")
        stbQ.AppendLine("  ), '') AS App_Nome_Breve, ")

        'RIMOSSA LETTURA FASI DA WEB SERVICE, TABELLE SPOSTATE SU METASCHEMA LOCALE
        stbQ.AppendLine(" CASE WHEN ISNULL(Mov_Dettaglio_Tecnico.FF_Classe, 0) < 1000")
        stbQ.AppendLine(" -- FasiFenologiche_OLD")
        stbQ.AppendLine("      THEN ff.FF_DES")
        stbQ.AppendLine(" ELSE")
        stbQ.AppendLine(" -- FasiFenologiche")
        stbQ.AppendLine("      ss.descrizione + ' (BBCH ' + (CASE sc.Tipo_Scala ")
        stbQ.AppendLine("                                    WHEN 2")
        stbQ.AppendLine("                                       THEN CONVERT(varchar, sc.stadio_principale) + CONVERT(varchar, sc.seconda_cifra)  ")
        stbQ.AppendLine("                                    WHEN 3")
        stbQ.AppendLine("                                       THEN CONVERT(varchar, sc.stadio_principale) + CONVERT(varchar, sc.seconda_cifra) + CONVERT(varchar, sc.terza_cifra)")
        stbQ.AppendLine("                                    ELSE CONVERT(varchar, sc.stadio_principale) ")
        stbQ.AppendLine("                                    END) + ')' ")
        stbQ.AppendLine(" END AS FaseFenologicaDes, ")
        stbQ.AppendLine(" ")

        stbQ.Append(" ISNULL((SELECT TOP 1 Imprese_Progetti.Progetto_Nome FROM Imprese_Progetti " & vbCrLf)
        stbQ.Append("       WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
        stbQ.Append(" 	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
        stbQ.Append(" 	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
        stbQ.Append(" 	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG  " & vbCrLf)

        'se ho scelto una data unica per la stampa..
        If Qs_DataStampa <> "" Then
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
        Else
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
        End If

        stbQ.Append(" 	     ORDER BY Imprese_Progetti.Validita_Inizio DESC ), '') AS Lotto " & vbCrLf)
        stbQ.AppendLine(" ")

        stbQ.AppendLine(" FROM Mov_Dettaglio_Tecnico ")

        stbQ.AppendLine(" INNER JOIN Movimenti ")
        stbQ.AppendLine(" INNER JOIN Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod  ")
        stbQ.AppendLine(" AND Movimenti.Id_Agenda = Agenda.Id_Agenda ")

        stbQ.AppendLine(" INNER JOIN Movimenti_dettagli ON Movimenti.PIVA = Movimenti_dettagli.PIVA AND Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod  ")
        stbQ.AppendLine(" AND Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda AND Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov ")

        stbQ.AppendLine(" INNER JOIN Appezzamento ")
        stbQ.AppendLine(" INNER JOIN Mov_Destinazioni ON Appezzamento.PIVA = Mov_Destinazioni.Piva  ")
        stbQ.AppendLine(" AND Appezzamento.SA_COD = Mov_Destinazioni.Sa_Cod AND Appezzamento.APPEZZA = Mov_Destinazioni.Appezza   ")
        stbQ.AppendLine(" ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod  ")
        stbQ.AppendLine(" AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov   ")
        stbQ.AppendLine(" AND Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ON Mov_Dettaglio_Tecnico.Piva = Movimenti_dettagli.PIVA ")
        stbQ.AppendLine(" AND Mov_Dettaglio_Tecnico.Sa_Cod = Movimenti_dettagli.Sa_Cod   ")
        stbQ.AppendLine(" AND Mov_Dettaglio_Tecnico.Id_Agenda = Movimenti_dettagli.Id_Agenda  ")
        stbQ.AppendLine(" AND Mov_Dettaglio_Tecnico.Id_Mov = Movimenti_dettagli.Id_Mov  ")
        stbQ.AppendLine(" AND Mov_Dettaglio_Tecnico.Id_Mov_Det = Movimenti_dettagli.Id_Mov_Det ")

        stbQ.AppendLine(" INNER JOIN Cultivar Cultivar ")
        stbQ.AppendLine(" INNER JOIN Reg_Impianti ON Cultivar.Cul_Cod = Reg_Impianti.CUL_COD ")
        stbQ.AppendLine(" INNER JOIN Imprese ON Imprese.PIVA = Reg_Impianti.PIVA ")

        stbQ.AppendLine(" INNER JOIN SpecieVegetali SpecieVegetali ON SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod ON Mov_Destinazioni.Piva = Reg_Impianti.PIVA  ")
        stbQ.AppendLine(" AND Mov_Destinazioni.Sa_Cod = Reg_Impianti.SA_COD AND Mov_Destinazioni.Appezza = Reg_Impianti.APPEZZA  ")
        stbQ.AppendLine(" AND Mov_Destinazioni.Id_Destinazione = Reg_Impianti.ID_REG ")
        ' Tolto il 24/07/2017 17.35.13: x passaggio a gestione FasiFeno tramite WS
        'stbQ.AppendLine(" FasiFenologiche FasiFenologiche ON Mov_Dettaglio_Tecnico.FF_Classe = FasiFenologiche.FF_COD INNER JOIN ")
        stbQ.AppendLine(" INNER JOIN Centri_Aziendali ON Reg_Impianti.Piva = Centri_Aziendali.Piva AND Reg_Impianti.Sa_Cod = Centri_Aziendali.Sa_Cod ")

        'RIMOSSA LETTURA FASI DA WEB SERVICE, TABELLE SPOSTATE SU METASCHEMA LOCALE
        stbQ.AppendLine("--FasiFenologiche")
        stbQ.AppendLine(" LEFT JOIN SpecieVegetaliXStadiCrescita ss")
        stbQ.AppendLine(" ON ss.VEG_COD = SpecieVegetali.VEG_COD AND ss.Cod_SS = ISNULL(Mov_Dettaglio_Tecnico.FF_Classe, 0) ")
        stbQ.AppendLine(" LEFT OUTER JOIN Stadi_Crescita_BBCH sc on ss.ID_BBCH = sc.ID_BBCH  ")

        stbQ.AppendLine("--FasiFenologiche_OLD")
        stbQ.AppendLine(" LEFT JOIN FasiFenologichexSpecieVegetali fs ")
        stbQ.AppendLine(" ON fs.VEG_COD = SpecieVegetali.VEG_COD AND fs.FF_COD = ISNULL(Mov_Dettaglio_Tecnico.FF_Classe, 0)")
        stbQ.AppendLine(" LEFT OUTER JOIN FasiFenologiche ff")
        stbQ.AppendLine(" ON fs.FF_COD = ff.FF_COD")

        'stbQ.AppendLine(" LEFT JOIN Imprese_Progetti ON Imprese_Progetti.Piva = Reg_Impianti.PIVA AND Imprese_Progetti.Sa_Cod = Reg_Impianti.SA_COD AND  ")
        'stbQ.AppendLine(" Imprese_Progetti.Appezza = Reg_Impianti.APPEZZA AND Imprese_Progetti.Id_Reg = Reg_Impianti.ID_REG ")

        stbQ.AppendLine("")


        If IDTestataTemp <> 0 Then

            stbQ.AppendLine(" INNER JOIN __tmp_FiltroImpianti f ")
            stbQ.AppendLine(" ON  Reg_Impianti.PIVA = f.piva  ")
            stbQ.AppendLine(" AND Reg_Impianti.SA_COD = f.sa_cod ")
            stbQ.AppendLine(" AND Reg_Impianti.APPEZZA = f.appezza ")
            stbQ.AppendLine(" AND Reg_Impianti.ID_REG = f.id_reg ")
            stbQ.AppendLine("       AND f.idTestataTemp = " & IDTestataTemp)
            stbQ.AppendLine("       AND f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
            stbQ.AppendLine("       AND f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

        End If

        stbQ.AppendLine(" WHERE Mov_Destinazioni.validita_inizio <> " & Agro_SQL_SaveDate(#1/1/1900#))

        If Not Flag_Multispecie Then
            If Veg_Cod = "0" Then
                stbQ.AppendLine(" AND Reg_Impianti.cul_cod = 0 ")
            Else
                If TerrenoNudoIncluso = False Then
                    stbQ.AppendLine(" AND SpecieVegetali.VEG_COD = " & Veg_Cod)
                Else
                    stbQ.AppendLine(" AND (SpecieVegetali.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) ")
                End If
            End If
        End If
        stbQ.AppendLine(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

        If Not Flag_Multicentro Then
            stbQ.AppendLine(" AND Agenda.sa_cod = " & Sa_Cod & " ")
        End If

        stbQ.AppendLine(" AND Agenda.Lav_Cod = 79 ")

        'se ho scelto una data unica per la stampa..
        If Qs_DataStampa <> "" Then

            stbQ.AppendLine(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            stbQ.AppendLine(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            stbQ.AppendLine(" AND Agenda.Validita_Inizio = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
        Else

            stbQ.AppendLine(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stbQ.AppendLine(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")

            stbQ.AppendLine(" AND Agenda.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stbQ.AppendLine(" AND Agenda.Validita_Inizio >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")

        End If

        stbQ.AppendLine(" AND Movimenti_dettagli.contabilizzato >= 0 ")


        stbQ.AppendLine(" ORDER BY App_Nome, Mov_Destinazioni.validita_inizio ")

        'ds tipizzato...ci copio le righe dentro
        'Me.DsFasiFenologiche = New Ds_FasiFenologiche

        'eseguo la query e controllo gli errori
        'objSql.SqlSelect(Session("ASG_Pathfilei..."), Session("ASG_Connessione_Server"), stbQ.ToString, Me.DsFasiFenologiche, _
        '                                                DsFasiFenologiche.FasiFenologiche.TableName, strErr)

        strErr = Nothing
        Try
            objSql.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "Schedacampagna.CaricaDsFasiFenologiche", DsFasiFenologiche, DsFasiFenologiche.FasiFenologiche.TableName)
        Catch ex As Exception
            strErr = ex.Message
        End Try

        'controllo errori 
        If Not IsNothing(strErr) Then
            'eccezzione......
            Throw New ApplicationException(strErr)
        Else

#Region "LETTURA WS FASI RIMOSSA"
            'RIMOSSA LETTURA FASI DA WEB SERVICE, TABELLE SPOSTATE SU METASCHEMA LOCALE

            ''controllo su appezza..
            ''se è un valore alto lo tronco alle ultime 3 cifre..
            'Dim i As Integer

            ''WS per fasi Fenologiche
            'Dim objParametriIngressoNEW As New AgronicaCoreMetaSchemaBIZ.FasiFenologiche_input
