                                                ByVal Flag_Nasc_Oper As Boolean, ByVal Flag_Nasc_Macc As Boolean,
                                                ByVal Flag_Nasc_DataFirma As Boolean, ByVal Flag_Nasc_NumRic As Boolean,
                                                ByVal Flag_Nasc_DataUltMan As Boolean, ByRef strQueryTratta As String,
                                                ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna,
                                               ByRef Hash_Patentino As Hashtable)

        'Dim l As New AgronicaCoreDataProvider.LogProvider
        'l.Scrivi_LOG(objParametri_Server, "CaricaDsTrattamentiPostRaccolta", "Inizio " & System.DateTime.Now)

        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String
        Dim stbQ As New System.Text.StringBuilder
        Dim stbQ1 As New System.Text.StringBuilder
        Dim App_Nome As String
        Dim Num_Appezzamento As Double

        Dim Padre As Boolean = False
        Dim NumFigli As Integer

        Dim i, j, c, n As Integer


        Dim sw As Stopwatch = StartWatch("CaricaDsTrattamentiPostRaccolta")

        Try

            'query che ricava gli id_agenda dei trattamenti post raccolta fatti sulla specie selezionata.
            stbQ1.AppendLine(" SELECT DISTINCT ")

            stbQ1.AppendLine("        Agenda.Id_Agenda,  Materie_Prime.Veg_Cod,SpecieVegetali.Veg_Des,")
            stbQ1.AppendLine("        ISNULL(Materie_Prime.Cul_Cod, 0) AS Cul_Cod,ISNULL(Cultivar.Cul_Des, '') AS Cul_Des")
            stbQ1.AppendLine(" FROM   SpecieVegetali INNER JOIN ")
            stbQ1.AppendLine("        Materie_Prime ON SpecieVegetali.Veg_Cod = Materie_Prime.Veg_Cod  LEFT JOIN ")
            stbQ1.AppendLine("        Cultivar ON Cultivar.Cul_Cod = Materie_Prime.Cul_Cod  INNER JOIN ")
            stbQ1.AppendLine("        Agenda INNER JOIN ")
            stbQ1.AppendLine("        Movimenti ON Agenda.PIVA = Movimenti.PIVA AND Agenda.Sa_Cod = Movimenti.Sa_Cod AND Agenda.Id_Agenda = Movimenti.Id_Agenda INNER JOIN ")
            stbQ1.AppendLine("        Movimenti_dettagli ON Movimenti.PIVA = Movimenti_dettagli.PIVA AND Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda AND  ")
            stbQ1.AppendLine("        Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov ON ")
            stbQ1.AppendLine("        Materie_Prime.Elem_Cod = Movimenti_dettagli.Elem_Cod AND Materie_Prime.Mat_Cod = Movimenti_dettagli.Mat_Cod ")

            stbQ1.AppendLine("WHERE Agenda.Lav_Cod IN (" & LAVCOD_TRATTAMENTO_POST_RACCOLTA & ") ")

            If Not Flag_Multispecie Then
                If IsNothing(strVeg_Cod) Then
                    strVeg_Cod = " 0 "
                End If
                stbQ1.AppendLine(" AND SpecieVegetali.VEG_COD IN (" & Agro_SQL_Save_Clausola_IN(strVeg_Cod, False) & ")")
            End If

            stbQ1.AppendLine(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

            If Not Flag_Multicentro Then
                stbQ1.AppendLine(" AND Agenda.sa_cod = " & Sa_Cod & " ")
            End If

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ1.AppendLine(" AND Agenda.Validita_Inizio = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            Else
                stbQ1.AppendLine(" AND Agenda.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
                stbQ1.AppendLine(" AND Agenda.Validita_Inizio >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")
            End If

            stbQ1.AppendLine(" AND Movimenti_dettagli.contabilizzato >= 0 ")

            stbQ1.AppendLine(" ORDER BY  Agenda.Id_Agenda ")

            strQueryTratta = stbQ1.ToString

            Dim Dt_IdAgenda As DataTable
            Dt_IdAgenda = objSql.EseguiQuery_Lettura(objParametri_Server, stbQ1.ToString, "SchedaCampagna.CaricaDsTrattamentiPostRaccolta")

            Dim strIdAgenda As String = ""

            If Not IsNothing(Dt_IdAgenda) AndAlso Dt_IdAgenda.Rows.Count > 0 Then
                For i = 0 To Dt_IdAgenda.Rows.Count - 1
                    strIdAgenda &= Dt_IdAgenda.Rows(i).Item("Id_Agenda") & ","
                Next
                strIdAgenda = Mid(strIdAgenda, 1, strIdAgenda.Length - 1)
            End If

            If strIdAgenda <> "" Then

                stbQ.AppendLine("             Select DISTINCT ")
                stbQ.AppendLine("                       Agenda.PIVA, CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Agenda.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale,  ")
                stbQ.AppendLine("                       Agenda.Sa_Cod, Agenda.Id_Agenda, Agenda.Lav_Cod, CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) As Data_Movimento, Movimenti.Cau_Mov, Movimenti.Mov_Desc, Movimenti_dettagli.Elem_Cod,  ")
                stbQ.AppendLine("                       Movimenti_dettagli.Pro_Cod, Movimenti_dettagli.Mat_Cod, Movimenti_dettagli.Udm_Cod, Movimenti_dettagli.Qta, Movimenti_dettagli.Extra_Int, Materie_Prime.Mat_Des, Formulati.Fr_Des,  ")
                stbQ.AppendLine("                       Mov_Dettaglio_Tecnico.Av_Cod, Mov_Dettaglio_Tecnico.Av_Gru, Avversita.Av_Des_Vol, GruppoAvversita.Av_Gru_Des,  ")
                stbQ.AppendLine("                       Mov_Dettaglio_Tecnico.Id_Mov_Det AS Id_Mov_Det_Tecnico, Movimenti_dettagli.Id_Mov_Det AS Id_Mov_Det_Dettagli, SpecieVegetali.Veg_Cod, SpecieVegetali.Veg_Des,Agenda.des_lib, Mov_Dettaglio_Tecnico.qta_ril, ISNULL(Movimenti_dettagli.TempoCarenza,0) AS carenza, ")
                stbQ.AppendLine("                       ISNULL(Movimenti_dettagli.PrincipiAttivi,'') AS Pa_Des, 0 AS Pa_Cod, ISNULL(Movimenti_dettagli.ClassiTossicologiche,'') AS ClasseToss,  Movimenti.mezzo, Movimenti.Num_Protocollo, Movimenti_dettagli.Cod_Progetto, Movimenti_dettagli.Lotto ")
                stbQ.AppendLine(" FROM         SpecieVegetali RIGHT OUTER JOIN ")
                stbQ.AppendLine("                       Materie_Prime ON SpecieVegetali.Veg_Cod = Materie_Prime.Veg_Cod RIGHT OUTER JOIN ")
                stbQ.AppendLine("                       Agenda INNER JOIN ")
                stbQ.AppendLine("                       Imprese ON Agenda.PIVA = Imprese.PIVA INNER JOIN ")
                stbQ.AppendLine("                       Movimenti ON Agenda.PIVA = Movimenti.PIVA AND Agenda.Sa_Cod = Movimenti.Sa_Cod AND Agenda.Id_Agenda = Movimenti.Id_Agenda INNER JOIN ")
                stbQ.AppendLine("                       Movimenti_dettagli ON Movimenti.PIVA = Movimenti_dettagli.PIVA AND Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda AND  ")
                stbQ.AppendLine("                       Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov LEFT OUTER JOIN ")
                stbQ.AppendLine("                      GruppoAvversita RIGHT OUTER JOIN ")
                stbQ.AppendLine("                       Mov_Dettaglio_Tecnico AS Mov_Dettaglio_Tecnico ON GruppoAvversita.Av_Gru = Mov_Dettaglio_Tecnico.Av_Gru LEFT OUTER JOIN ")
                stbQ.AppendLine("                       Avversita ON Mov_Dettaglio_Tecnico.Av_Cod = Avversita.Av_Cod ON Movimenti_dettagli.PIVA = Mov_Dettaglio_Tecnico.Piva AND  ")
                stbQ.AppendLine("                       Movimenti_dettagli.Sa_Cod = Mov_Dettaglio_Tecnico.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda AND  ")
                stbQ.AppendLine("                       Movimenti_dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov LEFT OUTER JOIN ")
                stbQ.AppendLine("                       Formulati ON Movimenti_dettagli.Pro_Cod = Formulati.Fr_Cod ON Materie_Prime.Piva = Movimenti_dettagli.PIVA AND  ")
                stbQ.AppendLine("                       Materie_Prime.Elem_Cod = Movimenti_dettagli.Elem_Cod AND Materie_Prime.Mat_Cod = Movimenti_dettagli.Mat_Cod ")

                stbQ.AppendLine("WHERE Agenda.Id_Agenda IN (" & Agro_SQL_Save_Clausola_IN(strIdAgenda, False) & ") ")

                stbQ.AppendLine(" AND Movimenti_dettagli.contabilizzato >= 0 ")

                stbQ.AppendLine(" ORDER BY Data_Movimento, Agenda.Id_Agenda ")

                strQueryTratta = stbQ.ToString

                strErr = Nothing

                'Try
                objSql.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "SchedaCampagna.CaricaDsTrattamentiPostRaccolta", DsTrattaPostRaccolta, DsTrattaPostRaccolta.DT_TrattamentiPost.TableName)
                'Catch ex As Exception
                '    strErr = ex.Message
                'End Try

                ''controllo errori 
                'If Not IsNothing(strErr) Then
                '    Throw New Exception(strErr)
                'Else 

                If Not IsNothing(DsTrattaPostRaccolta) Then

                    If Not Flag_Multispecie AndAlso Not Flag_Multicentro Then

                        'Me.CompactDtTrattamenti_Semplificata(Me.DsTratta, Flag_Arr_Acqua, Flag_Nasc_Resp, _
                        '                                     Flag_Nasc_Oper, Flag_Nasc_Macc, Flag_Nasc_DataFirma, _
                        '                                     Flag_Nasc_NumRic, Flag_Nasc_DataUltMan)
                    Else

                        Me.CompactDtTrattamentiPostRaccolta_Multispecie(Me.DsTrattaPostRaccolta, strIdAgenda, Dt_IdAgenda,
                                                                        Flag_Arr_Acqua, Flag_Nasc_Resp,
                                                                        Flag_Nasc_Oper, Flag_Nasc_Macc, Flag_Nasc_DataFirma,
                                                                        Flag_Nasc_NumRic, Flag_Nasc_DataUltMan,
                                                                        Hash_Patentino)
                    End If

                    DsTrattaPostRaccolta.Tables(0).Columns("Piva").ColumnName = "Piva_old"
                    DsTrattaPostRaccolta.Tables(0).Columns("PivaReale").ColumnName = "Piva"
                    DsTrattaPostRaccolta.Tables(0).Columns("Piva_old").ColumnName = "PivaReale"
                End If

            End If

        Catch ex As Exception
            Log_Errori &= "CaricaDsTrattamentiPostRaccolta: " & vbCrLf & ex.Message & vbCrLf
            Throw New Exception(Log_Errori)
        End Try

        EndWatch(sw, "CaricaDsTrattamentiPostRaccolta")

    End Sub

    Private Function CompactDtTrattamentiPostRaccolta_Multispecie(ByRef ds As DS_TrattamentiPost,
                                                                  ByVal strIdAgenda As String,
                                                                  ByVal Dt_IdAgenda As DataTable,
                                                                  ByVal Flag_Arr_Acqua As Boolean,
                                                                  ByVal Flag_Nasc_Resp As Boolean, ByVal Flag_Nasc_Oper As Boolean,
                                                                  ByVal Flag_Nasc_Macc As Boolean, ByVal Flag_Nasc_DataFirma As Boolean,
                                                                  ByVal Flag_Nasc_NumRic As Boolean, ByVal Flag_Nasc_DataUltMan As Boolean,
                                                                  ByRef Hash_Patentino As Hashtable)

        Dim objSqlDis As New AgronicaCoreDataProvider.DatatableUtility

        Dim objNoteAgenda As New AgronicaCoreContabDAL.AgendaxNote_R
        Dim DtNote As DataTable
        Dim DrNote As DataRow()

        Dim i, c, y, j, w, d, x, s, f, noteiter As Integer
        Dim strAppezzamenti As String

        Dim Padre As Boolean = False
        Dim NumFigli As Integer
        Dim SupPadre As Decimal

        Dim dr As DataRow

        Dim Righe_Old As Integer

        Dim n As Integer



        Dim AcquaNoRound As Decimal

        '-------------------------------------------------------------------------------------------------------------------
        '-------------------------------------------------------------------------------------------------------------------
        '-------------------------------------------------------------------------------------------------------------------
        'verifico se i principi attivi e le classi tossicologiche sono salvati in agenda o se devo leggerli dal web service
        Dim PrincipiSalvati As Boolean = False
        Dim DtPrincipi As DataTable
        Dim DtPrincipiDes As DataTable


        'seleziono le righe nella tabella di appoggio relative ai principi attivi
        Dim dtAppPA As DataTable = ds.DT_TrattamentiPost.Clone()
        For c = 0 To ds.DT_TrattamentiPost.Rows.Count - 1
            If ds.DT_TrattamentiPost.Rows(c).Item("elem_cod") = FORMULATI Then
                dtAppPA.ImportRow(ds.DT_TrattamentiPost.Rows(c))
            End If
        Next
        Dim strPACod() As String = objSqlDis.SelectDistinct(dtAppPA, "Pa_Des", True)

        If Not strPACod Is Nothing AndAlso strPACod.Length > 0 Then

            'se i principi sono salvati tutti (cod1§titolo1|cod2§titolo2)
            'leggo in locale le descrizioni dei principi attivi
            If strPACod(0) <> "" Then
                PrincipiSalvati = True
                Dim strPa_Cod As String = ""
                Dim p As Integer
                Dim Principi() As String
                Dim strElencoPACOD As String
                For n = 0 To strPACod.Length - 1
                    strPa_Cod = strPACod(n)
                    Principi = Split(strPa_Cod, "|")
                    If Not Principi Is Nothing Then
                        For p = 0 To Principi.Length - 1
                            strElencoPACOD &= Split(Principi(p), "§")(0) & ","
                        Next
                    End If
                Next
                If strElencoPACOD <> "" Then
                    Dim objPA As New AgronicaCoreMetaSchemaDAL.PrincipiAttivi_R
                    DtPrincipiDes = objPA.Leggi_Da_StrPa_Cod(Left(strElencoPACOD, strElencoPACOD.Length - 1), AGRODATAINIZIO, AGRODATAFINE, AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaDatiMinimi, "", "pa_cod", objParametri_Server)
                End If
            End If
        End If

        'se almeno un campo è vuoto
        'leggo i principi da web service (con una sola chiamata per tutti i formulati)
        If PrincipiSalvati = False Then
            'ottengo i formulati distinti
            Dim ElencoFormulati As String = ""
            Dim strFrCod() As String = objSqlDis.SelectDistinct(dtAppPA, "pro_cod", True)
            If Not strFrCod Is Nothing Then
                For f = 0 To strFrCod.Length - 1
                    ElencoFormulati &= strFrCod(f) & ","
                Next
            End If
            If ElencoFormulati <> "" Then
                Dim objAgroWs As New AgronicaCoreWebService.AgroWs
                ElencoFormulati = Left(ElencoFormulati, ElencoFormulati.Length - 1)
                DtPrincipi = objAgroWs.ComposizioneFormulatiRecupera(ElencoFormulati, objParametri_Server, objParametri_Utenti)
                objAgroWs = Nothing
            End If
        End If
        '-------------------------------------------------------------------------------------------------------------------
        '-------------------------------------------------------------------------------------------------------------------
        '-------------------------------------------------------------------------------------------------------------------



        'ottengo gli id_agenda e gli app_nome distinti
        'Dim strId_Agenda() As String = objSqlDis.SelectDistinct(ds.DT_TrattamentiPost, "id_agenda", False)
        Dim strId_Agenda() As String = Split(strIdAgenda, ",")

        Dim Sup_Tot As Decimal = 0.0
        Dim Sup_TrattataTot As Decimal = 0
        Dim Sup_Tot_Operazione As Decimal = 0
        Dim Sup_TrattataTot_Operazione As Decimal = 0
        Dim Avversita As String = ""
        Dim GruppoAvversita As String = ""
        Dim strPriAtt As String = ""
        Dim Acqua As Decimal
        Dim strAcqua As String = ""

        Dim drConcLav() As DS_TrattamentiPost.DT_TrattamentiPostRow
        Dim drAcqua() As DS_TrattamentiPost.DT_TrattamentiPostRow
        Dim drAvv() As DS_TrattamentiPost.DT_TrattamentiPostRow
        Dim drAvvGru() As DS_TrattamentiPost.DT_TrattamentiPostRow
        Dim drPro() As DS_TrattamentiPost.DT_TrattamentiPostRow

        Dim DtTemp As New DataTable

        Dim Hash_Prodotto_PA As New Hashtable
        Dim key_pat As String
        ' Dim Hash_Patentino As New Hashtable

        Dim Hash_MatCod As Hashtable

        Dim drNuovaRiga As DS_Trattamenti2.DT_Trattamenti2Row

        Dim strNote As String = ""

        'controllo ci sia qualcosa...
        If Not IsNothing(strId_Agenda) Then

            DtNote = objNoteAgenda.Leggi(0, 0, AGRODATAINIZIO, AGRODATAFINE,
                                          AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_JoinDescrizioni,
                                          " AgendaxNote.Id_Agenda IN (" & strIdAgenda & ")", "", objParametri_Server)

            'ciclo su tutti i id_agenda
            For i = 0 To strId_Agenda.Length - 1

                Hash_MatCod = New Hashtable
                Acqua = 0.0
                Sup_Tot_Operazione = 0
                Sup_TrattataTot_Operazione = 0

                Dim DrVegCod() As DataRow
                Dim Veg_Cod As Integer
                Dim Cul_Cod As Integer
                Dim Veg_Des As String
                Dim Cul_Des As String

                'per catasto
                inserisciTraGliIdAgendaMovimentati(strId_Agenda(i))

                DrVegCod = Dt_IdAgenda.Select("Id_Agenda=" & strId_Agenda(i))
                If Not DrVegCod Is Nothing AndAlso DrVegCod.Length > 0 Then
                    Veg_Cod = DrVegCod(0).Item("veg_cod")
                    Cul_Cod = DrVegCod(0).Item("cul_cod")
                    Veg_Des = DrVegCod(0).Item("veg_des")
                    Cul_Des = DrVegCod(0).Item("cul_des")
                End If

                Dim Righe() As DataRow = ds.DT_TrattamentiPost.Select("id_agenda=" & strId_Agenda(i))

                Dim dtApp As DataTable = ds.DT_TrattamentiPost.Clone()

                For c = 0 To Righe.Length - 1
                    dtApp.ImportRow(Righe(c))
                Next

                'seleziono le righe nella tabella di appoggio relative ai PRODOTTI
                Dim strPro() As String = objSqlDis.SelectDistinct(dtApp, "pro_cod")

                If Not IsNothing(strPro) Then

                    drConcLav = ds.DT_TrattamentiPost.Select("id_agenda=" & strId_Agenda(i))

                    Dim objCostiAccessori As New AgronicaCoreContabDAL.CostiAccessori_R

                    '--------------------------------------------------------------
                    'Costi accessori (operatore e macchina)
                    '--------------------------------------------------------------
                    If TipoReport = enum_TipoReport.SchedaCampagna_Multi Or
                        TipoReport = enum_TipoReport.RegistroTrattamenti_VenetoUnico Or
                        TipoReport = enum_TipoReport.RegistroTrattamenti_Veneto Or
                        TipoReport = enum_TipoReport.SchedaCampagna_Multicentro Or
                        TipoReport = enum_TipoReport.Eurep_Gap_Multicentro Or
                        TipoReport = enum_TipoReport.SchedaCampagna_Multicentro_ACA Or
                        TipoReport = enum_TipoReport.Prov_Aut_Trento Then

                        Dim strResponsabili As String = ""
                        Dim strOperatori As String = ""
                        Dim strMacchine As String = ""
                        Dim strTot As String = ""
                        Dim strCosti As String = ""
                        Dim strCosti1 As String = ""
                        Dim Num_Responsabili As Integer = 0
                        Dim Num_Operatori As Integer = 0
                        Dim Num_Macchine As Integer = 0
                        Dim nomeContatto As String

                        If Not IsDBNull(drConcLav(0).Mov_Desc()) AndAlso drConcLav(0).Mov_Desc() <> "" Then
                            If Trim(strNote) <> "" Then
                                strNote = String.Format("{0}{1}NOTE: {2}-{3}", strNote, vbCrLf, vbCrLf, drConcLav(0).Mov_Desc())
                            Else
                                strNote = String.Format("NOTE: {0}-{1}", vbCrLf, drConcLav(0).Mov_Desc())
                            End If
                        End If

                        '----------------------------------------------------------
                        '----------------------------------------------------------
                        '----------------------------------------------------------
                        '------------------------------------------------------------


                        'AGGIUNGO LE NUOVE NOTE DI AGENDA
                        DrNote = DtNote.Select("Id_Agenda = " & strId_Agenda(i))

                        If DrNote.Length > 0 Then

                            If strNote.IndexOf("NOTE") = -1 Then
                                If Trim(strNote) <> "" Then
                                    strNote = String.Format("{0}{1}NOTE: ", strNote, vbCrLf)
                                Else
                                    strNote = String.Format("NOTE: ")
                                End If
                            End If

                            For noteiter = 0 To DrNote.Length - 1
                                strNote = String.Format("{0}{1}-{2}", strNote, vbCrLf, DrNote(noteiter).Item("Nota_Des"))
                                If noteiter = DrNote.Length - 1 Then
                                    'strNote = String.Format("{0}{1}", strNote, vbCrLf)
                                End If
                            Next

                        End If

                        '''''''''''''''''''''''''''''''''''''''''''''''
                        ''' Aggiunta del ricetta Cod ''''''''''''''''''
                        '''''''''''''''''''''''''''''''''''''''''''''''
                        Dim objRicettexAgenda As New AgronicaCoreContabDAL.RicettexAgenda_R
                        Dim DT As DataTable
                        Dim strRicetta As String = ""

                        DT = objRicettexAgenda.Leggi(0,
                             0,
                             CInt(strId_Agenda(i)),
                             AGRODATAINIZIO,
                             AGRODATAFINE,
                             AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                             "",
                             " RicettexAgenda.Id_Agenda",
                             objParametri_Server)

                        If Not Flag_Nasc_NumRic AndAlso DT.Rows.Count > 0 Then
                            strRicetta = "Ricetta Numero: " & DT.Rows(0).Item("Ricetta_Cod")
                        End If

                        If strRicetta <> "" Then
                            If strNote <> "" Then
                                strNote &= vbCrLf & strRicetta
                            Else
                                strNote = strRicetta
                            End If
                        End If

                        'se ci sono note le aggiungo
                        If TipoReport <> enum_TipoReport.RegistroTrattamenti_Veneto AndAlso Trim(strNote) <> "" Then
                            strTot = strNote
                        End If

                        '============================================
                        'costi accessori
                        Dim flagDataFirma As Boolean = False
                        '16/09/2019: 
                        DtTemp = objCostiAccessori.CostiAccessori_from_IdAgenda2(Piva, CInt(strId_Agenda(i)), drConcLav(0).Data_Movimento, drConcLav(0).Data_Movimento, "", "", objParametri_Server)

                        If Not DtTemp Is Nothing AndAlso DtTemp.Rows.Count > 0 Then

                            For j = 0 To DtTemp.Rows.Count - 1

                                'è un record manodopera
                                If DtTemp.Rows(j).Item("Cod_RisUm") <> 0 Then

                                    'Recupero il nome del contatto
                                    If DtTemp.Rows(j).Item("Rag_Soc") <> "" Then
                                        nomeContatto = DtTemp.Rows(j).Item("Rag_Soc")
                                    Else
                                        nomeContatto = String.Format("{0} {1}", DtTemp.Rows(j).Item("Cognome"), DtTemp.Rows(j).Item("Nome"))
                                    End If

                                    If DtTemp.Rows(j).Item("Cau_Mov") = CAU_IMPUTAZIONE_TERZISTI Then
                                        nomeContatto &= " (Terzista)"
                                        flagDataFirma = True
                                    End If

                                    'Controllo se è un responsabile o un operatore
                                    If DtTemp.Rows(j).Item("Cau_Mov") <> CAU_IMPUTAZIONE_TECNICO_RESPONSABILE Then

                                        strOperatori &= nomeContatto & ","

                                        If Not IsDBNull(DtTemp.Rows(j).Item("patentino")) AndAlso DtTemp.Rows(j).Item("patentino") <> "" Then

                                            If Patentino = "" Then
                                                Patentino = DtTemp.Rows(j).Item("patentino")
                                            Else
                                                If InStr(Patentino, DtTemp.Rows(j).Item("patentino")) = 0 Then
                                                    Patentino &= " - " & DtTemp.Rows(j).Item("patentino")
                                                End If
                                            End If

                                            If Titolare = "" Then
                                                Titolare = nomeContatto
                                            Else
                                                If InStr(Titolare, nomeContatto) = 0 Then
                                                    Titolare &= " - " & nomeContatto
                                                End If
                                            End If

                                            If Data_Scadenza_Patentino = "" Then
                                                If IsDate(DtTemp.Rows(j).Item("data_scadenza_patentino")) AndAlso
                                                   CDate(DtTemp.Rows(j).Item("data_scadenza_patentino")) <> CDate(AGRODATAINIZIO) AndAlso
                                                   CDate(DtTemp.Rows(j).Item("data_scadenza_patentino")) <> CDate(AGRODATAFINE) Then
                                                    Data_Scadenza_Patentino = DtTemp.Rows(j).Item("data_scadenza_patentino")
                                                End If
                                            Else
                                                If InStr(Data_Scadenza_Patentino, DtTemp.Rows(j).Item("data_scadenza_patentino")) = 0 Then
                                                    If IsDate(DtTemp.Rows(j).Item("data_scadenza_patentino")) AndAlso
                                                      CDate(DtTemp.Rows(j).Item("data_scadenza_patentino")) <> CDate(AGRODATAINIZIO) AndAlso
                                                      CDate(DtTemp.Rows(j).Item("data_scadenza_patentino")) <> CDate(AGRODATAFINE) Then
