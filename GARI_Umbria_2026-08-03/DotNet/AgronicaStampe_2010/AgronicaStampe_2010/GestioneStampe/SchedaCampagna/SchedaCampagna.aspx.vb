            End If

            XMLs_VariabiliStampe = XML_FiltroStampa.GetElementsByTagName("VariabiliStampe")

            'leggo se ci sono filtri sui centri
            'se non ci sono record ha visibilita completa
            Dim objUtentiVisibilita As New AgronicaCoreUtentiDAL.Utenti_Visibilita_Appoggio_R
            Dim ListCentri As New List(Of String)
            Dim DtCentriVisibili As DataTable
            DtCentriVisibili = objUtentiVisibilita.Leggi(enum_TipoEntita.Centro, "", "", objParametri_Server)
            If Not DtCentriVisibili Is Nothing AndAlso DtCentriVisibili.Rows.Count > 0 Then
                For Each dt As DataRow In DtCentriVisibili.Rows
                    ListCentri.Add(dt("Piva") & "_" & dt("Sa_Cod"))
                Next
            End If

            For n_variabili = 0 To XMLs_VariabiliStampe.Count - 1

                XML_VariabiliStampe = XMLs_VariabiliStampe.Item(n_variabili)

                InserisciImpianto = True

                If FiltraImpianti = True Then

                    DrImpFascicolo = DTImpFascicolo.Select("piva='" & XML_VariabiliStampe.GetAttribute("piva") & "'" &
                                                           " AND sa_cod=" & XML_VariabiliStampe.GetAttribute("sa_cod") &
                                                           " AND appezza=" & XML_VariabiliStampe.GetAttribute("appezza") &
                                                           " AND id_reg=" & XML_VariabiliStampe.GetAttribute("id_reg"))

                    If Not (Not DrImpFascicolo Is Nothing AndAlso DrImpFascicolo.Length > 0) Then
                        InserisciImpianto = False
                    End If

                End If

                If InserisciImpianto = True Then

                    If ListCentri.Count = 0 OrElse ListCentri.Contains(XML_VariabiliStampe.GetAttribute("piva").ToString().Trim & "_" & XML_VariabiliStampe.GetAttribute("sa_cod").ToString().Trim) Then
                        ReDim Preserve Matrice_Variabili(4, N_Impianti)
                        'ReDim Preserve Matrice_Padri(N_Impianti, 100)

                        Matrice_Variabili(0, N_Impianti) = XML_VariabiliStampe.GetAttribute("piva")
                        Matrice_Variabili(1, N_Impianti) = XML_VariabiliStampe.GetAttribute("sa_cod")
                        Matrice_Variabili(2, N_Impianti) = XML_VariabiliStampe.GetAttribute("appezza")
                        Matrice_Variabili(3, N_Impianti) = XML_VariabiliStampe.GetAttribute("id_reg")
                        Matrice_Variabili(4, N_Impianti) = XML_VariabiliStampe.GetAttribute("veg_cod")
                        Id_Cod = If(IsNothing(XML_VariabiliStampe.GetAttribute("id_cod")), "", XML_VariabiliStampe.GetAttribute("id_cod"))

                        If InStr(strVeg_Cod, XML_VariabiliStampe.GetAttribute("veg_cod") & ",") = 0 AndAlso
                            XML_VariabiliStampe.GetAttribute("veg_cod") <> "0" Then
                            strVeg_Cod &= XML_VariabiliStampe.GetAttribute("veg_cod") & ","
                        End If

                        'se sa_cod=0 la stampa riguarda tutti gli impianti di tutti i centri
                        If Matrice_Variabili(1, N_Impianti) <> "0" AndAlso Not HCentri.ContainsKey(Matrice_Variabili(1, N_Impianti)) Then

                            HCentri.Add(Matrice_Variabili(1, N_Impianti), Matrice_Variabili(1, N_Impianti))

                            strFiltroCentro = String.Format(" ( Centri_Aziendali.PIVA='{0}' AND Centri_Aziendali.SA_COD={1} ) OR", XML_VariabiliStampe.GetAttribute("piva"), XML_VariabiliStampe.GetAttribute("sa_cod"))

                            strFiltroCentri = String.Format("{0}{1}", strFiltroCentri, strFiltroCentro)
                        End If

                        'se appezza=0 e id_reg=0 la stampa riguarda tutti gli impianti del centro
                        If Matrice_Variabili(2, N_Impianti) <> "0" And Matrice_Variabili(3, N_Impianti) <> "0" Then

                            strFiltroImpianto = " (Reg_Impianti.PIVA='" + XML_VariabiliStampe.GetAttribute("piva") + "' " +
                                            " AND Reg_Impianti.SA_COD=" + XML_VariabiliStampe.GetAttribute("sa_cod") +
                                            " AND Reg_Impianti.APPEZZA=" + XML_VariabiliStampe.GetAttribute("appezza") +
                                            " AND Reg_Impianti.ID_REG=" + XML_VariabiliStampe.GetAttribute("id_reg") +
                                            " ) OR"

                            strFiltroImpianti = strFiltroImpianti + strFiltroImpianto

                            strSa_Cod = strSa_Cod & Matrice_Variabili(1, N_Impianti) & ","
                            strAppezza = strAppezza & Matrice_Variabili(2, N_Impianti) & ","
                            strId_Reg = strId_Reg & Matrice_Variabili(3, N_Impianti) & ","

