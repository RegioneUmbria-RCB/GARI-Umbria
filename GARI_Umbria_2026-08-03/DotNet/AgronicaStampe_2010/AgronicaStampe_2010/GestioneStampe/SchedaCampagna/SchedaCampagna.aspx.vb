    Private Sub CaricaDSTrappole(ByVal Flag_Multicentro As Boolean, ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna, ByVal Flag_Multispecie As Boolean)

        'query x reperire i dati
        'prendo dal file di configurazione il nome del db server delle tabelle standard..
        'Dim objCDX As New Codex_Utility.Sql
        Dim objCDX As New AgronicaCoreDataProvider.DataProvider
        Dim err As String
        Dim stbQ As New System.Text.StringBuilder

        Dim App_Nome As String
        Dim Num_Appezzamento As Double
        Dim objNum As New AgronicaCoreDataProvider.UtilityProvider


        Dim i, j, c, n As Integer

        'Per Confusione Sessuale e Disorientalmento Sessuale inserisco una sola riga col numero di dispenser
        '(poichè questi non vengono reinnescati, come le trappole, ma ne vengono aggiunti dei nuovi)
        'Per Installazione Trappole e Catture di Massa inserisco tante righe quante sono le trappole
        'e ricavo poi le eventuali date di reinnesco


        Dim sw As Stopwatch = StartWatch("CaricaDSTrappole")

        'AF 08/25: non posso usare il Flag_MultiCentro perchè è sempre true
        'Mi baso sulla lista di impianti che mi arriva
        Dim isMultiCentro_daIDTestataTemp As Boolean = False
        If IDTestataTemp <> 0 Then
            Dim objTempImpianti As New __tmp_FiltroImpianti_R
            isMultiCentro_daIDTestataTemp = objTempImpianti.VerificaStampaMultiCentro(IDTestataTemp, objParametri_Server)
        End If

        stbQ.AppendLine(" SELECT DISTINCT ")
        stbQ.AppendLine("   Agenda.id_agenda, Agenda.Lav_Cod, CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) AS Data_Movimento, ")
        stbQ.AppendLine("   Operazioni.LAV_DES AS des_lib, SpecieVegetali.Veg_Des, Cultivar.Cul_Des, ")
        'stbQ.AppendLine("   Movimenti_dettagli.Qta, ")
        stbQ.AppendLine("   Appezzamento.APP_NOME, Avversita.Av_Des_Vol, Mov_Dettaglio_Tecnico.Sigla_AV, Mov_Dettaglio_Tecnico.Av_Cod, Mov_Dettaglio_Tecnico.trap_num, ")
        stbQ.AppendLine("   ISNULL(Mov_Dettaglio_Tecnico.Inn1_Data,'') AS Inn1_Data, ISNULL(Mov_Dettaglio_Tecnico.Inn2_Data,'') AS Inn2_Data, ")
        stbQ.AppendLine("   ISNULL(Mov_Dettaglio_Tecnico.Inn3_Data,'') AS Inn3_Data, ISNULL(Mov_Dettaglio_Tecnico.Inn4_Data,'') AS Inn4_Data, ")
        stbQ.AppendLine("   Movimenti_dettagli.pro_cod, trappole.trap_des, trappole.trap_dur, ")

        stbQ.AppendLine("   formulati.fr_des, ")
        stbQ.AppendLine("   CASE WHEN Agenda.Lav_Cod = " & LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA & " THEN Mov_Destinazioni.Qta ELSE Movimenti_dettagli.Qta END AS Qta, ")

        stbQ.AppendLine("   Reg_Impianti.PIVA,  ")
        stbQ.AppendLine("   CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Reg_Impianti.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale, ")
        stbQ.AppendLine("   Reg_Impianti.sa_cod, Centri_Aziendali.Sa_Nome, Reg_Impianti.appezza, Reg_Impianti.id_reg, ")

        stbQ.AppendLine("   ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici ")
        stbQ.AppendLine("           WHERE (Appezzamento_Codici.PIVA = Appezzamento.PIVA) ")
        stbQ.AppendLine("           AND (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) ")
        stbQ.AppendLine("           AND (Appezzamento_Codici.appezza = Appezzamento.appezza) ")
        stbQ.AppendLine("           AND (Appezzamento_Codici.id_cod = " & enum_CodiciAnagrafe.Riferimento_Alfanumerico_Appezzamento & ") ), '') AS App_Nome_Breve, ")
        'campo_des
        stbQ.AppendLine("   ISNULL(( SELECT TOP 1 Campi.Campo_Des " & vbCrLf)
        stbQ.AppendLine("            FROM Campi " & vbCrLf)
        stbQ.AppendLine("            WHERE Campi.Piva = Appezzamento.PIVA AND Campi.Sa_Cod = Appezzamento.SA_COD AND " & vbCrLf)
        stbQ.AppendLine("            Campi.Campo_Cod = Appezzamento.Campo_Cod " & vbCrLf)
        stbQ.AppendLine("            ),'') AS Campo_Nome, " & vbCrLf)

        stbQ.AppendLine(" ISNULL((SELECT TOP 1 Imprese_Progetti.Progetto_Nome FROM Imprese_Progetti " & vbCrLf)
        stbQ.AppendLine("       WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
        stbQ.AppendLine(" 	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
        stbQ.AppendLine(" 	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
        stbQ.AppendLine(" 	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG  " & vbCrLf)

        'se ho scelto una data unica per la stampa..
        If Qs_DataStampa <> "" Then
            stbQ.AppendLine(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            stbQ.AppendLine(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
        Else
            stbQ.AppendLine(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
            stbQ.AppendLine(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
        End If

        stbQ.AppendLine(" 	     ORDER BY Imprese_Progetti.Validita_Inizio DESC ), '') AS Lotto " & vbCrLf)

        'In caso di multicentro tiro fuori il raccoglitore_cod, per poter trovare gli impianti influenzati (SOLO PER OPERAZIONE LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA (173))
        stbQ.AppendLine(" , ISNULL(Agenda.Raccoglitore_Cod, 0) AS Raccoglitore_Cod " & vbCrLf)

        'AF 08/28: Utilizzato in caso di estrazione monocentro:
        ' se l'impianto è influenzato da altro centro, lo indico con 1 (sotto), altrimenti 0
        stbQ.AppendLine(" , 0 isInfluenzatoDaAltroCentro ")

        stbQ.AppendLine(" , Movimenti_dettagli.id_mov, Movimenti_dettagli.id_mov_det")

        stbQ.AppendLine(" FROM Avversita ")
        stbQ.AppendLine(" INNER JOIN Agenda ")
        stbQ.AppendLine(" INNER JOIN Movimenti ON ")
        stbQ.AppendLine("     Agenda.Id_Agenda = Movimenti.Id_Agenda AND Agenda.PIVA = Movimenti.PIVA AND Agenda.Sa_Cod = Movimenti.Sa_Cod ")
        stbQ.AppendLine(" INNER JOIN Movimenti_dettagli ON ")
        stbQ.AppendLine("     Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov AND Movimenti.PIVA = Movimenti_dettagli.PIVA ")
        stbQ.AppendLine(" AND Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda ")
        stbQ.AppendLine(" INNER JOIN Mov_Dettaglio_Tecnico ON ")
        stbQ.AppendLine("     Movimenti_dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov ")
        stbQ.AppendLine(" AND Movimenti_dettagli.PIVA = Mov_Dettaglio_Tecnico.Piva AND Movimenti_dettagli.Sa_Cod = Mov_Dettaglio_Tecnico.Sa_Cod ")
        stbQ.AppendLine(" AND Movimenti_dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda ")
        stbQ.AppendLine(" AND Movimenti_dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det ON Avversita.Av_Cod = Mov_Dettaglio_Tecnico.Av_Cod ")

        stbQ.AppendLine(" LEFT JOIN Trappole ON Movimenti_dettagli.Pro_Cod = Trappole.TRAP_COD ")
        stbQ.AppendLine(" LEFT JOIN Formulati ON Movimenti_dettagli.Pro_Cod = Formulati.FR_COD ")

        stbQ.AppendLine(" INNER JOIN Appezzamento ")
        stbQ.AppendLine(" INNER JOIN Mov_Destinazioni ON ")
        stbQ.AppendLine("     Appezzamento.PIVA = Mov_Destinazioni.Piva ")
        stbQ.AppendLine(" AND Appezzamento.SA_COD = Mov_Destinazioni.Sa_Cod AND Appezzamento.APPEZZA = Mov_Destinazioni.Appezza ")

        stbQ.AppendLine(" INNER JOIN Reg_Impianti ON ")
        stbQ.AppendLine("     Mov_Destinazioni.Piva = Reg_Impianti.PIVA AND Mov_Destinazioni.Sa_Cod = Reg_Impianti.SA_COD ")
        stbQ.AppendLine(" AND Mov_Destinazioni.Id_Destinazione = Reg_Impianti.ID_REG AND Mov_Destinazioni.Appezza = Reg_Impianti.APPEZZA ")

        stbQ.AppendLine(" INNER JOIN Imprese ON ")
        stbQ.AppendLine("     Reg_Impianti.Piva = Imprese.PIVA ")

        stbQ.AppendLine(" INNER JOIN Cultivar Cultivar ON Cultivar.Cul_Cod = Reg_Impianti.CUL_COD ")
        stbQ.AppendLine(" INNER JOIN SpecieVegetali SpecieVegetali ON SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva ")
        stbQ.AppendLine(" AND Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda ")
        stbQ.AppendLine(" AND Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov ")
        stbQ.AppendLine(" AND Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det ")
        stbQ.AppendLine(" INNER JOIN Operazioni ON Agenda.Lav_Cod = Operazioni.LAV_COD ")
        stbQ.AppendLine(" INNER JOIN Centri_Aziendali ON Reg_Impianti.Piva = Centri_Aziendali.Piva AND")
        stbQ.AppendLine(" Reg_Impianti.Sa_Cod = Centri_Aziendali.Sa_Cod")

        If IDTestataTemp <> 0 Then

            stbQ.AppendLine(" INNER JOIN __tmp_FiltroImpianti f ON ")
            stbQ.AppendLine("     Reg_Impianti.PIVA = f.piva ")
            stbQ.AppendLine(" AND Reg_Impianti.SA_COD = f.sa_cod ")
            stbQ.AppendLine(" AND Reg_Impianti.APPEZZA = f.appezza ")
            stbQ.AppendLine(" AND Reg_Impianti.ID_REG = f.id_reg ")
            stbQ.AppendLine(" AND f.idTestataTemp = " & IDTestataTemp)
            stbQ.AppendLine(" AND f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
            stbQ.AppendLine(" AND f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

        End If

        stbQ.AppendLine(" WHERE Agenda.Lav_Cod IN (" &
                        LAVCOD_INSTALLAZIONE_TRAPPOLE & ", " &
                        LAVCOD_CATTURE_MASSA & ", " &
                        LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA & ") ")


        'AF 08/25: per poter gestire i casi multicentro con impianti influenzati da un altro centro
        If isMultiCentro_daIDTestataTemp Then
            'Per gli impianti che sono totalmente influenzati ( Qta = 0 ), salto la riga
            stbQ.AppendLine(" AND Mov_Destinazioni.Qta > 0 ")
        Else
            'In caso di mono-centro ho bisogno di estrarre tutte le righe, altrimenti rischio di perdermi gli influenzati di queste casistiche
            'Centro A. Appezzamento 1 --> 100 trappole
            'Centro B. Appezzamento 2 --> 0 trappole

            'In un estrazione per il solo  Centro B non verrebbe mostrato che l'App 2. è influenzato al 100% da impianti di un altro centro
        End If

        If Not Flag_Multispecie Then
            If Veg_Cod = "0" Then
                stbQ.AppendLine(" AND Reg_Impianti.cul_cod = 0 ")
            Else
                If TerrenoNudoIncluso = False Then
                    stbQ.AppendLine(" AND SpecieVegetali.VEG_COD = " & Veg_Cod)
                Else
                    stbQ.AppendLine(" AND (SpecieVegetali.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) ")
                End If
            End If
        End If
        stbQ.AppendLine(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

        If Not Flag_Multicentro Then
            stbQ.Append(" AND Agenda.sa_cod = " & Sa_Cod & " ")
        End If

        'stbQ.Append(strFiltroImpianti)

        'se ho scelto una data unica per la stampa..
        If Qs_DataStampa <> "" Then

            stbQ.Append(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            stbQ.Append(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            stbQ.Append(" AND Agenda.Validita_Inizio = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
        Else

            stbQ.Append(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stbQ.Append(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")

            stbQ.Append(" AND Agenda.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stbQ.Append(" AND Agenda.Validita_Inizio >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")


        End If

        stbQ.Append(" AND Movimenti_dettagli.contabilizzato >= 0 ")

        'stbQ.Append(" ORDER BY Mov_Dettaglio_Tecnico.Inn1_Data ")

        'Tolgo il nome della tabella dai campi su cui effettuare l'ordinamento perché su alcuni DB,
        'come ad esempio quello di Cereali Ravenna, si generava un errore.
        stbQ.Append(" ORDER BY Inn1_Data ")

        Dim strErr As String 'stringa errore

        'Me.DsTrappola = New DS_Trappole

        'objCDX.SqlSelect(Session("ASG_Pathfilei..."), Session("ASG_Connessione_Server"), stbQ.ToString, Me.DsTrappola, _
        '               Me.DsTrappola.DS_Trappole.TableName, strErr)




        ' Uhalid 11/2024, vs ha automatico aggiunto un underscore davanti a DS_Trappole, investigando e' perche' il nome del xsd e della tabella e' uguale, quindi dentro lo stesso
        ' xsd c'era sia un dataset che una datatable con lo stesso nome e nelle nuove versione di vs 2019 in automatico aggiunge un underscore per gestire il conflitto tra i nomi, quindi l'ho aggiunto in tutti i posti in cui era necessario
        objCDX.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "CaricaDSTrappole", Me.DsTrappola, Me.DsTrappola._DS_Trappole.TableName)

        Dim DTInneschi As DataTable
        Dim Mov_Dettaglio_Tecnico_R As New AgronicaCoreContabDAL.Mov_Dettaglio_Tecnico_R   'New Agro_Contab_AD.Mov_Dettaglio_Tecnico_R

        Dim DTImpianti As DataTable
        Dim Mov_Destinazioni_R As New AgronicaCoreContabDAL.Mov_Destinazioni_R   'New Agro_Contab_AD.Mov_Destinazioni_R

        Dim frm_DateReinnesco() As Date

        Dim listaFormulati As New List(Of Integer)
        Dim DTFormulati As New DataTable

        For i = 0 To DsTrappola._DS_Trappole.Rows.Count - 1
            Dim drR As DS_Trappole.DS_TrappoleRow = DsTrappola._DS_Trappole.Rows(i)
            Select Case drR.lav_cod
                Case LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA
                    listaFormulati.Add(drR.pro_cod)
            End Select
        Next

        If listaFormulati.Count > 0 Then
            Dim filtroFormulati As String = "Formulati.Fr_Cod IN ( " & String.Join(",", listaFormulati) & " )"

            DTFormulati = AgronicaCoreWebService.Formulati_WS.Formulati_Elenco(Veg_Cod:=Veg_Cod,
                                                                           Dpi_Cod:="-999",
                                                                           DPI_Privato_Pubblico:=0,
                                                                           Id_Rcdpi:=0,
                                                                           Tipo_Testata:=0,
                                                                           Opt_Avversita_Infestanti:=0,
                                                                           Opt_Singola_Gruppo:=-1,
                                                                           Av_Gru:=New Integer() {0},
                                                                           Av_Cod:=New Integer() {0},
                                                                           strAvversita:="",
                                                                           Modulo:=0,
                                                                           Ep_Cod:=0,
                                                                           TipoRichiesto:=enum_TipoFormulato.InstallazioneTrappoleCattureMassa,
                                                                           TestoRicerca:="",
                                                                           Validita_Fine:=AGRODATAFINE,
                                                                           strFiltro:=filtroFormulati,
                                                                           Grfi_cod:=0,
                                                                           strListaComuni:="",
                                                                           FormulatiXAllegatiNormative_IDRiga:=0,
                                                                           Copertura:="",
                                                                           Stato_Cod:="",
                                                                           Lingua_Cod:=objParametri_Server.Lingua_Cod,
                                                                           objParametri_Super_Server,
                                                                           objParametri_Server,
                                                                           objParametri_Utenti,
                                                                           strErr)
        End If

        If Not isMultiCentro_daIDTestataTemp Then
            'AF 08/25: trovo tutte le operazioni che hanno il raccoglitore_cod valorizzato (quindi multicentro)
            'Per trovare tutti gli impianti influenzati da un altro centro (che non compaiono dalla select)

            'Centro A. Appezzamento 1 --> 100 trappole
            'Centro B. Appezzamento 2 --> 0 trappole
            'In un estrazione per il solo  Centro B non verrebbe mostrato che l'App 2. è influenzato al 100% da impianti di un altro centro


            Dim risultatoRaggruppamentoRaccoglitori = (From row In DsTrappola._DS_Trappole.AsEnumerable()
                                                       Where Not IsDBNull(row("Raccoglitore_Cod")) AndAlso
                                              row("Raccoglitore_Cod") <> 0 AndAlso
                                              Not IsDBNull(row("Qta"))
                                                       Group row By Raccoglitore = row.Field(Of Integer)("Raccoglitore_Cod") Into Group
                                                       Select New With {
                                             .Raccoglitore_Cod = Raccoglitore,
                                             .TotaleQta = Group.Sum(Function(x) Convert.ToDecimal(x("Qta"))),
                                             .NumeroRighe = Group.Count()
                                          }).ToList()
            Dim raccoglitoriConQtaZero = (From item In risultatoRaggruppamentoRaccoglitori
                                          Where item.TotaleQta = 0
                                          Select item).ToList()
            Dim raccoglitoriConQtaMaggioreZero = (From item In risultatoRaggruppamentoRaccoglitori
                                                  Where item.TotaleQta <> 0
                                                  Select item).ToList()

            'Lascio una sola riga per ogni raccoglitore_cod
            For Each item In raccoglitoriConQtaZero
                Dim counter As Integer = 1
                Do While counter < item.NumeroRighe
                    Dim rowDaRimuovere = (From row In DsTrappola._DS_Trappole.AsEnumerable()
                                          Where Not IsDBNull(row("Raccoglitore_Cod")) AndAlso
                                              row("Raccoglitore_Cod") = item.Raccoglitore_Cod
                                          Select row).FirstOrDefault()
                    DsTrappola._DS_Trappole.Rows.Remove(rowDaRimuovere)
                    counter += 1
                Loop

                'A questo punto mi segno l'ultimo impianto rimasto con qta 0, per poi andare a segnarlo come influenzato da altro centro
                Dim rowDaAggiornare = (From row In DsTrappola._DS_Trappole.AsEnumerable()
                                       Where Not IsDBNull(row("Raccoglitore_Cod")) AndAlso
                                           row("Raccoglitore_Cod") = item.Raccoglitore_Cod
                                       Select row).FirstOrDefault()
                rowDaAggiornare("isInfluenzatoDaAltroCentro") = 1
            Next

            'Per i raccoglitori con qta maggiore di 0 (casi misti, dove le trappole su sono più impianti), elimino tutte le righe con qta = 0
            For Each item In raccoglitoriConQtaMaggioreZero
                Dim rowsDaRimuovere = (From row In DsTrappola._DS_Trappole.AsEnumerable()
                                       Where Not IsDBNull(row("Raccoglitore_Cod")) AndAlso
                                          row("Raccoglitore_Cod") = item.Raccoglitore_Cod AndAlso
                                              Not IsDBNull(row("Qta")) AndAlso
                                           row("Qta") = 0
                                       Select row).ToList()

                If rowsDaRimuovere IsNot Nothing Then
                    For Each row In rowsDaRimuovere
                        DsTrappola._DS_Trappole.Rows.Remove(row)
                    Next
                End If
            Next


            'Faccio la stessa cosa per i casi con raccoglitore_cod = 0 (quindi operazioni mono-centro)
            'A causa della mancanza del filtro Mov_Destinazioni.Qta > 0
            Dim risultatoAgendeQta0 = (From row In DsTrappola._DS_Trappole.AsEnumerable()
                                       Where Not IsDBNull(row("Raccoglitore_Cod")) AndAlso
                                          row("Raccoglitore_Cod") = 0 AndAlso
                                              Not IsDBNull(row("Qta")) AndAlso
                                           row("Qta") = 0
                                       Select row).ToList()
            If risultatoAgendeQta0 IsNot Nothing Then
                For Each row In risultatoAgendeQta0
                    DsTrappola._DS_Trappole.Rows.Remove(row)
                Next
            End If

            ' Accertati di accettare le modifiche per aggiornare il DataTable
            DsTrappola._DS_Trappole.AcceptChanges()

        End If

        For i = 0 To DsTrappola._DS_Trappole.Rows.Count - 1


            'richiamo la funzione x ottenere la seconda data di innesco
            Dim drR As DS_Trappole.DS_TrappoleRow = DsTrappola._DS_Trappole.Rows(i)

            Dim currentFormulato As DataRow = Nothing
            If drR.lav_cod = LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA Then
                currentFormulato = DTFormulati.Select("fr_cod = " & drR.pro_cod).FirstOrDefault()
                drR.trap_des = currentFormulato.Item("fr_des") & " (" & drR.pro_cod & ")"
            End If

            DsTrappola._DS_Trappole.Rows(i).Item("Data_Movimento") = Formatta_Data_Movimento(DsTrappola._DS_Trappole.Rows(i).Item("Data_Movimento"))

            'Per le Installazione Trappole estraggo le date dei Reinneschi 
            Select Case drR.lav_cod

                Case LAVCOD_INSTALLAZIONE_TRAPPOLE, LAVCOD_CATTURE_MASSA, LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA


                    Select Case drR.lav_cod
                        Case LAVCOD_INSTALLAZIONE_TRAPPOLE, LAVCOD_CATTURE_MASSA

                            drR.qta = 1

                            Dim ord As String = " Data_Movimento, Sigla_AV, Trap_Num ASC "

                            Dim filtro As String = " Trap_Num = " & drR.Trap_Num & " AND av_cod = " & drR.av_cod

                            DTInneschi = Mov_Dettaglio_Tecnico_R.Last_TrapNum(CStr(drR.piva),
                                        CInt(drR.sa_cod),
                                        CStr(drR.sigla_av),
                                            AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_JoinCompleta,
                                        filtro, ord, objParametri_Server)

                            If Not IsNothing(DTInneschi) Then

                                'Se il recordset non e' vuoto ...
                                If DTInneschi.Rows.Count <> 0 Then

                                    j = 0
                                    For j = 0 To DTInneschi.Rows.Count - 1

                                        'movimenti destinazione
                                        DTImpianti = Mov_Destinazioni_R.Leggi(CStr(drR.piva),
                                                                    CInt(drR.sa_cod),
                                                                    CInt(DTInneschi.Rows(j).Item("Id_Agenda")),
                                                                    CInt(DTInneschi.Rows(j).Item("Id_Mov")),
                                                                    CInt(DTInneschi.Rows(j).Item("Id_Mov_Det")),
                                                                    CInt(drR.appezza),
                                                                    CInt(drR.id_reg), 0, AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)

                                        If Not IsNothing(DTImpianti) Then

                                            If DTImpianti.Rows.Count <> 0 Then

                                                If DTImpianti.Rows.Count <> 0 Then


                                                    Select Case j

                                                        Case 0
                                                            If Not IsNothing(DTInneschi.Rows(j).Item("inn1_data")) Then
                                                                drR.inn1_data = DTInneschi.Rows(j).Item("inn1_data")
                                                            End If
                                                        Case 1
                                                            If Not IsNothing(DTInneschi.Rows(j).Item("inn1_data")) Then
                                                                drR.inn2_data = DTInneschi.Rows(j).Item("inn1_data")
                                                            End If

                                                        Case 2
                                                            If Not IsNothing(DTInneschi.Rows(j).Item("inn1_data")) Then
                                                                drR.inn3_data = DTInneschi.Rows(j).Item("inn1_data")
                                                            End If

                                                        Case 3
                                                            If Not IsNothing(DTInneschi.Rows(j).Item("inn1_data")) Then
                                                                drR.inn4_data = DTInneschi.Rows(j).Item("inn1_data")
                                                            End If

                                                    End Select

                                                End If

                                            End If

                                        End If

                                    Next

                                End If

                            End If

                        Case Else
                            'per LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA la dose va a /ha, quindi prendiamo quella salvata in DB

                            Dim objMov_Dettagli As New AgronicaCoreContabDAL.Movimenti_Dettagli_R

                            Dim DTMovi As DataTable = objMov_Dettagli.OttieniStoricoInstallazioneReinneschi(drR.piva, drR.sa_cod, drR.Id_Agenda,
                                                                                                            drR.id_mov, drR.id_mov_det, "", "", objParametri_Server)

                            If Not IsNothing(DTMovi) AndAlso DTMovi.Rows.Count > 0 Then

                                drR.inn1_data = DTMovi.Rows(0).Item("Data_Installazione")

                                Dim x As Integer = 0

                                For x = 0 To DTMovi.Rows.Count - 1

                                    Select Case x

                                        Case 0
                                            If Not IsNothing(DTMovi.Rows(x).Item("Data_Reinnesco")) AndAlso DTMovi.Rows(x).Item("Data_Reinnesco") <> AGRODATAINIZIO Then
                                                drR.inn2_data = DTMovi.Rows(x).Item("Data_Reinnesco")
                                            End If

                                        Case 1
                                            If Not IsNothing(DTMovi.Rows(x).Item("Data_Reinnesco")) AndAlso DTMovi.Rows(x).Item("Data_Reinnesco") <> AGRODATAINIZIO Then
                                                drR.inn3_data = DTMovi.Rows(x).Item("Data_Reinnesco")
                                            End If

                                        Case 2
                                            If Not IsNothing(DTMovi.Rows(x).Item("Data_Reinnesco")) AndAlso DTMovi.Rows(x).Item("Data_Reinnesco") <> AGRODATAINIZIO Then
                                                drR.inn4_data = DTMovi.Rows(x).Item("Data_Reinnesco")
                                            End If

                                    End Select
                                Next

                            End If
                    End Select

                    drR.sigla_av = drR.sigla_av & " : " & drR.Trap_Num

                    'Visualizza la Specie e la Varietà insieme
                    drR.veg_des_e_cul_des = drR.veg_des & " " & drR.cul_des

                    'Visualizzo solo la data e non anche l'ora
                    If Not IsDBNull(drR.inn1_data) AndAlso Not String.IsNullOrEmpty(drR.inn1_data) Then
                        drR.inn1_data = CDate(drR.inn1_data).ToShortDateString
                    End If

                    If Not IsDBNull(drR.inn2_data) AndAlso Not String.IsNullOrEmpty(drR.inn2_data) Then
                        drR.inn2_data = CDate(drR.inn2_data).ToShortDateString
                    End If

                    If Not IsDBNull(drR.inn3_data) AndAlso Not String.IsNullOrEmpty(drR.inn3_data) Then
                        drR.inn3_data = CDate(drR.inn3_data).ToShortDateString
                    End If

                    If Not IsDBNull(drR.inn4_data) AndAlso Not String.IsNullOrEmpty(drR.inn4_data) Then
                        drR.inn4_data = CDate(drR.inn4_data).ToShortDateString
                    End If
            End Select

            Dim durataTrappola As Long = 0

            Select Case drR.lav_cod
                Case LAVCOD_INSTALLAZIONE_TRAPPOLE, LAVCOD_CATTURE_MASSA
                    durataTrappola = drR.trap_dur
                Case LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA
                    If currentFormulato IsNot Nothing Then
                        durataTrappola = If(IsDBNull(currentFormulato.Item("DurataFeromone")), 0, currentFormulato.Item("DurataFeromone"))
                    End If
            End Select

            'imposto la data di scadenza....
            If (Not IsDBNull(drR.inn4_data)) AndAlso (CDate(drR.inn4_data).ToShortDateString <> "01/01/1900") Then
                'aggiungo la durata della trappola alla data di innesco 4....
                drR.scadenza = CDate(drR.inn4_data).AddDays(durataTrappola).ToShortDateString
            Else
                If (Not IsDBNull(drR.inn3_data)) AndAlso (CDate(drR.inn3_data).ToShortDateString <> "01/01/1900") Then
                    'aggiungo la durata della trappola alla data di innesco 3....
                    drR.scadenza = CDate(drR.inn3_data).AddDays(durataTrappola).ToShortDateString
                Else
                    If (Not IsDBNull(drR.inn2_data)) AndAlso (CDate(drR.inn2_data).ToShortDateString <> "01/01/1900") Then
                        'aggiungo la durata della trappola alla data di innesco 2....
                        drR.scadenza = CDate(drR.inn2_data).AddDays(durataTrappola).ToShortDateString
                    ElseIf Not IsDBNull(drR.inn1_data) Then 'altrimenti scadenza in riferimento alla 
                        'prima installazione
                        'aggiungo la durata della trappola alla data di innesco 1....
                        drR.scadenza = CDate(drR.inn1_data).AddDays(durataTrappola).ToShortDateString
                    End If
                End If
            End If

            If CDate(drR.inn4_data).ToShortDateString = "01/01/1900" Then
                drR.inn4_data = ""
            End If

            If CDate(drR.inn3_data).ToShortDateString = "01/01/1900" Then
                drR.inn3_data = ""
            End If

            If CDate(drR.inn2_data).ToShortDateString = "01/01/1900" Then
                drR.inn2_data = ""
            End If

            'controllo su appezza..
            'se il nome dell'appezzamento contiene un numero indico questo
            'altrimenti lascio appezza-basecode

            DsTrappola._DS_Trappole.Rows(i).Item("App_Nome_Breve") = CodiceAppezzamento(DsTrappola._DS_Trappole.Rows(i).Item("piva"),
                                                                                       DsTrappola._DS_Trappole.Rows(i).Item("sa_cod"),
                                                                                       DsTrappola._DS_Trappole.Rows(i).Item("Campo_Nome"),
                                                                                       DsTrappola._DS_Trappole.Rows(i).Item("appezza"),
                                                                                       TipoCodAppezzamento,
                                                                                       DsTrappola._DS_Trappole.Rows(i).Item("app_nome"),
                                                                                       DsTrappola._DS_Trappole.Rows(i).Item("App_Nome_Breve"), -1,
                                                                                       lotto:=DsTrappola._DS_Trappole.Rows(i).Item("Lotto"))

            '----------------------------------------------
            'per id consociazione
            Try

                Dim objImp As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
                Dim ID_Consociazione As Integer
                Dim Tot_Consociati As Integer
                Dim Sigla_Consociazione As String
                If ControllaProgressivoConsociazione(drR.piva, drR.sa_cod, drR.appezza, drR.id_reg, ID_Consociazione, Tot_Consociati, Sigla_Consociazione, objParametri_Server) Then
                    drR.App_Nome_Breve &= "/" & Sigla_Consociazione & ""
                    drR.App_Nome_Breve &= "/" & ID_Consociazione & ""
                End If

            Catch ex As Exception

            End Try

            '----------------------------------------------

        Next

        Dim strAppezzamenti As String
        Dim w, s As Integer
        Dim Qta As Double

        If TipoReport = enum_TipoReport.SchedaCampagna_Semplificata Or TipoReport = enum_TipoReport.SchedaCampagna_ConserveItalia _
            Or TipoReport = enum_TipoReport.Eurep_Gap_Semplificata Or TipoReport = enum_TipoReport.Prov_Aut_Trento _
            Or TipoReport = enum_TipoReport.SchedaCampagna_Multicentro_ACA Or TipoReport = enum_TipoReport.Eurep_Gap_Multicentro Then

            Dim objSqlDis As New AgronicaCoreDataProvider.DatatableUtility

            'ottengo gli id_agenda e gli app_nome distinti
            Dim strId_Agenda() As String = objSqlDis.SelectDistinct(DsTrappola._DS_Trappole, "id_agenda")
            Dim strApp() As String = objSqlDis.SelectDistinct(DsTrappola._DS_Trappole, "APPEZZA")

            If Not strId_Agenda Is Nothing Then

                For i = 0 To strId_Agenda.Length - 1

                    inserisciTraGliIdAgendaMovimentati(strId_Agenda(i))

                    Dim drLav() As DS_Trappole.DS_TrappoleRow = DsTrappola._DS_Trappole.Select("id_agenda=" & strId_Agenda(i))

                    If drLav(0).lav_cod = LAVCOD_CONFUSIONE_SESSUALE Or drLav(0).lav_cod = LAVCOD_DISORIENTAMENTO_SESSUALE Then

                        strAppezzamenti = ""
                        Qta = 0

                        For w = 0 To strApp.Length - 1
                            Dim drAppezza() As DS_Trappole.DS_TrappoleRow = DsTrappola._DS_Trappole.Select("id_agenda=" & strId_Agenda(i) & " AND APPEZZA='" & strApp(w) & "'")
                            If drAppezza.Length > 0 Then
                                'strAppezzamenti &= drAppezza(0).app_nome & ", "
                                strAppezzamenti &= drAppezza(0).App_Nome_Breve & ", "
                                Qta += drAppezza(0).qta
                            End If
                        Next

                        If strAppezzamenti <> "" Then
                            strAppezzamenti = Left(strAppezzamenti, strAppezzamenti.Length - 2)
                        End If

                        'drLav(0).app_nome = strAppezzamenti
                        drLav(0).App_Nome_Breve = strAppezzamenti
                        drLav(0).qta = CInt(Qta)

                        For j = 1 To drLav.Length - 1

                            'Se la lavorazione è la stessa (le righe degli appezzamenti diversi sono identiche) 
                            'setto la Cul_Des =-1 x cancellarlo poi..
                            'N.B. La scelta del campo Cul_Des è casuale,è stato scelto xkè nn utilizzato nel sottoreport
                            If drLav(j).Id_Agenda = drLav(j - 1).Id_Agenda And
                                drLav(j).data_movimento = drLav(j - 1).data_movimento And
                                drLav(j).lav_cod = drLav(j - 1).lav_cod Then

                                drLav(j).cul_des = "-1"

                            End If

                        Next

                    End If

                Next


                For s = 0 To DsTrappola._DS_Trappole.Count - 1
                    If Not IsDBNull(DsTrappola._DS_Trappole.Rows(s).Item("cul_des")) Then
                        If DsTrappola._DS_Trappole.Rows(s).Item("cul_des") = "-1" Then
                            DsTrappola._DS_Trappole.Rows(s).Delete()
                        End If
                    End If

                Next

            End If

        End If


        '-------------------------------------------------------------
        '------------- per trappole multi impianto----------------------
        '-------------------------------------------------------------
        '-------------------------------------------------------------
        'richiamo la funzione x ottenere la seconda data di innesc

        For i = 0 To DsTrappola._DS_Trappole.Rows.Count - 1
            Dim drR2 As DS_Trappole.DS_TrappoleRow = DsTrappola._DS_Trappole.Rows(i)

            'Per le Installazione Trappole e catture aggiungo imp coinvolti 
            Select Case drR2.lav_cod

                Case LAVCOD_INSTALLAZIONE_TRAPPOLE, LAVCOD_CATTURE_MASSA, LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA

                    '-------------------------------------------------------------
                    '------------------aggiunta per trappole multiimpianto--------
                    '-------------------------------------------------------------
                    'Solo per installazione trappole e catture di massa,  lav_cod 107, 122
                    'canfusione e disorientamento non hanno infatte una trappola identificata 
                    'e con influenza suddivisa tra piu impianti, ma molter trappole ripartire
                    '-------------------------------------------------------------
                    'devo cercare tutti gli impianti influenzati  nella trappola. 
                    'quindi per ciascuna di tutte le trappole dei movimenti agenda 
                    'di installazione e catture devo associare  tutti gli impianti del movimento destinaz collegato
                    '-------------------------------------------------------------
                    'per ciascuna trappola univoca, letta nel movimento dettaglio tecnico, 
                    'metto in join con le destinazioni che hanno lo stesso id agenda e
                    'lo stesso id_movimento (altrimento prendo anche gli scarichi e gli altri movimenti)
                    '
                    Dim Appezzamento_Read As New AgronicaCoreAnagrafeDAL.Appezzamento_Read
                    Dim avversitaread As New AgronicaCoreMetaSchemaDAL.Avversita_R
                    Dim Dt_Trappole_X_Impianti As New DataTable

                    Select Case drR2.lav_cod
                        Case LAVCOD_INSTALLAZIONE_TRAPPOLE, LAVCOD_CATTURE_MASSA
                            'la sigla avversità l'ha manipolata, aggiungendoci dei caratteri,
                            'quindi occorre ricavarla dal codice
                            Dim sigl As String = avversitaread.Abbreviazione_from_AvCod(CInt(drR2.av_cod), objParametri_Server)
                            Dt_Trappole_X_Impianti = Mov_Dettaglio_Tecnico_R.Trappole_107122_X_ImpiantiInfluenza(
                                                     CStr(drR2.piva),
                                                     CInt(drR2.sa_cod),
                                                     sigl,
                                                     CInt(drR2.Trap_Num),
                                                     "",
                                                     "",
                                                     objParametri_Server, True, True)
                        Case LAVCOD_INSTALLAZIONE_TRAPPOLE_CATTURE_MASSA
                            'AF 08/25: per poter gestire i casi multicentro:
                            'Tolto filtro Sa_Cod
                            'Aggiunto filtro Raccoglitore_Cod, da alternare al filtro secco Id_Agenda
                            'Multicentro --> Filtro solo Raccoglitore_Cod
                            'Monocentro --> Filtro solo Id_Agenda
                            Dt_Trappole_X_Impianti = Mov_Dettaglio_Tecnico_R.Trappole_Formulati_X_ImpiantiInfluenza(
                                                     CStr(drR2.piva),
                                                     0,
                                                     If(isMultiCentro_daIDTestataTemp, 0, CInt(drR2.Id_Agenda)),
                                                     If(isMultiCentro_daIDTestataTemp, CInt(drR2.Item("Raccoglitore_Cod")), 0),
                                                     CInt(drR2.pro_cod),
                                                     "",
                                                     "",
                                                     objParametri_Server, EstraiLotto:=True)
                    End Select

                    Dim isInfluenzatoDaAltroCentro As Integer = drR2.Item("isInfluenzatoDaAltroCentro")
                    Dim stessoCentro As Boolean = drR2.Item("Raccoglitore_Cod") = 0

                    Dim ListaImpiantiInfluenzati As New List(Of String)
                    If Dt_Trappole_X_Impianti.Rows.Count > 1 Then
                        Dim AppxTrappola_Piva As String = drR2.piva
                        Dim AppxTrappola_SaCod As Integer = drR2.sa_cod
                        Dim AppxTrappola_Appezza As Integer = drR2.appezza

                        For Each impianto In Dt_Trappole_X_Impianti.Rows
                            'Leggo solo le descrizioni degli impianti INFLUENZATI, escludendo quello dove è installata la trappola
                            If impianto.Item("Azienda") <> AppxTrappola_Piva OrElse
                                    impianto.Item("Centro_Aziendale") <> AppxTrappola_SaCod OrElse
                                    impianto.Item("Imp_Influ_Appezza") <> AppxTrappola_Appezza OrElse
                                    isInfluenzatoDaAltroCentro = 1 Then
                                ListaImpiantiInfluenzati.Add(CodiceAppezzamento(impianto.Item("Azienda"),
                                                                            impianto.Item("Centro_Aziendale"),
                                                                            impianto.Item("campo_des"),
                                                                            impianto.Item("Imp_Influ_Appezza"),
                                                                            TipoCodAppezzamento,
                                                                            impianto.Item("app_nome"),
                                                                            impianto.Item("App_Nome_Breve"), -1,
                                                                            lotto:=impianto.Item("Lotto"))
                                                         )
                            End If
                        Next
                    End If

                    'aggiungo l'info sugli impianti influenzati se sono piu di uno, quindi se ci sono piu 
                    'impianti oltre quello di installazione
                    If Dt_Trappole_X_Impianti.Rows.Count > 1 Then
                        'Concateno le descrizioni degli impianti influenzati
                        Dim listaImpiantiString As String = String.Join(", ", ListaImpiantiInfluenzati.Distinct().ToList())

                        Dim nomeattuale As String = DsTrappola._DS_Trappole.Rows(i).Item("App_Nome_Breve")
                        If isInfluenzatoDaAltroCentro Then
                            DsTrappola._DS_Trappole.Rows(i).Item("App_Nome_Breve") = listaImpiantiString & " (Giustificati da altro centro)"
                        Else
                            DsTrappola._DS_Trappole.Rows(i).Item("App_Nome_Breve") = nomeattuale & " (Giustificati:" & listaImpiantiString & ")"
                        End If
                    ElseIf isInfluenzatoDaAltroCentro = 1 Then
                        Dim nomeattuale As String = DsTrappola._DS_Trappole.Rows(i).Item("App_Nome_Breve")
                        DsTrappola._DS_Trappole.Rows(i).Item("App_Nome_Breve") = nomeattuale & " (Giustificato da altro centro)"
                    End If
            End Select

        Next

        '-------------------------------------------------------------
        '-------------------------------------------------------------
        '-------------------------------------------------------------
        '-------------------------------------------------------------

        'rendo permanenti le modifiche sul ds
        DsTrappola._DS_Trappole.AcceptChanges()

        DsTrappola._DS_Trappole.Columns("Piva").ColumnName = "Piva_old"
        DsTrappola._DS_Trappole.Columns("PivaReale").ColumnName = "Piva"
        DsTrappola._DS_Trappole.Columns("Piva_old").ColumnName = "PivaReale"

        EndWatch(sw, "CaricaDsTrappole")

        ' End If

    End Sub

