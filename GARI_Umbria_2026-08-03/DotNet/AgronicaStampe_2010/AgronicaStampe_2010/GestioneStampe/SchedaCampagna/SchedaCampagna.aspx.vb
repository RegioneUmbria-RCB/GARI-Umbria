    Public Sub CaricaDsBlank(ByVal nRighe As Integer)

        Dim Riga As DS_Blank.BlankRow
        Dim i As Integer
        Dim Anno As String

        Anno = Ricava_Anno(Qs_DataStampa, Qs_DataInizio, Qs_DataFine)

        For i = 0 To nRighe - 1
            'Creo la nuova riga
            Riga = DSBlank.Blank.NewBlankRow()

            Riga.Blank_ID = 0
            Riga.Blank_Value = ""
            Riga.Blank_Year = Anno

            DSBlank.Blank.Rows.Add(Riga)
        Next

    End Sub


