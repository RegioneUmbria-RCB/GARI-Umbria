                                                    'non andrà bene la visualizzazione ma almeno non va in crash
                                                    Dose = CDec(DrProdotto(0).Item("qta"))
                                                    Udm_Des = " " & Udm_Des.Trim.Replace(" ", "_")

                                            End Select


                                            '07/11/2018: sistemato l'arrotondamento
                                            Select Case Lav_Cod

                                                Case LAVCOD_DISTRIBUZIONE_AMMENDANTI, LAVCOD_DISTRIBUZIONE_CONCIME, LAVCOD_SARCHIATURA_CONCIMAZIONE
                                                    '124 concimazione organica, 14 concimazione campo, 156 LAVCOD_SARCHIATURA_CONCIMAZIONE

                                                    Select Case CInt(DrProdotto(0).Item("mezzo"))
                                                        Case 0     'qtà totale
                                                            Qta_Tot = Dose * (Sup_TrattataTot / Sup_TrattataTot_Operazione)
                                                            'Dose_Tot = Math.Round(Dose * (Sup_TrattataTot / Sup_TrattataTot_Operazione), 3)
                                                            'Dose_Ha = Math.Round(Dose / Sup_TrattataTot_Operazione, 3) & Udm_Des & "/ha"
                                                            If CInt(Qs_arrotonda) <> -1 Then
                                                                Dose_Tot = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal((Dose * (Sup_TrattataTot / Sup_TrattataTot_Operazione)), CInt(Qs_arrotonda), True)
                                                                Dose_Ha = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal((Dose / Sup_TrattataTot_Operazione), CInt(Qs_arrotonda)) & Udm_Des & "/ha"
                                                            Else
                                                                Dose_Tot = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal_3((Dose * (Sup_TrattataTot / Sup_TrattataTot_Operazione)), True)
                                                                Dose_Ha = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal_3((Dose / Sup_TrattataTot_Operazione)) & Udm_Des & "/ha"
                                                            End If
                                                        Case 1  'qtà x ettaro
                                                            Qta_Tot = Dose * Sup_TrattataTot
                                                            ' Dose_Tot = Math.Round(Dose * Sup_TrattataTot, 3)
                                                            ' Dose_Ha = Math.Round(Dose, 3) & Udm_Des & "/ha"
                                                            If CInt(Qs_arrotonda) <> -1 Then
                                                                Dose_Tot = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal((Dose * Sup_TrattataTot), CInt(Qs_arrotonda), True)
                                                                Dose_Ha = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(Dose, CInt(Qs_arrotonda)) & Udm_Des & "/ha"
                                                            Else
                                                                Dose_Tot = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal_3((Dose * Sup_TrattataTot), True)
                                                                Dose_Ha = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal_3(Dose) & Udm_Des & "/ha"
                                                            End If
                                                    End Select

                                                Case Else  'concimazione fogliare, fertirrigazione

                                                    Select Case CInt(DrProdotto(0).Item("mezzo"))
                                                        Case 0   'qtà x ettolitro
                                                            Qta_Tot = Dose * Acqua
                                                            'Dose_Tot = Math.Round(Dose * Acqua, 3)
                                                            'Dose_Ha = Math.Round(Dose, 3) & Udm_Des & "/hl"
                                                            If CInt(Qs_arrotonda) <> -1 Then
                                                                Dose_Tot = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal((Dose * Acqua), CInt(Qs_arrotonda), True)
                                                                Dose_Ha = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(Dose, CInt(Qs_arrotonda)) & Udm_Des & "/hl"
                                                            Else
                                                                Dose_Tot = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal_3((Dose * Acqua), True)
                                                                Dose_Ha = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal_3(Dose) & Udm_Des & "/hl"
                                                            End If
                                                        Case 1  'qtà x ettaro
                                                            Qta_Tot = Dose * Sup_TrattataTot
                                                            ' Dose_Tot = Math.Round((Dose * Sup_TrattataTot), 3)
                                                            ' Dose_Ha = Math.Round(Dose, 3) & Udm_Des & "/ha"
                                                            If CInt(Qs_arrotonda) <> -1 Then
                                                                Dose_Tot = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal((Dose * Sup_TrattataTot), CInt(Qs_arrotonda), True)
                                                                Dose_Ha = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(Dose, CInt(Qs_arrotonda)) & Udm_Des & "/ha"
                                                            Else
                                                                Dose_Tot = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal_3(Dose * Sup_TrattataTot, True)
                                                                Dose_Ha = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal_3(Dose) & Udm_Des & "/ha"
                                                            End If
                                                    End Select

                                            End Select

                                            'creo la stringa del titolo
                                            N = DrProdotto(0).Item("N")
                                            P = DrProdotto(0).Item("P2O5")
                                            K = DrProdotto(0).Item("K2O")

                                            Titolo = N & " + " & P & " + " & K
                                            Efficienza = DrProdotto(0).Item("Efficienza")

                                            If CInt(DrProdotto(0).Item("Extra_Int")) = enum_UnitaMisura.Metri_Cubi Then  'mc
                                                Qta_Tot = Qta_Tot * 1000
                                            End If

                                            If CDec(Efficienza) < 1 Then
                                                N_Tot = Qta_Tot * (N * CDec(Efficienza)) / 100
                                            Else
                                                N_Tot = Qta_Tot * (N / 100)
                                            End If
                                            P_Tot = Qta_Tot * (P / 100)
                                            K_Tot = Qta_Tot * (K / 100)

                                        End If

                                        RigaDs.FER_DES = Prodotto
                                        RigaDs.Ordinamento_Prodotto = Prodotto
                                        RigaDs.Titolo = Titolo
                                        RigaDs.Qta_1 = Dose_Tot
                                        RigaDs.UDM_DES = Udm_Des
                                        RigaDs.Efficienza = Efficienza
                                        If CInt(Qs_arrotonda) <> -1 Then
                                            ' RigaDs.N = Math.Round(CDec(N), CInt(Qs_arrotonda))
                                            'RigaDs.P2O5 = Math.Round(CDec(P), CInt(Qs_arrotonda))
                                            'RigaDs.K2O = Math.Round(CDec(K), CInt(Qs_arrotonda))
                                            'RigaDs.N_1 = Math.Round(CDec(N_Tot), CInt(Qs_arrotonda))
                                            'RigaDs.P2O5_1 = Math.Round(CDec(P_Tot), CInt(Qs_arrotonda))
                                            'RigaDs.K2O_1 = Math.Round(CDec(K_Tot), CInt(Qs_arrotonda))
                                            'i campi del dataset sono double non decimal però...
                                            RigaDs.N = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(N, CInt(Qs_arrotonda))
                                            RigaDs.P2O5 = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(P, CInt(Qs_arrotonda))
                                            RigaDs.K2O = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(K, CInt(Qs_arrotonda))
                                            RigaDs.N_1 = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(N_Tot, CInt(Qs_arrotonda))
                                            RigaDs.P2O5_1 = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(P_Tot, CInt(Qs_arrotonda))
                                            RigaDs.K2O_1 = AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(K_Tot, CInt(Qs_arrotonda))
                                        Else
                                            RigaDs.N = N
                                            RigaDs.P2O5 = P
                                            RigaDs.K2O = K
                                            RigaDs.N_1 = N_Tot
                                            RigaDs.P2O5_1 = P_Tot
                                            RigaDs.K2O_1 = K_Tot
                                        End If

                                        '07/11/2018: fabri ha deliberato di arrotondare a 4 fino alle centiare
                                        'RigaDs.Sup_Trattata = CStr(Math.Round(Sup_TrattataTot, 3)) 'Sup_TrattataTot
                                        RigaDs.Sup_Trattata = CStr(AgronicaCoreDataProvider.Agro_Math.ArrotondaVal(Sup_TrattataTot, CInt(Qs_arrotonda)))

                                        RigaDs.Qta_Ril = Acqua

                                        DSConcime._DS_Concime.Rows.Add(RigaDs)

                                    End If

                                Next

                            End If


                        End If

                    Next

                End If

                '--------------------------------------------------------------------------------------
                'ORDINO IL DATASET
                '(per farlo importo nell'ordine le datarow ordinate e poi elimino le vecchie righe)
                '--------------------------------------------------------------------------------------
                Select Case tipo_ordinamento
                    Case 1

                        Dim Righe_Old As Integer
                        Righe_Old = DSConcime._DS_Concime.Count

                        If Righe_Old > 1 Then

                            ''questo metodo non funziona perchè gli rimangono i riferimenti al dataset, quindi non importa nulla
                            'Dim VetDr() As DataRow
                            'VetDr = DSConcime.DS_Concime.Select("", "veg_des, Data_creazione, Id_Agenda, Fer_Des, APP_NOME")

                            ''cancello tante volte quante sono le righe del ds
                            ''la riga a indice 0 (visto che ogni volta vengono cancellate righe non si può usare i come indice)
                            'For i = 0 To Righe_Old - 1
                            '    DSConcime.DS_Concime.Rows(0).Delete()
                            'Next

                            'For j = 0 To VetDr.Count - 1
                            '    DSConcime.DS_Concime.ImportRow(VetDr(j))
                            'Next

                            ''non funziona
                            'Dim VetDr() As DS_Concime.DS_ConcimeRow

                            'VetDr = DSConcime.DS_Concime.Select("", "veg_des, Data_creazione, Id_Agenda, Fer_Des, APP_NOME")

                            'For j = 0 To VetDr.Count - 1
                            '    'valore fittizio per marcare quelle da non cancellare
                            '    VetDr(j).Epoca_Cod = -666
                            '    DSConcime.DS_Concime.ImportRow(VetDr(j))
                            'Next

                            'For i = 0 To DSConcime.DS_Concime.Rows.Count - 1
                            '    If DSCatasto._DS_Catasto.Rows(i).Item("epoca_cod") <> -666 Then
                            '        DSCatasto._DS_Catasto.Rows(i).Delete()
                            '    End If
                            'Next

                            'For Each dr In DSConcime.DS_Concime.Select("", "veg_des, Data_creazione, Fer_Des, APP_NOME")
                            For Each dr In DSConcime._DS_Concime.Select("", "Ordinamento_Coltura, Ordinamento_Data, Ordinamento_Prodotto,  Ordinamento_AppezzaNomeBreve")
                                DSConcime._DS_Concime.ImportRow(dr)
                            Next

                            'è importante fare questa istruzione prima del delete!!!!
                            'rendo permanenti le modifiche sul ds
                            DSConcime._DS_Concime.AcceptChanges()

                            For i = 0 To Righe_Old - 1
                                DSConcime._DS_Concime.Rows(i).Delete()
                            Next

                            'rendo permanenti le modifiche sul ds
                            DSConcime._DS_Concime.AcceptChanges()

                            DSConcime._DS_Concime.Columns("Piva").ColumnName = "Piva_old"
                            DSConcime._DS_Concime.Columns("PivaReale").ColumnName = "Piva"
                            DSConcime._DS_Concime.Columns("Piva_old").ColumnName = "PivaReale"
                        End If

                End Select

            End If

        Catch ex As Exception
            Log_Errori &= "CaricaDsConcimazioni: " & vbCrLf & ex.Message & vbCrLf
            Throw New Exception(Log_Errori)
        End Try

        EndWatch(sw, "CaricaDsConcimazioni")

    End Sub

    Private Sub CaricaDsTrattamenti(ByVal Flag_Multispecie As Boolean, ByVal Flag_Multicentro As Boolean,
