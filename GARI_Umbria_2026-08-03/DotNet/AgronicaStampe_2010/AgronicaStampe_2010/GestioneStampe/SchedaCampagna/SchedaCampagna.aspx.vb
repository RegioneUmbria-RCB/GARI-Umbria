                                                    'dopo quando faccio ds.DT_Trattamenti2.Rows(s).Item("dose1") = CStr(Math.Round(cdec(ds.DT_Trattamenti2.Rows(s).Item("dose1").Split(" ")(0)), CInt(Qs_arrotonda)) & " " & ds.DT_Trattamenti2.Rows(s).Item("dose1").Split(" ")(1))
