                        '    End If
                        'Else
                        '    If Not IsNothing(objParametriUscitaNEW) Then
                        '        elencoDesc = (From fasi In objParametriUscitaNEW.ListaFasiFenologiche
                        '                      Where fasi.Cod_SS = ff_cod Select fasi.Descrizione & " ( BBCH " & fasi.Stadio & " )").ToArray()
