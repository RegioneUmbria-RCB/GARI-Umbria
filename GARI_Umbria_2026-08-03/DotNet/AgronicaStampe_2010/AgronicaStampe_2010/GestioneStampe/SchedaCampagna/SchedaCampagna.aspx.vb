                    Else
                        codiceProduttore = Cod_Socio
                    End If
                End If

                'If flag_mostra_codProd Then
                '    codiceProduttore = ImpreseCodici_Read.Leggi_Codice_from_Imprese_Codici(Piva, enum_CodiciAnagrafe.CodiceProduttore, objParametri_Server)
                '    If codiceProduttore = "" Then
