                    'RsRaccolta = drRaccolta.CopyToDataTable

                    '-------------------------------------------------------
                    'Per ogni impianto prendo la PRIMA e L'ULTIMA raccolta
                    For j = 0 To RsRaccolta.Rows.Count - 1

