    Private Function OttieniListaImpiantiDaMatrice(ByVal Matrice_Variabili As String(,), ByVal Validita_Inizio__tmp_FiltroImpianti As Date,
                                                   ByVal Validita_Fine__tmp_FiltroImpianti As Date, ByVal Idtestata As Integer) As List(Of TmpFiltroImpiantiObject)

        Dim lista As New List(Of TmpFiltroImpiantiObject)

        For x = 0 To Matrice_Variabili.GetUpperBound(1)

            lista.Add(New TmpFiltroImpiantiObject With
                      {
                            .Piva = Matrice_Variabili(0, x),
                            .Sa_Cod = Matrice_Variabili(1, x),
                            .Appezza = Matrice_Variabili(2, x),
                            .IdReg = Matrice_Variabili(3, x),
                            .Validita_Inizio = Validita_Inizio__tmp_FiltroImpianti,
                            .Validita_Fine = Validita_Fine__tmp_FiltroImpianti,
                            .IdTestataTemp = Idtestata
                      })

        Next

        Return lista.Distinct(New TmpFiltroImpiantiObjectComparer()).ToList

    End Function

    Private Sub Popola__tmp_FiltroImpianti_Da_Lista(ByVal Matrice_Variabili As String(,),
                                                    ByVal Validita_Inizio__tmp_FiltroImpianti As Date,
                                                    ByVal Validita_Fine__tmp_FiltroImpianti As Date,
                                                    ByRef Idtestata As Integer,
                                                    ByVal objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri)

        Try

            Dim xAgrosequenze As New AgronicaCoreDataProvider.Agro_Sequenze
            'Idtestata = xAgrosequenze.Agronica_SequenzaTabelle_NuovoID("IDTestataTemp", objParametri_Server)
            'Lavez - 12/07/2024 - normalizzazione chiamate a stack counter
            Idtestata = xAgrosequenze.NuovoId_Tabella("IDTestataTemp", 0, AgronicaCoreDataProvider.CostantiPersonalizzate.UpperBoundTabelle_Per_SequenzaTabelle_Topcode, objParametri_Server)

            Dim listaImpianti As List(Of TmpFiltroImpiantiObject) = OttieniListaImpiantiDaMatrice(Matrice_Variabili, Validita_Inizio__tmp_FiltroImpianti, Validita_Fine__tmp_FiltroImpianti, Idtestata)

            AgronicaCoreDataProvider.ConnessioniTransazioni.ApriConnessione(True, objParametri_Server)

            If Not IsNothing(listaImpianti) AndAlso listaImpianti.Any Then

                Dim jsonData = JsonConvert.SerializeObject(New With {Key .Table = listaImpianti})
                Dim ds As DataSet = JsonConvert.DeserializeObject(Of DataSet)(jsonData)

                Using sqlBulkCopy As New SqlBulkCopy(objParametri.objConnessione, Nothing, objParametri.objTransazione)
                    sqlBulkCopy.DestinationTableName = "__tmp_FiltroImpianti"
                    sqlBulkCopy.ColumnMappings.Add("Piva", "piva")
                    sqlBulkCopy.ColumnMappings.Add("Sa_Cod", "sa_cod")
                    sqlBulkCopy.ColumnMappings.Add("Appezza", "appezza")
                    sqlBulkCopy.ColumnMappings.Add("IdReg", "id_reg")
                    sqlBulkCopy.ColumnMappings.Add("IdTestataTemp", "idTestataTemp")
                    sqlBulkCopy.ColumnMappings.Add("Validita_Inizio", "Validita_Inizio")
                    sqlBulkCopy.ColumnMappings.Add("Validita_Fine", "Validita_Fine")
                    sqlBulkCopy.WriteToServer(ds.Tables(0))
                End Using

            End If

            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazione(1, objParametri_Server)

        Catch ex As Exception
            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazione(2, objParametri_Server)
            'MessaggioErrore = ex.Message
            'Scrivi_LOG(objParametri, NomeRoutine, MessaggioErrore)
            Throw New Exception("[" & "Popola__tmp_FiltroImpianti" & "] : " & ex.Message)
        Finally
            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiConnessione(objParametri_Server)
        End Try

    End Sub

    Private Sub Pulisci__tmp_FiltroImpianti(ByRef Idtestata As Integer,
                                            ByVal objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri)

        'Elimino le chiavi di ricerca della tabella temporanea __tmp_FiltroImpianti per evitare il proliferare dei record della tabella.
        If Idtestata <> 0 Then

