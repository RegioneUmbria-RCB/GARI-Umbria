        stbQ.Append("select agenda.id_agenda,agenda.validita_inizio as data_reg,movimenti.cau_mov, " & vbCrLf)
        stbQ.Append(" movimenti.extra_date as Data_Carico,movimenti.data_movimento as Data_Scarico,catalogoeuropeorifiuti.cer_cod as CodiceCER_Rifiuto, " & vbCrLf)
        stbQ.Append(" catalogoeuropeorifiuti.cer_des as Descrizione, movimenti_dettagli.pro_cod as pro_cod, movimenti_dettagli.extra_str as testo_rifiuto, " & vbCrLf)
        stbQ.Append(" movimenti_dettagli.qta as Qta,ISNULL((select top 1 udm_sim from unitamisura where unitamisura.udm_cod= movimenti_dettagli.udm_cod),'') as Udm, " & vbCrLf)
        stbQ.Append(" movimenti.doc_numero_sin as Doc_Numero_Sin,movimenti.doc_numero_des as Doc_Numero_Des, " & vbCrLf)
        stbQ.Append(" --isnull((select top 1 Rag_Soc from contatti " & vbCrLf)
        stbQ.Append(" --where contatti.cod_contatto =  " & vbCrLf)
        stbQ.Append(" --(select top 1 risorse_umane.cod_contatto from risorse_umane  " & vbCrLf)
        stbQ.Append(" --where risorse_umane.cod_risum = movimenti.cod_risum) " & vbCrLf)
        stbQ.Append(" --),'')  " & vbCrLf)
        stbQ.Append(" movimenti.extra_str " & vbCrLf)
        stbQ.Append(" as Rag_Soc_RisUm  " & vbCrLf)

        'FROM
        stbQ.Append(" from agenda  " & vbCrLf)
        stbQ.Append("    inner join movimenti on agenda.Id_Agenda = movimenti.Id_Agenda " & vbCrLf)
        stbQ.Append("    left outer join movimenti_dettagli on movimenti.id_agenda = movimenti_dettagli.id_agenda and movimenti.id_mov = movimenti_dettagli.id_mov " & vbCrLf)
        stbQ.Append("    left outer join catalogoeuropeorifiuti on catalogoeuropeorifiuti.codice = movimenti_dettagli.pro_cod " & vbCrLf)

        'WHERE
        'lav_cod = 1080 <-- gestione rifiuti
        stbQ.Append(" where agenda.lav_cod = " & LAVCOD_GESTIONE_RIFIUTI & " " & vbCrLf)
        stbQ.Append(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' " & vbCrLf)
        ' 4000 <-- intestazione 
        ' 7350 <-- elenco dettagli
        stbQ.Append(" and movimenti.cau_mov in ('4000','7350') " & vbCrLf)

        'se ho scelto una data unica per la stampa..
        If Qs_DataStampa <> "" Then

            stbQ.Append(" AND Agenda.Validita_Inizio = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
        Else
            stbQ.Append(" AND Agenda.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stbQ.Append(" AND Agenda.Validita_Inizio >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")

        End If

        stbQ.Append(" and (ISNULL(movimenti_dettagli.Contabilizzato,0)) >= 0 " & vbCrLf)

        'ORDER BY
        stbQ.Append(" order by agenda.Validita_Inizio, agenda.id_agenda, movimenti.cau_mov")
        'NB_ NON MODIFICARE L'ORDINAMENTO IN MODO CHE NELL'INTESTAZIONE SIA PRIMA DEI DETTAGLI




        strErr = Nothing
        Try
            objSql.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "CaricaDsGestioneRifiuti", DsGestioneRifiuti_TEMP, DsGestioneRifiuti_TEMP.DT_GestioneRifiuti.TableName)
        Catch ex As Exception
            strErr = ex.Message
        End Try

        'controllo errori 
        If Not IsNothing(strErr) Then

            'eccezzione......
            Throw New Exception(strErr)

        Else ' se non ci sono errori
            Dim DtGestioneRifiuti_temp = DsGestioneRifiuti_TEMP.DT_GestioneRifiuti
            For i = 0 To DtGestioneRifiuti_temp.Rows.Count - 1
                Dim newRow = DSGestioneRifiuti.DT_GestioneRifiuti.NewDT_GestioneRifiutiRow
                Select Case DtGestioneRifiuti_temp(i).cau_mov
                    Case "4000"
                        newRow.Doc_Numero_Sin = DtGestioneRifiuti_temp(i).Doc_Numero_Sin
                        newRow.Doc_Numero_Des = DtGestioneRifiuti_temp(i).Doc_Numero_Des
                        newRow.Rag_Soc_RisUm = DtGestioneRifiuti_temp(i).Rag_Soc_RisUm
                        newRow.id_agenda = DtGestioneRifiuti_temp(i).id_agenda
                        'se la prossima riga è di dettagli la inserisco in questa
                        If DtGestioneRifiuti_temp(i + 1).cau_mov = "7350" Then
                            newRow.Data_Carico = CDate(DtGestioneRifiuti_temp(i + 1).Data_Carico).ToShortDateString
                            newRow.data_reg = DtGestioneRifiuti_temp(i + 1).data_reg
                            newRow.Data_Scarico = CDate(DtGestioneRifiuti_temp(i + 1).Data_Scarico).ToShortDateString
                            newRow.Qta = DtGestioneRifiuti_temp(i + 1).Qta
                            newRow.Udm = DtGestioneRifiuti_temp(i + 1).Udm
                            If (DtGestioneRifiuti_temp(i + 1).pro_cod = 0) Then
                                newRow.testo_rifiuto = DtGestioneRifiuti_temp(i + 1).testo_rifiuto
                            Else
                                newRow.testo_rifiuto = "(" + DtGestioneRifiuti_temp(i + 1).CodiceCER_Rifiuto + ") " + DtGestioneRifiuti_temp(i + 1).Descrizione
                            End If

                            'così salto la prima riga di dettagli perchè l'ho già inserita
                            i += 1
                        End If
                    Case "7350"
                        'newRow = DtGestioneRifiuti_temp(i)

                        newRow.Doc_Numero_Sin = DtGestioneRifiuti_temp(i).Doc_Numero_Sin
                        newRow.Doc_Numero_Des = DtGestioneRifiuti_temp(i).Doc_Numero_Des
                        newRow.Rag_Soc_RisUm = DtGestioneRifiuti_temp(i).Rag_Soc_RisUm
                        newRow.id_agenda = DtGestioneRifiuti_temp(i).id_agenda
                        newRow.Data_Carico = CDate(DtGestioneRifiuti_temp(i).Data_Carico).ToShortDateString
                        newRow.data_reg = DtGestioneRifiuti_temp(i).data_reg
                        newRow.Data_Scarico = CDate(DtGestioneRifiuti_temp(i).Data_Scarico).ToShortDateString
                        newRow.Qta = DtGestioneRifiuti_temp(i).Qta
                        newRow.Udm = DtGestioneRifiuti_temp(i).Udm
                        If (DtGestioneRifiuti_temp(i).pro_cod = 0) Then
                            newRow.testo_rifiuto = DtGestioneRifiuti_temp(i).testo_rifiuto
                        Else
                            newRow.testo_rifiuto = "(" + DtGestioneRifiuti_temp(i).CodiceCER_Rifiuto + ") " + DtGestioneRifiuti_temp(i).Descrizione
                        End If
                    Case Else
                        ' ERRORE
                End Select

                DSGestioneRifiuti.DT_GestioneRifiuti.Rows.Add(newRow)

            Next

        End If

        EndWatch(sw, "CaricaDsGestioneRifiuti")

    End Sub


    ' ----------------------------------------------
    ' 10/11/2016 11:04:07: Per Romagnoli si è scelto di aggiungere nelle stampe multicentro
    ' tutti i centri aziendali, che hanno un magazzino che ha avuto movimentazioni nelle operazioni
    ' coinvolte nella stampa.
    ' ----------------------------------------------
    Sub AggiungiDsCentriMovimentati()

        Try

            ' uso l'HTidAgendaMovimenti per usare tutti gli ID_agenda per trovare i centri che hanno il 
            'magazzino movimentato con quegli id_agenda
            Dim strId_Agenda As String = ""

            For Each Key In HTIDAgendaDaControllare.Keys
                strId_Agenda &= Key.ToString & " ,"
            Next

            If strId_Agenda <> "" Then

                strId_Agenda = strId_Agenda.Remove(strId_Agenda.Length - 1)

                ' eseguo la query per gli id_agenda nel filtro di date per tutti i magazzini (cod 20) ed estrapolo i centri aziendali 
                ' con magazzino movimentato con le info per aggiungerlo in coda ai centri

                Dim drR As DS_Centri.DS_CentriRow
                Dim objSql As New AgronicaCoreDataProvider.DataProvider
                Dim objCentrixRubrica As New AgronicaCoreAnagrafeDAL.CentrixRubrica_Read
                Dim strErr As String
                Dim stbQ As New System.Text.StringBuilder
                Dim DtCentri As DataTable

                stbQ.Append("SELECT [Centri_Aziendali].[PIVA] " & vbCrLf)
                stbQ.Append("       , CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN [Centri_Aziendali].PIVA ELSE Imprese.partitaIvaReale END AS PivaReale " & vbCrLf)
                stbQ.Append("       ,[Centri_Aziendali].[sa_cod] " & vbCrLf)
                stbQ.Append("       ,[Centri_Aziendali].[sa_nome],Centri_Aziendali.Validita_inizio " & vbCrLf)
                stbQ.Append("     ,Indirizzi.ind_des, Indirizzi.CAP " & vbCrLf)
                stbQ.Append("     ,ISNULL(ISTAT.LOCALITA, '') AS com_des, ISNULL(ISTAT.COMUNI_PROV, '') AS pro_cod " & vbCrLf)

                'FROM
                stbQ.Append("   FROM Centri_Aziendali " & vbCrLf)
                stbQ.Append("   INNER JOIN Imprese ON Centri_Aziendali.PIVA = Imprese.PIVA " & vbCrLf)
                stbQ.Append("   inner join CentrixIndirizzi on CentrixIndirizzi.PIVA = Centri_Aziendali.PIVA AND CentrixIndirizzi.sa_cod = Centri_Aziendali.sa_cod " & vbCrLf)
                stbQ.Append("   INNER JOIN Indirizzi ON Indirizzi.cod_indirizzo = CentrixIndirizzi.cod_indirizzo " & vbCrLf)
                stbQ.Append("   LEFT OUTER JOIN ISTAT ON Indirizzi.pro_cod_istat = ISTAT.PROV AND Indirizzi.com_cod_istat = ISTAT.COM")

                'WHERE
                '
                stbQ.Append(" where Centri_Aziendali.piva = '" & Agro_SQL_SaveText(Piva) & "' " & vbCrLf)


                'se ho scelto una data unica per la stampa..
                If Qs_DataStampa <> "" Then

                Else
                    stbQ.Append(" AND Centri_Aziendali.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
                    stbQ.Append(" AND Centri_Aziendali.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")

                End If

                stbQ.Append(" and Centri_Aziendali.sa_cod in " & vbCrLf)
                stbQ.Append("   (select distinct sa_cod from Mov_Destinazioni " & vbCrLf)
                stbQ.Append("   where id_agenda in ( " & Agro_SQL_Save_Clausola_IN(strId_Agenda, False) & "  )  and tipo_destinazione = 20)")


                'ORDER BY
                stbQ.Append(" order by Centri_Aziendali.sa_cod")


                strErr = Nothing
                'Try
                DtCentri = objSql.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "CaricaDsGestioneRifiuti")
                'Catch ex As Exception
                '    strErr = ex.Message
                'End Try

                'If Not IsNothing(strErr) Then
                '    Throw New Exception(strErr)
                'Else

                If Not IsNothing(DtCentri) Then

                    If Not IsNothing(DSCentri._DS_Centri) Then
                        For i = 0 To DtCentri.Rows.Count - 1

                            Dim dtTrovato = DSCentri.Tables(0).Select("Sa_Cod =" & CStr(DtCentri.Rows(i).Item("Sa_Cod")))

                            If dtTrovato.Count > 0 Then

                            Else
                                drR = DSCentri._DS_Centri.NewDS_CentriRow
                                drR.Item("PIVA") = CStr(DtCentri.Rows(i).Item("PIVA"))
                                drR.Item("PivaReale") = CStr(DtCentri.Rows(i).Item("PivaReale"))
                                drR.Item("Sa_Cod") = CInt(DtCentri.Rows(i).Item("Sa_Cod"))
                                drR.Item("Sa_Nome") = CStr(DtCentri.Rows(i).Item("Sa_Nome"))
                                drR.Item("Indirizzo") = CStr(DtCentri.Rows(i).Item("ind_des"))
                                drR.Item("CAP") = CStr(DtCentri.Rows(i).Item("CAP"))
                                drR.Item("Comune") = CStr(DtCentri.Rows(i).Item("com_des"))
                                drR.Item("Provincia") = CStr(DtCentri.Rows(i).Item("pro_cod"))

                                '  Galassi, 10/11/2016 17:53:49: 
                                ' Dato che il codice sotto non serve ad una mazza ma è solo per rispettare le politiche metto un try per evitare di
                                ' invalidare la stampa se il mio algoritmo per ricalcolare la data ha qualche baco
                                drR.Item("Codice") = ""

                                Try

                                    If Not IsNothing(HTCentri) Then

                                        '##########     CODIFICA DEI CENTRI AZIENDALI PER LA SCHEDA DI CAMPAGNA MULTICENTRO     ########
                                        Dim lun As Integer = HTCentri.Count + 1
                                        Dim countLength((lun / 26)) As Integer
                                        Dim vvv As Integer = 0
                                        Do While lun > 0
                                            If lun < 26 Then
                                                countLength(vvv) = lun
                                            Else
                                                countLength(vvv) = lun Mod 26
                                            End If
                                            lun -= countLength(vvv)
                                            vvv += 1
                                        Loop
                                        For vvv = 0 To countLength.Count - 1
                                            drR.Item("Codice") = String.Format("{0}{1}", drR.Item("Codice"), Chr(countLength(vvv) + 64))
                                        Next


                                        HTCentri(String.Format("{0}{1}", DtCentri.Rows(i).Item("PIVA"), DtCentri.Rows(i).Item("Sa_Cod"))) = drR.Item("Codice")

                                        '#########      FINE CODIFICA   ##########################

                                    Else
                                        drR.Item("Codice") = "MAG"
                                    End If

                                Catch
                                    drR.Item("Codice") = "MAG"
                                End Try


                                Dim strRecapiti As String = ""
                                'Recupero i recapiti del centro aziendale
                                Dim DtRecapiti = objCentrixRubrica.Anagrafica_Centri_Rubrica_Leggi(Nothing, Piva,
                                                                                            CInt(DtCentri.Rows(i).Item("Sa_Cod")),
                                                                                            AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaDatiMinimi,
                                                                                            "", "", objParametri_Server)

                                If Not DtRecapiti Is Nothing AndAlso DtRecapiti.Rows.Count > 0 Then

                                    'Genero una stringa con tutti i recapiti del centro
                                    For j = 0 To DtRecapiti.Rows.Count - 1

                                        strRecapiti = String.Format("{0}{1}: {2}", strRecapiti, CStr(DtRecapiti.Rows(j).Item("descr")), CStr(DtRecapiti.Rows(j).Item("numero")))

                                        If j <> DtRecapiti.Rows.Count - 1 Then
                                            strRecapiti = String.Format("{0}{1}", strRecapiti, vbCrLf)
                                        End If
                                    Next
                                End If

                                drR.Item("Recapiti") = strRecapiti

                                DSCentri._DS_Centri.AddDS_CentriRow(drR)

                            End If
                        Next
                    End If

                End If

                'ultima cosa da fare
                DSCentri.AcceptChanges()
                DSCentri._DS_Centri.Columns("Piva").ColumnName = "Piva_old"
                DSCentri._DS_Centri.Columns("PivaReale").ColumnName = "Piva"
                DSCentri._DS_Centri.Columns("Piva_old").ColumnName = "PivaReale"

            End If

        Catch ex As Exception
            Log_Errori &= "AggiungiDsCentriMovimentati: " & vbCrLf & ex.Message & vbCrLf
            Throw New Exception(Log_Errori)
        End Try

    End Sub

    '(28/10/2014 modifica Fede) 
    'PRIORITA:
    'Se l'utente ha settato l'impostazione viene impostato in base all'impostazione scelta
    'Altrimenti la priorità è: 
    '1.RiferimentoAlfanumerico nell'appezzamento
    '2.Numeri nell'App_Nome
    '3.Appezza - BaseCode
    '(24/03/2015 modifica Fede) 
    'PRIORITA:
    'Se l'utente ha settato l'impostazione viene impostato in base all'impostazione scelta
    'Altrimenti la priorità è: 
    '1.RiferimentoAlfanumerico nell'appezzamento
    '2.App_Nome
    '3.Numeri nell'App_Nome
    '4.Appezza - BaseCode
    '
    ' Ultima modifica Estate 2016 - Inserito anche il riferimento al campo.
    '
    '28/11/2018: gestita per Coldiretti impostazione di visual campo solo sul frontespizio
    Private Function CodiceAppezzamento(ByVal Piva As String,
                                        ByVal Sa_Cod As Integer,
                                        ByVal Campo_Des As String,
                                        ByVal Appezza As Integer,
                                        ByVal TipoCodiceAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna,
                                        ByVal App_Nome As String,
                                        ByVal App_Nome_Breve As String,
                                        ByVal N_Appezza As Integer,
                                        Optional ByVal flag_Frontespizio As Boolean = False,
                                        Optional ByVal lotto As String = "") As String

        Dim strCodiceAppezzamento As String = ""
        Dim Num_Appezzamento As Long

        If TipoCodiceAppezzamento = enum_TipoCodiceAppezzamento_SchedaCampagna.RiferimentoAlfanumerico Then
            strCodiceAppezzamento = App_Nome_Breve
        End If

        If TipoCodiceAppezzamento = enum_TipoCodiceAppezzamento_SchedaCampagna.NumeriInAppNome Then
            Dim objNum As New AgronicaCoreDataProvider.UtilityProvider
            Num_Appezzamento = objNum.Numero_from_Stringa(App_Nome)
            If Num_Appezzamento = 0 Then
                strCodiceAppezzamento = ""
            Else
                strCodiceAppezzamento = CStr(Num_Appezzamento)
            End If
        End If

        If TipoCodiceAppezzamento = enum_TipoCodiceAppezzamento_SchedaCampagna.AppezzaMenoBasecode Then
            ' in molti ds non viene calcolato N_Appezza quindi lo calcolo qui
            If N_Appezza < 0 Then
                N_Appezza = Appezza - BaseCode
            End If
            'se è un valore alto lo tronco alle ultime 3 cifre..
            If CStr(N_Appezza).Length > 3 Then
                strCodiceAppezzamento = CInt(Right(CStr(N_Appezza), 3))
            Else
                strCodiceAppezzamento = N_Appezza
            End If
        End If

        If TipoCodiceAppezzamento = enum_TipoCodiceAppezzamento_SchedaCampagna.NomeAppezzamento Then
            strCodiceAppezzamento = App_Nome
        End If


        If strCodiceAppezzamento = "" Then

            If App_Nome_Breve <> "" Then
                strCodiceAppezzamento = App_Nome_Breve
            Else
                strCodiceAppezzamento = App_Nome
                'Dim objNum As New AgronicaCoreDataProvider.UtilityProvider
                'Num_Appezzamento = objNum.Numero_from_Stringa(App_Nome)
                'If Num_Appezzamento <> 0 Then
                '    strCodiceAppezzamento = CStr(Num_Appezzamento)
                'End If
            End If

            If strCodiceAppezzamento = "" Then
                ' in molti ds non viene calcolato N_Appezza quindi lo calcolo qui
                If N_Appezza < 0 Then
                    N_Appezza = Appezza - BaseCode
                End If
                'se è un valore alto lo tronco alle ultime 3 cifre..
                If CStr(N_Appezza).Length > 3 Then
                    strCodiceAppezzamento = CInt(Right(CStr(N_Appezza), 3))
                Else
                    strCodiceAppezzamento = N_Appezza
                End If
            End If

        End If


        If flag_visualizzaCampo_SoloSuFrontespizio = True And flag_Frontespizio = True Then
            'frontespizio e c'è opzione di visual campo

            If Not HTCentri Is Nothing AndAlso Not Campo_Des Is Nothing AndAlso Campo_Des.Trim <> "" Then
                strCodiceAppezzamento = String.Format("{0}/{1}/{2}/{3}", HTCentri.Item(String.Format("{0}{1}", Piva, Sa_Cod)), Campo_Des, strCodiceAppezzamento, lotto)
            Else
                If Not HTCentri Is Nothing Then
                    If Not Campo_Des Is Nothing AndAlso Campo_Des.Trim <> "" Then
                        strCodiceAppezzamento = String.Format("{0}/{1}/{2}/{3}", HTCentri.Item(String.Format("{0}{1}", Piva, Sa_Cod)), Campo_Des, strCodiceAppezzamento, lotto)
                    Else
                        strCodiceAppezzamento = String.Format("{0}//{1}/{2}", HTCentri.Item(String.Format("{0}{1}", Piva, Sa_Cod)), strCodiceAppezzamento, lotto)
                    End If
                End If
            End If

        ElseIf flag_visualizzaCampo_SoloSuFrontespizio = True And flag_Frontespizio = False Then
            'sezioni operazioni
            If Not HTCentri Is Nothing Then
                strCodiceAppezzamento = String.Format("{0}//{1}/{2}", HTCentri.Item(String.Format("{0}{1}", Piva, Sa_Cod)), strCodiceAppezzamento, lotto)
            End If
        Else
            'no opzione flag_visualizzaCampo_SoloSuFrontespizio

            ' se è la stampa multicentro concateno centro e numero appezzamento
            If Not HTCentri Is Nothing Then
                If flag_nascondiCampo Then
                    strCodiceAppezzamento = String.Format("{0}//{1}/{2}", HTCentri.Item(String.Format("{0}{1}", Piva, Sa_Cod)), strCodiceAppezzamento, lotto)
                Else
                    If Not Campo_Des Is Nothing AndAlso Campo_Des.Trim <> "" Then
                        strCodiceAppezzamento = String.Format("{0}/{1}/{2}/{3}", HTCentri.Item(String.Format("{0}{1}", Piva, Sa_Cod)), Campo_Des, strCodiceAppezzamento, lotto)
                    Else
                        strCodiceAppezzamento = String.Format("{0}//{1}/{2}", HTCentri.Item(String.Format("{0}{1}", Piva, Sa_Cod)), strCodiceAppezzamento, lotto)
                    End If
                End If
            End If
        End If

        Return strCodiceAppezzamento

    End Function

