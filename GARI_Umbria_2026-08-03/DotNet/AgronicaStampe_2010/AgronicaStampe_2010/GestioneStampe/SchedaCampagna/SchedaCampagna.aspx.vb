    '###########################################################################
    Private Sub CaricaDsErbacee(ByVal Flag_Multicentro As Boolean, ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna, flag_mostra_TecnRif As Boolean, flag_mostra_codProd As Boolean, ByVal LogoCliente() As Byte, ByVal LogoRegione() As Byte)

        Dim Imprese_Read As New AgronicaCoreAnagrafeDAL.Imprese_Read
        Dim Reg_Impianti_Codici_R As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Codici_R
        Dim ImpreseCodici_Read = New AgronicaCoreAnagrafeDAL.Imprese_Codici_Read

        'la query serve x gestire i report CRErbacee, CRArboree e l'intestazione

        'prendo il il nome del db contenente le tabelle di meta schema 
        Dim stbQuery As New System.Text.StringBuilder
        Dim stbQueryRappresentante As New System.Text.StringBuilder
        'Dim objSql As New Codex_Utility.Sql
        Dim objSql As New AgronicaCoreDataProvider.DataProvider

        'Dim objRappresentante As New Codex_Utlity.Sql
        'Dim objColture As New Codex_Utility.Sql

        Dim strErr As String

        Dim Str_LegaleReferente As String = ""
        Dim sw As Stopwatch = StartWatch("CaricaDsErbacee")


        Try
            Dim objContatti As New AgronicaCoreAnagrafeDAL.Risorse_Umane_R
            Str_LegaleReferente = objContatti.LeggiLegaleEReferente_xTestataQDC(Piva,
                                                                                 Sa_Cod,
                                                                                 Qs_DataInizio,
                                                                                 Qs_DataFine,
                                                                                    "",
                                                                                     "",
                                                                                     objParametri_Server)

        Catch ex As Exception
            Log_Errori &= "CaricaDsErbacee - Cerca Legale e Referente: " & vbCrLf & ex.Message & vbCrLf
        End Try

        Dim Flag_VisualizzaLottoEsercizio As Boolean = Not IsNothing(Session("VisualizzaLottoEsercizio")) AndAlso Session("VisualizzaLottoEsercizio") = True

        Try

            'query x reperire i dati....... 
            stbQuery.Append(" SELECT DISTINCT Appezzamento.PIVA, " & vbCrLf)
            stbQuery.Append(" CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Appezzamento.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale, " & vbCrLf)
            stbQuery.Append(" Imprese.rag_soc, Centri_Aziendali.sa_nome, Centri_Aziendali.sa_cod, " & vbCrLf)
            stbQuery.Append(" Appezzamento.Campo_Cod AS N_Campo,  " & vbCrLf)
            stbQuery.Append(" Reg_Impianti.APPEZZA, Appezzamento.App_Nome, Reg_Impianti.ID_REG, " & vbCrLf)
            stbQuery.Append(" (Reg_Impianti.ID_REG - " & BaseCode.ToString & ") AS N_idreg, (Reg_Impianti.APPEZZA - " & BaseCode.ToString & ") AS N_appezza, " & vbCrLf)
            stbQuery.Append(" Reg_Impianti.Validita_Inizio AS Data_InizioImpianto, " & vbCrLf)

            'Controllo se devo stampare la superficie dell'impianto o dell'appezzamento
            If strTipoSuperficie = "i" Then
                stbQuery.Append(" Reg_Impianti.sup_imp AS SUP_APP, " & vbCrLf)
            Else
                stbQuery.Append(" Appezzamento.Sup_App, " & vbCrLf)
            End If

            stbQuery.Append(" Reg_Impianti.Sup_Imp, " & vbCrLf)

            '(10/01/2019 fede) aggiunta buffer
            stbQuery.Append("     ISNULL(Appezzamento.DistBZ_CorpiIdrici,0) AS DistBZ_CorpiIdrici, " + vbCrLf)
            stbQuery.Append("     ISNULL(Appezzamento.DistBZ_AreeResPub,0) AS DistBZ_AreeResPub,  " + vbCrLf)
            stbQuery.Append("     ISNULL(Appezzamento.DistBZ_Allevamenti,0) AS DistBZ_Allevamenti, " + vbCrLf)
            stbQuery.Append("     ISNULL(Appezzamento.DistBZ_VegNatNonColt,0) AS DistBZ_VegNatNonColt,  " + vbCrLf)
            stbQuery.Append("     ISNULL(Appezzamento.SupBZ_Riduzione,0) AS SupBZ_Riduzione, " + vbCrLf)

            '(04/12/2019 fede) aggiunta gestione lingua
            stbQuery.Append(" SpecieVegetali.VEG_COD, coalesce(SpecieVegetali_XLingue.Veg_Des,SpecieVegetali.Veg_Des) as veg_des, SpecieVegetali.Gru_Cod, " & vbCrLf)
            stbQuery.Append(" ISNULL(coalesce(Cultivar_XLingue.Cul_Des,Cultivar.Cul_Des),'Terreno Nudo') AS Cul_Des, " & vbCrLf)
            'stbQuery.Append(" SpecieVegetali.VEG_COD, SpecieVegetali.VEG_DES, SpecieVegetali.Gru_Cod, " & vbCrLf)
            'stbQuery.Append(" ISNULL(Cultivar.CUL_DES,'Terreno Nudo') AS CUL_DES, " & vbCrLf)
            stbQuery.Append(" Cultivar.CUL_COD, " & vbCrLf)

            stbQuery.Append(" ISNULL(Reg_Impianti.GRVA_Cod_VEG,0) AS Grva_Cod, ISNULL(GruppoVarietale.Grva_Des,'') AS Grva_Des, " & vbCrLf)

            stbQuery.Append(" ISNULL(Portinnesti.PORT_DES,'') AS PORT_DES, ISNULL(FormeAllevamento.FORAL_DES,'') AS FORAL_DES, " & vbCrLf)

            'PIANTE
            stbQuery.Append("(ISNULL((SELECT TOP 1 Imprese_Progetti.p_ha FROM Imprese_Progetti " & vbCrLf)
            stbQuery.Append("        WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
            stbQuery.Append("	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
            stbQuery.Append("	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
            stbQuery.Append("	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG " & vbCrLf)

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQuery.Append(" AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(Qs_DataStampa) & " " & vbCrLf)
                stbQuery.Append(" AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(Qs_DataStampa) & " " & vbCrLf)
            Else
                stbQuery.Append(" AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
                stbQuery.Append(" AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
            End If
            stbQuery.Append("), 0)  * Reg_Impianti.Sup_Imp) AS Nr_Piante, " & vbCrLf)

            '(ISNULL(( SELECT TOP 1 Imprese_Progetti.p_ha FROM Imprese_Progetti  
            '        Where(Imprese_Progetti.PIVA = Reg_Impianti.PIVA And Imprese_Progetti.sa_cod = Reg_Impianti.SA_COD)
            '	and Imprese_Progetti.appezza = Reg_Impianti.APPEZZA AND Imprese_Progetti.Id_Reg = Reg_Impianti.ID_REG  
            '	AND Imprese_Progetti.Validita_Inizio <= CONVERT(DateTime,'2010/10/31',120)  
            '	AND Imprese_Progetti.Validita_Fine >= CONVERT(DateTime,'2009/11/01',120)  ), 0) * Reg_Impianti.Sup_Imp) AS Nr_Piante,


            'stbQuery.Append(" (Reg_Impianti.P_HA * Reg_Impianti.Sup_Imp) as Nr_Piante,  ")

            'corretto bug in data 8/11/2010: con sql2008 viene letto il primo campo avente lo stesso nome e nn l'ultimo
            'perciò nel nome del responsabile aziendale, anzichè finirci il nome di contatti ci finiva nome di persone
            'stbQuery.Append(" Persone.Cognome, Persone.Nome,  Indirizzi.ind_des, ")
            stbQuery.Append(" Indirizzi.ind_des, " & vbCrLf)
            stbQuery.Append(" Indirizzi.frz_des, ISNULL(ISTAT.CAP, '') AS CAP, ISNULL(ISTAT.LOCALITA, '') AS com_des, ISNULL(ISTAT.COMUNI_PROV, '') AS pro_cod, " & vbCrLf)
            stbQuery.Append(" Appezzamento.X, Appezzamento.Y,  " & vbCrLf)

            'telefono centro
            stbQuery.Append("(SELECT     TOP 1 Rubrica.numero " & vbCrLf)
            stbQuery.Append(" FROM          CentrixRubrica INNER JOIN " & vbCrLf)
            stbQuery.Append(" Rubrica ON CentrixRubrica.cod_rubrica = Rubrica.cod_rubrica AND Centri_Aziendali.sa_cod = CentrixRubrica.sa_cod AND " & vbCrLf)
            stbQuery.Append(" Centri_Aziendali.Piva = CentrixRubrica.Piva) AS Contatto, " & vbCrLf)

            'data semina
            stbQuery.Append("ISNULL((SELECT TOP 1 CONVERT(varchar,Agenda.Validita_Inizio, 103) AS Validita_Inizio " & vbCrLf)
            stbQuery.Append("FROM Agenda INNER JOIN  Movimenti ON Agenda.PIVA = Movimenti.PIVA AND Agenda.Sa_Cod = Movimenti.Sa_Cod AND Agenda.Id_Agenda = Movimenti.Id_Agenda  " & vbCrLf)
            stbQuery.Append("INNER JOIN Movimenti_dettagli ON Movimenti.PIVA = Movimenti_dettagli.PIVA AND Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND  Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda AND Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov  " & vbCrLf)
            stbQuery.Append("INNER JOIN  Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND   Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND   Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND   Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det   " & vbCrLf)
            stbQuery.Append("       WHERE(Agenda.Lav_Cod = 2 Or Agenda.Lav_Cod = 71 )  " & vbCrLf)
            stbQuery.Append("AND Movimenti.Cau_Mov = '2300'   " & vbCrLf)
            stbQuery.Append("AND   Mov_Destinazioni.Piva = Appezzamento.PIVA   " & vbCrLf)
            stbQuery.Append("AND   Mov_Destinazioni.sa_cod = Centri_Aziendali.sa_cod   " & vbCrLf)
            stbQuery.Append("AND   Mov_Destinazioni.appezza = Reg_Impianti.APPEZZA   " & vbCrLf)
            stbQuery.Append("AND   Mov_Destinazioni.Id_Destinazione = Reg_Impianti.ID_REG " & vbCrLf)
            stbQuery.Append("AND   Movimenti_dettagli.contabilizzato >= 0 " & vbCrLf)

            '''nuovo pezzo per la data
            If Qs_DataStampa <> "" Then
                stbQuery.Append(" AND Agenda.Validita_Inizio  <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
                stbQuery.Append(" AND Agenda.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            Else
                stbQuery.Append(" AND Agenda.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
                stbQuery.Append(" AND Agenda.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
            End If

            stbQuery.Append("ORDER BY Agenda.Validita_Inizio ) ,'01/01/1900') AS Data_Semina, " & vbCrLf)

            'data prima raccolta
            stbQuery.Append(" '31/12/2100' AS Data_Prima_Raccolta, " & vbCrLf)

            'lotto-------------------------------------------------------------------
            stbQuery.Append("ISNULL(( " & vbCrLf)
            '----ATTENZIONE, la query deve essere riannidata perchè orderby non funziona con la union in query annidate e sql2000
            '----se l'elemento non è ncluso nella select
            stbQuery.Append("select A.Progetto_Nome from ( " & vbCrLf)
            'riannidatamento per  aggiungere alla select la data usata nell'order
            stbQuery.Append("SELECT TOP 1 Imprese_Progetti.Progetto_Nome,Imprese_Progetti.Validita_Fine FROM Imprese_Progetti " & vbCrLf)
            stbQuery.Append("        WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
            stbQuery.Append("	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
            stbQuery.Append("	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
            stbQuery.Append("	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG " & vbCrLf)
            If Qs_DataStampa <> "" Then
                stbQuery.Append(" AND Imprese_Progetti.Validita_Inizio  <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
