            stbQuery.Append(" isnull(Cultivar.CUL_COD,0) as cul_cod, " & vbCrLf)

            stbQuery.Append(" 0 AS Grva_Cod, '' AS Grva_Des, " & vbCrLf)

            stbQuery.Append(" '' AS PORT_DES, '' AS FORAL_DES, 0 as Nr_Piante,  " & vbCrLf)

            'leggi commento nell'altra parte della union
            'stbsQuery.Append(" Persone.Cognome, Persone.Nome,  Indirizzi.ind_des, ")
            stbQuery.Append(" Indirizzi.ind_des, " & vbCrLf)
            stbQuery.Append(" Indirizzi.frz_des, ISNULL(ISTAT.CAP, '') AS CAP, ISNULL(ISTAT.LOCALITA, '') AS com_des, ISNULL(ISTAT.COMUNI_PROV, '') AS pro_cod, " & vbCrLf)
            stbQuery.Append(" 0, 0,  " & vbCrLf)

            'telefono centro
            stbQuery.Append("(SELECT     TOP 1 Rubrica.numero " & vbCrLf)
            stbQuery.Append(" FROM          CentrixRubrica INNER JOIN " & vbCrLf)
            stbQuery.Append(" Rubrica ON CentrixRubrica.cod_rubrica = Rubrica.cod_rubrica AND Centri_Aziendali.sa_cod = CentrixRubrica.sa_cod AND " & vbCrLf)
            stbQuery.Append(" Centri_Aziendali.Piva = CentrixRubrica.Piva) AS Contatto, " & vbCrLf)

            'data semina
            stbQuery.Append(" '01/01/1900' AS Data_Semina, " & vbCrLf)

            'data prima raccolta
            stbQuery.Append(" '31/12/2100' AS Data_Prima_Raccolta, " & vbCrLf)

            'lotto
            stbQuery.Append("'' AS Lotto, " & vbCrLf)

            'data semina prevista
            stbQuery.Append("'01/01/1900' AS Data_Semina_Prevista, " & vbCrLf)

            stbQuery.Append("'01/01/1900' AS Data_Fioritura_Prevista, " & vbCrLf)

            'prog_part
            stbQuery.Append("'' AS Prog_Part, " & vbCrLf)

            'data fioritura
            stbQuery.Append(" '01/01/1900' AS Data_Fioritura, " & vbCrLf)

            'rappresentante legale
            '03/09/2018: cambiata la gestione, il legale si legge da query dedicata per gestire il cambio di legale in corso di annata
            'stbQuery.Append(" ISNULL((SELECT TOP 1 Contatti.Cognome + ' ' + Contatti.nome + ' ' + Contatti.Rag_Soc FROM Contatti " & vbCrLf)
            'stbQuery.Append("         INNER JOIN Risorse_Umane ON Contatti.Piva = Risorse_Umane.Piva  AND Contatti.Cod_Contatto = Risorse_Umane.Cod_Contatto " & vbCrLf)
            'stbQuery.Append(" 	      INNER JOIN Rapporti_Contabili ON Risorse_Umane.Cod_Rapporto = Rapporti_Contabili.Cod_Rapporto " & vbCrLf)
            'stbQuery.Append("         WHERE Rapporti_Contabili.Cod_Rapporto IN (-1,-14)  " & vbCrLf)
            ''stbQuery.Append(" 	      AND Contatti.Piva = Appezzamento.PIVA ),'') AS Nome,  " & vbCrLf)
            'stbQuery.Append(" 	      AND    (      (Contatti.Sa_Cod = -1 AND Contatti.Piva = Appezzamento.PIVA)   " & vbCrLf)
            'stbQuery.Append(" 	              OR    (Contatti.Sa_Cod = 0 AND Contatti.Piva = Appezzamento.PIVA)   " & vbCrLf)
            'stbQuery.Append(" 	              OR    (Contatti.Sa_Cod = Appezzamento.Sa_Cod AND Contatti.Piva = Appezzamento.PIVA)   " & vbCrLf)
            'stbQuery.Append(" 	             )   " & vbCrLf)
            ''stbQuery.Append(" 	      AND (Contatti.Sa_Cod=0 OR Contatti.Sa_Cod=-1 OR Contatti.Sa_Cod=Appezzamento.Sa_Cod )" & vbCrLf)
            'stbQuery.Append(" 	       ),'') AS Nome,  " & vbCrLf)
            stbQuery.Append(" 	       '' AS Nome,  " & vbCrLf)

            'campo_des
            stbQuery.Append(" '' AS Campo_Nome, " & vbCrLf)

            'progetto_cod
            stbQuery.Append(" '' AS Progetto_cod, " & vbCrLf)

            'tra_fila maschio
            stbQuery.Append(" '' AS Tra_Fila, " & vbCrLf)

            'su_fila maschio
            stbQuery.Append(" '' AS Su_Fila, " & vbCrLf)

            'Copertura
            stbQuery.Append(" '' AS Cop_Des, " & vbCrLf)

            'App_Nome_Breve
            stbQuery.Append(" '' AS App_Nome_Breve " & vbCrLf)

            '-----------------------------------
            'FROM
            stbQuery.Append(" FROM  Appezzamento RIGHT OUTER JOIN " & vbCrLf)
            stbQuery.Append(" Imprese INNER JOIN " & vbCrLf)
            stbQuery.Append(" UtentiXImprese ON Imprese.PIVA = UtentiXImprese.PIVA INNER JOIN " & vbCrLf)
            stbQuery.Append(" ImpresexIndirizzi ON Imprese.PIVA = ImpresexIndirizzi.PIVA INNER JOIN " & vbCrLf)
            stbQuery.Append(" Indirizzi ON ImpresexIndirizzi.cod_indirizzo = Indirizzi.cod_indirizzo " & vbCrLf)
            stbQuery.Append(" LEFT OUTER JOIN " & vbCrLf)
            stbQuery.Append(" Centri_Aziendali ON Imprese.PIVA = Centri_Aziendali.PIVA ON Appezzamento.PIVA = Centri_Aziendali.PIVA AND " & vbCrLf)
            stbQuery.Append(" Appezzamento.SA_COD = Centri_Aziendali.sa_cod LEFT OUTER JOIN " & vbCrLf)
            stbQuery.Append(" Reg_Impianti ON Appezzamento.PIVA = Reg_Impianti.PIVA AND Appezzamento.SA_COD = Reg_Impianti.SA_COD AND " & vbCrLf)
            stbQuery.Append(" Appezzamento.APPEZZA = Reg_Impianti.APPEZZA LEFT OUTER JOIN " & vbCrLf)
            stbQuery.Append(" Cultivar Cultivar ON Reg_Impianti.CUL_COD = Cultivar.CUL_COD LEFT OUTER JOIN " & vbCrLf)
            stbQuery.Append(" SpecieVegetali SpecieVegetali ON Cultivar.VEG_COD = SpecieVegetali.VEG_COD LEFT OUTER JOIN " & vbCrLf)
            stbQuery.Append(" GruppoVegetale GruppoVegetale ON SpecieVegetali.GRU_COD = GruppoVegetale.GRU_COD " & vbCrLf)
            stbQuery.Append(" LEFT OUTER JOIN ISTAT ON Indirizzi.pro_cod_istat = ISTAT.PROV AND Indirizzi.com_cod_istat = ISTAT.COM " & vbCrLf)

            '(04/12/2019 fede) aggiunta gestione lingua
            stbQuery.Append(" LEFT JOIN SpecieVegetali_XLingue ON SpecieVegetali.Veg_Cod = SpecieVegetali_XLingue.Veg_Cod AND SpecieVegetali_XLingue.Lingua_Cod = " & objParametri_Server.Lingua_Cod & vbCrLf)

            'stbQuery.Append("LEFT OUTER JOIN ")
            'stbQuery.Append("Persone INNER JOIN ")
            'stbQuery.Append("ImpresexPersone_Codici ON Persone.cod_fis = ImpresexPersone_Codici.cod_fis ON ")
            'stbQuery.Append("Imprese.PIVA = ImpresexPersone_Codici.PIVA ")

            If IDTestataTemp <> 0 Then

                stbQuery.AppendLine(" inner Join __tmp_FiltroImpianti f ")
                stbQuery.AppendLine(" On  Reg_Impianti.PIVA = f.piva  ")
                stbQuery.AppendLine(" And Reg_Impianti.SA_COD = f.sa_cod ")
                stbQuery.AppendLine(" And Reg_Impianti.APPEZZA = f.appezza ")
                stbQuery.AppendLine(" And Reg_Impianti.ID_REG = f.id_reg ")
                stbQuery.AppendLine("       And f.idTestataTemp = " & IDTestataTemp)
                stbQuery.Append("       And f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
                stbQuery.Append("       And f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

            End If

            '-----------------------------------
            'WHERE
            stbQuery.Append(" WHERE ImpresexIndirizzi.Tipo_Indirizzo = 1 " & vbCrLf)

            'se ho un terreno nudo o ho scelto di stampare un rilievo piogge..
            If Veg_Cod = "0" Or Veg_Cod = "-1" Then
                stbQuery.Append(" and Reg_Impianti.cul_cod = 0 " & vbCrLf)
            Else
                If TerrenoNudoIncluso = False Then
                    stbQuery.Append(" AND SpecieVegetali.VEG_COD = " & Veg_Cod & vbCrLf)
                Else
                    stbQuery.Append(" AND (SpecieVegetali.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) " & vbCrLf)
                End If
            End If

            stbQuery.Append(" AND Imprese.Piva = '" & Agro_SQL_SaveText(Piva) & "' " & vbCrLf)

            If Not Flag_Multicentro Then
                stbQuery.Append(" AND Centri_Aziendali.sa_cod = " & Sa_Cod & " " & vbCrLf)
            End If

            'stbQuery.Append(strFiltroImpianti & vbCrLf)

            'stbQuery.Append(" ORDER BY Cultivar.CUL_DES, Data_InizioImpianto ")

            'Tolgo il nome della tabella dai campi su cui effettuare l'ordinamento perché su alcuni DB,
            'come ad esempio quello di Cereali Ravenna, si generava un errore.
            stbQuery.Append(" ORDER BY CUL_DES, Data_InizioImpianto " & vbCrLf)

            DsErbacee = New DS_Erbacee
            Dim DataR() As DataRow
            Dim r As DataRow
            Dim Num_Row As Integer
            Dim n As Integer

            objSql.EseguiQuery_Lettura(objParametri_Server, stbQuery.ToString, "SchedaCampagna.CaricaDsErbacee", DsErbacee, DsErbacee.vw_rptErbacee.TableName)

            If IsNothing(strErr) Then

                Dim i As Integer
                Dim Anno As String
                Dim Anno1 As String
                Dim Anno2 As String
                Dim Differenza As String
