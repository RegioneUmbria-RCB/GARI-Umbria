            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            Else
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
            End If

            stbQ.Append(" 	     ORDER BY Imprese_Progetti.Validita_Inizio DESC ), '') AS Lotto " & vbCrLf)

            stbQ.AppendLine(" FROM Agenda ")
            stbQ.AppendLine(" INNER JOIN Movimenti On Agenda.PIVA = Movimenti.PIVA And Agenda.Sa_Cod = Movimenti.Sa_Cod And Agenda.Id_Agenda = Movimenti.Id_Agenda ")
            stbQ.AppendLine(" INNER JOIN Centri_Aziendali On Agenda.PIVA = Centri_Aziendali.PIVA And Agenda.Sa_Cod = Centri_Aziendali.sa_cod ")
            stbQ.AppendLine(" LEFT JOIN Mov_Destinazioni md On Movimenti.PIVA = md.PIVA And Movimenti.Sa_Cod = md.Sa_Cod And Movimenti.Id_Agenda = md.Id_Agenda ")
            stbQ.AppendLine(" LEFT JOIN Appezzamento a On a.PIVA = md.PIVA And a.Sa_Cod = md.Sa_Cod And a.APPEZZA = md.APPEZZA ")
            stbQ.AppendLine(" LEFT JOIN Reg_Impianti On Reg_Impianti.PIVA = md.PIVA And Reg_Impianti.Sa_Cod = md.Sa_Cod And Reg_Impianti.APPEZZA = md.APPEZZA And Reg_Impianti.ID_REG = md.Id_Destinazione ")
            stbQ.AppendLine(" LEFT JOIN Cultivar c On Reg_Impianti.CUL_COD = c.Cul_Cod ")
            stbQ.AppendLine(" LEFT JOIN SpecieVegetali sv On sv.Veg_Cod = c.Veg_Cod ")
            stbQ.AppendLine(" LEFT JOIN Reg_Impianti_Codici ric On Reg_Impianti.PIVA = ric.PIVA And Reg_Impianti.Sa_Cod = ric.Sa_Cod And Reg_Impianti.APPEZZA = ric.APPEZZA And Reg_Impianti.ID_REG = ric.Id_Reg And Reg_Impianti.Cul_Cod=0 And ric.id_cod BETWEEN 3000 And 3999 ")
            stbQ.AppendLine(" LEFT JOIN Codici_Anagrafe On Codici_Anagrafe.codice = ric.id_cod ")
            'stbQ.AppendLine(" LEFT JOIN Imprese_Progetti ON Imprese_Progetti.Piva = Reg_Impianti.PIVA AND Imprese_Progetti.Sa_Cod = Reg_Impianti.SA_COD AND  ")
            'stbQ.AppendLine(" Imprese_Progetti.Appezza = Reg_Impianti.APPEZZA AND Imprese_Progetti.Id_Reg = Reg_Impianti.ID_REG ")

            stbQ.AppendLine(" WHERE Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

            'stbQ.AppendLine("AND (Reg_Impianti.piva IS NULL OR (1=1 " & strFiltroImpianti & "))")

            stbQ.AppendLine("AND Reg_Impianti.piva IS NULL")

            Select Case NonUtilizzo_Nessuno0_Fito1_Ferti2_Tutti3
                Case 1
                    stbQ.AppendLine(" AND Agenda.Lav_Cod = " & LAVCOD_TRATTAMENTO_DICHIARAZIONE_NON_UTILIZZO)
                Case 2
                    stbQ.AppendLine(" AND Agenda.Lav_Cod = " & LAVCOD_FERTILIZZAZIONI_DICHIARAZIONE_NON_UTILIZZO)
                Case 3
                    stbQ.AppendLine(" AND Agenda.Lav_Cod IN (" & LAVCOD_TRATTAMENTO_DICHIARAZIONE_NON_UTILIZZO & "," & LAVCOD_FERTILIZZAZIONI_DICHIARAZIONE_NON_UTILIZZO & ")")
            End Select

            If Not Flag_Multicentro Then
                stbQ.AppendLine(" AND Agenda.sa_cod = " & Sa_Cod)
            End If

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ.AppendLine(" AND Movimenti.Data_Movimento = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)))
            Else
                stbQ.AppendLine(" AND Movimenti.Data_Movimento <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)))
                stbQ.AppendLine(" AND Movimenti.Data_Movimento >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)))
            End If

            '23/05/2019 aggiunto  If Not Flag_Multispecie 
            If Not Flag_Multispecie Then
                If Veg_Cod = "0" Then
                    stbQ.AppendLine(" AND (Reg_Impianti.ID_REG IS NULL) ")
                Else
                    If TerrenoNudoIncluso = False Then
                        stbQ.AppendLine(" AND (Reg_Impianti.ID_REG IS NULL)")
                    Else
                        stbQ.AppendLine(" AND (Reg_Impianti.ID_REG IS NULL) ")
                    End If
                End If
            End If

            'stbQ.Append(" AND Movimenti_dettagli.contabilizzato >= 0 ") (NOT USED)

            stbQ.AppendLine("UNION ")

            'Agenda.Validita_Inizio 
            stbQ.AppendLine(" SELECT Agenda.PIVA, Agenda.Sa_Cod, Agenda.Id_Agenda, Agenda.Lav_Cod, Agenda.des_lib, CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) AS Data_Movimento, Centri_Aziendali.Sa_Nome, ")
            stbQ.AppendLine(" CONVERT(varchar, Agenda.Data_Creazione, 103) AS Data_Registrazione, a.APP_NOME, COALESCE(sv.Veg_Des, Codici_Anagrafe.descrizione) as SpecieDestUso, ")

            stbQ.Append(" ISNULL((SELECT TOP 1 Imprese_Progetti.Progetto_Nome FROM Imprese_Progetti " & vbCrLf)
            stbQ.Append("       WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG  " & vbCrLf)

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            Else
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
            End If

            stbQ.Append(" 	     ORDER BY Imprese_Progetti.Validita_Inizio DESC ), '') AS Lotto " & vbCrLf)

            stbQ.AppendLine(" FROM Agenda ")
            stbQ.AppendLine(" INNER JOIN Movimenti ON Agenda.PIVA = Movimenti.PIVA AND Agenda.Sa_Cod = Movimenti.Sa_Cod AND Agenda.Id_Agenda = Movimenti.Id_Agenda ")
            stbQ.AppendLine(" INNER JOIN Centri_Aziendali ON Agenda.PIVA = Centri_Aziendali.PIVA AND Agenda.Sa_Cod = Centri_Aziendali.sa_cod ")
            stbQ.AppendLine(" LEFT JOIN Mov_Destinazioni md ON Movimenti.PIVA = md.PIVA AND Movimenti.Sa_Cod = md.Sa_Cod AND Movimenti.Id_Agenda = md.Id_Agenda ")
            stbQ.AppendLine(" LEFT JOIN Appezzamento a ON a.PIVA = md.PIVA AND a.Sa_Cod = md.Sa_Cod AND a.APPEZZA = md.APPEZZA ")
            stbQ.AppendLine(" LEFT JOIN Reg_Impianti ON Reg_Impianti.PIVA = md.PIVA AND Reg_Impianti.Sa_Cod = md.Sa_Cod AND Reg_Impianti.APPEZZA = md.APPEZZA AND Reg_Impianti.ID_REG = md.Id_Destinazione ")
            stbQ.AppendLine(" LEFT JOIN Cultivar c ON Reg_Impianti.CUL_COD = c.Cul_Cod ")
            stbQ.AppendLine(" LEFT JOIN SpecieVegetali sv ON sv.Veg_Cod = c.Veg_Cod ")
            stbQ.AppendLine(" LEFT JOIN Reg_Impianti_Codici ric ON Reg_Impianti.PIVA = ric.PIVA AND Reg_Impianti.Sa_Cod = ric.Sa_Cod AND Reg_Impianti.APPEZZA = ric.APPEZZA AND Reg_Impianti.ID_REG = ric.Id_Reg AND Reg_Impianti.Cul_Cod=0 AND ric.id_cod BETWEEN 3000 And 3999 ")
            stbQ.AppendLine(" LEFT JOIN Codici_Anagrafe ON Codici_Anagrafe.codice = ric.id_cod ")
            'stbQ.AppendLine(" LEFT JOIN Imprese_Progetti ON Imprese_Progetti.Piva = Reg_Impianti.PIVA AND Imprese_Progetti.Sa_Cod = Reg_Impianti.SA_COD AND  ")
            'stbQ.AppendLine(" Imprese_Progetti.Appezza = Reg_Impianti.APPEZZA AND Imprese_Progetti.Id_Reg = Reg_Impianti.ID_REG ")

            If IDTestataTemp <> 0 Then

                stbQ.Append(" inner Join __tmp_FiltroImpianti f ")
                stbQ.Append(" On  Reg_Impianti.PIVA = f.piva  ")
                stbQ.Append(" And Reg_Impianti.SA_COD = f.sa_cod ")
                stbQ.Append(" And Reg_Impianti.APPEZZA = f.appezza ")
                stbQ.Append(" And Reg_Impianti.ID_REG = f.id_reg ")
                stbQ.Append("       And f.idTestataTemp = " & IDTestataTemp)
                stbQ.Append("       And f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
                stbQ.Append("       And f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

            End If

            stbQ.AppendLine(" WHERE Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

            'stbQ.AppendLine("AND (Reg_Impianti.piva IS NULL OR (1=1 " & strFiltroImpianti & "))")

            Select Case NonUtilizzo_Nessuno0_Fito1_Ferti2_Tutti3
                Case 1
                    stbQ.AppendLine(" AND Agenda.Lav_Cod = " & LAVCOD_TRATTAMENTO_DICHIARAZIONE_NON_UTILIZZO)
                Case 2
                    stbQ.AppendLine(" AND Agenda.Lav_Cod = " & LAVCOD_FERTILIZZAZIONI_DICHIARAZIONE_NON_UTILIZZO)
                Case 3
                    stbQ.AppendLine(" AND Agenda.Lav_Cod IN (" & LAVCOD_TRATTAMENTO_DICHIARAZIONE_NON_UTILIZZO & "," & LAVCOD_FERTILIZZAZIONI_DICHIARAZIONE_NON_UTILIZZO & ")")
            End Select

            If Not Flag_Multicentro Then
                stbQ.AppendLine(" AND Agenda.sa_cod = " & Sa_Cod)
            End If

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ.AppendLine(" AND Movimenti.Data_Movimento = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)))
            Else
                stbQ.AppendLine(" AND Movimenti.Data_Movimento <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)))
                stbQ.AppendLine(" AND Movimenti.Data_Movimento >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)))
            End If

            '23/05/2019 aggiunto  If Not Flag_Multispecie 
            If Not Flag_Multispecie Then
                If Veg_Cod = "0" Then
                    stbQ.AppendLine(" AND (Reg_Impianti.cul_cod = 0) ")
                Else
                    If TerrenoNudoIncluso = False Then
                        stbQ.AppendLine(" AND (sv.VEG_COD = " & Veg_Cod & ")")
                    Else
                        stbQ.AppendLine(" AND (sv.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) ")
                    End If
                End If
            End If

            'stbQ.Append(" ORDER BY Agenda.sa_cod, Agenda.Validita_Inizio ASC " & vbCrLf)
            stbQ.AppendLine(" ORDER BY Agenda.sa_cod, Data_Movimento ASC ")

            Dim Dt As DataTable

            strErr = Nothing
            Try
                Dt = objSql.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "SchedaCampagna.CaricaDsDichiarazioni")
            Catch ex As Exception
                strErr = Nothing
            End Try

            Dim RigaDs As DS_Autocertificazioni.DT_AutocertificazioniRow

            'Elimino l'oggetto
            objSql = Nothing

            'Verifico la presenza di errori
            If Not IsNothing(Dt) AndAlso Dt.Rows.Count > 0 Then

                Dim listaIdAgenda As Integer() = (From riga As DataRow In Dt Select CInt(riga.Item("id_agenda"))).Distinct.ToArray()

                For Each idAg As Integer In listaIdAgenda
                    Dim DrOp As DataRow() = (From riga As DataRow In Dt Where CInt(riga.Item("id_agenda")) = idAg).ToArray()

                    Dim strApp As String = ""

                    'If (Not IsDBNull(DrOp(0).Item("App_nome"))) Then
                    '    Dim listaApp As String() = (From riga As DataRow In DrOp Select CStr(riga.Item("app_nome"))).OrderBy(Function(x) CStr(x)).ToArray()
                    '    strApp = ": " & String.Join(", ", listaApp)
                    'End If
                    If (Not IsDBNull(DrOp(0).Item("App_nome"))) Then
                        Dim listaApp As String() = (From riga As DataRow In DrOp
                                                    Select CStr(riga.Item("app_nome")) & "/" & CStr(riga.Item("Lotto"))).
                                                    OrderBy(Function(x) CStr(x)).ToArray()
                        strApp = ": " & String.Join(", ", listaApp)
                    End If

                    RigaDs = DsAutocertificazioni.DT_Autocertificazioni.NewDT_AutocertificazioniRow

                    ' RigaDs.Data = CDate(dr.Item("validita_inizio")).ToShortDateString

                    RigaDs.Data = Formatta_Data_Movimento(DrOp(0).Item("Data_Movimento"))
                    RigaDs.Appezzamenti = DrOp(0).Item("sa_nome") & strApp
                    Select Case DrOp(0).Item("Lav_Cod")
                        Case LAVCOD_TRATTAMENTO_DICHIARAZIONE_NON_UTILIZZO
                            RigaDs.Dichiarazione = "Dichiaro di non aver utilizzato prodotti fitosanitari."
                            'RigaDs.Dichiarazione = "Dichiaro di non aver utilizzato prodotti fitosanitari." & vbCrLf & "D. Registrazione " & CDate(dr.Item("Data_Registrazione")).ToShortDateString
                        Case LAVCOD_FERTILIZZAZIONI_DICHIARAZIONE_NON_UTILIZZO
                            RigaDs.Dichiarazione = "Dichiaro di non aver utilizzato fertilizzanti."
                            'RigaDs.Dichiarazione = "Dichiaro di non aver utilizzato fertilizzanti." & vbCrLf & "D. Registrazione " & CDate(dr.Item("Data_Registrazione")).ToShortDateString
                    End Select

                    RigaDs.Specie = If(IsDBNull(DrOp(0).Item("SpecieDestUso")), "Tutte", DrOp(0).Item("SpecieDestUso"))

                    DsAutocertificazioni.DT_Autocertificazioni.Rows.Add(RigaDs)

                Next

                'rendo permanenti le modifiche sul ds
                DsAutocertificazioni.DT_Autocertificazioni.AcceptChanges()

            End If

        Catch ex As Exception
            Log_Errori &= "CaricaDsDichiarazioni: " & vbCrLf & ex.Message & vbCrLf
            Throw New Exception(Log_Errori)
        End Try

        EndWatch(sw, "CaricaDsDichiarazioni")

    End Sub

