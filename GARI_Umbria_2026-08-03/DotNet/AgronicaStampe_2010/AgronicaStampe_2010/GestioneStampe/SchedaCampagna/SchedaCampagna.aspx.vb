    '###########################################################################
    'riempie il ds x il rilevi avversità nelle trappole...
    Private Sub CaricaDSRilAvv_New(ByVal Flag_Multicentro As Boolean, ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna, ByVal Flag_Multispecie As Boolean)

        'Dim objSql As New Codex_Utility.Sql
        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String
        Dim stbQ As New System.Text.StringBuilder
        Dim i As Integer
        Dim App_Nome As String
        Dim Num_Appezzamento As Double
        ' Dim Rs As ADODB.Recordset
        Dim objNum As New AgronicaCoreDataProvider.UtilityProvider


        Dim sw As Stopwatch = StartWatch("CaricaDSRilAvv_New")

        'query x reperire i dati
        stbQ.Append(" SELECT Agenda.Id_Agenda, " & vbCrLf)
        stbQ.Append(" CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) AS Data_Creazione, SpecieVegetali.Veg_Des, Cultivar.Cul_Des, ")
        stbQ.Append(" CASE WHEN Trappole.TRAP_COD IS NULL THEN Formulati.Fr_Cod ELSE Trappole.TRAP_COD End As TRAP_COD, ")
        stbQ.AppendLine(" CASE WHEN Trappole.TRAP_DES IS NULL THEN Formulati.Fr_des ELSE Trappole.TRAP_DES End AS trappola, Avversita.Av_Des_Vol, ")
        stbQ.Append(" Reg_Impianti.PIVA,  ")
        stbQ.Append(" CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Reg_Impianti.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale, ")
        stbQ.Append(" Reg_Impianti.SA_COD, Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG, ")
        stbQ.Append(" Mov_Dettaglio_Tecnico.Qta_Ril, Appezzamento.APP_NOME, ")

        'campo_des
        stbQ.Append(" ISNULL(( SELECT top 1 Campi.Campo_Des " & vbCrLf)
        stbQ.Append(" FROM Campi " & vbCrLf)
        stbQ.Append(" WHERE Campi.Piva = Appezzamento.PIVA AND Campi.Sa_Cod = Appezzamento.SA_COD AND " & vbCrLf)
        stbQ.Append(" Campi.Campo_Cod = Appezzamento.Campo_Cod " & vbCrLf)
        stbQ.Append(" ),'') AS Campo_Nome, " & vbCrLf)

        stbQ.Append(" ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici  ")
        stbQ.Append("        where (Appezzamento_Codici.PIVA = Appezzamento.PIVA) ")
        stbQ.Append("       and (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) ")
        stbQ.Append("       and (Appezzamento_Codici.appezza = Appezzamento.appezza) ")
        stbQ.Append("       and (Appezzamento_Codici.id_cod = 1104) ), '') AS App_Nome_Breve, " & vbCrLf)





        stbQ.Append(" ISNULL((SELECT TOP 1 Imprese_Progetti.Progetto_Nome FROM Imprese_Progetti " & vbCrLf)
        stbQ.Append("       WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
        stbQ.Append(" 	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
        stbQ.Append(" 	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
        stbQ.Append(" 	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG  " & vbCrLf)

        'se ho scelto una data unica per la stampa..
        If Qs_DataStampa <> "" Then
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
        Else
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
            stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
        End If

        stbQ.Append(" 	     ORDER BY Imprese_Progetti.Validita_Inizio DESC ), '') AS Lotto " & vbCrLf)

        stbQ.Append(" FROM Agenda INNER JOIN ")
        stbQ.Append(" Movimenti ON Agenda.Id_Agenda = Movimenti.Id_Agenda AND Agenda.PIVA = Movimenti.PIVA AND  ")
        stbQ.Append(" Agenda.Sa_Cod = Movimenti.Sa_Cod INNER JOIN ")
        stbQ.Append(" Movimenti_dettagli ON Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov AND Movimenti.PIVA = Movimenti_dettagli.PIVA AND  ")
        stbQ.Append(" Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod AND Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda INNER JOIN ")
        stbQ.Append(" Mov_Dettaglio_Tecnico ON Movimenti_dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov AND  ")
        stbQ.Append(" Movimenti_dettagli.PIVA = Mov_Dettaglio_Tecnico.Piva AND Movimenti_dettagli.Sa_Cod = Mov_Dettaglio_Tecnico.Sa_Cod AND  ")
        stbQ.Append(" Movimenti_dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det INNER JOIN ")
        stbQ.Append(" Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND  ")
        stbQ.Append(" Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND  ")
        stbQ.Append(" Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND  ")
        stbQ.Append(" Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det INNER JOIN ")
        stbQ.Append(" Appezzamento ON Mov_Destinazioni.Piva = Appezzamento.PIVA AND Mov_Destinazioni.Sa_Cod = Appezzamento.SA_COD AND  ")
        stbQ.Append(" Mov_Destinazioni.Appezza = Appezzamento.APPEZZA INNER JOIN ")
        stbQ.Append(" Reg_Impianti ON Mov_Destinazioni.Piva = Reg_Impianti.PIVA AND Mov_Destinazioni.Sa_Cod = Reg_Impianti.SA_COD AND  ")
