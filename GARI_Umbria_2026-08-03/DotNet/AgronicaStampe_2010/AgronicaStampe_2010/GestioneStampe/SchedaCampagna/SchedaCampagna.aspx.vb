            '''    If Not HTCentri Is Nothing Then
            '''        Riga.App_Nome_Breve = String.Format("{0}/{1}", HTCentri.Item(String.Format("{0}{1}", CStr(Riga.Piva), CStr(Riga.Sa_Cod))), CStr(Riga.App_Nome_Breve))
            '''    End If

            '''End If

            Riga.Sa_Nome = CStr(Matrice(14, k))
            Riga.Data_Rilievo = CStr(Matrice(7, k))

            Riga.Ind_Mat_Cod = CInt(Matrice(8, k))
            Riga.Ind_Mat_Des = CStr(Matrice(9, k))

            Riga.Udm_Sim = CStr(Matrice(10, k))
            Riga.Qta = CDbl(Matrice(11, k))
            Riga.Data_Raccolta = CStr(Matrice(12, k))
            Riga.Veg_Des_e_Cul_Des = CStr(Matrice(16, k))


            If k = x - 1 And Resto <> 0 Then

            Else

                Riga.id_Agenda1 = CInt(Matrice(0, k + 1))

                Riga.Piva1 = CStr(Matrice(1, k + 1))
                Riga.Sa_Cod1 = CInt(Matrice(2, k + 1))
                Riga.Appezza1 = CInt(Matrice(3, k + 1))
                Riga.Id_Reg1 = CInt(Matrice(4, k + 1))
                Riga.Campo_Nome1 = CStr(Matrice(15, k + 1))
                Riga.Cul_Des1 = CStr(Matrice(5, k + 1))

                Riga.Appezza_Nome1 = Matrice(6, k + 1)
                Riga.App_Nome_Breve1 = CStr(Matrice(13, k + 1))

                Riga.App_Nome_Breve1 = CodiceAppezzamento(Riga.Piva1, Riga.Sa_Cod1, Riga.Campo_Nome1, Riga.Appezza1,
                                                         TipoCodAppezzamento,
                                                         Riga.Appezza_Nome1, Riga.App_Nome_Breve1, -1, lotto:=CStr(Matrice(17, k + 1)))


                Riga.Sa_Nome1 = CStr(Matrice(14, (k + 1)))

                Riga.Data_Rilievo1 = CStr(Matrice(7, k + 1))

                Riga.Ind_Mat_Cod1 = CInt(Matrice(8, k + 1))
                Riga.Ind_Mat_Des1 = CStr(Matrice(9, k + 1))

                Riga.Udm_Sim1 = CStr(Matrice(10, k + 1))
                Riga.Qta1 = CDbl(Matrice(11, k + 1))
                Riga.Data_Raccolta1 = CStr(Matrice(12, k + 1))
                Riga.Veg_Des_e_Cul_Des1 = CStr(Matrice(16, k + 1))


            End If

            DsRilievoIndiciMaturita._Ds_RilievoIndiciMaturita.Rows.Add(Riga)

            k += 1

        Next

        DsRilievoIndiciMaturita._Ds_RilievoIndiciMaturita.AcceptChanges()
        DsRilievoIndiciMaturita._Ds_RilievoIndiciMaturita.Columns("Piva").ColumnName = "Piva_old"
        DsRilievoIndiciMaturita._Ds_RilievoIndiciMaturita.Columns("PivaReale").ColumnName = "Piva"
        DsRilievoIndiciMaturita._Ds_RilievoIndiciMaturita.Columns("Piva_old").ColumnName = "PivaReale"

        EndWatch(swP, "CaricaDsRilievoIndiciMaturita")

