    '###########################################################################
    Private Function ParcoMacchine_RicavaCaratteristicheTecniche(ByVal Class_desc As String,
                                                                 ByVal mac_des As String,
                                                                 ByVal Targa As String,
                                                                 ByVal Telaio As String,
                                                                 ByVal Modello As String,
                                                                 ByVal Potenza As String,
                                                                 ByVal ditta_des As String,
                                                                 ByVal Taratura_Ugello As Double,
                                                                 ByVal Validita_Taratura_Inizio As Date,
                                                                 ByVal Validita_Taratura_Fine As Date
                                                                 ) As String

        Dim CaratteristicheTecniche As String = ""

        CaratteristicheTecniche = Class_desc

        If mac_des <> "" Then
            CaratteristicheTecniche &= " - " & mac_des
        End If
        If Modello <> "" Then
            CaratteristicheTecniche &= " - Modello: " & Modello
        End If
        If ditta_des <> "" Then
            CaratteristicheTecniche &= " - " & ditta_des
        End If
        If Targa <> "" Then
            CaratteristicheTecniche &= " - Targa: " & Targa
        End If
        If Telaio <> "" Then
            CaratteristicheTecniche &= " - Telaio: " & Telaio
        End If
        If Potenza <> "" Then
            CaratteristicheTecniche &= " - Potenza: " & Potenza
        End If
        If Taratura_Ugello <> 0 Then
            CaratteristicheTecniche &= " - Taratura Ugello: " & CStr(Taratura_Ugello)
        End If
        If Validita_Taratura_Inizio <> AGRODATAINIZIO Then
            CaratteristicheTecniche &= " - Taratura valida dal " & Validita_Taratura_Inizio.ToShortDateString
        End If
        If Validita_Taratura_Fine <> AGRODATAFINE Then
            CaratteristicheTecniche &= " al " & Validita_Taratura_Fine.ToShortDateString
        End If

        Return CaratteristicheTecniche

    End Function

    '###########################################################################
    Private Function ParcoMacchine_RicavaNote(ByVal Note As String,
                                             ByVal Scadenza As Date,
                                             ByVal doc_numero As Double,
                                              ByVal rag_soc As String,
                                              ByVal nome As String,
                                              ByVal cognome As String,
                                             ByVal Data_Immatricolazione As Date,
                                            ByVal N_Immatricolazione As String,
                                            ByVal N_Autorizzazione_Trasporto As String,
                                            ByVal Data_Rilascio_Autorizzazione As Date
                                            ) As String

        Dim NoteTot As String = ""

        NoteTot = Note

        If Scadenza <> AGRODATAINIZIO AndAlso Scadenza <> AGRODATAFINE Then
            NoteTot &= " - scadenza : " & Scadenza.ToShortDateString
        End If

        If doc_numero <> 0 Then
            NoteTot &= " - certificato n.: " & CStr(doc_numero)
        End If

        If rag_soc <> "" Then
            NoteTot &= " - centro revisione: " & rag_soc
        ElseIf cognome <> "" OrElse nome <> "" Then
            NoteTot &= " - centro revisione: " & cognome & " " & nome
        End If

        If N_Immatricolazione <> "" Then
            NoteTot &= " - n. immatricolazione: " & N_Immatricolazione
        End If
        If Data_Immatricolazione <> AGRODATAINIZIO Then
            NoteTot &= " - data immatricolazione: " & Data_Immatricolazione.ToShortDateString
        End If
        If N_Autorizzazione_Trasporto <> "" Then
            NoteTot &= " - n. autorizzazione trasporto: " & N_Autorizzazione_Trasporto
        End If
        If Data_Rilascio_Autorizzazione <> AGRODATAINIZIO Then
            NoteTot &= " - data rilascio autorizzazione: " & Data_Rilascio_Autorizzazione.ToShortDateString
        End If


        Return NoteTot

    End Function



