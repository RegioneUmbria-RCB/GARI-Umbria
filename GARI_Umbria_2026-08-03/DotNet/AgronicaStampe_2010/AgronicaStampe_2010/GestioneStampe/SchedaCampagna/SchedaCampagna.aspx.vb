            stbQuery.Append(strImpianti & vbCrLf)
            stbQuery.Append(strImpianti2 & vbCrLf)
            stbQuery.Append(" ) -- fine exists " & vbCrLf)
            'End If


            stbQuery.Append("  ORDER BY Campo_Nome " & vbCrLf)

            objSQL.EseguiQuery_Lettura(objParametri_Server, stbQuery.ToString, "SchedaCampagna.CaricaDsCatasto", DSCatasto, DSCatasto._DS_Catasto.TableName)


            If Not IsNothing(DSCatasto) Then

                Dim Occupazione_des As String = ""

                For i = 0 To DSCatasto._DS_Catasto.Rows.Count - 1

                    drR = DSCatasto._DS_Catasto.Rows(i)

                    Occupazione_des = AGEA_Ricava_OccupazioneDes(Nothing, Nothing,
                                                                drR.Sa_Cod,
                                                                drR.Appezza,
                                                                drR.Id_Reg,
                                                                 HT_OccupazioneDes)

                    If Occupazione_des <> "" Then
                        drR.Veg_Des &= " / " & Occupazione_des
                    End If

                    'nel caso del campoxparticelle (AINPO) non devo ricavare il nome
                    If drR.Appezza <> 0 Then
                        drR.App_Nome_Breve = CodiceAppezzamento(drR.Piva, drR.Sa_Cod, drR.Campo_Nome, drR.Appezza,
                                      TipoCodAppezzamento,
                                      drR.App_Nome, drR.App_Nome_Breve, -1, lotto:=drR.Progetto)
                    Else
                        'visualizza centro e nome del campo
                        Dim lotto = ""
                        If Not IsNothing(drR.Progetto) Then
                            lotto = drR.Progetto
                        End If
                        drR.App_Nome_Breve = String.Format("{0}/{1}//{2}", HTCentri.Item(String.Format("{0}{1}", drR.Piva, drR.Sa_Cod)), drR.Campo_Nome, lotto)
                    End If

                    '----------------------------------------------
                    'per id consociazione
                    Try

                        'nel caso del campox particelle (AINPO) non devo ricavare
                        If drR.Appezza <> 0 And drR.Id_Reg <> 0 Then
                            Dim objImp As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
                            Dim ID_Consociazione As Integer
                            Dim Tot_Consociati As Integer
                            Dim Sigla_Consociazione As String
                            If ControllaProgressivoConsociazione(drR.Piva, drR.Sa_Cod, drR.Appezza, drR.Id_Reg, ID_Consociazione, Tot_Consociati, Sigla_Consociazione, objParametri_Server) Then
                                drR.App_Nome_Breve &= "/" & Sigla_Consociazione & ""
                                'drR.App_Nome_Breve &= "/" & ID_Consociazione & ""
                            End If
                        End If

                    Catch ex As Exception

                    End Try

                    '----------------------------------------------

                    If drR.FOGLIO = "0" Then
                        drR.FOGLIO = ""
                    End If

                    If drR.NUMERO = "0" Then
                        drR.NUMERO = ""
                    End If

                    If drR.SEZIONE = "0" Then
                        drR.SEZIONE = ""
                    End If

                    If drR.SUBALTERNO = "0" Then
                        drR.SUBALTERNO = ""
                    End If

                    If drR.AREA = "0" Then
                        drR.AREA = ""
                    End If


                    If Not (drR.Ettari = "0" And drR.Are = "0" And drR.Centiare = "0") Then
                        drR.Sup_Particella = Ettari_from_EttariAreCentiare(CDbl(drR.Ettari), CDbl(drR.Are), CDbl(drR.Centiare))
                    End If

                    If drR.Sup_Particella = "0" Then
                        drR.Sup_Particella = ""
                    End If

                    drR.Sup_Imp = Format(CDbl(drR.Sup_Imp), "0.0000")

                    If drR.AREA <> "" Then
                        drR.AREA = Format(CDbl(drR.AREA), "0.0000")
                    End If

                    If drR.Sup_Particella <> "" Then
                        drR.Sup_Particella = Format(CDbl(drR.Sup_Particella), "0.0000")
                    End If

                Next


                '--------------------------------------------------------------------------------------
                'ORDINO IL DATASET
                '(per farlo importo nell'ordine le datarow ordinate e poi elimino le vecchie righe)
                '--------------------------------------------------------------------------------------

                Dim Righe_Old As Integer
                Dim dr As DataRow

                Righe_Old = DSCatasto._DS_Catasto.Count

                If Righe_Old > 1 Then

                    Select Case tipo_ordinamento
                        Case 1
                            For Each dr In DSCatasto._DS_Catasto.Select("", "veg_des, campo_nome, App_Nome_Breve")
                                DSCatasto._DS_Catasto.ImportRow(dr)
                            Next

                        Case Else

                            For Each dr In DSCatasto._DS_Catasto.Select("", "campo_nome, App_Nome_Breve")
                                DSCatasto._DS_Catasto.ImportRow(dr)
                            Next

                    End Select

                    'è importante farlo prima del delete!!!!!!!!!!
                    'rendo permanenti le modifiche sul ds
                    DSCatasto._DS_Catasto.AcceptChanges()

                    For i = 0 To Righe_Old - 1
                        DSCatasto._DS_Catasto.Rows(i).Delete()
                    Next

                    'rendo permanenti le modifiche sul ds
                    DSCatasto._DS_Catasto.AcceptChanges()

                    DSCatasto._DS_Catasto.Columns("Piva").ColumnName = "Piva_old"
                    DSCatasto._DS_Catasto.Columns("PivaReale").ColumnName = "Piva"
                    DSCatasto._DS_Catasto.Columns("Piva_old").ColumnName = "PivaReale"

                End If

            End If

        Catch ex As Exception
            Log_Errori &= "CaricaDsCatasto: " & vbCrLf & ex.Message & vbCrLf
            Throw New Exception(Log_Errori)
        End Try

        EndWatch(sw, "CaricaDsCatasto")


    End Sub


    '###########################################################################
    'query x caricare i dati x le semine di PIZZOLI.. enum_TipoReport.SchedaCampagna_Pizzoli
    '  Galassi, 07/08/2017 11.48.56: NB: La stampa è rimasta disallineata dal lontano Mesozoico per cui le info sono state integrate nel solo global nelle note --> CaricaDsSemine
    Private Sub CaricaDsSemine2()

        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String
        Dim stbQuery As New System.Text.StringBuilder

        'Dim ObjCOM_R As Object 'Agro_Anagrafe_AD.Reg_Impianti_Codici_R
        Dim Reg_Impianti_Codici_R As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Codici_R
        Dim rs As DataTable

        Dim i, appIndex As Integer

        Dim App_Nome As String
        Dim Num_Appezzamento As Integer

        Dim DefaultCopy() As StampeDefault


        Dim sw As Stopwatch = StartWatch("CaricaDsSemine2")

        If Not defaults Is Nothing Then
            ReDim DefaultCopy(defaults.Length - 1)
            Array.Copy(defaults, DefaultCopy, defaults.Length)
        End If

        stbQuery.Append(" SELECT DISTINCT ")
        stbQuery.Append(" Cultivar.Cul_Des, CONVERT(varchar,Agenda.Validita_Inizio, 103) AS DataSemina, Agenda.Validita_Inizio, Mov_Destinazioni.Qta, ")
        stbQuery.Append(" Movimenti_dettagli.Udm_Cod, UnitaMisura.UDM_SIM, Materie_Prime.Cod_Articolo,Materie_Prime.Mat_Cod,Materie_Prime.Mat_Des, ")
        stbQuery.Append(" Reg_Impianti.sup_imp, ")

        stbQuery.Append(" Reg_Impianti.PIVA, Reg_Impianti.SA_COD, Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG, ")
        stbQuery.Append(" Agenda.Id_Agenda, Agenda.Lav_Cod, Appezzamento.APP_NOME, ")

        stbQuery.Append(" ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici  ")
        stbQuery.Append("       where (Appezzamento_Codici.PIVA = Appezzamento.PIVA) ")
        stbQuery.Append("       and (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) ")
        stbQuery.Append("       and (Appezzamento_Codici.appezza = Appezzamento.appezza) ")
        stbQuery.Append("       and (Appezzamento_Codici.id_cod = 1104) ), '') AS App_Nome_Breve ")

        'stbQuery.Append(", ISNULL((SELECT TOP 1 val_cod  ")
        'stbQuery.Append(" FROM Reg_Impianti_Codici ")
        ''stbQuery.Append(" WHERE (id_cod = 1083) AND (PIVA = '" & Piva & "') AND (sa_cod = '" & Sa_Cod & "') ")
        'stbQuery.Append(" WHERE (id_cod = 1083) ")
        'stbQuery.Append(" ),'') AS TagliatoIntero ")

        'stbQuery.Append(", ISNULL((SELECT TOP 1 val_cod  ")
        'stbQuery.Append(" FROM Reg_Impianti_Codici ")
        ''stbQuery.Append(" WHERE (id_cod = 1083) AND (PIVA = '" & Piva & "') AND (sa_cod = '" & Sa_Cod & "') ")
        'stbQuery.Append(" WHERE (id_cod = 1084) ")
        'stbQuery.Append(" ),'') AS PartiTuberi ")

        stbQuery.Append(" FROM Reg_Impianti INNER JOIN ")
        stbQuery.Append(" Movimenti_dettagli INNER JOIN ")
        stbQuery.Append(" Mov_Destinazioni ON Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva AND ")
        stbQuery.Append(" Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND ")
        stbQuery.Append(" Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det AND ")
        stbQuery.Append(" Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov INNER JOIN ")
        stbQuery.Append(" Movimenti ON Movimenti_dettagli.PIVA = Movimenti.PIVA AND Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod AND ")
        stbQuery.Append(" Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda AND Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov INNER JOIN ")
        stbQuery.Append(" Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND ")
        stbQuery.Append(" Movimenti.Id_Agenda = Agenda.Id_Agenda INNER JOIN ")
        stbQuery.Append(" UnitaMisura ON Movimenti_dettagli.Udm_Cod = UnitaMisura.UDM_COD ON Reg_Impianti.PIVA = Mov_Destinazioni.Piva AND ")
        stbQuery.Append(" Reg_Impianti.SA_COD = Mov_Destinazioni.Sa_Cod AND Reg_Impianti.APPEZZA = Mov_Destinazioni.Appezza AND ")
        stbQuery.Append(" Reg_Impianti.ID_REG = Mov_Destinazioni.Id_Destinazione INNER JOIN ")
        stbQuery.Append(" Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod INNER JOIN ")
        stbQuery.Append(" SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod INNER JOIN ")
        stbQuery.Append(" Appezzamento ON Mov_Destinazioni.Piva = Appezzamento.PIVA AND Mov_Destinazioni.Sa_Cod = Appezzamento.SA_COD AND ")
        stbQuery.Append(" Mov_Destinazioni.Appezza = Appezzamento.APPEZZA LEFT OUTER JOIN ")
        stbQuery.Append(" Materie_Prime ON Movimenti_dettagli.Elem_Cod = Materie_Prime.Elem_Cod AND ")
        stbQuery.Append(" Movimenti_dettagli.Mat_Cod = Materie_Prime.Mat_Cod ")

        If IDTestataTemp <> 0 Then

            stbQuery.Append(" inner Join __tmp_FiltroImpianti f ")
            stbQuery.Append(" On  Reg_Impianti.PIVA = f.piva  ")
            stbQuery.Append(" And Reg_Impianti.SA_COD = f.sa_cod ")
            stbQuery.Append(" And Reg_Impianti.APPEZZA = f.appezza ")
            stbQuery.Append(" And Reg_Impianti.ID_REG = f.id_reg ")
            stbQuery.Append("       And f.idTestataTemp = " & IDTestataTemp)
            stbQuery.Append("       And f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
            stbQuery.Append("       And f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

        End If

        stbQuery.Append("WHERE Agenda.Lav_Cod IN (2, 71, 160) AND Movimenti.Cau_Mov = '2300' ")

        If Veg_Cod = "0" Then
            stbQuery.Append(" and Reg_Impianti.cul_cod = 0 ")
        Else
            If TerrenoNudoIncluso = False Then
                stbQuery.Append(" AND SpecieVegetali.VEG_COD = " & Veg_Cod)
            Else
                stbQuery.Append(" AND (SpecieVegetali.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) ")
            End If
        End If

        stbQuery.Append(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")
        If Sa_Cod <> "0" Then
            stbQuery.Append(" AND Agenda.sa_cod = " & Sa_Cod & " ")
        End If

        'stbQuery.Append(strFiltroImpianti)


        'se ho scelto una data unica per la stampa..
        If Qs_DataStampa <> "" Then

            stbQuery.Append(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            stbQuery.Append(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            stbQuery.Append(" AND Agenda.Validita_Inizio = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")

        Else

            stbQuery.Append(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stbQuery.Append(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")

            stbQuery.Append(" AND Agenda.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stbQuery.Append(" AND Agenda.Validita_Inizio >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")

        End If

        stbQuery.Append(" AND Movimenti_dettagli.contabilizzato >= 0 ")

        stbQuery.Append(" ORDER BY Agenda.Validita_Inizio, Agenda.Id_Agenda ")

        'ds tipizzato...ci copio le righe dentro
        'DsSemine2 = New DS_Semine2
        'eseguo la query e controllo gli errori
        'objSql.SqlSelect(Session("ASG_Pathfilei..."), Session("ASG_Connessione_Server"), stbQuery.ToString, DsSemine2, _
        '                        DsSemine2.DS_Semine_2.TableName, strErr)

        strErr = Nothing

        Try
            objSql.EseguiQuery_Lettura(objParametri_Server, stbQuery.ToString, "CaricaDsSemine2", DsSemine2, DsSemine2.DS_Semine_2.TableName)
        Catch ex As Exception
            strErr = ex.Message
        End Try



        'controllo errori 
        If IsNothing(strErr) Then

            For i = 0 To DsSemine2.DS_Semine_2.Rows.Count - 1


                'Modifica 27/07/2012 
                'al posto della varieta nella stampa della semina metto il mat_des
                'così per il sovescio si vede anche la specie usata
                DsSemine2.DS_Semine_2.Rows(i).Item("Cul_Des") = DsSemine2.DS_Semine_2.Rows(i).Item("Mat_Des")


                DsSemine2.DS_Semine_2.Rows(i).Item("DataSemina") = CDate(DsSemine2.DS_Semine_2.Rows(i).Item("DataSemina")).ToShortDateString

                '----------------------------------------------------------
                '---                Impianti Codici                     ---
                '----------------------------------------------------------

                'ObjCOM_R = Server.C.....ect("Agro_Anagrafe_AD.Reg_Impianti_Codici_R")

                'leggo se sono state salvate le colture precedenti

                Dim filtro As String = "( (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_Parti_Tuberi_Patate) +
                            ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_Taglio_Tuberi_Patate) +
                            ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_TraFila_Maschio) +
                            ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_SuFila_Maschio) +
                            ") )"
                rs = Reg_Impianti_Codici_R.Leggi(CStr(Piva),
                                    CInt(DsSemine2.DS_Semine_2.Rows(i).Item("sa_cod")),
                                    CInt(DsSemine2.DS_Semine_2.Rows(i).Item("appezza")),
                                    CInt(DsSemine2.DS_Semine_2.Rows(i).Item("id_reg")),
                                    "", 0, "", AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                                    filtro, "", objParametri_Server)

                'In ogni caso imposto = ""
                DsSemine2.DS_Semine_2.Rows(i).Item("PartiTuberi") = ""
                DsSemine2.DS_Semine_2.Rows(i).Item("TagliatoIntero") = ""
                DsSemine2.DS_Semine_2.Rows(i).Item("SuFila") = ""
                DsSemine2.DS_Semine_2.Rows(i).Item("TraFila") = ""

                'rs.Filter = " (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_Parti_Tuberi_Patate) + _
                '            ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_Taglio_Tuberi_Patate) + _
                '            ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_TraFila_Maschio) + _
                '            ") or (id_cod=" + CStr(enum_CodiciAnagrafe.Impianto_SuFila_Maschio) + _
                '            ")"

                If Not IsNothing(rs) AndAlso rs.Rows.Count <> 0 Then
                    Dim j As Integer = 0
                    For j = 0 To rs.Rows.Count - 1

                        Select Case rs.Rows(j).Item("id_cod")

                            Case enum_CodiciAnagrafe.Impianto_Parti_Tuberi_Patate

                                DsSemine2.DS_Semine_2.Rows(i).Item("PartiTuberi") = rs.Rows(j).Item("val_cod")

                            Case enum_CodiciAnagrafe.Impianto_Taglio_Tuberi_Patate

                                DsSemine2.DS_Semine_2.Rows(i).Item("TagliatoIntero") = rs.Rows(j).Item("val_cod")

                            Case enum_CodiciAnagrafe.Impianto_SuFila_Maschio

                                DsSemine2.DS_Semine_2.Rows(i).Item("SuFila") = rs.Rows(j).Item("val_cod")

                            Case enum_CodiciAnagrafe.Impianto_TraFila_Maschio

                                DsSemine2.DS_Semine_2.Rows(i).Item("TraFila") = rs.Rows(j).Item("val_cod")

                        End Select

                        'rs.MoveNext()

                    Next

                End If

                '----------------------------------------------------------

                'se il nome dell'appezzamento contiene un numero indico questo
                'altrimenti lascio appezza-basecode
                Dim objNum As New AgronicaCoreDataProvider.UtilityProvider
                Num_Appezzamento = objNum.Numero_from_Stringa(DsSemine2.DS_Semine_2.Rows(i).Item("app_nome"))

                'Num_Appezzamento = AppezzamentoNumero_from_AppezzamentoNome(Server, Session, Page, DsSemine2.DS_Semine2.Rows(i).Item("app_nome"))

                If Num_Appezzamento <> 0 Then
                    DsSemine2.DS_Semine_2.Rows(i).Item("app_nome") = CStr(Num_Appezzamento)
                Else
                    DsSemine2.DS_Semine_2.Rows(i).Item("app_nome") = DsSemine2.DS_Semine_2.Rows(i).Item("appezza") - BaseCode
                    'se è un valore alto lo tronco alle ultime 3 cifre..
                    If CStr(DsSemine2.DS_Semine_2.Rows(i).Item("app_nome")).Length > 3 Then
                        DsSemine2.DS_Semine_2.Rows(i).Item("app_nome") = Right(CStr(DsSemine2.DS_Semine_2.Rows(i).Item("app_nome")), 3)
                    End If
                End If

                If DsSemine2.DS_Semine_2.Rows(i).Item("app_nome_breve") = "" Then
                    DsSemine2.DS_Semine_2.Rows(i).Item("app_nome_breve") = DsSemine2.DS_Semine_2.Rows(i).Item("app_nome")
                End If

                '----------------------------------------------
                'per id consociazione
                Try

                    Dim objImp As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
                    Dim ID_Consociazione As Integer
                    Dim Tot_Consociati As Integer
                    Dim Sigla_Consociazione As String
                    If ControllaProgressivoConsociazione(Piva, DsSemine2.DS_Semine_2.Rows(i).Item("sa_cod"), DsSemine2.DS_Semine_2.Rows(i).Item("APPEZZA"), DsSemine2.DS_Semine_2.Rows(i).Item("ID_REG"), ID_Consociazione, Tot_Consociati, Sigla_Consociazione, objParametri_Server) Then
                        DsSemine2.DS_Semine_2.Rows(i).Item("App_Nome_Breve") &= "/" & Sigla_Consociazione & ""
                        'DsSemine2.DS_Semine2.Rows(i).Item("App_Nome_Breve") &= "/" & ID_Consociazione & ""
                    End If

                Catch ex As Exception

                End Try

                '----------------------------------------------

                If i > 0 Then
                    If DsSemine2.DS_Semine_2.Rows(i).Item("id_agenda") = DsSemine2.DS_Semine_2.Rows(i - 1).Item("id_agenda") Then

                        DsSemine2.DS_Semine_2.Rows(i).Item("DataSemina") = ""

                        If DsSemine2.DS_Semine_2.Rows(i).Item("piva") = DsSemine2.DS_Semine_2.Rows(i - 1).Item("piva") And
                           DsSemine2.DS_Semine_2.Rows(i).Item("sa_cod") = DsSemine2.DS_Semine_2.Rows(i - 1).Item("sa_cod") And
                           DsSemine2.DS_Semine_2.Rows(i).Item("appezza") = DsSemine2.DS_Semine_2.Rows(i - 1).Item("appezza") And
                           DsSemine2.DS_Semine_2.Rows(i).Item("id_reg") = DsSemine2.DS_Semine_2.Rows(i - 1).Item("id_reg") Then

                            'CALL TROVA TagliatoIntero e PartiTuberi

                            DsSemine2.DS_Semine_2.Rows(i).Item("sup_imp") = 0
                            DsSemine2.DS_Semine_2.Rows(i).Item("cul_des") = ""
                            DsSemine2.DS_Semine_2.Rows(i).Item("app_nome") = ""

                        End If

                    End If
                End If


                For appIndex = 0 To DefaultCopy.Length - 1

                    If Not DefaultCopy(appIndex) Is Nothing AndAlso CInt(DsSemine._DS_Semine.Rows(i).Item("appezza")) = DefaultCopy(appIndex).Appezza Then

                        DefaultCopy(appIndex) = Nothing
                    End If
                Next

            Next

            Dim InserisciSeminaPrevista As Boolean

            'Per gli appezzamenti per cui non sono state registrate semine, aggiungo una riga con
            'data semina prevista
            If Not defaults Is Nothing AndAlso
                defaults.Length > 0 AndAlso
                    DsSemine2.DS_Semine_2.Rows.Count < defaults.Length Then

                For i = 0 To defaults.Length - 1

                    InserisciSeminaPrevista = False

                    If Not DefaultCopy(i) Is Nothing AndAlso defaults(i).Data_Semina <> AGRODATAINIZIO Then

                        'se ho scelto una data unica per la stampa..
                        If Qs_DataStampa <> "" Then
                            If CDate(defaults(i).Data_Semina) >= CDate(Qs_DataStampa) And
                              CDate(defaults(i).Data_Semina) <= CDate(Qs_DataStampa) Then
                                InserisciSeminaPrevista = True
                            End If
                        Else
                            If CDate(defaults(i).Data_Semina) >= CDate(Qs_DataInizio) And
                               CDate(defaults(i).Data_Semina) <= CDate(Qs_DataFine) Then
                                InserisciSeminaPrevista = True
                            End If
                        End If

                        If InserisciSeminaPrevista = True Then

                            Dim newRow = DsSemine2.DS_Semine_2.NewDS_Semine_2Row()

                            newRow.DataSemina = defaults(i).Data_Semina
                            newRow.Lotto = defaults(i).Lotto

                            If Not HTCentri Is Nothing Then
                                newRow.App_Nome_Breve = String.Format("{0}/{1}", HTCentri.Item(String.Format("{0}{1}", CStr(defaults(i).Piva), CStr(defaults(i).Sa_Cod))), CStr(defaults(i).Num_App))
                            Else
                                newRow.App_Nome_Breve = CStr(defaults(i).Num_App)
                            End If

                            newRow.Cul_Des = defaults(i).Cul_Des
                            newRow.Sup_Imp = defaults(i).Sup_HA_App
                            newRow.Piva = defaults(i).Piva
                            newRow.Sa_Cod = defaults(i).Sa_Cod

                            DsSemine2.DS_Semine_2.Rows.Add(newRow)

                        End If

                    End If

                Next

            End If

            DsSemine2.DS_Semine_2.Columns("Piva").ColumnName = "Piva_old"
            DsSemine2.DS_Semine_2.Columns("PivaReale").ColumnName = "Piva"
            DsSemine2.DS_Semine_2.Columns("Piva_old").ColumnName = "PivaReale"
        Else
            'eccezione......
            Throw New Exception(strErr)
        End If

        EndWatch(sw, "CaricaDsSemine2")

    End Sub



    '###########################################################################
    'carico il dataset x il parco macchine 
