#Region "Wathcer"

    Private Function Leggi_Se_Watcher_Abilitato() As Boolean

        Dim objConfigSiti As New AgronicaCoreVarieDAL.Configurazione_Siti_R

        Dim DTConfigSiti As DataTable = objConfigSiti.Leggi(0, "Log_Scheda_Campagna_Abilitato", "", "", objParametri_Server)

        Dim logAbilitato As Boolean = False

        If Not IsNothing(DTConfigSiti) AndAlso DTConfigSiti.Rows.Count > 0 Then
            Dim vs = DTConfigSiti.Rows(0).Item("Valore").ToString
            If String.IsNullOrEmpty(vs) Then
                Return False
            Else
                If Boolean.TryParse(vs, logAbilitato) Then
                    Return logAbilitato
                Else
                    Return False
                End If
            End If
        Else
            Return False
        End If

    End Function

    Private Function StartWatch(ByVal messaggio As String) As Stopwatch

        If WatcherAbilitato Then

            Dim sw As New Stopwatch
            sw.Start()
            lp.Scrivi_LOG(objParametri_Server, "", String.Format("START {0}", messaggio))
            Return sw
        Else
            Return Nothing
        End If

    End Function

    Private Sub EndWatch(ByVal sw As Stopwatch, ByVal messaggio As String)

        If WatcherAbilitato AndAlso Not IsNothing(sw) Then
            sw.Stop()
            lp.Scrivi_LOG(objParametri_Server, "", String.Format("STOP {0}", messaggio))
            lp.Scrivi_LOG(objParametri_Server, "", String.Format("ELAPSED {0} {1}", messaggio, sw.ElapsedMilliseconds))
        End If

    End Sub

#End Region


