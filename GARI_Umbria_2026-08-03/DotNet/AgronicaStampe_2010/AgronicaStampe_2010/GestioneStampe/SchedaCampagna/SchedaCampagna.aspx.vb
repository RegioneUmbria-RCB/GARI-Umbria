    Private Sub CaricaDsChecklist_PraticheEcologiche(ByVal disp As Integer, ByVal RegolamentoCod As Integer)

        Dim dr As Ds_checklistDS.DS_ChecklistRow

        Dim DLL_Sezioni As New AgronicaCoreAuditDAL.Audit_Sezioni_R

        Dim DLL_codici As New AgronicaCoreAuditDAL.Audit_Codici_R




        Dim Audit_Data_Inizio As Date = AGRODATAINIZIO
        Dim Audit_Data_Fine As String = AGRODATAFINE
        Dim Audit_Cod As Integer = 0

        'Dim DT_Disp As DataTable
        Dim DT_Sezioni As DataTable
        Dim DT_Codici As DataTable

        Dim FiltroParte As Integer
        Dim bAggiungiSezione As Boolean

        Dim strErr As String = String.Empty


        Dim sw As Stopwatch = StartWatch("CaricaDsChecklist_PraticheEcologiche")

        ' se il FiltroParte = 0 allora stampo entrambe le parti della check-list (elementi di verifica e calcolo riduzione)
        ' se Qs_AuditCod=0 vuol dire che voglio stampare la check vuota e devo stampare sia la prima che la seconda parte
        'FiltroParte = 0
        'If Qs_AuditCod <> "0" AndAlso DLL_AD.EsitoDisposizione(Session("ASG_SuperUser_CodFiscale"), enum_AuditTipi.AuditTipi_SicurezzaLavoro, _
        '                                                     CInt(Qs_RegolamentoCod), _
        '                                                     CInt(Qs_AuditCod), CInt(disp), _
        '                                                     enum_AuditSezioni.AuditSezioni_ElementiVerifica, _
        '                                                     enum_AuditSezioni.AuditSezioni_Deroghe) Then
        '    FiltroParte = 1
        'End If

        'DT_Disp = DLL_AD.AuditDisposizioni_Leggi(enum_AuditTipi.AuditTipi_PraticheEcologicheAPOT, _
        '                                         CInt(RegolamentoCod), _
        '                                         CInt(disp), "", strErr)

        Dim Elenco_Audit As DataTable = New AgronicaCoreAuditDAL.Audit_R().Leggi(0, enum_AuditTipi.AuditTipi_PraticheEcologicheAPOT, RegolamentoCod, Piva, AGRODATAINIZIO, AGRODATAFINE, "", "Audit_cod desc", objParametri_Server)
        If Not Elenco_Audit Is Nothing AndAlso Elenco_Audit.Rows.Count > 0 Then
            Audit_Cod = Elenco_Audit(0).Item("Audit_Cod")
        Else
            Audit_Cod = 0
        End If

        DT_Sezioni = DLL_Sezioni.Leggi(enum_AuditTipi.AuditTipi_PraticheEcologicheAPOT, CInt(RegolamentoCod), 0, 0, #1/1/1900#, strErr, "", "", objParametri_Server)

        ' ciclo sulle sezioni ordinate per Ordine
        For i = 0 To DT_Sezioni.Rows.Count - 1

            bAggiungiSezione = True

            DT_Codici = DLL_codici.Leggi(enum_AuditTipi.AuditTipi_PraticheEcologicheAPOT, CInt(RegolamentoCod), CInt(disp), CInt(DT_Sezioni.Rows(i).Item("Sezione_Cod")), FiltroParte, strErr, "", "", objParametri_Server, CInt(Audit_Cod), , , ,
                                                 , , Audit_Data_Inizio, Audit_Data_Fine)

            Dim Riga As HtmlTableRow
            Dim Cella As HtmlTableCell
            Dim Cella_dx As HtmlTableCell

            ' ciclo sui codici per creare i controlli
            For j = 0 To DT_Codici.Rows.Count - 1

                ' creo la riga della sezione
                dr = DSCheckList.DS_Checklist.NewDS_ChecklistRow

                dr.Disp_Cod = disp
                dr.Disp_Nome = "" 'DT_Disp.Rows(0).Item("Disp_Nome").ToString & " - " & DT_Disp.Rows(0).Item("Descrizione").ToString
                dr.Sezione_Cod = DT_Sezioni.Rows(i).Item("Sezione_Cod")
                dr.Sezione_Des = DT_Sezioni.Rows(i).Item("Sezione_Des")
                dr.Punto_Numero = DT_Codici.Rows(j).Item("Punto_Numero")
                dr.Descrizione = DT_Codici.Rows(j).Item("Descrizione")


                If DT_Codici.Rows(j).Item("Nota") = 0 Then

                    Select Case DT_Codici.Rows(j).Item("Tipo")

                        Case "c"

                            If Not IsDBNull(DT_Codici.Rows(j).Item("Valore")) Then
                                If DT_Codici.Rows(j).Item("Valore") = "1" Then
                                    dr.Valore = "þ"
                                    'dr.Valore = "Sì"
                                Else
                                    dr.Valore = "¨"
                                    'dr.Valore = "No"
                                End If
                            Else
                                dr.Valore = ""
                            End If

                            dr.ValoreText = ""


                        Case "n" 'Azione correttiva o rilievo

                            If Not IsDBNull(DT_Codici.Rows(j).Item("Valore")) Then

                                'dr.ValoreText = DT_Codici.Rows(j).Item("Valore").ToString
                                dr.Descrizione = dr.Descrizione + " " + DT_Codici.Rows(j).Item("Valore").ToString

                            End If

                            dr.ValoreText = ""
                            dr.Valore = ""


                        Case Else

                            dr.Valore = ""
                            dr.ValoreText = ""

                    End Select

                Else
                    dr.Valore = ""
                    dr.ValoreText = ""

                End If

                ' pulizia dei tag html
