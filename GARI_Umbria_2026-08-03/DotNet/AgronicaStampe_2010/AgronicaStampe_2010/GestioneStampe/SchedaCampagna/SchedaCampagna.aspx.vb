                            strBuffer &= "corpi idrici per " & drR.DistBZ_CorpiIdrici & " m" & ","
                        End If
                        If drR.DistBZ_AreeResPub <> 0 Then
                            strBuffer &= "aree residenziali/pubbliche per " & drR.DistBZ_AreeResPub & " m" & ","
                        End If
                        If drR.DistBZ_Allevamenti <> 0 Then
                            strBuffer &= "allevamenti per " & drR.DistBZ_Allevamenti & " m" & ","
                        End If
                        If drR.DistBZ_VegNatNonColt <> 0 Then
                            strBuffer &= "vegetazione naturale/non coltivata per " & drR.DistBZ_VegNatNonColt & " m" & ","
