                    'ciclo su tutte le righe del dataset per prelevare il capitolato privato da inserire in una stringa
                    Dim objCapit = New AgronicaCoreAnagrafeDAL.Reg_Impianti_Codici_R
                    Dim capitolato As New List(Of String)()
                    For i = 0 To DsErbacee.vw_rptErbacee.Rows.Count - 1
                        Dim drR As DS_Erbacee.vw_rptErbaceeRow = DsErbacee.vw_rptErbacee.Rows(i)
                        If drR.APPEZZA <> 0 AndAlso drR.ID_REG <> 0 Then
