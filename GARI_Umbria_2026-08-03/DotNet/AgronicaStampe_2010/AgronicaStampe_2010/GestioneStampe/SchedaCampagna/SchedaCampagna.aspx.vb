                    inserisciTraGliIdAgendaMovimentati(DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("id_agenda"))

                    DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("data_creazione") = Formatta_Data_Movimento(DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("data_creazione"))
                    DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("App_Nome_Breve") = CodiceAppezzamento(
                                                            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("piva"),
                                                            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("sa_cod"),
                                                            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("Campo_Nome"),
                                                            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("appezza"),
                                                            TipoCodAppezzamento,
                                                            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("App_Nome"),
                                                            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("App_Nome_Breve"),
                                                            -1, lotto:=DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("Lotto"))



                    '----------------------------------------------
                    'per id consociazione
                    Try

                        Dim objImp As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
                        Dim ID_Consociazione As Integer
                        Dim Tot_Consociati As Integer
                        Dim Sigla_Consociazione As String
                        If ControllaProgressivoConsociazione(DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("piva"),
                                                            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("sa_cod"),
                                                             DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("APPEZZA"), DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("ID_REG"), ID_Consociazione, Tot_Consociati, Sigla_Consociazione, objParametri_Server) Then
                            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("App_Nome_Breve") &= "/" & Sigla_Consociazione & ""
                            'DsAltreOperazioniCulturali.DS_AltreOperazioniCulturali.Rows(i).Item("App_Nome_Breve") &= "/" & ID_Consociazione & ""
                        End If

                    Catch ex As Exception

                    End Try

                    '----------------------------------------------

                    '----------------------------------------------
                    ' x ORDINAMENTO
                    DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("Ordinamento_Coltura") = DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("veg_des")
                    DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("Ordinamento_Data") = CDate(DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("Data_creazione"))
                    DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("Ordinamento_Operazione") = DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("lav_des")
                    DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("Ordinamento_AppezzaNomeBreve") = DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Item("app_nome_breve")
                    '----------------------------------------------

                Next


                Select Case tipo_ordinamento
                    Case 1

                        Dim Righe_Old As Integer
                        Righe_Old = DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Count

                        If Righe_Old > 1 Then

                            'For Each dr In DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Select("", "veg_des, Data_creazione, Lav_Des")
                            For Each dr In DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Select("", "Ordinamento_Coltura, Ordinamento_Data, Ordinamento_operazione, Ordinamento_AppezzaNomeBreve")
                                DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.ImportRow(dr)
                            Next

                            'è importante fare questa istruzione prima del delete!!!!
                            'rendo permanenti le modifiche sul ds
                            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.AcceptChanges()

                            For i = 0 To Righe_Old - 1
                                DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(i).Delete()
                            Next

                            'rendo permanenti le modifiche sul ds
                            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.AcceptChanges()

                        End If

                End Select


                '06/11/2018: aggiunta SchedaCampagna_Multi
                If TipoReport = enum_TipoReport.SchedaCampagna_Semplificata Or
                    TipoReport = enum_TipoReport.SchedaCampagna_Multicentro Or
                    TipoReport = enum_TipoReport.SchedaCampagna_ConserveItalia Or
                    TipoReport = enum_TipoReport.Eurep_Gap_Semplificata Or
                    TipoReport = enum_TipoReport.Eurep_Gap_Multicentro Or
                    TipoReport = enum_TipoReport.SchedaCampagna_Multicentro_ACA Or
                    TipoReport = enum_TipoReport.Prov_Aut_Trento Or
                    TipoReport = enum_TipoReport.SchedaCampagna_Multi Then

                    Dim objSqlDis As New AgronicaCoreDataProvider.DatatableUtility

                    'ottengo gli id_agenda e gli app_nome distinti
                    Dim strId_Agenda() As String = objSqlDis.SelectDistinct(DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali, "id_agenda")
                    'Dim strApp() As String = objSqlDis.SelectDistinct(DsAltreOperazioniCulturali.DS_AltreOperazioniCulturali, "APPEZZA")
                    'Modifica 04-12 per minisci che ha consociati, filtrando per appezza i datti dellla stessa op agenda 
                    'non vengono discriminati, occorre filtrare per id_reg che cambia nel consociato


                    Dim strID_Reg_Prima_Appezza(,) As String = objSqlDis.SelectDistinct(DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali, "APPEZZA", "ID_REG", False)


                    If Not strId_Agenda Is Nothing Then

                        For i = 0 To strId_Agenda.Length - 1

                            Dim drLav() As DS_AltreOperazioniCulturali.DS_AltreOperazioniCulturaliRow = DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Select("id_agenda=" & strId_Agenda(i))

                            If Lingua = 2 Then
                                Dim jj As Integer = 0
                                For jj = 0 To drLav.Length - 1
                                    Dim lavcod As Integer = New AgronicaCoreContabDAL.Agenda_R().Lav_Cod_From_Piva_Sa_Cod_Id_Agenda(drLav(jj).piva, drLav(jj).sa_cod, drLav(jj).Id_Agenda, objParametri_Server)
                                    drLav(jj).Lav_Des = New AgronicaCoreMetaSchemaDAL.Operazioni_R().LavorazioneDes_from_LavorazioneCod(lavcod, objParametri_Server)
                                Next
                            End If

                            strAppezzamenti = ""
                            'Modifica 04-12 per minisci che ha consociati, filtrando per appezza i datti dellla stessa op agenda 
                            'non vengono discriminati, occorre filtrare per id_reg che cambia nel consociato
                            'For w = 0 To strApp.Length - 1
                            For w = 0 To strID_Reg_Prima_Appezza.Length / 2 - 1

                                'Modifica 04-12 per minisci che ha consociati, filtrando per appezza i datti dellla stessa op agenda 
                                'non vengono discriminati, occorre filtrare per id_reg che cambia nel consociato
                                'Dim drAppezza() As DS_AltreOperazioniCulturali.DS_AltreOperazioniCulturaliRow = DsAltreOperazioniCulturali.DS_AltreOperazioniCulturali.Select("id_agenda=" & strId_Agenda(i) & " AND APPEZZA='" & strApp(w) & "'")
                                Dim drAppezza() As DS_AltreOperazioniCulturali.DS_AltreOperazioniCulturaliRow = DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Select("id_agenda=" & strId_Agenda(i) & " AND APPEZZA=" & strID_Reg_Prima_Appezza(w, 0) & "  AND ID_REG=" & strID_Reg_Prima_Appezza(w, 1) & " ")




                                If drAppezza.Length > 0 Then
                                    'strAppezzamenti &= drAppezza(0).app_nome & ", "
                                    strAppezzamenti &= drAppezza(0).App_Nome_Breve & ", "
                                End If
                            Next

                            If strAppezzamenti <> "" Then
                                strAppezzamenti = Left(strAppezzamenti, strAppezzamenti.Length - 2)
                            End If

                            'drLav(0).app_nome = strAppezzamenti
                            drLav(0).App_Nome_Breve = strAppezzamenti

                            For j = 1 To drLav.Length - 1
                                'Se la lavorazione è la stessa (le righe degli appezzamenti diversi sono identiche) 
                                'setto la Cul_Des =-1 x cancellarlo poi..
                                'N.B. La scelta del campo Cul_Des è casuale,è stato scelto xkè nn utilizzato nel sottoreport
                                If drLav(j).Id_Agenda = drLav(j - 1).Id_Agenda And
                                    drLav(j).data_creazione = drLav(j - 1).data_creazione And
                                    drLav(j).Lav_Des = drLav(j - 1).Lav_Des Then

                                    drLav(j).cul_des = "-1"

                                End If

                            Next

                        Next
                        For s = 0 To DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Count - 1
                            If Not IsDBNull(DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(s).Item("cul_des")) Then
                                If DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(s).Item("cul_des") = "-1" Then
                                    DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Rows(s).Delete()
                                End If
                            End If

                        Next

                    End If

                End If 'raggruppamento


            End If

            'rendo permanenti le modifiche sul ds
            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.AcceptChanges()

            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Columns("Piva").ColumnName = "Piva_old"
            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Columns("PivaReale").ColumnName = "Piva"
            DsAltreOperazioniCulturali._DS_AltreOperazioniCulturali.Columns("Piva_old").ColumnName = "PivaReale"

        Catch ex As Exception
            Log_Errori &= "CaricaDsAltreOperazioniColturali: " & vbCrLf & ex.Message & vbCrLf
            Throw New Exception(Log_Errori)
        End Try

        EndWatch(sw, "CaricaDsAltreOperazioniColturali")

    End Sub

