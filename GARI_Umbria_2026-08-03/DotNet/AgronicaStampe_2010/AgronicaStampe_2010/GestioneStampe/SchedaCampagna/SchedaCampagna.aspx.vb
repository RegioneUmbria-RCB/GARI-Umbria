    Public Function CaricaLogoRegioneInCampoBlob(ByRef regione As String,
                                    ByRef objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri) As Byte()

        Dim NomeLogo As String
        Dim LogoRegione As Byte()
        Dim path As String = "~\AB_Immagini\Regioni\LogoRegione" & regione & ".jpg"
        Dim pathAlternativo As String = "..\AB_Immagini\Regioni\LogoRegione" & regione & ".jpg"


        Try


            If System.IO.File.Exists(Me.MapPathSecure(path)) = True Then
                Dim bmpF As System.Drawing.Bitmap = New System.Drawing.Bitmap(Me.MapPathSecure(path))
                Dim c As New System.Drawing.ImageConverter
                LogoRegione = c.ConvertTo(bmpF, GetType(Byte()))
            Else
                'di default inserisco un'imamgine bianca come logo
                Dim bmpImg As System.Drawing.Bitmap = New System.Drawing.Bitmap(1, 1)
                bmpImg.SetPixel(0, 0, Drawing.Color.White)
                Dim cx As New System.Drawing.ImageConverter
                LogoRegione = cx.ConvertTo(bmpImg, GetType(Byte()))
            End If

            If Not IsNothing(LogoRegione) Then
                Return LogoRegione
            End If


        Catch ex As Exception
            Throw New Exception("CaricaLogoRegione. Caricamento logo regione: " & ex.Message)
        End Try

    End Function

