            '(04/12/2019 fede) aggiunta gestione lingua
            stbQuery.Append(" ISNULL(SpecieVegetali.VEG_COD, 0) AS veg_cod, ISNULL(coalesce(SpecieVegetali_XLingue.Veg_Des,SpecieVegetali.Veg_Des) ,'') AS Veg_Des, isnull(SpecieVegetali.Gru_Cod,0) as gru_cod, " & vbCrLf)
            'stbQuery.Append(" ISNULL(SpecieVegetali.VEG_COD, 0) AS veg_cod, isnull(SpecieVegetali.VEG_DES,'') as veg_des, isnull(SpecieVegetali.Gru_Cod,0) as gru_cod, " & vbCrLf)
