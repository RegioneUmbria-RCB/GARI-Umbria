    Private Function Dammi_Perc_Abbattimento_Piu_Restrittiva(ByVal listaPercAbb As List(Of String)) As Decimal

        Dim percAbbMin As Decimal = 100

        For Each pa As String In listaPercAbb

            Dim arrPa = pa.Split("|")
            For Each p In arrPa
                Dim percAbb = p.Split("§")(1)
                If IsNumeric(percAbb) Then
                    If CDec(percAbb) < percAbbMin Then
                        percAbbMin = CDec(percAbb)
                    End If
                End If
            Next
        Next

        If percAbbMin > 0 AndAlso percAbbMin < 100 Then
            Return percAbbMin
        Else
            Return 0
        End If

    End Function

    Private Function Formatta_Data_Movimento(ByVal data As Date, Optional ByVal mostraOrario As Boolean = True) As String

        Dim data_formattata As String = ""

        If (data.Hour <> 0 OrElse data.Minute <> 0) AndAlso mostraOrario Then
            data_formattata = data.ToString("dd/MM/yyyy HH:mm")
        Else
            data_formattata = data.ToString("dd/MM/yyyy")
        End If

        Return data_formattata

    End Function

    'Replica il funzionamento della funzione Reg_Impianti_Read.ricavaProgressivoConsociazioneSePresente evitando di fare sempre
    'delle letture su db
    Private Function ControllaProgressivoConsociazione(ByVal Piva As String,
                                       ByVal Sa_Cod As Integer,
                                       ByVal Appezza As Integer,
                                       ByVal ID_Reg As Integer,
                                        ByRef ID_Consociazione As Integer,
                                        ByRef Tot_Consociati As Integer,
                                        ByRef Sigla_Consociazione As String,
                                       ByRef objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
                                       ) As Boolean
        Dim Dr As DataRow()

        ID_Consociazione = 0
        Tot_Consociati = 0
        Sigla_Consociazione = ""

        If IsNothing(DT_Impianti_Progressivo_Consociazione) Then
            Dim obj As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read

            Dim xOrderBy = "Reg_impianti.Id_Reg asc"

            DT_Impianti_Progressivo_Consociazione = obj.Leggi(Piva, 0, 0, 0, AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta, "", xOrderBy, objParametri)
        End If

        Dr = DT_Impianti_Progressivo_Consociazione.Select("Sa_Cod = " & Sa_Cod & " And Appezza = " & Appezza & " And Id_Reg = " & ID_Reg)

        'se dr vuoto ritorno false
        If IsNothing(Dr) OrElse Dr.Count = 0 Then
            Return False
        End If

        ID_Consociazione = Dr(0).Item("Id_Consociazione")

        'se non ci sono consociati ritorno  false stringa vuota
        If ID_Consociazione = 0 Then
            Return False
        End If

        'ricavo tutti gli impianti consociati, con quell'Id_Consociazione
        Dr = DT_Impianti_Progressivo_Consociazione.Select("Sa_Cod = " & Sa_Cod & " And Appezza = " & Appezza & " And Id_Consociazione = " & ID_Consociazione)

        Dim i As Integer = 0
        If Not IsNothing(Dr) AndAlso Dr.Count > 0 Then
            For i = 0 To Dr.Count - 1
                If Dr(i)("Id_Reg") = ID_Reg Then
                    Tot_Consociati = Dr.Count
                    ID_Consociazione = i + 1
                    Sigla_Consociazione = "" & ID_Consociazione & "-" & Dr.Count
                    Return True
                End If
            Next
        End If

        Return False
    End Function


    ''' <summary>
    ''' Mostro i riferimenti dei Regolamenti aggiornati se sto stampando con Data Fine >= 2024 e se ho selezionato
    ''' come regione 'Emilia - Romagna' mostro anche il regolamento 'QC'
    ''' </summary>
    Private Sub MostraRiferimentiRegolamentiAggiornati(ByVal TipoReport As Integer)

        Select Case TipoReport
            Case enum_TipoReport.SchedaCampagna_Multicentro

                If Session("ReportSelezionato") = enum_CodificaStampe.SchedaCampagna_Multicentro Then

                    If (Not String.IsNullOrEmpty(Qs_DataFine) AndAlso IsDate(Qs_DataFine) AndAlso CDate(Qs_DataFine).Year >= 2024) OrElse
                        (Not String.IsNullOrEmpty(Qs_DataStampa) AndAlso IsDate(Qs_DataStampa) AndAlso CDate(Qs_DataStampa).Year >= 2024) Then

                        rptStampa_Multicentro.Section1.ReportObjects("TextSchedaCampagna").ObjectFormat.EnableSuppress = True

                        'arboree
                        If Gru_Cod = 1 Then
                            If CStr(Session("Regione_Selezionata")) = "008" Then
                                rptStampa_Multicentro.Section1.ReportObjects("TextSchedaCampagna2025ErbaceeER").ObjectFormat.EnableSuppress = False
                            Else
                                rptStampa_Multicentro.Section1.ReportObjects("TextSchedaCampagna2025ErbaceeGenerale").ObjectFormat.EnableSuppress = False
                            End If
                        Else
                            'erbacee e orticole
                            If CStr(Session("Regione_Selezionata")) = "008" Then
                                rptStampa_Multicentro.Section1.ReportObjects("TextSchedaCampagna2025ArboreeER").ObjectFormat.EnableSuppress = False
                            Else
                                rptStampa_Multicentro.Section1.ReportObjects("TextSchedaCampagna2025ArboreeGenerale").ObjectFormat.EnableSuppress = False
                            End If
                        End If
                    End If

                End If

            Case enum_TipoReport.SchedaCampagna_Multi

                Select Case Session("ReportSelezionato")
                    Case enum_CodificaStampe.Registro_Fertilizzazioni, enum_CodificaStampe.Registro_Fertilizzazioni_Massivo

                        If (Not String.IsNullOrEmpty(Qs_DataFine) AndAlso IsDate(Qs_DataFine) AndAlso CDate(Qs_DataFine).Year >= 2024) OrElse
                           (Not String.IsNullOrEmpty(Qs_DataStampa) AndAlso IsDate(Qs_DataStampa) AndAlso CDate(Qs_DataStampa).Year >= 2024) Then

                            rptStampa_Multispecie.Section1.ReportObjects("TextRegistroFertilizzazioni").ObjectFormat.EnableSuppress = True

                            If CStr(Session("Regione_Selezionata")) = "008" Then
                                rptStampa_Multispecie.Section1.ReportObjects("TextRegistroFertilizzazioni2025ER").ObjectFormat.EnableSuppress = False
                            Else
                                rptStampa_Multispecie.Section1.ReportObjects("TextRegistroFertilizzazioni2025Generale").ObjectFormat.EnableSuppress = False
                            End If
                        End If

                    Case enum_CodificaStampe.RegistroTrattamenti_Semplificata, enum_CodificaStampe.Registro_Trattamenti_Massivo

                        If (Not String.IsNullOrEmpty(Qs_DataFine) AndAlso IsDate(Qs_DataFine) AndAlso CDate(Qs_DataFine).Year >= 2024) OrElse
                            (Not String.IsNullOrEmpty(Qs_DataStampa) AndAlso IsDate(Qs_DataStampa) AndAlso CDate(Qs_DataStampa).Year >= 2024) Then

                            rptStampa_Multispecie.Section1.ReportObjects("TextRegistroTrattamenti").ObjectFormat.EnableSuppress = True

                            If CStr(Session("Regione_Selezionata")) = "008" Then
                                rptStampa_Multispecie.Section1.ReportObjects("TextRegistroTrattamenti2025ER").ObjectFormat.EnableSuppress = False
                            Else
                                rptStampa_Multispecie.Section1.ReportObjects("TextRegistroTrattamenti2025Generale").ObjectFormat.EnableSuppress = False
                            End If
                        End If
                End Select
        End Select

    End Sub


End Class


