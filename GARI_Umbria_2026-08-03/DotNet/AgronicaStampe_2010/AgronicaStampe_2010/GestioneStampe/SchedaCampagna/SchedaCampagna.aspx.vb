    Private Sub CaricaDsRilievoPiogge(ByVal Flag_Multicentro As Boolean)

        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String
        Dim stbQ As New System.Text.StringBuilder


        Dim sw As Stopwatch = StartWatch("CaricaDsRilievoPiogge")

        Try

            stbQ.Append(" SELECT Centri_Aziendali.sa_nome, ")
            stbQ.Append("        Agenda.Sa_Cod, ")
            stbQ.Append("        Mov_Dettaglio_Tecnico.Qta_Ril, ")
            'stbQ.Append("        Agenda.Validita_Inizio AS Validita_Inizio_Ordinamento,")
            stbQ.Append("        movimenti.data_movimento AS Validita_Inizio_Ordinamento,")
            'stbQ.Append("        CONVERT(varchar,Agenda.Validita_Inizio,103) AS Validita_Inizio, ")
            stbQ.Append("        CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) As Validita_Inizio, ")
            stbQ.Append("        Movimenti.ora ")

            stbQ.Append(" FROM Agenda INNER JOIN")
            stbQ.Append(" Movimenti ON Agenda.PIVA = Movimenti.PIVA AND Agenda.Sa_Cod = Movimenti.Sa_Cod AND ")
            stbQ.Append(" Agenda.Id_Agenda = Movimenti.Id_Agenda INNER JOIN")
            stbQ.Append(" Mov_Dettaglio_Tecnico ON Movimenti.PIVA = Mov_Dettaglio_Tecnico.Piva AND ")
            stbQ.Append(" Movimenti.Sa_Cod = Mov_Dettaglio_Tecnico.Sa_Cod AND Movimenti.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda AND ")
            stbQ.Append(" Movimenti.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov")
            stbQ.Append(" INNER JOIN Centri_Aziendali ON Agenda.PIVA = Centri_Aziendali.PIVA AND ")
            stbQ.Append(" Agenda.Sa_Cod = Centri_Aziendali.sa_cod")

            stbQ.Append(" WHERE (Agenda.Lav_Cod = 126) ")
            stbQ.Append(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

            If Not Flag_Multicentro Then
                stbQ.Append(" AND Agenda.sa_cod = " & Sa_Cod & " ")
            Else
                'Cmq filtro i centri relativi agli impianti selezionati!!!
                'Non essendoci il filtro sugli impianti mi farebbe vedere sempre le pioggie di tutti i centri!!!
                strFiltroCentri = " AND (" + strFiltroCentri + ")"
                stbQ.Append(strFiltroCentri)
            End If

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ.Append(" AND movimenti.data_movimento = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            Else
                stbQ.Append(" AND movimenti.data_movimento <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
                stbQ.Append(" AND movimenti.data_movimento >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")
            End If

            '26/11/2018: l'ordinamento per specie è indifferente, essendo registrati solo sul centro
            stbQ.Append(" ORDER BY Agenda.sa_cod,Validita_Inizio_Ordinamento ASC, ora ASC")

            Dim Rs As DataTable

            strErr = Nothing
            'Try
            Rs = objSql.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "SchedaCampagna.CaricaDsRilievoPiogge")
            'Catch ex As Exception
            '    strErr = Nothing
            'End Try

            'creo una nuova istanza del dataset
            'DsRilievoPiogge = New DS_RilievoPiogge

            Dim RigaDs As DS_RilievoPiogge.RilievoPioggeRow
            Dim i, j, k, z As Integer
            Dim nRecord As Integer
            Dim nRighe As Integer
            Dim Resto As Integer
            Dim Nr_Colonne_Rilievi As Integer

            'Elimino l'oggetto
            objSql = Nothing

            'Verifico la presenza di errori
            If Not IsNothing(Rs) Then

                'Verifico se il recordset e' aperto
                ' If Rs.State <> 0 Then

                If Rs.Rows.Count > 0 Then

                    'dimensiono la matrice di oggetti
                    Dim Matrice(Rs.Rows.Count - 1, 4) As Object

                    ' messo nell'order by della query
                    'Rs.Sort = "sa_cod, validita_inizio ASC, ora ASC"

                    i = 0

                    'riempio la matrice con i valori del recordset poi lo distruggo
                    For i = 0 To Rs.Rows.Count - 1

                        Matrice(i, 0) = Formatta_Data_Movimento(Rs.Rows(i).Item("Validita_Inizio"))
                        If CInt(Qs_arrotonda) <> -1 Then
                            Matrice(i, 1) = Math.Round(Rs.Rows(i).Item("qta_ril"), CInt(Qs_arrotonda))
                        Else
                            Matrice(i, 1) = Rs.Rows(i).Item("qta_ril")
                        End If


                        Matrice(i, 2) = CDate(Rs.Rows(i).Item("ora")).ToShortTimeString

                        Matrice(i, 3) = Rs.Rows(i).Item("sa_cod")

                        Matrice(i, 4) = Rs.Rows(i).Item("sa_nome")


                    Next


                    'Elimino il recordset
                    Rs = Nothing

                    Dim LastSaCod As Integer = 0
                    Dim Occorrenze As Integer = 0
                    Dim Trovato As Boolean
                    Dim IndiceColonna As Integer

                    i = 0


                    'Report diversi hanno un diverso numero di colonne
                    Select Case Session("ReportSelezionato")

                        Case enum_CodificaStampe.SchedaCampagna_Pizzoli,
                              enum_CodificaStampe.Eurep_Gap_Semplificata,
                              enum_CodificaStampe.Eurep_Gap_Multicentro,
                              enum_CodificaStampe.SchedaCampagna_ProvAut_Trento

                            Nr_Colonne_Rilievi = 4

                        Case Else

                            Nr_Colonne_Rilievi = 3

                    End Select


                    Resto = UBound(Matrice, 1) Mod Nr_Colonne_Rilievi

                    'conto il numero di righe del record
                    If Resto = 0 Then
                        nRighe = UBound(Matrice, 1) \ Nr_Colonne_Rilievi
                    Else
                        nRighe = UBound(Matrice, 1) \ Nr_Colonne_Rilievi + 1
                    End If

                    Do While i <= UBound(Matrice, 1)

                        IndiceColonna = i Mod Nr_Colonne_Rilievi

                        If IndiceColonna = 0 Then
                            RigaDs = DsRilievoPiogge.RilievoPiogge.NewRilievoPioggeRow

                            RigaDs.Sa_Cod = CInt(Matrice(i, 3))
                            RigaDs.Sa_Nome = CStr(Matrice(i, 4))
                        End If


                        Select Case IndiceColonna

                            Case 0
                                RigaDs.Data_Rilievo1 = CDate(Matrice(i, 0))
                                RigaDs.Qta1 = CDbl(Matrice(i, 1))
                                RigaDs.Ora_Rilievo1 = CStr(Matrice(i, 2))
                                If Not HTCentri Is Nothing Then
                                    RigaDs.RifCentro1 = HTCentri.Item(String.Format("{0}{1}", Piva, CInt(Matrice(i, 3))))
                                Else
                                    RigaDs.RifCentro1 = "*"
                                End If

                            Case 1
                                RigaDs.Data_Rilievo2 = CDate(Matrice(i, 0))
                                RigaDs.Qta2 = CDbl(Matrice(i, 1))
                                RigaDs.Ora_Rilievo2 = CStr(Matrice(i, 2))
                                If Not HTCentri Is Nothing Then
                                    RigaDs.RifCentro2 = HTCentri.Item(String.Format("{0}{1}", Piva, CInt(Matrice(i, 3))))
                                Else
                                    RigaDs.RifCentro2 = "*"
                                End If
                            Case 2
                                RigaDs.Data_Rilievo3 = CDate(Matrice(i, 0))
                                RigaDs.Qta3 = CDbl(Matrice(i, 1))
                                RigaDs.Ora_Rilievo3 = CStr(Matrice(i, 2))
                                If Not HTCentri Is Nothing Then
                                    RigaDs.RifCentro3 = HTCentri.Item(String.Format("{0}{1}", Piva, CInt(Matrice(i, 3))))
                                Else
                                    RigaDs.RifCentro3 = "*"
                                End If

                                'Verificare se qui entra o no !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
                            Case 3
                                RigaDs.Data_Rilievo4 = CDate(Matrice(i, 0))
                                RigaDs.Qta4 = CDbl(Matrice(i, 1))
                                RigaDs.Ora_Rilievo4 = CStr(Matrice(i, 2))
                                If Not HTCentri Is Nothing Then
                                    RigaDs.RifCentro4 = HTCentri.Item(String.Format("{0}{1}", Piva, CInt(Matrice(i, 3))))
                                Else
                                    RigaDs.RifCentro4 = "*"
                                End If


                        End Select

                        If IndiceColonna = Nr_Colonne_Rilievi - 1 Or i = UBound(Matrice, 1) Then
                            DsRilievoPiogge.RilievoPiogge.Rows.Add(RigaDs)
                        End If


                        i += 1

                    Loop


                End If

                'End If

            End If

        Catch ex As Exception
            Log_Errori &= "CaricaDsRilievoPiogge: " & vbCrLf & ex.Message & vbCrLf
            Throw New Exception(Log_Errori)
        End Try

        EndWatch(sw, "CaricaDsRilievoPiogge")

    End Sub


