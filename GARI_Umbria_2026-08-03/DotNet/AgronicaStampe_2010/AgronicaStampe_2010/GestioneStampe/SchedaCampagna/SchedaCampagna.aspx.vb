                        'Else
                        '    DsFasiFenologiche.FasiFenologiche.Rows(i).Item("ff_des") = ""
                        'End If
                        ''DsFasiFenologiche.FasiFenologiche.Rows(i).Item("ff_des") = IIf(Not IsNothing(elencoDesc) AndAlso elencoDesc.Length > 0, elencoDesc(0).ToString, "")
#End Region
                    End If
                Else
                    Throw New Exception("Codice della Fase Fenologica non inserito")
                End If

                Try

                    Dim objImp As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
                    Dim ID_Consociazione As Integer
                    Dim Tot_Consociati As Integer
                    Dim Sigla_Consociazione As String
                    If ControllaProgressivoConsociazione(DsFasiFenologiche.FasiFenologiche.Rows(i).Item("piva"),
                                                                                                        DsFasiFenologiche.FasiFenologiche.Rows(i).Item("sa_cod"),
                                                                                                        DsFasiFenologiche.FasiFenologiche.Rows(i).Item("APPEZZA"), DsFasiFenologiche.FasiFenologiche.Rows(i).Item("ID_Destinazione"), ID_Consociazione, Tot_Consociati, Sigla_Consociazione, objParametri_Server) Then
                        DsFasiFenologiche.FasiFenologiche.Rows(i).Item("App_Nome_Breve") &= "/" & Sigla_Consociazione & ""
                        'DsFasiFenologiche.FasiFenologiche.Rows(i).Item("App_Nome_Breve") &= "/" & ID_Consociazione & ""

                    End If
                Catch ex As Exception

                End Try

                '----------------------------------------------

                For appIndex = 0 To DefaultCopy.Length - 1
                    If Not DefaultCopy(appIndex) Is Nothing AndAlso CInt(DsFasiFenologiche.FasiFenologiche.Rows(i).Item("appezza")) = DefaultCopy(appIndex).Appezza Then
                        DefaultCopy(appIndex) = Nothing
                    End If
                Next

            Next

            Dim InserisciFiorituraPrevista As Boolean

            'Per gli appezzamenti per cui non sono state registrate osservazioni di fioritura, aggiungo una riga con
            'la data di fioritura prevista
            If Not defaults Is Nothing AndAlso
                  defaults.Length > 0 AndAlso
                        DsFasiFenologiche.FasiFenologiche.Rows.Count < defaults.Length Then

                For i = 0 To defaults.Length - 1

                    InserisciFiorituraPrevista = False

                    If Not DefaultCopy(i) Is Nothing AndAlso defaults(i).Data_Fioritura <> AGRODATAINIZIO Then

                        'se ho scelto una data unica per la stampa..
                        If Qs_DataStampa <> "" Then
                            If CDate(defaults(i).Data_Fioritura) >= CDate(Qs_DataStampa) And
                              CDate(defaults(i).Data_Fioritura) <= CDate(Qs_DataStampa) Then
                                InserisciFiorituraPrevista = True
                            End If
                        Else
                            If CDate(defaults(i).Data_Fioritura) >= CDate(Qs_DataInizio) And
                               CDate(defaults(i).Data_Fioritura) <= CDate(Qs_DataFine) Then
                                InserisciFiorituraPrevista = True
                            End If
                        End If

                        If InserisciFiorituraPrevista = True Then

                            Dim newRow = DsFasiFenologiche.FasiFenologiche.NewFasiFenologicheRow()

                            newRow.data_ril = defaults(i).Data_Fioritura

                            Dim app As New AgronicaCoreAnagrafeDAL.Appezzamento_Read
                            Dim obj As New AgronicaCoreAnagrafeDAL.Appezzamento_Codici_R
                            Dim newRow_Appezza_Nome As String = app.AppezzamentoNome_from_Appezza(defaults(i).Piva, defaults(i).Sa_Cod, defaults(i).Appezza, objParametri_Server)
                            newRow.App_Nome_Breve = obj.RiferimentoAlfanumerico_from_Appezza(defaults(i).Piva, defaults(i).Sa_Cod, defaults(i).Appezza, "", objParametri_Server)

                            newRow.App_Nome_Breve = CodiceAppezzamento(defaults(i).Piva, defaults(i).Sa_Cod, defaults(i).Campo_Nome, defaults(i).Appezza,
                                                                     TipoCodAppezzamento,
                                                                     newRow_Appezza_Nome, newRow.App_Nome_Breve, -1)



                            newRow.cul_des = defaults(i).Cul_Des

                            newRow.ff_des = "fioritura: fase piena (> 50%)"

                            DsFasiFenologiche.FasiFenologiche.Rows.Add(newRow)

                        End If

                    End If

                Next

            End If


            '--------------------------------------------------------------------------------------
            'ORDINO IL DATASET
            '(per farlo elimino le vecchie righe e poi importo nell'ordine le datarow ordinate)
            '--------------------------------------------------------------------------------------

            Dim dr, dr2 As Ds_FasiFenologiche.FasiFenologicheRow
            Dim Rows() As Ds_FasiFenologiche.FasiFenologicheRow
            Dim Rows2() As Ds_FasiFenologiche.FasiFenologicheRow
            Dim s As Integer = 0

            ReDim Rows2(DsFasiFenologiche.FasiFenologiche.Count - 1)

            Rows = DsFasiFenologiche.FasiFenologiche.Select("", "Data_ril")

            For Each dr In Rows

                dr2 = DsFasiFenologiche.FasiFenologiche.NewFasiFenologicheRow()

                If Not IsDBNull(dr.Item("App_Nome")) Then
                    dr2.app_nome = dr.app_nome
                End If

                If Not IsDBNull(dr.Item("App_Nome_Breve")) Then
                    dr2.App_Nome_Breve = dr.App_Nome_Breve
                End If

                If Not IsDBNull(dr.Item("appezza")) Then
                    dr2.appezza = dr.appezza
                End If

                If Not IsDBNull(dr.Item("veg_des")) Then
                    dr2.veg_des = dr.veg_des
                End If

                If Not IsDBNull(dr.Item("cul_des")) Then
                    dr2.cul_des = dr.cul_des
                End If

                If Not IsDBNull(dr.Item("data_ril")) Then
                    dr2.data_ril = Formatta_Data_Movimento(dr.data_ril)
                End If

                If Not IsDBNull(dr.Item("ff_des")) Then
                    dr2.ff_des = dr.ff_des
                End If

                If Not IsDBNull(dr.Item("id_agenda")) Then
                    dr2.id_agenda = dr.id_agenda
                End If

                If Not IsDBNull(dr.Item("id_destinazione")) Then
                    dr2.id_destinazione = dr.id_destinazione
                End If

                If Not IsDBNull(dr.Item("piva")) Then
                    dr2.piva = dr.piva
                End If

                If Not IsDBNull(dr.Item("pivaReale")) Then
                    dr2.pivaReale = dr.pivaReale
                End If

                If Not IsDBNull(dr.Item("sa_cod")) Then
                    dr2.sa_cod = dr.sa_cod
                End If

                If Not IsDBNull(dr.Item("Sa_Nome")) Then
                    dr2.Sa_Nome = dr.Sa_Nome
                End If

                'Visualizza la Specie e la Varietà insieme
                If Not IsDBNull(dr.Item("veg_des")) AndAlso
                   Not IsDBNull(dr.Item("cul_des")) Then

                    dr2.veg_des_e_cul_des = dr.Item("veg_des") & " " & dr.Item("cul_des")
                End If

                Rows2(s) = dr2
                s += 1

            Next

            Dim Righe_Old As Integer = DsFasiFenologiche.FasiFenologiche.Rows.Count

            'DsFasiFenologiche.FasiFenologiche.Clear
            For Each dr In Rows2
                DsFasiFenologiche.FasiFenologiche.Rows.Add(dr)
            Next

            'rendo permanenti le modifiche sul ds
            DsFasiFenologiche.FasiFenologiche.AcceptChanges()

            For i = 0 To Righe_Old - 1
                DsFasiFenologiche.FasiFenologiche.Rows(i).Delete()
            Next

            'rendo permanenti le modifiche sul ds
            DsFasiFenologiche.FasiFenologiche.AcceptChanges()

            DsFasiFenologiche.FasiFenologiche.Columns("Piva").ColumnName = "Piva_old"
            DsFasiFenologiche.FasiFenologiche.Columns("PivaReale").ColumnName = "Piva"
            DsFasiFenologiche.FasiFenologiche.Columns("Piva_old").ColumnName = "PivaReale"

        End If

        EndWatch(sw, "CaricaDsFasiFenologiche")

    End Sub


    '###########################################################################
    Private Sub CaricaDsIrrigazione(ByVal flag_Multispecie As Boolean, ByVal Flag_Multicentro As Boolean, ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna)

        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String
        Dim stbQ As New System.Text.StringBuilder

        Dim i, j, s, w, c, n As Integer

        Dim Padre As Boolean = False
        Dim NumFigli As Integer

        Dim App_Nome As String
        Dim Num_Appezzamento As Double
        'Dim strAppezzamenti As String


        Dim sw As Stopwatch = StartWatch("CaricaDsIrrigazione")

        Try

            stbQ.AppendLine("Select DISTINCT ")
            'stbQ.Append(" Agenda.id_agenda, CONVERT(varchar, Agenda.Validita_Inizio,103) as data_creazione, Agenda.Validita_Inizio, Impiantiirrigazioni.imp_des, Mov_Dettaglio_Tecnico.inn1_data, " & vbCrLf)
            stbQ.AppendLine(" Agenda.id_agenda, ")
            stbQ.AppendLine(" CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) AS data_creazione, Movimenti.Data_Movimento,")
            stbQ.AppendLine(" ISNULL(Parco_Macchine.Mac_Des, Impiantiirrigazioni.imp_des) as imp_des,")
            stbQ.AppendLine(" Mov_Dettaglio_Tecnico.inn1_data,")
            stbQ.AppendLine(" Mov_Dettaglio_Tecnico.inn2_data, Mov_Dettaglio_Tecnico.nitrati, Mov_Dettaglio_Tecnico.dose, Movimenti.Mov_desc, ")
            stbQ.AppendLine(" Mov_Dettaglio_Tecnico.Parziale, ")
            stbQ.AppendLine(" Mov_Destinazioni.qta as QtaTot, ")
            stbQ.AppendLine(" Mov_Destinazioni.Qta2 as SuperficieTrattata,")
            stbQ.AppendLine(" Reg_Impianti.sup_imp AS SUP_APP, ")

            stbQ.AppendLine(" Centri_Aziendali.Sa_Nome, Appezzamento.Piva, ")
            stbQ.AppendLine(" CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Appezzamento.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale, ")
            stbQ.AppendLine(" Appezzamento.Sa_Cod, Appezzamento.APP_NOME, Reg_Impianti.appezza, Reg_Impianti.id_reg, ")
            'stbQ.Append(" unitamisura.udm_sim, Mov_Destinazioni.qta, " & vbCrLf)
            stbQ.AppendLine(" unitamisura.udm_sim, Mov_Destinazioni.qta as totale, ")
            'stbQ.Append(" totale = Mov_Dettaglio_Tecnico.qta_ril " & vbCrLf)
            stbQ.AppendLine(" Qta = Mov_Dettaglio_Tecnico.qta_ril, ")

            stbQ.AppendLine(" Cultivar.cul_des, ")
            '26/11/2018 introdotta lettura destinazione d'uso in query invece che lettura separata dopo (serve la dest uso per l'eventuale ordinamento per coltura)
            ' stbQ.Append("  SpecieVegetali.Veg_Des, " & vbCrLf) '  Galassi, 04/11/2016 18:00:50:  Aggiunta specie veg_des per multispecie
            stbQ.AppendLine(" CASE WHEN reg_impianti.cul_cod = 0 THEN ")
            stbQ.AppendLine("           ( ISNULL( (SELECT TOP 1 descrizione ")
            stbQ.AppendLine("                       FROM Reg_Impianti_Codici RIC ")
            stbQ.AppendLine("                       INNER JOIN Codici_Anagrafe Cod ON  RIC.id_cod= Cod.codice ")
            stbQ.AppendLine("                       WHERE progetto_cod=0 ")
            stbQ.AppendLine("                       AND id_cod >= 3000 and id_cod < 4000 ")
            stbQ.AppendLine("                       AND piva=Reg_Impianti.piva and sa_cod=Reg_Impianti.sa_cod ")
            stbQ.AppendLine("                       AND appezza= Reg_Impianti.appezza and id_reg=Reg_Impianti.id_reg ")
            stbQ.AppendLine("                       ), 'Terreno nudo')  )")
            stbQ.AppendLine(" ELSE  ( ")
            stbQ.AppendLine("       veg_des  ")
            stbQ.AppendLine("       )  ")
            stbQ.AppendLine(" END AS veg_des, ")

            stbQ.AppendLine(" ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici  ")
            stbQ.AppendLine(" WHERE (Appezzamento_Codici.PIVA = Appezzamento.PIVA) ")
            stbQ.AppendLine(" and (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) ")
            stbQ.AppendLine(" and (Appezzamento_Codici.appezza = Appezzamento.appezza) ")
            stbQ.AppendLine(" and (Appezzamento_Codici.id_cod = 1104) ), '') AS App_Nome_Breve, ")

            'campo_des
            stbQ.Append(" ISNULL(( SELECT top 1 Campi.Campo_Des " & vbCrLf)
            stbQ.Append(" FROM Campi " & vbCrLf)
            stbQ.Append(" WHERE Campi.Piva = Appezzamento.PIVA AND Campi.Sa_Cod = Appezzamento.SA_COD AND " & vbCrLf)
            stbQ.Append(" Campi.Campo_Cod = Appezzamento.Campo_Cod " & vbCrLf)
            stbQ.Append(" ),'') AS Campo_Nome, " & vbCrLf)

            stbQ.Append(" ISNULL((SELECT TOP 1 Imprese_Progetti.Progetto_Nome FROM Imprese_Progetti " & vbCrLf)
            stbQ.Append("       WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
            stbQ.Append(" 	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG  " & vbCrLf)

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            Else
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
                stbQ.Append(" 	     AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
            End If

            stbQ.Append(" 	     ORDER BY Imprese_Progetti.Validita_Inizio DESC ), '') AS Lotto, " & vbCrLf)

            'Note ricorrenti / Giustificazioni
            stbQ.AppendLine(" ISNULL(Note_Intervento.Nota_Des,'') AS Nota_Des ")
            stbQ.AppendLine(" , '' AS Ordinamento_Coltura, '01/01/1900' AS Ordinamento_Data, '' AS Ordinamento_Prodotto,'' AS Ordinamento_Centro, '' AS Ordinamento_AppezzaNomeBreve, ")

            'Modaliltà applicazione e Nr domanda ACA
            stbQ.AppendLine("CodiciACA.Nr_domanda_ACA")

            stbQ.AppendLine(" FROM ImpiantiIrrigazioni impiantiirrigazioni")
            stbQ.AppendLine(" INNER JOIN Mov_Dettaglio_Tecnico")
            stbQ.AppendLine(" ON impiantiirrigazioni.Imp_Cod = Mov_Dettaglio_Tecnico.Freatimetro")
            stbQ.AppendLine(" INNER JOIN UnitaMisura unitamisura")
            stbQ.AppendLine(" ON unitamisura.UDM_COD = Mov_Dettaglio_Tecnico.Dett_Cod")
            stbQ.AppendLine(" INNER JOIN Movimenti")
            stbQ.AppendLine(" INNER JOIN Agenda")
            stbQ.AppendLine(" ON Movimenti.PIVA = Agenda.PIVA")
            stbQ.AppendLine(" AND Movimenti.Sa_Cod = Agenda.Sa_Cod")
            stbQ.AppendLine(" AND Movimenti.Id_Agenda = Agenda.Id_Agenda")
            stbQ.AppendLine(" INNER JOIN Movimenti_dettagli")
            stbQ.AppendLine(" ON Movimenti.PIVA = Movimenti_dettagli.PIVA")
            stbQ.AppendLine(" AND Movimenti.Sa_Cod = Movimenti_dettagli.Sa_Cod")
            stbQ.AppendLine(" AND Movimenti.Id_Agenda = Movimenti_dettagli.Id_Agenda")
            stbQ.AppendLine(" AND Movimenti.Id_Mov = Movimenti_dettagli.Id_Mov")
            stbQ.AppendLine(" INNER JOIN Reg_Impianti")
            stbQ.AppendLine(" INNER JOIN Appezzamento")
            stbQ.AppendLine(" INNER JOIN Mov_Destinazioni")
            stbQ.AppendLine(" ON Appezzamento.PIVA = Mov_Destinazioni.Piva")
            stbQ.AppendLine(" AND Appezzamento.SA_COD = Mov_Destinazioni.Sa_Cod")
            stbQ.AppendLine(" AND Appezzamento.APPEZZA = Mov_Destinazioni.Appezza")
            stbQ.AppendLine(" ON Reg_Impianti.PIVA = Mov_Destinazioni.Piva")
            stbQ.AppendLine(" AND Reg_Impianti.SA_COD = Mov_Destinazioni.Sa_Cod")
            stbQ.AppendLine(" AND Reg_Impianti.ID_REG = Mov_Destinazioni.Id_Destinazione")
            stbQ.AppendLine(" AND Reg_Impianti.APPEZZA = Mov_Destinazioni.Appezza")
            stbQ.AppendLine(" ON Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod")
            stbQ.AppendLine(" AND Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva")
            stbQ.AppendLine(" AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda")
            stbQ.AppendLine(" AND Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov")
            stbQ.AppendLine(" AND Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det")
            stbQ.AppendLine(" ON Movimenti_dettagli.PIVA = Mov_Dettaglio_Tecnico.Piva")
            stbQ.AppendLine(" AND Movimenti_dettagli.Sa_Cod = Mov_Dettaglio_Tecnico.Sa_Cod")
            stbQ.AppendLine(" AND Movimenti_dettagli.Id_Agenda = Mov_Dettaglio_Tecnico.Id_Agenda")
            stbQ.AppendLine(" AND Movimenti_dettagli.Id_Mov = Mov_Dettaglio_Tecnico.Id_Mov")
            stbQ.AppendLine(" AND Movimenti_dettagli.Id_Mov_Det = Mov_Dettaglio_Tecnico.Id_Mov_Det")
            stbQ.AppendLine(" INNER JOIN Imprese")
            stbQ.AppendLine(" ON Reg_Impianti.PIVA = Imprese.Piva")
            stbQ.AppendLine(" LEFT OUTER JOIN SpecieVegetali")
            stbQ.AppendLine(" INNER JOIN Cultivar")
            stbQ.AppendLine(" ON SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod ")
            stbQ.AppendLine(" ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod")
            stbQ.AppendLine(" INNER JOIN Centri_Aziendali")
            stbQ.AppendLine(" ON Reg_Impianti.Piva = Centri_Aziendali.Piva")
            stbQ.AppendLine(" AND Reg_Impianti.Sa_Cod = Centri_Aziendali.Sa_Cod ")

            ' X Note ricorrenti / Giustificazioni
            stbQ.AppendLine(" LEFT OUTER JOIN AgendaxNote ON Agenda.Id_Agenda = AgendaxNote.Id_Agenda ")
            stbQ.AppendLine(" LEFT OUTER JOIN Note_Intervento ON AgendaxNote.Nota_Cod = Note_Intervento.Nota_Cod ")

            stbQ.AppendLine("LEFT OUTER JOIN Imprese_Progetti")
            stbQ.AppendLine("ON Imprese_Progetti.Piva = Reg_Impianti.PIVA")
            stbQ.AppendLine("AND Imprese_Progetti.Sa_Cod = Reg_Impianti.SA_COD")
            stbQ.AppendLine("AND Imprese_Progetti.Appezza = Reg_Impianti.APPEZZA")
            stbQ.AppendLine("AND Imprese_Progetti.Id_Reg = Reg_Impianti.ID_REG")

            stbQ.AppendLine(" LEFT JOIN Reg_ImpiantiXParcoMacchine")
            stbQ.AppendLine(" ON Reg_ImpiantiXParcoMacchine.Piva = Reg_Impianti.PIVA")
            stbQ.AppendLine(" AND Reg_ImpiantiXParcoMacchine.Sa_Cod = Reg_Impianti.SA_COD")
            stbQ.AppendLine(" AND Reg_ImpiantiXParcoMacchine.Appezza = Reg_Impianti.APPEZZA")
            stbQ.AppendLine(" AND Reg_ImpiantiXParcoMacchine.Id_Reg = Reg_Impianti.ID_REG")
            stbQ.AppendLine(" AND Reg_ImpiantiXParcoMacchine.Mac_Cod = Mov_Dettaglio_Tecnico.Ditta_Cod")

            stbQ.AppendLine(" LEFT JOIN Parco_Macchine")
            stbQ.AppendLine(" ON Parco_Macchine.Mac_Cod = Reg_ImpiantiXParcoMacchine.Mac_Cod")

            'Nr domanda ACA
            stbQ.AppendLine(" LEFT JOIN (")
            If sql2017 Then
                stbQ.AppendLine(" SELECT ipc.Piva, ipc.ProgettoCod, ipc.ContributoTipo,")
                stbQ.AppendLine("        STRING_AGG(aca.ContributoDes, ', ') Nr_domanda_ACA")
                stbQ.AppendLine(" FROM Imprese_ProgettiXContributi ipc")
                stbQ.AppendLine(" JOIN  Contributi aca")
                stbQ.AppendLine($" ON ipc.ContributoTipo = {CInt(ContributeType.ACA)}")
                stbQ.AppendLine(" AND ipc.ContributoTipo = aca.Tipo")
                stbQ.AppendLine(" AND ipc.ContributoCod = aca.ContributoCod")
                stbQ.AppendLine(" GROUP BY ipc.Piva, ipc.ProgettoCod, ipc.ContributoTipo")
            Else
                stbQ.AppendLine(" SELECT ipc_outer.Piva, ipc_outer.ProgettoCod, ipc_outer.ContributoTipo, ")
                stbQ.AppendLine("        STUFF((SELECT ', ' + aca.ContributoDes FROM Imprese_ProgettiXContributi ipc")
                stbQ.AppendLine("        INNER JOIN Contributi aca ON ipc.ContributoCod = aca.ContributoCod AND ipc.ContributoTipo = aca.Tipo ")
                stbQ.AppendLine("        WHERE ipc.Piva = ipc_outer.Piva AND ipc.ProgettoCod = ipc_outer.ProgettoCod AND ipc.ContributoTipo = ipc_outer.ContributoTipo ")
                stbQ.AppendLine("        FOR XML PATH('')), 1, 2, '') AS Nr_domanda_ACA")
                stbQ.AppendLine(" FROM ")
                stbQ.AppendLine($" (SELECT DISTINCT Piva, ProgettoCod, ContributoTipo FROM Imprese_ProgettiXContributi WHERE ContributoTipo = {CInt(ContributeType.ACA)}) ipc_outer")
            End If
            stbQ.AppendLine(" ) CodiciACA")
            stbQ.AppendLine(" ON Imprese_Progetti.Piva = CodiciACA.Piva")
            stbQ.AppendLine(" AND Imprese_Progetti.Progetto_Cod = CodiciACA.ProgettoCod")

            'stbQ.AppendLine("LEFT OUTER JOIN Reg_Impianti_Codici")
            'stbQ.AppendLine("ON Reg_Impianti_Codici.PIVA = Imprese_Progetti.Piva")
            'stbQ.AppendLine("AND Reg_Impianti_Codici.sa_cod = Imprese_Progetti.sa_cod")
            'stbQ.AppendLine("AND Reg_Impianti_Codici.appezza = Imprese_Progetti.APPEZZA ")
            'stbQ.AppendLine("AND Reg_Impianti_Codici.id_reg = Imprese_Progetti.ID_REG")
            'stbQ.AppendLine("AND Reg_Impianti_Codici.Progetto_Cod = Imprese_Progetti.Progetto_Cod")
            'stbQ.AppendLine($"AND Reg_Impianti_Codici.id_cod = {CInt(enum_CodiciAnagrafe.Impianto_Nr_domanda_ACA)}")
            'stbQ.AppendLine("AND Imprese_Progetti.validita_inizio <= Agenda.Validita_Inizio")
            'stbQ.AppendLine("AND Imprese_Progetti.validita_fine >= Agenda.Validita_Inizio")

            If IDTestataTemp <> 0 Then

                stbQ.AppendLine(" INNER JOIN __tmp_FiltroImpianti f ")
                stbQ.AppendLine(" ON  Reg_Impianti.PIVA = f.piva  ")
                stbQ.AppendLine(" AND Reg_Impianti.SA_COD = f.sa_cod ")
                stbQ.AppendLine(" AND Reg_Impianti.APPEZZA = f.appezza ")
                stbQ.AppendLine(" AND Reg_Impianti.ID_REG = f.id_reg ")
                stbQ.AppendLine(" AND f.idTestataTemp = " & IDTestataTemp)
                stbQ.AppendLine(" AND f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
                stbQ.AppendLine(" AND f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

            End If

            stbQ.AppendLine("WHERE Agenda.Lav_Cod IN (1) ")

            If Not flag_Multispecie Then
                If Veg_Cod = "0" Then
                    stbQ.AppendLine(" AND Reg_Impianti.cul_cod = 0 ")
                Else
                    If TerrenoNudoIncluso = False Then
                        stbQ.AppendLine(" AND SpecieVegetali.VEG_COD = " & Veg_Cod)
                    Else
                        stbQ.AppendLine(" AND (SpecieVegetali.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) ")
                    End If
                End If

            End If

            stbQ.AppendLine(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")

            If Not Flag_Multicentro Then
                stbQ.AppendLine(" AND Agenda.sa_cod = " & Sa_Cod & " ")
            End If

            'If strAppezza <> "" And strId_Reg <> "" Then
            '    stbQ.Append(" AND Reg_Impianti.APPEZZA IN (" & strAppezza & ") ")
            '    stbQ.Append(" AND Reg_Impianti.ID_REG IN (" & strId_Reg & ") ")
            'End If

            'stbQ.Append(strFiltroImpianti)


            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ.AppendLine(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
                stbQ.AppendLine(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
                stbQ.AppendLine(" AND Movimenti.Data_Movimento = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            Else
