            Dim DTImpFascicolo As New DataTable
            Dim DrImpFascicolo() As DataRow
            If Not Session("Fascicolo") Is Nothing AndAlso IsNumeric(Session("Fascicolo")) Then
                FiltraImpianti = True
                Dim Allegati_Documenti_Cod As Integer = Session("Fascicolo")
                Session("Fascicolo") = Nothing
                Dim objImpFascicolo As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
