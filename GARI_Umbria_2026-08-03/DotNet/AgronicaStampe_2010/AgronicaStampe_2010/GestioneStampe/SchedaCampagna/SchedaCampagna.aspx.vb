        Dim strErr As String
        Dim stbQ As New System.Text.StringBuilder
        Dim DsGestioneRifiuti_TEMP As New DS_GestioneRifiuti

        '  Galassi, 20/10/2016 17:18:08: revisionata perchè il 20 Hanno deciso di usare un campo stringa invece del contatto 


