        stbQ.Append(" isnull(Taratura_Ugello, 0.0 ) as Taratura_Ugello, ISNULL(Validita_Taratura_Inizio,'01/01/1900') AS  Validita_Taratura_Inizio, ISNULL(Validita_Taratura_Fine, '31/12/2100') AS Validita_Taratura_Fine    " & vbCrLf)

