    'carico il dataset x le visite
    Private Sub CaricaDsVisite(ByVal Flag_Multicentro As Boolean, ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna, ByVal Flag_Multispecie As Boolean, ByVal Veg_Cod As String, ByVal Id_Cod As String)

        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr, strErr1 As String
        Dim stbQ As New System.Text.StringBuilder
        Dim stbQ2 As New System.Text.StringBuilder
        Dim stbQ3 As New System.Text.StringBuilder
        Dim stbQDettagli As New System.Text.StringBuilder


        Dim DR As DS_Note.DS_NoteRow

        Dim i, j As Integer

        Dim Dt_Dettagli, DT_vis As New DataTable
        Dim Dr_Dettagli() As DataRow
        Dim strDettagli As String
        Dim strSpecie As String
        Dim lstVarieta As New List(Of String)

        Dim Num_Appezzamento As Double


        Dim sw As Stopwatch = StartWatch("CaricaDsVisite")

        Try

            DSVisite = New DS_Note

            Dim NomeDBUtenti As String = objParametri_Utenti.Recupera_NomeDB

            '------------------------------------------
            'PEZZO DA USARE NELLE PARTI DELLA UNION CHE LEGGONO LE VISITE NUOVE - VERSIONE V2 DotNet
            stbQ2 = costruisciQueryVisiteNuova(NomeDBUtenti, Piva, Flag_Multicentro, Sa_Cod, Qs_DataStampa, Qs_DataInizio, Qs_DataFine)
            '------------------------------------------------

            '------------------------------------------
            'PEZZO DA USARE NELLE PARTI DELLA UNION CHE LEGGONO LE VISITE NUOVE FILTRATE PER SPECIE - VERSIONE V3 Angular
            stbQ3 = costruisciQueryVisiteNuovaConSpecie(Piva, Qs_DataInizio, Qs_DataFine, Veg_Cod, Id_Cod)
            '------------------------------------------------

            stbQ.Length = 0
            stbQ.AppendLine(" /* vecchie visite (sono su azienda o su centro aziendale) */ ")
            stbQ.AppendLine(" Select DISTINCT Agenda.Piva , '' as Rag_Soc, Agenda.Sa_Cod, '' as Sa_Nome, Agenda.Id_Agenda,  Agenda.Lav_Cod , Agenda.Des_Lib As Lav_Des,  ")
            stbQ.AppendLine(" CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) As Data_Movimento, convert(time,Movimenti.Ora, 8) As ora,   Movimenti.Mov_Desc As Note, '' AS Note2,   ")
            stbQ.AppendLine(" Movimenti.Cod_RisUm,  CASE Contatti.Id_CF WHEN 0 THEN ISNULL(Contatti.Cognome,'') + ' ' + ISNULL(Contatti.Nome,'') ELSE ISNULL(Contatti.Rag_Soc,'') END AS Tecnico, ")
            stbQ.AppendLine(" agenda.username_creazione, '' AS utente, ")
            stbQ.AppendLine(" '' AS Operazione ")
            stbQ.AppendLine(" FROM  Agenda  ")
            stbQ.AppendLine(" INNER JOIN Movimenti ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND Movimenti.Id_Agenda = Agenda.Id_Agenda ")
            stbQ.AppendLine(" LEFT OUTER JOIN   Risorse_Umane   ON Risorse_Umane.Cod_RisUm = Movimenti.Cod_RisUm  ")
            stbQ.AppendLine(" LEFT OUTER JOIN Contatti ON  Contatti.piva = Risorse_Umane.piva AND Contatti.Cod_Contatto = Risorse_Umane.Cod_Contatto ")

            stbQ.AppendLine(" WHERE Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' ")
            stbQ.AppendLine(" AND Agenda.Lav_Cod IN (" & LAVCOD_VISITA_GENERICA.ToString & "," & LAVCOD_MONITORAGGIO_TEMPI_RIENTRO.ToString & ") ")
            If Not Flag_Multicentro Then
                stbQ.AppendLine(" AND (Agenda.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " OR Agenda.Sa_Cod = -1) ")
            End If
            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ.AppendLine(" AND Movimenti.Data_Movimento = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            Else
                stbQ.AppendLine(" AND Movimenti.Data_Movimento <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
                stbQ.AppendLine(" AND Movimenti.Data_Movimento >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")
            End If

            stbQ.AppendLine(" ")
            stbQ.AppendLine(" UNION ALL ")
            stbQ.AppendLine(" ")

            stbQ.AppendLine(" /* nuova visita (se legata a piva o a centro aziendale)*/ ")
            stbQ.AppendLine(stbQ2.ToString)
            stbQ.AppendLine(" AND NOT EXISTS ( ")
            stbQ.AppendLine("               SELECT 1 ")
            stbQ.AppendLine("               FROM Mov_Destinazioni ")
            stbQ.AppendLine("               WHERE Mov_Destinazioni.piva= agenda.piva ")
            stbQ.AppendLine("               AND Mov_Destinazioni.id_agenda= agenda.id_agenda ")
            stbQ.AppendLine("               ) ")
            stbQ.AppendLine(" ")

            stbQ.AppendLine(" ")
            stbQ.AppendLine(" UNION ALL ")
            stbQ.AppendLine(" ")

            stbQ.AppendLine(" /* nuova visita (legata all'impianto) */ ")
            stbQ.AppendLine(stbQ2.ToString)
            stbQ.AppendLine(" AND EXISTS ( ")
            stbQ.AppendLine("               SELECT 1 ")
            stbQ.AppendLine("               FROM Mov_Destinazioni ")
            stbQ.AppendLine("               INNER JOIN reg_impianti ")
            stbQ.AppendLine("               ON Mov_Destinazioni.piva = Reg_Impianti.PIVA and Mov_Destinazioni.Sa_Cod = Reg_Impianti.SA_COD ")
            stbQ.AppendLine("               and Mov_Destinazioni.Appezza = Reg_Impianti.APPEZZA and Mov_Destinazioni.Id_Destinazione = Reg_Impianti.id_reg ")

            If IDTestataTemp <> 0 Then

                stbQ.AppendLine(" inner Join __tmp_FiltroImpianti f ")
                stbQ.AppendLine(" On  Reg_Impianti.PIVA = f.piva  ")
                stbQ.AppendLine(" And Reg_Impianti.SA_COD = f.sa_cod ")
                stbQ.AppendLine(" And Reg_Impianti.APPEZZA = f.appezza ")
                stbQ.AppendLine(" And Reg_Impianti.ID_REG = f.id_reg ")
                stbQ.AppendLine("       And f.idTestataTemp = " & IDTestataTemp)
                stbQ.AppendLine("       And f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
                stbQ.AppendLine("       And f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

            End If

            stbQ.AppendLine("               WHERE Mov_Destinazioni.piva= agenda.piva ")
            stbQ.AppendLine("               AND Mov_Destinazioni.id_agenda= agenda.id_agenda ")
            'stbQ.AppendLine(strFiltroImpianti)
            stbQ.AppendLine("               ) ")

            stbQ.AppendLine(" ")
            stbQ.AppendLine(" UNION ALL ")
            stbQ.AppendLine(" ")

            stbQ.AppendLine(" /* nuova visita (legata alla specie) */ ")
            stbQ.AppendLine(stbQ3.ToString)

            stbQ.AppendLine(" ORDER BY  Data_Movimento ")

            strErr = Nothing
            ' Try
            'objSql.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "CaricaDsVisite", DSVisite, DSVisite.DS_Note.TableName)
            DT_vis = objSql.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "CaricaDsVisite")
            'Catch ex As Exception
            '    strErr = ex.Message
            'End Try

            stbQDettagli.AppendLine(" SELECT DISTINCT Agenda.Piva, Agenda.Sa_Cod, Agenda.Id_Agenda, Agenda.Lav_Cod, CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) AS Data_Movimento, " &
                                "                 Mov_Destinazioni.Piva AS Piva_App, Mov_Destinazioni.Sa_Cod AS Sa_Cod_App, " &
                                "                 Mov_Destinazioni.Appezza, Mov_Destinazioni.Id_Destinazione, Mov_Destinazioni.Qta, Appezzamento.APP_NOME, Reg_Impianti.Validita_Inizio, Reg_Impianti.Validita_Fine, ISNULL(Campi.Campo_Des,'') AS Campo_Nome, " &
                                " ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici  " &
                                "       where (Appezzamento_Codici.PIVA = Appezzamento.PIVA) " &
                                "       and (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) " &
                                "       and (Appezzamento_Codici.appezza = Appezzamento.appezza) " &
                                "       and (Appezzamento_Codici.id_cod = 1104) ), '') AS App_Nome_Breve ," &
                                " SpecieVegetali.Veg_Des, Cultivar.Cul_Des" &
                                " FROM         Movimenti_dettagli INNER JOIN " &
                                "              Movimenti INNER JOIN " &
                                "              Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND Movimenti.Id_Agenda = Agenda.Id_Agenda ON  " &
                                "              Movimenti_dettagli.PIVA = Movimenti.PIVA AND Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod AND  " &
                                "              Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda AND Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov INNER JOIN " &
                                "              Mov_Destinazioni ON Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det AND  " &
                                "              Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND  " &
                                "              Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva INNER JOIN " &
                                "              Reg_Impianti ON Mov_Destinazioni.Piva = Reg_Impianti.PIVA AND Mov_Destinazioni.Sa_Cod = Reg_Impianti.SA_COD AND  " &
                                "              Mov_Destinazioni.Appezza = Reg_Impianti.APPEZZA AND Mov_Destinazioni.Id_Destinazione = Reg_Impianti.ID_REG INNER JOIN " &
                                "              Appezzamento ON Reg_Impianti.PIVA = Appezzamento.PIVA AND Reg_Impianti.SA_COD = Appezzamento.SA_COD AND  " &
                                "              Reg_Impianti.APPEZZA = Appezzamento.APPEZZA LEFT JOIN Campi ON Appezzamento.Piva = Campi.Piva AND " &
                                "              Appezzamento.Sa_Cod = Campi.Sa_Cod AND Appezzamento.Campo_Cod = Campi.Campo_Cod " &
                                "              INNER JOIN Cultivar ON  Cultivar.Cul_Cod = Reg_Impianti.CUL_COD " &
                                "              INNER JOIN SpecieVegetali ON SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod ")

            If IDTestataTemp <> 0 Then

                stbQDettagli.AppendLine("              inner Join __tmp_FiltroImpianti f ")
                stbQDettagli.AppendLine("              On  Reg_Impianti.PIVA = f.piva  ")
                stbQDettagli.AppendLine("              And Reg_Impianti.SA_COD = f.sa_cod ")
                stbQDettagli.AppendLine("              And Reg_Impianti.APPEZZA = f.appezza ")
                stbQDettagli.AppendLine("              And Reg_Impianti.ID_REG = f.id_reg ")
                stbQDettagli.AppendLine("                    And f.idTestataTemp = " & IDTestataTemp)
                stbQDettagli.AppendLine("       And f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
                stbQDettagli.AppendLine("       And f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

            End If

            stbQDettagli.AppendLine(" WHERE Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' " &
                                " AND ( Agenda.Lav_Cod = " & Agro_SQL_SaveNum(LAVCOD_MONITORAGGIO_TEMPI_RIENTRO.ToString) & " OR Agenda.Lav_Cod = " & Agro_SQL_SaveNum(LAVCOD_ALTRE_OPERAZIONI.ToString) & " )")
            '                       se occorre aggiungere il lav-cod 162 per le visite 

            'If Sa_Cod <> "0" Then
            If Not Flag_Multicentro Then
                stbQDettagli.AppendLine(" AND (Agenda.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " OR Agenda.Sa_Cod = -1) ")
            End If

            'stbQDettagli.AppendLine(strFiltroImpianti)

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQDettagli.AppendLine(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
                stbQDettagli.AppendLine(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
                stbQDettagli.AppendLine(" AND Movimenti.Data_Movimento = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            Else
                stbQDettagli.AppendLine(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
                stbQDettagli.AppendLine(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")
                stbQDettagli.AppendLine(" AND Movimenti.Data_Movimento <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
                stbQDettagli.AppendLine(" AND Movimenti.Data_Movimento >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")
            End If

            If Not Flag_Multispecie Then
                If Veg_Cod = "0" Then
                    stbQDettagli.AppendLine(" and Reg_Impianti.cul_cod = 0 ")
                Else
                    If TerrenoNudoIncluso = False Then
                        stbQDettagli.AppendLine(" AND SpecieVegetali.VEG_COD = " & Veg_Cod)
                    Else
                        stbQDettagli.AppendLine(" AND (SpecieVegetali.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) ")
                    End If
                End If
            End If

            stbQDettagli.AppendLine(" ORDER BY Agenda.Id_Agenda, Agenda.Piva ")

            strErr1 = Nothing
            'Try
            Dt_Dettagli = objSql.EseguiQuery_Lettura(objParametri_Server, stbQDettagli.ToString, "CaricaDsVisite")
            'Catch ex As Exception
            '    strErr1 = ex.Message
            'End Try

            'If Not IsNothing(strErr) Then
            '    Throw New Exception(strErr)
            'Else

            Dim Data, Ora, Tecnico, Note As String

            If Not IsNothing(DT_vis) Then

                For i = 0 To DT_vis.Rows.Count - 1

                    DR = DSVisite._DS_Note.NewRow

                    'non vengono usati nel report
                    DR.Piva = ""
                    DR.PivaReale = ""
                    DR.Des_Lib = ""
                    DR.Sa_Cod = 0
                    DR.Id_Agenda = DT_vis.Rows(i).Item("Id_Agenda")
                    DR.Lav_Cod = 0
                    DR.Cod_RisUm = 0

                    '--------------------------------
                    'DATA
                    ' GBEL 18-03-2021 Le colonne nel datatable in casi di sql provider non sono di tipo system.string ma timespan
                    If AgronicaCoreDataProvider.DataProviderFactory.Instance.TipoProvider = enum_DataProvidersType.OleDbProvider Then
                        If CDate(DT_vis.Rows(i).Item("Data_Movimento")).ToShortDateString = "01/01/1900" Then
                            Data = ""
                            Ora = ""
                        Else
                            Data = Formatta_Data_Movimento(DT_vis.Rows(i).Item("Data_Movimento"))
                            If IsDBNull(DT_vis.Rows(i).Item("Ora")) Then
                                Ora = ""
                            Else
                                If CDate(DT_vis.Rows(i).Item("Ora")).ToShortTimeString <> "00:00" And CDate(DT_vis.Rows(i).Item("Ora")).ToShortTimeString <> "00.00" Then
                                    Ora = CDate(DT_vis.Rows(i).Item("Ora")).ToShortTimeString
                                Else
                                    Ora = ""
                                End If
                            End If
                        End If
                    Else
                        If CDate(DT_vis.Rows(i).Item("Data_Movimento")).ToShortDateString = "01/01/1900" Then
                            Data = ""
                            Ora = ""
                        Else
                            Data = Formatta_Data_Movimento(DT_vis.Rows(i).Item("Data_Movimento"))
                            If IsDBNull(DT_vis.Rows(i).Item("Ora")) Then
                                Ora = ""
                            Else
                                Dim dtOra As DateTime = New Date(DirectCast(DT_vis.Rows(i).Item("Ora"), TimeSpan).Ticks)
                                If dtOra.ToShortTimeString <> "00:00" And dtOra.ToShortTimeString <> "00.00" Then
                                    Ora = dtOra.ToShortTimeString
                                Else
                                    Ora = ""
                                End If
                            End If
                        End If
                    End If

                    DR.Data_Movimento = Data & " " & Ora

                    '--------------------------------
                    'TECNICO
                    If DT_vis.Rows(i).Item("Tecnico") <> "" Then
                        Tecnico = DT_vis.Rows(i).Item("Tecnico")
                    Else
                        If DT_vis.Rows(i).Item("Utente") <> "" Then
                            Tecnico = DT_vis.Rows(i).Item("Utente")
                        Else
                            Tecnico = ""
                        End If
                    End If

                    DR.Tecnico = Tecnico

                    '--------------------------------
                    'NOTE
                    If DT_vis.Rows(i).Item("Lav_Cod") = LAVCOD_MONITORAGGIO_TEMPI_RIENTRO Then
                        Note = DT_vis.Rows(i).Item("Lav_Des")
                    Else
                        Note = "Visita"
                    End If

                    If DT_vis.Rows(i).Item("Operazione") <> "" Then
                        Note &= " (" + DT_vis.Rows(i).Item("Operazione") + ") "
                    End If

                    If DT_vis.Rows(i).Item("Note") <> "" Or DT_vis.Rows(i).Item("Note2") <> "" Then
                        Note &= ": " & DT_vis.Rows(i).Item("Note") & " " & DT_vis.Rows(i).Item("Note2")
                    End If

                    DR.Note = Note.Trim

                    '----------------------------------------------------
                    'DETTAGLI APPEZZAMENTI E NOTE TEMPI DI RIENTRO
                    'IF REPORT = GLOBALGAP



                    Dr_Dettagli = Dt_Dettagli.Select("id_agenda=" & DT_vis.Rows(i).Item("id_agenda"))

                    strDettagli = ""

                    strSpecie = ""

                    lstVarieta.Clear()

                    If Not Dr_Dettagli Is Nothing AndAlso Dr_Dettagli.Length > 0 Then

                        strSpecie = Dr_Dettagli(0).Item("Veg_Des")

                        For j = 0 To Dr_Dettagli.Length - 1

                            Dr_Dettagli(j).Item("App_Nome_Breve") = CodiceAppezzamento(Dr_Dettagli(j).Item("Piva"),
                                                                                        Dr_Dettagli(j).Item("Sa_Cod"),
                                                                                        Dr_Dettagli(j).Item("Campo_Nome"),
                                                                                        Dr_Dettagli(j).Item("Appezza"),
                                                                                        TipoCodAppezzamento,
                                                                                        Dr_Dettagli(j).Item("App_Nome"),
                                                                                        Dr_Dettagli(j).Item("App_Nome_Breve"), -1)

                            '----------------------------------------------
                            'per id consociazione
                            Try

                                Dim objImp As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
                                Dim ID_Consociazione As Integer
                                Dim Tot_Consociati As Integer
                                Dim Sigla_Consociazione As String
                                If ControllaProgressivoConsociazione(Dr_Dettagli(j).Item("Piva"),
                                                                                        Dr_Dettagli(j).Item("Sa_Cod"),
                                                                                        Dr_Dettagli(j).Item("APPEZZA"), Dr_Dettagli(j).Item("Id_Destinazione"), ID_Consociazione, Tot_Consociati, Sigla_Consociazione, objParametri_Server) Then
                                    Dr_Dettagli(j).Item("App_Nome_Breve") &= "/" & Sigla_Consociazione & ""
                                    'Dr_Dettagli(j).Item("App_Nome_Breve") &= "/" & ID_Consociazione & ""
                                End If

                            Catch ex As Exception

                            End Try

                            '----------------------------------------------


                            If DT_vis.Rows(i).Item("Lav_Cod") = LAVCOD_MONITORAGGIO_TEMPI_RIENTRO AndAlso
                                (Session("ReportSelezionato") = enum_CodificaStampe.Eurep_Gap_Multicentro OrElse Session("ReportSelezionato") = enum_CodificaStampe.Eurep_Gap_Semplificata) Then


                                Select Case Dr_Dettagli(j).Item("Qta")
                                    Case -1
                                        strDettagli &= "App." & Dr_Dettagli(j).Item("App_Nome_Breve") & " ---> Tempo di Rientro NON RISPETTATO," & vbCrLf
                                    Case 1
                                        strDettagli &= "App." & Dr_Dettagli(j).Item("App_Nome_Breve") & " ---> Tempo di Rientro RISPETTATO," & vbCrLf
                                End Select

                            Else

                                strDettagli &= " App." & Dr_Dettagli(j).Item("App_Nome_Breve") & ","

                            End If

                            If Not lstVarieta.Contains(Dr_Dettagli(j).Item("Cul_Des")) Then

                                lstVarieta.Add(Dr_Dettagli(j).Item("Cul_Des"))

                            End If

                        Next

                    End If


                    If DT_vis.Rows(i).Item("Lav_Cod") = LAVCOD_MONITORAGGIO_TEMPI_RIENTRO AndAlso
                                (Session("ReportSelezionato") = enum_CodificaStampe.Eurep_Gap_Multicentro OrElse Session("ReportSelezionato") = enum_CodificaStampe.Eurep_Gap_Semplificata) Then


                        DR.Note &= vbCrLf & strDettagli

                    Else

                        If Not String.IsNullOrEmpty(strDettagli) Then

                            strDettagli = strDettagli.TrimEnd(",")

                            strDettagli = strDettagli.Insert(0, "App.interessati:")

                        End If

                        DR.Note &= vbCrLf & strDettagli

                    End If


                    'Visualizza la Specie e la Varietà insieme
                    DR.Veg_Des_e_Cul_Des = strSpecie & " " & String.Join(",", lstVarieta)

                    DSVisite._DS_Note.Rows.Add(DR)

                Next

            End If

            ' End If

        Catch ex As Exception
            Log_Errori &= "CaricaDsvisite: " & vbCrLf & ex.Message & vbCrLf
            Throw New Exception(Log_Errori)
        End Try

        EndWatch(sw, "CaricaDsVisite")

    End Sub


