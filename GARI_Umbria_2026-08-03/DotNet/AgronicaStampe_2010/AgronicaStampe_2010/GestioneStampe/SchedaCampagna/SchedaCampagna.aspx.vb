                If Veg_Cod = "0" Then
                    stbQ.Append(" and Reg_Impianti.cul_cod = 0 " & vbCrLf)
                Else
                    If TerrenoNudoIncluso = False Then
                        stbQ.Append(" AND SpecieVegetali.VEG_COD = " & Veg_Cod & vbCrLf)
                    Else
                        stbQ.Append(" AND (SpecieVegetali.VEG_COD = " & Veg_Cod & " OR Reg_Impianti.cul_cod = 0) " & vbCrLf)
                    End If
                End If
            End If

            stbQ.Append(" AND Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' " & vbCrLf)


            If Not Flag_Multicentro Then
                stbQ.Append(" AND Agenda.sa_cod = " & Sa_Cod & " " & vbCrLf)
            End If

            'stbQ.Append(strFiltroImpianti & vbCrLf)


            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQ.Append(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
                stbQ.Append(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)

                stbQ.Append(" AND Movimenti.Data_Movimento = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)

