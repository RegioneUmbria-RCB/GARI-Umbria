        stbQ.Append(" ISNULL(Parco_Macchine.Targa , '') AS Targa, ISNULL(Telaio, '') AS Telaio, ISNULL(Modello, '') AS Modello, isnull(Potenza,'') AS Potenza, ISNULL(Stato_Utilizzo, '') AS Stato_Utilizzo,    " & vbCrLf)
