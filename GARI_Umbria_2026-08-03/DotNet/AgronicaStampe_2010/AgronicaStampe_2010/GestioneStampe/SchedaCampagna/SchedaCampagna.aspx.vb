        stbQ.Append(" INNER JOIN Cultivar Cultivar ON Cultivar.Cul_Cod = Reg_Impianti.CUL_COD INNER JOIN ")
        stbQ.Append(" SpecieVegetali SpecieVegetali ON SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod INNER JOIN ")
        stbQ.Append(" Avversita Avversita ON Mov_Dettaglio_Tecnico.Av_Cod = Avversita.Av_Cod  ")
