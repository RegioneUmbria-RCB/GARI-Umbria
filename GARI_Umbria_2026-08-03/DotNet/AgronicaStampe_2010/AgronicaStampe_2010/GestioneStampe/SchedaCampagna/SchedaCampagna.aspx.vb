                        'End If
                        'If riga_man(0).Item("Doc_Numero") <> 0 Then
                        '    nuovaRiga.Note += " - certificato n.: " + _
                        '            riga_man(0).Item("Doc_Numero").ToString
                        'End If
                        'If riga_man(0).Item("Rag_Soc") <> "" OrElse riga_man(0).Item("Cognome") <> "" OrElse _
                        '    riga_man(0).Item("Nome") <> "" Then
                        '    nuovaRiga.Note += " - centro revisione: " + _
                        '                riga_man(0).Item("Rag_Soc") + _
                        '                riga_man(0).Item("Cognome") + " " + _
                        '                riga_man(0).Item("Nome")
                        'End If
                        nuovaRiga.Note = ParcoMacchine_RicavaNote(riga_man(0).Item("note"),
                                                                     riga_man(0).Item("scadenza"),
                                                                     riga_man(0).Item("Doc_Numero"),
                                                                      riga_man(0).Item("Rag_Soc"),
                                                                     riga_man(0).Item("Nome"),
                                                                     riga_man(0).Item("Cognome"),
                                                                      riga_man(0).Item("Data_Immatricolazione"),
                                                                    riga_man(0).Item("N_Immatricolazione"),
                                                                     riga_man(0).Item("N_Autorizzazione_Trasporto"),
                                                                    riga_man(0).Item("Data_Rilascio_Autorizzazione"))


                        If riga_man(0).Item("data") <> AGRODATAINIZIO Then
