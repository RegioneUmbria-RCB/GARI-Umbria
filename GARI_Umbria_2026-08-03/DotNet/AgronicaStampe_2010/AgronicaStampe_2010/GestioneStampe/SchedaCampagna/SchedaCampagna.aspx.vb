                        drR.gru_cod = 2

                        If drR.APPEZZA <> 0 And drR.ID_REG <> 0 Then

                            'se ho scelto i rilievi piogge..
                            If CStr(Session("sezioni")) = "9" Then
                                drR.VEG_DES = ""
                            Else
                                drR.VEG_DES = "Terreno Nudo"
                            End If

                            'controllo se è laghetto, boschetto o altro..

                            'CodiceTerreno = Leggi_DestinazioneUso_Impianto2(Server, Session, Page, CStr(drr.PIVA), CInt(drr.sa_cod), CInt(drr.APPEZZA), CInt(drr.ID_REG), DestinazioneUso)

                            DestinazioneUso = ""
                            Dim objRegImpianti As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read

                            Dim DtDest As DataTable
                            DtDest = objRegImpianti.Leggi_DestinazioneUso_Impianto2(drR.PIVA,
                                                                                    drR.sa_cod,
                                                                                    drR.APPEZZA,
                                                                                    drR.ID_REG,
                                                                                    "", "", objParametri_Server)

                            objRegImpianti = Nothing

                            If DtDest.Rows.Count > 0 Then
                                DestinazioneUso = DtDest.Rows(0).Item("descrizione")
                                CodiceTerreno = DtDest.Rows(0).Item("id_cod")
                            Else
                                DestinazioneUso = ""
                                CodiceTerreno = 0
                            End If


                            If CodiceTerreno <> 0 Then

                                drR.CUL_DES = DestinazioneUso 'CodiceAnagrafeDes_from_CodiceAnagrafeCod(Server, Session, Page, CodiceTerreno)

                                If InStr(strCodiciTerreno, drR.CUL_DES) = 0 Then
                                    strCodiciTerreno &= drR.CUL_DES & ", "
                                End If

                            Else

                                If InStr(strCodiciTerreno, "Terreno Nudo") = 0 Then
                                    strCodiciTerreno &= "Terreno Nudo, "
                                End If

                            End If

                        End If


                    End If

                    'Se il Report è quello di conserve italia
                    'inserisco le cooperative referenti e la op
                    If TipoReport = enum_TipoReport.SchedaCampagna_ConserveItalia Then

                        If drR.APPEZZA <> 0 And drR.ID_REG <> 0 Then

                            'cerco la cooperativa a cui è stato associato ciascun impianto
                            drR.Piva_Cooperativa = Reg_Impianti_Codici_R.Leggi_Codice_from_Reg_Impianti_Codici(drR.PIVA, drR.sa_cod, drR.APPEZZA, drR.ID_REG, 1074, objParametri_Server)
                            If drR.Piva_Cooperativa <> "" Then

                                Dim objImprese As New AgronicaCoreAnagrafeDAL.Imprese_Read
                                'drR.Cooperativa = RagSoc_from_Piva(Server, Session, Page, drR.Piva_Cooperativa)
                                drR.Cooperativa = objImprese.RagSoc_from_Piva(drR.Piva_Cooperativa, objParametri_Server)
                                objImprese = Nothing
                            End If

                        End If

                        Dim RsOP As DataTable
                        RsOP = Imprese_Read.Recupera_OP_from_Piva(drR.PIVA, objParametri_Server)

                        If Not RsOP Is Nothing AndAlso RsOP.Rows.Count > 0 Then
                            drR.OP = RsOP.Rows(0).Item("RAG_SOC")
                            drR.Piva_OP = RsOP.Rows(0).Item("PIVA")
                        End If

                    ElseIf Session("ReportSelezionato") = enum_CodificaStampe.SchedaInterventiAgronomici Then

                        piva_orgref = ""
                        ragosc_orgref = ""

                        If drR.APPEZZA <> 0 And drR.ID_REG <> 0 Then
                            Reg_Impianti_Codici_R.OrgReferentePivaRagSoc_from_Impianto(drR.PIVA, drR.sa_cod, drR.APPEZZA, drR.ID_REG, 0,
                                                                                        Qs_DataInizio, Qs_DataFine,
                                                                                        "", "",
                                                                                         piva_orgref, ragosc_orgref,
                                                                                         objParametri_Server)
                        End If

                        drR.Piva_Cooperativa = piva_orgref
                        drR.Cooperativa = ragosc_orgref

                    End If 'conserveitalia o scheda interventi agronomici

                    'se ho scelto un giorno metto un solo anno
                    If Qs_DataStampa <> "" Then

                        Anno = CStr(Year(CDate(Qs_DataStampa)))

                        drR.anno = Anno

                    Else
                        'se ho scelto un intervallo..
                        Anno1 = CStr(Year(CDate(Qs_DataInizio)))
                        Anno2 = CStr(Year(CDate(Qs_DataFine)))

                        Differenza = DateDiff(DateInterval.Year, CDate(Qs_DataInizio), CDate(Qs_DataFine))
                        'metto un anno se l'intervallo è inferiore ad un anno
                        If Differenza = 0 Then
                            drR.anno = Anno1
                        Else
                            'altrimenti metto i due anni dell'intervallo
                            drR.anno = Anno1 & " - " & Anno2
                        End If

                    End If


                    drR.Num_Patentino = Patentino
                    drR.Titolare_Patentino = Titolare
                    drR.Data_Scadenza_Patentino = Data_Scadenza_Patentino

                    '(04/11/2015 fede) 
                    '1.se c'è la data trapianto viene preso l'anno del trapianto
                    '2.se c'è la data trapianto prevista viene preso l'anno del trapianto previsto (sempre in Data_Semina sovrascritto sopra)
                    '3.altrimenti viene preso l'anno di inizio impianto (21/05/2019 maga) se nel prestampa è flaggato il check "Stampa anno impianto colture pluriennali)
                    If drR.gru_cod = 2 Or drR.gru_cod = 3 Then
                    Else
                        '21/05/2019: viene stampato l'anno dell data inizio impianto se c'è il flag selezionato nel prestampa
                        If flag_StampaAnnoImpiantoPluriennali = True Then
                            If IsDate(drR.Data_Semina) AndAlso CDate(drR.Data_Semina) <> AGRODATAINIZIO Then
                                drR.Data_InizioImpianto = Year(CDate(drR.Data_Semina))
                            Else
                                If IsDate(drR.Data_InizioImpianto) AndAlso CDate(drR.Data_InizioImpianto) <> AGRODATAINIZIO Then
                                    drR.Data_InizioImpianto = Year(CDate(drR.Data_InizioImpianto))
                                Else
                                    drR.Data_InizioImpianto = ""
                                End If
                            End If
                        Else
                            drR.Data_InizioImpianto = ""
                        End If
                    End If


                    'Inserisco le colture precedenti (per erbacee e orticole)
                    'N.B.Non considero le date..(es.se ho 4 colture sottintendo che sono riferite ai 4anni precedenti)
                    If drR.APPEZZA <> 0 Then

                        If Gru_Cod <> 1 Then


                            InserisciPrecessioniColturali(drR, Campo_Cod)



                        End If

                    End If

                    If Not IsNothing(LogoRegione) Then
                        drR.LogoRegione = LogoRegione
                    End If
                    drR.LogoCliente = LogoCliente
                    drR.Cod_Produttore = codiceProduttore
                    drR.TecnicoRif = tecnicoImpresa
                    If drR.VEG_DES <> "" Then
                        drR.VEG_DES += FinalitàSpecie + capitolatoPr
                    End If
                    'INSERIRE QUI I CAMPI NUOVI PER INTESTAZIONE !!!!!!

                Next ' ciclo impianti

                'creo la stringa delle cooperative prendendo quelle inserite in ogni impianto ed eliminando le doppie..
                For i = 0 To DsErbacee.vw_rptErbacee.Rows.Count - 1

                    If DsErbacee.vw_rptErbacee.Rows(i).Item("Piva_Cooperativa").ToString <> "" Then
                        If InStr(Piva_Cooperativa, DsErbacee.vw_rptErbacee.Rows(i).Item("Piva_Cooperativa").ToString) = 0 Then
                            Piva_Cooperativa &= DsErbacee.vw_rptErbacee.Rows(i).Item("Piva_Cooperativa").ToString & " - "
                            Cooperativa &= DsErbacee.vw_rptErbacee.Rows(i).Item("Cooperativa").ToString & " - "
                        End If
                    End If

                Next

                If Piva_Cooperativa <> "" Then
                    Piva_Cooperativa = Left(Piva_Cooperativa, Piva_Cooperativa.Length - 3)
                    Cooperativa = Left(Cooperativa, Cooperativa.Length - 3)
                Else
                    Cooperativa = ""
                End If

                If strCodiciTerreno <> "" Then
                    strCodiciTerreno = Left(strCodiciTerreno, strCodiciTerreno.Length - 2)
                End If

                'inserisco la stringa nel ds
                For i = 0 To DsErbacee.vw_rptErbacee.Rows.Count - 1

                    Dim drR As DS_Erbacee.vw_rptErbaceeRow = DsErbacee.vw_rptErbacee.Rows(i)

                    drR.Piva_Cooperativa = Piva_Cooperativa
                    drR.Cooperativa = Cooperativa

                    If strCodiciTerreno <> "" Then
                        drR.VEG_DES = strCodiciTerreno
                    End If

                    If Session("ReportSelezionato") = enum_CodificaStampe.SchedaInterventiAgronomici Then
                        If flag_organismoIntest = True Then
                            'l'intestatario deve essere la cooperativa impostata come org referente
                            'e sotto riportare anche l'az agr
                            If drR.Cooperativa <> "" Then
                                drR.rag_soc = drR.Cooperativa & "<br>" & drR.rag_soc
                            End If
                            drR.Cooperativa = ""
                        End If
                    End If

                Next


                '--------------------------------------------------------------------------------------
                'ORDINO IL DATASET
                '(per farlo importo nell'ordine le datarow ordinate e poi elimino le vecchie righe)
                '--------------------------------------------------------------------------------------

                Dim Righe_Old As Integer
                Dim dr As DataRow

                Righe_Old = DsErbacee.vw_rptErbacee.Count

                'For Each dr In DsErbacee.vw_rptErbacee.Select("", "N_appezza")
                For Each dr In DsErbacee.vw_rptErbacee.Select("", "App_Nome_Breve")

                    DsErbacee.vw_rptErbacee.ImportRow(dr)

                Next

                For i = 0 To Righe_Old - 1
                    DsErbacee.vw_rptErbacee.Rows(i).Delete()
                Next

                'rendo permanenti le modifiche sul ds
                DsErbacee.vw_rptErbacee.AcceptChanges()
                DsErbacee.vw_rptErbacee.Columns("Piva").ColumnName = "Piva_old"
                DsErbacee.vw_rptErbacee.Columns("PivaReale").ColumnName = "Piva"
                DsErbacee.vw_rptErbacee.Columns("Piva_old").ColumnName = "PivaReale"

            Else
                'eccezione......
                Throw New Exception(strErr)
            End If

        Catch ex As Exception
            Log_Errori &= "CaricaDsErbacee: " & vbCrLf & ex.Message & vbCrLf
            Throw New Exception(Log_Errori)
        End Try

        EndWatch(sw, "CaricaDsErbacee")

    End Sub

