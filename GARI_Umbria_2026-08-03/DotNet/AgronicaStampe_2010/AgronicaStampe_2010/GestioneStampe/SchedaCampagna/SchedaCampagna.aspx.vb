        End If

        rptStampa_EUREP_GAP_Semplicata.OpenSubreport("FooterLogo.rpt").SetDataSource(DSLogoFooter)

        '--- controlli
        If InStr(strSezioni, ElencoReportChiave.VERIFICHE_CONFORMITA) <> 0 Then
