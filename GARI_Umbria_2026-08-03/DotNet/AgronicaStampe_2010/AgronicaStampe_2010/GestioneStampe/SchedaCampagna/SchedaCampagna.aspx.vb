            stbQ.Append(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            stbQ.Append(" AND Agenda.Validita_Inizio = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
        Else

