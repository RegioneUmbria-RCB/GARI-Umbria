    Public Sub CaricaDsCatasto(ByVal Flag_Multicentro As Boolean, ByVal Flag_Multispecie As Boolean,
                               ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna,
                               ByRef HT_OccupazioneDes As Hashtable)

        Dim stbQuery As New System.Text.StringBuilder
        Dim objSQL As New AgronicaCoreDataProvider.DataProvider
        Dim strErr As String

        Dim strImpianto As String = ""
        Dim strImpianti As String = ""
        Dim drR As DS_Catasto.DS_CatastoRow

        Dim App_Nome As String
        Dim Num_Appezzamento As Double
        Dim objNum As New AgronicaCoreDataProvider.UtilityProvider

        Dim i As Integer


        Dim sw As Stopwatch = StartWatch("CaricaDsCatasto")

        Try

            'Carico gli IMPIANTI che HANNO RECORD nella tabella ProgettixParticelle...

            stbQuery.Length = 0

            stbQuery.Append(" --ProgettixParticelle " & vbCrLf)
            stbQuery.Append(" SELECT DISTINCT " & vbCrLf)

            stbQuery.Append(" Centri_Aziendali.sa_nome, Reg_Impianti.PIVA,  " & vbCrLf)
            stbQuery.Append(" CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Reg_Impianti.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale, " & vbCrLf)
            stbQuery.Append(" Reg_Impianti.SA_COD, " & vbCrLf)
            stbQuery.Append(" Reg_Impianti.APPEZZA, Reg_Impianti.ID_REG, Appezzamento.App_Nome, " & vbCrLf)
            stbQuery.Append(" Reg_Impianti.CUL_COD, " & vbCrLf)

            ' stbQuery.Append(" ISNULL(SpecieVegetali.Veg_Des, '') AS Veg_Des, ISNULL(Cultivar.CUL_DES,'Terreno Nudo') AS CUL_DES, ")
            '06/11/2018 MAGA
            'veg_des e cul_des unificate e lette anche le destinazioni d'uso
            stbQuery.Append(" case when Reg_Impianti.cul_cod = 0 then " & vbCrLf)
            stbQuery.Append("           ( ISNULL( (SELECT TOP 1 descrizione " & vbCrLf)
            stbQuery.Append("                       FROM Reg_Impianti_Codici RIC " & vbCrLf)
            stbQuery.Append("                       INNER JOIN Codici_Anagrafe Cod ON  RIC.id_cod= Cod.codice " & vbCrLf)
            stbQuery.Append("                       where progetto_cod=0 " & vbCrLf)
            stbQuery.Append("                       and id_cod >= 3000 and id_cod < 4000 " & vbCrLf)
            stbQuery.Append("                       and piva=Reg_Impianti.piva and sa_cod=Reg_Impianti.sa_cod " & vbCrLf)
            stbQuery.Append("                       and appezza= Reg_Impianti.appezza and id_reg=Reg_Impianti.id_reg " & vbCrLf)
            stbQuery.Append("                       ), 'Terreno nudo')  )" & vbCrLf)
            stbQuery.Append(" else  ( " & vbCrLf)
            stbQuery.Append("       SELECT veg_des + ' ' +  cul_des " & vbCrLf)
            stbQuery.Append("       FROM SpecieVegetali " & vbCrLf)
            stbQuery.Append("       INNER JOIN Cultivar ON  SpecieVegetali.Veg_Cod = Cultivar.Veg_Cod " & vbCrLf)
            stbQuery.Append("       where Cultivar.Cul_Cod = Reg_Impianti.cul_cod " & vbCrLf)
            stbQuery.Append("       ) " & vbCrLf)
            stbQuery.Append("  end AS veg_des, " & vbCrLf)

            stbQuery.Append(" Appezzamento.SUP_APP, Reg_Impianti.REGOLAMENTO, Reg_Impianti.FINANZIAMENTO, " & vbCrLf)
            stbQuery.Append(" ISNULL(AppezzamentiXParticelle.PROV,'') AS PROV, ISNULL(AppezzamentiXParticelle.COM,'') AS COM, ISNULL(AppezzamentiXParticelle.SEZIONE,'') AS SEZIONE, " & vbCrLf)
            stbQuery.Append(" ISNULL(AppezzamentiXParticelle.FOGLIO,'') AS FOGLIO, ISNULL(AppezzamentiXParticelle.NUMERO,'') AS NUMERO, ISNULL(AppezzamentiXParticelle.SUBALTERNO,'') AS SUBALTERNO, " & vbCrLf)
            stbQuery.Append(" ISNULL(AppezzamentiXParticelle.AREA,'') AS AREA, " & vbCrLf)

            'Controllo se devo stampare la superficie dell'impianto o dell'appezzamento
            If strTipoSuperficie = "i" Then
                stbQuery.Append(" Reg_Impianti.sup_imp, " & vbCrLf)
            Else
                stbQuery.Append(" Appezzamento.Sup_App AS Sup_Imp, " & vbCrLf)
            End If

            stbQuery.Append(" ISNULL(ISTAT.LOCALITA,'') AS Comune, ISNULL(ISTAT.COMUNI_PROV,'') AS Provincia, " & vbCrLf)
            stbQuery.Append(" ISNULL(ProgettixParticelle.val_cod, '') AS Prog_Part , " & vbCrLf)

            stbQuery.Append(" ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici  " & vbCrLf)
            stbQuery.Append("         where (Appezzamento_Codici.PIVA = Appezzamento.PIVA) " & vbCrLf)
            stbQuery.Append(" 	      and (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) " & vbCrLf)
            stbQuery.Append(" 	      and (Appezzamento_Codici.appezza = Appezzamento.appezza) " & vbCrLf)
            stbQuery.Append(" 	      and (Appezzamento_Codici.id_cod = 1104) ), '') AS App_Nome_Breve, " & vbCrLf)

            stbQuery.Append(" ISNULL((SELECT TOP 1 Imprese_Progetti.Progetto_Nome FROM Imprese_Progetti " & vbCrLf)
            stbQuery.Append("       WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
            stbQuery.Append("       AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
            stbQuery.Append("       AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
            stbQuery.Append(" 	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG " & vbCrLf)
            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQuery.Append(" AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
                stbQuery.Append(" AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            Else
                stbQuery.Append(" AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
                stbQuery.Append(" AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
            End If

            stbQuery.Append("       ORDER BY Imprese_Progetti.Validita_Inizio DESC ), '') AS Progetto, " & vbCrLf)

            'campo_des
            stbQuery.Append(" ISNULL(( SELECT top 1 Campi.Campo_Des " & vbCrLf)
            stbQuery.Append(" FROM Campi " & vbCrLf)
            stbQuery.Append(" WHERE Campi.Piva = Appezzamento.PIVA AND Campi.Sa_Cod = Appezzamento.SA_COD AND " & vbCrLf)
            stbQuery.Append(" Campi.Campo_Cod = Appezzamento.Campo_Cod " & vbCrLf)
            stbQuery.Append(" ),'') AS Campo_Nome, " & vbCrLf)

            stbQuery.Append(" Reg_Impianti.FINANZIAMENTO, ISNULL(ParticelleCatastali.ETTARI,'0') AS ETTARI, ISNULL(ParticelleCatastali.[ARE],'0') AS ARE, ISNULL(ParticelleCatastali.CENTIARE,'0') AS CENTIARE, " & vbCrLf)
            stbQuery.Append(" 0 AS Sup_Particella " & vbCrLf)

            stbQuery.Append(" FROM         ParticelleCatastali LEFT OUTER JOIN" & vbCrLf)
            stbQuery.Append("              ProgettixParticelle RIGHT OUTER JOIN" & vbCrLf)
            stbQuery.Append("              ISTAT RIGHT OUTER JOIN" & vbCrLf)
            stbQuery.Append("              AppezzamentiXParticelle RIGHT OUTER JOIN" & vbCrLf)
            stbQuery.Append("              Reg_Impianti INNER JOIN" & vbCrLf)
            stbQuery.Append("              Imprese ON Reg_Impianti.PIVA = Imprese.PIVA INNER JOIN" & vbCrLf)
            stbQuery.Append("              Appezzamento ON Reg_Impianti.APPEZZA = Appezzamento.APPEZZA AND Reg_Impianti.SA_COD = Appezzamento.SA_COD AND " & vbCrLf)
            stbQuery.Append("              Reg_Impianti.PIVA = Appezzamento.PIVA LEFT OUTER JOIN" & vbCrLf)
            stbQuery.Append("              Imprese_Progetti ON Reg_Impianti.ID_REG = Imprese_Progetti.Id_Reg AND Reg_Impianti.APPEZZA = Imprese_Progetti.Appezza AND " & vbCrLf)
            stbQuery.Append("              Reg_Impianti.SA_COD = Imprese_Progetti.Sa_Cod AND Reg_Impianti.PIVA = Imprese_Progetti.Piva ON " & vbCrLf)
            stbQuery.Append("              AppezzamentiXParticelle.PIVA = Appezzamento.PIVA AND AppezzamentiXParticelle.SA_COD = Appezzamento.SA_COD AND " & vbCrLf)
            stbQuery.Append("              AppezzamentiXParticelle.APPEZZA = Appezzamento.APPEZZA ON ISTAT.PROV = AppezzamentiXParticelle.PROV AND " & vbCrLf)
            stbQuery.Append("              ISTAT.COM = AppezzamentiXParticelle.COM " & vbCrLf)
            stbQuery.Append("              ON ProgettixParticelle.PIVA = Imprese_Progetti.Piva AND " & vbCrLf)
            stbQuery.Append("              ProgettixParticelle.sa_cod = Imprese_Progetti.Sa_Cod AND ProgettixParticelle.appezza = Imprese_Progetti.Appezza AND " & vbCrLf)
            stbQuery.Append("              ProgettixParticelle.Id_Reg = Imprese_Progetti.Id_Reg AND ProgettixParticelle.Progetto_Cod = Imprese_Progetti.Progetto_Cod ON " & vbCrLf)
            stbQuery.Append("              ParticelleCatastali.PROV = ProgettixParticelle.PROV AND ParticelleCatastali.COM = ProgettixParticelle.COM AND " & vbCrLf)
            stbQuery.Append("              ParticelleCatastali.SEZIONE = ProgettixParticelle.SEZIONE AND ParticelleCatastali.FOGLIO = ProgettixParticelle.FOGLIO AND " & vbCrLf)
            stbQuery.Append("              ParticelleCatastali.NUMERO = ProgettixParticelle.NUMERO AND ParticelleCatastali.SUBALTERNO = ProgettixParticelle.SUBALTERNO AND " & vbCrLf)
            stbQuery.Append("              ParticelleCatastali.PROV = AppezzamentiXParticelle.PROV AND ParticelleCatastali.COM = AppezzamentiXParticelle.COM AND " & vbCrLf)
            stbQuery.Append("              ParticelleCatastali.SEZIONE = AppezzamentiXParticelle.SEZIONE AND ParticelleCatastali.FOGLIO = AppezzamentiXParticelle.FOGLIO AND " & vbCrLf)
            stbQuery.Append("              ParticelleCatastali.NUMERO = AppezzamentiXParticelle.NUMERO AND " & vbCrLf)
            stbQuery.Append("              ParticelleCatastali.SUBALTERNO = AppezzamentiXParticelle.SUBALTERNO" & vbCrLf)
            stbQuery.Append(" INNER JOIN Centri_Aziendali ON Centri_Aziendali.Piva = Appezzamento.Piva AND Centri_Aziendali.Sa_Cod = Appezzamento.Sa_Cod " & vbCrLf)

            'LEFT OUTER JOIN Cultivar ON Reg_Impianti.CUL_COD = Cultivar.Cul_Cod 
            'stbQuery.Append(" LEFT OUTER JOIN SpecieVegetali ON Cultivar.Veg_Cod = SpecieVegetali.Veg_Cod ")

            If IDTestataTemp <> 0 Then

                stbQuery.Append(" inner Join __tmp_FiltroImpianti f ")
                stbQuery.Append(" On  Reg_Impianti.PIVA = f.piva  ")
                stbQuery.Append(" And Reg_Impianti.SA_COD = f.sa_cod ")
                stbQuery.Append(" And Reg_Impianti.APPEZZA = f.appezza ")
                stbQuery.Append(" And Reg_Impianti.ID_REG = f.id_reg ")
                stbQuery.Append("       And f.idTestataTemp = " & IDTestataTemp)
                stbQuery.Append("       And f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
                stbQuery.Append("       And f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

            End If

            stbQuery.Append(" WHERE Reg_Impianti.PIVA = '" & Agro_SQL_SaveText(Piva) & "'" & vbCrLf)

            If Not Flag_Multicentro AndAlso Sa_Cod <> "0" Then
                stbQuery.Append("  AND Reg_Impianti.Sa_Cod = " & Sa_Cod & " " & vbCrLf)
            End If

            ''stbQuery.Append(strFiltroImpianti)


            'se ho scelto una data unica per la stampa..
