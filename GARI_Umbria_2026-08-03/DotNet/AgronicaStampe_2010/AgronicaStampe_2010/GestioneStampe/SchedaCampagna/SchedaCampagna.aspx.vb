                        End If

                    End If


                    'Il campo veg_des è nullo se è stato selezionato un terreno nudo o un rilievo piogge
                    If IsDBNull(DsErbacee.vw_rptErbacee.Rows(i).Item("veg_des")) Then

                        'se ho scelto i rilievi piogge..
                        If CStr(Session("sezioni")) = "9" Then
                            drR.VEG_DES = ""
