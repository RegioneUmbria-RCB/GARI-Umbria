        'stbQ.Append(" LEFT JOIN Imprese_Progetti ON Imprese_Progetti.Piva = Reg_Impianti.PIVA AND Imprese_Progetti.Sa_Cod = Reg_Impianti.SA_COD AND  " & vbCrLf)
        'stbQ.Append(" Imprese_Progetti.Appezza = Reg_Impianti.APPEZZA AND Imprese_Progetti.Id_Reg = Reg_Impianti.ID_REG " & vbCrLf)

        If IDTestataTemp <> 0 Then

            stbQ.Append(" inner Join __tmp_FiltroImpianti f ")
            stbQ.Append(" On  Reg_Impianti.PIVA = f.piva  ")
            stbQ.Append(" And Reg_Impianti.SA_COD = f.sa_cod ")
            stbQ.Append(" And Reg_Impianti.APPEZZA = f.appezza ")
            stbQ.Append(" And Reg_Impianti.ID_REG = f.id_reg ")
