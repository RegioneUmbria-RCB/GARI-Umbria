    '  Galassi, 06/10/2016 16:18:44: PER PROV. AUT. DI TRENTO APOT
    '
    '  Fa lo stesso lavoro delle pratiche ecologiche ma ha audit_tipo = 9 (non sono esattamente uguali i cicli)
    '
    Private Sub CaricaDsFormazione(ByVal RegolamentoCod As Integer, ByVal disp As Integer)

        Dim dr As DS_Formazione.DT_FormazioneRow

        Dim DLL_Sezioni As New AgronicaCoreAuditDAL.Audit_Sezioni_R

        Dim DLL_codici As New AgronicaCoreAuditDAL.Audit_Codici_R




        Dim Audit_Data_Inizio As Date = AGRODATAINIZIO
        Dim Audit_Data_Fine As String = AGRODATAFINE
        Dim Audit_Cod As Integer = 0

        'Dim DT_Disp As DataTable
        Dim DT_Sezioni As DataTable
        Dim DT_Codici As DataTable

        Dim FiltroParte As Integer
        Dim bAggiungiSezione As Boolean

        Dim strErr As String = String.Empty


        Dim sw As Stopwatch = StartWatch("CaricaDsFormazione")

        Dim Elenco_Audit As DataTable = New AgronicaCoreAuditDAL.Audit_R().Leggi(0, enum_AuditTipi.AuditTipi_Formazione, RegolamentoCod, Piva, AGRODATAINIZIO, AGRODATAFINE, "", "Audit_cod desc", objParametri_Server)
        If Not Elenco_Audit Is Nothing AndAlso Elenco_Audit.Rows.Count > 0 Then
            For Each audit As DataRow In Elenco_Audit.Rows
                Audit_Cod = audit.Item("Audit_Cod")
                DT_Sezioni = Nothing
                DT_Sezioni = DLL_Sezioni.Leggi(enum_AuditTipi.AuditTipi_Formazione, CInt(RegolamentoCod), 0, 0, #1/1/1900#, strErr, "", "", objParametri_Server)

                ' ciclo sulle sezioni ordinate per Ordine
                For i = 0 To DT_Sezioni.Rows.Count - 1

                    bAggiungiSezione = True
                    DT_Codici = Nothing
                    DT_Codici = DLL_codici.Leggi(enum_AuditTipi.AuditTipi_Formazione, CInt(RegolamentoCod), CInt(disp), CInt(DT_Sezioni.Rows(i).Item("Sezione_Cod")), FiltroParte, strErr, "", "", objParametri_Server, CInt(Audit_Cod), , , ,
                                                         , , Audit_Data_Inizio, Audit_Data_Fine)

                    Dim Riga As HtmlTableRow
                    Dim Cella As HtmlTableCell
                    Dim Cella_dx As HtmlTableCell

                    ' creo la riga della formazione
                    dr = DSFormazione.DT_Formazione.NewDT_FormazioneRow

                    'ciclo sui codici per creare i controlli
                    For j = 0 To DT_Codici.Rows.Count - 1


                        If DT_Codici.Rows(j).Item("Nota") = 0 Then



                            Select Case DT_Codici.Rows(j).Item("Tipo")

                                Case "d" ' DAta formazione

                                    If Not IsDBNull(DT_Codici.Rows(j).Item("Valore")) Then
                                        dr.Data = CDate(DT_Codici.Rows(j).Item("Valore"))
                                    Else
                                        dr.Data = "nessuna data"
                                    End If



                                Case "n" 'Argomento formazione

                                    If Not IsDBNull(DT_Codici.Rows(j).Item("Valore")) Then
                                        dr.Argomento = DT_Codici.Rows(j).Item("Valore").ToString

                                    Else
                                        dr.Argomento = "non definito"
                                    End If

                                Case "s" 'Partecipanti

                                    If Not IsDBNull(DT_Codici.Rows(j).Item("Valore")) Then

                                        dr.Partecipante = DT_Codici.Rows(j).Item("Valore").ToString

                                    End If


                                Case Else

                            End Select

                        Else

                        End If

                    Next    ' ciclo su DT_Codici

                    DSFormazione.DT_Formazione.AddDT_FormazioneRow(dr)

                    DT_Codici.Dispose()
                    DT_Codici = Nothing

                Next        ' ciclo su DT_Sezioni

                DT_Sezioni.Dispose()
                DT_Sezioni = Nothing
            Next
        End If

        EndWatch(sw, "CaricaDsFormazione")

    End Sub

