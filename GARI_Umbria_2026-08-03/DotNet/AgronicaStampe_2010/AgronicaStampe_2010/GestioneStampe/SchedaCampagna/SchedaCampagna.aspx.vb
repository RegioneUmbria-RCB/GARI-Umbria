    'carico il dataset x le visite
    Private Sub CaricaDsVisite_OLD(ByVal Flag_Multicentro As Boolean, ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna)

        Dim objSql As New AgronicaCoreDataProvider.DataProvider
        Dim strErr, strErr1 As String
        Dim stbQ As New System.Text.StringBuilder
        Dim stbQDettagli As New System.Text.StringBuilder

        Dim i, j As Integer

        Dim Dt_Dettagli As New DataTable
        Dim Dr_Dettagli() As DataRow
        Dim strDettagli As String

        Dim Num_Appezzamento As Double

        stbQ.Append(" SELECT DISTINCT Agenda.Piva , Agenda.Sa_Cod, Agenda.Id_Agenda, " &
                        " Agenda.Lav_Cod , Agenda.Des_Lib AS Lav_Des, " &
                        " CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) As Data_Movimento, Movimenti.Mov_Desc as Note, " &
                        " Movimenti.Cod_RisUm, CASE Contatti.Id_CF WHEN 0 THEN ISNULL(Contatti.Cognome,'') + ' ' + ISNULL(Contatti.Nome,'') ELSE ISNULL(Contatti.Rag_Soc,'') END AS Tecnico " &
                        " FROM Contatti INNER JOIN Risorse_Umane ON Contatti.Cod_Contatto = Risorse_Umane.Cod_Contatto RIGHT OUTER JOIN Movimenti INNER JOIN " &
                        " Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND Movimenti.Id_Agenda = Agenda.Id_Agenda ON Risorse_Umane.Cod_RisUm = Movimenti.Cod_RisUm " &
                        " WHERE Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' " &
                        " AND Agenda.Lav_Cod IN (" & LAVCOD_VISITA_GENERICA.ToString & "," & LAVCOD_MONITORAGGIO_TEMPI_RIENTRO.ToString & ")")

        'If Sa_Cod <> "0" Then
        If Not Flag_Multicentro Then
            stbQ.Append(" AND (Agenda.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " OR Agenda.Sa_Cod = -1) ")
        End If

        'se ho scelto una data unica per la stampa..
        If Qs_DataStampa <> "" Then

            stbQ.Append(" AND Movimenti.Data_Movimento = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")

        Else

            stbQ.Append(" AND Movimenti.Data_Movimento <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stbQ.Append(" AND Movimenti.Data_Movimento >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")

        End If

        stbQ.Append(" ORDER BY  Data_Movimento ")

        ''eseguo la query e controllo gli errori
        'objSql.SqlSelect(Session("ASG_Pathfilei..."), Session("ASG_Connessione_Server"), stbQ.ToString, DSVisite, _
        '                 DSVisite.DS_Note.TableName, strErr)

        strErr = Nothing
        Try
            objSql.EseguiQuery_Lettura(objParametri_Server, stbQ.ToString, "CaricaDsVisite", DSVisite, DSVisite._DS_Note.TableName)
        Catch ex As Exception
            strErr = ex.Message
        End Try

        stbQDettagli.Append(" SELECT DISTINCT Agenda.Piva, Agenda.Sa_Cod, Agenda.Id_Agenda, Agenda.Lav_Cod, CAST(Movimenti.Data_Movimento AS DATETIME) + CAST(TRY_CAST(Movimenti.Ora AS TIME) AS DATETIME) AS Data_Movimento, " &
                            "                 Mov_Destinazioni.Piva AS Piva_App, Mov_Destinazioni.Sa_Cod AS Sa_Cod_App, " &
                            "                 Mov_Destinazioni.Appezza, Mov_Destinazioni.Id_Destinazione, Mov_Destinazioni.Qta, Appezzamento.APP_NOME, Reg_Impianti.Validita_Inizio, Reg_Impianti.Validita_Fine, " &
                            " ISNULL((SELECT TOP 1 Appezzamento_Codici.val_cod FROM Appezzamento_Codici  " &
                            "       where (Appezzamento_Codici.PIVA = Appezzamento.PIVA) " &
                            "       and (Appezzamento_Codici.sa_cod = Appezzamento.sa_cod) " &
                            "       and (Appezzamento_Codici.appezza = Appezzamento.appezza) " &
                            "       and (Appezzamento_Codici.id_cod = 1104) ), '') AS App_Nome_Breve " &
                            " FROM         Movimenti_dettagli INNER JOIN " &
                            "              Movimenti INNER JOIN " &
                            "              Agenda ON Movimenti.PIVA = Agenda.PIVA AND Movimenti.Sa_Cod = Agenda.Sa_Cod AND Movimenti.Id_Agenda = Agenda.Id_Agenda ON  " &
                            "              Movimenti_dettagli.PIVA = Movimenti.PIVA AND Movimenti_dettagli.Sa_Cod = Movimenti.Sa_Cod AND  " &
                            "              Movimenti_dettagli.Id_Agenda = Movimenti.Id_Agenda AND Movimenti_dettagli.Id_Mov = Movimenti.Id_Mov INNER JOIN " &
                            "              Mov_Destinazioni ON Movimenti_dettagli.Id_Mov_Det = Mov_Destinazioni.Id_Mov_Det AND  " &
                            "              Movimenti_dettagli.Id_Mov = Mov_Destinazioni.Id_Mov AND Movimenti_dettagli.Id_Agenda = Mov_Destinazioni.Id_Agenda AND  " &
                            "              Movimenti_dettagli.Sa_Cod = Mov_Destinazioni.Sa_Cod AND Movimenti_dettagli.PIVA = Mov_Destinazioni.Piva INNER JOIN " &
                            "              Reg_Impianti ON Mov_Destinazioni.Piva = Reg_Impianti.PIVA AND Mov_Destinazioni.Sa_Cod = Reg_Impianti.SA_COD AND  " &
                            "              Mov_Destinazioni.Appezza = Reg_Impianti.APPEZZA AND Mov_Destinazioni.Id_Destinazione = Reg_Impianti.ID_REG INNER JOIN " &
                            "              Appezzamento ON Reg_Impianti.PIVA = Appezzamento.PIVA AND Reg_Impianti.SA_COD = Appezzamento.SA_COD AND  " &
                            "              Reg_Impianti.APPEZZA = Appezzamento.APPEZZA ")

        If IDTestataTemp <> 0 Then

            stbQDettagli.Append("              inner Join __tmp_FiltroImpianti f ")
            stbQDettagli.Append("              On  Reg_Impianti.PIVA = f.piva  ")
            stbQDettagli.Append("              And Reg_Impianti.SA_COD = f.sa_cod ")
            stbQDettagli.Append("              And Reg_Impianti.APPEZZA = f.appezza ")
            stbQDettagli.Append("              And Reg_Impianti.ID_REG = f.id_reg ")
            stbQDettagli.Append("                    And f.idTestataTemp = " & IDTestataTemp)
            stbQDettagli.Append("                    And f.Validita_Inizio <= " & Agro_SQL_SaveDate(Validita_Fine__tmp_FiltroImpianti) & " ")
            stbQDettagli.Append("                    And f.Validita_Fine >= " & Agro_SQL_SaveDate(Validita_Inizio__tmp_FiltroImpianti) & " ")

        End If

        stbQDettagli.Append(" WHERE Agenda.Piva = '" & Agro_SQL_SaveText(Piva) & "' " &
                            " AND Agenda.Lav_Cod = " & Agro_SQL_SaveNum(LAVCOD_MONITORAGGIO_TEMPI_RIENTRO.ToString))

        If Sa_Cod <> "0" Then
            stbQDettagli.Append(" AND (Agenda.Sa_Cod = " & Agro_SQL_SaveNum(Sa_Cod) & " OR Agenda.Sa_Cod = -1) ")
        End If

        'stbQDettagli.Append(strFiltroImpianti)

        'se ho scelto una data unica per la stampa..
        If Qs_DataStampa <> "" Then

            stbQDettagli.Append(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            stbQDettagli.Append(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")
            stbQDettagli.Append(" AND Movimenti.Data_Movimento = " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " ")

        Else

            stbQDettagli.Append(" AND Reg_Impianti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stbQDettagli.Append(" AND Reg_Impianti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")
            stbQDettagli.Append(" AND Movimenti.Data_Movimento <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " ")
            stbQDettagli.Append(" AND Movimenti.Data_Movimento >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " ")

        End If

        stbQDettagli.Append(" ORDER BY Agenda.Id_Agenda, Agenda.Piva ")

        '  Dt_Dettagli = objSql.SqlSelect(Session("ASG_Pathfilei..."), Session("ASG_Connessione_Server"), stbQDettagli.ToString, 1, strErr1)

        strErr1 = Nothing
        Try
            Dt_Dettagli = objSql.EseguiQuery_Lettura(objParametri_Server, stbQDettagli.ToString, "CaricaDsVisite")
        Catch ex As Exception
            strErr1 = ex.Message
        End Try


        'controllo errori 
        If Not IsNothing(strErr) Then

            'eccezzione......
            Throw New Exception(strErr)

        Else ' se non ci sono errori

            For i = 0 To DSVisite._DS_Note.Rows.Count - 1

                '--------------------------------
                'DATA
                If CDate(DSVisite._DS_Note.Rows(i).Item("Data_Movimento")).ToShortDateString = "01/01/1900" Then
                    DSVisite._DS_Note.Rows(i).Item("Data_Movimento") = ""
                Else
                    DSVisite._DS_Note.Rows(i).Item("Data_Movimento") = Formatta_Data_Movimento(DSVisite._DS_Note.Rows(i).Item("Data_Movimento"))
                End If

                '--------------------------------
                'NOTE
                If DSVisite._DS_Note.Rows(i).Item("Note") <> "" Then
                    DSVisite._DS_Note.Rows(i).Item("Note") = DSVisite._DS_Note.Rows(i).Item("Lav_Des") & " - NOTA: " & DSVisite._DS_Note.Rows(i).Item("Note")
                Else
                    DSVisite._DS_Note.Rows(i).Item("Note") = DSVisite._DS_Note.Rows(i).Item("Lav_Des")
                End If

                Select Case DSVisite._DS_Note.Rows(i).Item("Lav_Cod")

                    Case LAVCOD_MONITORAGGIO_TEMPI_RIENTRO

                        Dr_Dettagli = Dt_Dettagli.Select("id_agenda=" & DSVisite._DS_Note.Rows(i).Item("id_agenda"))

                        strDettagli = ""

                        If Not Dr_Dettagli Is Nothing AndAlso Dr_Dettagli.Length > 0 Then

                            For j = 0 To Dr_Dettagli.Length - 1

                                Dr_Dettagli(j).Item("App_Nome_Breve") = CodiceAppezzamento(Dr_Dettagli(j).Item("Piva"),
                                                                                           Dr_Dettagli(j).Item("Sa_Cod"),
                                                                                           Dr_Dettagli(j).Item("Campo_Nome"),
                                                                                           Dr_Dettagli(j).Item("Appezza"),
                                                                                           TipoCodAppezzamento,
                                                                                           Dr_Dettagli(j).Item("App_Nome"),
                                                                                           Dr_Dettagli(j).Item("App_Nome_Breve"), -1)

                                ''''--------------------------------
                                ''''NOME APPEZZAMENTO
                                ''''controllo su appezza..
                                ''''se il nome dell'appezzamento contiene un numero indico questo
                                ''''altrimenti lascio appezza-basecode
                                '''Dim objNum As New AgronicaCoreDataProvider.UtilityProvider
                                '''Num_Appezzamento = objNum.Numero_from_Stringa(Dr_Dettagli(j).Item("app_nome"))

                                ''''Num_Appezzamento = AppezzamentoNumero_from_AppezzamentoNome(Server, Session, Page, Dr_Dettagli(j).Item("app_nome"))

                                '''If Num_Appezzamento <> 0 Then
                                '''    Dr_Dettagli(j).Item("app_nome") = CStr(Num_Appezzamento)
                                '''Else
                                '''    Dr_Dettagli(j).Item("app_nome") = Dr_Dettagli(j).Item("appezza") - BaseCode
                                '''    'se è un valore alto lo tronco alle ultime 3 cifre..
                                '''    If CStr(Dr_Dettagli(j).Item("app_nome")).Length > 3 Then
                                '''        Dr_Dettagli(j).Item("app_nome") = Right(CStr(Dr_Dettagli(j).Item("app_nome")), 3)
                                '''    End If
                                '''End If

                                '''If Dr_Dettagli(j).Item("App_Nome_Breve") = "" Then
                                '''    Dr_Dettagli(j).Item("App_Nome_Breve") = CStr(Dr_Dettagli(j).Item("app_nome"))
                                '''End If

                                '----------------------------------------------
                                'per id consociazione
                                Try

                                    Dim objImp As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
                                    Dim ID_Consociazione As Integer
                                    Dim Tot_Consociati As Integer
                                    Dim Sigla_Consociazione As String
                                    If ControllaProgressivoConsociazione(Dr_Dettagli(j).Item("Piva"),
                                                                                           Dr_Dettagli(j).Item("Sa_Cod"),
                                                                                           Dr_Dettagli(j).Item("APPEZZA"), Dr_Dettagli(j).Item("ID_REG"), ID_Consociazione, Tot_Consociati, Sigla_Consociazione, objParametri_Server) Then
                                        Dr_Dettagli(j).Item("App_Nome_Breve") &= "/" & Sigla_Consociazione & ""
                                        'Dr_Dettagli(j).Item("App_Nome_Breve") &= "/" & ID_Consociazione & ""
                                    End If

                                Catch ex As Exception

                                End Try

                                '----------------------------------------------


                                Select Case Dr_Dettagli(j).Item("Qta")
                                    Case -1
                                        strDettagli &= "App." & Dr_Dettagli(j).Item("App_Nome_Breve") & " ---> Tempo di Rientro NON RISPETTATO," & vbCrLf
                                    Case 1
                                        strDettagli &= "App." & Dr_Dettagli(j).Item("App_Nome_Breve") & " ---> Tempo di Rientro RISPETTATO," & vbCrLf
                                End Select

                            Next

                        End If

                        DSVisite._DS_Note.Rows(i).Item("Note") &= vbCrLf & strDettagli

                End Select

            Next

        End If

    End Sub

    Private Sub CaricaDsControlliInterventi(ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna,
                                            ByVal Flag_Multispecie As Boolean, ByVal Flag_Multicentro As Boolean,
                                            ByVal Flag_Nasc_Fitoreg As Boolean,
                                            ByVal HTIDAgendaDaControllare As Hashtable)

        Dim i, j, v As Integer

        Dim strRisultatoVerifica As String
        Dim Id_Agenda As Integer
        Dim objDpi As New AgronicaCoreDpiBIZ.DPI_Verifica

        Dim DT_InterventoVericato As New DataTable
        Dim DT_RisultatiVerifiche As New DataTable

        Dim Biologico As Boolean
        Dim Dpi_Cod As Integer


        Dim sw As Stopwatch = StartWatch("CaricaDsControlliInterventi")

        For Each Key In HTIDAgendaDaControllare.Keys

            Id_Agenda = Key
            'HTIDAgendaDaControllare.Item(Key)

            If DT_InterventoVericato.Columns.Count = 0 Then
                objDpi.Crea_DT_InterventoVerificato(DT_InterventoVericato)
                objDpi.Crea_DT_RisultatiVerifiche(DT_RisultatiVerifiche)
            End If

            Dim objDpiVerifica As New AgronicaCoreDpiBIZ.DPI_Verifica
            Dim rval As New rispostaStandard(Of AgronicaCoreDpiBIZ.Verifica_Disciplinare_Intervento)
            rval = objDpiVerifica.Verifica_Conformita_Intervento_New(objParametri_Server, objParametri_Utenti,
                                                                                                 Piva,
                                                                                                 "", Id_Agenda,
                                                                                                 Id_Agenda,
                                                                                                 True,
                                                                                                    enum_Disciplinare_Operazione.QuelloDellOperazione, 0,
                                                                                                            "", 0, 0, 0)

            If rval.RispostaOK = True Then
                If rval.RispostaStringa.Risultato <> "" Then
                    objDpi.Analizza_RisultatoVerifica(rval.RispostaStringa.Risultato, True, Nothing,
                                                  DT_InterventoVericato, DT_RisultatiVerifiche, 0, False, objParametri_Utenti)
                End If

            Else
                Throw New Exception(rval.Errore)
            End If

            'strRisultatoVerifica = objDpi.Verifica_Intervento_Da_IDAgenda(Piva, Id_Agenda, Dpi_Cod, Biologico, objParametri_Server, objParametri_Utenti)

            'If strRisultatoVerifica <> "-1" And strRisultatoVerifica <> "0" And strRisultatoVerifica <> "" Then
            '    objDpi.Analizza_RisultatoVerifica(strRisultatoVerifica, DT_InterventoVericato, DT_RisultatiVerifiche, Dpi_Cod, Biologico)
            'End If

        Next

        Dim DrOp() As DataRow
        Dim DrCntr() As DataRow

        Dim RigaDs As DS_ControlloConformita_Interventi.DT_ControlloConformita_InterventiRow

        Dim Lav_Cod As Integer
        Dim Lav_Des As String
        Dim Des_Lib As String

        Dim Reg_Verificato As String
        Dim Disciplinare_Cod As Integer
        Dim Disciplinare_Des As String
        Dim RegBio As String

        Dim InserisciControllo As Boolean

        Dim objOperazione As New AgronicaCoreMetaSchemaDAL.Operazioni_R

        For i = 0 To DT_InterventoVericato.Rows.Count - 1

            Id_Agenda = DT_InterventoVericato.Rows(i).Item("id_agenda")

            Lav_Cod = DT_InterventoVericato.Rows(i).Item("Lav_Cod")
            Lav_Des = objOperazione.LavDes_from_LavCod(Lav_Cod, objParametri_Server)

            Disciplinare_Cod = DT_InterventoVericato.Rows(i).Item("Disciplinare_Cod")
            Disciplinare_Des = DT_InterventoVericato.Rows(i).Item("Disciplinare_Des")

            If Disciplinare_Des = "" Then
                Disciplinare_Des = "Nessuno"
            End If

            RegBio = DT_InterventoVericato.Rows(i).Item("Biologico")
            If LCase(RegBio) = "true" Then
                Disciplinare_Des = "Biologico"
            End If

            Reg_Verificato = "Disciplinare Applicato: " & Disciplinare_Des

            Des_Lib = DT_InterventoVericato.Rows(i).Item("data_movimento") & " - " & Lav_Des & " - " & Reg_Verificato

            DrOp = DT_InterventoVericato.Select("id_agenda=" & Id_Agenda.ToString)

            DrCntr = DT_RisultatiVerifiche.Select("id_agenda=" & Id_Agenda.ToString)

            If Not DrOp Is Nothing AndAlso DrOp.Length > 0 Then

                For j = 0 To DrOp.Length - 1

                    For v = 0 To DrCntr.Length - 1

                        InserisciControllo = False

                        Select Case Lav_Cod

                            Case LAVCOD_TRATTAMENTO_ANTIPARASSITARIO,
                                            LAVCOD_TRATTAMENTO_FITOREGOLATORE,
                                            LAVCOD_CONCIA_SEME,
                                            LAVCOD_GEODISINFESTAZIONE,
                                            LAVCOD_DISERBO, LAVCOD_DISSECCAMENTO

                                Select Case DrCntr(v).Item("err_code")

                                    'controlli etichetta
                                    Case 0,
                                        enTipoErrCode_Verifica.DoseNonDisponibile,
                                        enTipoErrCode_Verifica.ProdottoNonGiustificatoSuAvversita,
                                        enTipoErrCode_Verifica.Epoca_Etichetta,
                                        enTipoErrCode_Verifica.DoseEccessiva,
                                        enTipoErrCode_Verifica.AcquaNonCorretta,
                                        enTipoErrCode_Verifica.UnitaMisuraNonCompatibile,
                                        enTipoErrCode_Verifica.CarenzaNonRispettata,
                                        enTipoErrCode_Verifica.SuperatoNumMaxInterventiProdotto,
                                        enTipoErrCode_Verifica.IntervalloInterventiNonRispettato,
                                        enTipoErrCode_Verifica.BufferZoneNonRispettata
                                        InserisciControllo = True

                                        'controlli dpi
                                    Case enTipoErrCode_Verifica.AvversitaNonGiustificataDPI,
                                        enTipoErrCode_Verifica.ImpiantiNonCoerentiDPI,
                                        enTipoErrCode_Verifica.SuperatoNumMaxInterventiPA,
                                        enTipoErrCode_Verifica.IncompatibilitaTraSostanze,
                                        enTipoErrCode_Verifica.SogliaNonRegistrata,
                                        enTipoErrCode_Verifica.DataInterventoMin,
                                        enTipoErrCode_Verifica.DataInterventoMax,
                                        enTipoErrCode_Verifica.SuperatoVolumeMaxAcquaDpi

                                        Select Case Disciplinare_Cod
                                            Case Is > 0
                                                InserisciControllo = True
                                        End Select

                                        'controlli diserbo
                                    Case enTipoErrCode_Verifica.DoseDiserboEccessiva,
                                         enTipoErrCode_Verifica.DoseEccessivaSADpi_Anno

                                        Select Case Disciplinare_Cod
                                            Case Is > 0
                                                Select Case Lav_Cod
                                                    Case LAVCOD_DISERBO, LAVCOD_DISSECCAMENTO
                                                        InserisciControllo = True
                                                End Select
                                        End Select


                                    Case enTipoErrCode_Verifica.DoseEccessivaRame

                                        'x DPI + BIO
                                        Select Case Disciplinare_Cod
                                            Case Is > 0
                                                Select Case Lav_Cod
                                                    Case LAVCOD_TRATTAMENTO_ANTIPARASSITARIO,
                                                        LAVCOD_TRATTAMENTO_FITOREGOLATORE,
                                                        LAVCOD_CONCIA_SEME,
                                                        LAVCOD_GEODISINFESTAZIONE
                                                        InserisciControllo = True
                                                End Select
                                            Case Else
                                                Select Case LCase(RegBio)
                                                    Case "true"
                                                        Select Case Lav_Cod
                                                            Case LAVCOD_TRATTAMENTO_ANTIPARASSITARIO,
                                                                LAVCOD_TRATTAMENTO_FITOREGOLATORE,
                                                                LAVCOD_CONCIA_SEME,
                                                                LAVCOD_GEODISINFESTAZIONE
                                                                InserisciControllo = True
                                                        End Select
                                                End Select

                                        End Select

                                    Case enTipoErrCode_Verifica.DoseEccessivaRame5Anni,
                                        enTipoErrCode_Verifica.ProdottoNonBiologico

                                        Select Case LCase(RegBio)
                                            Case "true"
                                                Select Case Lav_Cod
                                                    Case LAVCOD_TRATTAMENTO_ANTIPARASSITARIO,
                                                        LAVCOD_TRATTAMENTO_FITOREGOLATORE,
                                                        LAVCOD_CONCIA_SEME,
                                                        LAVCOD_GEODISINFESTAZIONE
                                                        InserisciControllo = True
                                                End Select
                                        End Select

                                    Case enTipoErrCode_Verifica.InterventoNonConsentito

                                        Select Case LCase(RegBio)
                                            Case "true"
                                                Select Case Lav_Cod
                                                    Case LAVCOD_DISERBO,
                                                        LAVCOD_DISSECCAMENTO
                                                        InserisciControllo = True
                                                End Select
                                        End Select
                                End Select


                            Case LAVCOD_TRATTAMENTO_ANTIBUTTERATURA, LAVCOD_CONCIMAZIONE_FOGLIARE,
                                 LAVCOD_DISTRIBUZIONE_AMMENDANTI, LAVCOD_DISTRIBUZIONE_CONCIME,
                                 LAVCOD_FERTIRRIGAZIONE, LAVCOD_SARCHIATURA_CONCIMAZIONE
                                '106 TRATTAMENTO ANTIBUTTERATURA, 123 CONCIMAZIONE FOGLIARE,
                                '124 DISTRIBUZIONE AMMENDANTI ORGANICI, 14 DISTRIBUZIONE CONCIME IN PIENO CAMPO,
                                '26 FERTIRRIGAZIONE, 156 SARCHIATURA

                                Select Case DrCntr(v).Item("err_code")

                                    Case enTipoErrCode_Verifica.Superato_N_Max,
                                        enTipoErrCode_Verifica.Superato_P_Max,
                                        enTipoErrCode_Verifica.Superato_K_Max,
                                        enTipoErrCode_Verifica.Superato_M_Max
                                        InserisciControllo = True

                                    Case enTipoErrCode_Verifica.Superato_N_Max_Intervento
                                        Select Case Disciplinare_Cod
                                            Case Is > 0
                                                InserisciControllo = True
                                        End Select

                                    Case enTipoErrCode_Verifica.ProdottoNonBiologico
                                        If LCase(RegBio) = "true" Then
                                            InserisciControllo = True
                                        End If

                                    Case enTipoErrCode_Verifica.DoseEccessivaRame
                                        If LCase(RegBio) = "true" Or Disciplinare_Cod > 0 Then
                                            InserisciControllo = True
                                        End If

                                End Select

                            Case LAVCOD_RACCOLTA

                                Select Case DrCntr(v).Item("err_code")
                                    Case enTipoErrCode_Verifica.CarenzaNonRispettata
                                        InserisciControllo = True
                                End Select

                        End Select

                        If InserisciControllo = True Then

                            RigaDs = DSControlliConformitaInterventi.DT_ControlloConformita_Interventi.NewDT_ControlloConformita_InterventiRow

                            RigaDs.ID_Agenda = Id_Agenda
                            RigaDs.Lav_Cod = Lav_Cod
                            RigaDs.Des_Lib = Des_Lib

                            RigaDs.ID_Controllo = DrCntr(v).Item("err_code")
                            RigaDs.Controllo_Des = DrCntr(v).Item("err_des")

                            If DrCntr(v).Item("pro_des") <> "" Then
                                RigaDs.Dettaglio_NON_Conformita = DrCntr(v).Item("pro_des") & ":" & DrCntr(v).Item("err_nota")
                            Else
                                RigaDs.Dettaglio_NON_Conformita = DrCntr(v).Item("err_nota")
                            End If



                            Select Case DrCntr(v).Item("BooleanRisVer")
                                Case "true"
                                    RigaDs.Conforme_SI = "X"
                                Case "false"
                                    RigaDs.Conforme_NO = "X"
                            End Select

                            DSControlliConformitaInterventi.DT_ControlloConformita_Interventi.Rows.Add(RigaDs)

                        End If


                    Next

                Next

            End If

        Next

        EndWatch(sw, "CaricaDsControlliInterventi")


    End Sub

