    '#########################################################################################
    Private Function AGEA_Ricava_OccupazioneDes(ByVal DT_AGEA_byQuintuplaAgea As DataTable, ByVal DT_AGEA_bycodiciGias As DataTable,
                                           ByVal sa_cod As Integer, ByVal Appezza As Integer, ByVal Id_Reg As Integer,
                                           ByRef HT_OccupazioneDes As Hashtable) As String

        Dim Occupazione_Des As String = ""

        Try

            Dim flag_ricercaXcodiciGias As Boolean = False

            Dim chiave_Impianto As String = sa_cod & "|" & Appezza & "|" & Id_Reg

            If Not HT_OccupazioneDes.ContainsKey(chiave_Impianto) Then

                If Not IsNothing(DT_AGEA_byQuintuplaAgea) AndAlso DT_AGEA_byQuintuplaAgea.Rows.Count > 0 Then
                    'RICERCA SULLA QUINTUPLA AGEA

                    Dim dr() As DataRow

                    dr = DT_AGEA_byQuintuplaAgea.Select(" Sa_Cod = " & Agro_SQL_SaveNum(sa_cod) & " AND appezza = " & Agro_SQL_SaveNum(Appezza) & " AND id_reg = " & Agro_SQL_SaveNum(Id_Reg))

                    If Not IsNothing(dr) AndAlso dr.Length > 0 Then
                        Occupazione_Des = dr(0).Item("Occupazione_Des")
                        HT_OccupazioneDes.Add(chiave_Impianto, Occupazione_Des)
                    Else
                        flag_ricercaXcodiciGias = True
                    End If

                Else
                    flag_ricercaXcodiciGias = True
                End If

                If flag_ricercaXcodiciGias = True AndAlso Not IsNothing(DT_AGEA_bycodiciGias) AndAlso DT_AGEA_bycodiciGias.Rows.Count > 0 Then
                    'RICERCA SUI CODICI GIAS
                    Dim dr() As DataRow

                    dr = DT_AGEA_bycodiciGias.Select(" Sa_Cod = " & Agro_SQL_SaveNum(sa_cod) & " AND appezza = " & Agro_SQL_SaveNum(Appezza) & " AND id_reg = " & Agro_SQL_SaveNum(Id_Reg))

                    If Not IsNothing(dr) AndAlso dr.Length > 0 Then
                        Occupazione_Des = dr(0).Item("Occupazione_Des")
                        HT_OccupazioneDes.Add(chiave_Impianto, Occupazione_Des)
                    End If

                End If

            Else
                Occupazione_Des = HT_OccupazioneDes(chiave_Impianto)
            End If 'ht impianti

        Catch ex As Exception
            Log_Errori &= "AGEA_Ricava_OccupazioneDes: " & vbCrLf & ex.Message & vbCrLf
            'Throw New Exception(Log_Errori)
        End Try

        Return Occupazione_Des

    End Function



    '#########################################################################################
    'utilizzata nel registro trattamenti veneto, nel quaderno di campagna lombardia veneto
    'e nel registro aziendale unico
    Private Sub CaricaDsImpianti_Multispecie(ByRef strQueryErbacee As String, ByVal Flag_RegTrattamentiVeneto As Boolean,
                                             ByVal TipoCodAppezzamento As enum_TipoCodiceAppezzamento_SchedaCampagna,
                                             ByVal LogoCliente() As Byte, ByVal LogoRegione() As Byte,
                                             ByRef HT_OccupazioneDes As Hashtable)

        'la query serve x gestire i report CRErbacee, CRArboree e l'intestazione
        ' -> l'intestazione non più, ora anche il report uso non agricolo

        Dim Imprese_Read As New AgronicaCoreAnagrafeDAL.Imprese_Read
        Dim Reg_Impianti_Codici_R As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Codici_R
        Dim ImpCodici As New AgronicaCoreAnagrafeDAL.Imprese_Codici_Read

        DsUsoNonAgricolo = New DS_UsoNonAgricolo
        DsArboree = New DS_Arboree
        DsErbacee = New DS_Erbacee

        'prendo il il nome del db contenente le tabelle di meta schema 
        Dim stbQuery As New System.Text.StringBuilder
        Dim stbQueryRappresentante As New System.Text.StringBuilder
        Dim stbQueryColture As New System.Text.StringBuilder

        Dim objSql As New AgronicaCoreDataProvider.DataProvider

        Dim strErr As String
        Dim Messaggio As String
        Dim Rs As DataTable
        Dim SuperUser As String
        Dim OP, Piva_OP As String
        Dim DataInizioImpianto As String = ""

        Dim DtImpianti As DataTable


        Dim sw As Stopwatch = StartWatch("CaricaDsImpianti_Multispecie")


        Try

            CUAA = ImpCodici.Leggi_CUAA(Piva, objParametri_Server)


            'query x reperire i dati....... 
            stbQuery.Append(" SELECT DISTINCT '' AS Cooperativa, '' AS Piva_Cooperativa, Appezzamento.PIVA,  " & vbCrLf)
            stbQuery.Append(" CASE WHEN ISNULL(Imprese.partitaIvaReale, '') = '' THEN Appezzamento.PIVA ELSE Imprese.partitaIvaReale END AS PivaReale, " & vbCrLf)
            stbQuery.Append(" Imprese.rag_soc, Centri_Aziendali.sa_nome, Centri_Aziendali.sa_cod, " & vbCrLf)

            'modifica del 06/08/2014: per l'umbria, che ha il numero di afscicolo nell'app_nome, andava in overflow
            '-> necessario convert a float
            'stbQuery.Append(" Appezzamento.Campo_Cod AS N_Campo,  ")
            stbQuery.Append(" CONVERT(float, Appezzamento.Campo_Cod) AS N_Campo,  " & vbCrLf)
            stbQuery.Append(" Reg_Impianti.APPEZZA, Appezzamento.App_Nome, Reg_Impianti.ID_REG, " & vbCrLf)
            stbQuery.Append(" (Reg_Impianti.ID_REG - " & BaseCode.ToString & ") AS N_idreg,  " & vbCrLf)

            'modifica del 06/08/2014: per l'umbria, che ha il numero di afscicolo nell'app_nome, andava in overflow
            '-> necessario convert a float
            ' stbQuery.Append(" (Reg_Impianti.APPEZZA - " & BaseCode.ToString & ") AS N_appezza, ")
            stbQuery.Append(" CONVERT(float, (Reg_Impianti.APPEZZA - " & BaseCode.ToString & ")) AS N_appezza, " & vbCrLf)
            stbQuery.Append(" Reg_Impianti.Validita_Inizio AS Data_InizioImpianto, " & vbCrLf)

            'Controllo se devo stampare la superficie dell'impianto o dell'appezzamento
            If strTipoSuperficie = "i" Then
                stbQuery.Append(" Reg_Impianti.sup_imp AS SUP_APP, " & vbCrLf)
            Else
                stbQuery.Append(" Appezzamento.Sup_App, " & vbCrLf)
            End If

            stbQuery.Append(" Reg_Impianti.Sup_Imp, " & vbCrLf)

            stbQuery.Append("ISNULL (SpecieVegetali.VEG_COD, 0) AS VEG_COD,  ISNULL (SpecieVegetali.Gru_Cod, 0) AS Gru_Cod, " & vbCrLf)
            'stbQuery.Append(" ISNULL(Cultivar.CUL_DES,'Terreno Nudo') AS CUL_DES, " & vbCrLf)

            '(04/12/2019 fede) aggiunta gestione lingua
            'stbQuery.Append(" ISNULL(Cultivar.CUL_DES,'') AS CUL_DES, " & vbCrLf)
            stbQuery.Append(" ISNULL(coalesce(Cultivar_XLingue.Cul_Des,Cultivar.Cul_Des),'') AS Cul_Des,  " & vbCrLf)


            stbQuery.Append(" Cultivar.CUL_COD, " & vbCrLf)

            '26/11/2018 introdotta lettura destinazione d'uso in query invece che lettura separata dopo (serve la dest uso per l'eventuale ordinamento per coltura)
            'stbQuery.Append(" ISNULL(SpecieVegetali.VEG_DES, '') AS VEG_DES, ")
            stbQuery.Append(" case when reg_impianti.cul_cod = 0 then " & vbCrLf)
            stbQuery.Append("           ( ISNULL( (SELECT TOP 1 descrizione " & vbCrLf)
            stbQuery.Append("                       FROM Reg_Impianti_Codici RIC " & vbCrLf)
            stbQuery.Append("                       INNER JOIN Codici_Anagrafe Cod ON  RIC.id_cod= Cod.codice " & vbCrLf)
            stbQuery.Append("                       where progetto_cod=0 " & vbCrLf)
            stbQuery.Append("                       and id_cod >= 3000 and id_cod < 4000 " & vbCrLf)
            stbQuery.Append("                       and piva=Reg_Impianti.piva and sa_cod=Reg_Impianti.sa_cod " & vbCrLf)
            stbQuery.Append("                       and appezza= Reg_Impianti.appezza and id_reg=Reg_Impianti.id_reg " & vbCrLf)
            stbQuery.Append("                       ), 'Terreno nudo')  )" & vbCrLf)
            stbQuery.Append(" else  ( " & vbCrLf)
            stbQuery.Append("       veg_des  " & vbCrLf)
            stbQuery.Append("       )  " & vbCrLf)
            stbQuery.Append("  end AS veg_des, " & vbCrLf)

            stbQuery.Append(" ISNULL(Reg_Impianti.GRVA_Cod_VEG,0) AS Grva_Cod, ISNULL(GruppoVarietale.Grva_Des,'') AS Grva_Des, " & vbCrLf)

            stbQuery.Append(" ISNULL(Portinnesti.PORT_DES,'') AS PORT_DES, ISNULL(FormeAllevamento.FORAL_DES,'') AS FORAL_DES, " & vbCrLf)

            'PIANTE
            stbQuery.Append("(ISNULL((SELECT TOP 1 Imprese_Progetti.p_ha FROM Imprese_Progetti " & vbCrLf)
            stbQuery.Append("        WHERE Reg_Impianti.Piva = Imprese_Progetti.PIVA " & vbCrLf)
            stbQuery.Append("	     AND Reg_Impianti.sa_cod = Imprese_Progetti.sa_cod " & vbCrLf)
            stbQuery.Append("	     AND Reg_Impianti.appezza = Imprese_Progetti.APPEZZA " & vbCrLf)
            stbQuery.Append("	     AND Reg_Impianti.id_reg = Imprese_Progetti.ID_REG " & vbCrLf)

            'se ho scelto una data unica per la stampa..
            If Qs_DataStampa <> "" Then
                stbQuery.Append(" AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
                stbQuery.Append(" AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataStampa)) & " " & vbCrLf)
            Else
                stbQuery.Append(" AND Imprese_Progetti.Validita_Inizio <= " & Agro_SQL_SaveDate(CDate(Qs_DataFine)) & " " & vbCrLf)
                stbQuery.Append(" AND Imprese_Progetti.Validita_Fine >= " & Agro_SQL_SaveDate(CDate(Qs_DataInizio)) & " " & vbCrLf)
            End If
            stbQuery.Append("), 0)  * Reg_Impianti.Sup_Imp) AS Nr_Piante, " & vbCrLf)


            'corretto bug in data 8/11/2010: con sql2008 viene letto il primo campo avente lo stesso nome e nn l'ultimo
            'perciò nel nome del responsabile aziendale, anzichè finirci il nome di contatti ci finiva nome di persone
            'stbQuery.Append(" Persone.Cognome, Persone.Nome,  Indirizzi.ind_des, ")
            stbQuery.Append(" Indirizzi.ind_des, " & vbCrLf)
            stbQuery.Append(" Indirizzi.frz_des, ISNULL(ISTAT.CAP, '') AS CAP, ISNULL(ISTAT.LOCALITA, '') AS com_des, ISNULL(ISTAT.COMUNI_PROV, '') AS pro_cod, " & vbCrLf)
            stbQuery.Append(" Appezzamento.X, Appezzamento.Y,  " & vbCrLf)

            '(10/01/2019 fede) aggiunta buffer
            stbQuery.Append("     ISNULL(Appezzamento.DistBZ_CorpiIdrici,0) AS DistBZ_CorpiIdrici, " + vbCrLf)
            stbQuery.Append("     ISNULL(Appezzamento.DistBZ_AreeResPub,0) AS DistBZ_AreeResPub,  " + vbCrLf)
            stbQuery.Append("     ISNULL(Appezzamento.DistBZ_Allevamenti,0) AS DistBZ_Allevamenti, " + vbCrLf)
            stbQuery.Append("     ISNULL(Appezzamento.DistBZ_VegNatNonColt,0) AS DistBZ_VegNatNonColt,  " + vbCrLf)
            stbQuery.Append("     ISNULL(Appezzamento.SupBZ_Riduzione,0) AS SupBZ_Riduzione, " + vbCrLf)

            'telefono centro
            stbQuery.Append(" ISNULL((SELECT     TOP 1 Rubrica.numero " & vbCrLf)
            stbQuery.Append(" FROM          CentrixRubrica INNER JOIN " & vbCrLf)
