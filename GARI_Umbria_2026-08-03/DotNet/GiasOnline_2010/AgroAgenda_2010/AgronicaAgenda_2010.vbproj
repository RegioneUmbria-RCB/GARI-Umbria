  <ItemGroup />
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">10.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.VisualBasic.targets" />
  <Import Project="$(VSToolsPath)\WebApplications\Microsoft.WebApplication.targets" Condition="'$(VSToolsPath)' != ''" />
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v10.0\WebApplications\Microsoft.WebApplication.targets" Condition="false" />
  <ProjectExtensions>
    <VisualStudio>
      <FlavorProperties GUID="{349c5851-65df-11da-9384-00065b846f21}">
        <WebProjectProperties>
          <SaveServerSettingsInUserFile>True</SaveServerSettingsInUserFile>
        </WebProjectProperties>
      </FlavorProperties>
    </VisualStudio>
  </ProjectExtensions>
  <Target Name="BeforeBuild">
    <!-- <Message Text="+++++ OUT_DIR = $(OutDir) +++++" Importance="High" /> -->
    <!-- <Message Text="+++++ OUT_PATH = $(OutputPath) +++++" Importance="High" /> -->
    <!-- Copia il file di configurazione (perchè l'originale è bloccato in quanto archiviato) -->
    <Message Text="+++++ Copio Min_Config.xml +++++" Importance="High" />
    <Message Text="+++++ --&gt; Directory = $(WebProjectOutputDir) +++++" Importance="High" />
    <Copy SourceFiles="Classi\Minify\Min_Config.xml" DestinationFiles="$(WebProjectOutputDir)\Classi\Minify\Min_Config_pers.xml" OverwriteReadOnlyFiles="false" />
    <!-- <TransformXml Source="web.base.config" Transform="Web.$(Configuration).config" Destination="web.config" /> -->
  </Target>
  <!-- <UsingTask TaskName="MinifyWebAssets" AssemblyFile="$(OutDir)AgroAgenda_2010.dll" /> -->
  <!-- <Target Name="CustomMinAfterBuild" AfterTargets="Build" DependsOnTargets="$(BuildDependsOn)"> -->
  <!-- <Message Text="+++++ Eseguo Minificazione +++++" Importance="High" /> -->
  <!-- <Message Text="+++++ &gt; Directory = $(WebProjectOutputDir) +++++" Importance="High" /> -->
  <!-- <MinifyWebAssets ContinueOnError="ErrorAndStop" WebDir="$(WebProjectOutputDir)" /> -->
  <!-- </Target> -->
  <Target Name="CustomMinAfterBuild" AfterTargets="Build" DependsOnTargets="$(BuildDependsOn)">
    <!-- Eseguo il task minificazione in processo MSBuild separato per evitare che al termine tenga lockata la dll principale -->
    <Exec Command="&quot;$(MSBuildBinPath)\MSBuild.exe&quot; &quot;$(MSBuildProjectDirectory)\AfterBuild.msbuild&quot; /property:WebDir=$(WebProjectOutputDir) /property:OutDirCallingProject=$(OutDir)" />
    <!-- Imposta il tipo di Build eseguita nella configurazione per la gestione dei file minified (lo faccio dopo per evitare che venga valorizzato anche quando fallisce la compilazione e i file non vengono minificati) -->
    <Message Text="+++++ Imposto $(Configuration) in Min_Config_pers.xml +++++" Importance="High" />
    <XmlPoke XmlInputPath="$(WebProjectOutputDir)\Classi\Minify\Min_Config_pers.xml" Value="$(Configuration)" Query="/MinConfig/Target" />
  </Target>
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>Questo progetto fa riferimento a uno o più pacchetti NuGet che non sono presenti in questo computer. Usare lo strumento di ripristino dei pacchetti NuGet per scaricarli. Per altre informazioni, vedere http://go.microsoft.com/fwlink/?LinkID=322105. Il file mancante è {0}.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('..\packages\EntityFramework.6.4.4\build\EntityFramework.props')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\EntityFramework.6.4.4\build\EntityFramework.props'))" />
    <Error Condition="!Exists('..\packages\EntityFramework.6.4.4\build\EntityFramework.targets')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\EntityFramework.6.4.4\build\EntityFramework.targets'))" />
    <Error Condition="!Exists('..\packages\AgGatewayADAPTFramework.3.0.0\build\AgGatewayADAPTFramework.targets')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\AgGatewayADAPTFramework.3.0.0\build\AgGatewayADAPTFramework.targets'))" />
  </Target>
  <Import Project="..\packages\EntityFramework.6.4.4\build\EntityFramework.targets" Condition="Exists('..\packages\EntityFramework.6.4.4\build\EntityFramework.targets')" />
  <Import Project="..\packages\AgGatewayADAPTFramework.3.0.0\build\AgGatewayADAPTFramework.targets" Condition="Exists('..\packages\AgGatewayADAPTFramework.3.0.0\build\AgGatewayADAPTFramework.targets')" />
  <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="AfterBuild">
