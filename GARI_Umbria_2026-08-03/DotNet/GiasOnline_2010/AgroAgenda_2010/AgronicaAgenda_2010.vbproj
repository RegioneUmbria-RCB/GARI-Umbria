    <!-- SonarQube Exclusion  -->
    <SonarQubeSetting Include="sonar.exclusions">
      <Value>Gis/Gis_Scripts/**,Scripts/additional-methods.js,Scripts/jMsAjax.js,Scripts/jquery.jstree.js,Scripts/jquery.watable_modificato.js,Scripts/plugins/jqplot*.js,Scripts/plugins/jquery.jqplot.js</Value>
