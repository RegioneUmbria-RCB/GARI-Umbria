    Public Shared Function GiasPalmDettagli(ByVal piva As String, ByVal sa_cod As String, ByVal id As String) As RispostaStandard
        Dim r As New RispostaStandard

        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            r.Sessione = False
            Return r
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Try

            'Inserire il codice QUI..
            Dim objgis As New AgronicaCoreGisDAL.GIS_Entita_R
            Dim dt As DataTable = objgis.GiasPalmDettagli(piva, sa_cod, id, objParametri_Server)

            Dim rval As String = " { ""giaspalm_dettagli"": { ""Area"": " &
                    Math.Round(CDec(dt(0)("Area")) / 10000, 4).ToString.Replace(",", ".") & ", ""Perimetro"": " &
                    Math.Round(CDec(dt(0)("Perimetro")), 6).ToString.Replace(",", ".") & ", ""punti_dettagli"": ["
            Dim lRval As New List(Of String)

            Dim Primo As Boolean = True
            For Each dtR As DataRow In dt.Rows
                If dtR("dettagli").ToString.StartsWith("{") Then
                    lRval.Add(dtR("dettagli").ToString.Replace("""quota", """pdop"":" & dtR("pdop").ToString.Replace(",", ".") & ", ""quota"))
                Else
                    If Not Primo Then

                        lRval.Add("{" &
                                  " ""FixQuality"": """", " &
                                  " ""FixAlg"": """", " &
                                  " ""lat"": " & dtR("lat").ToString.Replace(",", ".") & ", " &
                                  " ""lng"": " & dtR("lon").ToString.Replace(",", ".") & ", " &
                                  " ""quota"": " & Math.Round(dtR("quota"), 0).ToString.Replace(",", ".") & ", " &
                                  " ""pdop"": " & dtR("pdop").ToString.Replace(",", ".") &
                                  " } ")

                    End If
                    Primo = False

                End If
            Next

            rval &= String.Join(",", lRval.ToArray)

            rval &= "]}}"

            r.RispostaOK = True
            r.RispostaStringa = rval

        Catch ex As Exception

            r.RispostaOK = False

            'uso questa funzione per ottenere il Messaggio..:
            r.Errore = "Errore durante l'operazione: " & vbCrLf &
                AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)


        End Try

        Return r
    End Function

