    Public Shared Function pfRateo(ByVal ChiaveAlbero As String, DescrizioneDelPiano As String, ByVal cellsize As String, ByVal DataRiferimentoPerLetturaDatiSentinel As String, oCfgLetturaPF As AgronicaCoreModello.PrecisionModel_CFGLetturaDati) As RispostaStandard

        Dim objParametri_Server As New AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")

        Dim rval As New RispostaStandard
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            rval.RispostaOK = False
            rval.Sessione = False
            rval.RispostaStringa = "SessioneScaduta"
            Return rval
        End If

        Lingua.Gias_InizializzaCultura_DaSession()


        Dim objParametri_Utenti As New AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Utenti = HttpContext.Current.Session("ASG_objParametri_Utenti")

        Dim passwordSuperUser As String =
            HttpContext.Current.Session("ASG_SuperUser_Password")

        Dim AgroPF As New AgronicaPrecisionFarming.PianoConcimazioneRateoVariabile

        'Valorizzo il Codice_Fiscale_Tecnico prendendolo dalla tabella Gruppi_Utente
        Dim Codice_Fiscale_Tecnico As String = ""
        Dim xUtenteCorrente As String = CType(objParametri_Server, AgronicaCoreDataProvider.AgronicaCoreParametri).UtenteUsername
        Dim objUtentiDAL As New AgronicaCoreUtentiDAL.Utenti_xGruppi_Utente_R
        Codice_Fiscale_Tecnico = objUtentiDAL.Leggi_IdentificativoGruppoUtenti_Singolo(xUtenteCorrente, objParametri_Utenti)


        Try

            rval = AgroPF.CalcolaPianoConcimazioneRateoVariabileLocal(
                       DescrizioneDelPiano, DataRiferimentoPerLetturaDatiSentinel, ChiaveAlbero, cellsize, Codice_Fiscale_Tecnico, passwordSuperUser, oCfgLetturaPF, objParametri_Server, objParametri_Utenti
                    )
        Catch ex As Exception

            rval.RispostaOK = False
            rval.Errore = Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)

        End Try


        Return rval

    End Function




    Private Shared Function PopolaDatiSpecieRecuperaFiltro(ByVal lista_cul_cod As String) As String
        Dim rval As String = "("


        For Each sListaCulCod In lista_cul_cod.Split(",")

            If sListaCulCod <> "-1" Then
                Dim appListaCulCod As String() = sListaCulCod.Split("_")
                rval &= "(ii.Cul_COD = " & appListaCulCod(0) &
                    " AND ii.validita_inizio = " & Agro_SQL_SaveDate(appListaCulCod(1)) &
                    " AND ii.validita_fine = " & Agro_SQL_SaveDate(appListaCulCod(2)) & ") OR "
            End If


        Next

        Return rval.Substring(0, rval.Length - 3) & ")"


    End Function


    Public Shared Function PopolaDatiSpecie(ByVal ChiaveAlbero As String, ByVal lista_cul_cod As String, ByVal ckRibaltaGrafica As String) As String

        Dim objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")

        Lingua.Gias_InizializzaCultura_DaSession()


        Dim sCurImp As String() = ChiaveAlbero.Split(SeparatoreAlberoJson)
        Dim Piva As String = sCurImp(1)
        Dim Sa_Cod As Integer = sCurImp(2)
        Dim campo_cod As Integer = sCurImp(3)
        Dim datariferimento As Date = Now.Date
        Dim xFiltroAggiuntivo As String = ""

        If lista_cul_cod <> "" Then
            xFiltroAggiuntivo = PopolaDatiSpecieRecuperaFiltro(lista_cul_cod)

            If CBool(ckRibaltaGrafica) Then

                Dim xRibalta As New AgronicaCoreGisDAL.GIS_Entita_W
                xRibalta.RibaltaGraficaAppezzaImpianto(
                    "",
                    Piva,
                    Sa_Cod,
                    campo_cod,
                    "",
                    xFiltroAggiuntivo,
                    objParametri_Server
                )

            End If

            lista_cul_cod = ""
        End If

        Dim dtSpecie As DataTable
        Dim dtLeggiSpecieDatoCampo As New AgronicaCoreAnagrafeDAL.Campi_R
        dtSpecie = dtLeggiSpecieDatoCampo.LeggiColtureDatoCampo(
            Piva,
            Sa_Cod,
            campo_cod,
            lista_cul_cod,
            datariferimento,
            AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
            xFiltroAggiuntivo,
            "",
            objParametri_Server
        )

        Dim rval As String = ""

        If xFiltroAggiuntivo = "" Then

            rval = "<table id=""tblCultivarXRicette"">"
            For Each drVarieta In dtSpecie.Rows
                Dim sValiditaFine As String = ""
                If Not (CDate(drVarieta("validita_fine")) = AGRODATAFINE Or CDate(drVarieta("validita_fine")) = #1/1/2100#) Then
                    sValiditaFine = " - " & drVarieta("validita_fine")
                End If
                rval &= "<tr><td><input type=""checkbox"" id=""ckSp_" & drVarieta("cul_cod") & "_" & drVarieta("validita_inizio") & "_" & drVarieta("validita_fine") & """ /></td><td>" & " " & drVarieta("veg_des") & " - " & drVarieta("cul_des") & " - " & drVarieta("validita_inizio") & sValiditaFine & "</td></tr>"

            Next

            rval &= "</table>"
        Else


            For Each drImpianto In dtSpecie.Rows

                Dim appezza As Integer = drImpianto("Appezza")
                Dim id_imp As Integer = drImpianto("id_reg")

                Dim tmpChiave As String = ""
                Dim lTipoNodo As enum_TipoNodo = enum_TipoNodo.Impianto_Generico

                If Not (drImpianto("gru_cod") Is DBNull.Value) Then
                    Select Case drImpianto("gru_cod")
                        Case 1
                            lTipoNodo = enum_TipoNodo.ImpiantoArborea
                        Case 2
                            lTipoNodo = enum_TipoNodo.ImpiantoErbacea
                        Case 3
                            lTipoNodo = enum_TipoNodo.ImpiantoOrticola
                    End Select
                End If


                AgronicaCoreDataProvider.Albero.ChiaveAlbero_Codifica_x_json(
                        tmpChiave,
                        TipoNodo:=lTipoNodo,
                        Piva:=Piva,
                        Sa_Cod:=Sa_Cod,
                        Campo_Cod:=campo_cod,
                        Appezza:=appezza,
                        Id_Imp:=id_imp
                    )
                rval &= tmpChiave & "|"
            Next
            rval = rval.TrimEnd("|")
        End If

        Return rval

    End Function

    Private Shared Function NodoValidoPerNuovaRicetta(ByVal sCurImp As String()) As Boolean
        Dim isValid As Boolean = False

        If sCurImp.Length = 1 Then
            Return False
        End If

        If sCurImp(5) <> 0 Then
            isValid = True
        End If

        If sCurImp(0) = 51 Then
            isValid = True
        End If

        Return isValid

    End Function
    Private Shared Function Gestione_Ricetta_GeneraXMl(ByRef ObjParametri_Server As AgronicaCoreParametri, ByVal XmlDoc As System.Xml.XmlDocument, ByRef Xml_Risultato As System.Xml.XmlElement, ByRef StrNodiVariabili As String, ByRef StrNodo As String, ByRef Piva As String, ByRef Num_Checked As Integer, ByVal ListOFobjImpianto As List(Of Impianto), ByRef rag_soc As String, ByRef sa_nome As String, ByRef FlagAssegnataPiva As Boolean, ByVal programmazione_testata As Integer) As Integer

        'si possono selezionare soltanto specie o destinazioni d'uso omogenee
        Dim Veg_Cod As Integer
        Dim DestinazioneUsoPiuVegCod As String = "-1"
        Dim DestinazioneUsoPiuVegCod_PrecXTest As String = "-1"

        For Each objImpianto As Impianto In ListOFobjImpianto



            Dim leggiDati As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
            Dim dtLeggiDescrizioni As DataTable =
                leggiDati.Leggi_DescrizioniImpianti2(
                objImpianto.Piva,
                objImpianto.Sa_Cod,
                objImpianto.Appezza,
                objImpianto.ID_Reg,
                AGRODATAINIZIO,
                AGRODATAFINE,
                "",
                "",
                ObjParametri_Server
            )

            Dim dtLeggiDati As DataTable =
                leggiDati.Leggi(
                objImpianto.Piva,
                objImpianto.Sa_Cod,
                objImpianto.Appezza,
                objImpianto.ID_Reg,
                enumSelezioneVariabile.Selezione_TabellaCompleta,
                "",
                "",
                ObjParametri_Server
            )


            Dim leggiVegCodDatoImpianto As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
            objImpianto.Veg_Cod = leggiVegCodDatoImpianto.VegCod_from_PivaSaCodAppezzaIdimp(
                objImpianto.Piva,
                objImpianto.Sa_Cod,
                objImpianto.Appezza,
                objImpianto.ID_Reg,
                "",
                "",
                ObjParametri_Server
            )

            DestinazioneUsoPiuVegCod = leggiVegCodDatoImpianto.Codice_Anagrafe_from_PivaSaCodAppezzaIdImp(
                objImpianto.Piva,
                objImpianto.Sa_Cod,
                objImpianto.Appezza,
                objImpianto.ID_Reg,
                ObjParametri_Server
            )

            DestinazioneUsoPiuVegCod = objImpianto.Veg_Cod & "|" & DestinazioneUsoPiuVegCod

            If DestinazioneUsoPiuVegCod_PrecXTest <> "-1" AndAlso DestinazioneUsoPiuVegCod <> DestinazioneUsoPiuVegCod_PrecXTest Then
                Throw New Exception(My.Resources.AgronicaControlliGIS.V_M_Gestione_Ricetta_GeneraXMl_Impianti_di_specie_non_omogenee)
            End If
            DestinazioneUsoPiuVegCod_PrecXTest = DestinazioneUsoPiuVegCod

            If Not FlagAssegnataPiva Then

                Piva = objImpianto.Piva


                Dim ragsocFrompiva As New AgronicaCoreAnagrafeDAL.Imprese_Read
                Dim saNomeFromPivaSaCod As New AgronicaCoreAnagrafeDAL.CentriAziendali_Read

                rag_soc = ragsocFrompiva.RagSoc_from_Piva(objImpianto.Piva, ObjParametri_Server)
                sa_nome = saNomeFromPivaSaCod.SaNome_from_SaCod(objImpianto.Piva, objImpianto.Sa_Cod, ObjParametri_Server)
                FlagAssegnataPiva = True

            End If



            If (objImpianto.Veg_Cod <> 0) Then

                Xml_Risultato = XmlDoc.CreateElement("Risultato")

                Xml_Risultato.SetAttribute("piva", objImpianto.Piva)
                Xml_Risultato.SetAttribute("rag_soc", rag_soc)
                Xml_Risultato.SetAttribute("sa_cod", objImpianto.Sa_Cod)
                Xml_Risultato.SetAttribute("sa_nome", sa_nome)

                Xml_Risultato.SetAttribute("campo_cod", objImpianto.Campo_Cod)


                Xml_Risultato.SetAttribute("appezza", objImpianto.Appezza)
                Xml_Risultato.SetAttribute("app_nome", objImpianto.App_Nome)
                Xml_Risultato.SetAttribute("id_reg", objImpianto.ID_Reg)

                Xml_Risultato.SetAttribute("programmazione_testata", programmazione_testata)
                Xml_Risultato.SetAttribute("programmazione_entita_cod", objImpianto.Programmazione_Entita_cod)

                Xml_Risultato.SetAttribute("veg_cod", objImpianto.Veg_Cod)
                Xml_Risultato.SetAttribute("cul_cod", objImpianto.Cul_Cod)

                Veg_Cod = objImpianto.Veg_Cod



                Xml_Risultato.SetAttribute("descrizione", dtLeggiDescrizioni.Rows(0)("Campo_des") & " - " & dtLeggiDescrizioni.Rows(0)("App_nome"))
                Xml_Risultato.SetAttribute("sup_imp", dtLeggiDescrizioni.Rows(0)("sup_imp"))

                Xml_Risultato.SetAttribute("grfi_cod", dtLeggiDati.Rows(0)("grfi_cod"))
                Xml_Risultato.SetAttribute("finanziamento", dtLeggiDati.Rows(0)("finanziamento"))
                Xml_Risultato.SetAttribute("regolamento", dtLeggiDati.Rows(0)("regolamento"))

                Dim cop_cod As String = "0"
                If Not IsDBNull(dtLeggiDati.Rows(0)("cop_cod")) Then
                    cop_cod = dtLeggiDati.Rows(0)("cop_cod")
                End If

                Xml_Risultato.SetAttribute("cop_cod", cop_cod)


                Xml_Risultato.SetAttribute("validita_inizio", AGRODATAINIZIO)
                Xml_Risultato.SetAttribute("validita_fine", AGRODATAFINE)

                StrNodo = Xml_Risultato.OuterXml

                Num_Checked += 1

                'Inserisco l'XML nella stringa complessiva
                StrNodiVariabili = StrNodiVariabili & StrNodo

            End If
        Next
        Return Veg_Cod
    End Function

    Private Shared Function Gestione_RicettaAgendaxml(ByVal ChiaveAlbero As String, ByVal ObjParametri_Server As AgronicaCoreParametri, ByRef StrVariabiliFiltro As String, ByRef Veg_Cod As Integer, ByRef Programmazione_Cod As Integer, ByRef Piva As String, ByRef listaOfImpianti As List(Of Impianto), ByRef shouldReturn As Boolean, Optional ByVal id_agenda As Integer = 0) As Object
        shouldReturn = False
        Dim objCentriAz As New AgronicaCoreAnagrafeDAL.CentriAziendali_Read

        Dim Destinazione As String


        Dim XmlDoc As New System.Xml.XmlDocument
        Dim Xml_FiltroRisultati As System.Xml.XmlElement
        Dim Xml_Risultato As System.Xml.XmlElement

        StrVariabiliFiltro = ""
        Dim StrNodiVariabili As String = ""
        Dim StrNodo As String = ""

        Piva = ""

        Dim programmazione_testata As Integer = 0
        Dim PrimaVolta As Boolean = True
        Dim Selezionato As Boolean

        Dim Progetto_Nome As String
        Dim Progetto_Cod As Integer

        'utilizzata solo per controllare di selezionare almeno una riga
        Dim Num_Checked As Integer = 0


        Dim Dt_Impianto As String() = ChiaveAlbero.Split("|")

        'Cerco gli impianti selezionati

        Dim objImpianto As Impianto

        listaOfImpianti = New List(Of Impianto)


        Dim rag_soc As String
        Dim sa_nome As String


        Dim flagAssegnataPiva As Boolean = False




        For Each CurImp As String In Dt_Impianto

            Dim sCurImp As String() = CurImp.Split(SeparatoreAlberoJson)

            Dim sCurVegcod As Integer = 0

            If id_agenda = 0 And Not NodoValidoPerNuovaRicetta(sCurImp) Then
                shouldReturn = True : Return My.Resources.AgronicaControlliGIS.V_M_Gestione_RicettaAgendaxml_Selezionare_impianto_o_pianificazione_o_campo
            End If

            'è un planning    
            If sCurImp(0) = 51 Then


                Albero.ChiaveAlbero_Decodifica_PlanningTestata_x_json(CurImp, "", "", 0, programmazione_testata)

                Dim LeggiEntita As New AgronicaCoreAnagrafeDAL.Programmazione_Entita_R
                Dim dtLeggiEntita As DataTable =
                LeggiEntita.Leggi(
                    programmazione_testata,
                    0,
                    "",
                    sCurImp(1),
                    sCurImp(2),
                    0,
                    0,
                    0,
                    0,
                    AGRODATAINIZIO,
                    AGRODATAFINE,
                    "",
                    "",
                    "",
                    ObjParametri_Server
                )

                'Riciclo il campo codice_Fiscale_tecnico per salvare il dato "programmazione entita"
                For Each drLeggiEntita As DataRow In dtLeggiEntita.Rows
                    listaOfImpianti.Add(
                        New Impianto With {
                            .Piva = sCurImp(1),
                            .Sa_Cod = sCurImp(2),
                            .Appezza = drLeggiEntita("appezza"),
                            .ID_Reg = drLeggiEntita("id_reg"),
                            .Programmazione_Entita_cod = drLeggiEntita("programmazione_entita_cod"),
                            .Campo_Cod = 0
                        })

                Next


            Else

                objImpianto = New Impianto With {
                    .Piva = sCurImp(1),
                    .Sa_Cod = sCurImp(2),
                    .Campo_Cod = sCurImp(3),
                    .Appezza = sCurImp(4),
                    .ID_Reg = sCurImp(5),
                    .Programmazione_Entita_cod = 0
                }
                listaOfImpianti.Add(objImpianto)

            End If




            Veg_Cod = Gestione_Ricetta_GeneraXMl(ObjParametri_Server, XmlDoc, Xml_Risultato, StrNodiVariabili, StrNodo, Piva, Num_Checked, listaOfImpianti, rag_soc, sa_nome, flagAssegnataPiva, programmazione_testata)


        Next

        Programmazione_Cod = programmazione_testata

        'Creo il nodo "FiltroRisultati"
        Xml_FiltroRisultati = XmlDoc.CreateElement("FiltroRisultati")

        'Rendo l'albero figlio del documento
        If id_agenda = 0 Then
            XmlDoc.AppendChild(Xml_FiltroRisultati)
        End If


        'Inserisco gli elementi "VariabiliStampe" come figli del nodo "FiltroStampa"
        Xml_FiltroRisultati.InnerXml = StrNodiVariabili

        'Estraggo la stringa XML complessiva
        StrVariabiliFiltro = XmlDoc.InnerXml
        Return Nothing
    End Function

