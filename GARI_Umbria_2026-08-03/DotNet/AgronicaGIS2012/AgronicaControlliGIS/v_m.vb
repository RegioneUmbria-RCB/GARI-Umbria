    Public Shared Sub LeggiInfoBioConversione(ByRef objParametri_server As AgronicaCoreParametri, ByRef sBioConversione As String, appezza1 As Integer, sa_Cod1 As Integer, piva1 As String, ByVal programmazione_entita_cod As Integer)


        Dim dtBioConversione As DataTable = Nothing
        If programmazione_entita_cod <> 0 Then
            Dim leggiCodiciAnag As New AgronicaCoreAnagrafeDAL.Programmazione_Entita_Codici_R
            dtBioConversione =
                leggiCodiciAnag.Leggi(programmazione_entita_cod, 1018, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_server)
        Else
            If appezza1 <> 0 Then
                Dim leggiCodiciAnag As New AgronicaCoreAnagrafeDAL.Appezzamento_Codici_R
                dtBioConversione =
                leggiCodiciAnag.Leggi(piva1, sa_Cod1, appezza1, 1018, sBioConversione, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_server)
            End If

        End If


        If Not dtBioConversione Is Nothing AndAlso dtBioConversione.Rows.Count = 1 Then

            sBioConversione = dtBioConversione(0)("val_Cod")
            Select Case sBioConversione
                Case enum_MetodoProduzione.Biologico
                    sBioConversione = " [" & My.Resources.AgronicaControlliGIS.Biologico & "] "
                Case enum_MetodoProduzione.Integrato
                    sBioConversione = " [" & My.Resources.AgronicaControlliGIS.Integrato & "] "
                Case enum_MetodoProduzione.InConversione
                    sBioConversione = " [" & My.Resources.AgronicaControlliGIS.InConversione & "] "
            End Select
        End If


    End Sub

