    Public Shared Function VerificaEsistenzaEntitaPerImpianti(
            ByVal InData As VerificaEsistenzaEntitaPerImpianti_In,
            ByRef objParametri_Server As AgronicaCoreParametri
        ) As rispostaStandard(Of VerificaEsistenzaEntitaPerImpianti_Out)

        Dim r As New rispostaStandard(Of VerificaEsistenzaEntitaPerImpianti_Out)

        r.RispostaStringa = New VerificaEsistenzaEntitaPerImpianti_Out()

        r.RispostaStringa.NumeroEntita = 0

        r.RispostaStringa.ElencoEntitaImpianti = New List(Of DatiEntitaImpianto)

        Try

            Dim objGisEntitaLeggi = New AgronicaCoreGisDAL.GIS_Entita_R

            Dim vegCod = 0
            Dim destinazioneUso = 0

            If Not IsNothing(InData.UtilizzoTerreno) Then
                Select Case InData.UtilizzoTerreno.GetType()
                    Case GetType(AgronicaCoreModelsSTD.metaschema.utilizzi.Varieta)
                        vegCod = CType(InData.UtilizzoTerreno, AgronicaCoreModelsSTD.metaschema.utilizzi.Varieta).specie.codice
                        destinazioneUso = 0
                    Case Else
                        vegCod = 0
                        destinazioneUso = InData.UtilizzoTerreno.codice
                End Select
            End If

            Dim dtEntitaImpianti = objGisEntitaLeggi.LeggiEntitaImpianti(
                    InData.Piva,
                    InData.SaCod,
                    InData.CampoCod,
                    InData.ValiditaInizio,
                    InData.ValiditaFine,
                    vegCod,
                    destinazioneUso,
                    objParametri_Server)

            If Not IsNothing(dtEntitaImpianti) AndAlso dtEntitaImpianti.Rows.Count > 0 Then

                r.RispostaStringa.NumeroEntita = dtEntitaImpianti.Rows.Count

                For Each rigaEntita In dtEntitaImpianti.Rows
                    Dim nuovaRiga = New DatiEntitaImpianto()
                    nuovaRiga.EntitaCod = rigaEntita("Entita_Cod")
                    nuovaRiga.Piva = rigaEntita("Piva")
                    nuovaRiga.SaCod = rigaEntita("Sa_Cod")
                    nuovaRiga.Appezza = rigaEntita("Appezza")
                    nuovaRiga.IdReg = rigaEntita("Id_Imp")
                    r.RispostaStringa.ElencoEntitaImpianti.Add(nuovaRiga)
                Next

            End If

            r.RispostaOK = True

        Catch ex As Exception

            r.RispostaOK = False
            r.Errore = ex.Message

        Finally

        End Try

        Return r

    End Function

    Public Shared Function AggiornaFiltroImpianti(
            ByVal InData As AggiornaFiltroImpianti_In,
            ByRef objParametri_Server As AgronicaCoreParametri
        ) As rispostaStandard(Of AggiornaFiltroImpianti_Out)

        Dim r As New rispostaStandard(Of AggiornaFiltroImpianti_Out)

        r.RispostaStringa = New AggiornaFiltroImpianti_Out()

        r.RispostaStringa.IdTestata = 0

        r.RispostaStringa.ImpostaVisibilitaTotale = False

        Dim IDTestataTemp = 0

        Dim ImpostaVisibilitaTotale = False

        Dim TotaleElementiGraficiImpianto = 0

        Try

            If InData.IdTestata = 0 Then

                Dim Impianti = New List(Of Impianto)

                For Each impiantoIn In InData.Impianti

                    Dim objImpianto = New Impianto With {
                        .Piva = impiantoIn.Piva,
                        .Sa_Cod = impiantoIn.Sa_Cod,
                        .Appezza = impiantoIn.Appezza,
                        .ID_Reg = impiantoIn.Id_Reg,
                        .Progetto_Cod = impiantoIn.Progetto_Cod,
                        .Veg_Cod = impiantoIn.Veg_Cod
                    }

                    Impianti.Add(objImpianto)

                Next

                Dim xAgrosequenze As New Agro_Sequenze

                'IDTestataTemp = xAgrosequenze.Agronica_SequenzaTabelle_NuovoID("IDTestataTemp", objParametri_Server)
                'Lavez - 12/07/2024 - normalizzazione chiamate a stack counter
                IDTestataTemp = xAgrosequenze.NuovoId_Tabella("IDTestataTemp", 0, AgronicaCoreDataProvider.CostantiPersonalizzate.UpperBoundTabelle_Per_SequenzaTabelle_Topcode, objParametri_Server)

                Dim OperazioneCorrente_FiltroImpianti As String = ""

                OperazioneCorrente_EstraiFiltrone(IDTestataTemp,
                                                  Impianti,
                                                  OperazioneCorrente_FiltroImpianti,
                                                  objParametri_Server)

                PopolaTabellaFiltroImpianti(OperazioneCorrente_FiltroImpianti, objParametri_Server)

                Dim listaImpiantiTMP = (From ii In Impianti Select ii.Piva).Distinct.ToList

                If listaImpiantiTMP.Count > 1 Then
                    ImpostaVisibilitaTotale = True
                End If

            Else

                IDTestataTemp = InData.IdTestata

                Dim leggiFiltroImpianti As New AgronicaCoreVarieDAL.__tmp_FiltroImpianti_R

                Dim dtImpianti = leggiFiltroImpianti.ConteggioRecordDistinctPivaDaIDTestataTemp(IDTestataTemp, objParametri_Server)

                Dim conteggioRecordTmp As Integer = dtImpianti.Rows.Count

                If conteggioRecordTmp > 1 Then
                    ImpostaVisibilitaTotale = True
                End If

            End If

            Dim objGisElemGraficiLeggi As New AgronicaCoreGisDAL.GIS_ElementiGrafici_R

            Dim dtElemGraficiImpianti = objGisElemGraficiLeggi.Leggi(objParametri_Server.PivaSuperUser,
                                                                     0,
                                                                     0,
                                                                     enum_Gis_LayerElementiGrafici_std.IMPIANTI,
                                                                     enumFromatoCartograficoConvertito.Nessuna_Conversione,
                                                                     enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                     "",
                                                                     "",
                                                                     objParametri_Server,
                                                                     0,
                                                                     "ElementoGrafico_Cod")


            If Not IsNothing(dtElemGraficiImpianti) Then
                TotaleElementiGraficiImpianto = dtElemGraficiImpianti.Rows.Count
            End If

            r.RispostaStringa.IdTestata = IDTestataTemp

            r.RispostaStringa.ImpostaVisibilitaTotale = ImpostaVisibilitaTotale

            r.RispostaStringa.TotaleElementiGraficiImpianto = TotaleElementiGraficiImpianto

            r.RispostaOK = True

        Catch ex As Exception

            r.RispostaOK = False
            r.Errore = ex.Message

        Finally

        End Try

        Return r

    End Function

    Public Shared Sub OperazioneCorrente_EstraiFiltrone(ByVal IDTestataTemp As Integer,
                                                        ByVal Impianti As List(Of Impianto),
                                                        ByRef OperazioneCorrente_FiltroImpianti As String,
                                                        Optional ByVal objParametri As AgronicaCoreParametri = Nothing)

        Dim listImp As New List(Of String)

        OperazioneCorrente_EstraiDAL_FiltroImpianti(IDTestataTemp, Impianti, listImp, objParametri)

        OperazioneCorrente_FiltroImpianti = String.Join("|", listImp.ToArray)

    End Sub

    Public Shared Sub OperazioneCorrente_EstraiDAL_FiltroImpianti(IDTestataTemp As Integer,
                                                                  ByVal dest As List(Of OperazioneAgenda_Temp.Movimento_Destinazione),
                                                                  ByRef listImp As List(Of String))

        Dim xDestImp As List(Of Impianto) = (
            From i1 In dest
            Select New Impianto With {
                .Piva = i1.Piva,
                .Sa_Cod = i1.Sa_Cod,
                .Appezza = i1.Appezza,
                .ID_Reg = i1.Id_Destinazione
                }
            ).ToList

        OperazioneCorrente_EstraiDAL_FiltroImpianti(IDTestataTemp, xDestImp, listImp, Nothing)

    End Sub

    Public Shared Sub OperazioneCorrente_EstraiDAL_FiltroImpianti(ByVal IDTestataTemp As Integer,
                                                                  ByVal dest As List(Of Impianto),
                                                                  ByRef listImp As List(Of String),
                                                                  Optional ByVal objParametri As AgronicaCoreParametri = Nothing)

        Dim hs As New Hashtable

        Dim listImp1 As New List(Of String)

        Dim bUsername As Boolean = objParametri IsNot Nothing

        Dim contatoreDati As Integer = 1

        For Each iDest In dest

            Dim chiaveHash As String = "('" & iDest.Piva & "'," & iDest.Sa_Cod & "," & iDest.Appezza & "," & iDest.ID_Reg & "," & IDTestataTemp

            If objParametri IsNot Nothing Then
                chiaveHash &= ", '" & objParametri.UtenteUsername & "', '" & objParametri.UtenteUsername & "'"
            End If

            chiaveHash &= ")"

            If Not hs.ContainsKey(chiaveHash) Then

                hs.Add(chiaveHash, iDest)

                listImp1.Add(chiaveHash)

                If contatoreDati Mod 1000 = 0 Then
                    popolaConImpianti(listImp, listImp1, bUsername)
                    listImp1.Clear()
                End If

            Else
                'xdebug
                Dim idle As Integer = 0
            End If

            contatoreDati += 1

        Next

        If dest.Count Mod 1000 <> 0 Then
            popolaConImpianti(listImp, listImp1, bUsername)
        End If

    End Sub

    Private Shared Sub popolaConImpianti(listImp As List(Of String),
                                         listImp1 As List(Of String),
                                         ByVal bUsername As Boolean)

        Dim sInsertStmt2 As New StringBuilder

        Dim line As String = " insert into __tmp_FiltroImpianti (piva, sa_cod, appezza, id_reg, IDTestataTemp"

        If bUsername Then
            line &= ", Username_Creazione, Username_Modifica"
        End If

        line &= ") values "

        sInsertStmt2.AppendLine(line)

        sInsertStmt2.Append(String.Join(",", listImp1))

        listImp.Add(sInsertStmt2.ToString)

    End Sub

    Public Shared Sub PopolaTabellaFiltroImpianti(operazioneCorrente_FiltroImpianti As String,
                                                  ByVal objParametri As AgronicaCoreParametri)

        Dim vQry As String() = operazioneCorrente_FiltroImpianti.Split("|")

        Dim scriviImpianti As New AgronicaCoreDataProvider.DataProvider

        For Each stmt In vQry

            Dim rVal As Boolean = scriviImpianti.EseguiQuery_Scrittura(objParametri, stmt, "PopolaTabellaFiltroImpianti")

        Next

    End Sub

    Public Shared Function salvaElementiGraficiDaFileShape(ByVal fileName As String,
                                                           ByVal layer_cod As Int32,
                                                           ByVal datiImpianto As DatiImpianto_Importazione,
                                                           ByVal datiCatasto As Daticatasto_Importazione,
                                                           ByVal tipologiaShape_cod As Int32,
                                                           ByVal codice_sistemaRiferimento As Int32,
                                                           ByVal progressivoGIAS As Int32,
                                                           ByRef objParametri_Server As AgronicaCoreParametri,
                                                           ByRef objParametri_Utenti As AgronicaCoreParametri,
                                                           Optional ByVal inizio_validita As Date = CostantiPersonalizzate.AGRODATAINIZIO,
                                                           Optional ByVal fine_validita As Date = CostantiPersonalizzate.AGRODATAFINE,
                                                           Optional ByVal descrizione_file As String = "",
                                                           Optional ByVal pixelSize As Int32 = 0
                                                           ) As Boolean


        Dim objUtentiDAL As New AgronicaCoreUtentiDAL.Utenti_xGruppi_Utente_R

        Dim Codice_Fiscale_Tecnico =
            objUtentiDAL.Leggi_IdentificativoGruppoUtenti_Singolo(objParametri_Server.UtenteUsername, objParametri_Utenti)

        Dim impostaRiproiezioneDaTipoImportazione As Boolean = False
        Dim riproiezioneRichiestaDaUtente As Boolean = (codice_sistemaRiferimento > 0)
        Dim layerPerCatasto = layer_cod

        If tipologiaShape_cod = Tipo_Importazione_FileShape.Importazione_Trimble Then
            'trimble
            layerPerCatasto = 1
            impostaRiproiezioneDaTipoImportazione = False
            codice_sistemaRiferimento = 1
        End If
        If tipologiaShape_cod = Tipo_Importazione_FileShape.importaCatasto_DXF Then
            layerPerCatasto = 3
            If datiCatasto.fileCatasto = TipoFileCatasto.CatastoDXF Then
                impostaRiproiezioneDaTipoImportazione = True
            Else
                impostaRiproiezioneDaTipoImportazione = False
                If Not (codice_sistemaRiferimento <> "-1") Then
                    codice_sistemaRiferimento = 1
                End If
            End If

        End If

        If tipologiaShape_cod = Tipo_Importazione_FileShape.importaGeneric_SHP Or
           tipologiaShape_cod = Tipo_Importazione_FileShape.Importa_KmlKmz Then

            If Not (codice_sistemaRiferimento <> "-1") Then
                codice_sistemaRiferimento = 1
            End If
        End If

        If tipologiaShape_cod = Tipo_Importazione_FileShape.Importazione_Trimble And datiImpianto.id_reg = 0 Then
            Throw New Exception("Nessun impianto selezionato.")
        End If

        Dim trasformaSistemaRiferimento As Boolean = (impostaRiproiezioneDaTipoImportazione Or riproiezioneRichiestaDaUtente)

        Select Case tipologiaShape_cod
            Case Tipo_Importazione_FileShape.importaCatasto_DXF
                Dim configurazioneImportazione As ConfigurazioneImportazione =
                        New ConfigurazioneImportazione(fileName,
                                                       objParametri_Server.PivaSuperUser,
                                                       "",
                                                       0,
                                                       datiImpianto.campo_cod,
                                                       datiImpianto.appezza,
                                                       datiImpianto.id_reg,
                                                       0,
                                                       0,
                                                       "",
                                                       0,
                                                       0,
                                                       layer_cod,
                                                       tipologiaShape_cod,
                                                       Now.Year,
                                                       "",
                                                       "",
                                                       progressivoGIAS,
                                                       trasformaSistemaRiferimento,
                                                       codice_sistemaRiferimento,
                                                       CInt(TipiEnumerativi.enum_GIS2012_TipoEntita.CATASTO).ToString,
                                                       Codice_Fiscale_Tecnico)

                configurazioneImportazione.DataInizioValidita = inizio_validita
                configurazioneImportazione.DataFineValidita = fine_validita

                configurazioneImportazione.ConfigurazioneImportazione_Catasto = New ConfigurazioneImportazione_Catasto
                configurazioneImportazione.ConfigurazioneImportazione_Catasto.AzioneSuDati_1Sovrascrive_2Ignora_3Aggiunge = datiCatasto.ComportamentoImportazione
                configurazioneImportazione.ConfigurazioneImportazione_Catasto.CreaLayerTestuale = datiCatasto.CreaLayerTestuale

                configurazioneImportazione.ConfigurazioneImportazione_Catasto.CodBelfiore = datiCatasto.CodBelfiore
                configurazioneImportazione.ConfigurazioneImportazione_Catasto.Prov = datiCatasto.Provincia
                configurazioneImportazione.ConfigurazioneImportazione_Catasto.Com = datiCatasto.Comune
                configurazioneImportazione.ConfigurazioneImportazione_Catasto.Sezione = datiCatasto.Sezione
                configurazioneImportazione.ConfigurazioneImportazione_Catasto.Foglio = datiCatasto.Foglio
                configurazioneImportazione.ConfigurazioneImportazione_Catasto.Particella = datiCatasto.Particella
                configurazioneImportazione.ConfigurazioneImportazione_Catasto.Subalterno = datiCatasto.Subalterno
                configurazioneImportazione.ConfigurazioneImportazione_Catasto.IdentificativoEsterno = datiCatasto.IdentificativoEsterno
                configurazioneImportazione.ConfigurazioneImportazione_Catasto.FiltroParticelleCatastali = datiCatasto.FiltroParticelleCatastali

                If datiCatasto.fileCatasto = TipoFileCatasto.CatastoDXF Then
                    Dim objImportDXF = New AgronicaSHPWrapper.DXF_ToAgronicaGIS2012
                    configurazioneImportazione.ConfigurazioneImportazione_Catasto.ListaLayersDXFAgenziaEntrate = datiCatasto.ListaLayersDXFAgenziaEntrate

                    objImportDXF.convert(configurazioneImportazione, objParametri_Server, objParametri_Utenti)
                Else

                    Dim objImportSHP = New AgronicaSHPWrapper.ShapeFileToAgronicaGis2012


                    objImportSHP.convert(configurazioneImportazione, objParametri_Server, objParametri_Utenti)

                End If
            Case Tipo_Importazione_FileShape.Importa_Raster
                Dim objEntitaWrite As New AgronicaSHPWrapper.Raster_ToAgronicaGIS2012

                Dim configurazioneFileRaster As New ConfigurazioneImportazione(fileName,
                                                                               objParametri_Server.PivaSuperUser,
                                                                               datiImpianto.piva,
                                                                               datiImpianto.sa_cod,
                                                                               datiImpianto.campo_cod,
                                                                               datiImpianto.appezza,
                                                                               datiImpianto.id_reg,
                                                                               0,
                                                                               0,
                                                                               "",
                                                                               0,
                                                                               0,
                                                                               layer_cod,
                                                                               tipologiaShape_cod,
                                                                               Now.Year,
                                                                               "",
                                                                               "",
                                                                               progressivoGIAS,
                                                                               trasformaSistemaRiferimento,
                                                                               codice_sistemaRiferimento,
                                                                               CInt(TipiEnumerativi.enum_GIS2012_TipoEntita.RASTER).ToString,
                                                                               Codice_Fiscale_Tecnico)
                configurazioneFileRaster.DataInizioValidita = inizio_validita
                configurazioneFileRaster.DataFineValidita = fine_validita
                configurazioneFileRaster.DescrizioneFile = descrizione_file
                configurazioneFileRaster.PixelSize = pixelSize

                objEntitaWrite.convert(configurazioneFileRaster, objParametri_Server, objParametri_Utenti)

            Case Tipo_Importazione_FileShape.Importa_KmlKmz

                Dim objImportKML = New AgronicaSHPWrapper.KML_ToAgronicaGIS2012

                Dim configurazioneKML = New ConfigurazioneImportazione(fileName,
                                                                    objParametri_Server.PivaSuperUser,
                                                                    datiImpianto.piva,
                                                                    datiImpianto.sa_cod,
                                                                    datiImpianto.campo_cod,
                                                                    datiImpianto.appezza,
                                                                    datiImpianto.id_reg,
                                                                    0,
                                                                    0,
                                                                    "",
                                                                    0,
                                                                    0,
                                                                    layer_cod,
                                                                    tipologiaShape_cod,
                                                                    Now.Year,
                                                                    "",
                                                                    "",
                                                                    progressivoGIAS,
                                                                    trasformaSistemaRiferimento,
                                                                    codice_sistemaRiferimento,
                                                                    CInt(TipiEnumerativi.enum_GIS2012_TipoEntita.DATI_IMPORTATI).ToString,
                                                                    Codice_Fiscale_Tecnico)

                configurazioneKML.DataInizioValidita = inizio_validita
                configurazioneKML.DataFineValidita = fine_validita

                objImportKML.convert(configurazioneKML, objParametri_Server, objParametri_Utenti)
            Case Else
                Dim objImportSHP = New AgronicaSHPWrapper.ShapeFileToAgronicaGis2012

                Dim configurazioneShape = New ConfigurazioneImportazione(fileName,
                                                                         objParametri_Server.PivaSuperUser,
                                                                         datiImpianto.piva,
                                                                         datiImpianto.sa_cod,
                                                                         datiImpianto.campo_cod,
                                                                         datiImpianto.appezza,
                                                                         datiImpianto.id_reg,
                                                                         0,
                                                                         0,
                                                                         "",
                                                                         0,
                                                                         0,
                                                                         layer_cod,
                                                                         tipologiaShape_cod,
                                                                         Now.Year,
                                                                         "",
                                                                         "",
                                                                         progressivoGIAS,
                                                                         trasformaSistemaRiferimento,
                                                                         codice_sistemaRiferimento,
                                                                         CInt(TipiEnumerativi.enum_GIS2012_TipoEntita.DATI_IMPORTATI).ToString,
                                                                         Codice_Fiscale_Tecnico)

                configurazioneShape.DataInizioValidita = inizio_validita
                configurazioneShape.DataFineValidita = fine_validita

                objImportSHP.convert(configurazioneShape, objParametri_Server, objParametri_Utenti)

        End Select

        Return True

    End Function

    Public Shared Function SalvaFileRaster(ByVal fileContent() As Byte,
                                           ByVal fileZipName As String,
                                           ByRef objParametri_Server As AgronicaCoreParametri
                                          ) As String()

        Dim LeggiCFGDatiIniziali As New AgronicaCoreVarieDAL.Configurazione_Siti_R

        Dim conf = LeggiCFGDatiIniziali.Leggi_Valore(0, "pathFileRaster", "", "", objParametri_Server)
        Dim basePath = LeggiCFGDatiIniziali.Leggi_Valore(0, "GestioneAllegati_Repository", "", "", objParametri_Server)


        'DEBUG DEBUG DEBUG
        'conf = "{""BasePathAllegatiRaster"": ""C:\\GIASLAN\\File_Temporanei"", ""FormatiConsentiti"": ["".tif"", "".tiff"", "".ecw"", "".jp2""]}"
        'DEBUG DEBUG DEBUG

        If conf = "" Then
            Throw New Exception("Configurazione file temporanei non trovata. impossibile proseguire")
        End If

        Dim configurazioniRaster = JObject.Parse(conf)


        Dim extensionList As String() = JArray.Parse(configurazioniRaster("FormatiConsentiti").ToString).ToObject(Of String())

        Dim pathCompleto = System.IO.Path.Combine(basePath, configurazioniRaster("BasePathAllegatiRaster").ToString)

        If Not System.IO.Directory.Exists(pathCompleto) Then
            Throw New Exception("La cartella remota non esiste.")
        End If

        Dim workDir = System.IO.Path.Combine(pathCompleto, Path.GetFileNameWithoutExtension(fileZipName))

        Dim filePathTemp = System.IO.Path.Combine(workDir, fileZipName)

        If Not Path.GetExtension(filePathTemp).Equals(".zip") And Not extensionList.Contains(Path.GetExtension(filePathTemp)) Then
            Throw New Exception("Il file caricato non è in un formato consentito.")
        End If

        If Directory.Exists(workDir) = True Then
            Directory.Delete(workDir, True)
        End If
        Directory.CreateDirectory(workDir)

        Using f As New System.IO.FileStream(filePathTemp, IO.FileMode.Create)
            f.Write(fileContent, 0, fileContent.Length)
        End Using

        Dim infoFile As New InfoRaster

        If Path.GetExtension(filePathTemp).Equals(".zip") Then
            AgronicaCoreUtility.AgroZip.UnZip(filePathTemp, workDir)

            Dim fList = Directory.GetFiles(workDir).ToList().Where(Function(x) extensionList.Contains(Path.GetExtension(x)))

            If fList.Count = 0 Then
                Return fList.ToArray
            End If

            Dim fileZipList As New List(Of String)

            For Each f In fList

                If Not infoFile.COGChecker(f) Then
                    f = infoFile.ConvertToCOG(f)
                End If

                Dim newPath = RenameFile(workDir, f)

                Dim newGUID = Path.GetFileNameWithoutExtension(newPath)

                Dim movePath = Path.Combine(pathCompleto, newGUID)

                If Directory.Exists(movePath) = True Then
                    Directory.Delete(movePath, True)
                End If
                Directory.CreateDirectory(movePath)

                Dim completeFilePath = Path.Combine(movePath, Path.GetFileName(newPath))

                FileIO.FileSystem.CopyFile(newPath, completeFilePath)

                fileZipList.Add(completeFilePath)
            Next

            Directory.Delete(workDir, True)

            Return fileZipList.ToArray
        Else
            Dim fileList(0) As String

            If Not infoFile.COGChecker(filePathTemp) Then
                filePathTemp = infoFile.ConvertToCOG(filePathTemp)
            End If

            fileList(0) = RenameFileAndSubfolder(pathCompleto, workDir, filePathTemp)
            Return fileList
        End If

    End Function

    Private Shared Function RenameFileAndSubfolder(subfolder As String, workDir As String, filePathTemp As String) As String

        Dim nuovoGUIDFile = (Guid.NewGuid).ToString

        Dim renamedFileName = String.Format("{0}{1}", nuovoGUIDFile, Path.GetExtension(filePathTemp))

        Dim renamedSubfolder = Path.Combine(subfolder, nuovoGUIDFile)

        If Not Directory.Exists(renamedSubfolder) Then
            Directory.CreateDirectory(renamedSubfolder)
        End If

        Dim renamedFilePath = Path.Combine(renamedSubfolder, renamedFileName)

        FileSystem.FileCopy(filePathTemp, renamedFilePath)

        Directory.Delete(workDir, True)

        Return renamedFilePath

    End Function

    Private Shared Function RenameFile(workDir As String, filePathTemp As String) As String

        Dim renamedFileName = String.Format("{0}{1}", (Guid.NewGuid).ToString, Path.GetExtension(filePathTemp))

        Dim renamedFilePath = Path.Combine(workDir, renamedFileName)

        FileSystem.Rename(filePathTemp, renamedFilePath)

        Return renamedFilePath

    End Function

    Public Shared Function LeggiContenutoZipFileShape(ByVal fileZip() As Byte,
                                                      ByVal fileZipName As String,
                                                      ByVal tipologiaShape_cod As Int32,
                                                      ByVal tipoFileCatasto As TipoFileCatasto,
                                                      ByRef objParametri_Server As AgronicaCoreParametri
                                                      ) As String()

        Dim LeggiCFGDatiIniziali As New AgronicaCoreVarieDAL.Configurazione_Siti_R
        Dim pathTemp As String =
                    LeggiCFGDatiIniziali.Leggi_Valore(0, "PathFileTemporanei", "", "", objParametri_Server)

        If pathTemp = "" Then
            Throw New Exception("Configurazione file temporanei non trovata. impossibile proseguire")
        End If

        If Not System.IO.Directory.Exists(pathTemp) Then
            System.IO.Directory.CreateDirectory(pathTemp)
        End If

        Dim filePathTemp = System.IO.Path.Combine(pathTemp, fileZipName)

        If Path.GetExtension(filePathTemp) <> ".zip" Then
            Throw New Exception("Il file caricato non è in formato ZIP")
        End If

        Using f As New System.IO.FileStream(filePathTemp, IO.FileMode.Create)
            f.Write(fileZip, 0, fileZip.Length)
        End Using

        Dim workDir As String = Path.Combine(pathTemp, Path.GetFileNameWithoutExtension(fileZipName))
        If Directory.Exists(workDir) = True Then
            Directory.Delete(workDir, True)
        End If
        Directory.CreateDirectory(workDir)

        AgronicaCoreUtility.AgroZip.UnZip(filePathTemp, workDir)

        If tipologiaShape_cod = Tipo_Importazione_FileShape.Importa_KmlKmz Then
            Dim kmzFiles = Directory.GetFiles(workDir, "*.kmz", System.IO.SearchOption.AllDirectories)

            For Each kmzipFile In kmzFiles
                AgronicaCoreUtility.AgroZip.UnZip(kmzipFile, workDir)
            Next
        End If

        Dim files = Directory.GetFiles(workDir, GetTipologiaFile(tipologiaShape_cod, tipoFileCatasto), System.IO.SearchOption.AllDirectories)

        Return files
    End Function

    Private Shared Function GetTipologiaFile(ByVal tipologiaShape_cod As Integer, ByVal tipoFileCatasto As TipoFileCatasto) As String
        Dim filtro As String

        If tipologiaShape_cod = Tipo_Importazione_FileShape.importaCatasto_DXF Then
            If tipoFileCatasto = TipoFileCatasto.CatastoDXF Then
                filtro = "*.dxf"
            Else
                filtro = "*.shp"
            End If
        ElseIf tipologiaShape_cod = Tipo_Importazione_FileShape.Importa_KmlKmz Then
            filtro = "*.kml"
        Else
            filtro = "*.shp"
        End If

        Return filtro
    End Function

    Private Shared Sub CustomLayerCancellationAllowed(layerCod As Integer,
                                                      objParametriServer As AgronicaCoreParametri,
                                                      objParametriUtenti As AgronicaCoreParametri)
        '(1) controllare permesso Flag_Rimozione
        '(2) controllare permessi amministrativi di altri utenti
        Dim rPermessi = New AgronicaCoreGisBIZ.GIS_LayerElementiGrafici_Permessi_Utente_GruppiUtente_R()
        Dim permissions = rPermessi.LeggiPermessiLayer(layerCod, objParametriServer, objParametriUtenti)

        Dim userPermissions = permissions.utenti_permessi.Where(Function(perm)
                                                                    Return perm.Username = objParametriUtenti.UsernameOperazione OrElse
                                                                    perm.Username = objParametriUtenti.UtenteUsername
                                                                End Function).ToList.SingleOrDefault

        If userPermissions.Flag_Rimozione <> 1 Then
            Throw New GiasException(My.Resources.AgronicaControlliGIS.RimozioneLayerPermessiErrore)
        End If

        Dim otherUsersPermissions = permissions.utenti_permessi.Where(Function(perm)
                                                                          Return perm.Username <> objParametriUtenti.UtenteUsername AndAlso
                                                                          perm.Username <> objParametriUtenti.UsernameOperazione AndAlso
                                                                          perm.Username <> objParametriServer.SuperUserUsername AndAlso 'super user should always have permissions on all layers, so it doesn't count
                                                                          perm.Flag_Amministrazione = 1
                                                                      End Function).ToList

        'super user is allowed to delete custom layer even if other users have permissions
        If otherUsersPermissions.Count > 0 AndAlso objParametriServer.SuperUserUsername <> objParametriServer.UtenteUsername Then
            Throw New GiasException(My.Resources.AgronicaControlliGIS.RimozioneLayerPermessiAmministrativiAltriUtentiErrore)
        End If

        'super user is allowed to delete custom layer even if other user groups have permissions
        If permissions.gruppiutente_permessi.Count > 0 AndAlso objParametriServer.SuperUserUsername <> objParametriServer.UtenteUsername Then
            Throw New GiasException(My.Resources.AgronicaControlliGIS.RimozioneLayerPermessiGruppiErrore)
        End If

        '(3) controllare dati associati
        '(4) controllare che in GIS_LayerElementiGrafici non ci siano dati, o ci siano dati solo dell'utente
        Dim objLetturaElemGrafici = New AgronicaCoreGisDAL.GIS_ElementiGrafici_R
        Dim filtroAggiuntivo As String = $" (Username_Creazione <> '{objParametriServer.UsernameOperazione}' AND Username_Creazione <> '{objParametriServer.UtenteUsername}')"
        Dim elements = objLetturaElemGrafici.Leggi(
            PivaSuperUser:=objParametriServer.PivaSuperUser,
            ElementoGrafico_Cod:=0,
            Entita_Cod:=0,
            LayerElementiGrafici_Cod:=layerCod,
            FormatoGraficoConvertito:=enumFromatoCartograficoConvertito.Nessuna_Conversione,
            xSelezioneVariabile:=enumSelezioneVariabile.Selezione_TabellaDatiMinimi,
            xFiltroAggiuntivo:=filtroAggiuntivo,
            xOrderBy:="",
            objParametri:=objParametriServer
            )

        If elements.Rows.Count > 0 Then
            Throw New GiasException(My.Resources.AgronicaControlliGIS.RimozioneLayerDatiAssociatiAltriUtentiErrore)
        End If
    End Sub

#End Region

End Class

