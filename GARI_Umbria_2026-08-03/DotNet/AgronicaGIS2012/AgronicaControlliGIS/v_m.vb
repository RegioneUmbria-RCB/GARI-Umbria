    <WebMethod(EnableSession:=True)>
    Public Shared Function LeggiElaborazioniInSospesoMappaDettagliata() As RispostaStandard

        Dim r As New RispostaStandard

        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")

        'todo: session
        Lingua.Gias_InizializzaCultura_DaSession()


        Try

            Dim xLeggi As New AgronicaCoreGisDAL.GIS_Tiles_R
            Dim DT = xLeggi.Leggi(objParametri_Server)
            Dim TilesCodes As New List(Of Integer)
            Dim LastDate As DateTime = AGRODATAINIZIO
            For Each row In DT.Rows
                TilesCodes.Add(row("Tiles_Cod"))
                Dim currDate = CDate(row("Data_Creazione"))
                If currDate > LastDate Then
                    LastDate = currDate
                End If
            Next

            Dim oRisp = JObject.FromObject(New With {
                                           .TilesCodes = String.Join(",", TilesCodes),
                                           .DataRif = LastDate.ToShortDateString()
                                           })

            Dim serializerSettings As New JsonSerializerSettings()
            serializerSettings.ReferenceLoopHandling = ReferenceLoopHandling.Ignore
            r.RispostaOK = True
            r.RispostaStringa = JsonConvert.SerializeObject(oRisp)

        Catch ex As Exception

            r.RispostaOK = False
            r.Errore = Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)

        End Try

        Return r

    End Function

