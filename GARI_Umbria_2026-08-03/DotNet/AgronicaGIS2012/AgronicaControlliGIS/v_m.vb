    ''' <summary>
    ''' Esegue la logica per determinare se il clustering deve essere utilizzato per un singolo layer
    ''' </summary>
    ''' <returns>True se il clustering deve essere utilizzato, altrimenti False.</returns>
    Private Shared Function UtilizzareClustering(     'ByVal clusteringFeature As Boolean,
    ByVal layerCodDaVerificare As Integer,
    ByVal InData As AgronicaCoreModello.GisDataReadParam,
    ByRef objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri,
    ByRef objParametri_Utenti As AgronicaCoreDataProvider.AgronicaCoreParametri
    ) As Boolean

        ' Applicare la logica solo alla tipologia Layer 1 (standard)
        Const TIPO_LAYER_STANDARD As Integer = 1
        If CInt(InData.TipologiaLayerSelezionata) <> TIPO_LAYER_STANDARD Then
            ' Se non è il tipo di layer corretto, non applichiamo il clustering.
            Return False
        End If

        ' Leggere la configurazione personalizzata dell'utente per questo layer

        Dim configBiz As New AgronicaCoreGisBIZ.GIS_ClusterConfig_BIZ_R()

        ' Chiamiamo il BIZ per ottenere il profilo completo (testata + dettagli).
        Dim profiloUtente As GisClusterConfigSave_InData = configBiz.LeggiConfigurazione(
        CanoPy,
        layerCodDaVerificare,
        objParametri_Utenti.UtenteUsername,
        objParametri_Server
    )


        If profiloUtente Is Nothing Then
            ' non è stato configurato il profilo di clusterizzazione per quell'utente sul layer in uso, NON Utilizzare clustering
            Return False
        Else
            ' Trovato record? SI
            Dim rangeTrovato As Boolean = False

            ' Controlla se lo zoom attuale rientra in uno dei range definiti nei dettagli.
            If profiloUtente.Details IsNot Nothing AndAlso profiloUtente.Details.Any() Then
                For Each detail In profiloUtente.Details
                    Try
                        ' Deserializza i parametri di zoom dal campo stringa.
                        Dim params = JsonConvert.DeserializeObject(Of structZoom)(detail.Parameters)
                        If InData.zoomLevel >= params.ZoomMin AndAlso InData.zoomLevel <= params.ZoomMax Then
                            rangeTrovato = True
                            Exit For ' Trovato un range valido.
                        End If
                    Catch
                    End Try
                Next
            End If

            If rangeTrovato Then
                ' Il dettaglio contiene un elemento per cui lo zoom è compreso? SI, allora utilizza clustering
                Return True
            Else
                ' Il dettaglio contiene un elemento per cui lo zoom è compreso? NO
                ' Controlliamo se è definito un livello di raggruppamento di default nel profilo.
                If profiloUtente.LivelloZoomMassimoVisualizzazioneRaggruppata > 0 Then
                    ' E' definito un livello di raggruppamento di default? SI
                    Return (InData.zoomLevel <= profiloUtente.LivelloZoomMassimoVisualizzazioneRaggruppata)
                Else
                    ' E' definito un livello di raggruppamento di default? NO,  NON Utilizzare clustering
                    Return False
                End If
            End If
        End If

    End Function

    ' Struttura di supporto per deserializzare i parametri di zoom.
    Private Class structZoom
        Public Property ZoomMin As Integer
        Public Property ZoomMax As Integer
    End Class



    ''' <summary>
    ''' Converte una lista di ClusterItem (risultato dell'algoritmo Canopy) in un oggetto GeoJson_New
    ''' </summary>
    ''' <returns>Un oggetto GeoJson_New formattato per la visualizzazione dei cluster.</returns>
    Private Shared Function ConvertiClusterItemsInGeoJson(
    ByVal PivaSuperUser As String,
    ByVal ElencoClusterItems As List(Of ClusterItem),
    ByVal TipologiaLayer As Integer,
    ByVal LayerElementiGrafici_Cod As List(Of Integer),
    ByVal Piva As String,
    ByVal ObjParametri_Server As AgronicaCoreParametri,
    ByVal ObjParametri_Utenti As AgronicaCoreParametri
) As GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)

        ' prepara l'oggetto GEOJSON di ritorno, che non è altro che un contenitore con una lista di features cioé gli elementi da disegnare sulla mappa.
        Dim finalObj As New GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
        finalObj.geoJsonCaricato = New AgronicaCoreModelsSTD.Gis.GeoJson_Shape_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp) With {
        .type = "FeatureCollection",
        .features = New List(Of AgronicaCoreModelsSTD.Gis.GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))
        }

        ' Se la lista dei cluster in input è vuota, restituisce una collezione vuota.
        If ElencoClusterItems Is Nothing OrElse Not ElencoClusterItems.Any() Then
            Return finalObj
        End If

        ' Crea una ConcurrentBag, una versione speciale di una lista che può essere usata in sicurezza quando più thread cercano di aggiungere elementi contemporaneamente.
        Dim featureList As New Concurrent.ConcurrentBag(Of GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))()

        ' avvia il lavoro in parallelo
        Parallel.ForEach(ElencoClusterItems,
        Sub(item)
            ' Per ogni ClusterItem nella lista, creiamo una feature GeoJSON.

            ' trasforma la stringa WKT del centroide in un oggetto geometry GeoJSON.
            Dim coordinates = getStringGeometryGeoJson(item.Wkt_Centroid)

            ' Crea un nuovo oggetto properties, ogni feature ha una geometria che sarebbe la sua posizione e delle proprietà che sono tutte le info associate
            Dim prop = New AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp()

            prop.layer = LayerElementiGrafici_Cod(0).ToString()
            prop.StandardEntita_layerDiAppartenenza = 1
            prop.StandardEntita_layerDiAppartenenza_Des = "Standard"
            prop.StandardEntita_layerDiAppartenenza_Icona32 = ""
            prop.id = PivaSuperUser & "|" & item.Id & "|" & TipologiaLayer & "|Layer_" & LayerElementiGrafici_Cod(0).ToString()
            prop.tipoicona = ""
            prop.zindex = 0
            prop.Entita_Cod = 0
            prop.Entita_GUID = ""
            prop.Area_Cod = 0
            prop.ParametriVisualizzazioneLayer = ""
            prop.veg_cod = 0
            prop.informazioni = "True"
            prop.flag_gps = 0
            prop.etichetta = ""
            prop.chiavealbero = ""
            prop.inserimento = "False"
            prop.modifica = "False"
            prop.cancellazione = "False"
            prop.Testo = item.ElementCount.ToString() ' Il testo visualizzato sull'icona che sarebbe il conteggio degli elementi.
            prop.AppIdRate = ""
            prop.TipologiaGML = "Point"
            prop.InOsservazione = 0
            prop.Colore_Primario = ""
            prop.Colore_Retinatura = ""
            prop.Trasparenza = 0
            prop.Clustered = "True"

            ' Crea l'oggetto feature finale, mettendo insieme la geometria (coordinates) e le proprietà (prop).
            Dim feature = New AgronicaCoreModelsSTD.Gis.GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp) With {
                .type = "Feature",
                .geometry = coordinates, ' La posizione del cluster.
                .properties = prop        ' Tutte le informazioni.
            }

            featureList.Add(feature)
        End Sub)

        ' Converte il ConcurrentBag in una List normale e la assegna a finalObj
        finalObj.geoJsonCaricato.features = featureList.ToList()

        Return finalObj
    End Function


    Public Shared Function AggiornaLayer_3_New(
            objParametri_Super_Server As AgronicaCoreDataProvider.AgronicaCoreParametri,
            objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri,
            objParametri_Utenti As AgronicaCoreDataProvider.AgronicaCoreParametri,
            InData As AgronicaCoreModello.GisDataReadParam,
            cfgAlbero As ConfigurazioneAlbero
        ) As GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)

        Try

            'Amine 15/09/2025 - Leggo la configurazione per vedere se la feature di clustering è attiva
            Dim configClustering As New AgronicaCoreVarieDAL.Configurazione_Siti_R()
            Dim clusteringFeatureString As String = configClustering.Leggi_Valore(0, "Gis_Clustering", "", "", objParametri_Server)
            Dim clusteringFeature As Boolean = False 'di default la feature è spenta
            'clusteringFeature contiene sempre il valore corretto anche nel caso in cui non riesca a convertire la stringa
            Boolean.TryParse(clusteringFeatureString, clusteringFeature)

            Dim ns As XNamespace = "http://www.opengis.net/gml"

            Dim objEntitaBiz As New AgronicaCoreGisBIZ.DatiEntita_R

            Dim Codice_Fiscale_Tecnico As String = "CF TEC"

            CodiceFiscaleTecnicoImposta(objParametri_Server, objParametri_Utenti, Codice_Fiscale_Tecnico)

            Dim lAggiungiLayer_Imprese As Boolean = InData.TipologiaLayerSelezionata = "100"

            Dim SementiSportelloCod As Integer = -1
            Dim gp As GisPurpose

            If Not InData.cfgSementi Is Nothing Then
                Dim flgMappaturaLibera As Integer = 0
                If InData.cfgSementi.SementiMappaturaLibera.ToLower = "true" Then
                    flgMappaturaLibera = 1
                End If
                gp = New GisPurpose(InData.cfgSementi.Sementi, flgMappaturaLibera)
                SementiSportelloCod = gp.SementiSportelloCod()
            End If

            Dim xFiltroAggiuntivo As String = ""

            Dim codice_specie As Integer = 0
            Dim codice_destinazione_uso As Integer = 0

            If Not IsNothing(InData.veg_cod) Then
                Select Case InData.veg_cod.GetType()
                    Case GetType(AgronicaCoreModelsSTD.metaschema.utilizzi.Varieta)
                        codice_specie = CType(InData.veg_cod, AgronicaCoreModelsSTD.metaschema.utilizzi.Varieta).specie.codice
                        codice_destinazione_uso = 0
                    Case Else
                        codice_specie = 0
                        codice_destinazione_uso = InData.veg_cod.codice
                End Select
            End If

            Dim filtroTemporaleAvanzato = New FiltroTemporaleAvanzato()
            filtroTemporaleAvanzato.filtroTemporalePeriodo = InData.filtroTemporale
            If IsNothing(InData.filtroTemporaleSingolaData) Then
                filtroTemporaleAvanzato.filtroTemporaleSingolaData = InData.filtroTemporale
            Else
                filtroTemporaleAvanzato.filtroTemporaleSingolaData = InData.filtroTemporaleSingolaData
            End If

            'lavez - 20/11/2023 - elenco layer visibili
            Dim LayersVisibili = New GIS_LayerElementiGrafici().GetElencoLayerVisibiliPerTipologia_e_Utente(objParametri_Server.PivaSuperUser, cfgAlbero.TipologiaLayer_Cod, objParametri_Server)
            If LayersVisibili.elencoLayers Is Nothing Then
                LayersVisibili.elencoLayers = New List(Of ElencoLayerVisibiliUtenteTipologia)
            End If

            'Lavez - 18/07/2024 - (se provengo da fuori il gis) ottimizzazione carico query se ho dei layer specifici sostituisci quelli precedentemente letti
            If InData.layerElementiGrafici_cod IsNot Nothing Then
                If InData.layerElementiGrafici_cod.Count > 0 Then
                    LayersVisibili.elencoLayers.Clear()

                    For Each l In InData.layerElementiGrafici_cod
                        LayersVisibili.elencoLayers.Add(New ElencoLayerVisibiliUtenteTipologia With {
                                                        .LayerElementiGrafici_Cod = l,
                                                        .Flag_Attivo = True,
                                                        .Flag_Visbile = True,
                                                        .LayerElementiGrafici_Des = CType(l, AgronicaCoreDataProvider.TipiEnumerativi.enum_Gis_LayerElementiGrafici_std).ToString()
                                                    })
                    Next
                End If
            End If


            Dim layers As New List(Of Integer)

            If clusteringFeature AndAlso
               InData.zoomLevel > 0 AndAlso
               LayersVisibili IsNot Nothing AndAlso
               LayersVisibili.elencoLayers IsNot Nothing AndAlso
               LayersVisibili.elencoLayers.Any() Then

                'Dim layers As New List(Of Integer)
                layers = LayersVisibili.elencoLayers.Select(Function(l) l.LayerElementiGrafici_Cod).ToList()

                ' Prepara l'oggetto GeoJSON finale che conterrà i risultati di tutti i layer.
                Dim geoJsonFinale As New GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
                geoJsonFinale.geoJsonCaricato = New AgronicaCoreModelsSTD.Gis.GeoJson_Shape_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp) With {
                .type = "FeatureCollection",
                .features = New List(Of AgronicaCoreModelsSTD.Gis.GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))
                }

                Dim clusteringBiz As New AgronicaCoreGisBIZ.GIS_Clustering_R() ' Questo legge soglie e centroidi
                Dim GeneraclusterBiz As New AgronicaCoreGisBIZ.Gis_ClusteringCanoPy() ' Questo esegue Canopy

                ' Cicla su ogni layer.
                For Each layerId As Integer In layers


                    Dim layerCorrenteList As New List(Of Integer) From {layerId}

                    ' Per ogni layer, chiama l'helper per decidere se usare il clustering, controllando se esiste la configurazione di clusering per quel layer.
                    If UtilizzareClustering(layerId, InData, objParametri_Server, objParametri_Utenti) Then

                        ' Leggi le soglie per lo zoom attuale.
                        Dim soglie = clusteringBiz.LeggiSoglieClusterAlgorithm(CanoPy, InData.zoomLevel, objParametri_Server)

                        If soglie.T1 <> -1 AndAlso soglie.T2 <> -1 Then
                            ' Soglie valide

                            Dim layerDaCercare As New List(Of Integer) From {layerId}

                            Dim dtCentroidi As DataTable

                            If String.IsNullOrWhiteSpace(InData.wktBoundaySTIntersects) Then

                                ' chiamo la funzione per il recupero dei centroidi tramite i parametri di anagrafica
                                dtCentroidi = clusteringBiz.LeggiCentroidiEntitaAnagrafica(
                                InData.piva,
                                InData.sa_cod,
                                InData.appezza,
                                InData.id_imp,
                                layerDaCercare,
                                objParametri_Server
                                )

                            Else
                                ' Chiamiamo la funzione per il recupero dei centroidi tramite Bounding Box
                                dtCentroidi = clusteringBiz.LeggiCentroidiInBoundingBox(InData.wktBoundaySTIntersects, layerDaCercare, objParametri_Server)
                            End If

                            ' Esegue l'algoritmo Canopy solo sui centroidi di questo layer.
                            Dim elencoClusterItems = GeneraclusterBiz.GeneraClusterCanopy(dtCentroidi, soglie.T1, soglie.T2)

                            ' Converte i cluster di questo layer in un oggetto GeoJson_New.
                            Dim geoJsonClusterLayer = ConvertiClusterItemsInGeoJson(
                            objParametri_Server.PivaSuperUser,
                            elencoClusterItems,
                            CInt(InData.TipologiaLayerSelezionata),
                            New List(Of Integer) From {layerId}, ' Passa solo il layer corrente
                            InData.piva,
                            objParametri_Server,
                            objParametri_Utenti
                            )

                            ' Aggiunge le "feature" generate da questo layer al risultato finale aggregato.
                            If geoJsonClusterLayer.geoJsonCaricato.features IsNot Nothing Then
                                geoJsonFinale.geoJsonCaricato.features.AddRange(geoJsonClusterLayer.geoJsonCaricato.features)
                            End If
                        Else
                            ' Se il clustering non è attivo per questo layer, eseguiamo la lettura orginale completa.

                            'Dim dt = objEntitaBiz.LeggiPerGerarchiaImprese(
                            'objParametri_Server.PivaSuperUser,
