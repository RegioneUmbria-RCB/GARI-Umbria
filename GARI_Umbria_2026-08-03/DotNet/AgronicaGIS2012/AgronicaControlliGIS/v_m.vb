                                                                                     objParametri_Server,
                                                                                     enum_TipoOperazioneDB.Cancellazione)

            NRowElementoDt += 1

            objDati.StringaRisposta = String.Format(My.Resources.AgronicaControlliGIS.V_M_Cancella_Elemento_GIS_collegato_num,
