    ''' <summary>
    ''' Effettua le operazioni CRUD sugli attributi dei Layer
    ''' </summary>
    ''' <param name="objAttributoLayerIn"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="objParametri_Utenti"></param>
    ''' <returns></returns>
    Public Shared Function AttributoLayer(
        ByRef objAttributoLayerIn As AttributoLayer_In,
        ByRef objParametri_Server As AgronicaCoreParametri,
        ByRef objParametri_Utenti As AgronicaCoreParametri
        ) As Boolean

        'Inizializzazione parametri

        'TipoLayer al momento fisso ad 1
        Dim TipoLayer As Int32 = 1

        'Lettura permessi WMS

        Dim ObjUtenti As New AgronicaCoreUtentiDAL.Utenti_Permessi_R

        Dim permessiWMS As Boolean = ObjUtenti.Controlla_Permessi_Utente(
            objParametri_Utenti.UtenteUsername,
            enum_Id_Servizio.GiasOnline,
            enum_Security_Attivita.GIS_VisualizzazioneGestioneWMS,
            enum_Security_Operazione.Modifica,
            Date.Now,
            "",
            objParametri_Utenti)

        If Not permessiWMS Then
            Throw New Exception("L'utente non ha i permessi per effettuare l'operazione richiesta")
        End If

        'Caricamento layer

        Dim objLayerBiz As New GIS_LayerElementiGrafici

        Dim successOperazione As Boolean

        Select Case objAttributoLayerIn.IdOperazione
            Case AttributoLayer_In.OperazioneAttributo.INSERT

                If objAttributoLayerIn.ProgressivoDataStruct <> Nothing And objAttributoLayerIn.ProgressivoDataStruct <> "" Then
                    Throw New Exception("Non è possibile inserire un nuovo attributo con un progressivo già valorizzato")
                End If

                successOperazione = objLayerBiz.SalvaAttributoLayer(
                                            objParametri_Server.PivaSuperUser,
                                            objAttributoLayerIn.IdLayer,
                                            objAttributoLayerIn.Nome,
                                            objAttributoLayerIn.TipoDato,
                                            TipoLayer,
                                            objParametri_Server,
                                            objParametri_Utenti)

            Case AttributoLayer_In.OperazioneAttributo.UPDATE

                If objAttributoLayerIn.ProgressivoDataStruct = Nothing Or objAttributoLayerIn.ProgressivoDataStruct.Trim.Equals("") Then
                    Throw New Exception("Non è possibile aggiornare un attributo senza un progressivo")
                End If

                successOperazione = objLayerBiz.AggiornaAttributoLayer(
                                            objParametri_Server.PivaSuperUser,
                                            objAttributoLayerIn.IdLayer,
                                            objAttributoLayerIn.Nome,
                                            objAttributoLayerIn.TipoDato,
                                            TipoLayer,
                                            -1,
                                            Nothing,
                                            objAttributoLayerIn.ProgressivoDataStruct,
                                            objParametri_Server,
                                            objParametri_Utenti)

            Case AttributoLayer_In.OperazioneAttributo.DELETE

                If objAttributoLayerIn.ProgressivoDataStruct = Nothing Or objAttributoLayerIn.ProgressivoDataStruct.Trim.Equals("") Then
                    Throw New Exception("Non è possibile eliminare un attributo senza un progressivo")
                End If

                successOperazione = objLayerBiz.EliminaAttributoLayer(
                                            objParametri_Server.PivaSuperUser,
                                            objAttributoLayerIn.ProgressivoDataStruct,
                                            TipoLayer,
                                            objParametri_Server,
                                            objParametri_Utenti)
            Case Else
                Throw New Exception("Tipo Operazione non riconosciuto")
        End Select

        Return successOperazione

    End Function

