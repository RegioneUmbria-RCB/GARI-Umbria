                '    True,
                '    False,
                '    True,
                '    SementiSportelloCod,
                '    Codice_Fiscale_Tecnico,
                '    InData.wktBoundaySTIntersects,
                '    cfgAlbero,
                '    xFiltroAggiuntivo,
                '    objParametri_Server,
                '    objParametri_Utenti,
                '    filtroTemporaleAvanzato:=filtroTemporaleAvanzato,
                '    InData.layerElementiGrafici_cod,
                '    LayersVisibili:=LayersVisibili)

                'Return GetPlaceGeoJSONFromDataTable(objParametri_Server.PivaSuperUser, dt, ns, InData.TipologiaLayerSelezionata, InData.layerElementiGrafici_cod, cfgAlbero, InData.piva, SementiSportelloCod, Codice_Fiscale_Tecnico, objParametri_Server, objParametri_Utenti)

