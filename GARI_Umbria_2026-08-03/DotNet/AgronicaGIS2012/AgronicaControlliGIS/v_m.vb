    Public Shared Function CaricaDatiPrecisionXmlDaAllegati_2022(ByVal obj_CaricaDatiPrecision As CaricaDatiPrecision_In,
                                                                 ByRef objParametri_Server As AgronicaCoreParametri,
                                                                 ByRef objParametri_Utenti As AgronicaCoreParametri) As rispostaStandard(Of GisDataReadRval_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))

        Dim r As New rispostaStandard(Of GisDataReadRval_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))

        Dim listCodici As List(Of Integer) = obj_CaricaDatiPrecision.Lista_RicettaOp_Cod
        Dim TipoCodici As Integer = obj_CaricaDatiPrecision.Flag_TipoCod

        r.RispostaOK = True
        Dim oCfgLetturaPF As AgronicaCoreModello.PrecisionModel_CFGLetturaDati

        If obj_CaricaDatiPrecision.Flag_TipoCod = 1 Then

            'caso allegati
            oCfgLetturaPF = New PrecisionModel_CFGLetturaDati
            oCfgLetturaPF.ListaCodici_AllegatiDocumentiCod_MappePrescrizione = listCodici

        Else

            'caso ricette
            oCfgLetturaPF = CaricaDatiPrecisionXmlDaAllegati_2022_CFGLettruaPF_Ricette(listCodici, objParametri_Server)

        End If
        'Ricette oppure allegati

        Dim stb As New StringBuilder

        stb.AppendLine(" <DatiEntita xmlns = ""http://www.agronica.it/grafica/"" xmlns:GML = ""http://www.opengis.net/gml"">")
        stb.AppendLine(" <layersdescrizioni>")
        stb.AppendLine("    <layer tipologia_layer = ""1"" nome_layer=""Standard"">")
        stb.AppendLine("       <valori pivasuperuser = """ & objParametri_Server.PivaSuperUser & """ utente=""" & objParametri_Server.SuperUserUsername & """ codice=""51"" colore_primario=""00FF00"" colore_secondario=""FF0000"" icona16=""MappePrescrizione16.png"" icona32=""MappePrescrizione32.png"" varianza=""1"" trasparenza=""6.0000002E-001"" MostraDescrizioneAssociata=""0"" ZIndex=""15"" flagvisibile=""1"" flagattivo=""1"" FlagInserimento=""0"" FlagModifica=""0"" FlagCancellazione=""0"" FlagInformazioni=""0"" FeatureTypeId=""5"" TipoNodoAlberoAnagrafe="""">Mappe Prescrizione</valori>")
        stb.AppendLine("    </layer>")
        stb.AppendLine("  </layersdescrizioni>")
        stb.AppendLine("</DatiEntita>")

        Dim myXmlToAppend As XDocument = XDocument.Parse(stb.ToString)

        'capire lPiva se richiesto.

        Dim inData As New AppendiDatiXmlLettiDaAllegatiParamIn With {
        .lPiva = "",
        .xml = myXmlToAppend,
        .sFiltroRicettaOperazioneCod = "",
        .sFiltroAllegatiDocumentiCod = "",
        .xCounter = 0,
        .objParametri_Server = objParametri_Server,
        .objParametri_Utenti = objParametri_Utenti
        }

        LetturaDatiPrecisionFarmingEmbeddedXml(oCfgLetturaPF, inData)

        Dim ns As XNamespace = "http://www.opengis.net/gml"

        r.RispostaStringa = New GisDataReadRval_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
        r.RispostaStringa.myGeoJson = IIf(inData.json = "", GetPlaceGeoJSONToGeoJsonNew(myXmlToAppend, ns, 1), JsonConvert.DeserializeObject(Of GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))(inData.json))

        Return r

    End Function
    Public Shared Function CaricaDatiPrecisionXmlDaAllegati_2022_CFGLettruaPF_Ricette(listCodici As List(Of Integer), objParametri_Server As AgronicaCoreParametri) As PrecisionModel_CFGLetturaDati


        Dim xLetturaTipoRicetta As New AgronicaCoreContabDAL.Ricette_Operazioni_R
