    Private Shared Sub CancellaPlanning(objDati As DatiCancella,
                                        objParametri_Server As AgronicaCoreParametri,
                                        risposta As rispostaStandard(Of Cancella_Out))

        If objDati.programmazione_cod = 0 OrElse objDati.programmazione_entita_cod = 0 Then

            Dim msg As String = My.Resources.AgronicaControlliGIS.V_M_Cancella_Selezionare_impianto_da_Anagrafica
            risposta.RispostaStringa.MessaggioEsito = msg

        End If

        Dim xLetturaVerificaRibaltamento As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Programmazioni_R
        Dim xDataTable As DataTable = xLetturaVerificaRibaltamento.Leggi("",
                                                                         0,
                                                                         0,
                                                                         0,
                                                                         0,
                                                                         objDati.programmazione_cod,
                                                                         objDati.programmazione_entita_cod,
                                                                         "",
                                                                         "",
                                                                         objParametri_Server)

        If xDataTable.Rows.Count = 0 Then

            Dim xElimina As New AgronicaCoreAnagrafeDAL.Programmazione_Entita_W
            xElimina.Cancella(objDati.programmazione_cod,
                              objDati.programmazione_entita_cod,
                              True,
                              False,
                              0,
                              "",
                              objParametri_Server)

        Else

            objDati.EsitoRispostaOK = False
            objDati.StringaRisposta = My.Resources.AgronicaControlliGIS.V_M_Cancella_Impossibile_eliminare_dato_impianto_associato

            GestisciEsitoRispostaCancella(objDati, risposta)

        End If

    End Sub

    Private Shared Sub CancellaDatoGiasPalm(objDati As DatiCancella,
                                            objCancella As Cancella_In,
                                            objParametri_Server As AgronicaCoreParametri,
                                            risposta As rispostaStandard(Of Cancella_Out))

        Dim XOldID As New AgronicaCoreGisDAL.GIS_Entita_R
        Dim dtXOldID As DataTable

        dtXOldID = XOldID.LeggixVecchiaChiaveGis(CType(objCancella.Entita_Cod, Integer),
                                                 enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                 "",
                                                 "",
                                                 objParametri_Server)

        If dtXOldID.Rows.Count > 0 Then

            Dim oldGrafica_id As String = dtXOldID.Rows(0)(0)

            If oldGrafica_id <> "" Then
                Dim xPrefissoAccessorio As New AgronicaCoreGraficaDAL.Layers_R
                Dim dtxPrefissoAccessorio As DataTable

                Dim lPrefissoOldGrafica_id As Char = oldGrafica_id(0)

                dtxPrefissoAccessorio = xPrefissoAccessorio.Leggi("",
                                                                  0,
                                                                  enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                  " prefisso = '" & lPrefissoOldGrafica_id & "'",
                                                                  "",
                                                                  objParametri_Server)

                Dim graficaCoreVecchio As New AgronicaCoreGraficaDAL.Grafica_Write

                graficaCoreVecchio.Cancella(objDati.piva,
                                            objDati.sa_cod,
                                            "",
                                            oldGrafica_id,
                                            "",
                                            "",
                                            objParametri_Server)

                If dtxPrefissoAccessorio.Rows.Count > 0 Then

                    If Not IsDBNull(dtxPrefissoAccessorio.Rows(0)(0)) Then

                        Dim sPrefissoAccessorio As String = dtxPrefissoAccessorio.Rows(0)("PrefissiAccessori")
                        Dim esitoGiasPalm As Boolean = graficaCoreVecchio.Cancella(objDati.piva,
                                                                                   objDati.sa_cod,
                                                                                   "",
                                                                                   sPrefissoAccessorio & oldGrafica_id.Substring(1, oldGrafica_id.Length - 1),
                                                                                   "",
                                                                                   "",
                                                                                   objParametri_Server)

                        objDati.EsitoRispostaOK = esitoGiasPalm
                        objDati.StringaRisposta = My.Resources.AgronicaControlliGIS.V_M_Cancella_Dati_Gias_Palm_eliminati_
                        Dim msgErrore = My.Resources.AgronicaControlliGIS.V_M_Cancella_Errore_eliminazione_Dati_registrati_con_Gias_Palm_

                        GestisciEsitoRispostaCancella(objDati, risposta, msgErrore)

                    End If

                End If

            End If

        End If

    End Sub

