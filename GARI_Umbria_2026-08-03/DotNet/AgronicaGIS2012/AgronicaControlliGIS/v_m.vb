    Public Shared Function SalvaNuovoAB_2022(ByVal obj_SalvaNuovoAB As SalvaNuovoAB_In,
                                             ByRef objParametri_Server As AgronicaCoreParametri,
                                             ByRef objParametri_Utenti As AgronicaCoreParametri) As rispostaStandard(Of SalvaNuovoAB_Out)
        Dim r As New rispostaStandard(Of SalvaNuovoAB_Out) With {
            .RispostaStringa = New SalvaNuovoAB_Out
        }

        Dim ChiaveAlbero As ChiaveAlbero = obj_SalvaNuovoAB.ChiaveAlbero
        Dim risp As Boolean = True

        'Valorizzo il Codice_Fiscale_Tecnico prendendolo dalla tabella Gruppi_Utente
        Dim xUtenteCorrente As String = objParametri_Server.UtenteUsername
        Dim objUtentiDAL As New AgronicaCoreUtentiDAL.Utenti_xGruppi_Utente_R
        Dim Codice_Fiscale_Tecnico As String = objUtentiDAL.Leggi_IdentificativoGruppoUtenti_Singolo(xUtenteCorrente,
                                                                                                     objParametri_Utenti)

        Dim ent_start As Integer = 0
        Dim objImpianto = New AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo With {
            .Piva = ChiaveAlbero.Piva,
            .Sa_Cod = ChiaveAlbero.Sa_Cod,
            .Appezza = ChiaveAlbero.Appezza,
            .Id_reg = ChiaveAlbero.Id_Imp
        }

        Dim tipoNodo As enum_TipoNodo = ChiaveAlbero.TipoNodo

        Dim Programmazione_Cod As Integer
        Dim Programmazione_Entita_Cod As Integer

        If tipoNodo = enum_TipoNodo.PlanningEntita Then
            Programmazione_Cod = CType(ChiaveAlbero.Programmazione_Cod, Integer)
            Programmazione_Entita_Cod = CType(ChiaveAlbero.Programmazione_Entita_Cod, Integer)

        End If

        If obj_SalvaNuovoAB.HiddenPunti_AB <> "" Then
            Dim app As String() = obj_SalvaNuovoAB.HiddenPunti_AB.Split("*")
            ent_start = app(0).Split("|")(1)

            Dim idleLayerElementiGrafici_Cod As Integer
            GetEntitaGiasFromEntitaGrafica(ent_start,
                                           objImpianto.Piva,
                                           objImpianto.Sa_Cod,
                                           objImpianto.Appezza,
                                           objImpianto.Id_reg,
                                           Nothing,
                                           Nothing,
                                           objParametri_Server,
                                           objParametri_Utenti,
                                           1,
                                           2,
                                           0,
                                           0,
                                           0,
                                           Nothing,
                                           idleLayerElementiGrafici_Cod,
                                           Codice_Fiscale_Tecnico)

        End If

        'Date§ 20/03/2012|Time§ 01:41:54pm|Version§ 5.10.038|Id§ 0|Name§ AB Line 1|Length§ 872,938|Dist1§ 0,000§ Dist2§ 4,661

        If obj_SalvaNuovoAB.HiddenPunti_AB <> "" Then
            Dim ent_A, ent_B, Ent_C As Integer
            Dim leggiAltreEntita As New AgronicaCoreGisDAL.PrecisionFarming

            Dim dtAltreEntita As DataTable = leggiAltreEntita.LeggiDatiAB_DaEntitaCod(ent_start,
                                                                                      enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                                      "",
                                                                                      "",
                                                                                      objParametri_Server)

            For Each riga In dtAltreEntita.Rows

                Select Case riga("ElementoGrafico_des")

                    Case "A"
                        ent_A = riga("entita_Cod")

                    Case "B"
                        ent_B = riga("entita_Cod")

                    Case Else
                        Ent_C = riga("entita_Cod")

                End Select

            Next

            r.RispostaStringa.hiddenPunti_A = SalvaGrafica2(New InSalvaGraficaModel(objImpianto.Piva, objImpianto.Sa_Cod, ent_A, obj_SalvaNuovoAB.HiddenPunti_A, Programmazione_Cod, Programmazione_Entita_Cod, 55, objImpianto, "A", 55, 0, 0, 0),
