                                                       ByVal grva_cod As Integer,
                                                       ByVal data_inizio As Date,
                                                       ByVal data_fine As Date,
                                                       ByVal Sementi As String,
                                                       ByVal SementiMappaturaLibera As String,
                                                       ByVal moltiplicatoreDistanze As Integer,
                                                       ByVal Flag_InterferenzeStessoReferente As Boolean,
                                                       ByVal numeroRecordDaRestituire As Integer,
                                                       ByVal hiddenPunti_Nuovo As String,
                                                       ByRef objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                                       ByRef objParametri_Utenti As AgronicaCoreDataProvider.AgronicaCoreParametri) As DataTable

        Dim gmlPol As String = GetGmlPol(hiddenPunti_Nuovo)

        Dim gp As New GisPurpose(Sementi,
                                 SementiMappaturaLibera)
        Dim FlagFinalita As Boolean = gp.Mode() = GisPurpose.enum_GisPurpose.SementiSportello

        Dim verificatore As New AgronicaCoreGisDAL.GIS_OperazioniCartograficheDB
        Dim dtInterferenze As DataTable = verificatore.ElencoImpiantiInterferenzaSementi(pivaSementieroReferente,
                                                                                         gmlPol,
                                                                                         veg_cod,
                                                                                         grva_cod,
                                                                                         Math.Abs(CInt(grva_cod < 0)),
                                                                                         data_inizio,
                                                                                         data_fine,
                                                                                         Flag_InterferenzeStessoReferente,
                                                                                         moltiplicatoreDistanze,
                                                                                         numeroRecordDaRestituire,
                                                                                         FlagFinalita,
                                                                                         objParametri_Server,
                                                                                         objParametri_Utenti)

        Return dtInterferenze

    End Function

    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' Implementata per non utilizzare la Sessione
    ''' </summary>
    ''' <param name="ChiaveAlbero"></param>
    ''' <param name="hiddenPunti_Nuovo"></param>
    ''' <param name="Area"></param>
    ''' <param name="ElementoGrafico_Des"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <returns></returns>
    Public Shared Function SalvaNuovoElementoGraficoDaChiaveAlbero(ByVal ChiaveAlbero As ChiaveAlbero,
                                                                   ByVal hiddenPunti_Nuovo As String,
                                                                   ByVal Area As String,
                                                                   ByVal ElementoGrafico_Des As String,
                                                                   ByRef objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri) As SalvaNuovoMultiPoint_Out
        Dim list_NuoveEntita As New List(Of Obj_SalvaGrafica)

        'se non impostato il tipo di nodo dell'albero allora occorre gestirlo.
        If ChiaveAlbero.TipoNodo = enum_TipoNodo.Indefinito Then
            Dim LeggiChiave As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
            Dim dtChiave As DataTable = LeggiChiave.TipoNodoAlebroAnagrafeDaChiaviImpianto(ChiaveAlbero.Piva,
                                                                                           ChiaveAlbero.Sa_Cod,
                                                                                           ChiaveAlbero.Appezza,
                                                                                           ChiaveAlbero.Id_Imp,
                                                                                           "",
                                                                                           "",
                                                                                           objParametri_Server)

            If dtChiave.Rows.Count = 0 Then
                ChiaveAlbero.TipoNodo = enum_TipoNodo.ImpiantoNudo

            Else
                ChiaveAlbero.TipoNodo = dtChiave.Rows(0)("TipoNodoAlberoAnagrafe")

            End If
        End If

        Dim ob_jImpianto As New AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo

        ob_jImpianto.Piva = ChiaveAlbero.Piva
        ob_jImpianto.Sa_Cod = ChiaveAlbero.Sa_Cod
        ob_jImpianto.Appezza = ChiaveAlbero.Appezza
        ob_jImpianto.Id_reg = ChiaveAlbero.Id_Imp

        If ChiaveAlbero.TipoNodo = enum_TipoNodo.Campo Then
            ob_jImpianto.campo_cod = ChiaveAlbero.Campo_Cod

        End If

        Dim Programmazione_Entita_Cod As Integer = CInt(ChiaveAlbero.Programmazione_Entita_Cod)
        Dim Programmazione_Cod As Integer = CInt(ChiaveAlbero.Programmazione_Cod)


        Dim leggiTipoEntita As New AgronicaCoreGisDAL.GIS_TipoEntita_R
        Dim dtleggiTipoEntita As DataTable = leggiTipoEntita.Leggi(0,
                                                                   ChiaveAlbero.TipoNodo,
                                                                   enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                   "",
                                                                   "",
                                                                   objParametri_Server)

        Dim PropagazioneSalvataggioPoligono As enum_PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.NessunaPropagazione
        If Area <> "" Then
            AreaAppezzaImpiantoModificaConVerificaAgenda(Area,
                                                         objParametri_Server,
                                                         ChiaveAlbero.Piva,
                                                         ChiaveAlbero.Sa_Cod,
                                                         ChiaveAlbero.Appezza,
                                                         ChiaveAlbero.Id_Imp,
                                                         PropagazioneSalvataggioPoligono)
        End If

        Dim Tipo_entita_cod As Integer = dtleggiTipoEntita.Rows(0)("TipoEntita_Cod")
        Dim LayerElementiGrafici_Cod As Integer = dtleggiTipoEntita.Rows(0)("LayerElementiGrafici_Cod")

        Dim streerore As String = ""

        Dim leggiCFGStaticMap As New Configurazione_Siti_R
        Dim jSonStaticMapCFG As String = leggiCFGStaticMap.Leggi_Valore(0,
                                                                        "GIS_StaticMapCFG",
                                                                        "",
                                                                        "",
                                                                        objParametri_Server)

        Dim inSalvaGraficaDati As InSalvaGraficaModel

        If Tipo_entita_cod = enum_GIS2012_TipoEntita.CATASTO Then
            inSalvaGraficaDati = New InSalvaGraficaModel(Entita_cod:=0,
                                                         CatastoProv:=ChiaveAlbero.p_Provincia_Cod,
                                                         CatastoCom:=ChiaveAlbero.p_Comune_Cod,
                                                         CatastoSezione:=ChiaveAlbero.p_Sezione,
                                                         CatastoFoglio:=ChiaveAlbero.p_Foglio,
                                                         CatastoNumero:=ChiaveAlbero.p_Numero,
                                                         CatastoSubalterno:=ChiaveAlbero.p_Subalterno,
                                                         HiddenPunti:=hiddenPunti_Nuovo,
                                                         Tipo_entita_cod:=Tipo_entita_cod,
                                                         ElementoGrafico_DES:="",
                                                         layer_codAtt:=LayerElementiGrafici_Cod)

        Else
            inSalvaGraficaDati = New InSalvaGraficaModel(piva:=ChiaveAlbero.Piva,
                                                         sa_cod:=ChiaveAlbero.Sa_Cod,
                                                         Entita_cod:=0,
                                                         hiddenPunti:=hiddenPunti_Nuovo,
                                                         programmazione_cod:=Programmazione_Cod,
                                                         programmazione_entita_cod:=Programmazione_Entita_Cod,
                                                         Tipo_entita_cod:=Tipo_entita_cod,
                                                         objImpianto:=ob_jImpianto,
                                                         ElementoGrafico_DES:=ElementoGrafico_Des,
                                                         layer_codAtt:=LayerElementiGrafici_Cod,
                                                         id_agenda:=ChiaveAlbero.Id_Agenda,
                                                         id_Mov_Det:=0,
                                                         analisi_campione_cod:=ChiaveAlbero.Analisi_Campione_Cod)

            ' VAnni: 29/9/2021: GIS_StaticMapCFG            
            If Not String.IsNullOrEmpty(jSonStaticMapCFG) Then
                inSalvaGraficaDati.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(jSonStaticMapCFG)
                inSalvaGraficaDati.StaticMapCFG.EntitaCod = 0

            End If

        End If

        Dim esito As Boolean
        ModificaImpiantoSalvaEntitaConGestionePropagazione2(inSalvaGraficaDati,
                                                            enum_TipoOperazioneDB.Scrittura,
                                                            objParametri_Server,
                                                            list_NuoveEntita,
                                                            PropagazioneSalvataggioPoligono,
                                                            jSonStaticMapCFG,
                                                            esito)

        Dim objReturn_SalvaNuovoMultiPoint As New SalvaNuovoMultiPoint_Out With {
            .Esito = esito,
            .Lista_obj_SalvaGrafica = list_NuoveEntita
        }
        'TODO: cancellare appena testato
        'ModificaImpiantoSalvaEntitaConGestionePropagazione(
        '    enum_TipoOperazioneDB.Scrittura,
        '    0,
        '    hiddenPunti_Nuovo,
        '    objParametri_Server,
        '    streerore,
        '    Piva, Sa_Cod, Appezza, programmazione_entita_cod, programmazione_cod,
        '    risp,
        '    objImpianto, id_Agenda, id_mov_Det, Analisi_Campione_Cod, LayerElementiGrafici_Cod, PropagazioneSalvataggioPoligono, Tipo_entita_cod)

        Return objReturn_SalvaNuovoMultiPoint

    End Function

    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' Altra versione ModificaImpiantoSalvaEntitaConGestionePropagazione() che non restituisce una stringa ma un msg + una lista di Entita_Cod
    ''' </summary>
    ''' <param name="InSalvaGraficaModel"></param>
    ''' <param name="TipoOperazioneElementoPrincipale"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="list_Return_SalvaGrafica"></param>
    ''' <param name="PropagazioneSalvataggioPoligono"></param>
    ''' <param name="jSonStaticMapCFG"></param>
    ''' <param name="esito"></param>
    Public Shared Sub ModificaImpiantoSalvaEntitaConGestionePropagazione2(ByVal InSalvaGraficaModel As InSalvaGraficaModel,
                                                                          ByVal TipoOperazioneElementoPrincipale As enum_TipoOperazioneDB,
                                                                          ByRef objParametri_Server As AgronicaCoreParametri,
                                                                          ByRef list_Return_SalvaGrafica As List(Of Obj_SalvaGrafica),
                                                                          ByRef PropagazioneSalvataggioPoligono As enum_PropagazioneSalvataggioPoligono,
                                                                          ByVal jSonStaticMapCFG As String,
                                                                          ByRef esito As Boolean)

        If InSalvaGraficaModel.LayerCodAtt <> 19 Then
            'le propagazioni sono disponibili solo in layer impianti reali (19)
            PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.NessunaPropagazione

        End If

        'procedo al salvataggio dell'impianto o di quel che è in ogni caso,
        If PropagazioneSalvataggioPoligono <> enum_PropagazioneSalvataggioPoligono.Appezzamento Then
            Dim obj_Return_SalvaGrafica As Obj_SalvaGrafica = SalvaGrafica2(InSalvaGraficaModel,
                                                                            objParametri_Server,
                                                                            TipoOperazioneElementoPrincipale)
            list_Return_SalvaGrafica.Add(obj_Return_SalvaGrafica)
            esito = (esito And obj_Return_SalvaGrafica.Esito)
        End If

        'decido se salvare o meno l'appezzamento.
        If PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.Appezzamento Or
            PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.ImpiantoEdAppezzamento Then

            Dim tipoNodoAlbero As Integer = 0
            Dim leggiTipoNodoAlbero As New AgronicaCoreGisDAL.GIS_TipoEntita_R

            Dim dtTipoNodoalbero As DataTable = leggiTipoNodoAlbero.Leggi(InSalvaGraficaModel.TipoEntitaCod,
                                                                          0,
                                                                          enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                          "",
                                                                          "",
                                                                          objParametri_Server)

            If dtTipoNodoalbero.Rows.Count = 0 Then
                Throw New Exception(My.Resources.AgronicaControlliGIS.V_M_ModificaImpiantoSalvaEntitaConGestionePropagazione_Tipo_di_nodo_albero_non_decodificato)
            Else
                tipoNodoAlbero = dtTipoNodoalbero(0)("TipoNodoAlberoAnagrafe")
            End If

            'il campo_Cod non è indispensabile perché si salva un appezzamento, non un campo...
            Dim chiaveAlbero As String = ""
            Albero.ChiaveAlbero_Codifica_x_json_faster(Chiave:=chiaveAlbero,
                                                       TipoNodo:=tipoNodoAlbero,
                                                       Piva:=InSalvaGraficaModel.Piva,
                                                       Sa_Cod:=InSalvaGraficaModel.SaCod,
                                                       Campo_Cod:=0,
                                                       Appezza:=InSalvaGraficaModel.ObjImpianto.Appezza)

            Dim rval1 As v_m_DatiGisSuElementiAnagraficiCollegati = ControllaEsistonoDatiGisSuElementiAnagraficiCollegati(chiaveAlbero,
                                                                                                                          objParametri_Server)
            InSalvaGraficaModel.ObjImpianto.Id_reg = 0

            If rval1.DatiGisSuElementiAnagraficiCollegati_Lista_Entita_Cod.Count = 0 Then
                'nuovo appezzamento se non esiste             
                Dim InSalvaGraficaNuovo As New InSalvaGraficaModel(InSalvaGraficaModel.Piva,
                                                                   InSalvaGraficaModel.SaCod,
                                                                   0,
                                                                   InSalvaGraficaModel.HiddenPunti,
                                                                   0,
                                                                   0,
                                                                   enum_GIS2012_TipoEntita.APPEZZAMENTI,
                                                                   InSalvaGraficaModel.ObjImpianto,
                                                                   "",
                                                                   enum_Gis_LayerElementiGrafici_std.APPEZZAMENTI,
                                                                   0,
                                                                   0,
                                                                   0)

                ' Vanni: 29/9/2021: GIS_StaticMapCFG
                If Not String.IsNullOrEmpty(jSonStaticMapCFG) Then
                    InSalvaGraficaNuovo.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(jSonStaticMapCFG)
                    InSalvaGraficaNuovo.StaticMapCFG.EntitaCod = 0
                End If

                Dim obj_Return_SalvaGrafica As Obj_SalvaGrafica = SalvaGrafica2(InSalvaGraficaNuovo,
                                                                                objParametri_Server,
                                                                                TipiEnumerativi.enum_TipoOperazioneDB.Scrittura)
                list_Return_SalvaGrafica.Add(obj_Return_SalvaGrafica)
                esito = (esito And obj_Return_SalvaGrafica.Esito)

            Else

                'dati per appezzamento se esiste.
                For Each appPiccolo In rval1.DatiGisSuElementiAnagraficiCollegati_Lista_Entita_Cod

                    Dim InSalvaGraficaAggiorna As New InSalvaGraficaModel(appPiccolo.Piva,
                                                                          appPiccolo.Sa_Cod,
                                                                          appPiccolo.Entita_Cod,
                                                                          InSalvaGraficaModel.HiddenPunti,
                                                                          0,
                                                                          0,
                                                                          enum_GIS2012_TipoEntita.APPEZZAMENTI,
                                                                          InSalvaGraficaModel.ObjImpianto,
                                                                          "",
                                                                          enum_Gis_LayerElementiGrafici_std.APPEZZAMENTI,
                                                                          0,
                                                                          0,
                                                                          0)

                    ' VAnni: 29/9/2021: GIS_StaticMapCFG
                    If Not String.IsNullOrEmpty(jSonStaticMapCFG) Then
                        InSalvaGraficaAggiorna.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(jSonStaticMapCFG)
                        InSalvaGraficaAggiorna.StaticMapCFG.EntitaCod = appPiccolo.Entita_Cod
                    End If

                    Dim obj_Return_SalvaGrafica As Obj_SalvaGrafica = SalvaGrafica2(InSalvaGraficaAggiorna,
                                                                                    objParametri_Server,
                                                                                    TipiEnumerativi.enum_TipoOperazioneDB.Modifica)
                    list_Return_SalvaGrafica.Add(obj_Return_SalvaGrafica)
                    esito = (esito And obj_Return_SalvaGrafica.Esito)

                Next

            End If

        End If

    End Sub

    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' Salvataggio del dato cartografico (versione che restituisce obj e non stringa)
    ''' </summary>
    ''' <param name="inSalvaGraficaModel"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="TipoOperazioneDB"></param>
    ''' <param name="flag_gps">indica se il dato proviene da GPS, TODO: Renere il parametro Obbligatorio e modificare le chiamate di conseguenza</param>
    ''' <param name="inviato"></param>
    ''' <returns>Stringa contenente eventuali errori in salvataggio.</returns>
    Public Shared Function SalvaGrafica2(inSalvaGraficaModel As InSalvaGraficaModel,
                                         ByRef objParametri_Server As AgronicaCoreParametri,
                                         ByVal TipoOperazioneDB As Integer,
                                         Optional ByVal flag_gps As String = "",
                                         Optional ByVal inviato As Integer = 0) As Obj_SalvaGrafica

        Dim r As New Obj_SalvaGrafica
        Dim FlagConnessioneLocale, FlagTransazioneLocale As Boolean

        Try

            Dim xDocRval As XDocument = XDocument.Parse("<DatiEntita xmlns=""http://www.agronica.it/grafica/"" xmlns:gml=""http://www.opengis.net/gml""></DatiEntita>")
            Dim lay = <layersdescrizioni>
                          <layer tipologia_layer="1" nome_layer="entità">
                          </layer>
                      </layersdescrizioni>

            xDocRval.Root.Add(lay)

            Dim appezza As Integer = 0
            Dim id_reg As Integer = 0
            Dim Campo_cod As Integer = 0

            If Not inSalvaGraficaModel.ObjImpianto Is Nothing Then
                appezza = inSalvaGraficaModel.ObjImpianto.Appezza
                id_reg = inSalvaGraficaModel.ObjImpianto.Id_reg
                Campo_cod = inSalvaGraficaModel.ObjImpianto.campo_cod

            End If

            Dim newEntitaElement = <Entita TipoOperazioneDB=<%= TipoOperazioneDB %> ecolor="256" eline="256" rad="15" text=<%= inSalvaGraficaModel.ElementoGraficoDes %> validita_inizio="01/01/1900" validita_fine="31/12/2100" username_creazione="" username_modifica="">
                                       <layers>
                                           <layer tipologia_layer="1"><%= inSalvaGraficaModel.LayerCodAtt %></layer>
                                       </layers>
                                       <EntitaGIAS>
                                           <DatoGias>
                                               <PivaSuperUser><%= objParametri_Server.PivaSuperUser %></PivaSuperUser>
                                               <Entita_Cod><%= inSalvaGraficaModel.EntitaCod %></Entita_Cod>
                                               <TipoEntita_Cod><%= inSalvaGraficaModel.TipoEntitaCod %></TipoEntita_Cod>
                                               <Piva><%= inSalvaGraficaModel.Piva %></Piva>
                                               <Sa_Cod><%= inSalvaGraficaModel.SaCod %></Sa_Cod>
                                               <Appezza><%= appezza %></Appezza>
                                               <Campo_Cod><%= Campo_cod %></Campo_Cod>
                                               <Id_Imp><%= id_reg %></Id_Imp>
                                               <PROV><%= inSalvaGraficaModel.CatastoProv %></PROV>
                                               <COM><%= inSalvaGraficaModel.CatastoCom %></COM>
                                               <SEZIONE><%= inSalvaGraficaModel.CatastoSezione %></SEZIONE>
                                               <FOGLIO><%= inSalvaGraficaModel.CatastoFoglio %></FOGLIO>
                                               <NUMERO><%= inSalvaGraficaModel.CatastoNumero %></NUMERO>
                                               <SUBALTERNO><%= inSalvaGraficaModel.CatastoSubalterno %></SUBALTERNO>
                                               <Programmazione_Entita_Cod><%= inSalvaGraficaModel.ProgrammazioneEntitaCod %></Programmazione_Entita_Cod>
                                               <Programmazione_Cod><%= inSalvaGraficaModel.ProgrammazioneCod %></Programmazione_Cod>
                                               <Id_Agenda><%= inSalvaGraficaModel.IdAgenda %></Id_Agenda>
                                               <id_mov_det><%= inSalvaGraficaModel.IdMovDet %></id_mov_det>
                                               <analisi_campione_cod><%= inSalvaGraficaModel.AnalisiCampioneCod %></analisi_campione_cod>
                                               <OLDGrafica_ID></OLDGrafica_ID>
                                               <inviato><%= inviato %></inviato>
                                               <Data_Creazione><%= Now.ToLongDateString %></Data_Creazione>
                                               <Data_Modifica><%= Now.ToLongDateString %></Data_Modifica>
                                               <Username_Creazione><%= objParametri_Server.UsernameOperazione %></Username_Creazione>
                                               <Username_Modifica><%= objParametri_Server.UsernameOperazione %></Username_Modifica>
                                               <Validita_Inizio>1900-01-01T00:00:00</Validita_Inizio>
                                               <Validita_Fine>2100-12-31T00:00:00</Validita_Fine>
                                           </DatoGias>
                                       </EntitaGIAS>
                                   </Entita>

            'se non sto cancellando incapsulo la grafica

            Dim sNodeDoc As XDocument

            Dim wktToGeoML As New wkt_gml
            Dim wktHelp As New WKT

            'valore che non serve a nulla quando si cancella

            Dim coord As String = ""

            If TipoOperazioneDB = TipiEnumerativi.enum_TipoOperazioneDB.Cancellazione Then
                inSalvaGraficaModel.HiddenPunti = "(44.485001332738115, 11.794383116803829),(44.48301117678287, 11.795177050672237),(44.48385317412669, 11.793932505689327)"
            End If

            coord = GetCoord(inSalvaGraficaModel.HiddenPunti)

            Dim gmlCoord As String = wktToGeoML.Trasforma(coord,
                                                          False,
                                                          False,
                                                          False,
                                                          0)
            sNodeDoc = XDocument.Parse(gmlCoord)

            If flag_gps = "" Then
                flag_gps = "0"
            End If

            Dim elementoGrafico_Cod As Integer = 0

            If TipoOperazioneDB <> enum_TipoOperazioneDB.Scrittura Then
                Dim letturaElementoGrafico As New AgronicaCoreGisDAL.GIS_ElementiGrafici_R
                Dim dtLetturaElmenetoGrafico As DataTable = letturaElementoGrafico.Leggi("",
                                                                                         0,
                                                                                         inSalvaGraficaModel.EntitaCod,
                                                                                         0,
                                                                                         enumFromatoCartograficoConvertito.Nessuna_Conversione,
                                                                                         enumSelezioneVariabile.Selezione_TabellaDatiMinimi,
                                                                                         "",
                                                                                         "",
                                                                                         objParametri_Server)

                If dtLetturaElmenetoGrafico.Rows.Count = 1 Then
                    elementoGrafico_Cod = dtLetturaElmenetoGrafico(0)("ElementoGrafico_Cod")

                Else
                    Throw New Exception(My.Resources.AgronicaControlliGIS.V_M_SalvaGrafica_Errore_assenza_elemento_grafico_entità_gis_ _
                                        & inSalvaGraficaModel.EntitaCod)

                End If

            End If

            sNodeDoc.Root.@Flag_GPS = flag_gps
            sNodeDoc.Root.@ElementoGrafico_Cod = elementoGrafico_Cod

            newEntitaElement.Add(sNodeDoc.FirstNode)

            xDocRval.Root.Add(newEntitaElement)

            Dim ListaNS As New List(Of String)
            ListaNS.Add("http://www.opengis.net/gml")

            Dim rval As String = xmlHelper.RemoveNamespace(xDocRval, ListaNS).ToString.Replace("xmlns=""""", "")

            Dim tmpDoc As XDocument = XDocument.Parse(rval)

            'scrive le entità

            Dim listOFEntita = (From a In tmpDoc.<DatiEntita>.<Entita>
                                Select a).ToList()

            Dim conteggioNonImportati As Integer = 0

            Dim ScriviElementiGrafici As New AgronicaCoreGisBIZ.GIS_Entita_W
            Dim EsitoGrafica As Boolean = True

            Dim lista_EntitaCod_Nuovi As New List(Of Chiave_SalvaGrafica_Out)

            For Each elemento In listOFEntita

                Try

                    'transazione sulla singola chiamata di un entità grafica/GIAS

                    Utility.VerificaApriTransazione(objParametri_Server, FlagConnessioneLocale, FlagTransazioneLocale)

                    Dim OutputEntitaCod As Integer = -1


                    EsitoGrafica = ScriviElementiGrafici.scrivi(elemento.ToString, OutputEntitaCod, objParametri_Server)

                    lista_EntitaCod_Nuovi.Add(New Chiave_SalvaGrafica_Out With {
                                            .Piva = objParametri_Server.PivaSuperUser,
                                            .Entita_Cod = OutputEntitaCod
                    })

                    If EsitoGrafica Then

                        If inSalvaGraficaModel.TipoEntitaCod = enum_GIS2012_TipoEntita.CentriAziendali Then
                            AggiornaCoordinateCentroAziendale(inSalvaGraficaModel.Piva,
                                                              inSalvaGraficaModel.SaCod,
                                                              objParametri_Server,
                                                              gmlCoord)
                        End If

                        Utility.VerificaChiudiTransazione(objParametri_Server, FlagTransazioneLocale)

                    End If

                    'se esiste una configurazione, questa è attiva ed il layer è presente in lista (o la lista è vuota)

                    If EsitoGrafica AndAlso
                        Not IsNothing(inSalvaGraficaModel.StaticMapCFG) AndAlso
                        inSalvaGraficaModel.StaticMapCFG.StaticMapAttive AndAlso
                        inSalvaGraficaModel.StaticMapCFG.LayerAbilitati.Contains(inSalvaGraficaModel.LayerCodAtt) Then

                        Dim gestioneStaticMaps As New GoogleStaticMaps
                        If OutputEntitaCod > 0 Then
                            inSalvaGraficaModel.StaticMapCFG.EntitaCod = OutputEntitaCod
                        End If
                        inSalvaGraficaModel.StaticMapCFG.objParametri_Server = objParametri_Server
                        gestioneStaticMaps.AggiornaElementoGraficoConMappaStatica(inSalvaGraficaModel.StaticMapCFG)
                    End If

                Catch ex As Exception

                    conteggioNonImportati += 1

                    Utility.VerificaAnnullaTransazione(objParametri_Server, FlagTransazioneLocale)

                Finally

                    Utility.VerificaChiudiConnessione(objParametri_Server, FlagConnessioneLocale)

                End Try


            Next

            ' VAnni: 24/2/2020: al momento non uso la versione in lingua (perchè occorre capire se un messaggio in lingua diversa non viene interpretato)

            If EsitoGrafica = False Then

                r.Messaggio = "Problemi nel salvare l'appezzamento, provare a disegnare un poligono senza lati che hanno intersezioni fra di loro."
                r.Esito = False
                r.Lista_ElementiGrafici = Nothing

            Else

                r.Messaggio = "Operazione eseguita correttamente."
                r.Esito = True
                r.Lista_ElementiGrafici = lista_EntitaCod_Nuovi

            End If

        Catch ex As Exception

            r.Messaggio = ex.Message
            r.Esito = False
            r.Lista_ElementiGrafici = Nothing

        Finally

        End Try

        Return r

    End Function

