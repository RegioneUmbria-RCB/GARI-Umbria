    Private Shared Function getFromVegCod(veg_cod As String) As Integer


        Dim objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")


        Dim vegLeggi As New AgronicaCoreMetaSchemaDAL.SpecieVegetali_R
        Dim dtVeg As DataTable =
        vegLeggi.Leggi(
            veg_cod,
            0,
            "",
            "",
            enumSelezioneVariabile.Selezione_TabellaCompleta,
            "",
            "",
            objParametri_Server
            )

        Dim gru_Cod As Integer = dtVeg.Rows(0)("gru_cod")

        Select Case gru_Cod
            Case 1
                Return 22
            Case 2
                Return 20
            Case 3
                Return 19
            Case Else
                Return 23
        End Select
    End Function

