        'dati dell'indirizzo 
        Ind.Via = via
        Ind.Frazione = frazione
        Ind.Stato = stato
        Ind.Note = ""

        Ind.Pro_Cod = "000"
        Ind.Com_Cod = "000"



        If comune.Length > 6 Then
            Ind.Pro_Cod = Left(comune, 3)
            Ind.Com_Cod = Right(Left(comune, 6), 3)
