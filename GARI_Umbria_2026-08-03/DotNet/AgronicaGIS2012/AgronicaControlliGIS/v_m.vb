    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="PoligonoWKT"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="objParametri_Utenti"></param>
    ''' <returns></returns>
    Public Shared Function CustomMapOverlayBase_InizializzaCalendario_2022(ByVal PoligonoWKT As String,
                                                                           ByRef objParametri_Server As AgronicaCoreParametri,
                                                                           ByRef objParametri_Utenti As AgronicaCoreParametri,
                                                                           ByRef objParametri_Super_Server As AgronicaCoreParametri,
                                                                           ByVal Optional checkPermessiUtente As Boolean = True
                                                                           ) As rispostaStandard(Of Lista_GisSat_SentinelOverlay_Out)

        Dim r As New rispostaStandard(Of Lista_GisSat_SentinelOverlay_Out)

        Dim permessiAnalisiDatiSat As Boolean = True

        If checkPermessiUtente Then
            Dim ObjUtenti As New AgronicaCoreUtentiDAL.Utenti_Permessi_R
            permessiAnalisiDatiSat = ObjUtenti.Controlla_Permessi_Utente(objParametri_Utenti.UtenteUsername,
                                                                         Id_Servizio_GiasOnline,
                                                                         enum_Security_Attivita.GIS_SAT_AnalisiDatiSatellitari,
                                                                         enum_Security_Operazione.Modifica,
                                                                         Date.Now,
                                                                         "",
                                                                         objParametri_Utenti)
        End If

        If Not permessiAnalisiDatiSat Then
            r.RispostaOK = False
            r.Errore = My.Resources.AgronicaControlliGIS.V_M_Richiesto_permesso_di_analisi_dati

        Else
            Dim basePath As String
            Dim leggiBasePath As New AgronicaCoreVarieDAL.Configurazione_Siti_R
            Dim letturaUtenti As New AgronicaCoreUtentiDAL.Utenti_Read

            basePath = leggiBasePath.Leggi_Valore(0,
                                                  "GiasOnline_WS_Mappe_2013",
                                                  "",
                                                  "",
                                                  objParametri_Server)

            basePath &= "MappeApi.svc/customMapOverlayBaseInizializzaCalendario"

            Dim payload As String = " { ""PoligonoWKT"": """ & PoligonoWKT & """ } "

            Dim user As String = objParametri_Server.SuperUserUsername
            Dim password As String = ""

            Dim dt_Utenti As DataTable = letturaUtenti.Leggi2(user,
                                                              "",
                                                              "",
                                                              objParametri_Utenti)

            If dt_Utenti.Rows.Count > 0 Then
                password = dt_Utenti.Rows(0).Item("Password")

            End If

            Dim nomeOggettoEmbed As String = "d"
            Dim xUtil As New AgronicaCoreUtility.Http
            Dim xRisp As String = xUtil.RestPostBasicAuth(basePath,
                                                          payload,
                                                          user,
                                                          password,
                                                          nomeOggettoEmbed)

            r = JsonConvert.DeserializeObject(Of rispostaStandard(Of Lista_GisSat_SentinelOverlay_Out))(xRisp)

        End If

        Return r

    End Function


    Public Shared Function AggiornaElencoTipologie4(
        ByRef objAggiElencoTipologieIn As AggiornaElencoTipologie_In,
        ByRef objParametri_Server As AgronicaCoreParametri,
        ByRef objParametri_Utenti As AgronicaCoreParametri
        ) As ElencoTipologieLayer

        'Inizializzazione parametri

        If Not IsNumeric(objAggiElencoTipologieIn.Layer_Selezionato) Then
            objAggiElencoTipologieIn.Layer_Selezionato = "0"
        End If

        If Not IsNumeric(objAggiElencoTipologieIn.Sementieri_Sportello_Configurazione_cod) Then
            objAggiElencoTipologieIn.Sementieri_Sportello_Configurazione_cod = "0"
        End If

        'Copia layer da superuser

        If objAggiElencoTipologieIn.leggiLayerNonVisibili Then
            SeInserisciLayerDefaultSuperUser(objParametri_Server, objParametri_Utenti)
        End If

        'Generazione colorazione automatica

        ColorazioneAutomatica_2022(objAggiElencoTipologieIn.Layer_Selezionato, objParametri_Server)

        'Verifica se aggiungere layer imprese

        Dim lAggiungiLayer_Imprese As Boolean = False
        If Not String.IsNullOrEmpty(objAggiElencoTipologieIn.Layer_Selezionato) AndAlso
           objAggiElencoTipologieIn.Layer_Selezionato = enum_TipologiaLayer.Organizzazione Then
            lAggiungiLayer_Imprese = True
        End If

        'Lettura permessi WMS

        Dim ObjUtenti As New AgronicaCoreUtentiDAL.Utenti_Permessi_R

        Dim permessiWMS As Boolean = ObjUtenti.Controlla_Permessi_Utente(
            objParametri_Utenti.UtenteUsername,
            enum_Id_Servizio.GiasOnline,
            enum_Security_Attivita.GIS_VisualizzazioneGestioneWMS,
            enum_Security_Operazione.Modifica,
            Date.Now,
            "",
            objParametri_Utenti)

        Dim permessiDatiSatellitari As Boolean = ObjUtenti.Controlla_Permessi_Utente(
            objParametri_Utenti.UtenteUsername,
            enum_Id_Servizio.GiasOnline,
            enum_Security_Attivita.GIS_SAT_AnalisiDatiSatellitari,
            enum_Security_Operazione.Modifica,
            Date.Now,
            "",
            objParametri_Utenti)

        Dim permessiTecniciInCampo As Boolean = ObjUtenti.Controlla_Permessi_Utente(
            objParametri_Utenti.UtenteUsername,
            enum_Id_Servizio.GiasOnline,
            enum_Security_Attivita.ReportPercorsi,
            enum_Security_Operazione.Modifica,
            Date.Now,
            "",
            objParametri_Utenti)

        Dim analisiProduttivita As Boolean = ObjUtenti.Controlla_Permessi_Utente(
            objParametri_Utenti.UtenteUsername,
            enum_Id_Servizio.GiasOnline,
            enum_Security_Attivita.AnalisiProduttivita,
            enum_Security_Operazione.Modifica,
            Date.Now,
            "",
            objParametri_Utenti)

        'Caricamento layer

        Dim objLayerBiz As New GIS_LayerElementiGrafici

        Dim elencoTipologie = objLayerBiz.GetElencoTipoligieLayers(
            objParametri_Server.PivaSuperUser,
            objAggiElencoTipologieIn.Layer_Selezionato,
            permessiWMS,
            permessiDatiSatellitari,
            permessiTecniciInCampo,
            analisiProduttivita,
            objAggiElencoTipologieIn.leggiLayerNonVisibili,
            objAggiElencoTipologieIn.leggiLayerNonAttivi,
            CInt(objAggiElencoTipologieIn.Sementieri_Sportello_Configurazione_cod),
            objParametri_Server,
            objParametri_Utenti)

        'Se tipologia layer standard e layer non trovati, vengono copiati da superuser e riletti

        If objAggiElencoTipologieIn.Layer_Selezionato = enum_TipologiaLayer.Std AndAlso (elencoTipologie Is Nothing OrElse elencoTipologie.ListaTipologieLayer.Count = 0) Then

            SeInserisciLayerDefaultSuperUser(objParametri_Server, objParametri_Utenti)

            elencoTipologie = objLayerBiz.GetElencoTipoligieLayers(
                objParametri_Server.PivaSuperUser,
                objAggiElencoTipologieIn.Layer_Selezionato,
                permessiWMS,
                permessiDatiSatellitari,
                permessiTecniciInCampo,
                analisiProduttivita,
                objAggiElencoTipologieIn.leggiLayerNonVisibili,
                objAggiElencoTipologieIn.leggiLayerNonAttivi,
                CInt(objAggiElencoTipologieIn.Sementieri_Sportello_Configurazione_cod),
                objParametri_Server,
                objParametri_Utenti)

        End If

        Return elencoTipologie

    End Function


    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="objSalvaColoriLayer2"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <returns></returns>
    ''' 
    Public Shared Function SalvaColoriLayer2_2022(ByVal objSalvaColoriLayer2 As SalvaColoriLayer2_In,
                                                  ByRef objParametri_Server As AgronicaCoreParametri) As RispostaStandard
        Dim r As New RispostaStandard

        Dim FlagTransazioneLocale As Boolean = False
        Dim FlagConnessioneLocale As Boolean = False

        Try

            AgronicaCoreDataProvider.ConnessioniTransazioni.ApriConnessioneXCoreBiz(FlagConnessioneLocale,
                                                                                    FlagTransazioneLocale,
                                                                                    objParametri_Server)

            If objSalvaColoriLayer2.Tipologia = 1 Then

                'GIS_LayerElementiGrafici

                Dim objMod As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_W

                For Each row In objSalvaColoriLayer2.ListaDatiLayer

                    row.Trasparenza = Double.Parse(row.Trasparenza, System.Globalization.CultureInfo.InvariantCulture).ToString

                    r.RispostaOK = objMod.Modifica_Colori(objParametri_Server.PivaSuperUser,
                                                          objParametri_Server.UtenteUsername,
                                                          row.ID,
                                                          row.TipologiaLayer_Cod,
                                                          row.Colore_Primario,
                                                          row.Colore_Secondario,
                                                          row.Varianza,
                                                          row.Trasparenza,
                                                          row.MostraDescrizioneAssociata,
                                                          row.ZIndex,
                                                          row.Flag_Visibile,
                                                          "",
                                                          objParametri_Server)

                    If Not r.RispostaOK Then
                        Throw New Exception("Si è verificato un errore nella modifica colori")
                    End If

                Next

            Else

                'GIS_LayerTiles

                Dim objModTiles As New AgronicaCoreGisDAL.GIS_LayerTiles_W
                Dim objLayerTilesDescrizioneBIZ As New AgronicaCoreGisBIZ.GIS_LayerTilesDescrizione_W

                For Each row In objSalvaColoriLayer2.ListaDatiTema

                    r.RispostaOK = objModTiles.Modifica_colori(objParametri_Server.PivaSuperUser,
                                                               row.LayerElementiGrafici_Cod,
                                                               row.ID,
                                                               row.TipologiaLayer_Cod,
                                                               objParametri_Server.UtenteUsername,
                                                               row.Colore_Primario,
                                                               row.Colore_Secondario,
                                                               row.Varianza,
                                                               objParametri_Server)

                    If Not r.RispostaOK Then
                        Throw New Exception("Si è verificato un errore nella modifica colori")
                    End If

                    If row.layerDescrizione_aggiungi IsNot Nothing AndAlso row.layerDescrizione_aggiungi.Count > 0 Then

                        r = objLayerTilesDescrizioneBIZ.SalvaLayerTilesDescrizione(row.layerDescrizione_aggiungi,
                                                                                   False,
                                                                                   objParametri_Server)

                        If Not r.RispostaOK Then
                            Throw New Exception(r.Errore)
                        End If

                    End If

                    If row.layerDescrizione_modifica IsNot Nothing AndAlso row.layerDescrizione_modifica.Count > 0 Then

                        r = objLayerTilesDescrizioneBIZ.AggiornaLayerTilesDescrizione(row.layerDescrizione_modifica,
                                                                                      False,
                                                                                      objParametri_Server)
                        If Not r.RispostaOK Then
                            Throw New Exception(r.Errore)
                        End If

                    End If

                    If row.layerDescrizione_elimina IsNot Nothing AndAlso row.layerDescrizione_elimina.Count > 0 Then

                        r = objLayerTilesDescrizioneBIZ.EliminaLayerTilesDescrizione(row.layerDescrizione_elimina,
                                                                                     False,
                                                                                     objParametri_Server)
                        If Not r.RispostaOK Then
                            Throw New Exception(r.Errore)
                        End If

                    End If
                Next

            End If

            r.RispostaStringa = "OK"
            r.RispostaOK = True

            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazioneXCoreBiz(FlagTransazioneLocale, objParametri_Server)
        Catch ex As Exception

            'Faccio il rollback della transazione
            If Not objParametri_Server.objTransazione Is Nothing Then
                'objParametri.objTransazione.Rollback()
                'objParametri.objTransazione = Nothing
                AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazione(2, objParametri_Server)
            End If

            r.RispostaOK = False
            r.RispostaStringa = ex.Message
        Finally
            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiConnessioneXCoreBiz(FlagConnessioneLocale, objParametri_Server)
        End Try

        Return r

    End Function

