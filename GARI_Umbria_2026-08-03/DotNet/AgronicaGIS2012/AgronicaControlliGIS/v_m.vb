    Private Shared Sub SeInserisciLayerDefaultSuperUser(ByRef objParametri_Server As AgronicaCoreParametri,
                                                        ByRef objParametri_Utenti As AgronicaCoreParametri,
                                                        Optional ByRef objLayerEntita As AgronicaCoreGisDAL.GIS_LayerElementiGrafici_R = Nothing)

        If objParametri_Server.PivaSuperUser = objParametri_Server.UsernameOperazione Then

            Try

                Dim oneShot As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_W

                oneShot.UpdateSuperUserOneShot(objParametri_Server.PivaSuperUser, objParametri_Server)

            Catch e As Exception

            End Try

        End If

        'leggo tutte le impostazioni del superuser e incollo i default del superuser

        If IsNothing(objLayerEntita) Then
            objLayerEntita = New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_R
        End If

        Dim DT_SuperUser As DataTable
        DT_SuperUser = objLayerEntita.Leggi(objParametri_Server.PivaSuperUser, objParametri_Server.SuperUserUsername, 0, 0, AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta, "", " ZIndex ", objParametri_Server)

        Dim DT_UtenteCorrente As DataTable
        DT_UtenteCorrente = objLayerEntita.Leggi(objParametri_Server.PivaSuperUser, objParametri_Server.UtenteUsername, 0, 0, AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta, "", " ZIndex ", objParametri_Server)

        Dim dr() As DataRow

        Dim objW As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_W

        Dim leggiPermessiLayer As New AgronicaCoreGisBIZ.GIS_Permessi_Layer_R

        For i = 0 To DT_SuperUser.Rows.Count - 1

            Dim tipologiaLayerCod As String = DT_SuperUser.Rows(i).Item("TipologiaLayer_cod")
            Dim layerCod As String = DT_SuperUser.Rows(i).Item("LayerElementiGrafici_Cod")

            If Not IsNumeric(layerCod) OrElse (IsNumeric(layerCod) AndAlso layerCod <> 0) Then

                Dim filtroSelect = String.Format("LayerElementiGrafici_Cod='{0}' and TipologiaLayer_cod='{1}'",
                                                 layerCod,
                                                 tipologiaLayerCod)

                dr = DT_UtenteCorrente.Select(filtroSelect)

                If dr.Length = 0 Then

                    Dim scriviLayer = VerificaSeScriviLayer(objParametri_Server, objParametri_Utenti, leggiPermessiLayer, layerCod)

                    If scriviLayer Then

                        objW.Scrivi(objParametri_Server.PivaSuperUser,
                                    objParametri_Server.UtenteUsername,
                                    DT_SuperUser.Rows(i).Item("LayerElementiGrafici_Cod"),
                                    DT_SuperUser.Rows(i).Item("LayerElementiGrafici_Des"),
                                    DT_SuperUser.Rows(i).Item("Flag_Attivo"),
                                    DT_SuperUser.Rows(i).Item("Flag_Visibile"),
                                    IIf(IsDBNull(DT_SuperUser.Rows(i).Item("Colore_Base")), "", DT_SuperUser.Rows(i).Item("Colore_Base")),
                                    IIf(IsDBNull(DT_SuperUser.Rows(i).Item("Colore_Selezionato")), "", DT_SuperUser.Rows(i).Item("Colore_Selezionato")),
                                    IIf(IsDBNull(DT_SuperUser.Rows(i).Item("Colore_Primario")), "", DT_SuperUser.Rows(i).Item("Colore_Primario")),
                                    IIf(IsDBNull(DT_SuperUser.Rows(i).Item("Colore_Secondario")), "", DT_SuperUser.Rows(i).Item("Colore_Secondario")),
                                    DT_SuperUser.Rows(i).Item("Varianza"),
                                    DT_SuperUser.Rows(i).Item("Trasparenza"),
                                    DT_SuperUser.Rows(i).Item("MostraDescrizioneAssociata"),
                                    DT_SuperUser.Rows(i).Item("TipologiaLayer_cod"),
                                    DT_SuperUser.Rows(i).Item("ZIndex"),
                                    IIf(IsDBNull(DT_SuperUser.Rows(i).Item("icona16")), "", DT_SuperUser.Rows(i).Item("Icona16")),
                                    IIf(IsDBNull(DT_SuperUser.Rows(i).Item("icona32")), "", DT_SuperUser.Rows(i).Item("Icona32")),
                                    DT_SuperUser.Rows(i).Item("Validita_Inizio"),
                                    DT_SuperUser.Rows(i).Item("Validita_Fine"),
                                    objParametri_Server)

                    End If

                    'Lavez - 04/03/2025 - Aggiornamento GIS_LayerTiles per tematizzazione 
                    RibaltaLayerTilesFromSuperUserToCurrentUser(CInt(layerCod), objParametri_Server)

                End If

            End If

        Next

    End Sub

    Private Shared Sub RibaltaLayerTilesFromSuperUserToCurrentUser(ByVal layerCod As Integer,
                                                                   ByRef objParametri_Server As AgronicaCoreParametri)

        'leggo tutti le impostazioni del superuser e incollo i default del super user
        Dim objLayerTiles As New AgronicaCoreGisDAL.GIS_LayerTiles_R

        Dim DTSuperUser As DataTable = objLayerTiles.Leggi(
            objParametri_Server.PivaSuperUser,
            layerCod,
            0,
            0,
            objParametri_Server.SuperUserUsername,
            AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
            "",
            "",
            objParametri_Server)

        Dim dtUtenteCorrente As DataTable = objLayerTiles.Leggi(
            objParametri_Server.PivaSuperUser,
            layerCod,
            0,
            0,
            objParametri_Server.UtenteUsername,
            AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
            "",
            "",
            objParametri_Server)

        Dim objW As New AgronicaCoreGisDAL.GIS_LayerTiles_W

        For i = 0 To DTSuperUser.Rows.Count - 1
            Dim dr = dtUtenteCorrente.Select("LayerTiles_cod=" & DTSuperUser.Rows(i).Item("LayerTiles_cod") & " ")

            If dr.Length = 0 Then
                objW.Scrivi(
                    objParametri_Server.PivaSuperUser,
                    DTSuperUser.Rows(i).Item("LayerElementiGrafici_Cod"),
                    objParametri_Server.UtenteUsername,
                    DTSuperUser.Rows(i).Item("LayerTiles_Cod"),
                    DTSuperUser.Rows(i).Item("TipologiaLayer_cod"),
                    DTSuperUser.Rows(i).Item("LayerTiles_Des"),
                    IIf(IsDBNull(DTSuperUser.Rows(i).Item("Colore_Primario")), "FFFFFF", DTSuperUser.Rows(i).Item("Colore_Primario")),
                    IIf(IsDBNull(DTSuperUser.Rows(i).Item("Colore_Secondario")), "FFFFFF", DTSuperUser.Rows(i).Item("Colore_Secondario")),
                    IIf(IsDBNull(DTSuperUser.Rows(i).Item("Colore_Base")), "FFFFFF", DTSuperUser.Rows(i).Item("Colore_Base")),
                    IIf(IsDBNull(DTSuperUser.Rows(i).Item("Varianza")), "1", DTSuperUser.Rows(i).Item("Varianza")),
                    DTSuperUser.Rows(i).Item("Validita_Inizio"),
                    DTSuperUser.Rows(i).Item("Validita_Fine"),
                    objParametri_Server)
            End If
        Next
    End Sub

    Private Shared Function VerificaSeScriviLayer(ByRef objParametri_Server As AgronicaCoreParametri,
                                                  ByRef objParametri_Utenti As AgronicaCoreParametri,
                                                  ByRef leggiPermessiLayer As AgronicaCoreGisBIZ.GIS_Permessi_Layer_R,
                                                  ByVal layerCod As String) As Boolean
        Dim scriviLayer = True

        If IsLayerPersonalizzato(layerCod) Then

            'Verifica permessi utente per layer personalizzato

            Dim elencoPermessiLayer = leggiPermessiLayer.LeggiPermessiDaUtente(layerCod,
                                                                               objParametri_Utenti,
                                                                               objParametri_Server,
                                                                               objParametri_Server.UtenteUsername)

            If elencoPermessiLayer.utenti_permessi.Count = 0 Then

                scriviLayer = False

            Else

                Dim permessiLayerUtente = elencoPermessiLayer.utenti_permessi(0)

                If permessiLayerUtente.Flag_Inserimento = 0 AndAlso
                    permessiLayerUtente.Flag_Modifica = 0 AndAlso
                    permessiLayerUtente.Flag_Cancellazione = 0 AndAlso
                    permessiLayerUtente.Flag_Informazioni = 0 AndAlso
                    permessiLayerUtente.Flag_Amministrazione = 0 Then

                    scriviLayer = False

                End If

            End If

        End If

        Return scriviLayer

    End Function

    Private Shared Function IsLayerPersonalizzato(ByVal LayerElementiGrafici_Cod As Integer)
        Return LayerElementiGrafici_Cod >= 1000000
    End Function

    Public Shared Function SalvaColoriLayer2(ByVal Tipologia As Integer, ByVal Dati As String) As String

        Dim objParametri_server = HttpContext.Current.Session("ASG_objParametri_Server")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim lDatiSplittati As String() = Dati.Split("$")

        If Tipologia = 1 Then

            'GIS_LayerElementiGrafici

            Dim objMod As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_W

            Dim layerID, primario, secondario, varianza, trasparenza, MostraDescrizioneAssociata, zindex, visibile, tipologiaLayer_cod As String

            For Each riga In lDatiSplittati

                Dim cols As String() = riga.Split("|")

                layerID = cols(0)
                primario = cols(1)
                secondario = cols(2)
                varianza = cols(3)
                trasparenza = Double.Parse(cols(4), System.Globalization.CultureInfo.InvariantCulture).ToString()
                zindex = cols(5)
                visibile = cols(6)
                MostraDescrizioneAssociata = cols(7)
                tipologiaLayer_cod = cols(8)

                objMod.Modifica_Colori(
                    objParametri_server.PivaSuperUser,
                    objParametri_server.UtenteUsername,
                    layerID,
                    tipologiaLayer_cod,
                    primario,
                    secondario,
                    varianza,
                    trasparenza,
                    MostraDescrizioneAssociata,
                    zindex,
                    visibile,
                    "",
                    objParametri_server)

            Next

        Else

            'GIS_LayerTiles

            Dim objModTiles As New AgronicaCoreGisDAL.GIS_LayerTiles_W

            Dim tileID, primario, secondario, varianza, tipologiaLayer_cod, layerID As String

            For Each riga In lDatiSplittati

                Dim cols As String() = riga.Split("|")

                tileID = cols(0)
                primario = cols(1)
                secondario = cols(2)
                varianza = cols(3)
                tipologiaLayer_cod = cols(4)
                layerID = cols(5)

                objModTiles.Modifica_colori(
                    objParametri_server.PivaSuperUser,
                    layerID,
                    tileID,
                    tipologiaLayer_cod,
                    objParametri_server.UtenteUsername,
                    primario,
                    secondario,
                    varianza,
                    objParametri_server)

            Next

        End If

        Return "OK"

    End Function

