    Private Shared Sub CancellaImpiantoAppezzamento(objDati As DatiCancella,
                                                    objCancella As Cancella_In,
                                                    objParametri_Server As AgronicaCoreParametri,
                                                    objParametri_Utenti As AgronicaCoreParametri,
                                                    risposta As rispostaStandard(Of Cancella_Out),
                                                    objImpianto As AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo)

        If objDati.IsConsuntivo Then

            'Reale

            objImpianto = New AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo With {
                .TipoOperazioneDB_Impianto = enum_TipoOperazioneDB.Cancellazione,
                .Piva = objDati.piva,
                .Sa_Cod = objDati.sa_cod,
                .Appezza = objDati.appezza,
                .Id_reg = objDati.id_reg
            }

            Dim risultatoCancellaDatoAnagrafico As RispostaStandard

            Select Case objDati.tipoentita_cod

                Case enum_GIS2012_TipoEntita.APPEZZAMENTI

                    risultatoCancellaDatoAnagrafico = CancellaAppezzamento(objDati, objParametri_Server, objParametri_Utenti)

                Case enum_GIS2012_TipoEntita.IMPIANTI_ERBACEA,
                     enum_GIS2012_TipoEntita.IMPIANTI_ORTICOLA,
                     enum_GIS2012_TipoEntita.IMPIANTO_ARBOREA,
                     enum_GIS2012_TipoEntita.IMPIANTO_GENERICO,
                     enum_GIS2012_TipoEntita.IMPIANTO_NUDO

                    If objDati.EliminaImpiantoConEliminaAppezzamento Then

                        risultatoCancellaDatoAnagrafico = CancellaAppezzamento(objDati, objParametri_Server, objParametri_Utenti)

                    Else

                        risultatoCancellaDatoAnagrafico = CancellaImpianto(objDati, objParametri_Server, objParametri_Utenti)

                    End If

                Case Else

                    risultatoCancellaDatoAnagrafico = New RispostaStandard With {
                        .RispostaOK = True,
                        .RispostaStringa = My.Resources.AgronicaControlliGIS.V_M_Cancella_Nessun_elemento_anagrafico_associato & V_M.LineBreak
                    }

            End Select

            objDati.EsitoRispostaOK = risultatoCancellaDatoAnagrafico.RispostaOK
            objDati.StringaRisposta = risultatoCancellaDatoAnagrafico.RispostaStringa
            Dim msgErrore = risultatoCancellaDatoAnagrafico.Errore

            GestisciEsitoRispostaCancella(objDati, risposta, msgErrore)

        Else

            'Planning

            CancellaPlanning(objDati, objParametri_Server, risposta)

        End If

    End Sub

