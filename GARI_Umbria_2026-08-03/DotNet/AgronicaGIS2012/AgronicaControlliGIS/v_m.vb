    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="obj_CaricaDate_Def"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <returns></returns>
    Public Shared Function CaricaDateDefault_2022(ByVal obj_CaricaDate_Def As CaricaDate_Default_In,
                                                  ByRef objParametri_Server As AgronicaCoreParametri) As rispostaStandard(Of DateDefault_Out)
        Dim r As New rispostaStandard(Of DateDefault_Out) With {
            .RispostaStringa = New DateDefault_Out
        }

        r.RispostaStringa.Validita_Inizio = ""
        r.RispostaStringa.Validita_Fine = ""

        Dim gp As New GisPurpose(obj_CaricaDate_Def.Sementi,
                                 obj_CaricaDate_Def.SementiMappaturaLibera)

        Dim sportelloCod As Integer = gp.SementiSportelloCod()

        If sportelloCod <> -1 Then
            r.RispostaStringa.Validita_Inizio = Now.Date.ToShortDateString

            Dim leggiSportello As New AgronicaCoreSementieriDAL.Sportello_R
            Dim dtLeggiSportello As DataTable

            dtLeggiSportello = leggiSportello.Leggi(sportelloCod,
                                                    0,
                                                    AgronicaCoreDataProvider.CostantiPersonalizzate.AGRODATAINIZIO,
                                                    enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                    "",
                                                    objParametri_Server)

            If dtLeggiSportello.Rows.Count > 0 Then
                r.RispostaStringa.Validita_Fine = CDate(dtLeggiSportello.Rows(0)("validita_fine")).ToShortDateString

            End If

        End If

        r.RispostaOK = True

        Return r

    End Function

