    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' Uguale a VerificaVicini con utilizzo di Session, ma gestisce entrambi i casi (Entita_Cod o no)
    ''' </summary>
    ''' <param name="obj_VerificaVicini"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <returns></returns>
    Public Shared Function VerificaVicini(ByVal obj_VerificaVicini As VerificaVicini_In,
                                          ByRef objParametri_Server As AgronicaCoreParametri,
                                          ByRef objParametri_Utenti As AgronicaCoreParametri) As rispostaStandard(Of VerificaVicini_Out)
        Dim r As New rispostaStandard(Of VerificaVicini_Out) With {
            .RispostaStringa = New VerificaVicini_Out
        }

        If IsNothing(obj_VerificaVicini.Validita_Inizio) Then
            obj_VerificaVicini.Validita_Inizio = AGRODATAINIZIO
        End If

        If IsNothing(obj_VerificaVicini.Validita_Fine) Then
            obj_VerificaVicini.Validita_Fine = AGRODATAFINE
        End If

        If IsNothing(obj_VerificaVicini.Grva_Cod) Then
            obj_VerificaVicini.Grva_Cod = 0
        End If

        'utilizzo la versione di dtInterferenze_from_poligono() senza Session
        Dim dtInterferenze As DataTable = DtInterferenze_FromPoligono("",
                                                                      obj_VerificaVicini.Veg_Cod,
                                                                      obj_VerificaVicini.Grva_Cod,
                                                                      obj_VerificaVicini.Validita_Inizio,
                                                                      obj_VerificaVicini.Validita_Fine,
                                                                      obj_VerificaVicini.Sementi,
                                                                      obj_VerificaVicini.SementiMappaturaLibera,
                                                                      -1000,
                                                                      True,
                                                                      5,
                                                                      obj_VerificaVicini.HiddenPunti,
                                                                      objParametri_Server,
                                                                      objParametri_Utenti)

        Dim iEntitaCod As Integer = -1
        If Not String.IsNullOrEmpty(obj_VerificaVicini.Entita_Cod) Then
            If Not Integer.TryParse(obj_VerificaVicini.Entita_Cod, iEntitaCod) Then
                iEntitaCod = -1

            End If
        End If

        Dim Msg As String = ""
        Dim Elenco_Vicini As New List(Of Entita_Info_Out)

        If dtInterferenze Is Nothing Then
            Msg = AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_Poligono_non_corretto_riprovare)

        Else
            If dtInterferenze.Rows.Count = 0 Then
                Msg = AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_Nessuna_prossimità_rilevata)

            Else
                'Dim primo As Boolean = True

                For Each drowRisp As DataRow In dtInterferenze.Rows

                    If iEntitaCod <> drowRisp("Entita_Cod") Then
                        Dim indirizzo As String = drowRisp("Ind_des") _
                                                  & " " _
                                                  & drowRisp("frz_des") _
                                                  & " - " _
                                                  & drowRisp("cap") _
                                                  & " " _
                                                  & drowRisp("citta") _
                                                  & " " _
                                                  & drowRisp("provincia")

                        Dim dist As Double = drowRisp("DistanzaEffettiva")
                        Dim distanza As String

                        If dist > 1000 Then
                            distanza = Agro_Math.ArrotondaVal_3(dist / 1000).ToString("0.000") & " km"
                        Else
                            distanza = Agro_Math.ArrotondaVal_0(dist).ToString() & " mt"
                        End If

                        Dim EntitaVicina As New Entita_Info_Out With {
                            .Indirizzo = indirizzo,
                            .Referente = drowRisp("Referente"),
                            .Distanza = distanza,
                            .Veg_Des = drowRisp("veg_des"),
                            .Tipologia = ""
                        }

                        Elenco_Vicini.Add(EntitaVicina)

                    End If

                Next

            End If

        End If

        r.RispostaStringa.Messaggio = Msg
        r.RispostaStringa.Elenco_EntitaVicine = Elenco_Vicini

        Return r

    End Function

    ''' <summary>
