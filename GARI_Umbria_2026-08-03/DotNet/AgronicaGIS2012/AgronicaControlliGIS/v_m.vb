    ''' <summary>
    ''' '
    ''' </summary>
    ''' <param name="entita_cod"></param>
    ''' <param name="nome_appezza"></param>
    ''' <param name="sup_imp"></param>
    ''' <param name="data_inizio"></param>
    ''' <param name="data_fine"></param>
    ''' <param name="specie"></param>
    ''' <param name="varieta"></param>
    ''' <param name="finalita"></param>
    ''' <param name="tipologia"></param>
    ''' <param name="hiddenPunti_modifica"></param>
    ''' <param name="via_stringa"></param>
    ''' <param name="Codice_Fiscale_Tecnico"></param>
    ''' <param name="Lotto"></param>
    ''' <param name="codice_socio"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="Sementi"></param>
    ''' <param name="SementiMappaturaLibera"></param>
    ''' <param name="CodiciAnagrafeAggiuntivi">opzionale, stringa vuota</param>
    ''' <param name="ModificaAnagrafica">opzionale, ture</param>
    ''' <returns></returns>
    Public Shared Function ModificaImpianto(
        ByVal entita_cod As String,
        ByVal nome_appezza As String,
        ByVal sup_imp As String,
        ByVal data_inizio As String, ByVal data_fine As String,
        ByVal specie As String,
        ByVal varieta As String,
        ByVal finalita As String,
        ByVal tipologia As String,
        ByVal hiddenPunti_modifica As String,
        ByVal via_stringa As String,
        ByVal Codice_Fiscale_Tecnico As String,
        ByVal Lotto As String,
        ByVal codice_socio As String,
        ByVal objParametri_Server As AgronicaCoreParametri,
        ByVal objParametri_Utenti As AgronicaCoreParametri,
        ByVal Sementi As String,
        ByVal SementiMappaturaLibera As String,
        ByVal DatiPassaggio As String,
        ByVal CodiciAnagrafeAggiuntivi As String,
        ByVal ModificaAnagrafica As Boolean
    ) As RispostaStandard

        Dim Risposta_ModificaImpianto As New RispostaStandard



        Dim FlagConnessioneLocale As Boolean = False
        Dim FlagTransazioneLocale As Boolean = False
        Dim streerore As String = ""

        Try

            Dim leggiCFGStaticMap As New Configurazione_Siti_R
            Dim jSonStaticMapCFG As String = leggiCFGStaticMap.Leggi_Valore(0, "GIS_StaticMapCFG", "", "", objParametri_Server)


            AgronicaCoreDataProvider.ConnessioniTransazioni.ApriConnessioneXCoreBiz(FlagConnessioneLocale,
                                                                                    FlagTransazioneLocale,
                                                                                    objParametri_Server)

            Dim piva As String = ""
            Dim sa_cod As Integer
            Dim appezza As Integer
            Dim id_reg As Integer
            Dim programmazione_entita_cod As Integer
            Dim programmazione_cod As Integer

            Dim risp As Boolean = True
            Dim gp As New GisPurpose(Sementi, SementiMappaturaLibera)
            Dim Programmazione_Des As String = gp.SementiSportelloProgrammazione()

            Dim Preventivo1_Consuntivo2 As Integer = 0
            Dim objImpianto As AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo
            Dim objLeggiCodiciAnagrafe As New AgronicaCoreAnagrafeDAL.Imprese_Codici_Read
            Dim objScriviCodiciAnagrafe As New AgronicaCoreAnagrafeDAL.Imprese_Codici_Write
            Dim tipoentita_cod As Integer = 0
            Dim id_agenda As Integer = 0
            Dim id_Mov_Det As Integer = 0
            Dim analisi_campione_cod As Integer = 0
            Dim LayerElementiGrafici_Cod As Integer = 0

            Dim PropagazioneSalvataggioPoligono As enum_PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.NessunaPropagazione

            GetEntitaGiasFromEntitaGrafica(entita_cod, piva, sa_cod, appezza, id_reg, programmazione_entita_cod, programmazione_cod,
                                           objParametri_Server, objParametri_Utenti, Preventivo1_Consuntivo2, tipoentita_cod, id_agenda, id_Mov_Det, analisi_campione_cod,
                                           objImpianto, LayerElementiGrafici_Cod, Codice_Fiscale_Tecnico)


            'Vanni, 11/10/2016: se si passa da terreno nudo ad una specie/cultivar occorre re-impostare il dato del tipoEntita_Cod
            If Not String.IsNullOrEmpty(varieta) AndAlso
                Not String.IsNullOrEmpty(specie) AndAlso
                varieta <> "0" AndAlso
                varieta <> "null" AndAlso
                tipoentita_cod = enum_GIS2012_TipoEntita.IMPIANTO_NUDO AndAlso
                Preventivo1_Consuntivo2 = 2 Then

                tipoentita_cod = Get_TipoEntita_Cod_DatoVeg_cod(varieta, objParametri_Server)

            End If


            If String.IsNullOrEmpty(tipologia) Then
                tipologia = 0
            Else
                If tipologia = "null" Then
                    tipologia = 0
                End If
            End If

            If String.IsNullOrEmpty(finalita) Then
                finalita = 0
            Else
                If finalita = "null" Then
                    finalita = 0
                End If
            End If

            '  Vanni, 24/04/2014 15:02:59: salvataggio elementi generici
            If Not (LayerElementiGrafici_Cod = 19 Or LayerElementiGrafici_Cod = 33) Then


                Dim inSalvaGraficaDatiL1 As InSalvaGraficaModel

                If tipoentita_cod = enum_GIS2012_TipoEntita.CATASTO Then
                    inSalvaGraficaDatiL1 = New InSalvaGraficaModel(
                        Entita_cod:=entita_cod,
                        CatastoProv:="",
                        CatastoCom:="",
                        CatastoSezione:="",
                        CatastoFoglio:=0,
                        CatastoNumero:=0,
                        CatastoSubalterno:="",
                        HiddenPunti:=hiddenPunti_modifica,
                        Tipo_entita_cod:=tipoentita_cod,
                        ElementoGrafico_DES:="",
                        layer_codAtt:=LayerElementiGrafici_Cod
                    )

                Else
                    inSalvaGraficaDatiL1 = New InSalvaGraficaModel(
                        piva,
                        sa_cod,
                        entita_cod,
                        hiddenPunti_modifica,
                        programmazione_cod,
                        programmazione_entita_cod,
                        tipoentita_cod,
                        objImpianto,
                        "",
                        LayerElementiGrafici_Cod,
                        id_agenda,
                        id_Mov_Det,
                        analisi_campione_cod
                    )
                End If

                ' VAnni: 29/9/2021: GIS_StaticMapCFG                
                If Not String.IsNullOrEmpty(jSonStaticMapCFG) Then
                    inSalvaGraficaDatiL1.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(jSonStaticMapCFG)
                    inSalvaGraficaDatiL1.StaticMapCFG.EntitaCod = entita_cod
                End If

                streerore = SalvaGrafica(inSalvaGraficaDatiL1, risp, objParametri_Server, enum_TipoOperazioneDB.Modifica)

                Dim AreaAppezzamento As Decimal
                Dim AreaImpianto As Decimal
                Dim AssociazioneArea As enum_Gis_AssociaSuperficieA

                Dim gestionePropagazioneEsiste As Boolean


                'catasto..
                If LayerElementiGrafici_Cod = 3 Then

                    gestionePropagazioneEsiste =
                            PropagazioneSalvataggioPoligonoLeggi(sup_imp, AssociazioneArea, AreaImpianto, AreaAppezzamento, PropagazioneSalvataggioPoligono)

                    If gestionePropagazioneEsiste AndAlso AssociazioneArea = enum_Gis_AssociaSuperficieA.Catasto Then

                        Dim modificaPArticella As New AgronicaCoreAnagrafeDAL.ParticelleCatastali_W
                        Dim haConvert As New AgronicaCoreAnagrafeBIZ.Particella_R

                        Dim prov As String
                        Dim com As String
                        Dim sezione As String
                        Dim foglio As Integer
                        Dim numero As Integer
                        Dim subalterno As String

                        Dim ettari As Integer
                        Dim are As Integer
                        Dim centiare As Integer


                        AgronicaCoreDataProvider.Conversioni.EttariAreCentiare_from_Ettari(AreaAppezzamento, ettari, are, centiare)
                        GetEntitaCatastoGiasFromEntitaGrafica(entita_cod, prov, com, sezione, foglio, numero, subalterno, objParametri_Server, objParametri_Utenti)
                        modificaPArticella.Modifica_SuperficieParticella(prov, com, sezione, foglio, numero, subalterno, ettari, are, centiare, "", objParametri_Server)

                    End If

                Else



                    ' VAnni: 15/2/2018: se mi trovo sul layer appezzamento ed ho scelto di propagare le info all'impianto, allora procedo alla creazione di un nuovo impianto.
                    If (LayerElementiGrafici_Cod = 1) Then

                        gestionePropagazioneEsiste =
                            PropagazioneSalvataggioPoligonoLeggi(sup_imp, AssociazioneArea, AreaImpianto, AreaAppezzamento, PropagazioneSalvataggioPoligono)


                        If gestionePropagazioneEsiste Then

                            If AssociazioneArea = enum_Gis_AssociaSuperficieA.Nessuno Then
                                sup_imp = "{ ""AssociazioneArea"": 0, ""AreaAppezzamento"": 0, ""AreaImpianto"": 0, ""PropagazioneSalvataggioPoligono"": " & PropagazioneSalvataggioPoligono & " }"
                            End If


                            If PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.Appezzamento Or
                                    PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.ImpiantoEdAppezzamento Then

                                objImpianto = New AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo

                                objImpianto.TipoOperazioneDB_Impianto = TipiEnumerativi.enum_TipoOperazioneDB.Modifica
                                objImpianto.Piva = piva
                                objImpianto.Sa_Cod = sa_cod
                                objImpianto.Appezza = appezza

                                objImpianto.app_nome = nome_appezza
                                objImpianto.via_stringa = via_stringa

                                objImpianto.ModificaAppezzamento(objParametri_Server, objParametri_Utenti)

                            End If


                            'conferma di essere nel nuovo GIS, quindi procedo
                            If PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.Impianto Or
                                    PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.ImpiantoEdAppezzamento And varieta <> "null" Then

                                Dim leggiSpecie As New AgronicaCoreMetaSchemaDAL.SpecieVegetali_R
                                Dim dtSpecie As DataTable =
                                    leggiSpecie.Leggi_con_Cul_Des(0, varieta, "", "", objParametri_Server)

                                Dim veg_Cod As Integer = 0
                                If dtSpecie.Rows.Count > 0 Then
                                    veg_Cod = dtSpecie.Rows(0)("veg_Cod")
                                End If


                                ' VAnni: 16/2/2018: todo: aggiungere i dati mancanti indicati come stringa vuota..
                                Dim rStdSalvaNuovoImpianto2018 As RispostaStandard =
                                    SalvaNuovoImpianto2018(
                                        piva,
                                        sa_cod,
                                        veg_Cod,
                                        AreaImpianto,
                                        data_inizio,
                                        data_fine,
                                        varieta,
                                        finalita,
                                        "",
                                        tipologia,
                                        "",
                                        Lotto,
                                        "",
                                        "",
                                        via_stringa,
                                        hiddenPunti_modifica,
                                        Codice_Fiscale_Tecnico,
                                        enum_Gis_LayerElementiGrafici_std.IMPIANTI,
                                        "",
                                        CodiciAnagrafeAggiuntivi,
                                        enum_PropagazioneSalvataggioPoligono.ImpiantoSuAppezzamentoEsistente,
                                        appezza
                                    )

                                If Not rStdSalvaNuovoImpianto2018.RispostaOK Then
                                    Throw New Exception(rStdSalvaNuovoImpianto2018.Errore)
                                End If

                            End If

                        End If


                    End If

                End If
                'catasto

                AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazioneXCoreBiz(FlagTransazioneLocale, objParametri_Server)
                If streerore.ToLower.Contains("errore") Then
                    Risposta_ModificaImpianto.Errore = streerore
                Else
                    Risposta_ModificaImpianto.RispostaOK = True
                    Risposta_ModificaImpianto.RispostaStringa = streerore
                End If

                Return Risposta_ModificaImpianto
            End If

            Dim Tipo_entita_cod As Integer = 0

            If Preventivo1_Consuntivo2 = 2 Then
                objImpianto = New AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo

                objImpianto.TipoOperazioneDB_Impianto = TipiEnumerativi.enum_TipoOperazioneDB.Modifica
                objImpianto.Piva = piva
                objImpianto.app_nome = nome_appezza
                objImpianto.Sa_Cod = sa_cod
                objImpianto.Appezza = appezza
                objImpianto.Id_reg = id_reg
                objImpianto.via_stringa = via_stringa
                objImpianto.Progetto_Nome = Lotto


                If data_inizio <> "" Then
                    objImpianto.data_inizio = data_inizio
                Else
                    objImpianto.data_inizio = AGRODATAINIZIO
                End If
                If data_fine <> "" Then
                    objImpianto.data_fine = data_fine
                Else
                    objImpianto.data_fine = AGRODATAFINE
                End If


                If varieta <> "" And varieta <> "null" Then
                    objImpianto.Cul_Cod = varieta
                End If

                If tipologia <> "" And tipologia <> "null" Then
                    objImpianto.Tipologia = tipologia
                End If

                If finalita <> "" And finalita <> "null" Then
                    objImpianto.finalita_impianto = finalita
                End If

                CodiciAnagrafeAggiuntiviImposta(CodiciAnagrafeAggiuntivi, objImpianto)

                objImpianto.codice_Fiscale_Tecnico = Codice_Fiscale_Tecnico

                'If Not IsNothing(HttpContext.Current.Session("DatiPassaggio")) And Codice_Fiscale_Tecnico <> "" And Codice_Fiscale_Tecnico <> "null" Then
                '    objImpianto.codice_Fiscale_Tecnico = Codice_Fiscale_Tecnico
                'Else
                '    objImpianto.codice_Fiscale_Tecnico = ""
                'End If

                ' Vanni: 7/12/2017: integrata gestione superfici "extra oggetto"
                objImpianto.Superficie_IMPIANTO = 0

                ' VAnni: 8/10/2019: ora posso scegliere di memorizzare solo il dato GIS
                If ModificaAnagrafica Then
                    objImpianto.Modifica()
                Else
                    objImpianto.ModificaAppezzamento(objParametri_Server, objParametri_Utenti)
                End If


                Dim AreaAppezzamento As Decimal
                Dim AreaImpianto As Decimal
                Dim AssociazioneArea As enum_Gis_AssociaSuperficieA

                Dim gestionePropagazioneEsiste As Boolean =
                        PropagazioneSalvataggioPoligonoLeggi(sup_imp, AssociazioneArea, AreaImpianto, AreaAppezzamento, PropagazioneSalvataggioPoligono)


                ' VAnni: 31/7/2018: verifica operazioni di agenda
                If (gestionePropagazioneEsiste And (AssociazioneArea = enum_Gis_AssociaSuperficieA.Impianto Or AssociazioneArea = enum_Gis_AssociaSuperficieA.ImpiantoEdAppezzamento)) Or
                    (Not gestionePropagazioneEsiste And sup_imp <> "" And sup_imp <> "0") Then

                    AreaAppezzaImpiantoModificaConVerificaAgenda(sup_imp, objParametri_Server, piva, sa_cod, appezza, id_reg, PropagazioneSalvataggioPoligono)

                End If

                Tipo_entita_cod = tipoentita_cod 'AgronicaCoreDataProvider.TipiEnumerativi.enum_TipoNodo.Impianto_Generico

                If Not String.IsNullOrEmpty(codice_socio) And ModificaAnagrafica Then
                    Dim dtCodiciAnagrafe As DataTable =
                        objLeggiCodiciAnagrafe.Leggi(piva, TipiEnumerativi.enum_CodiciAnagrafe.Codice_Socio, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)

                    If dtCodiciAnagrafe.Rows.Count = 0 Then
                        objScriviCodiciAnagrafe.Scrivi(piva, TipiEnumerativi.enum_CodiciAnagrafe.Codice_Socio, codice_socio, AGRODATAINIZIO, AGRODATAFINE, objParametri_Server)
                    Else
                        objScriviCodiciAnagrafe.Modifica(piva, TipiEnumerativi.enum_CodiciAnagrafe.Codice_Socio, codice_socio, AGRODATAINIZIO, AGRODATAFINE, "", objParametri_Server)
                    End If

                End If




            Else


                Dim xAggiornamento As New AgronicaCoreAnagrafeDAL.Programmazione_Entita_W

                If sup_imp = "" Then
                    sup_imp = "0"
                End If
                xAggiornamento.Pianificazione_Modifica_GIS(programmazione_entita_cod, sup_imp, via_stringa, objParametri_Server)

                Tipo_entita_cod = AgronicaCoreDataProvider.TipiEnumerativi.enum_TipoNodo.PlanningEntitaImpianto

            End If 'Preventivo1_Consuntivo2 = 2


            Dim inSalvaGraficaDati As New InSalvaGraficaModel(
                piva:=piva,
                sa_cod:=sa_cod,
                Entita_cod:=entita_cod,
                hiddenPunti:=hiddenPunti_modifica,
                programmazione_cod:=programmazione_cod,
                programmazione_entita_cod:=programmazione_entita_cod,
                Tipo_entita_cod:=Tipo_entita_cod,
                objImpianto:=objImpianto,
                ElementoGrafico_DES:="",
                layer_codAtt:=LayerElementiGrafici_Cod,
                id_agenda:=id_agenda,
                id_Mov_Det:=id_Mov_Det,
                analisi_campione_cod:=analisi_campione_cod
            )

            ' VAnni: 29/9/2021: GIS_StaticMapCFG            
            If Not String.IsNullOrEmpty(jSonStaticMapCFG) Then
                inSalvaGraficaDati.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(jSonStaticMapCFG)
                inSalvaGraficaDati.StaticMapCFG.EntitaCod = entita_cod
            End If

            ModificaImpiantoSalvaEntitaConGestionePropagazione(
                inSalvaGraficaDati,
                enum_TipoOperazioneDB.Modifica,
                objParametri_Server,
                streerore,
                risp,
                PropagazioneSalvataggioPoligono,
                jSonStaticMapCFG
            )

            'TODO: cancellare appena testato
            'ModificaImpiantoSalvaEntitaConGestionePropagazione(
            '    enum_TipoOperazioneDB.Modifica,
            '    entita_cod,
            '    hiddenPunti_modifica,
            '    objParametri_Server,
            '    streerore,
            '    piva, sa_cod, appezza, programmazione_entita_cod, programmazione_cod,
            '    risp,
            '    objImpianto,
            '    id_agenda, id_Mov_Det, analisi_campione_cod, LayerElementiGrafici_Cod,
            '    PropagazioneSalvataggioPoligono, Tipo_entita_cod
            ')

            'verifico se devo forzare loggare l'operazione
            LoggaOperazioneDB(objParametri_Server, entita_cod, 2, DatiPassaggio, Sementi)




            'parte solo sementieri
            If Not String.IsNullOrEmpty(DatiPassaggio) Then


                'Dim VerificaInterferenze As Boolean = False

                'verifico se devo forzare l'evento di check interferenze
                'Dim objEntita As New AgronicaCoreGisDAL.GIS_Entita_R
                'Dim objInter_W As New AgronicaCoreSementieriDAL.Sementieri_Sportello_InterferenzePerConferma_W
                'Dim objIntR As New AgronicaCoreSementieriDAL.Sementieri_Sportello_InterferenzePerConferma_R

                'objInter_W.Modifica_Tutti_Interferenti(entita_cod, objParametri_Server)


                'metto tutte le interferenze a stato 

                If DatiPassaggio.ToString.Split("|")(5) = 1 Then

                    Dim objInter_W As New AgronicaCoreSementieriDAL.Sementieri_Sportello_InterferenzePerConferma_W
                    Dim objIntR As New AgronicaCoreSementieriDAL.Sementieri_Sportello_InterferenzePerConferma_R
                    Dim Interferenze As New AgronicaCoreGisBIZ.Interferenze

                    'Gabriele: suppongo che il poligono non sia più in interferenza con nessuno...
                    Interferenze.GeneraDescrizione_Casella_Conflitto(entita_cod, objParametri_Server, objParametri_Utenti)
                    'al posto di:
                    'objInter_W.Modifica_Tutti_Interferenti(entita_cod, objParametri_Server)

                    'VerificaInterferenze = True
                    'Dim risposta As String
                    Dim dtInterferenze As DataTable
                    Dim numeroRecordDaRestituire As Integer = -1
                    Dim moltiplicatoreDistanze As Integer = 1
                    Dim pivaSementieroReferente As String = Codice_Fiscale_Tecnico

                    dtInterferenze = dtInterferenze_from_poligono(pivaSementieroReferente, specie, tipologia,
                                                                  data_inizio, data_fine,
                                                                  moltiplicatoreDistanze, False,
                                                                  numeroRecordDaRestituire,
                                                                  hiddenPunti_modifica, objParametri_Server, objParametri_Utenti)

                    If dtInterferenze.Rows.Count > 0 Then
                        'Ho ancora interferenze???
                        For Each drowRisp As DataRow In dtInterferenze.Rows
                            Dim entita_cod_proprietario As Integer = drowRisp("Entita_Cod")

                            'se è già stata confermata 
                            Dim dt_gia_Inseriti As DataTable
                            dt_gia_Inseriti = objIntR.Leggi_da_Propietario_Interferente(entita_cod_proprietario, entita_cod, objParametri_Server)

                            If dt_gia_Inseriti.Rows.Count = 0 Then
                                Dim Interferenze_Cod As Integer

                                Dim AgroSequenze As New AgronicaCoreDataProvider.Agro_Sequenze
                                'Interferenze_Cod = AgroSequenze.Agronica_SequenzaTabelle_NuovoID("Sementieri_Sportello_InterferenzePerConferma", objParametri_Server)
                                'Lavez - 12/07/2024 - normalizzazione chiamate a stack counter
                                Interferenze_Cod = AgroSequenze.NuovoId_Tabella("Sementieri_Sportello_InterferenzePerConferma", 0, AgronicaCoreDataProvider.CostantiPersonalizzate.UpperBoundTabelle_Per_SequenzaTabelle_Topcode, objParametri_Server)
                                objInter_W.Scrivi(Interferenze_Cod, entita_cod_proprietario, entita_cod, True, drowRisp("DistanzaEffettiva"), objParametri_Server)
                            Else
                                'modifico e imposto a true 
                                objInter_W.Modifica_Flag(dt_gia_Inseriti.Rows(0).Item("Interferenze_Cod"), True, True, objParametri_Server)
                            End If
                        Next
                    End If

                End If

            End If



            'End If
            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazioneXCoreBiz(FlagTransazioneLocale, objParametri_Server)

            Risposta_ModificaImpianto.RispostaOK = True
            Risposta_ModificaImpianto.RispostaStringa = My.Resources.AgronicaControlliGIS.V_M_ModificaImpianto_Modifica_avvenuta_con_successo_

        Catch ex As Exception

            'Faccio il rollback della transazione
            If Not objParametri_Server.objTransazione Is Nothing Then
                'objParametri.objTransazione.Rollback()
                'objParametri.objTransazione = Nothing
                AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazione(2, objParametri_Server)

            End If

            Risposta_ModificaImpianto.RispostaOK = False

            'uso questa funzione per ottenere il Messaggio..:
            Risposta_ModificaImpianto.Errore &= "Errore durante l'operazione: " & vbCrLf &
                AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)

        Finally

            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiConnessioneXCoreBiz(FlagConnessioneLocale, objParametri_Server)

        End Try


        Return Risposta_ModificaImpianto

    End Function

    Private Shared Sub ModificaImpiantoSalvaEntitaConGestionePropagazione(
        ByVal InSalvaGraficaModel As InSalvaGraficaModel,
        ByVal TipoOperazioneElementoPrincipale As enum_TipoOperazioneDB,
        objParametri_Server As AgronicaCoreParametri,
        ByRef streerore As String,
        risp As Boolean,
        ByRef PropagazioneSalvataggioPoligono As enum_PropagazioneSalvataggioPoligono,
        ByVal jSonStaticMapCFG As String
    )

        If InSalvaGraficaModel.LayerCodAtt <> 19 Then
            'le propagazioni sono disponibili solo in layer impianti reali (19)
            PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.NessunaPropagazione
        End If

        'procedo al salvataggio dell'impianto o di quel che è in ogni caso,
        If PropagazioneSalvataggioPoligono <> enum_PropagazioneSalvataggioPoligono.Appezzamento Then

            streerore = SalvaGrafica(
                InSalvaGraficaModel,
                risp,
                objParametri_Server,
                TipoOperazioneElementoPrincipale
                )
        End If

        'decido se salvare o meno l'appezzamento.
        If PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.Appezzamento Or
            PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.ImpiantoEdAppezzamento Then

            Dim tipoNodoAlbero As Integer = 0
            Dim leggiTipoNodoAlbero As New AgronicaCoreGisDAL.GIS_TipoEntita_R

            Dim dtTipoNodoalbero As DataTable =
                leggiTipoNodoAlbero.Leggi(InSalvaGraficaModel.TipoEntitaCod, 0, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)


            If dtTipoNodoalbero.Rows.Count = 0 Then
                Throw New Exception(My.Resources.AgronicaControlliGIS.V_M_ModificaImpiantoSalvaEntitaConGestionePropagazione_Tipo_di_nodo_albero_non_decodificato)
            Else
                tipoNodoAlbero = dtTipoNodoalbero(0)("TipoNodoAlberoAnagrafe")
            End If

            'il campo_Cod non è indispensabile perché si salva un appezzamento, non un campo...
            Dim chiaveAlbero As String = ""
            AgronicaCoreDataProvider.Albero.ChiaveAlbero_Codifica_x_json_faster(
                Chiave:=chiaveAlbero,
                TipoNodo:=tipoNodoAlbero,
                Piva:=InSalvaGraficaModel.Piva,
                Sa_Cod:=InSalvaGraficaModel.SaCod,
                Campo_Cod:=0,
                Appezza:=InSalvaGraficaModel.ObjImpianto.Appezza)


            Dim rval1 As v_m_DatiGisSuElementiAnagraficiCollegati = ControllaEsistonoDatiGisSuElementiAnagraficiCollegati(chiaveAlbero, objParametri_Server)
            InSalvaGraficaModel.ObjImpianto.Id_reg = 0

            If rval1.DatiGisSuElementiAnagraficiCollegati_Lista_Entita_Cod.Count = 0 Then


                'nuovo appezzamento se non esiste                

                Dim InSalvaGraficaNuovo As New InSalvaGraficaModel(
                        InSalvaGraficaModel.Piva,
                        InSalvaGraficaModel.SaCod,
                        0,
                        InSalvaGraficaModel.HiddenPunti,
                        0, 0,
                        enum_GIS2012_TipoEntita.APPEZZAMENTI,
                        InSalvaGraficaModel.ObjImpianto,
                        "",
                        enum_Gis_LayerElementiGrafici_std.APPEZZAMENTI,
                        0, 0, 0
                    )

                ' VAnni: 29/9/2021: GIS_StaticMapCFG
                If Not String.IsNullOrEmpty(jSonStaticMapCFG) Then
                    InSalvaGraficaNuovo.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(jSonStaticMapCFG)
                    InSalvaGraficaNuovo.StaticMapCFG.EntitaCod = 0
                End If

                streerore &= SalvaGrafica(
                    InSalvaGraficaNuovo,
                    risp,
                    objParametri_Server,
                    TipiEnumerativi.enum_TipoOperazioneDB.Scrittura
                )
            Else

                'dati per appezzamento se esiste.
                For Each appPiccolo In rval1.DatiGisSuElementiAnagraficiCollegati_Lista_Entita_Cod



                    Dim InSalvaGraficaAggiorna As New InSalvaGraficaModel(
                        appPiccolo.Piva,
                        appPiccolo.Sa_Cod,
                        appPiccolo.Entita_Cod,
                        InSalvaGraficaModel.HiddenPunti,
                        0, 0,
                        enum_GIS2012_TipoEntita.APPEZZAMENTI,
                        InSalvaGraficaModel.ObjImpianto,
                        "",
                        enum_Gis_LayerElementiGrafici_std.APPEZZAMENTI,
                        0, 0, 0
                    )

                    ' VAnni: 29/9/2021: GIS_StaticMapCFG
                    If Not String.IsNullOrEmpty(jSonStaticMapCFG) Then
                        InSalvaGraficaAggiorna.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(jSonStaticMapCFG)
                        InSalvaGraficaAggiorna.StaticMapCFG.EntitaCod = appPiccolo.Entita_Cod
                    End If

                    streerore &= SalvaGrafica(
                        InSalvaGraficaAggiorna,
                        risp,
                        objParametri_Server,
                        TipiEnumerativi.enum_TipoOperazioneDB.Modifica
                    )
                Next

            End If


        End If
    End Sub

