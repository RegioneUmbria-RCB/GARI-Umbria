    Public Shared Function PreselezioneAgendaAnnulla() As RispostaStandard

        Dim r As New RispostaStandard
        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            r.Sessione = False
            Return r
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Try

            Dim objOpAgenda2010 As New ParametriAgenda
            objOpAgenda2010.Svuota_DatiOperazione()


            r.RispostaOK = True
            r.RispostaStringa = ""


        Catch ex As Exception

            r.RispostaOK = False

            'uso questa funzione per ottenere il Messaggio..:
            r.Errore = "Errore durante l'operazione: " & vbCrLf &
                AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)


        End Try

        Return r

    End Function



    ''' <summary>
    ''' Legge i parametri cartografici di inizializzazione
    ''' </summary>
    ''' <param name="FiltroAggiuntivo"></param>
    ''' <param name="objParametri"></param>
    ''' <returns></returns>
    Public Function InizializzazioneLetturaParametriCartografici(
        ByVal FiltroAggiuntivo As String,
        ByVal objParametri As AgronicaCoreParametri
    ) As RispostaStandard

        Dim rval As New RispostaStandard
        rval.RispostaOK = True

        Try

            Dim xLetturaEnveloper As New AgronicaCoreGisDAL.GIS_Entita_R
            Dim dtEnv As DataTable =
                xLetturaEnveloper.InizializzazioneLetturaParametriCartografici(FiltroAggiuntivo, objParametri)

            If dtEnv.Rows.Count > 0 Then
                Dim BBox As String = dtEnv.Rows(0)("PoligonoWKT").ToString().Replace("POLYGON ((", "").Replace("))", "").Replace(",", "")
                Dim bbox_ltln As String = Coord_UTM_AltoSinistra_BassoDestra_DaGML_WGS(dtEnv.Rows(0)("PoligonoWKT"))
                Dim center As String = dtEnv.Rows(0)("Center_PoligonoWKT")
                center = center.Replace("POINT (", "").Replace(")", "")
                rval.RispostaStringa = "{ ""BBox"": """ & BBox & """, ""BBox_NE_SW_LatLng"": """ & bbox_ltln & """, ""Center"": """ & center & """  }"
            End If

        Catch ex As Exception

            rval.RispostaOK = False
            rval.Errore = AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)

        End Try

        Return rval


    End Function


    Private Function Coord_UTM_AltoSinistra_BassoDestra_DaGML_WGS(ByVal PoligonoWKT As String) As String


        If PoligonoWKT <> "" Then
            Dim vCoord As String() = PoligonoWKT.Replace("POLYGON ((", "").Replace("))", "").Split(",")
            Return vCoord(3).TrimStart(" ") & vCoord(1)
        Else
            Return ""
        End If

    End Function



    ''' <summary>
    ''' Legge, per ciascun impianto nel datatable, il dato cartografico
    ''' </summary>
    ''' <param name="Lav_Cod"></param>
    ''' <param name="ListaImpianti"></param>
    ''' <param name="SovrascriviDatoWKTEsistente"></param>
    ''' <param name="objParametri"></param>
    ''' <returns></returns>
    Public Function AgendaLetturaWKT_SuListaImpianti(
        ByVal Lav_Cod As Integer,
        ByRef ListaImpianti As DataTable,
        ByVal SovrascriviDatoWKTEsistente As Boolean,
        ByVal objParametri As AgronicaCoreParametri
    ) As RispostaStandard

        Dim rval As New RispostaStandard
        rval.RispostaOK = True

        Try

            'leggo i dati su lista di oggetti 
            Dim objListaImpianti As List(Of Impianto) =
                       (From dd1 In ListaImpianti.AsEnumerable
                        Select New Impianto With {
                             .Piva = dd1("piva"),
                             .Sa_Cod = dd1("Sa_Cod"),
                             .Appezza = dd1("Appezza"),
                             .ID_Reg = dd1("ID_Reg"),
                             .GisWkt = dd1("GisWkt"),
                             .GisWktGps = dd1("GisWktGps"),
                             .GisWktSistemaRiferimento = dd1("GisWktSistemaRiferimento"),
                             .GisLayerCod = dd1("GisLayerCod"),
                             .GisTipoEntita_cod = dd1("GisTipoEntita_cod")
                             }).ToList

            Dim rvalLista As RispostaStandard =
                AgendaLetturaWKT_SuListaImpianti(Lav_Cod, objListaImpianti, SovrascriviDatoWKTEsistente, objParametri)

            'in caso di errore interno alle elaborazioni questo viene restituito:
            If Not rvalLista.RispostaOK Then
                Return rvalLista
            End If

            'riporto da lista oggetti a datatable
            For Each rigaImpianto In ListaImpianti.Rows

                Dim datiImpianto As Impianto = (
                From ii In objListaImpianti
                Where ii.Piva = rigaImpianto("piva") _
                   And ii.Sa_Cod = rigaImpianto("sa_cod") _
                   And ii.Appezza = rigaImpianto("appezza") _
                   And ii.ID_Reg = rigaImpianto("id_reg")
                Select ii).First

                If Not datiImpianto Is Nothing Then
                    rigaImpianto("GisWkt") = datiImpianto.GisWkt
                    rigaImpianto("GisWktGps") = datiImpianto.GisWktGps
                    rigaImpianto("GisWktSistemaRiferimento") = datiImpianto.GisWktSistemaRiferimento
                    rigaImpianto("GisLayerCod") = datiImpianto.GisLayerCod
                    rigaImpianto("GisTipoEntita_cod") = datiImpianto.GisTipoEntita_cod
                End If

            Next

        Catch ex As Exception

            rval.RispostaOK = False
            rval.Errore = AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)

        End Try

        Return rval


    End Function

    ''' <summary>
    ''' Legge, per ciascun impianto nella lista, il dato cartografico
    ''' </summary>
    ''' <param name="Lav_Cod">per decidere se leggere punti o poligoni</param>
    ''' <param name="ListaImpianti">Elenco integrto</param>
    ''' <param name="SovrascriviDatoWKTEsistente">Sovrascrive un dato WKT</param>
    ''' <returns>Esito dela lettura</returns>
    Public Function AgendaLetturaWKT_SuListaImpianti(
        ByVal Lav_Cod As Integer,
        ByRef ListaImpianti As List(Of Impianto),
        ByVal SovrascriviDatoWKTEsistente As Boolean,
        ByVal objParametri As AgronicaCoreParametri
    ) As RispostaStandard


        Dim rval As New RispostaStandard
        rval.RispostaOK = True

        Try


            If SovrascriviDatoWKTEsistente Then
                For Each ii In ListaImpianti
                    ii.GisWkt = ""
                    ii.GisWktGps = ""
                    ii.GisWktSistemaRiferimento = ""
                    ii.GisLayerCod = 0
                    ii.GisTipoEntita_cod = 0
                Next
            End If

            'lettura che tiene conto delle fasce di rispetto
            If ({LAVCOD_TRATTAMENTO_ANTIPARASSITARIO, LAVCOD_TRATTAMENTO_FITOREGOLATORE, LAVCOD_DISERBO, LAVCOD_GEODISINFESTAZIONE, LAVCOD_CONCIA_SEME, LAVCOD_DISSECCAMENTO}).Contains(Lav_Cod) Then
                AgendaLetturaWKT_SuListaImpianti(Lav_Cod, ListaImpianti, enum_Gis_LayerElementiGrafici_std.Fasce_di_rispetto, objParametri)
            End If

            AgendaLetturaWKT_SuListaImpianti(Lav_Cod, ListaImpianti, enum_Gis_LayerElementiGrafici_std.IMPIANTI, objParametri)

            AgendaLetturaWKT_SuListaImpianti(Lav_Cod, ListaImpianti, enum_Gis_LayerElementiGrafici_std.APPEZZAMENTI, objParametri)

        Catch ex As Exception

            rval.RispostaOK = False
            rval.Errore = AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)

        End Try

        Return rval
    End Function

    Private Sub AgendaLetturaWKT_SuListaImpianti(
        ByVal lav_Cod As Integer,
        ByRef ListaImpianti As List(Of Impianto),
        ByVal LayerElementiGrafici_cod As enum_Gis_LayerElementiGrafici_std,
        ByVal objParametri As AgronicaCoreParametri
    )

        'Grilli 14/08/2018 fix nel caso in cui non ci siano impianti
        If ListaImpianti.Count = 0 Then
            Return
        End If

        Dim GIS_TipoOggetto_Cod As enum_Gis_TipoOggetto

        Dim letturaTipoOggetto As New AgronicaCoreGisDAL.GIS_OperazioniAgendaXGrafica_R
        Dim dtLetturaTipoOggetto As DataTable =
            letturaTipoOggetto.Leggi(lav_Cod, "", "", objParametri)

        If dtLetturaTipoOggetto.Rows.Count > 0 Then
            GIS_TipoOggetto_Cod = dtLetturaTipoOggetto(0)("Gis_TipoOggetto_Cod")
        Else
            GIS_TipoOggetto_Cod = enum_Gis_TipoOggetto.NonSpecificato
        End If

        Dim letturaDatiGIS As New AgronicaCoreGisDAL.GIS_Entita_R
        Dim sLista1 As List(Of String)

        If LayerElementiGrafici_cod = enum_Gis_LayerElementiGrafici_std.APPEZZAMENTI Then
            sLista1 =
                (From s In ListaImpianti
                 Select " (e.piva = '" & s.Piva & "' AND e.sa_cod = " & s.Sa_Cod & " AND e.Appezza = " & s.Appezza & " AND e.id_imp = 0)"
                 ).ToList()
        Else
            sLista1 =
                (From s In ListaImpianti
                 Select " (e.piva = '" & s.Piva & "' AND e.sa_cod = " & s.Sa_Cod & " AND e.Appezza = " & s.Appezza & " AND e.id_imp = " & s.ID_Reg & ")"
                 ).ToList()
        End If

        Dim filtroListaSQL As String = String.Join(" OR ", sLista1.ToArray)

        Dim rvalImpiantiLetti As DataTable =
            letturaDatiGIS.AgendaLetturaWKT_DaListaImpianti(" (" & filtroListaSQL & ")", LayerElementiGrafici_cod, GIS_TipoOggetto_Cod, objParametri)


        Dim rvalFinale As New DataTable
        rvalFinale.Columns.Add(New DataColumn("piva", GetType(String)))
        rvalFinale.Columns.Add(New DataColumn("sa_cod", GetType(Integer)))
        rvalFinale.Columns.Add(New DataColumn("appezza", GetType(Integer)))
        rvalFinale.Columns.Add(New DataColumn("id_imp", GetType(Integer)))
        rvalFinale.Columns.Add(New DataColumn("WKT", GetType(String)))
        rvalFinale.Columns.Add(New DataColumn("flag_gps", GetType(Integer)))



        'popolo datatable finale, tenendo conto delle buffer zone
        For Each drow In rvalImpiantiLetti.Rows
            Dim r1 As DataRow = rvalFinale.NewRow()

            Dim wktFinale As String = ""
            If LayerElementiGrafici_cod = enum_Gis_LayerElementiGrafici_std.Fasce_di_rispetto Then
                wktFinale = letturaDatiGIS.BufferZone_CalcolaArea_Da_Entita_Cod_WKT(drow("Entita_Cod"), "", objParametri)
            End If

            If wktFinale = "" Then
                wktFinale = drow("WKT")
            End If

            r1("piva") = drow("piva")
            r1("sa_cod") = drow("sa_cod")
            r1("appezza") = drow("appezza")
            r1("id_imp") = drow("id_imp")
            r1("WKT") = wktFinale
            r1("flag_gps") = drow("flag_gps")

            rvalFinale.Rows.Add(r1)

        Next

        'parte finale
        For Each ii In ListaImpianti

            Dim filtroImp As Integer = 0
            If LayerElementiGrafici_cod <> enum_Gis_LayerElementiGrafici_std.APPEZZAMENTI Then
                filtroImp = ii.ID_Reg
            End If

            Dim wkt1 = (
                From d1 In rvalFinale.AsEnumerable
                Where d1("piva") = ii.Piva _
                    And d1("sa_cod") = ii.Sa_Cod _
                    And d1("appezza") = ii.Appezza _
                    And d1("id_imp") = filtroImp
                Select New With {.wkt = CStr(d1("WKT")), .flagGPS = d1("flag_gps")}
            ).FirstOrDefault

            If Not wkt1 Is Nothing AndAlso Not String.IsNullOrEmpty(wkt1.wkt) AndAlso String.IsNullOrEmpty(ii.GisWkt) Then
                ii.GisWkt = wkt1.wkt
                ii.GisWktGps = wkt1.flagGPS
                ii.GisWktSistemaRiferimento = "-1"
                ii.GisLayerCod = enum_Gis_LayerElementiGrafici_std.AGENDA_RILIEVI
                ii.GisTipoEntita_cod = enum_GIS2012_TipoEntita.Destinazione_Agenda
            End If
        Next

    End Sub

    Public Shared Function GIS_TipoEntita_popola() As rispostaStandard(Of List(Of GIS_TipoEntitaResponse))

        Dim r As New rispostaStandard(Of List(Of GIS_TipoEntitaResponse))
        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            r.Sessione = False
            Return r
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Try

            Dim xL As New AgronicaCoreGisDAL.GIS_TipoEntita_R
            Dim dt As DataTable =
                xL.LeggiPerJoinLayer(0, 0, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)

            r.RispostaOK = True
            r.RispostaStringa = (From t In dt.AsEnumerable
                                 Select New GIS_TipoEntitaResponse With {
                                     .LayerElementiGrafici_Cod = t("LayerElementiGrafici_Cod"),
                                     .LayerElementiGrafici_Des = t("LayerElementiGrafici_Des"),
                                     .TipoEntita_Cod = t("TipoEntita_Cod"),
                                     .TipoEntita_Des = t("TipoEntita_Des"),
                                     .TipoNodoAlberoAnagrafe = t("TipoNodoAlberoAnagrafe"),
                                     .Icona32 = t("Icona32")
                                     }).ToList()


        Catch ex As Exception

            r.RispostaOK = False

            'uso questa funzione per ottenere il Messaggio..:
            r.Errore = "Errore durante l'operazione: " & vbCrLf &
                AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)


        End Try

        Return r

    End Function

    <WebMethod(EnableSession:=True)>
    Public Shared Function GestisciStrumentoScomponiRicomponi(ByVal piva As String, ByVal sa_cod As Integer) As rispostaStandard(Of ScomponiResponse)
        Dim r As New rispostaStandard(Of ScomponiResponse)

        r.RispostaStringa = New ScomponiResponse

        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            r.Sessione = False
            Return r
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Try

            Dim xLeggiEsistonoPunti As New AgronicaCoreGisDAL.GIS_Entita_R
            Dim dt As DataTable =
                xLeggiEsistonoPunti.LeggixEliminaImpiantoPuntiScomposti(piva, sa_cod, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)


            If dt.Rows.Count > 0 Then

                Dim xLayer_R As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_R
                Dim xDtLayer As DataTable
                xDtLayer = xLayer_R.Leggi(
                        objParametri_Server.PivaSuperUser,
                        objParametri_Server.UtenteUsername,
                        4,
                        1,
                        enumSelezioneVariabile.Selezione_TabellaCompleta,
                        "",
                        "",
                        objParametri_Server
                    )

                If xDtLayer.Rows.Count > 0 AndAlso (xDtLayer.Rows(0)("flag_attivo") <> 1 Or xDtLayer.Rows(0)("flag_visibile") <> 1) Then


                    r.RispostaStringa.Ricarica = True

                    ' VAnni: 25/1/2017: attivo i layer interessati, se sono disattivati.
                    Dim xLayer As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_W
