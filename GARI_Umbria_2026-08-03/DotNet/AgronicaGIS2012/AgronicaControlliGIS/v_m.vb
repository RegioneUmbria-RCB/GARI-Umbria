    Public Shared Function TestSuperficieCfrGis(toTestGisEntita As AgronicaCoreEntityFramework_POCO.GIS_Entita, superficieDaTestare As Double) As RispostaStandard

        Dim r As New RispostaStandard

        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        Dim objParametri_Utenti As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Utenti")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            r.Sessione = False
            Return r
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Try

            Dim LeggiSuperficieGis As New AgronicaCoreGisDAL.GIS_Entita_R

            Select Case toTestGisEntita.TipoEntita_Cod
                Case enum_GIS2012_TipoEntita.APPEZZAMENTI,
                enum_GIS2012_TipoEntita.IMPIANTI_ORTICOLA

                    Dim dtSup As DataTable =
                        LeggiSuperficieGis.LeggiSmallAppezza(
                        toTestGisEntita.Piva,
                        toTestGisEntita.Sa_Cod,
                        toTestGisEntita.Appezza,
                        toTestGisEntita.Id_Imp,
                        " g.LayerElementiGrafici_Cod = " & toTestGisEntita.TipoEntita_Cod,
                        "",
                        objParametri_Server
                    )


                    If dtSup.Rows.Count > 0 Then

                        Dim superficieGis As Double = dtSup(0)("superficie") / 10000
                        Dim diff As Double = 1 - superficieGis / superficieDaTestare

                        Const rnd1 As Integer = 4
                        Const rndPercent As Integer = 1

                        Dim soglia As Decimal = 0 'GetLSogliaRossi(objParametri_Utenti)

                        If Math.Abs(diff) > soglia Then
                            r.RispostaStringa = "Superficie indicata: " & Math.Round(superficieDaTestare, rnd1) & ", superficie del poligono associato nel GIS:" & Math.Round(superficieGis, rnd1).ToString() & ", differenza: " & Math.Round(superficieDaTestare - superficieGis, rnd1).ToString() & " (in percentuale: " & (Math.Round(diff * 100, rndPercent)).ToString() & "%)"
                        End If

                    End If

            End Select


            r.RispostaOK = True

        Catch ex As Exception

            r.RispostaOK = False

            'uso questa funzione per ottenere il Messaggio..:
            r.Errore = "Errore durante l'operazione: " & vbCrLf &
                AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)


        End Try

        Return r
    End Function


