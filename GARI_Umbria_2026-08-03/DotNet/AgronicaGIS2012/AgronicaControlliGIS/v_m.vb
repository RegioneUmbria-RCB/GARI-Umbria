                    strB.Append("""cul_des"" : """ & culdes & """ ,  ")
                    strB.Append("""veg_des"" : """ & vegdes & """ ,  ")
                    strB.Append("""dest_uso"" : """ & dt.Rows(0).Item("destinazione_uso") & """ ,  ")

                    strB.Append("""Superficie"" : """ & dt.Rows(0).Item("Superficie") & """ ,  ")

