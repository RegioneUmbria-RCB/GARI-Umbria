    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="LayerElementiGrafici_Cod"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <returns></returns>
    Public Shared Function Caricaplace_tabella_Dettagli2_2022(ByVal LayerElementiGrafici_Cod As Integer,
                                                              ByRef objParametri_Server As AgronicaCoreParametri) As RispostaStandard
        Dim r As New RispostaStandard

        If String.IsNullOrEmpty(LayerElementiGrafici_Cod) Then
            r.RispostaStringa = ""
        Else
            'leggo tutti le impostazioni del superuser e incollo i default del super user
            Dim objLayerTiles As New AgronicaCoreGisDAL.GIS_LayerTiles_R


            Dim DTSuperUser As DataTable = objLayerTiles.Leggi(
                objParametri_Server.PivaSuperUser,
                LayerElementiGrafici_Cod,
                0,
                0,
                objParametri_Server.SuperUserUsername,
                AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                "",
                "",
                objParametri_Server)

            Dim dtUtenteCorrente As DataTable = objLayerTiles.Leggi(
                objParametri_Server.PivaSuperUser,
                LayerElementiGrafici_Cod,
                0,
                0,
                objParametri_Server.UtenteUsername,
                AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                "",
                "",
                objParametri_Server)

            Dim dr() As DataRow
            Dim objW As New AgronicaCoreGisDAL.GIS_LayerTiles_W

            For i = 0 To DTSuperUser.Rows.Count - 1
                dr = dtUtenteCorrente.Select("LayerTiles_cod='" & DTSuperUser.Rows(i).Item("LayerTiles_cod") & "'")

                If dr.Length = 0 Then
                    objW.Scrivi(
                        objParametri_Server.PivaSuperUser,
                        DTSuperUser.Rows(i).Item("LayerElementiGrafici_Cod"),
                        objParametri_Server.UtenteUsername,
                        DTSuperUser.Rows(i).Item("LayerTiles_Cod"),
                        DTSuperUser.Rows(i).Item("TipologiaLayer_cod"),
                        DTSuperUser.Rows(i).Item("LayerTiles_Des"),
                        IIf(IsDBNull(DTSuperUser.Rows(i).Item("Colore_Primario")), "FFFFFF", DTSuperUser.Rows(i).Item("Colore_Primario")),
                        IIf(IsDBNull(DTSuperUser.Rows(i).Item("Colore_Secondario")), "FFFFFF", DTSuperUser.Rows(i).Item("Colore_Secondario")),
                        IIf(IsDBNull(DTSuperUser.Rows(i).Item("Colore_Base")), "FFFFFF", DTSuperUser.Rows(i).Item("Colore_Base")),
                        IIf(IsDBNull(DTSuperUser.Rows(i).Item("Varianza")), "1", DTSuperUser.Rows(i).Item("Varianza")),
                        DTSuperUser.Rows(i).Item("Validita_Inizio"),
                        DTSuperUser.Rows(i).Item("Validita_Fine"),
                        objParametri_Server)
                End If
            Next

            Dim dt_Ti As DataTable
            dt_Ti = objLayerTiles.Leggi(
                objParametri_Server.PivaSuperUser,
                LayerElementiGrafici_Cod,
                0,
                0,
                objParametri_Server.UtenteUsername,
                enumSelezioneVariabile.Selezione_TabellaCompleta,
                "",
                "",
                objParametri_Server)

            Dim l As New List(Of ColonneNome)
            Dim c As New ColonneNome("LayerTiles_Cod", "Codice", "number")
            c._hidden = True
            l.Add(c)

            c = New ColonneNome("LayerTiles_Des", "Entità", "string")
            l.Add(c)

            c = New ColonneNome("Colore_Primario", "Colore primario", "string")
            c._FormatoParticolare = "<div class=#= Colore_Primario==null ? '' : 'color-border' # style='border-radius: 5px; background-color: \\##:Colore_Primario#;'>&nbsp;</div>"
            c._cssHeader = "allineacentro"
            c._Editabile = True
            l.Add(c)

            c = New ColonneNome("Colore_Secondario", "Colore secondario", "string")
            c._FormatoParticolare = "<div class=#= Colore_Secondario==null ? '' : 'color-border' # style='border-radius: 5px; background-color: \\##:Colore_Secondario#;'>&nbsp;</div>"
            c._cssHeader = "allineacentro"
            c._Editabile = True
            l.Add(c)

            c = New ColonneNome("Varianza", "N. di varianza", "number")
            c._Editabile = True
            c._cssHeader = "allineadestra"
            c._css = "allineadestra"
            l.Add(c)

            Dim js As New AgronicaCoreDataProvider.JSON_DataTable
            js.Editabile_Deafault = False

            r.RispostaStringa = js.JSON_DataTable_Kendo(dt_Ti,
                                                        l,
                                                        AssegnaAutomaticamenteTipoFiltro_daTipoDato:=True,
                                                        tipoFiltroKendo:=TipoFiltroKendo_colonne.CasellaDiscesa)

        End If

        r.RispostaOK = True

        Return r

    End Function

