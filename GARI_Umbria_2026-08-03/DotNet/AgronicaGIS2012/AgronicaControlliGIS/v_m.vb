            End Select


            Dim rigaStr As String = "<span style='font-weight: bold'>GIS</span>: {6} {7} {0} ({1} {2}, {3}). " &
                                    AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_GetInfoGeneraliRipartoLog_Vecchia_superficie) &
                                    " (Ha): <span style='text-decoration: underline'>{4}</span>, " &
                                    AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_GetInfoGeneraliRipartoLog_Nuova_superficie) &
                                    ": <span style='text-decoration: underline'>{5}</span> <br />"
            Dim EffettivaProposta As String = ""


            dtUtente = letturaUtente.Utenti_Dettagli_from_CF(riga("Username_Modifica"), enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Utenti)

            rval.Append(
                String.Format(rigaStr, "", dtUtente(0)("Nome"), dtUtente(0)("cognome"), CDate(riga("Data_Modifica")).ToShortDateString,
                              Riparto_HaAreCentiAre_Ha(riga("vecchioInter_Ettari_Are_Centiare")), Riparto_HaAreCentiAre_Ha(riga("inter_Ettari_Are_Centiare")), descrizioneTipoOperazione, ParametriSalvataggio)
            )

        Next

        If Not flgRigaLog Then
            rval.Append(AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_Nessuna_elaborazione_GIS_effettuata))
        End If

        Return rval.ToString()


    End Function

    Private Shared Function Riparto_HaAreCentiAre_Ha(txtHaAre As String) As String

        Dim v1 As String() = txtHaAre.Split(".")
        If v1.Length <> 3 Then
            Return txtHaAre
        End If

        Riparto_HaAreCentiAre_Ha_impostaZero(v1(0))
        Riparto_HaAreCentiAre_Ha_impostaZero(v1(1))
        Riparto_HaAreCentiAre_Ha_impostaZero(v1(2))

        Try

            Dim rval As Decimal = AgronicaCoreDataProvider.UtilityProvider.Ettari_from_EttariAreCentiare(CDec(v1(0)), CDec(v1(1)), CDec(v1(2)))
            Return rval.ToString.Replace(".", ",")
        Catch ex As Exception

        End Try
        Return txtHaAre
    End Function

    Private Shared Sub Riparto_HaAreCentiAre_Ha_impostaZero(ByRef v1 As String)
        If v1 = "" Then
            v1 = "0"
        End If
    End Sub

    Public Shared Sub DatiPf(ByVal s As String, ByVal hipenChar As String, ByRef stb As StringBuilder)
        If s.Contains("§") Then
            stb.Append(" , ""extra_info"": { ")
            Dim lSSplit As String() = s.Split("|")

            Dim s1 As New List(Of String)


            Dim lenllsplit As Integer = lSSplit.Length
            Dim progress As Integer = 0
            For i As Integer = 0 To lSSplit.Length - 1
                If lSSplit(i) <> "" Then
                    s1.Add(hipenChar & lSSplit(i).Split("§ ")(0) & hipenChar & " : " & hipenChar & lSSplit(i).Split("§")(1) & hipenChar)
                End If

            Next

            stb.Append(String.Join(",", s1.ToArray))

            stb.Append(" } ")
        End If

    End Sub


