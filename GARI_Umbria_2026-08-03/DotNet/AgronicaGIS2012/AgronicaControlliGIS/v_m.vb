        End If


        'Dim gmlPol As String
        'gmlPol = GetGmlPol(hiddenPunti_Nuovo)

        If IsNothing(obj_VerificaInterferenze.Grva_Cod) Then
            obj_VerificaInterferenze.Grva_Cod = 0
        End If

