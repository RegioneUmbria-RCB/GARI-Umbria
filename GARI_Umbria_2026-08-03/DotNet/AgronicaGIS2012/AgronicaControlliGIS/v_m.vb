        Try
            Dim basePath As String
            Dim leggiBasePath As New AgronicaCoreVarieDAL.Configurazione_Siti_R

            Dim ObjUtenti As New AgronicaCoreUtentiDAL.Utenti_Permessi_R
            Dim permessiAnalisiDatiSat As Boolean = ObjUtenti.Controlla_Permessi_Utente(
                                       HttpContext.Current.Session("ASG_Utente_Username"),
                                       HttpContext.Current.Session("ASG_IdServizio"),
                                       enum_Security_Attivita.GIS_SAT_AnalisiDatiSatellitari,
                                       enum_Security_Operazione.Modifica,
                                       Date.Now, "", objParametri_Utenti)

            If Not permessiAnalisiDatiSat Then
                r.RispostaOK = False
                r.Errore = My.Resources.AgronicaControlliGIS.V_M_Richiesto_permesso_di_analisi_dati
                Return r
            End If

            basePath = leggiBasePath.Leggi_Valore(0, "GiasOnline_WS_Mappe_2013", "", "", objParametri_Server)
            basePath &= "MappeApi.svc/VerificheSuElaborazioniConfigurazioneUtente"
            Dim payload As String = " { ""FiltroElaborazioni"": " & FiltroElaborazioni & ", ""ListaConfigurazioni"": """ & ListaConfigurazioni & """, ""DataRiferimentoElaborazioni"": """ & DataRiferimentoElaborazioni & """ } "

            Dim user As String = HttpContext.Current.Session("ASG_SuperUser_Username").ToString()
            Dim password As String = HttpContext.Current.Session("ASG_SuperUser_Password").ToString()
            Dim nomeOggettoEmbed As String = "d"

            Dim xUtil As New AgronicaCoreUtility.Http

            Dim xRisp As String =
            xUtil.RestPostBasicAuth(basePath, payload, user, password, nomeOggettoEmbed)

            Dim ElabConfig As rispostaStandard(Of AgronicaCoreModelloInSviluppo.ElaborazioniConfigurazioneUtente_List) =
                JsonConvert.DeserializeObject(Of rispostaStandard(Of AgronicaCoreModelloInSviluppo.ElaborazioniConfigurazioneUtente_List))(xRisp)

            If ElabConfig.RispostaOK Then
                r.RispostaOK = True
                r.RispostaStringa = JsonConvert.SerializeObject(ElabConfig.RispostaStringa)
            Else
                r.RispostaOK = False
                r.Errore = ElabConfig.Errore
            End If

        Catch ex As Exception
            r.RispostaOK = False
            r.Errore = Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)
        End Try


        Return r

    End Function




