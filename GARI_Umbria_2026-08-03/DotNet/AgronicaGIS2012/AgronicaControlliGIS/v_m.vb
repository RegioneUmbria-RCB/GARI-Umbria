        End If

        'Dim verificatore As New AgronicaCoreGisDAL.GIS_OperazioniCartograficheDB
        'Dim dtInterferenze As DataTable = verificatore.ElencoImpiantiInterferenzaSementi(piva,
        '                                                                                 gmlPol,
        '                                                                                 veg_cod,
        '                                                                                 grva_cod,
        '                                                                                 Math.Abs(CInt(grva_cod < 0)),
        '                                                                                 data_inizio,
        '                                                                                 data_fine,
        '                                                                                 True,
        '                                                                                 moltiplicatoreDistanze,
        '                                                                                 numeroRecordDaRestituire,
        '                                                                                 objParametri.Server)

        Dim dtInterferenze As DataTable = DtInterferenze_FromPoligono("",
                                                                      obj_VerificaInterferenze.Veg_Cod,
                                                                      obj_VerificaInterferenze.Grva_Cod,
                                                                      obj_VerificaInterferenze.Validita_Inizio,
                                                                      obj_VerificaInterferenze.Validita_Fine,
                                                                      obj_VerificaInterferenze.Sementi,
                                                                      obj_VerificaInterferenze.SementiMappaturaLibera,
                                                                      moltiplicatoreDistanze,
                                                                      True,
                                                                      numeroRecordDaRestituire,
                                                                      obj_VerificaInterferenze.HiddenPunti_Nuovo,
                                                                      objParametri_Server,
                                                                      objParametri_Utenti)

        r.RispostaStringa.MessaggioEsito = ""

        'vanni, 24/02/2020, verifica escape, @Gabri__ la funzione è ancora usata ??
        If dtInterferenze Is Nothing Then
            r.RispostaStringa.MessaggioEsito = My.Resources.AgronicaControlliGIS.V_M_Poligono_non_corretto_riprovare

