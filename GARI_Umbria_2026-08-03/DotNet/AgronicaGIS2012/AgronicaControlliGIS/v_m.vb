                obj_Return_GetProp.Tipo_EntitaCod = enum_GIS2012_TipoEntita.NON_DEFINITO

                obj_Return_GetProp.Piva = dt.Rows(0).Item("piva")
                obj_Return_GetProp.Cul_Cod = dt.Rows(0).Item("cul_cod")
                obj_Return_GetProp.Grfi_Cod = dt.Rows(0).Item("Grfi_Cod")
