    Private Shared Function PropagazioneSalvataggioPoligonoLeggi(config As String, ByRef AssociazioneArea As enum_Gis_AssociaSuperficieA, ByRef AreaImpianto As Decimal, ByRef AreaAppezzamento As Decimal, ByRef PropagazioneSalvataggioPoligono As enum_PropagazioneSalvataggioPoligono) As Boolean

        Dim datoLetto = False

        If config.Contains("{") Then

            datoLetto = True

            Dim objArea As JObject = JsonConvert.DeserializeObject(config)

            AreaImpianto = objArea("AreaImpianto").ToString.Replace(".", AgronicaCoreUtility.CulturaHelper.SeparatoreDecimaleVB)
            AreaAppezzamento = objArea("AreaAppezzamento").ToString.Replace(".", AgronicaCoreUtility.CulturaHelper.SeparatoreDecimaleVB)

            If Not objArea("PropagazioneSalvataggioPoligono") Is Nothing Then
                PropagazioneSalvataggioPoligono = CInt(objArea("PropagazioneSalvataggioPoligono"))

            End If

            If Not objArea("AssociazioneArea") Is Nothing Then
                AssociazioneArea = CInt(objArea("AssociazioneArea"))

            End If
        End If

        Return datoLetto
    End Function

    ''' <summary>
    ''' se richiedo la modifica di qualsiasi superifice allora metto il flag di modifica sulle operazioni che andranno riaggiornate
    ''' </summary>
    ''' <param name="Area">oggetto json oppure valore singolo con area da impostare</param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="Piva"></param>
    ''' <param name="Sa_Cod"></param>
    ''' <param name="Appezza"></param>
    ''' <param name="Id_Imp"></param>
    Private Shared Sub AreaAppezzaImpiantoModificaConVerificaAgenda(Area As String, objParametri_Server As AgronicaCoreParametri, Piva As String, Sa_Cod As Integer, Appezza As Integer, Id_Imp As Integer, ByRef PropagazioneSalvataggioPoligono As enum_PropagazioneSalvataggioPoligono)

        If Appezza <> 0 And Id_Imp <> 0 Then
            AgendaMarcaDaRiconfermare(objParametri_Server, Piva, Sa_Cod, Appezza, Id_Imp)
        End If

        Dim AreaImpianto As Decimal
        Dim AreaAppezzamento As Decimal
        Dim idleAssociazioneArea As enum_Gis_AssociaSuperficieA = enum_Gis_AssociaSuperficieA.Nessuno

        Dim DatoLetto As Boolean =
            PropagazioneSalvataggioPoligonoLeggi(Area, idleAssociazioneArea, AreaImpianto, AreaAppezzamento, PropagazioneSalvataggioPoligono)

        If Not DatoLetto Then
            'retrocompatibilità su chiamata da client versione precedente al 09/11/2017
            AreaImpianto = Area.Replace(".", ",")
            AreaAppezzamento = -1
        End If

        'appezzamento
        If Appezza <> 0 AndAlso (AreaAppezzamento = -1 Or AreaAppezzamento > 0) Then

            If AreaAppezzamento = -1 Then
                AreaAppezzamento = AreaImpianto
            End If

            Dim objAppezza As New AgronicaCoreAnagrafeDAL.Appezzamento_Write
            objAppezza.Modifica_Parametrizzata(Piva, Sa_Cod, Appezza, "Sup_app", AreaAppezzamento, "", objParametri_Server)

        End If

        'impianto
        If Id_Imp <> 0 AndAlso AreaImpianto > 0 Then

            Dim objimp As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Write
            objimp.Modifica_Sup_Imp(Piva, Sa_Cod, Appezza, Id_Imp, AreaImpianto, "", objParametri_Server)
        End If

    End Sub

    Private Shared Sub AgendaMarcaDaRiconfermare(objParametri_Server As AgronicaCoreParametri, Piva As String, Sa_Cod As Integer, Appezza As Integer, Id_Imp As Integer)
        Dim objAgenda As New AgronicaCoreContabDAL.Agenda_W
        Dim dt As DataTable
        Dim objMov As New AgronicaCoreContabDAL.Mov_Destinazioni_R
        dt = objMov.Leggi(Piva, Sa_Cod, 0, 0, 0, Appezza, Id_Imp, 0, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)
        If dt.Rows.Count > 0 Then
            Dim i As Integer
            For i = 0 To dt.Rows.Count - 1
                objAgenda.Agenda_SettaFlag_OpDaRiconfermare(Piva, dt.Rows(i).Item("Id_Agenda"), "GIS Mappe", Now.Today, "", objParametri_Server)
            Next
        End If

    End Sub

    Public Shared Function SalvaNuovoImpianto2018(
        ByVal piva As String,
        ByVal sa_cod As String,
        ByVal veg_cod As String,
        ByVal sup_imp As String,
        ByVal data_inizio As String,
        ByVal data_fine As String,
        ByVal varieta As String,
        ByVal finalita As String,
        ByVal disciplinare As String,
        ByVal tipologia As String,
        ByVal nome As String,
        ByVal lotto As String,
        ByVal data_semina As String,
        ByVal data_raccolta As String,
        ByVal via_stringa As String,
        ByVal hiddenPunti_Nuovo As String,
        ByVal Codice_Fiscale_Tecnico As String,
        ByVal layer_cod As String,
        ByVal elementografico_des As String,
        ByVal CodiciAnagrafeAggiuntivi As String,
        ByVal PropagazioneSalvataggioPoligono As String,
        Optional ByVal Appezza As Integer = 0,
        Optional ByVal campo_cod As Integer = 0
    ) As RispostaStandard
        Dim r As New RispostaStandard

        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            r.Sessione = False
            Return r
        End If

        Lingua.Gias_InizializzaCultura_DaSession()


        Try

            'Inserire il codice QUI..

            r.RispostaOK = True

            Dim salvataggioEsito As String =
                SalvaNuovoImpianto(
                    piva, sa_cod, veg_cod, sup_imp,
                    data_inizio, data_fine, varieta, finalita,
                    disciplinare, tipologia, nome, lotto,
                    data_semina, data_raccolta, via_stringa,
                    hiddenPunti_Nuovo, Codice_Fiscale_Tecnico, layer_cod, elementografico_des, CodiciAnagrafeAggiuntivi, PropagazioneSalvataggioPoligono, Appezza, campo_cod)

            If salvataggioEsito.ToLower.Contains("error") Then
                Throw New Exception(salvataggioEsito)
            End If

            r.RispostaStringa = salvataggioEsito

        Catch ex As Exception

            r.RispostaOK = False

            'uso questa funzione per ottenere il Messaggio..:
            r.Errore = "Errore durante l'operazione: " & vbCrLf &
                AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)


        End Try

        Return r
    End Function


    Public Shared Function SalvaNuovoImpianto(
                        ByVal piva As String,
                        ByVal sa_cod As String,
                        ByVal veg_cod As String,
                        ByVal sup_imp As String,
                        ByVal data_inizio As String,
                        ByVal data_fine As String,
                        ByVal varieta As String,
                        ByVal finalita As String,
                        ByVal disciplinare As String,
                        ByVal tipologia As String,
                        ByVal nome As String,
                        ByVal lotto As String,
                        ByVal data_semina As String,
                        ByVal data_raccolta As String,
                        ByVal via_stringa As String,
                        ByVal hiddenPunti_Nuovo As String,
                        ByVal Codice_Fiscale_Tecnico As String,
                        ByVal layer_cod As String,
                        ByVal elementografico_des As String,
                        Optional ByVal CodiciAnagrafeAggiuntivi As String = "",
                        Optional ByVal PropagazioneSalvataggioPoligono As enum_PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.NessunaPropagazione,
                        Optional ByVal appezza As Integer = 0,
                        Optional ByVal campo_cod As Integer = 0
                    ) As String

        Dim risp As Boolean

        '  Vanni, 22/04/2014 16:44:56: da capire come fare per la selezione di default
        If layer_cod = "-1" Then
            layer_cod = "19"
        End If

        Dim objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")
        Dim objParametri_Utenti = HttpContext.Current.Session("ASG_objParametri_Utenti")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            risp = False
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim programmazione_entita_cod As Integer = 0
        Dim Programmazione_cod As Integer = 0
        Dim Tipo_entita_cod As Integer = 0

        'salva su planning oppure su reale..
        Dim objImpianto As AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo

        Dim Preventivo1_Consuntivo2 As Integer = 2
        If Not HttpContext.Current.Session("DatiPassaggio") Is Nothing Then
            Preventivo1_Consuntivo2 = HttpContext.Current.Session("DatiPassaggio").ToString.Split("|")(4)
        End If
        Dim gp As New GisPurpose(HttpContext.Current.Session("Sementi"), HttpContext.Current.Session("SementiMappaturaLibera"))
        Dim Programmazione_Des As String = gp.SementiSportelloProgrammazione()

        Dim FlagConnessioneLocale As Boolean = False
        Dim FlagTransazioneLocale As Boolean = False
        Dim streerore As String = ""

        Try

            Dim leggiCFGStaticMap As New Configurazione_Siti_R
            Dim str As String = leggiCFGStaticMap.Leggi_Valore(0, "GIS_StaticMapCFG", "", "", objParametri_Server)


            AgronicaCoreDataProvider.ConnessioniTransazioni.ApriConnessioneXCoreBiz(FlagConnessioneLocale,
                                                                                    FlagTransazioneLocale,
                                                                                    objParametri_Server)

            Dim lSa_codSplit As String() = sa_cod.Split("|")

            '  Vanni, 22/04/2014 16:20:55: salvataggio di qualsiasi entità
            If layer_cod = 19 Or layer_cod = 33 Or layer_cod = 1 Or PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.ImpiantoSuAppezzamentoEsistente Then

                If Preventivo1_Consuntivo2 = 2 Then

                    objImpianto = New AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo
                    objImpianto.Piva = piva

                    objImpianto.Sa_Cod = lSa_codSplit(lSa_codSplit.Length - 1)

                    objImpianto.campo_cod = campo_cod

                    objImpianto.Superficie_Appezzamento = sup_imp.Replace(".", ",")
                    objImpianto.Superficie_IMPIANTO = objImpianto.Superficie_Appezzamento

                    If data_inizio <> "" Then
                        objImpianto.data_inizio = data_inizio
                    Else
                        objImpianto.data_inizio = AGRODATAINIZIO
                    End If
                    If data_fine <> "" Then
                        objImpianto.data_fine = data_fine
                    Else
                        objImpianto.data_fine = AGRODATAFINE
                    End If

                    If nome <> "" Then
                        objImpianto.app_nome = nome
                    End If

                    If via_stringa <> "" Then
                        objImpianto.via_stringa = via_stringa
                    End If

                    If lotto <> "" Then
                        objImpianto.Progetto_Nome = lotto
                    End If

                    'ho i dati dell'impianto, viceversa creo un terreno nudo.
                    If layer_cod <> 1 Then

                        objImpianto.Veg_Cod = veg_cod

                        If varieta <> "" Then
                            objImpianto.Cul_Cod = varieta
                        End If
                        If finalita <> "" Then
                            objImpianto.finalita_impianto = finalita
                        End If
                        If disciplinare <> "" Then
                            objImpianto.Disciplinare_Cod = disciplinare
                        End If
                        If tipologia <> "" Then
                            objImpianto.Tipologia = tipologia
                        End If

                        If data_semina <> "" Then
                            objImpianto.Data_semina = data_semina
                        End If
                        If data_raccolta <> "" Then
                            objImpianto.Data_Raccolta = data_raccolta
                        End If

                        CodiciAnagrafeAggiuntiviImposta(CodiciAnagrafeAggiuntivi, objImpianto)

                    End If


                    'If Not IsNothing(HttpContext.Current.Session("DatiPassaggio")) And Codice_Fiscale_Tecnico <> "" Then
                    '    objImpianto.codice_Fiscale_Tecnico = Codice_Fiscale_Tecnico
                    'End If
                    objImpianto.codice_Fiscale_Tecnico = Codice_Fiscale_Tecnico

                    ''  Vanni, 22/04/2014 16:18:30: salvo solo un nuovo impianto
                    If layer_cod = enum_Gis_LayerElementiGrafici_std.IMPIANTI Then

                        If PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.ImpiantoSuAppezzamentoEsistente Then

                            objParametri_Server.ImpostaFinestre_con_SalvataggioTemporale(objImpianto.data_inizio, objImpianto.data_fine)
                            If Esistono_Impianti_Su_Appezzamenti(objImpianto.Piva, objImpianto.Sa_Cod, appezza, 0, objParametri_Server) Then
                                objParametri_Server.ResettaFinestra()
                                'error è indispensabile perchè viene testato ..:
                                streerore &= "error: " & My.Resources.AgronicaControlliGIS.V_M_SalvaNuovoImpianto_Errore_presenza_impianto_attivo_appezzamento
                                Return streerore
                            End If
                            objParametri_Server.ResettaFinestra()

                            objImpianto.ImpostaPerScritturaNuovoImpiantoSuAppezzaEsistente = True
                            objImpianto.Appezza = appezza
                        End If

                        risp = objImpianto.Salva(Nothing, Nothing, Nothing)

                        Tipo_entita_cod = getFromVegCod(veg_cod)

                    Else

                        risp = objImpianto.Salva(Nothing, Nothing, Nothing)

                        Tipo_entita_cod = enum_GIS2012_TipoEntita.APPEZZAMENTI

                    End If

                Else

                    If sa_cod.Contains("|") Then
                        sa_cod = sa_cod.Split("|")(1)
                    End If

                    Dim tload As String() = {"pivasuperuser§ " & objParametri_Server.PivaSuperUser & "|piva§ " & piva & "|sa_cod§ " & sa_cod & "|ISTATP§ -1|PROG_POLIG§ 0|VEG_COD§ " & veg_cod & "|CUL_COD§ " & varieta & "|COD_VARIET§ " & varieta & "|DESCRIZION§ GRANTURCO (MAIS)|DATA_SEMINA§ " & data_semina & "|DATA_RACCOLTA§ " & data_raccolta & "|DATA_INIZIO§ " & data_inizio & "|DATA_FINE§ " & data_fine & "|AREA_COLT§ " & sup_imp & "|CODICE_FISCALE_TECNICO§ " & Codice_Fiscale_Tecnico & "|Programmazione_Des§ " & Programmazione_Des & "|udm_sup§ ha|tipologia§ " & tipologia & "|finalita§ " & finalita & "|via_stringa§ " & via_stringa & "|"}

                    Dim CaricaPlanningDaFintoDBF As New InterpretaDatiDBF.InterpretaDatiDBF
                    If layer_cod = 33 Then
                        risp = CaricaPlanningDaFintoDBF.ImportaDatiDBF(tload, {"|", "§"}, InterpretaDatiDBF.Tipo_Importazione.Tipo_Importazione_ShapeFile.Importazione_Agrea_Crea_Planning, objParametri_Server)
                        programmazione_entita_cod = CInt(GetValue(tload(0).Split({"|"c, "§"c}), "Programmazione_Entita_Cod"))
                        Programmazione_cod = CInt(GetValue(tload(0).Split({"|"c, "§"c}), "Programmazione_Cod"))
                    Else
                        risp = True
                    End If


                    Tipo_entita_cod = AgronicaCoreDataProvider.TipiEnumerativi.enum_TipoNodo.PlanningEntitaImpianto

                End If

            Else
                Tipo_entita_cod = getFromLayer(layer_cod)
                risp = True

            End If

            ' VAnni: 29/1/2018: decido anche im base alla propagazione dei dati di impianto .. 

            If layer_cod <> 19 Then
                'le propagazioni sono disponibili solo in layer impianti reali (19)
                PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.NessunaPropagazione
            End If

            'procedo al salvataggio dell'impianto o di quel che è in ogni caso,
            If PropagazioneSalvataggioPoligono <> enum_PropagazioneSalvataggioPoligono.Appezzamento Then


                Dim inSalvaGraficaDati As InSalvaGraficaModel = New InSalvaGraficaModel(
                    piva,
                    lSa_codSplit(lSa_codSplit.Length - 1),
                    0,
                    hiddenPunti_Nuovo,
                    Programmazione_cod,
                    programmazione_entita_cod,
                    Tipo_entita_cod,
                    objImpianto,
                    elementografico_des,
                    layer_cod,
                    0,
                    0,
                    0)

                ' VAnni: 29/9/2021: GIS_StaticMapCFG
                If Not String.IsNullOrEmpty(str) Then
                    inSalvaGraficaDati.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(str)
                    inSalvaGraficaDati.StaticMapCFG.EntitaCod = 0
                End If

                streerore = SalvaGrafica(inSalvaGraficaDati, risp, objParametri_Server, enum_TipoOperazioneDB.Scrittura)

            End If

            'decido se salvare o meno l'appezzamento.
            If PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.Appezzamento Or
                PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.ImpiantoEdAppezzamento Then

                objImpianto.Id_reg = 0

                Dim inSalvaGraficaAppezza As InSalvaGraficaModel = New InSalvaGraficaModel(
                    piva,
                    lSa_codSplit(lSa_codSplit.Length - 1),
                    0,
                    hiddenPunti_Nuovo,
                    0,
                    0,
                    enum_GIS2012_TipoEntita.APPEZZAMENTI,
                    objImpianto,
                    elementografico_des,
                    enum_Gis_LayerElementiGrafici_std.APPEZZAMENTI,
                    0,
                    0,
                    0)

                ' VAnni: 29/9/2021: GIS_StaticMapCFG
                If Not String.IsNullOrEmpty(str) Then
                    inSalvaGraficaAppezza.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(str)
                    inSalvaGraficaAppezza.StaticMapCFG.EntitaCod = 0
                End If

                streerore &= SalvaGrafica(inSalvaGraficaAppezza, risp, objParametri_Server, enum_TipoOperazioneDB.Scrittura)

            End If


            'verifico se devo forzare loggare l'operazione 
            Dim Ultimo_Entita_Cod As Integer
            Dim objEntita As New AgronicaCoreGisDAL.GIS_Entita_R
            Ultimo_Entita_Cod = objEntita.Max_Entita_cod(objParametri_Server)


            LoggaOperazioneDB(objParametri_Server, Ultimo_Entita_Cod, 1, HttpContext.Current.Session("DatiPassaggio"), HttpContext.Current.Session("Sementi"))



            'verifico se devo forzare l'evento di check interferenze 
            Dim VerificaInterferenze As Boolean = False
            If Not IsNothing(HttpContext.Current.Session("DatiPassaggio")) Then
                If HttpContext.Current.Session("DatiPassaggio").ToString.Split("|")(5) = 1 Then

                    VerificaInterferenze = True
                    Dim dtInterferenze As DataTable
                    Dim numeroRecordDaRestituire As Integer = -1
                    Dim moltiplicatoreDistanze As Integer = 1
                    Dim pivaSementieroReferente As String = HttpContext.Current.Session("Codice_Fiscale_Tecnico")

                    dtInterferenze = dtInterferenze_from_poligono(pivaSementieroReferente, veg_cod, tipologia,
                                                                  data_inizio, data_fine,
                                                                  moltiplicatoreDistanze, False,
                                                                  numeroRecordDaRestituire,
                                                                  hiddenPunti_Nuovo, objParametri_Server, objParametri_Utenti)


                    If dtInterferenze.Rows.Count > 0 Then
                        For Each drowRisp As DataRow In dtInterferenze.Rows
                            Dim entita_cod_proprietario As Integer
                            entita_cod_proprietario = drowRisp("Entita_Cod")
                            Dim Interferenze_Cod As Integer

                            Dim AgroSequenze As New AgronicaCoreDataProvider.Agro_Sequenze
                            'Lavez - 12/07/2024 - normalizzazione chiamate a stack counter
                            Interferenze_Cod = AgroSequenze.NuovoId_Tabella("Sementieri_Sportello_InterferenzePerConferma", 0, AgronicaCoreDataProvider.CostantiPersonalizzate.UpperBoundTabelle_Per_SequenzaTabelle_Topcode, objParametri_Server)
                            'Interferenze_Cod = AgroSequenze.Agronica_SequenzaTabelle_NuovoID(
                            '                    "Sementieri_Sportello_InterferenzePerConferma",
                            '                    objParametri_Server
                            '                    )


                            Dim objInter As New AgronicaCoreSementieriDAL.Sementieri_Sportello_InterferenzePerConferma_W
                            objInter.Scrivi(Interferenze_Cod, entita_cod_proprietario, Ultimo_Entita_Cod, True, drowRisp("DistanzaEffettiva"), objParametri_Server)
                        Next
                    End If

                End If
            End If


            'End If
            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazioneXCoreBiz(FlagTransazioneLocale, objParametri_Server)
        Catch ex As Exception

            'Faccio il rollback della transazione
            If Not objParametri_Server.objTransazione Is Nothing Then
                'objParametri.objTransazione.Rollback()
                'objParametri.objTransazione = Nothing
                AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazione(2, objParametri_Server)
            End If


        Finally

            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiConnessioneXCoreBiz(FlagConnessioneLocale, objParametri_Server)

        End Try

        Return streerore

    End Function

    Private Shared Sub CodiciAnagrafeAggiuntiviImposta(CodiciAnagrafeAggiuntivi As String, objImpianto As AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo)

        ' VAnni: 1/2/2018: al momento solo due codici anagrafe, però non sarebbe male generalizzare...

        If Not String.IsNullOrEmpty(CodiciAnagrafeAggiuntivi) Then

            Dim jArrCodiciAnag As JArray = JArray.Parse(CodiciAnagrafeAggiuntivi)

            For Each jItemAnag As JObject In jArrCodiciAnag

                Dim id_cod = CInt(jItemAnag("id_cod"))

                'codici appezzamento
                If id_cod = enum_CodiciAnagrafe.Riferimento_Alfanumerico_Appezzamento Then
                    objImpianto.codice_appezamento = jItemAnag("val_cod")
                End If

                'codici impianto
                If id_cod = enum_CodiciAnagrafe.Organismo_Referente Then
                    objImpianto.OrganismoReferente = jItemAnag("val_cod")
                End If

                If id_cod = enum_CodiciAnagrafe.Impianto_PianoSemina Then
                    objImpianto.PianoSemina = jItemAnag("val_cod")
                End If

                If id_cod >= 3000 AndAlso id_cod < 4000 Then
                    objImpianto.codice_terreno = id_cod
                End If
            Next

        End If
    End Sub

    Private Shared Function dtInterferenze_from_poligono(ByVal pivaSementieroReferente As String,
                                                         ByVal veg_cod As Integer,
                                                         ByVal grva_cod As Integer,
                                                         ByVal data_inizio As Date,
                                                         ByVal data_fine As Date,
                                                         ByVal moltiplicatoreDistanze As Integer,
                                                         ByVal Flag_InterferenzeStessoReferente As Boolean,
                                                         ByVal numeroRecordDaRestituire As Integer,
                                                         ByVal hiddenPunti_Nuovo As String,
                                                         ByVal objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                                         ByVal objParametri_Utenti As AgronicaCoreDataProvider.AgronicaCoreParametri) As DataTable
        Dim gmlPol As String
        gmlPol = GetGmlPol(hiddenPunti_Nuovo)
        Dim gp As New GisPurpose(HttpContext.Current.Session("Sementi"), HttpContext.Current.Session("SementiMappaturaLibera"))
        Dim FlagFinalita As Boolean = gp.Mode() = GisPurpose.enum_GisPurpose.SementiSportello

        Dim verificatore As New AgronicaCoreGisDAL.GIS_OperazioniCartograficheDB
        Dim dtInterferenze As DataTable = verificatore.ElencoImpiantiInterferenzaSementi(
            pivaSementieroReferente,
            gmlPol,
            veg_cod,
            grva_cod,
            Math.Abs(CInt(grva_cod < 0)),
            data_inizio,
            data_fine,
            Flag_InterferenzeStessoReferente,
            moltiplicatoreDistanze,
            numeroRecordDaRestituire,
            FlagFinalita,
            objParametri_Server,
            objParametri_Utenti)

        Return dtInterferenze
    End Function

    Public Shared Function VerificaPoligono(ByVal Poligono As String) As String

        Dim objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()


        Dim verificatore As New AgronicaCoreGisBIZ.GIS_ElementiGrafici_W


        If Not verificatore.VerificaPoligono(GetGmlPol(Poligono), objParametri_Server) Then
            Return My.Resources.AgronicaControlliGIS.V_M_Poligono_non_corretto
        Else
            Return "Ok"
        End If

    End Function


    ''' <summary>
    ''' Salvataggio del dato cartografico
    ''' </summary>
    ''' <param name="piva"></param>
    ''' <param name="sa_cod"></param>
    ''' <param name="Entita_cod"></param>
    ''' <param name="hiddenPunti">Punti così come memorizzati dalle API di Google Maps: es.: (44.485001332738115, 11.794383116803829),(44.48301117678287, 11.795177050672237),(44.48385317412669, 11.793932505689327)</param>
    ''' <param name="risp"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="programmazione_cod">nel caso di salvataggio di un planning</param>
    ''' <param name="programmazione_entita_cod">nel caso di salvataggio di un planning</param>
    ''' <param name="Tipo_entita_cod">Tipo di entita per albero anagrafica (tabella GIS_TipoEntita, decodificare da Cul_cod la specie e poi il Gru_Cod)</param>
    ''' <param name="objImpianto">Se si salva un appezzamento, un'impianto, un campo indicare qui i dati</param>
    ''' <param name="TipoOperazioneDB"></param>
    ''' <param name="ElementoGrafico_DES"></param>
    ''' <param name="layer_codAtt">Layer dove memorizzare (Da tabella GIS_LayerElementiGrafici) </param>
    ''' <param name="id_agenda"></param>
    ''' <param name="id_Mov_Det"></param>
    ''' <param name="analisi_campione_cod"></param>
    ''' <param name="flag_gps">indica se il dato proviene da GPS, TODO: Renere il parametro Obbligatorio e modificare le chiamate di conseguenza</param>
    ''' <param name="inviato"></param>
    ''' <returns>Stringa contenente eventuali errori in salvataggio.</returns>
    Public Shared Function SalvaGrafica(inSalvaGraficaModel As InSalvaGraficaModel,
               ByVal risp As Boolean,
               ByVal objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri,
               ByVal TipoOperazioneDB As Integer,
               Optional ByVal flag_gps As String = "",
               Optional ByVal inviato As Integer = 0
               ) As String


        Dim streerore As String = ""
        Dim FlagConnessioneLocale, FlagTransazioneLocale As Boolean
        Try


            Dim xDocRval As XDocument = XDocument.Parse("<DatiEntita xmlns=""http://www.agronica.it/grafica/"" xmlns:gml=""http://www.opengis.net/gml""></DatiEntita>")
            Dim lay = <layersdescrizioni>
                          <layer tipologia_layer="1" nome_layer="entità">
                          </layer>
                      </layersdescrizioni>

            xDocRval.Root.Add(lay)

            Dim appezza As Integer = 0
            Dim id_reg As Integer = 0
            Dim Campo_cod As Integer = 0
            If Not inSalvaGraficaModel.ObjImpianto Is Nothing Then
                appezza = inSalvaGraficaModel.ObjImpianto.Appezza
                id_reg = inSalvaGraficaModel.ObjImpianto.Id_reg
                Campo_cod = inSalvaGraficaModel.ObjImpianto.campo_cod
            End If



            Dim newEntitaElement = <Entita TipoOperazioneDB=<%= TipoOperazioneDB %> ecolor="256" eline="256" rad="15" text=<%= inSalvaGraficaModel.ElementoGraficoDes %> validita_inizio="01/01/1900" validita_fine="31/12/2100" username_creazione="" username_modifica="">
                                       <layers>
                                           <layer tipologia_layer="1"><%= inSalvaGraficaModel.LayerCodAtt %></layer>
                                       </layers>
                                       <EntitaGIAS>
                                           <DatoGias>
                                               <PivaSuperUser><%= objParametri_Server.PivaSuperUser %></PivaSuperUser>
                                               <Entita_Cod><%= inSalvaGraficaModel.EntitaCod %></Entita_Cod>
                                               <TipoEntita_Cod><%= inSalvaGraficaModel.TipoEntitaCod %></TipoEntita_Cod>
                                               <Piva><%= inSalvaGraficaModel.Piva %></Piva>
                                               <Sa_Cod><%= inSalvaGraficaModel.SaCod %></Sa_Cod>
                                               <Appezza><%= appezza %></Appezza>
                                               <Campo_Cod><%= Campo_cod %></Campo_Cod>
                                               <Id_Imp><%= id_reg %></Id_Imp>
                                               <PROV><%= inSalvaGraficaModel.CatastoProv %></PROV>
                                               <COM><%= inSalvaGraficaModel.CatastoCom %></COM>
                                               <SEZIONE><%= inSalvaGraficaModel.CatastoSezione %></SEZIONE>
                                               <FOGLIO><%= inSalvaGraficaModel.CatastoFoglio %></FOGLIO>
                                               <NUMERO><%= inSalvaGraficaModel.CatastoNumero %></NUMERO>
                                               <SUBALTERNO><%= inSalvaGraficaModel.CatastoSubalterno %></SUBALTERNO>
                                               <Programmazione_Entita_Cod><%= inSalvaGraficaModel.ProgrammazioneEntitaCod %></Programmazione_Entita_Cod>
                                               <Programmazione_Cod><%= inSalvaGraficaModel.ProgrammazioneCod %></Programmazione_Cod>
                                               <Id_Agenda><%= inSalvaGraficaModel.IdAgenda %></Id_Agenda>
                                               <id_mov_det><%= inSalvaGraficaModel.IdMovDet %></id_mov_det>
                                               <analisi_campione_cod><%= inSalvaGraficaModel.AnalisiCampioneCod %></analisi_campione_cod>
                                               <OLDGrafica_ID></OLDGrafica_ID>
                                               <inviato><%= inviato %></inviato>
                                               <Data_Creazione><%= Now.ToLongDateString %></Data_Creazione>
                                               <Data_Modifica><%= Now.ToLongDateString %></Data_Modifica>
                                               <Username_Creazione><%= objParametri_Server.UsernameOperazione %></Username_Creazione>
                                               <Username_Modifica><%= objParametri_Server.UsernameOperazione %></Username_Modifica>
                                               <Validita_Inizio>1900-01-01T00:00:00</Validita_Inizio>
                                               <Validita_Fine>2100-12-31T00:00:00</Validita_Fine>
                                           </DatoGias>
                                       </EntitaGIAS>
                                   </Entita>

            'se non sto cancellando incapsulo la grafica ..
            Dim sNodeDoc As XDocument

            Dim wktToGeoML As New wkt_gml
            Dim wktHelp As New WKT

            'valore che non serve a nulla quando si cancella
            Dim coord As String = ""

            If TipoOperazioneDB = AgronicaCoreDataProvider.TipiEnumerativi.enum_TipoOperazioneDB.Cancellazione Then
                inSalvaGraficaModel.HiddenPunti = "(44.485001332738115, 11.794383116803829),(44.48301117678287, 11.795177050672237),(44.48385317412669, 11.793932505689327)"
            End If

            coord = GetCoord(inSalvaGraficaModel.HiddenPunti)

            Dim gmlCoord As String = wktToGeoML.Trasforma(
                                coord,
                                False,
                                False,
                                False,
                                0
                            )
            sNodeDoc = XDocument.Parse(
                gmlCoord
            )


            If flag_gps = "" Then
                flag_gps = "0"
            End If

            Dim elementoGrafico_Cod As Integer = 0

            If TipoOperazioneDB <> enum_TipoOperazioneDB.Scrittura Then
                Dim letturaElementoGrafico As New AgronicaCoreGisDAL.GIS_ElementiGrafici_R
                Dim dtLetturaElmenetoGrafico As DataTable =
                    letturaElementoGrafico.Leggi("", 0, inSalvaGraficaModel.EntitaCod, 0, enumFromatoCartograficoConvertito.Nessuna_Conversione, enumSelezioneVariabile.Selezione_TabellaDatiMinimi, "", "", objParametri_Server)

                If dtLetturaElmenetoGrafico.Rows.Count = 1 Then
                    elementoGrafico_Cod = dtLetturaElmenetoGrafico(0)("ElementoGrafico_Cod")
                Else
                    Throw New Exception(My.Resources.AgronicaControlliGIS.V_M_SalvaGrafica_Errore_assenza_elemento_grafico_entità_gis_ & inSalvaGraficaModel.EntitaCod)
                End If
            End If

            sNodeDoc.Root.@Flag_GPS = flag_gps
            sNodeDoc.Root.@ElementoGrafico_Cod = elementoGrafico_Cod

            newEntitaElement.Add(sNodeDoc.FirstNode)


            xDocRval.Root.Add(newEntitaElement)


            Dim ListaNS As New List(Of String)
            ListaNS.Add("http://www.opengis.net/gml")
            Dim rval As String = xmlHelper.RemoveNamespace(xDocRval, ListaNS).ToString.Replace("xmlns=""""", "")

            Dim tmpDoc As XDocument = XDocument.Parse(rval)
            'scrive le entità
            Dim listOFEntita = (
                        From a In tmpDoc.<DatiEntita>.<Entita>
                        Select a).ToList()

            Dim conteggioNonImportati As Integer = 0

            Dim ScriviElementiGrafici As New AgronicaCoreGisBIZ.GIS_Entita_W
            Dim EsitoGrafica As Boolean = True

            Dim listaEntita_codNuovi As New List(Of String)

            For Each elemento In listOFEntita

                'per test formato database ...
                Try

                    'transizione sulla singola chiamata di un entità grafica/GIAS

                    '------------------------------
                    ''Se la connessione è chiusa la apro e se la transazione è chiusa la inizio
                    AgronicaCoreDataProvider.ConnessioniTransazioni.ApriConnessioneXCoreBiz(FlagConnessioneLocale,
                                                                                    FlagTransazioneLocale,
                                                                                    objParametri_Server)

                    Dim OutputEntitaCod As Integer = -1


                    EsitoGrafica = ScriviElementiGrafici.scrivi(elemento.ToString, OutputEntitaCod, objParametri_Server)

                    listaEntita_codNuovi.Add(objParametri_Server.PivaSuperUser & "|" & OutputEntitaCod)

                    If EsitoGrafica Then

                        If inSalvaGraficaModel.TipoEntitaCod = enum_GIS2012_TipoEntita.CentriAziendali Then

                            AggiornaCoordinateCentroAziendale(inSalvaGraficaModel.Piva, inSalvaGraficaModel.SaCod, objParametri_Server, gmlCoord)

                        End If

                        '  Vanni, 18/02/2016 09:04:16: verificare il Flag transazione locale .. !
                        AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazioneXCoreBiz(FlagTransazioneLocale, objParametri_Server)

                    End If

                    'se esiste una configurazione, questa è attiva ed il layer è presaente in lista (o la lista è vuota)
                    If EsitoGrafica AndAlso
                        Not IsNothing(inSalvaGraficaModel.StaticMapCFG) AndAlso
                        inSalvaGraficaModel.StaticMapCFG.StaticMapAttive AndAlso
                        inSalvaGraficaModel.StaticMapCFG.LayerAbilitati.Contains(inSalvaGraficaModel.LayerCodAtt) Then

                        Dim gestioneStaticMaps As New GoogleStaticMaps
                        If OutputEntitaCod > 0 Then
                            inSalvaGraficaModel.StaticMapCFG.EntitaCod = OutputEntitaCod
                        End If
                        inSalvaGraficaModel.StaticMapCFG.objParametri_Server = objParametri_Server
                        gestioneStaticMaps.AggiornaElementoGraficoConMappaStatica(inSalvaGraficaModel.StaticMapCFG)
                    End If

                Catch ex As Exception
                    conteggioNonImportati += 1
                    If Not objParametri_Server.objTransazione Is Nothing Then
                        'objParametri.objTransazione.Rollback() 
                        'objParametri.objTransazione = Nothing
                        AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazione(2, objParametri_Server)
                    End If

                Finally

                    AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiConnessioneXCoreBiz(FlagConnessioneLocale, objParametri_Server)

                End Try


            Next

            ''i18n__ + verifica escape
            'If risp = False Or EsitoGrafica = False Then
            '    streerore = My.Resources.AgronicaControlliGIS.V_M_SalvaGrafica_Problemi_salvataggio_appezzamento
            '    If Not EsitoGrafica Then
            '        streerore &= My.Resources.AgronicaControlliGIS.V_M_SalvaGrafica_Errore_suggerimento_disegno_poligono
            '    End If
            'Else


            '    streerore = My.Resources.AgronicaControlliGIS.V_M_Operazione_eseguita_correttamente & ". " & String.Join(",", listaEntita_codNuovi.ToArray)
            'End If

            '' VAnni: 24/2/2020: al momento non uso la versione in lingua (perchè occorre capire se un messaggio in lingua diversa non viene interpretato)
            If risp = False Or EsitoGrafica = False Then
                streerore = "Problemi nel salvare l appezzamento"
                If Not EsitoGrafica Then
                    streerore &= ", provare a disegnare un poligono senza lati che hanno intersezioni fra loro."
                End If
            Else


                streerore = "Operazione eseguita correttamente." & String.Join(",", listaEntita_codNuovi.ToArray)
            End If

            'End If

        Catch ex As Exception
            'Faccio il rollback della transazione

        Finally

        End Try

        Return streerore
    End Function

