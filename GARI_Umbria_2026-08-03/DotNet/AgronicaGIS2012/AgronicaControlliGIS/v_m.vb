    Public Shared Function CaricaDateDefaultDaVegCod(ByVal Veg_Cod As String) As String

        Dim objParametri As AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri = HttpContext.Current.Session("ASG_objParametri_Server")

        Dim objParametri_Utenti As AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Utenti = HttpContext.Current.Session("ASG_objParametri_Utenti")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()


        Dim rval As String
        'controllo se sono in modalità sementi o no
        Dim gp As New GisPurpose(HttpContext.Current.Session("Sementi"), HttpContext.Current.Session("SementiMappaturaLibera"))
        If gp.Mode() = GisPurpose.enum_GisPurpose.SementiSportello Then
            rval = -1
        Else

            Dim objVar As New AgronicaCoreMetaSchemaDAL.SpecieVegetali_R
            Dim dt As DataTable

            If Veg_Cod = "" Then
                Veg_Cod = "-1"
            End If

            dt = objVar.Leggi(Veg_Cod, 0, "", "", AgronicaCoreDataProvider.AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
                              "", "", objParametri)
            Dim str_R As String = ""

            Dim d1 As Date
            Dim d2 As Date

            Dim lUtentiImpostazioni As New AgronicaCoreUtentiDAL.Utenti_Impostazioni_Read
            lUtentiImpostazioni.AnnataAgraria(Now, d1, d2, objParametri_Utenti)

            'Dim Data_Dal As String = AgronicaCoreDataProvider.Data.get_Annata_Agraria_Inizio(Now)
            'Dim Al_Dal As String = AgronicaCoreDataProvider.Data.get_Annata_Agraria_Fine(Now)

            Dim Data_Dal As String = d1.ToShortDateString
            Dim Al_Dal As String = d2.ToShortDateString


            If dt.Rows.Count > 0 AndAlso dt.Rows(0).Item("Gru_cod") = "1" Then
                'restituisco l anno corrente e infinito
                str_R = Data_Dal & "|" & ""

            Else
                'anno corrente
                str_R = Data_Dal & "|" & Al_Dal
            End If

            Return str_R

        End If

        Return rval
    End Function


    Public Shared Function CaricaDateDefault() As String


        Dim objParamentri_server As New AgronicaCoreDataProvider.AgronicaCoreParametri
        objParamentri_server = HttpContext.Current.Session("ASG_objParametri_Server")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParamentri_server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim rval As String = "-1"
        Dim gp As New GisPurpose(HttpContext.Current.Session("Sementi"), HttpContext.Current.Session("SementiMappaturaLibera"))

        Dim sportelloCod As Integer = gp.SementiSportelloCod()
        If sportelloCod <> -1 Then

            rval = Now.Date.ToShortDateString & "|"

            Dim leggiSportello As New AgronicaCoreSementieriDAL.Sportello_R
            Dim dtLeggiSportello As DataTable

            dtLeggiSportello = leggiSportello.Leggi(sportelloCod, 0, AgronicaCoreDataProvider.CostantiPersonalizzate.AGRODATAINIZIO, enumSelezioneVariabile.Selezione_TabellaCompleta, "", objParamentri_server)

            If dtLeggiSportello.Rows.Count > 0 Then
                rval &= CDate(dtLeggiSportello.Rows(0)("validita_fine")).ToShortDateString
            End If
        End If

        Return rval
    End Function

