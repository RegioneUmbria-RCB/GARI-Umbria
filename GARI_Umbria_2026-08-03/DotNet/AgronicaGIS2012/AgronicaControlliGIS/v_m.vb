    Private Shared Function GetValue(ByVal vettore As String(), ByVal CodiceDaRestituire As String) As String

        Dim pos As Integer = 0
        For Each s In vettore
            If s.TrimEnd(" ").ToLower = CodiceDaRestituire.ToLower Then
                Return vettore(pos + 1).TrimStart(" ").TrimEnd(" ")
            End If
            pos += 1
        Next

        Return Nothing

    End Function


