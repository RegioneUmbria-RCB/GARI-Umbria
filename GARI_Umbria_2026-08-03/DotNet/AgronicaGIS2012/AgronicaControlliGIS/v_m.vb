            Dim LeggiCFGDatiIniziali As New AgronicaCoreVarieDAL.Configurazione_Siti_R
            Dim pathTemp As String =
                    LeggiCFGDatiIniziali.Leggi_Valore(0, "PathFileTemporanei", "", "", objParametri_Server)
            If pathTemp = "" Then
                Throw New Exception("Configurazione file temporanei non trovata. impossibile proseguire")
            End If

            Dim filePathTemp = System.IO.Path.Combine(pathTemp, objpfPrescriptionUpload.fileName)

            If Path.GetExtension(filePathTemp) <> ".zip" Then
                Throw New Exception("Il file caricato non è in formato ZIP")
            End If

            If objpfPrescriptionUpload.rateColumnName = "" Then
                Throw New Exception("Colonna dosaggio prescrizione non valorizzata. Impossibile proseguire")
            End If

            Using f As New System.IO.FileStream(filePathTemp, IO.FileMode.Create)
                f.Write(objpfPrescriptionUpload.fileContent, 0, objpfPrescriptionUpload.fileContent.Length)
            End Using

            Dim workDir As String = Path.Combine(pathTemp, Path.GetFileNameWithoutExtension(objpfPrescriptionUpload.fileName))
            If Directory.Exists(workDir) = True Then
                Directory.Delete(workDir, True)
            End If
            Directory.CreateDirectory(workDir)

            AgronicaCoreUtility.AgroZip.UnZip(filePathTemp, workDir)

            Dim fList = Directory.GetFiles(workDir).ToList().Where(Function(x) x.Contains(".shp")).ToList()

            If fList.Count <= 0 Then
                Throw New Exception("Nessun file shp trovato nella cartella temporanea")
            End If

            Dim pList = Directory.GetFiles(workDir).ToList().Where(Function(x) x.Contains(".prj")).ToList()
            If pList.Count <= 0 Then
                Throw New Exception("File prj non trovato. impossibile determinare il sistema di coordinate. Operazione interrotta.")
            Else
                Dim prj = File.ReadAllText(pList(0))
                If Not prj.StartsWith("GEOGCS[""GCS_WGS_1984""") Then
                    Throw New Exception("Shapefile con sistema di coordinate non WGS84. Impossibile proseguire")
                End If
            End If

            Dim finalObj As New GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
            finalObj.geoJsonCaricato = New AgronicaCoreModelsSTD.Gis.GeoJson_Shape_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
            finalObj.geoJsonCaricato.type = "FeatureCollection"
            finalObj.geoJsonCaricato.features = New List(Of AgronicaCoreModelsSTD.Gis.GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))

            Dim gisLayerR As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_R
            Dim dtLayer = gisLayerR.Leggi(objParametri_Server.PivaSuperUser, objParametri_Utenti.UtenteUsername, TipiEnumerativi.enum_Gis_LayerElementiGrafici_std.Mappe_Prescrizione, 1, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)
            If dtLayer.Rows.Count <= 0 Then
                Throw New Exception("Dati Layer non trovati")
            End If

            Dim featureList = NetTopologySuite.IO.Esri.Shapefile.ReadAllFeatures(fList(0))


            'verifico la distanza di tutti i poligoni della mappa rispetto il poligono dell'impianto se la distanza supera i 200m blocco 
            Dim gis As New AgronicaCoreGisDAL.GIS_ElementiGrafici_R
            Dim gisEntita As New AgronicaCoreGisDAL.GIS_Entita_R

            Dim dtEntita = gisEntita.Leggi(objParametri_Server.PivaSuperUser,
                            0,
                            enum_GIS2012_TipoEntita.NON_DEFINITO,
                            objpfPrescriptionUpload.ChiaveAlbero.Piva,
                            objpfPrescriptionUpload.ChiaveAlbero.Sa_Cod,
                            objpfPrescriptionUpload.ChiaveAlbero.Appezza,
                            objpfPrescriptionUpload.ChiaveAlbero.Campo_Cod,
                            objpfPrescriptionUpload.ChiaveAlbero.Id_Imp,
                            AGRODATAINIZIO,
                            AGRODATAFINE,
                            "",
                            "",
                            objParametri_Server)

            If dtEntita.Rows.Count <= 0 Then
                Throw New Exception("Entita GIS del impianto non trovata. Operazione interrotta")
            End If

            Dim dtElemGrafico = gis.Leggi(objParametri_Server.PivaSuperUser, 0, dtEntita.Rows(0)("Entita_Cod"), enum_Gis_LayerElementiGrafici_std.IMPIANTI, enumFromatoCartograficoConvertito.WKT, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server, 0, "ElementoGrafico_Cod")

            If dtElemGrafico.Rows.Count <= 0 Then
                Throw New Exception("Poligono del impianto non trovato. Operazione interrotta")
            End If

            Dim i As Integer
            For Each feature In featureList
                Select Case feature.Geometry.GeometryType
                    Case "Polygon"
                    Case "LineString"
                        finalObj.geoJsonCaricato.features.Add(New AgronicaCoreModelsSTD.Gis.GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp) With {
                                                                        .type = "Feature",
                                                                        .geometry = getStringGeometryGeoJson(feature.Geometry.ToString()),
                                                                        .properties = New AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp() With {
                                                                                    .layer = TipiEnumerativi.enum_Gis_LayerElementiGrafici_std.Mappe_Prescrizione,
                                                                                    .StandardEntita_layerDiAppartenenza = TipiEnumerativi.enum_Gis_LayerElementiGrafici_std.Mappe_Prescrizione,
                                                                                    .StandardEntita_layerDiAppartenenza_Des = dtLayer.Rows(0)("LayerElementiGrafici_Des"),
                                                                                    .StandardEntita_layerDiAppartenenza_Icona32 = dtLayer.Rows(0)("Icona32"),
                                                                                    .id = "",
                                                                                    .tipoicona = "",
                                                                                    .zindex = 0,
                                                                                    .Entita_Cod = -1,
                                                                                    .veg_cod = 0,
                                                                                    .inserimento = 0,
                                                                                    .modifica = 0,
                                                                                    .cancellazione = 0,
                                                                                    .informazioni = 1,
                                                                                    .flag_gps = 0,
                                                                                    .etichetta = "",
                                                                                    .chiavealbero = Albero.ChiaveAlbero_Codifica_x_json_solo_valorizzati(
                                                                                                                    "",
                                                                                                                    TipoNodo:=objpfPrescriptionUpload.ChiaveAlbero.TipoNodo,
                                                                                                                    Piva:=objpfPrescriptionUpload.ChiaveAlbero.Piva,
                                                                                                                    Sa_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Sa_Cod,
                                                                                                                    Campo_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Campo_Cod,
                                                                                                                    Appezza:=objpfPrescriptionUpload.ChiaveAlbero.Appezza,
                                                                                                                    Id_Imp:=objpfPrescriptionUpload.ChiaveAlbero.Id_Imp,
                                                                                                                    Programmazione_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Programmazione_Cod,
                                                                                                                    Programmazione_Entita_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Programmazione_Entita_Cod,
                                                                                                                    Analisi_Testata_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Analisi_Testata_Cod,
                                                                                                                    Analisi_Campione_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Analisi_Campione_Cod,
                                                                                                                    Ricetta_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Ricetta_Cod,
                                                                                                                    ricetta_Operazione_cod:=objpfPrescriptionUpload.ChiaveAlbero.RicettaOperazione_Cod,
                                                                                                                    id_agenda:=objpfPrescriptionUpload.ChiaveAlbero.Id_Agenda
                                                                                                                ),
                                                                                    .Testo = "",
                                                                                    .AppIdRate = "CAP_N+§ " + feature.Attributes(objpfPrescriptionUpload.rateColumnName).ToString(),
                                                                                    .TipologiaGML = feature.Geometry.GeometryType,
                                                                                    .InOsservazione = 0,
                                                                                    .Colore_Primario = dtLayer.Rows(0)("Colore_Primario"),
                                                                                    .Colore_Retinatura = dtLayer.Rows(0)("Colore_Primario"),
                                                                                    .Trasparenza = 1
                                                                                }
                                                                      })

                    Case "MultiPolygon"
                        For i = 0 To feature.Geometry.NumGeometries - 1
                            If {"Polygon", "LineString"}.Contains(feature.Geometry.GetGeometryN(i).GeometryType) Then
                                Dim dist = gis.Poligono_CalcolaDistanza(dtElemGrafico.Rows(0)("geodata"), feature.Geometry.GetGeometryN(i).Reverse().ToString(), 1, objParametri_Server)

                                If dist > 40 Then
                                    Throw New Exception("Area della mappa di prescrizione troppo distante dal poligono dell'impianto (Distanza rilevata " & Math.Round(dist, 2).ToString() & " m). Caricamento interrotto")
                                End If

                                finalObj.geoJsonCaricato.features.Add(New AgronicaCoreModelsSTD.Gis.GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp) With {
                                                                        .type = "Feature",
                                                                        .geometry = getStringGeometryGeoJson(feature.Geometry.GetGeometryN(i).ToString()),
                                                                        .properties = New AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp() With {
                                                                                    .layer = TipiEnumerativi.enum_Gis_LayerElementiGrafici_std.Mappe_Prescrizione,
                                                                                    .StandardEntita_layerDiAppartenenza = TipiEnumerativi.enum_Gis_LayerElementiGrafici_std.Mappe_Prescrizione,
                                                                                    .StandardEntita_layerDiAppartenenza_Des = dtLayer.Rows(0)("LayerElementiGrafici_Des"),
                                                                                    .StandardEntita_layerDiAppartenenza_Icona32 = dtLayer.Rows(0)("Icona32"),
                                                                                    .id = "",
                                                                                    .tipoicona = "",
                                                                                    .zindex = 0,
                                                                                    .Entita_Cod = 0,
                                                                                    .veg_cod = 0,
                                                                                    .inserimento = 0,
                                                                                    .modifica = 0,
                                                                                    .cancellazione = 0,
                                                                                    .informazioni = 1,
                                                                                    .flag_gps = 0,
                                                                                    .etichetta = "",
                                                                                    .chiavealbero = Albero.ChiaveAlbero_Codifica_x_json_solo_valorizzati(
                                                                                                                    "",
                                                                                                                    TipoNodo:=objpfPrescriptionUpload.ChiaveAlbero.TipoNodo,
                                                                                                                    Piva:=objpfPrescriptionUpload.ChiaveAlbero.Piva,
                                                                                                                    Sa_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Sa_Cod,
                                                                                                                    Campo_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Campo_Cod,
                                                                                                                    Appezza:=objpfPrescriptionUpload.ChiaveAlbero.Appezza,
                                                                                                                    Id_Imp:=objpfPrescriptionUpload.ChiaveAlbero.Id_Imp,
                                                                                                                    Programmazione_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Programmazione_Cod,
                                                                                                                    Programmazione_Entita_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Programmazione_Entita_Cod,
                                                                                                                    Analisi_Testata_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Analisi_Testata_Cod,
                                                                                                                    Analisi_Campione_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Analisi_Campione_Cod,
                                                                                                                    Ricetta_Cod:=objpfPrescriptionUpload.ChiaveAlbero.Ricetta_Cod,
                                                                                                                    ricetta_Operazione_cod:=objpfPrescriptionUpload.ChiaveAlbero.RicettaOperazione_Cod,
                                                                                                                    id_agenda:=objpfPrescriptionUpload.ChiaveAlbero.Id_Agenda
                                                                                                                ),
                                                                                    .Testo = "",
                                                                                    .AppIdRate = "CAP_N+§ " + feature.Attributes(objpfPrescriptionUpload.rateColumnName).ToString(),
                                                                                    .TipologiaGML = feature.Geometry.GetGeometryN(i).GeometryType,
                                                                                    .InOsservazione = 0,
                                                                                    .Colore_Primario = dtLayer.Rows(0)("Colore_Primario"),
                                                                                    .Colore_Retinatura = dtLayer.Rows(0)("Colore_Primario"),
                                                                                    .Trasparenza = 1
                                                                                }
                                                                      })
                            End If
                        Next
                    Case Else
                        'feature ignorata
                End Select
            Next

            Dim geojsonstr As String = ""
            geojsonstr = JsonConvert.SerializeObject(finalObj)

            If geojsonstr = "" Then
                Throw New Exception("Conversione in GeoJSON dello shape file fallita. Impossibile proseguire")
            End If

            'converto il geojson modello nts in geojson modello agronica
            ScriviAllegatoPrescrizione(objpfPrescriptionUpload, geojsonstr, objParametri_Server, objParametri_Utenti)

            r.RispostaOK = True
            r.RispostaStringa = "Mappa di prescrizione caricata"
        Catch ex As Exception
            r.RispostaOK = False
            r.RispostaStringa = ""
            r.Errore = ex.Message
        End Try

        Return r
    End Function

    Private Shared Sub ScriviAllegatoPrescrizione(ByVal objpfPrescriptionUpload As pfPrescriptionUploadCoreWS_In,
                                                  ByVal jsonString As String,
                                                  ByRef objParametri_Server As AgronicaCoreParametri,
                                                  ByRef objParametri_Utenti As AgronicaCoreParametri)

        Dim OUTPUT_Allegati_Documenti_Cod As Integer = -1

        'Scrivo le tabelle degli allegati in transazione
        Dim ScriviSuAllegati As New AgronicaCoreAnagrafeBIZ.Allegati_Documenti_W
        Dim rvalScriviAllegati As RispostaStandard = ScriviSuAllegati.PrecisionFarmingScriviSuAllegati(
            enum_CategorieDocumenti.PrecisionFarming_MappaPrescrizione,
            objpfPrescriptionUpload.DescrizionePiano,
            "",
            objParametri_Server,
            objpfPrescriptionUpload.ChiaveAlbero.Piva,
            objpfPrescriptionUpload.ChiaveAlbero.Sa_Cod,
            objpfPrescriptionUpload.ChiaveAlbero.Appezza,
            objpfPrescriptionUpload.ChiaveAlbero.RicettaOperazione_Cod,
            objpfPrescriptionUpload.ChiaveAlbero.Id_Imp,
            "",
            Nothing,
            jsonString,
            OUTPUT_Allegati_Documenti_Cod
        )

        If OUTPUT_Allegati_Documenti_Cod < 0 Then
            Throw New Exception("Errore in memorizzazione geojson su tabella allegati_documenti")
        End If
    End Sub

    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="objpfPrescriptionUpdate"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="objParametri_Utenti"></param>
    ''' <param name="objParametri_Super_Server"></param>
    ''' <returns></returns>
    Public Shared Function pfPrescriptionUpdate_2022(ByVal objpfPrescriptionUpdate As pfPrescriptionUpdate_In,
                                                     ByRef objParametri_Server As AgronicaCoreParametri,
                                                     ByRef objParametri_Utenti As AgronicaCoreParametri,
                                                     ByRef objParametri_Super_Server As AgronicaCoreParametri,
                                                     ByVal Optional scritturaDaEngineMappePrescrizione As Boolean = False) As RispostaStandard

        Dim r As New RispostaStandard
        Try

            If objpfPrescriptionUpdate.jsonMap = "" Then
                Throw New Exception("Mappa di prescrizione non valorizzata. Impossibile proseguire")
            End If
            If objpfPrescriptionUpdate.allegati_documenti_cod < 0 Then
                Throw New Exception("Valorizzare id allegati documenti. Impossibile proseguire")
            End If

            Dim chk = JsonConvert.DeserializeObject(Of GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))(objpfPrescriptionUpdate.jsonMap)

            If chk Is Nothing OrElse chk.geoJsonCaricato Is Nothing Then
                Throw New Exception("Verifica json map fallita. Impossibile proseguire")
            End If

            Dim LeggiCFGDatiIniziali As New AgronicaCoreVarieDAL.Configurazione_Siti_R
            Dim pathMain As String =
                    LeggiCFGDatiIniziali.Leggi_Valore(0, "GestioneEsportazioni_Repository", "", "", objParametri_Server)
            If pathMain = "" Then
                Throw New Exception("Configurazione file temporanei non trovata. impossibile proseguire")
            End If

            Dim pathTemp As String = System.IO.Path.Combine(pathMain, "EsportazionePF", Guid.NewGuid().ToString())
            If Directory.Exists(pathTemp) = False Then
                Directory.CreateDirectory(pathTemp)
            End If

            Dim filetemp = System.IO.Path.GetFileNameWithoutExtension(Path.GetRandomFileName())

            Dim gis2esri As New AgronicaPrecisionFarming.Gis2EsriShapeFile(objpfPrescriptionUpdate.appIdRateRef, "")
            gis2esri.ExportShapeFileFromGeoJson(objpfPrescriptionUpdate.jsonMap, pathTemp, filetemp)

            AgronicaCoreUtility.AgroZip.ZipAFolder(System.IO.Path.Combine(pathMain, "EsportazionePF", filetemp + ".zip"), pathTemp)

            ModificaAllegatoPrescrizione(objpfPrescriptionUpdate, System.IO.Path.Combine(pathMain, "EsportazionePF", filetemp + ".zip"), objParametri_Server, objParametri_Utenti, scritturaDaEngineMappePrescrizione, objParametri_Super_Server)

            r.RispostaOK = True
            r.RispostaStringa = "Mappa di prescrizione aggiornata"
        Catch ex As Exception
            r.RispostaOK = False
            r.RispostaStringa = ""
            r.Errore = ex.Message
        End Try

        Return r
    End Function

    Private Shared Sub ModificaAllegatoPrescrizione(ByVal objpfPrescriptionUpload As pfPrescriptionUpdate_In,
                                                    ByVal pathAllegato As String,
                                                    ByRef objParametri_Server As AgronicaCoreParametri,
                                                    ByRef objParametri_Utenti As AgronicaCoreParametri,
                                                    ByVal Optional scritturaDaEngineMappePrescrizione As Boolean = False,
                                                    ByRef Optional objParametri_Super_Server As AgronicaCoreParametri = Nothing)




        'Scrivo le tabelle degli allegati in transazione
        Dim ScriviSuAllegati As New AgronicaCoreAnagrafeBIZ.Allegati_Documenti_W
        Dim rAllegati As New AgronicaCoreAnagrafeDAL.Allegati_Documenti_R

        Dim dt = rAllegati.Leggi(objpfPrescriptionUpload.allegati_documenti_cod, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)

        Dim DescrizionePiano As String = ""
        If dt.Rows.Count <= 0 Then
            DescrizionePiano = dt.Rows(0)("").ToString("Aleggati_Documenti_Des")
        End If

        Dim rvalScriviAllegati As RispostaStandard = ScriviSuAllegati.PrecisionFarmingAggiornaAllegati(
            enum_CategorieDocumenti.PrecisionFarming_MappaPrescrizione,
            objpfPrescriptionUpload.allegati_documenti_cod,
            DescrizionePiano,
            System.IO.Path.GetFileName(pathAllegato),
            objParametri_Server,
            "",
            -1,
            -1,
            -1,
            -1,
            "",
            File.ReadAllBytes(pathAllegato),
            objpfPrescriptionUpload.jsonMap,
            scritturaDaEngineMappePrescrizione,
            objParametri_Super_Server
        )

        If rvalScriviAllegati.RispostaOK = False Then
            Throw New Exception(rvalScriviAllegati.Errore)
        End If
    End Sub

    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="objCoordFromImpresa"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <returns></returns>
    Public Shared Function CoordinateFromViaCentro_2022(ByVal objCoordFromImpresa As CoordinateFromImpresa_In,
                                                        ByRef objParametri_Server As AgronicaCoreParametri) As rispostaStandard(Of CoordsFromViaCentro_Out)
        Dim r As New rispostaStandard(Of CoordsFromViaCentro_Out) With {
            .RispostaStringa = New CoordsFromViaCentro_Out
        }

        Dim Filtro_Sa_Cod As String = (objCoordFromImpresa.Sa_Cod).ToString
        Dim Piva As String = objCoordFromImpresa.Piva

        Dim objIndirizzi As New AgronicaCoreAnagrafeDAL.Indirizzi_Read

        Dim dt As DataTable = objIndirizzi.LeggixGisCentro(Piva,
                                                           Filtro_Sa_Cod,
                                                           objParametri_Server)

        If dt.Rows.Count = 0 Then
            dt = objIndirizzi.LeggixGisCentro(Piva,
                                              "0",
                                              objParametri_Server)

            If dt.Rows.Count = 0 Then
                dt = objIndirizzi.LeggixGisCentro("",
                                                  "0",
                                                  objParametri_Server)

            End If
        End If

        If dt.Rows.Count <> 0 Then
            r.RispostaStringa.Stato = dt.Rows(0).Item("stato")
            r.RispostaStringa.Localita = dt.Rows(0).Item("localita")
            r.RispostaStringa.Provincia = dt.Rows(0).Item("provincia")
            r.RispostaStringa.Ind_Des = dt.Rows(0).Item("ind_des")
            r.RispostaStringa.Frz_Des = dt.Rows(0).Item("frz_des")
            r.RispostaStringa.Com_Des = dt.Rows(0).Item("com_des")

        Else
            r.RispostaStringa.Stato = ""
            r.RispostaStringa.Localita = ""
            r.RispostaStringa.Provincia = ""
            r.RispostaStringa.Ind_Des = ""
            r.RispostaStringa.Frz_Des = ""
            r.RispostaStringa.Com_Des = ""

        End If

        r.RispostaOK = True

        Return r

    End Function

