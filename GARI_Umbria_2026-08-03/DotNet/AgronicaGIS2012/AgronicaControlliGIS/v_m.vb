    Private Shared Function isCircle(ByVal Tipologia_Layer_Richiesta As Integer, ByVal elemento As System.Xml.Linq.XElement) As Boolean

        ' VAnni: 27/7/2018: rimuovere dalla condizione per ricomprendere anche i rilievi vegeto produttivi tematizzando poligoni...:
        'Or Tipologia_Layer_Richiesta = enum_TipologiaLayer.RilieviVegetoProduttivi

        'Return (
        '    elemento.@info_estese.Contains("§") And (Tipologia_Layer_Richiesta = enum_TipologiaLayer.Avversita)
        ') Or

        Dim rval As Boolean =
        Tipologia_Layer_Richiesta = enum_TipologiaLayer.Fenologia Or (
            Tipologia_Layer_Richiesta = enum_TipologiaLayer.Percorsi _
            And (elemento.<layers>.<layer>.Value = "81" Or
                    elemento.<layers>.<layer>.Value = "85"
            )
        )

        Return rval
    End Function

    Private Shared Function isCircleFromDataRow(ByVal Tipologia_Layer_Richiesta As Integer, ByVal row As DataRow) As Boolean

        ' VAnni: 27/7/2018: rimuovere dalla condizione per ricomprendere anche i rilievi vegeto produttivi tematizzando poligoni...:
        'Or Tipologia_Layer_Richiesta = enum_TipologiaLayer.RilieviVegetoProduttivi

        'Return (
        '    elemento.@info_estese.Contains("§") And (Tipologia_Layer_Richiesta = enum_TipologiaLayer.Avversita)
        ') Or

        If row("layer_" + Tipologia_Layer_Richiesta.ToString) Is DBNull.Value Then
            Return False
        End If

        Dim rval As Boolean =
        Tipologia_Layer_Richiesta = enum_TipologiaLayer.Fenologia Or (
            Tipologia_Layer_Richiesta = enum_TipologiaLayer.Percorsi _
            And (row("layer_" + Tipologia_Layer_Richiesta.ToString) = "81" Or
                 row("layer_" + Tipologia_Layer_Richiesta.ToString) = "85"
            )
        )

        Return rval
    End Function

    Public Shared Function CaricaAzienda() As String

        Dim objParamentri_server As New AgronicaCoreDataProvider.AgronicaCoreParametri
        objParamentri_server = HttpContext.Current.Session("ASG_objParametri_Server")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParamentri_server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim str As New StringBuilder

        Dim debugFlag = False

        If debugFlag Then

            Dim objGerarchia As New AgronicaCoreAnagrafeDAL.GerarchiaImprese_R
            Dim DtGerarchie As New DataTable
            DtGerarchie = objGerarchia.Leggi("", 1, AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParamentri_server)

            Dim strIn As String
            Dim hashtable As New Hashtable
            strIn = ""

            Dim i As Integer
            For i = 0 To DtGerarchie.Rows.Count - 1
                'AGGIUNGO IL PADRE
                If hashtable.ContainsKey(DtGerarchie.Rows(i).Item("padre")) = False Then
                    If strIn.Length > 0 Then
                        strIn = strIn + ", '" + DtGerarchie.Rows(i).Item("padre") & "' "
                    Else
                        strIn = " '" + DtGerarchie.Rows(i).Item("padre") & "' "
                    End If
                    hashtable.Add(DtGerarchie.Rows(i).Item("padre"), DtGerarchie.Rows(i).Item("padre"))
                End If
                If hashtable.ContainsKey(DtGerarchie.Rows(i).Item("Figlio")) = False Then
                    If strIn.Length > 0 Then
                        strIn = strIn + ", '" + DtGerarchie.Rows(i).Item("Figlio") & "' "
                    Else
                        strIn = " '" + DtGerarchie.Rows(i).Item("Figlio") & "' "
                    End If
                    hashtable.Add(DtGerarchie.Rows(i).Item("Figlio"), DtGerarchie.Rows(i).Item("Figlio"))
                End If
            Next

            'str.Append("<option value=''>Selezionare l'Azienda di Appartenenza</option>")
            Dim objImprese As New AgronicaCoreAnagrafeDAL.Imprese_Read
            DtGerarchie = objImprese.Leggi("", AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta, " Piva in (" & strIn & ")", "", objParamentri_server)

            For i = 0 To DtGerarchie.Rows.Count - 1
                If DtGerarchie.Rows(i).Item("Piva") = HttpContext.Current.Session("_Piva") Then
                    str.Append("<option value='" & DtGerarchie.Rows(i).Item("Piva") & "' selected='selected'>" & DtGerarchie.Rows(i).Item("rag_soc") & "</option>")
                Else
                    str.Append("<option value='" & DtGerarchie.Rows(i).Item("Piva") & "'>" & DtGerarchie.Rows(i).Item("rag_soc") & "</option>")
                End If
            Next

        Else

            Dim objImprese As New AgronicaCoreAnagrafeDAL.Imprese_Read

            Dim DtGerarchie2 As New DataTable
            DtGerarchie2 = objImprese.Leggi_4(objParamentri_server)

            For i = 0 To DtGerarchie2.Rows.Count - 1
                If DtGerarchie2.Rows(i).Item("Piva") = HttpContext.Current.Session("_Piva") Then
                    str.Append("<option value='" & DtGerarchie2.Rows(i).Item("Piva") & "' selected='selected'>" & DtGerarchie2.Rows(i).Item("rag_soc") & "</option>")
                Else
                    str.Append("<option value='" & DtGerarchie2.Rows(i).Item("Piva") & "'>" & DtGerarchie2.Rows(i).Item("rag_soc") & "</option>")
                End If
            Next

        End If

        Return str.ToString

    End Function

