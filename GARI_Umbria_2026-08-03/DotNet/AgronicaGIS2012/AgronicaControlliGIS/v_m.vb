    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="LayerElementiGrafici_Cod"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <returns></returns>
    Public Shared Function Caricaplace_tabella_Dettagli_2022(ByVal LayerElementiGrafici_Cod As Integer,
                                                             ByRef objParametri_Server As AgronicaCoreParametri) As rispostaStandard(Of Caricaplace_TabHTML_Out)
        Dim r As New rispostaStandard(Of Caricaplace_TabHTML_Out)

        'leggo tutti le impostazioni del superuser e incollo i default del super user
        Dim objLayerTiles As New AgronicaCoreGisDAL.GIS_LayerTiles_R

        Dim DTSuperUser As DataTable = objLayerTiles.Leggi(
            objParametri_Server.PivaSuperUser,
            LayerElementiGrafici_Cod,
            0,
            0,
            objParametri_Server.SuperUserUsername,
            enumSelezioneVariabile.Selezione_TabellaCompleta,
            "",
            "",
            objParametri_Server)


        Dim dtUtenteCorrente As DataTable = objLayerTiles.Leggi(
            objParametri_Server.PivaSuperUser,
            LayerElementiGrafici_Cod,
            0,
            0,
            objParametri_Server.UtenteUsername,
            AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
            "",
            "",
            objParametri_Server)

        Dim dr() As DataRow
        Dim objW As New AgronicaCoreGisDAL.GIS_LayerTiles_W

        For Each d In DTSuperUser.Rows
            dr = dtUtenteCorrente.Select("LayerTiles_cod='" & d.Item("LayerTiles_cod") & "'")

            If dr.Length = 0 Then
                objW.Scrivi(
                    objParametri_Server.PivaSuperUser,
                    d.Item("LayerElementiGrafici_Cod"),
                    objParametri_Server.UtenteUsername,
                    d.Item("LayerTiles_Cod"),
                    d.Item("TipologiaLayer_cod"),
                    d.Item("LayerTiles_Des"),
                    IIf(IsDBNull(d.Item("Colore_Primario")), "FFFFFF", d.Item("Colore_Primario")),
                    IIf(IsDBNull(d.Item("Colore_Secondario")), "FFFFFF", d.Item("Colore_Secondario")),
                    IIf(IsDBNull(d.Item("Colore_Base")), "FFFFFF", d.Item("Colore_Base")),
                    IIf(IsDBNull(d.Item("Varianza")), "1", d.Item("Varianza")),
                    d.Item("Validita_Inizio"),
                    d.Item("Validita_Fine"),
                    objParametri_Server)
            End If
        Next

        Dim dt_Ti As DataTable
        dt_Ti = objLayerTiles.Leggi(
            objParametri_Server.PivaSuperUser,
            LayerElementiGrafici_Cod,
            0,
            0,
            objParametri_Server.UtenteUsername,
            enumSelezioneVariabile.Selezione_TabellaCompleta,
            "",
            "",
            objParametri_Server)

