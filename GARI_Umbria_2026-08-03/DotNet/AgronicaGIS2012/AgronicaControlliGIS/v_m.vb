    Public Shared Sub TrattamentiPresenti(ByRef oImp As v_m_ObjImpiantoPiccolo, ByVal objParametri_server As AgronicaCoreParametri)
        Dim o As New AgronicaCoreContabDAL.Mov_Destinazioni_R()
        Dim strFiltroLavCod As String = " Lav_Cod IN (74,13,158,155,103,18) "

