        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim StrVariabiliFiltro As String
        Dim Piva As String
        Dim lShouldReturn As String
        Dim id_agenda As Integer = 0

        If Not String.IsNullOrEmpty(ChiaveAlbero) Then
            id_agenda = ChiaveAlbero.Split(SeparatoreAlberoJson)(25)
        End If

        Dim idleListOfImpianto As List(Of Impianto)

        Dim lResult As String = Gestione_RicettaAgendaxml(ChiaveAlbero, ObjParametri_Server, StrVariabiliFiltro, veg_cod, Piva, lShouldReturn, idleListOfImpianto, id_agenda)


        objOpAgenda2010.Id_Agenda = 0
        objOpAgenda2010.Piva = ""
