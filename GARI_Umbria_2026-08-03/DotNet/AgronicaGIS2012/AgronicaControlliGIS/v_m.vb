    Private Shared Sub AppendiDatiXmlLettiDaAllegati(
           inData As AppendiDatiXmlLettiDaAllegatiParamIn
    )

        Dim leggiAllegati As New AgronicaCoreAnagrafeDAL.Allegati_Documenti_R
        If String.IsNullOrEmpty(inData.sFiltroAllegatiDocumentiCod) Then
            inData.sFiltroAllegatiDocumentiCod = " allegati_Documenti_Cod in (" &
            AgronicaCoreAnagrafeBIZ.Allegati_Documenti.LeggiListaAllegatiDocumentiCodDaListaRicettaOperazioni(inData.objParametri_Server, inData.sFiltroRicettaOperazioneCod) &
        ")"
        End If

        Dim dtResult = leggiAllegati.LeggiXML_JSON(0, AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta, inData.sFiltroAllegatiDocumentiCod, "", inData.objParametri_Server, inData.lPiva)
        If dtResult.Rows.Count <= 0 Then
            Exit Sub
        End If

        If dtResult.Rows(0)("allegatiDocumentiText") Is DBNull.Value Then
            Dim xmlPrescription As String = dtResult.Rows(0)("allegatiDocumentiXML")
            If String.IsNullOrEmpty(xmlPrescription) Then
                Exit Sub
            End If
            Dim xDocP As XDocument = XDocument.Parse(xmlPrescription)

            For Each nn As XElement In xDocP.<DatiEntita>.<Entita>.ToList()
                inData.xCounter -= 1
                Dim dg As XElement = nn.<EntitaGIAS>.<DatoGias>.First
                dg.<Entita_Cod>.Value = inData.xCounter
                dg.Add(<InOsservazione>0</InOsservazione>)
                dg.Add(<Colore_Primario>#00FF00</Colore_Primario>)
                dg.Add(<Colore_Retinatura>#00FF00</Colore_Retinatura>)
                dg.Add(<Trasparenza>1</Trasparenza>)
                dg.Add(<flag_gps>0</flag_gps>)
                dg.Add(<StandardEntita_layerDiAppartenenza><%= CInt(inData.StandardEntita_layerDiAppartenenza) %></StandardEntita_layerDiAppartenenza>)
                dg.Add(<ETICHETTA></ETICHETTA>)

                nn.Add(New XAttribute("info_estese", ""))
                nn.Add(New XAttribute("TipoIcona", ""))

                Dim dettaglio = <Dettaglio>
                                    <PrecisionFarming>
                                        <AppIdRate/>
                                        <Speed/>
                                        <Height/>
                                    </PrecisionFarming>
                                </Dettaglio>
                nn.Add(dettaglio)

                Dim datiAnagrafici = <DatiAnagrafici>
                                         <Impianto/>
                                     </DatiAnagrafici>
                nn.Add(datiAnagrafici)

                Dim planning = <Planning>
                                   <programmazione_entita/>
                               </Planning>
                nn.Add(planning)

                Dim autorizzazioni = <autorizzazioni>
                                         <gis>
                                             <inserimento>False</inserimento>
                                             <modifica>False</modifica>
                                             <cancellazione>False</cancellazione>
                                             <informazioni>True</informazioni>
                                         </gis>
                                     </autorizzazioni>

                nn.Add(autorizzazioni)


                CType(inData.xml.FirstNode, XElement).Add(nn)

            Next

            Dim ns As XNamespace = "http://www.opengis.net/gml"
            Dim myGeoJson = GetPlaceGeoJSONToGeoJsonNew(inData.xml, ns, 1)
            Dim allegatiW As New AgronicaCoreAnagrafeDAL.Allegati_Documenti_W
            Dim jsonStr = JsonConvert.SerializeObject(myGeoJson)

            If allegatiW.Modifica("", "", "", "", "", AGRODATAINIZIO, AGRODATAFINE, dtResult.Rows(0)("Allegati_Documenti_Cod"), inData.objParametri_Server, strJSON:=jsonStr) = True Then
                inData.json = jsonStr
                inData.xml = Nothing
            Else
                Throw New Exception("Errore conversione da xml a json dell'allegato")
            End If

        Else
            inData.json = dtResult.Rows(0)("allegatiDocumentiText")
        End If

    End Sub


