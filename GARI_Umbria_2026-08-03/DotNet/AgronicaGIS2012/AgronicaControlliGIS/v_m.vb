    Public Shared Function CaricaCampiDatoCentroAziendale(ByVal Piva As String, ByVal sa_cod As String, ByVal isSementi As Boolean, ByVal planning1impianti2 As String) As String

        Dim objParamentri_server As New AgronicaCoreDataProvider.AgronicaCoreParametri
        objParamentri_server = HttpContext.Current.Session("ASG_objParametri_Server")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParamentri_server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim str As New StringBuilder
        'str.Append("<option value='new'>Nuovo Centro Aziendale</option>")


        Dim dt As DataTable

        If planning1impianti2 = 2 Then
            Dim objcampi As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
            dt = objcampi.Leggi_DescrizioniImpianti2(Piva, sa_cod, 0, 0, AGRODATAINIZIO, AGRODATAFINE, "", "", objParamentri_server)
        Else
            Dim objplann As New AgronicaCoreAnagrafeDAL.Programmazione_Testata_R


            dt = objplann.Leggi_X_Albero(
                0,
                "",
                Piva,
                sa_cod,
                AGRODATAINIZIO,
                AGRODATAFINE,
                "",
                "",
                objParamentri_server
            )

        End If

        Dim desSA As String = ""


        Dim i As Integer
        Dim lenLat As Integer = 1
        Dim lenlong As Integer = 1

        For i = 0 To dt.Rows.Count - 1

            Dim lappendata As String = ""
            Dim lappezza As Integer = 0
            Dim lidREg As Integer = 0
            Dim programmazione_cod As Integer = 0

            If planning1impianti2 = 2 Then
                Dim campo As String = dt.Rows(i).Item("Campo_des")
                If Not String.IsNullOrEmpty(campo) Then
                    campo &= " - "
                End If
                desSA =
                     campo &
                    dt.Rows(i).Item("app_nome") &
                    " (" & dt.Rows(i).Item("app_nome") & ") - " &
                    dt.Rows(i).Item("Veg_Des") & " (" & dt.Rows(i).Item("Cul_Des") & ")"


                If isSementi Then

                    lenLat = dt.Rows(i).Item("lat").ToString.Length
                    lenlong = dt.Rows(i).Item("long").ToString.Length
                    If lenLat > 6 Then lenLat = 6
                    If lenlong > 6 Then lenlong = 6

                    desSA &= " (Lat.: " & dt.Rows(i).Item("lat").ToString.Substring(0, lenLat) & ", Long.:" &
                        dt.Rows(i).Item("long").ToString.Substring(0, lenlong) & ")"


                End If


                lappezza = dt.Rows(i).Item("appezza")
                lidREg = dt.Rows(i).Item("Id_Reg")

            Else
                programmazione_cod = dt.Rows(i).Item("Programmazione_cod")
                desSA = dt.Rows(i).Item("Programmazione_des")
            End If



            lappendata = Piva & "°" & sa_cod & "°" & lappezza & "°" & lidREg & "°" & programmazione_cod
            If i = 0 Then
                str.Append("<option value='" & lappendata & "' selected='selected'>" & desSA & "</option>")
            Else
                str.Append("<option value='" & lappendata & "'>" & desSA & "</option>")
            End If



        Next

        Return str.ToString
    End Function


