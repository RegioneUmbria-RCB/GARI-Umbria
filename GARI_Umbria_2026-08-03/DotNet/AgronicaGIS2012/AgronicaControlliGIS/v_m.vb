    Public Shared Function DatiAppezzamentoAggiuntivi(ByVal EntitaCod As Integer, ByVal hipenChar As String, objParametri_Server As AgronicaCoreParametri, objParametri_utenti As AgronicaCoreParametri) As String

        Dim objDatiAppezza = New AgronicaCoreGisDAL.GIS_Entita_R
        Dim dtDatiAppezza As DataTable =
            objDatiAppezza.LeggiCompleto_Entita_cod(EntitaCod, "", "", objParametri_Server)


        Dim stb As New StringBuilder

        If dtDatiAppezza.Rows.Count = 1 Then

            Dim piva As String = dtDatiAppezza.Rows(0)("piva")
            Dim sa_cod As Integer = dtDatiAppezza.Rows(0)("sa_cod")
            Dim appezza As Integer = dtDatiAppezza.Rows(0)("appezza")

            Dim objAnagrafeRipartoDAL = New AgronicaCoreAnagrafeDAL.AppezzaxParticelle_R
            Dim dtDatiRiparto As DataTable =
                objAnagrafeRipartoDAL.LeggiParticelle_Da_Appezzamento(piva, sa_cod, appezza, enumSelezioneVariabile.Selezione_JoinDescrizioni, "", "", objParametri_Server)

            For Each RigaParticella In dtDatiRiparto.Rows

                Dim objAnagrafeParCodDAL = New AgronicaCoreAnagrafeDAL.ImpresexParticelle_Codici_R
                Dim dtCod As DataTable =
                objAnagrafeParCodDAL.LeggiConDescrizioni(
                    0,
                    0,
                    piva,
                    sa_cod,
                    RigaParticella("prov"),
                    RigaParticella("com"),
                    RigaParticella("sezione"),
                    RigaParticella("foglio"),
                    RigaParticella("numero"),
                    RigaParticella("subalterno"),
                    1318,
                    "",
                    "",
                    "",
                    objParametri_Server)

                For Each rigaConduzione In dtCod.Rows
                    DatiCatastoAggiuntiviRigaConduzione(stb, rigaConduzione, True)
                Next
                'per ciascuna riga in conduzione.

            Next
            'RigaParticella

        End If
        'se trovato un appezzamento

        Return "<span style='font-weight: bold'>" &
               AgronicaCoreUtility.jSon.Escape("Conduzione:") & "</span>§" & stb.ToString() & "|"

    End Function

    Public Shared Function DatiCatastoAggiuntivi(ByVal EntitaCod As Integer,
                                                 ByVal hipenChar As String,
                                                 ByRef objParametri_Server As AgronicaCoreParametri,
                                                 ByRef objParametri_utenti As AgronicaCoreParametri) As String

        'dati intersezione con centri aziendali
        Dim obRiparto As New AgronicaCoreAnagrafeDAL.AppezzaxParticelle_R
        Dim objAnagrafeParCodDAL = New AgronicaCoreAnagrafeDAL.ImpresexParticelle_Codici_R
        Dim dtCod As DataTable =
            objAnagrafeParCodDAL.LeggiConDescrizioni(EntitaCod, 0, "", 0, "", "", "", 0, 0, "", 1318, "", "", "", objParametri_Server)

        Dim LeggiLog As New AgronicaCoreAnagrafeDAL.CatastoModificheParticelleXAppezzamentiLog_R


        Dim stb As New StringBuilder

        Dim sommaRipartoComplessiva As Decimal = 0
        Dim sommaSupCondottaComplessiva As Decimal = 0

        For Each riga In dtCod.Rows

            DatiCatastoAggiuntiviRigaConduzione(stb, riga, False)

            'dettaglio del riparto del catasto su impianti
            Dim dtRiparto As DataTable =
                obRiparto.LeggiAppezzamenti_Da_ParticellaGis(
                True,
                False,
                False,
                EntitaCod,
                riga("Piva"),
                riga("sa_Cod"),
                Now.Date,
                Now.Date,
                0,
                False,
                New StringBuilder,
                enumSelezioneVariabile.Selezione_TabellaCompleta,
                "",
                "",
                objParametri_Server)

            stb.Append("<span style='text-decoration: underline; color:blue'>" &
                       AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_DatiCatastoAggiuntivi_Riparto_appezzamenti) & "</span><br /><table class='tblRiparto'>")

            Dim sommaRiparto As Decimal = 0

            For Each rigaDettaglioRiparto As DataRow In dtRiparto.Rows


                Dim dtLeggiLog As DataTable =
                LeggiLog.Leggi(0, rigaDettaglioRiparto("piva"), rigaDettaglioRiparto("sa_cod"), 0, rigaDettaglioRiparto("appezza"),
                    rigaDettaglioRiparto("prov"), rigaDettaglioRiparto("com"), rigaDettaglioRiparto("sezione"), rigaDettaglioRiparto("foglio"), rigaDettaglioRiparto("numero"), rigaDettaglioRiparto("subalterno"), enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)

                Dim infoGeneraliRiparto As String =
                    GetInfoGeneraliRipartoLog(dtLeggiLog, objParametri_utenti)

                sommaRipartoComplessiva += rigaDettaglioRiparto("Area")
                sommaRiparto += rigaDettaglioRiparto("Area")
                stb.Append("<tr><td><span>" & AgronicaCoreUtility.jSon.Escape(rigaDettaglioRiparto("App_nome")) & "</span></td>")
                stb.Append("<td class='ColonnaRiaparto1'><span class='InfoRiparto1'>" & AgronicaCoreUtility.jSon.Escape(rigaDettaglioRiparto("Area") & "</span></td> "))
                stb.Append("<td class='ColonnaReportInfo'><span style='' class='ReportInfoRiparto1'>" & infoGeneraliRiparto & "</span></td>")
                stb.Append("</tr>")

            Next
            'appezzamento

            stb.Append("<tr class='ColonnaDesSommaRiaparto1'><td><span>" &
                       AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_DatiCatastoAggiuntivi_Superficie_riparto) & "</span></td>")
            stb.Append("<td class='ColonnaRiaparto1'><span class='SommaRipartoCentro'>" & sommaRiparto.ToString() & "</span></td> ")
            stb.Append("<td></td>")
            stb.Append("</tr>")
            stb.Append("</table>")

            sommaSupCondottaComplessiva += riga("Sup_Condotta")
        Next
        'centro

        stb.Append("<span style='font-weight: bold'>" &
                   AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_DatiCatastoAggiuntivi_Superficie_riparto_complessiva) &
                   "</span><span class='SommaRiparto1'>" & sommaRipartoComplessiva.ToString() & "</span> <br />")
        stb.Append("<span style='font-weight: bold'>" &
                   AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_DatiCatastoAggiuntivi_Superficie_condotta_complessiva) &
                   "</span><span class='SommaTotaleSuperficieCondotta'>" & sommaSupCondottaComplessiva.ToString() & "</span> ")


        Return "<span style='font-weight: bold'>" &
               AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_DatiCatastoAggiuntivi_Particella_assegnata) & "</span>§" & stb.ToString() & "|"

    End Function

    Private Shared Sub DatiCatastoAggiuntiviRigaConduzione(stb As StringBuilder, riga As DataRow, RiportaInfoParticella As Boolean)

        If RiportaInfoParticella Then
            stb.Append("<br/> <span style='text-decoration: underline; color:blue'>Particella: <span style='font-weight: bold'>" & riga("DescrizioneParticella") & "</span></span>")
        End If

        stb.Append("<br /><span style='text-decoration: underline; color:blue'>" & AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_DatiCatastoAggiuntivi_Impresa_centro_codici) & "</span><br />")
        stb.Append(AgronicaCoreUtility.jSon.Escape(riga("Rag_soc")) & " - ")
        stb.Append(AgronicaCoreUtility.jSon.Escape(riga("sa_nome")) & " ... ")
        stb.Append(TitoloPossessoDes_from_TitoloPossessoCod(riga("TitoloPossesso")) & " - ")
        stb.Append(AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_DatiCatastoAggiuntivi_Sup_condotta_) & "<span class='supCondottaSingoloCentro'> " & riga("Sup_condotta") & "</span> - ")
