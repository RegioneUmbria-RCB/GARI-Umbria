    Public Shared Function GeneraDescrizionePlanning(ByVal ChiaveAlbero As String) As String

        'todo: session
        Lingua.Gias_InizializzaCultura_DaSession()

        Dim rval As String = ""

        Dim appPivaSacod As String() = ChiaveAlbero.Split(SeparatoreAlberoJson)
        Dim piva As String = appPivaSacod(1)
        Dim sa_cod As Integer = appPivaSacod(2)

        Dim cond As String = " (rr.APPEZZA = __ap__ and ID_REG = __imp__) OR "
        Dim condFinal As String = ""
        '(rr.APPEZZA = 68026675 and ID_REG = 68026369) OR
        '(rr.APPEZZA = 68026676 and ID_REG = 68026369)

        For Each sNodo As String In ChiaveAlbero.Split("|")

            Dim lappezza As Integer
            Dim lid_reg As Integer

            Dim spApp As String() = sNodo.Split(SeparatoreAlberoJson)

            lappezza = spApp(4)
            lid_reg = spApp(5)

            condFinal &= cond.Replace("__ap__", lappezza).Replace("__imp__", lid_reg)

        Next

        condFinal = condFinal.Substring(0, condFinal.Length - 4)

        Dim ObjParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")

        Dim pf As New AgronicaCoreGisDAL.PrecisionFarming
        Dim dtDes As DataTable = pf.ProponiDescrizioneImpiantiAggregati(
            piva,
            sa_cod,
            condFinal,
            enumSelezioneVariabile.Selezione_TabellaCompleta,
            "",
            "",
            ObjParametri_Server
        )

        If dtDes.Rows.Count > 0 Then

            rval = rval & dtDes.Rows(0)("sa_nome") & "_"

            For Each drDes As DataRow In dtDes.Rows

                Dim lCampo As String = drDes("campo_des")
                If lCampo <> "" AndAlso Not rval.Contains(lCampo) Then
                    rval &= lCampo & "_"
                End If

                Dim lveg As String = drDes("veg_des")
                If lveg <> "" AndAlso Not rval.Contains(lveg) Then
                    rval &= lveg & "_"
                End If

                'rval &= drDes("app_nome")

            Next

            rval = svuotaCaratteri(rval)
            rval = rval.TrimEnd(" ").TrimEnd("_")
        Else
            rval = ""
        End If

        Return rval

    End Function

    Private Shared Function svuotaCaratteri(ByVal s As String) As String
        Dim scaratteriSotituire As String = " _àaìiùuèeéeòo'_°_^_£_?_#_*_@_|_/_._"
        For i As Integer = 0 To scaratteriSotituire.Length - 2 Step 2
            s = s.Replace(scaratteriSotituire(i), scaratteriSotituire(i + 1))
        Next

        Return s
    End Function

