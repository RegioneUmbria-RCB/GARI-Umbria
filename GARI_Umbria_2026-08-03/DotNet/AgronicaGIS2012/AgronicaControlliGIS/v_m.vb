                r.RispostaStringa.MessaggioEsito = My.Resources.AgronicaControlliGIS.V_M_VerificaInterferenze_Nessuna_interferenza_rilevata

            Else
                If obj_VerificaInterferenze.CampoPiuVicino = 0 Then
                    r.RispostaStringa.MessaggioEsito = My.Resources.AgronicaControlliGIS.V_M_VerificaInterferenze_Trovate_le_seguenti_interferenze

                Else
                    r.RispostaStringa.MessaggioEsito = My.Resources.AgronicaControlliGIS.V_M_VerificaInterferenze_Campo_più_vicino

