                                             ByRef objParametri_Server As AgronicaCoreParametri,
                                             ByRef objParametri_Utenti As AgronicaCoreParametri) As rispostaStandard(Of GetProprieta_Out)
        Dim r As New rispostaStandard(Of GetProprieta_Out)

        Dim Entita_Cod As String = obj_GetProp.Entita_Cod
        Dim Tipo_GP As Integer = obj_GetProp.Tipo_GetProp

        Dim objGIS As New AgronicaCoreGisDAL.GIS_Entita_R
