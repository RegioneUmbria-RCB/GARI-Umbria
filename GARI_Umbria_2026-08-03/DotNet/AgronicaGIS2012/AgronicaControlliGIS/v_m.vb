        UtenteAbilitato = False
        UtenteAbilitato = objUtenti.Controlla_Permessi_Utente(objParametri_Server.UtenteUsername,
                                                              5,
                                                              enum_Security_Attivita.Cartografia_BufferZone,
                                                              enum_Security_Operazione.Modifica,
                                                              Date.Now,
                                                              "",
                                                              objParametri_Utenti)
        permessoBufferZone = (UtenteAbilitato Or isSuperUser(objParametri_Server))

        UtenteAbilitato = False
        UtenteAbilitato = objUtenti.Controlla_Permessi_Utente(objParametri_Server.UtenteUsername,
                                                              5,
                                                              enum_Security_Attivita.Analisi_Dati_Meteo,
                                                              enum_Security_Operazione.Modifica,
                                                              Date.Now,
