    Private Shared Function getCoord(ByVal ns As XNamespace, ByRef JSON As StringBuilder, ByVal elemento As XElement) As String
        Dim str As String() =
                        GML.DammiArrayCoordinateDatoXml(ns, elemento.<geodata>.FirstOrDefault)

        Dim strVertici As New StringBuilder
        Dim i As Integer

        Dim lContaVertici As Integer

        If CType(elemento.<geodata>.FirstOrDefault.DescendantNodes.FirstOrDefault, XElement).Name.ToString.ToLower.Contains("linestring") Then

            lContaVertici = 1
        Else

            lContaVertici = 4
            If str.Count <= 4 Then
                lContaVertici = 1
            End If

        End If

        For i = 0 To str.Count - lContaVertici
            If strVertici.Length > 0 Then
                strVertici.Append(",{")
            Else
                strVertici.Append("{")
            End If
            strVertici.Append("""lat"":""" & str(i) & """,")
            i = i + 1
            strVertici.Append("""long"":""" & str(i) & """")

            strVertici.Append("}")
        Next

        If Not JSON Is Nothing Then
            JSON.Append(strVertici.ToString)
            Return ""
        End If

        Return strVertici.ToString

    End Function

