    Public Shared Function CaricaCentroAziendale(ByVal Piva As String, ByVal isSementi As Boolean, Optional ByRef objParamentri_server As AgronicaCoreParametri = Nothing) As String

        If IsNothing(objParamentri_server) Then
            objParamentri_server = HttpContext.Current.Session("ASG_objParametri_Server")

            If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParamentri_server) Then
                Return "SessioneScaduta"
            End If
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim str As New StringBuilder
        'str.Append("<option value='new'>Nuovo Centro Aziendale</option>")


        Dim dt As DataTable
        Dim objCentro As New AgronicaCoreAnagrafeDAL.CentriAziendali_Read
        dt = objCentro.Leggi(Piva, 0, AgronicaCoreParametri.enumSelezioneVariabile.Selezione_JoinDescrizioni, "", "", objParamentri_server)

        Dim desSA As String = ""

        Dim i As Integer
        Dim lenLat As Integer = 1
        Dim lenlong As Integer = 1

        For i = 0 To dt.Rows.Count - 1

            desSA = dt.Rows(i).Item("Sa_nome")

            If isSementi Then

                lenLat = dt.Rows(i).Item("lat").ToString.Length
                lenlong = dt.Rows(i).Item("long").ToString.Length
                If lenLat > 6 Then lenLat = 6
                If lenlong > 6 Then lenlong = 6

                desSA &= " (Lat.: " & dt.Rows(i).Item("lat").ToString.Substring(0, lenLat) & ", Long.:" &
                    dt.Rows(i).Item("long").ToString.Substring(0, lenlong) & ")"


            End If
            desSA &= " | " &
                       dt.Rows(i).Item("ind_des") & ", " & dt.Rows(i).Item("CAP") & " " & dt.Rows(i).Item("Com_Des")


            Dim lAppendPiva As String = ""
            'If isSementi Then
            lAppendPiva = Piva & "|"
            'End If


            If i = 0 Then


                str.Append("<option value='" & lAppendPiva & dt.Rows(i).Item("sa_cod") & "' selected='selected'>" & desSA & "</option>")
            Else
                str.Append("<option value='" & lAppendPiva & dt.Rows(i).Item("sa_cod") & "'>" & desSA & "</option>")
            End If

        Next

        Return str.ToString
    End Function



