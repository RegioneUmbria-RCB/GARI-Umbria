    Public Shared Function STBufferGeoJsonPolygon(ByVal objParametri_server As AgronicaCoreParametri, InData As STBufferGeoJsonPolygonInData) As rispostaStandard(Of STBufferGeoJsonPolygonOutData)


        Dim rval As New rispostaStandard(Of STBufferGeoJsonPolygonOutData)
        Dim wktAllargato As String = ""
        Dim wkt As String = ""

        Dim geoJsonctrl As New GeoJsonController(Of GeoJson_EmptyProperties)

        Try


            'converto dati in ingresso da GeoJson a WKT
            wkt = geoJsonctrl.STAsText(InData.PolygonGeoJson)

            Dim wktTestr As New AgronicaCoreGisDAL.GIS_ElementiGrafici_W
            Dim wktEsitoTest As Boolean = wktTestr.TestaPoligono(wkt)

            If Not wktEsitoTest Then
                'da antiorario ad orario
                wkt = AgronicaGIS2012.Commons.PolygonOrder.InvertiPoligono_wkt(wkt, False)
            End If

            'chiamo la funzione che "aumenta" il poligono
            Dim oDal As New AgronicaCoreGisDAL.GIS_OperazioniCartograficheDB
            wktAllargato = oDal.STBufferFromWKTString(wkt, InData.Metri, objParametri_server)

            'converto dati restituiti da WKT a GeoJSON
            rval.RispostaStringa = New STBufferGeoJsonPolygonOutData
            rval.RispostaStringa.PolygonGeoJson = geoJsonctrl.ObjJsonFromWKT(wktAllargato)
            rval.RispostaOK = True

        Catch ex As Exception

            wktAllargato = wkt

            rval.RispostaStringa = New STBufferGeoJsonPolygonOutData
            rval.RispostaStringa.PolygonGeoJson = geoJsonctrl.ObjJsonFromWKT(wktAllargato)
            rval.RispostaOK = True

        End Try

        Return rval

    End Function

    Public Shared Sub GetPlaceGeoJSON(ByRef strs As String, ByVal xdoc As XDocument, ByVal ns As XNamespace, ByVal Tipologia_Layer_Richiesta As Integer)

        Dim JSON As New StringBuilder

        Dim listaPlaces1 = (
            From a In xdoc.<DatiEntita>.<Entita>
            Where a.<EntitaGIAS>.<DatoGias>.<Entita_Cod>.Value <> 0
            Select a).ToList()

        Dim listaPlaces As New List(Of XElement)


        If (From l In listaPlaces1.<layers>.<layer> Select l.@tipologia_layer).FirstOrDefault = Tipologia_Layer_Richiesta.ToString Then
            listaPlaces = listaPlaces1
        Else

            For Each e In listaPlaces1

                'lista dei layer: su ciascuno di questi sarà creata una nuova entitaà.
                Dim l1 = (
                    From l In e.<layers>.<layer>
                    Select l).ToList

                Dim layAdded As New List(Of String)
                For Each lll In l1


                    If lll.@tipologia_layer = Tipologia_Layer_Richiesta _
                        And Not String.IsNullOrEmpty(lll.Value.ToString) Then

                        Dim cloneE As XElement = (From e11 In e.DescendantsAndSelf Select New XElement(e11)).FirstOrDefault

                        'CVDOCG: gestire la visualizzazione di rilievi dove viene indicata più di un avversità
                        Dim newLayerElem As XElement =
                            <layers>
                                <layer tipologia_layer=<%= Tipologia_Layer_Richiesta %>><%= lll.Value.ToString %></layer>
                            </layers>

                        cloneE.<layers>.Remove()
                        cloneE.Add(newLayerElem)

                        listaPlaces.Add(cloneE)


                    End If
                Next 'l1

            Next 'ListaPlace1
        End If


        Dim finalObj As New GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
        finalObj.geoJsonCaricato = New GeoJson_Shape_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
        finalObj.geoJsonCaricato.type = "FeatureCollection"


        Dim tmplayers As XElement = (
                      From a In xdoc.<DatiEntita>.<layersdescrizioni>.<layer>
                      Where a.@tipologia_layer = Tipologia_Layer_Richiesta
                      Select a
                      ).FirstOrDefault

        Dim tmplayersDefault As XElement = (
                      From a In xdoc.<DatiEntita>.<layersdescrizioni>.<layer>
                      Where a.@tipologia_layer = enum_TipologiaLayer.Std
                      Select a
                      ).FirstOrDefault

        'la selezione del layer avviene attraverso il join su tmplayerEspolosi
        '"{""layer"":""" & _
        '                ( _
        '                   From ly In elemento.<layers>.<layer> _
        '                   Where ly.@tipologia_layer = Tipologia_Layer_Richiesta _
        '                   Select ly.Value _
        '                 ).FirstOrDefault.ToString & """," & _



        'Dim idleXml As String = ""
        'For Each ll In listaPlaces
        '    idleXml &= ll.ToString
        'Next

        finalObj.geoJsonCaricato.features =
        (
            From elemento In listaPlaces
            Where elemento.<layers>.<layer>.@tipologia_layer = Tipologia_Layer_Richiesta
            Select New GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp) With {
                .type = "Feature",
                .geometry = getGeometryGeoJson2(elemento),
                .properties = New AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp With {
                    .layer = elemento.<layers>.<layer>.Value,
                    .StandardEntita_layerDiAppartenenza = elemento.<EntitaGIAS>.<DatoGias>.<StandardEntita_layerDiAppartenenza>.Value,
                    .StandardEntita_layerDiAppartenenza_Des =
                      (From b In tmplayersDefault.<valori>
                       Where b.@codice = elemento.<EntitaGIAS>.<DatoGias>.<StandardEntita_layerDiAppartenenza>.Value
                       Select b.Value).FirstOrDefault.ToString,
                    .StandardEntita_layerDiAppartenenza_Icona32 =
                      (From b In tmplayersDefault.<valori>
                       Where b.@codice = elemento.<EntitaGIAS>.<DatoGias>.<StandardEntita_layerDiAppartenenza>.Value
                       Select b.@icona32).FirstOrDefault.ToString,
                .id = elemento.<EntitaGIAS>.<DatoGias>.<PivaSuperUser>.Value & "|" &
                    elemento.<EntitaGIAS>.<DatoGias>.<Entita_Cod>.Value,
                .tipoicona = elemento.@TipoIcona.Replace("""", " "),
                .zindex = (From b In tmplayers.<valori>
                           Where b.@codice = (
                             From ly In elemento.<layers>.<layer>
                             Where ly.@tipologia_layer = Tipologia_Layer_Richiesta
                             Select ly
                           ).Value
                           Select b.@ZIndex).FirstOrDefault.ToString,
                .Entita_Cod = elemento.<EntitaGIAS>.<DatoGias>.<Entita_Cod>.Value,
                .veg_cod = IIf(
                        elemento.<DatiAnagrafici>.<Impianto>.<veg_cod>.Value = "",
                            IIf(
                                elemento.<Planning>.<programmazione_entita>.<veg_cod>.Value = "",
                                "-1",
                                elemento.<Planning>.<programmazione_entita>.<veg_cod>.Value
                                ),
                    elemento.<DatiAnagrafici>.<Impianto>.<veg_cod>.Value
                    ).ToString,
                .inserimento = elemento.<autorizzazioni>.<gis>.<inserimento>.Value,
                .modifica = elemento.<autorizzazioni>.<gis>.<modifica>.Value,
                .cancellazione = elemento.<autorizzazioni>.<gis>.<cancellazione>.Value,
                .informazioni = elemento.<autorizzazioni>.<gis>.<informazioni>.Value,
                .flag_gps = elemento.<EntitaGIAS>.<DatoGias>.<flag_gps>.Value,
                .etichetta = AgronicaCoreUtility.jSon.Escape(elemento.<EntitaGIAS>.<DatoGias>.<ETICHETTA>.Value),
                .chiavealbero = If(
                            CInt(elemento.<EntitaGIAS>.<DatoGias>.<TipoNodoAlberoAnagrafe>.Value) = AgronicaCoreDataProvider.TipiEnumerativi.enum_TipoNodo.Particella,
                            AgronicaCoreDataProvider.Albero.ChiaveAlbero_Codifica_x_json_solo_valorizzati(
                            "",
                            TipoNodo:=elemento.<EntitaGIAS>.<DatoGias>.<TipoNodoAlberoAnagrafe>.Value,
                            Piva:=elemento.<EntitaGIAS>.<DatoGias>.<Piva>.Value,
                            Sa_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<Sa_Cod>.Value,
                            Campo_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<Campo_Cod>.Value,
                            Appezza:=elemento.<EntitaGIAS>.<DatoGias>.<Appezza>.Value,
                            Id_Imp:=elemento.<EntitaGIAS>.<DatoGias>.<Id_Imp>.Value,
                            p_Part_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<part_cod>.Value,
                            p_Provincia_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<PROV>.Value,
                            p_Comune_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<COM>.Value,
                            p_Sezione:=elemento.<EntitaGIAS>.<DatoGias>.<SEZIONE>.Value,
                            p_Foglio:=elemento.<EntitaGIAS>.<DatoGias>.<FOGLIO>.Value,
                            p_Numero:=elemento.<EntitaGIAS>.<DatoGias>.<NUMERO>.Value,
                            p_Subalterno:=elemento.<EntitaGIAS>.<DatoGias>.<SUBALTERNO>.Value
                        ),
                        AgronicaCoreDataProvider.Albero.ChiaveAlbero_Codifica_x_json_solo_valorizzati(
                                    "",
                                    TipoNodo:=elemento.<EntitaGIAS>.<DatoGias>.<TipoNodoAlberoAnagrafe>.Value,
                                    Piva:=elemento.<EntitaGIAS>.<DatoGias>.<Piva>.Value,
                                    Sa_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<Sa_Cod>.Value,
                                    Campo_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<Campo_Cod>.Value,
                                    Appezza:=elemento.<EntitaGIAS>.<DatoGias>.<Appezza>.Value,
                                    Id_Imp:=elemento.<EntitaGIAS>.<DatoGias>.<Id_Imp>.Value,
                                    Programmazione_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<Programmazione_Cod>.Value,
                                    Programmazione_Entita_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<Programmazione_Entita_Cod>.Value,
                                    Analisi_Testata_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<analisi_testata_cod>.Value,
                                    Analisi_Campione_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<analisi_campione_cod>.Value,
                                    Ricetta_Cod:=elemento.<EntitaGIAS>.<DatoGias>.<Ricetta_Cod>.Value,
                                    ricetta_Operazione_cod:=elemento.<EntitaGIAS>.<DatoGias>.<Ricetta_Operazione_Cod>.Value,
                                    id_agenda:=elemento.<EntitaGIAS>.<DatoGias>.<ID_Agenda>.Value
                                )
                    ).ToString,
                .Testo = AgronicaCoreUtility.jSon.Escape(elemento.@text.Replace("""", " ")),
                .AppIdRate = IIf(
                         elemento.@text.ToString.Contains("§"),
                         AgronicaCoreUtility.jSon.Escape(elemento.@text.ToString).Replace(",", "."),
                         IIf(
                             elemento.@info_estese.Contains("§"),
                             elemento.@info_estese.ToString,
