        analisi_campione_cod = DTLetturaDatiEntita(0)("analisi_campione_cod")
        LayerElementiGrafici_Cod = DTLetturaDatiEntita(0)("LayerElementiGrafici_Cod")

        If programmazione_cod <> 0 OrElse programmazione_entita_cod <> 0 Then
            Preventivo1_Consuntivo2 = 1

        Else
            Preventivo1_Consuntivo2 = 2

        End If

    End Sub

    Public Shared Function Esistono_Impianti_Su_Appezzamenti(
                                            ByVal Piva As String,
