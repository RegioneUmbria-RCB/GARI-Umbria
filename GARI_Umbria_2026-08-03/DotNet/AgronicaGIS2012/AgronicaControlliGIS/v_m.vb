    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="objBufferZone"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <returns></returns>
    Public Shared Function BufferZone_Leggi_2022(ByVal objBufferZone As BufferZone_In,
                                                 ByRef objParametri_Server As AgronicaCoreParametri) As rispostaStandard(Of LeggiBufferZone_Out)
        Dim r As New rispostaStandard(Of LeggiBufferZone_Out)


        Dim Piva As String = objBufferZone.ChiaveAlbero.Piva
        Dim Sa_Cod As String = objBufferZone.ChiaveAlbero.Sa_Cod
        Dim Appezza As String = objBufferZone.ChiaveAlbero.Appezza
        Dim Campo_Cod As String = objBufferZone.ChiaveAlbero.Campo_Cod

        Dim lCodice As New AgronicaCoreAnagrafeDAL.Appezzamento_Read
        Dim dtCodice As DataTable = lCodice.Leggi(Piva,
                                                  Sa_Cod,
                                                  Appezza,
                                                  enumSelezioneVariabile.Selezione_JoinDescrizioni,
                                                  "",
                                                  "",
                                                  objParametri_Server)

        objBufferZone.SupBZ_Riduzione = 0
        objBufferZone.DistBZ_CorpiIdrici = 0
        objBufferZone.DistBZ_AreeResPub = 0
        objBufferZone.DistBZ_Allevamenti = 0
        objBufferZone.DistBZ_VegNatNonColt = 0

        Dim DatoLetto As Boolean = False

        If dtCodice.Rows.Count > 0 Then

            Dim dtCodice_row = dtCodice.Rows(0)

            LetturaBufferZone(dtCodice_row, "SupBZ_Riduzione", objBufferZone.SupBZ_Riduzione, DatoLetto)
            LetturaBufferZone(dtCodice_row, "DistBZ_CorpiIdrici", objBufferZone.DistBZ_CorpiIdrici, DatoLetto)
            LetturaBufferZone(dtCodice_row, "DistBZ_AreeResPub", objBufferZone.DistBZ_AreeResPub, DatoLetto)
            LetturaBufferZone(dtCodice_row, "DistBZ_Allevamenti", objBufferZone.DistBZ_Allevamenti, DatoLetto)
            LetturaBufferZone(dtCodice_row, "DistBZ_VegNatNonColt", objBufferZone.DistBZ_VegNatNonColt, DatoLetto)

        End If

        Dim SupBZ_Riduzione_Ricalcolata As Decimal = 0
        Dim xBufArea As New AgronicaCoreGisDAL.GIS_Entita_R
        SupBZ_Riduzione_Ricalcolata = xBufArea.BufferZone_CalcolaArea_Da_Entita_Cod(objBufferZone.Entita_Cod,
                                                                                    "",
                                                                                    objParametri_Server)

        If SupBZ_Riduzione_Ricalcolata > 0 Then
            SupBZ_Riduzione_Ricalcolata = Math.Round(SupBZ_Riduzione_Ricalcolata / 10000, 4)
        End If

        r.RispostaOK = True
        r.RispostaStringa = New LeggiBufferZone_Out With {
            .DatoLetto = DatoLetto.ToString.ToLower,
            .SupBZ_Riduzione = objBufferZone.SupBZ_Riduzione,
            .DistBZ_CorpiIdrici = objBufferZone.DistBZ_CorpiIdrici,
            .DistBZ_AreeResPub = objBufferZone.DistBZ_AreeResPub,
            .DistBZ_Allevamenti = objBufferZone.DistBZ_Allevamenti,
            .DistBZ_VegNatNonColt = objBufferZone.DistBZ_VegNatNonColt,
            .SupBZ_Riduzione_Ricalcolata = SupBZ_Riduzione_Ricalcolata
        }

        Return r

    End Function

