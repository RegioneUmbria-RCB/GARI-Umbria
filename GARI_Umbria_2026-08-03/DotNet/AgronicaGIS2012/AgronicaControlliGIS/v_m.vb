    Private Shared Sub AggiornaCoordinateCentroAziendale(ByVal piva As String, ByVal sa_cod As String, ByVal objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri, ByVal gmlCoord As String)
        Dim lXYZ As New List(Of xyz)
        Dim conv As New AgronicaConversioneCartografiaGias.FormatsConverter.GML
        lXYZ = conv.EstraiCoordinateDaPoligono("<r>" & gmlCoord & "</r>", False)

        Dim fXYZ As xyz = lXYZ.First
        Dim X As Integer
        Dim Y As Integer
        CalcolaXYdaLatLong(fXYZ.X, fXYZ.Y, X, Y, objParametri_Server)
        AggiornaCoordinateCentroAziendale(piva, sa_cod, fXYZ.X, fXYZ.Y, X, Y, objParametri_Server)
    End Sub

    Private Shared Sub AggiornaCoordinateCentroAziendale(ByVal piva As String, ByVal sa_cod As String, ByVal latitudine As Double, ByVal longitudine As Double, ByVal X As Double, ByVal Y As Double, ByVal objParametri_server As AgronicaCoreParametri)

        Dim aSa As New AgronicaCoreGisDAL.ElementiGias_NonGis2012_W
        aSa.ScriviCoordinateCentroAziendale(
            piva,
            sa_cod,
            latitudine,
            longitudine,
            0,
            X,
            Y,
            objParametri_server
        )


    End Sub

    Private Shared Sub CalcolaXYdaLatLong(ByVal Latitudine As Double, ByVal Longitudine As Double, ByRef X As Double, ByRef Y As Double, ByVal ObjParametri_Server As AgronicaCoreParametri)


        Dim CoordWktSudEst As String = "POINT (" & Longitudine.ToString.Replace(",", ".") & " " & Latitudine.ToString.Replace(",", ".") & ")"
        Const LatLongToXY As Integer = 4
        ' Const XYtoLatLong As Integer = 1

        Dim leggiTrasformazione As New AgronicaCoreGisDAL.GIS_SistemiRiferimentoCartografia_R
        Dim dtLeggiTrasformazione As DataTable = leggiTrasformazione.Leggi(LatLongToXY, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", ObjParametri_Server)

        Dim cconverter As New CoordinateConverter
        Dim ParametriCartograficiWGS84ED50 As New ParametriCoordinateConverter With {
            .CSFromText = dtLeggiTrasformazione(0)("CSFrom"),
            .CStoText = dtLeggiTrasformazione(0)("CSTo"),
            .CStoGeoText = dtLeggiTrasformazione(0)("CStoGeo"),
            .AgronicaLatOffset = dtLeggiTrasformazione(0)("AgronicaLatOffset"),
            .AgronicaLonOffset = dtLeggiTrasformazione(0)("AgronicaLonOffset"),
            .LibreriaDaUsare = dtLeggiTrasformazione(0)("LibreriaDaUsare")
        }

        Dim risultato As String = cconverter.WKTPolygonWGS84_from_WKTPolygonED50(CoordWktSudEst, True, ParametriCartograficiWGS84ED50)
        'risultato = risultato.Replace("(", "").Replace(")", "")
        'X = CInt(risultato.Split(",")(0))
        'Y = CInt(risultato.Split(",")(1))
        X = CDbl(risultato.Split(" ")(1).Replace("(", "").Replace(")", "").Replace(".", ","))
        Y = CDbl(risultato.Split(" ")(2).Replace("(", "").Replace(")", "").Replace(".", ","))


    End Sub


    Public Shared Function SalvaNuovoAB(ByVal chiaveAlbero As String, ByVal hiddenPunti_A As String, ByVal hiddenPunti_B As String, ByVal hiddenPunti_AB As String) As String
        Dim risp As Boolean

        Dim objParametri_Server As New AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")

        Dim objParametri_Utenti As New AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Utenti = HttpContext.Current.Session("ASG_objParametri_Utenti")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            risp = False
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()


        'Valorizzo il Codice_Fiscale_Tecnico prendendolo dalla tabella Gruppi_Utente
        Dim Codice_Fiscale_Tecnico As String = ""
        Dim xUtenteCorrente As String = CType(objParametri_Server, AgronicaCoreDataProvider.AgronicaCoreParametri).UtenteUsername
        Dim objUtentiDAL As New AgronicaCoreUtentiDAL.Utenti_xGruppi_Utente_R
        Codice_Fiscale_Tecnico = objUtentiDAL.Leggi_IdentificativoGruppoUtenti_Singolo(xUtenteCorrente, objParametri_Utenti)




        Dim ent_start As Integer = 0
        Dim sCurImp As String() = chiaveAlbero.Split(SeparatoreAlberoJson)

        Dim objImpianto = New AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo With {
                .Piva = sCurImp(1),
                .Sa_Cod = sCurImp(2),
                .Appezza = sCurImp(4),
                .Id_reg = sCurImp(5)
            }

        Dim Programmazione_Cod As Integer = 0
        Dim Programmazione_Entita_Cod As Integer = 0

        Dim tipoNodo As enum_TipoNodo
        Albero.ChiaveAlbero_Decodifica_TipoNodo_x_json(chiaveAlbero, tipoNodo)
        If tipoNodo = enum_TipoNodo.PlanningEntita Then
            Albero.ChiaveAlbero_Decodifica_PlanningTestata_x_json(chiaveAlbero, "", "", 0, Programmazione_Cod)
            Albero.ChiaveAlbero_Decodifica_PlanningEntita_x_json(chiaveAlbero, "", "", 0, Programmazione_Entita_Cod)
        End If


        If hiddenPunti_AB <> "" Then
            Dim app As String() = hiddenPunti_AB.Split("*")
            ent_start = app(0).Split("|")(1)
            Dim idleLayerElementiGrafici_Cod As Integer
            GetEntitaGiasFromEntitaGrafica(ent_start, objImpianto.Piva, objImpianto.Sa_Cod, objImpianto.Appezza, objImpianto.Id_reg, Nothing, Nothing, objParametri_Server, objParametri_Utenti, 1, 2, 0, 0, 0, Nothing, idleLayerElementiGrafici_Cod, Codice_Fiscale_Tecnico)

        End If



        'Date§ 20/03/2012|Time§ 01:41:54pm|Version§ 5.10.038|Id§ 0|Name§ AB Line 1|Length§ 872,938|Dist1§ 0,000§ Dist2§ 4,661

        Dim streerore As String
        If hiddenPunti_AB <> "" Then

            Dim ent_A, ent_B, Ent_C As Integer

            Dim leggiAltreEntita As New AgronicaCoreGisDAL.PrecisionFarming
            Dim dtAltreEntita As DataTable = leggiAltreEntita.LeggiDatiAB_DaEntitaCod(ent_start, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)

            For Each riga In dtAltreEntita.Rows
                Select Case riga("ElementoGrafico_des")
                    Case "A"
                        ent_A = riga("entita_Cod")
                    Case "B"
                        ent_B = riga("entita_Cod")
                    Case Else
                        Ent_C = riga("entita_Cod")
                End Select

            Next

            streerore = SalvaGrafica(New InSalvaGraficaModel(objImpianto.Piva, objImpianto.Sa_Cod, ent_A, hiddenPunti_A, Programmazione_Cod, Programmazione_Entita_Cod, 55, objImpianto, "A", 55, 0, 0, 0), risp, objParametri_Server, TipiEnumerativi.enum_TipoOperazioneDB.Modifica)
            streerore &= SalvaGrafica(New InSalvaGraficaModel(objImpianto.Piva, objImpianto.Sa_Cod, ent_B, hiddenPunti_B, Programmazione_Cod, Programmazione_Entita_Cod, 55, objImpianto, "B", 55, 0, 0, 0), risp, objParametri_Server, TipiEnumerativi.enum_TipoOperazioneDB.Modifica)
            streerore &= SalvaGrafica(New InSalvaGraficaModel(objImpianto.Piva, objImpianto.Sa_Cod, Ent_C, hiddenPunti_A & ", " & hiddenPunti_B, Programmazione_Cod, Programmazione_Entita_Cod, 55, objImpianto, "Date§ 20/03/2012|Time§ 01:41:54pm|Version§ 5.10.038|Id§ 0|Name§ AB Line 1|Length§ 872,938|Dist1§ 0,000§ Dist2§ 4,661", 55, 0, 0, 0), risp, objParametri_Server, TipiEnumerativi.enum_TipoOperazioneDB.Modifica)

        Else

            streerore = SalvaGrafica(New InSalvaGraficaModel(objImpianto.Piva, objImpianto.Sa_Cod, 0, hiddenPunti_A, Programmazione_Cod, Programmazione_Entita_Cod, 55, objImpianto, "A", 55, 0, 0, 0), risp, objParametri_Server, TipiEnumerativi.enum_TipoOperazioneDB.Scrittura)
            streerore &= SalvaGrafica(New InSalvaGraficaModel(objImpianto.Piva, objImpianto.Sa_Cod, 0, hiddenPunti_B, Programmazione_Cod, Programmazione_Entita_Cod, 55, objImpianto, "B", 55, 0, 0, 0), risp, objParametri_Server, TipiEnumerativi.enum_TipoOperazioneDB.Scrittura)
            streerore &= SalvaGrafica(New InSalvaGraficaModel(objImpianto.Piva, objImpianto.Sa_Cod, 0, hiddenPunti_A & ", " & hiddenPunti_B, Programmazione_Cod, Programmazione_Entita_Cod, 55, objImpianto, "Date§ 20/03/2012|Time§ 01:41:54pm|Version§ 5.10.038|Id§ 0|Name§ AB Line 1|Length§ 872,938|Dist1§ 0,000§ Dist2§ 4,661", 55, 0, 0, 0), risp, objParametri_Server, TipiEnumerativi.enum_TipoOperazioneDB.Scrittura)
        End If

        'If streerore.StartsWith("Ok") Then
        streerore = "Ok"
        'End If

        Return streerore

    End Function




    Public Shared Function VerifichePreSalvataggio(
        ByVal chiaveAlbero As String,
        ByVal verifica_EsistonoOperazioniSuImpianti As Boolean,
        ByVal verifica_EsistonoDatiGisSuElementiAnagraficiCollegati As Boolean,
        ByVal verifica_EsisteCatastoAssociatoAdAppezzamento As Boolean,
        ByVal verifica_EsistenzaImpiantiDaEntita As Boolean,
        ByVal validita_inizio As String,
        ByVal validita_fine As String
    ) As rispostaStandard(Of v_m_verifichePreSalvataggio)

        Dim r As New rispostaStandard(Of v_m_verifichePreSalvataggio)
        r.RispostaStringa = New v_m_verifichePreSalvataggio


        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            r.Sessione = False
            Return r
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Try

            'operazioni associate ad impianti
            If verifica_EsistonoOperazioniSuImpianti Then
                r.RispostaStringa.MessaggioOperazioniSuImpianti = ControllaSeEsistonoOperazioni(chiaveAlbero)
                If r.RispostaStringa.MessaggioOperazioniSuImpianti = "true" Then
                    r.RispostaStringa.EsistonoOperazioniSuImpianti = True
                End If
            Else
                r.RispostaStringa.EsistonoOperazioniSuImpianti = True
            End If


            'Dati Gis Su Elementi Anagrafici Collegati
            If (verifica_EsistonoDatiGisSuElementiAnagraficiCollegati) Then
                Dim rval1 As v_m_DatiGisSuElementiAnagraficiCollegati = ControllaEsistonoDatiGisSuElementiAnagraficiCollegati(chiaveAlbero, objParametri_Server)
                r.RispostaStringa.MessaggioDatiGisSuElementiAnagraficiCollegati = rval1.MessaggioDatiGisSuElementiAnagraficiCollegati
                If r.RispostaStringa.MessaggioDatiGisSuElementiAnagraficiCollegati = "true" Then
                    r.RispostaStringa.EsistonoDatiGisSuElementiAnagraficiCollegati = True
                End If
            Else
                r.RispostaStringa.EsistonoDatiGisSuElementiAnagraficiCollegati = True
            End If


            'Catasto associato ad appezzamenti
            If verifica_EsisteCatastoAssociatoAdAppezzamento Then
                r.RispostaStringa.MessaggioCatastoAssociatoAdAppezzamento = ControllaSeEsisteCatasto(chiaveAlbero)
                If r.RispostaStringa.MessaggioCatastoAssociatoAdAppezzamento <> "true" Then
                    r.RispostaStringa.EsisteCatastoAssociatoAdAppezzamento = True
                End If
            Else
                r.RispostaStringa.EsisteCatastoAssociatoAdAppezzamento = True
            End If

            'ci sono impianti sull'appezzamento che intersecano la validità richiesta.
            If verifica_EsistenzaImpiantiDaEntita Then

                If validita_fine = "" Then
                    validita_fine = AGRODATAFINE.ToShortDateString
                End If


                r.RispostaStringa.MessaggioEsistonoImpiantiDaEntita = VerificaEsistenzaImpiantiDaEntita(chiaveAlbero, validita_inizio, validita_fine).RispostaStringa
                If r.RispostaStringa.MessaggioEsistonoImpiantiDaEntita = "0" Then
                    r.RispostaStringa.EsistonoImpiantiDaEntita = True

                    r.RispostaStringa.MessaggioEsistonoImpiantiDaEntita =
                        My.Resources.AgronicaControlliGIS.V_M_VerifichePreSalvataggio_Nessun_impianto_validito_fra_il_ &
                        validita_inizio & My.Resources.AgronicaControlliGIS.V_M__Ed_il_ & validita_fine
                Else
                    r.RispostaStringa.MessaggioEsistonoImpiantiDaEntita = My.Resources.AgronicaControlliGIS.V_M_Esistono_già_ & r.RispostaStringa.MessaggioEsistonoImpiantiDaEntita &
                    My.Resources.AgronicaControlliGIS.V_M_VerifichePreSalvataggio__Impianti_validiti_fra_il_ & validita_inizio & My.Resources.AgronicaControlliGIS.V_M__Ed_il_ & validita_fine
                End If

            Else
                r.RispostaStringa.EsistonoImpiantiDaEntita = True
            End If

            r.RispostaOK = True


        Catch ex As Exception

            r.RispostaOK = False

            'uso questa funzione per ottenere il Messaggio..:
            r.Errore = "Errore durante l'operazione: " & vbCrLf &
                AgronicaCoreDataProvider.Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True, source:=True)


        End Try

        Return r
    End Function

    Public Shared Function ControllaEsistonoDatiGisSuElementiAnagraficiCollegati(ByVal ChiaveAlbero As String, ByVal objParametri_server As AgronicaCoreParametri) As v_m_DatiGisSuElementiAnagraficiCollegati

        Dim rval As New v_m_DatiGisSuElementiAnagraficiCollegati

        Dim Piva As String
        Dim Sa_Cod As Integer = 0
        Dim Campo_Cod As Integer = 0
        Dim Appezza As Integer = 0
        Dim Id_Imp As Integer = 0
        Dim p_Part_Cod As Integer
        Dim p_Provincia_Cod As String
        Dim p_Comune_Cod As String
        Dim p_Sezione As String
        Dim p_Foglio As Integer
        Dim p_Numero As Integer
        Dim p_Subalterno As String
        Dim Cod_Fiscale As String
        Dim Fabbricato_Cod As Integer
        Dim Prodotto_Cod As Integer
        Dim Data_Lavorazione As String
        Dim Analisi_Certificato_Cod As Integer
        Dim Analisi_Testata_Cod As Integer
        Dim Analisi_Dettaglio_Cod As Integer
        Dim Analisi_Campione_Cod As Integer
        Dim Piano_Cod As Integer
        Dim Vas_Cod As Integer
        Dim id_agenda As Integer
        Dim Programmazione_Cod As Integer = 0
        Dim Programmazione_Entita_Cod As Integer = 0
        Dim xFiltroAggiuntivo As String = ""

        Dim tipoNodoAlbero As enum_TipoNodo
        AgronicaCoreDataProvider.Albero.ChiaveAlbero_Decodifica_TipoNodo_x_json(ChiaveAlbero, tipoNodoAlbero)

        If (tipoNodoAlbero = enum_TipoNodo.ImpiantoArborea Or
                tipoNodoAlbero = enum_TipoNodo.ImpiantoErbacea Or
                tipoNodoAlbero = enum_TipoNodo.ImpiantoNudo Or
                tipoNodoAlbero = enum_TipoNodo.ImpiantoOrticola Or
                tipoNodoAlbero = enum_TipoNodo.Impianto_Generico Or
                tipoNodoAlbero = enum_TipoNodo.Appezzamento) Then


            AgronicaCoreDataProvider.Albero.ChiaveAlbero_Decodifica_x_json(
                ChiaveAlbero,
                Piva,
                Sa_Cod,
                Campo_Cod,
                Appezza,
                Id_Imp,
                p_Part_Cod,
                p_Provincia_Cod,
                p_Comune_Cod,
                p_Sezione,
                p_Foglio,
                p_Numero,
                p_Subalterno,
                Cod_Fiscale,
                Fabbricato_Cod,
                Prodotto_Cod,
                Data_Lavorazione,
                Analisi_Certificato_Cod,
                Analisi_Testata_Cod,
                Analisi_Dettaglio_Cod,
                Analisi_Campione_Cod,
                Piano_Cod,
                Vas_Cod,
                id_agenda
            )
        Else

            'verifica non necessaria
            rval.MessaggioDatiGisSuElementiAnagraficiCollegati = "true"
            rval.DatiGisSuElementiAnagraficiCollegati_Lista_Entita_Cod = New List(Of v_m_ObjImpiantoPiccolo)

            Return rval

        End If

        'cerco un qualsiasi elemento fra impianti ed appezzamenti...
        Dim MessaggioFinaleAppezza As String = "Impianto"

        If tipoNodoAlbero <> enum_TipoNodo.Appezzamento Then

            'sto chiedendo un'impianto, allora cerco gli appezzamenti..
            xFiltroAggiuntivo = " and tipoEntita_Cod = " & enum_GIS2012_TipoEntita.APPEZZAMENTI

            Id_Imp = 0
            MessaggioFinaleAppezza = "Appezzamento"

        Else

            'sto cercando degli impianti...
            xFiltroAggiuntivo = " and tipoEntita_Cod in (" & enum_GIS2012_TipoEntita.IMPIANTO_ARBOREA &
                ", " & enum_GIS2012_TipoEntita.IMPIANTI_ERBACEA & vbCrLf &
                ", " & enum_GIS2012_TipoEntita.IMPIANTO_NUDO & vbCrLf &
                ", " & enum_GIS2012_TipoEntita.IMPIANTI_ORTICOLA & vbCrLf &
                ", " & enum_GIS2012_TipoEntita.IMPIANTO_GENERICO & vbCrLf &
            " ) "

        End If


        Dim objEntita As New AgronicaCoreGisDAL.GIS_Entita_R

        'il campo_Cod non è indispensabile perchè non si sta memorizzando un campo, ma un appezzamento.
        Dim dt As DataTable =
            objEntita.LeggiDB(objParametri_server.PivaSuperUser, 0, 0, Piva, Sa_Cod, Appezza, 0, Id_Imp, "", "", "", 0, 0, "", 0, 0, 0, 0, "", enumSelezioneVariabile.Selezione_TabellaCompleta, xFiltroAggiuntivo, "", objParametri_server)



        If dt.Rows.Count = 0 Then
            rval.MessaggioDatiGisSuElementiAnagraficiCollegati = "true"
            rval.DatiGisSuElementiAnagraficiCollegati_Lista_Entita_Cod = New List(Of v_m_ObjImpiantoPiccolo)
        Else
            'i18n__ + verifica escape
            'rval.MessaggioDatiGisSuElementiAnagraficiCollegati = "<b>Attenzione</b> esiste un elemento GIS di tipo " & MessaggioFinaleAppezza & ", se si procede allora questo elemento sarà sostituito."
            rval.MessaggioDatiGisSuElementiAnagraficiCollegati = String.Format(
                My.Resources.AgronicaControlliGIS.V_M_ControllaEsistonoDatiGisSuElementiAnagraficiCollegati_Avviso_Sostituzione,
                MessaggioFinaleAppezza
            )
            rval.DatiGisSuElementiAnagraficiCollegati_Lista_Entita_Cod = (
                From tt In dt.AsEnumerable
                Select New v_m_ObjImpiantoPiccolo With {
                    .Entita_Cod = CInt(tt("Entita_cod")),
                    .Piva = tt("piva"),
                    .Sa_Cod = tt("sa_Cod"),
                    .Appezza = tt("appezza"),
                    .Id_reg = tt("id_imp")
                    }
            ).ToList

        End If

        Return rval

    End Function

    Public Shared Function ControllaSeEsistonoOperazioni(ByVal ChiaveAlbero As String) As String
        Dim objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim Piva As String
        Dim Sa_Cod As Integer = 0
        Dim Campo_Cod As Integer = 0
        Dim Appezza As Integer = 0
        Dim Id_Imp As Integer = 0
        Dim p_Part_Cod As Integer
        Dim p_Provincia_Cod As String
        Dim p_Comune_Cod As String
        Dim p_Sezione As String
        Dim p_Foglio As Integer
        Dim p_Numero As Integer
        Dim p_Subalterno As String
        Dim Cod_Fiscale As String
        Dim Fabbricato_Cod As Integer
        Dim Prodotto_Cod As Integer
        Dim Data_Lavorazione As String
        Dim Analisi_Certificato_Cod As Integer
        Dim Analisi_Testata_Cod As Integer
        Dim Analisi_Dettaglio_Cod As Integer
        Dim Analisi_Campione_Cod As Integer
        Dim Piano_Cod As Integer
        Dim Vas_Cod As Integer
        Dim id_agenda As Integer
        Dim Programmazione_Cod As Integer = 0
        Dim Programmazione_Entita_Cod As Integer = 0
        Dim xFiltroAggiuntivo As String = ""

        Dim tipoNodoAlbero As enum_TipoNodo
        AgronicaCoreDataProvider.Albero.ChiaveAlbero_Decodifica_TipoNodo_x_json(ChiaveAlbero, tipoNodoAlbero)

        If Not (tipoNodoAlbero = enum_TipoNodo.ImpiantoArborea Or
                tipoNodoAlbero = enum_TipoNodo.ImpiantoErbacea Or
                tipoNodoAlbero = enum_TipoNodo.ImpiantoNudo Or
                tipoNodoAlbero = enum_TipoNodo.ImpiantoOrticola Or
                tipoNodoAlbero = enum_TipoNodo.Impianto_Generico) Then

            Return "true"
        Else

            AgronicaCoreDataProvider.Albero.ChiaveAlbero_Decodifica_x_json(
                ChiaveAlbero,
                Piva,
                Sa_Cod,
                Campo_Cod,
                Appezza,
                Id_Imp,
                p_Part_Cod,
                p_Provincia_Cod,
                p_Comune_Cod,
                p_Sezione,
                p_Foglio,
                p_Numero,
                p_Subalterno,
                Cod_Fiscale,
                Fabbricato_Cod,
                Prodotto_Cod,
                Data_Lavorazione,
                Analisi_Certificato_Cod,
                Analisi_Testata_Cod,
                Analisi_Dettaglio_Cod,
                Analisi_Campione_Cod,
                Piano_Cod,
                Vas_Cod,
                id_agenda
            )

        End If

        'controllo se esistono le operazioni
        Dim objAgenda As New AgronicaCoreContabDAL.Mov_Destinazioni_R
        Dim dt As DataTable
        dt = objAgenda.Leggi(Piva, Sa_Cod, 0, 0, 0, Appezza, Id_Imp, 0, enumSelezioneVariabile.Selezione_TabellaCompleta, xFiltroAggiuntivo, "", objParametri_Server)

        If dt.Rows.Count = 0 Then
            Return "true"
        Else
            'Return "<b>Attenzione</b> esistono " & dt.Rows.Count & " operazioni su questo impianto, se si modifica la superficie dell'impianto è necessario rientrare in modifica di tali operazione per la riattualizzazione dei valori"
            Dim strToReturn As String = My.Resources.AgronicaControlliGIS.V_M_ControllaSeEsistonoOperazioni_Avviso_modifica_superficie_impianto
            Return String.Format(strToReturn, dt.Rows.Count)
        End If
    End Function


