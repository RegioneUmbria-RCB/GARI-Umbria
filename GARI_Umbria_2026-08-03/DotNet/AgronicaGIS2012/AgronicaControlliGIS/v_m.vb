    Private Shared Function GetGeoJsonResult(InData As AgronicaCoreModello.GisDataReadParam,
                                             cfgAlbero As ConfigurazioneAlbero,
                                             ns As XNamespace,
                                             LayerList As List(Of Integer),
                                             Codice_Fiscale_Tecnico As String,
                                             codice_specie As Integer,
                                             codice_destinazione_uso As Integer,
                                             lAggiungiLayer_Imprese As Boolean,
                                             SementiSportelloCod As Integer,
                                             xFiltroAggiuntivo As String,
                                             filtroTemporaleAvanzato As FiltroTemporaleAvanzato,
                                             LayersVisibili As LayerVisibiliUtenteTipologia,
                                             objParametri_Super_Server As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                             objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                             objParametri_Utenti As AgronicaCoreDataProvider.AgronicaCoreParametri
                                             ) As GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)

        Dim objEntitaBiz As New AgronicaCoreGisBIZ.DatiEntita_R

        Dim dt = objEntitaBiz.LeggiPerGerarchiaImprese(
                    objParametri_Server.PivaSuperUser,
                    Codice_Fiscale_Tecnico,
                    0,
                    0,
                    InData.piva,
                    InData.sa_cod,
                    InData.appezza,
                    InData.campo_cod,
                    codice_specie,
                    codice_destinazione_uso,
                    InData.id_imp,
                    "",
                    "",
                    "-1",
                    -1,
                    -1,
                    "-1",
                    0,
                    0,
                    0,
                    0,
                    lAggiungiLayer_Imprese,
                    True,
                    False,
                    True,
                    SementiSportelloCod,
                    Codice_Fiscale_Tecnico,
                    InData.wktBoundaySTIntersects,
                    cfgAlbero,
                    xFiltroAggiuntivo,
                    objParametri_Server,
                    objParametri_Utenti,
                    filtroTemporaleAvanzato:=filtroTemporaleAvanzato,
                    InData.layerElementiGrafici_cod,
                    LayersVisibili:=LayersVisibili)

        Return GetPlaceGeoJSONFromDataTable(objParametri_Server.PivaSuperUser, dt, ns, InData.TipologiaLayerSelezionata, If(LayerList Is Nothing, InData.layerElementiGrafici_cod, LayerList), cfgAlbero, InData.piva, SementiSportelloCod, Codice_Fiscale_Tecnico, objParametri_Super_Server, objParametri_Server, objParametri_Utenti)
    End Function



    Public Shared Function GetDataElaborazione(
            objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri,
            objParametri_Utenti As AgronicaCoreDataProvider.AgronicaCoreParametri,
            InData As LeggiDateImpiantiPerFiltroTemporale_In
        ) As String

        Try

            Dim objGISEntita As New AgronicaCoreGisDAL.GIS_Entita_R
            Dim dataElaborazione As String = InData.date
            'Impostazione finestra temporale
            If IsNothing(dataElaborazione) Then
                dataElaborazione = Date.Now
            End If

            objParametri_Server.FinestraTemporaleInizio = dataElaborazione
            objParametri_Server.FinestraTemporaleFine = dataElaborazione

            '1.
            Dim dt = objGISEntita.LeggiEntitaImpianti_FiltroTemporale(InData.piva,
                                                                      InData.sa_cod,
                                                                      dataElaborazione,
                                                                      GIS_Utility.GetLimiteByTipoOperatoreData("<=", enum_OperatoreFiltroTemporale.PrecedenteUguale),
                                                                      GIS_Utility.GetLimiteByTipoOperatoreData(">=", enum_OperatoreFiltroTemporale.SuccessivoUguale),
                                                                      objParametri_Server)
            ' Seleziono la data di fine maggiore
            If dt IsNot Nothing AndAlso dt.Rows.Count > 0 Then Return dataElaborazione

            '2.
            dt = objGISEntita.LeggiEntitaImpianti_FiltroTemporale(InData.piva,
                                                                      InData.sa_cod,
                                                                      dataElaborazione,
                                                                      GIS_Utility.GetLimiteByTipoOperatoreData("<=", enum_OperatoreFiltroTemporale.PrecedenteUguale),
                                                                      GIS_Utility.GetLimiteByTipoOperatoreData("<=", enum_OperatoreFiltroTemporale.PrecedenteUguale),
                                                                      objParametri_Server)
            ' Seleziono la data di fine maggiore
            If dt IsNot Nothing AndAlso dt.Rows.Count > 0 Then Return dt.AsEnumerable().Max(Function(row) row.Field(Of Date)("validita_fine"))

            '3.
            dt = objGISEntita.LeggiEntitaImpianti_FiltroTemporale(InData.piva,
                                                                      InData.sa_cod,
                                                                      dataElaborazione,
                                                                      GIS_Utility.GetLimiteByTipoOperatoreData(">=", enum_OperatoreFiltroTemporale.SuccessivoUguale),
                                                                      GIS_Utility.GetLimiteByTipoOperatoreData(">=", enum_OperatoreFiltroTemporale.SuccessivoUguale),
                                                                      objParametri_Server)
            ' Seleziono la data di inizio minore
            If dt IsNot Nothing AndAlso dt.Rows.Count > 0 Then
                Return dt.AsEnumerable().Min(Function(row) row.Field(Of Date)("Validita_inizio"))
            Else
                Return ""
            End If

        Catch ex As Exception
            Throw New Exception(ex.Message, ex)
        End Try
    End Function

    Public Shared Function GetPlaceGeoJSONFromDataTable(ByVal PivasuperUSer As String,
                                                        ByVal data As DataTable,
                                                        ByVal ns As XNamespace,
                                                        ByVal Tipologia_Layer_Richiesta As Integer,
                                                        ByVal LayerList As List(Of Integer),
                                                        ByVal cfgAlbero As ConfigurazioneAlbero,
                                                        ByVal Piva As String,
                                                        ByVal SementiSportelloCod As Integer,
                                                        ByVal codiceFiscaleTecnico As String,
                                                        ByVal ObjParametri_Super_Server As AgronicaCoreParametri,
                                                        ByVal ObjParametri_Server As AgronicaCoreParametri,
                                                        ByVal ObjParametri_Utenti As AgronicaCoreParametri) As GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
        Try
            Dim finalObj As New GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
            finalObj.geoJsonCaricato = New AgronicaCoreModelsSTD.Gis.GeoJson_Shape_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
            finalObj.geoJsonCaricato.type = "FeatureCollection"
            finalObj.geoJsonCaricato.features = New List(Of AgronicaCoreModelsSTD.Gis.GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))

            If data.Rows.Count <= 0 Then
                Return finalObj
            End If

            Dim objLayer As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_R
            Dim objLayerStruct As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_Anagrafica_DataStruct_R
            Dim objUtentiPerm As New AgronicaCoreUtentiBIZ.Utenti_Permessi_R

            Dim utente_permessi_gis As AgronicaCoreDTOStd.InData.Gis.PermessiUtenteEntitaGIS = Nothing

            If SementiSportelloCod <= 0 Then
                utente_permessi_gis = objUtentiPerm.LeggiPemerssiUtenteEntitaGis(ObjParametri_Utenti.UtenteUsername, ObjParametri_Utenti)
            End If

            Dim featureList As New ConcurrentBag(Of GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))()

            'lavez - 22/07/2024 - aggiunti due parametri tipologia_layer e layerList in caso si provenga al di fuori del GIS
            Dim dtLayers = Map2Object.DataTableToObjectList(Of AgronicaCoreDTOStd.InData.Gis.DatiGeneraliLayer)(objLayer.LeggiElencoDettagliLayers(data.Rows(0)("PivaSuperUser"), "", Tipologia_Layer_Richiesta, 0, True, True, "", ObjParametri_Server, LayerList))

            'Dim dtText = objLayerStruct.Leggi(PivasuperUSer, 0, Tipologia_Layer_Richiesta, 0, "", enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", ObjParametri_Server)
            Dim dtTextWithSep = objLayerStruct.Leggi(PivasuperUSer, 0, Tipologia_Layer_Richiesta, 0, "", enumSelezioneVariabile.Selezione_JoinCompleta, "", "", ObjParametri_Server, ObjParametri_Utenti)

            Dim isSementieri = GetIsSementieri(ObjParametri_Server)
            Parallel.ForEach(data.AsEnumerable.Where(Function(row) row("geodata") IsNot DBNull.Value),
                Sub(row)
                    If CheckLayer(IIf(row("layer_" + Tipologia_Layer_Richiesta.ToString()) Is DBNull.Value, 0, row("layer_" + Tipologia_Layer_Richiesta.ToString())), LayerList) = True Then
                        Dim rowLayer = dtLayers.FirstOrDefault(Function(x) x.LayerElementiGrafici_Cod = row("StandardEntita_layerDiAppartenenza"))
                        Dim coordinates = getStringGeometryGeoJson(row("geodata"))
                        Dim prop = New AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp()
                        prop.layer = IIf(row("layer_" + Tipologia_Layer_Richiesta.ToString()) Is DBNull.Value, "", row("layer_" + Tipologia_Layer_Richiesta.ToString()))
                        prop.StandardEntita_layerDiAppartenenza = IIf(row("StandardEntita_layerDiAppartenenza") Is DBNull.Value, 0, row("StandardEntita_layerDiAppartenenza"))
                        prop.StandardEntita_layerDiAppartenenza_Des = IIf(rowLayer Is Nothing, "", rowLayer.LayerElementiGrafici_Des)
                        prop.StandardEntita_layerDiAppartenenza_Icona32 = IIf(rowLayer Is Nothing, "", rowLayer.Icona32)
                        prop.id = row("PivaSuperUser") & "|" & row("Entita_Cod") & "|" & Tipologia_Layer_Richiesta.ToString() & "|" & row("layer_" + Tipologia_Layer_Richiesta.ToString())
                        prop.tipoicona = row("@TipoIcona").ToString.Replace("""", " ")
                        prop.zindex = IIf(rowLayer Is Nothing, 0, rowLayer.ZIndex)
                        prop.Entita_Cod = row("Entita_Cod")
                        prop.Entita_GUID = row("Entita_GUID").ToString
                        prop.Area_Cod = IIf(row("Area_Cod") Is DBNull.Value, 0, CInt(row("Area_Cod")))
                        prop.ParametriVisualizzazioneLayer = System.Text.RegularExpressions.Regex.Unescape(row("ParametriVisualizzazioneLayer").ToString)
                        prop.veg_cod = IIf(row("veg_cod_impianto") = 0,
                                           IIf(row("veg_cod_programmazione_entita") Is DBNull.Value Or row("veg_cod_programmazione_entita") = 0, -1, row("veg_cod_programmazione_entita")),
                                           row("veg_cod_impianto"))
                        'lavez - 15/01/2024 - legati ai permessi anagrafica
                        'prop.inserimento = row("inserimento")
                        'prop.modifica = row("modifica")
                        'prop.cancellazione = row("cancellazione")
                        prop.informazioni = row("informazioni")
                        prop.flag_gps = row("flag_gps")
                        prop.etichetta = AgronicaCoreUtility.jSon.Escape(IIf(row("ETICHETTA") Is DBNull.Value, "", row("ETICHETTA")))
                        ' Chiave albero
                        Dim tipoNodoAlberoAnagrafe = 0
                        If row("TipoNodoAlberoAnagrafe") IsNot DBNull.Value Then
                            tipoNodoAlberoAnagrafe = CInt(row("TipoNodoAlberoAnagrafe"))
                        End If
                        If (tipoNodoAlberoAnagrafe = enum_TipoNodo.Particella) Then
                            prop.chiavealbero = Albero.ChiaveAlbero_Codifica_x_json_solo_valorizzati("",
                            TipoNodo:=tipoNodoAlberoAnagrafe,
                            Piva:=row("Piva"),
                            Sa_Cod:=row("Sa_cod"),
                            Campo_Cod:=row("Campo_Cod"),
                            Appezza:=row("Appezza"),
                            Id_Imp:=row("Id_Imp"),
                            p_Part_Cod:=row("part_cod"),
                            p_Provincia_Cod:=row("PROV"),
                            p_Comune_Cod:=row("COM"),
                            p_Sezione:=row("SEZIONE"),
                            p_Foglio:=row("FOGLIO"),
                            p_Numero:=row("NUMERO"),
                            p_Subalterno:=row("SUBALTERNO")
                            ).ToString
                        Else
                            prop.chiavealbero = Albero.ChiaveAlbero_Codifica_x_json_solo_valorizzati("",
                            TipoNodo:=tipoNodoAlberoAnagrafe,
                            Piva:=row("Piva"),
                            Sa_Cod:=row("Sa_cod"),
                            Campo_Cod:=row("Campo_Cod"),
                            Appezza:=row("Appezza"),
                            Id_Imp:=row("Id_Imp"),
                            Programmazione_Cod:=row("Programmazione_Cod"),
                            Programmazione_Entita_Cod:=row("Programmazione_Entita_Cod"),
                            Analisi_Testata_Cod:=row("analisi_testata_cod"),
                            Analisi_Campione_Cod:=row("analisi_campione_cod"),
                            Ricetta_Cod:=IIf(row("Ricetta_Cod") Is DBNull.Value, 0, row("Ricetta_Cod")),
                            ricetta_Operazione_cod:=row("Ricetta_Operazione_Cod"),
                            id_agenda:=row("ID_Agenda"),
                            Fabbricato_Cod:=row("Fabbricato_Cod")
                            ).ToString
                        End If

                        'lavez - 15/01/2024 - i permessi di scrittura/lettura vengono legati ai permessi anagrafici

                        If Not isSementieri Then
                            'mengarda - logica applicata per tutti i server NON sementieri
                            Select Case prop.StandardEntita_layerDiAppartenenza
                                Case enum_Gis_LayerElementiGrafici_std.Centri_Aziendali
                                    prop.inserimento = utente_permessi_gis.centriAziendali.Scrittura.ToString()
                                    prop.modifica = utente_permessi_gis.centriAziendali.Scrittura.ToString()
                                    prop.cancellazione = utente_permessi_gis.centriAziendali.Scrittura.ToString()

                                Case enum_Gis_LayerElementiGrafici_std.Fabbricati
                                    prop.inserimento = utente_permessi_gis.fabbricati.Scrittura.ToString()
                                    prop.modifica = utente_permessi_gis.fabbricati.Scrittura.ToString()
                                    prop.cancellazione = utente_permessi_gis.fabbricati.Scrittura.ToString()

                                Case enum_Gis_LayerElementiGrafici_std.CAMPI
                                    prop.inserimento = utente_permessi_gis.campi.Scrittura.ToString()
                                    prop.modifica = utente_permessi_gis.campi.Scrittura.ToString()
                                    prop.cancellazione = utente_permessi_gis.campi.Scrittura.ToString()

                                Case enum_Gis_LayerElementiGrafici_std.APPEZZAMENTI
                                    prop.inserimento = utente_permessi_gis.appezzamenti.Scrittura.ToString()
                                    prop.modifica = utente_permessi_gis.appezzamenti.Scrittura.ToString()
                                    prop.cancellazione = utente_permessi_gis.appezzamenti.Scrittura.ToString()

                                Case enum_Gis_LayerElementiGrafici_std.IMPIANTI
                                    prop.inserimento = utente_permessi_gis.impianti.Scrittura.ToString()
                                    prop.modifica = utente_permessi_gis.impianti.Scrittura.ToString()
                                    prop.cancellazione = utente_permessi_gis.impianti.Scrittura.ToString()

                                Case Else
                                    prop.inserimento = row("inserimento")
                                    prop.modifica = row("modifica")
                                    prop.cancellazione = row("cancellazione")
                            End Select
                        Else
                            If (Tipologia_Layer_Richiesta = enum_TipologiaLayer.Organizzazione) Then
                                Dim isMine = row("codice_fiscale_tecnico") = codiceFiscaleTecnico
                                prop.inserimento = isMine
                                prop.modifica = isMine
                                prop.cancellazione = isMine
                            Else
                                prop.inserimento = row("inserimento")
                                prop.modifica = row("modifica")
                                prop.cancellazione = row("cancellazione")
                            End If
                        End If

                        '---
                        prop.Testo = AgronicaCoreUtility.jSon.Escape(row("@text").Replace("""", " "))

                        'prop.AppIdRate = PrepareText(dtText, prop.StandardEntita_layerDiAppartenenza, AgronicaCoreUtility.jSon.Escape(row("@text").Replace("""", " ")))

                        prop.AppIdRate = IIf(row("@text").ToString.Contains("§"),
                                        AgronicaCoreUtility.jSon.Escape(row("@text").Replace("""", " ").Replace(",", ".")),
                                        IIf(row("@info_estese").Contains("§"),
                                            row("@info_estese").ToString,
                                            " ")).ToString

                        prop.TipologiaGML = IIf((isCircleFromDataRow(Tipologia_Layer_Richiesta, row)),
                                        "Circle",
                                        coordinates.type).ToString()
                        prop.InOsservazione = IIf(row("InOsservazione") Is DBNull.Value, 0, row("InOsservazione"))
                        prop.Colore_Primario = row("Colore_Primario")
                        prop.Colore_Retinatura = row("Colore_Retinatura")
                        prop.Trasparenza = IIf(row("Trasparenza") Is DBNull.Value, 0, row("Trasparenza"))
                        prop.Clustered = "False"

                        Dim feature = New AgronicaCoreModelsSTD.Gis.GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
                        feature.type = "Feature"
                        feature.geometry = coordinates
                        feature.properties = prop

                        featureList.Add(feature)
                    End If
                End Sub)

            If (cfgAlbero Is Nothing OrElse (cfgAlbero.TipologiaLayer_Cod = enum_TipologiaLayer.Std And
                                             LayerList.Contains(enum_Gis_LayerElementiGrafici_std.Stazioni_Meteo)
                                            ) OrElse
                                            LayerList.Count = 0) Then

                'Dim xRead As New AgronicaCoreWebService.MeteoNT
                Dim xRead As New InterfacciaMeteoSuite(ObjParametri_Server, ObjParametri_Super_Server)
                Dim xReadLayer As New AgronicaCoreGisBIZ.GIS_LayerElementiGrafici

                Dim DT As DataTable = xReadLayer.leggiDatiBaseLayer(CInt(enum_Gis_LayerElementiGrafici_std.Stazioni_Meteo),
                                                                        CInt(enum_TipologiaLayer.Std),
                                                                        ObjParametri_Server)

                If Not DT Is Nothing AndAlso DT.Rows.Count = 1 AndAlso CBool(DT.Rows(0)("Flag_Visibile")) Then

                    featureList = AggiungiStazioniMeteo(featureList, Piva, xRead, DT.Rows(0), ObjParametri_Server)

                End If
            End If

            finalObj.geoJsonCaricato.features = featureList.ToList()

            'Dim test As String = JsonConvert.SerializeObject(finalObj, New Converters.StringEnumConverter)

            'Dim back = JsonConvert.DeserializeObject(Of GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))(test)

            Return finalObj
        Catch ex As Exception
            Throw New Exception(ex.Message, ex)
        End Try

    End Function

    Private Shared Function AggiungiStazioniMeteo(ByVal featureList As ConcurrentBag(Of GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)),
                                                  ByVal Piva As String, 'ByRef xRead As AgronicaCoreWebService.MeteoNT,
                                                  ByRef xRead As InterfacciaMeteoSuite,
                                                  ByRef LayerRow As DataRow,
                                                  ByRef objParametri As AgronicaCoreParametri
                                                  ) As ConcurrentBag(Of GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))
        Dim parametriCall As New JObject
        parametriCall.Add("PIVA", Piva)
        parametriCall.Add("PIVA_Superuser", objParametri.PivaSuperUser)

        objParametri.FinestraTemporaleInizio = CostantiPersonalizzate.AGRODATAINIZIO
        objParametri.FinestraTemporaleFine = CostantiPersonalizzate.AGRODATAFINE

        Dim anagraficaStazioniString = xRead.LeggiAnagraficaStazioni(parametriCall) ', objParametri)

        objParametri.FinestraTemporaleInizio = Date.Today
        objParametri.FinestraTemporaleInizio = Date.Today

        If Not anagraficaStazioniString.Equals("") Then

            Dim elencoStazioniObj = JObject.Parse(anagraficaStazioniString)

            Dim elencoStazioniConCoordinate = JArray.Parse(elencoStazioniObj("RispostaStringa")).Where(Function(t) t("Staz_Geo") IsNot Nothing)

            For Each stazione In elencoStazioniConCoordinate

                'If stazione("Staz_Geo") Is Nothing Then
                '    Continue For
                'End If

                Dim feature = New AgronicaCoreModelsSTD.Gis.GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
                feature.type = "Feature"

                Dim wktHelp As New WKT

                Dim coord As New List(Of xyz)

                Dim xyzStazione As New xyz With {.X = CType(stazione, JObject).SelectToken("Staz_Geo.Lng"),
                                                 .Y = CType(stazione, JObject).SelectToken("Staz_Geo.Lat")}

                coord.Add(xyzStazione)

                feature.geometry = getStringGeometryGeoJson(wktHelp.CreaWKT(coord, "POINT"))

                Dim prop As New AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp With {
                                .layer = CInt(enum_Gis_LayerElementiGrafici_std.Stazioni_Meteo).ToString,
                                .StandardEntita_layerDiAppartenenza = CInt(enum_Gis_LayerElementiGrafici_std.Stazioni_Meteo).ToString,
                                .StandardEntita_layerDiAppartenenza_Des = LayerRow("LayerElementiGrafici_Des").ToString,
                                .StandardEntita_layerDiAppartenenza_Icona32 = LayerRow("Icona32").ToString,
                                .id = String.Format("{0}|{1}|{2}|{3}", objParametri.PivaSuperUser,
                                                                       ((-1000000) - CInt(stazione("Staz_Id"))).ToString,
                                                                       CInt(enum_TipologiaLayer.Std).ToString,
                                                                       CInt(enum_Gis_LayerElementiGrafici_std.Stazioni_Meteo).ToString),
                                .tipoicona = "",
                                .zindex = LayerRow("ZIndex").ToString,
                                .Entita_Cod = ((-1000000) - CInt(stazione("Staz_Id"))).ToString,
                                .Entita_GUID = "",
                                .veg_cod = "-1",
                                .inserimento = "False",
                                .flag_gps = "0",
                                .etichetta = "",
                                .modifica = "False",
                                .cancellazione = "False",
                                .informazioni = "True",
                                .chiavealbero = "0§01234567891§",
                                .Testo = String.Format("Stazione§ {0}|Fornitore§ {1}|Reale§ {2}",
                                                           stazione("Staz_Nome").ToString,
                                                           stazione("Fornitore").ToString,
                                                           stazione("FlagReale").ToString),
                                .AppIdRate = String.Format("Stazione§ {0}|Fornitore§ {1}|Reale§ {2}",
                                                           stazione("Staz_Nome").ToString,
                                                           stazione("Fornitore").ToString,
                                                           stazione("FlagReale").ToString),
                                .TipologiaGML = "Point",
                                .InOsservazione = "0",
                                .Colore_Primario = LayerRow("Colore_Primario").ToString,
                                .Colore_Retinatura = "",
                                .Trasparenza = LayerRow("Trasparenza").ToString,
                                .ParametriVisualizzazioneLayer = ""
                            }

                feature.properties = prop

                featureList.Add(feature)
            Next
        End If

        Return featureList
    End Function

    Public Shared Function GetNodeTreeInfos(
        ByVal LayerAppartenenza As String,
        ByVal Piva As String,
        ByVal Sa_Cod As Integer,
        ByVal campo_cod As Integer,
        ByVal Appezza As Integer,
        ByVal id_imp As Integer,
        ByVal cfgAlbero As ConfigurazioneAlbero,
        ByRef objParametri_Server As AgronicaCoreParametri
        ) As GeoJSONAgroGisPropTreeNode

        Dim o As New GeoJSONAgroGisPropTreeNode
        Dim key As New GeoJSONAgroGisPropTreeNodeKey()

        GiasBaseHelper.Setta_Link_GiasBase("ASG_objParametri_Server", _LinkGiasBase)

        Select Case LayerAppartenenza

            Case CInt(enum_Gis_LayerElementiGrafici_std.APPEZZAMENTI)

                If Piva = "" Or Sa_Cod = 0 Or Appezza = 0 Then

                    Return Nothing

                Else

                    o.type = "appezzamento"
                    o.imageUrl = _LinkGiasBase + "agronica/AB_Immagini/icone24/x05_Appezzamento.png"
                    o.style = ""

                    key.TipoNodo = enum_TipoNodo.Appezzamento
                    key.Piva = Piva
                    key.Sa_Cod = Sa_Cod
                    key.Campo_Cod = campo_cod
                    key.Appezza = Appezza

                    o.id = key.getKeyString()

                    o.startDate = AGRODATAINIZIO
                    o.endDate = AGRODATAFINE

                    Dim objAppezza As New AgronicaCoreAnagrafeDAL.Appezzamento_Read

                    'Lettura appezzamento

                    Dim DT_Appezzamenti = objAppezza.Leggi_x_anagrafica(
                        Piva,
                        Sa_Cod,
                        0,
                        Appezza,
                        "",
                        "",
                        objParametri_Server)

                    If DT_Appezzamenti.Rows.Count > 0 Then

                        Dim visualizzaRiferimentoAlfanumericoImpianto = False
                        If cfgAlbero IsNot Nothing Then
                            visualizzaRiferimentoAlfanumericoImpianto = cfgAlbero.visualizzaRiferimentoAlfanumericoImpianto
                        End If

                        Dim datiNodoAppezzamento = Utility_AlberoAnagrafica.PreparaDatiNodoAppezzamento(
                            DT_Appezzamenti.Rows(0),
                            visualizzaRiferimentoAlfanumericoImpianto)

                        o.text = datiNodoAppezzamento.DescrizioneNodo
                        o.startDate = datiNodoAppezzamento.xValidita_Inizio
                        o.endDate = datiNodoAppezzamento.xValidita_Fine

                    End If

                End If

            Case CInt(enum_Gis_LayerElementiGrafici_std.IMPIANTI)

                If Piva = "" Or Sa_Cod = 0 Or Appezza = 0 Or id_imp = 0 Then

                    Return Nothing

                Else

                    o.type = "impianto"
                    o.imageUrl = _LinkGiasBase + "agronica/AB_Immagini/IconeVegetali/9999999.ico"
                    o.style = ""

                    key.TipoNodo = enum_TipoNodo.Impianto_Generico
                    key.Piva = Piva
                    key.Sa_Cod = Sa_Cod
                    key.Campo_Cod = campo_cod
                    key.Appezza = Appezza
                    key.Id_Imp = id_imp

                    o.startDate = AGRODATAINIZIO
                    o.endDate = AGRODATAFINE

                    Dim objImpianti As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read

                    'Lettura impianto

                    Dim DT_Impianti = objImpianti.Leggi_xAlbero(
                        Piva,
                        Sa_Cod,
                        Appezza,
                        id_imp,
                        "",
                        "",
                        objParametri_Server,
                        cfgAlbero.FiltroImpiantiIdTestataTemp)

                    If DT_Impianti.Rows.Count > 0 Then

                        Dim datiNodoImpianto = Utility_AlberoAnagrafica.PreparaDatiNodoImpianto(
                            DT_Impianti.Rows(0),
                            0)

                        key.TipoNodo = datiNodoImpianto.TipoNodo

                        o.text = datiNodoImpianto.DescrizioneNodo
                        o.startDate = datiNodoImpianto.xValidita_Inizio
                        o.endDate = datiNodoImpianto.xValidita_Fine

                    End If

                    o.id = key.getKeyString()

                End If

            Case Else

                Return Nothing

        End Select

        Return o

    End Function

    Private Shared Function CheckLayer(ByVal layercod As Integer, ByVal layerlist As List(Of Integer)) As Boolean
        If layerlist Is Nothing Then
            Return True
        ElseIf layerlist.Count = 0 Then
            Return True
        Else
            Return layerlist.Contains(layercod)
        End If
    End Function

    ''' <summary>
    ''' Scrittura nuovo layer personalizzato
    ''' </summary>
    ''' <param name="objScriviNuovoLayerPersonalizzato">Dati nuovo  layer</param>
    ''' <param name="objParametri_Server">Parametri server</param>
    ''' <returns></returns>
    Public Shared Function ScriviNuovoLayerPersonalizzato(ByVal objScriviNuovoLayerPersonalizzato As ScriviNuovoLayerPersonalizzato_In,
                                                          ByRef objParametri_Server As AgronicaCoreParametri
                                                          ) As rispostaStandard(Of ScriviNuovoLayerPersonalizzato_Out)

        Dim r As New rispostaStandard(Of ScriviNuovoLayerPersonalizzato_Out)

        r.RispostaStringa = New ScriviNuovoLayerPersonalizzato_Out()

        Dim objLayerElementiGrafici As New GIS_LayerElementiGrafici

        Dim objNuovoLayer = New GIS_LayerElementiGrafici.ScriviNuovoLayerPersonalizzatoInData With
        {
            .NomeLayer = objScriviNuovoLayerPersonalizzato.NomeLayer,
            .MostraDescrizioneAssociata = objScriviNuovoLayerPersonalizzato.MostraDescrizioneAssociata,
            .FeatureTypeId = objScriviNuovoLayerPersonalizzato.FeatureTypeId
        }

        Dim risposta = objLayerElementiGrafici.ScriviNuovoLayerPersonalizzato(objNuovoLayer, objParametri_Server)

        r.RispostaStringa.LayerElementiGrafici_Cod = risposta.RispostaStringa.LayerElementiGrafici_Cod

        r.RispostaOK = True

        Return r

    End Function

    ''' <summary>
    ''' Eliminazione layer personalizzato
    ''' </summary>
    ''' <param name="layerCod">Codice layer</param>
    ''' <param name="objParametriServer">Parametri server</param>
    ''' <param name="objParametriUtenti">Parametri utenti</param>
    ''' <returns></returns>
    Public Shared Function DeleteCustomLayer(layerCod As Integer,
                                             objParametriServer As AgronicaCoreParametri,
                                             objParametriUtenti As AgronicaCoreParametri
                                             ) As rispostaStandard(Of Boolean)

        Dim r As New rispostaStandard(Of Boolean)
        Dim objLayerElementiGrafici As New GIS_LayerElementiGrafici
        Dim objLayerElementiGraficiAnagrafica As New GIS_LayerElementiGrafici_Anagrafica_W
        Dim xScriviAssociazioneTipoOggetto As New AgronicaCoreGisDAL.GIS_LayerElementiGraficiXTipoOggetto_W
        Dim objLayerTiles As New AgronicaCoreGisBIZ.GIS_LayerTiles_W
        Dim objLayerTilesDescriptions As New AgronicaCoreGisBIZ.GIS_LayerTilesDescrizione_W

        Try
            CustomLayerCancellationAllowed(
                layerCod,
                objParametriServer,
                objParametriUtenti
                )

            AgronicaCoreDataProvider.ConnessioniTransazioni.ApriConnessione(True, objParametriServer)

            'eliminazione di tutti gli elementi grafici associati
            If Not objLayerElementiGrafici.EliminazioneTotaleDatiLayer(layerCod, objParametriServer).RispostaOK Then
                Throw New Exception("Errore durante la cancellazione degli elementi grafici")
            End If

            'rimozione da GIS_LayerElementiGrafici_Anagrafica_DataStruct
            If Not objLayerElementiGrafici.DeleteWholeLayerDataStruct(objParametriServer.PivaSuperUser, layerCod, objParametriServer) Then
                Throw New Exception("Errore durante la cancellazione dei dati da GIS_LayerElementiGrafici_Anagrafica_DataStruct")
            End If

            'rimozione da GIS_LayerTiles
            If Not objLayerTiles.DeleteAllTilesPerLayer(objParametriServer.PivaSuperUser, layerCod, objParametriServer) Then
                Throw New Exception("Errore durante la cancellazione dei dati da GIS_LayerTiles")
            End If

            'rimozione da GIS_LayerTilesDescrizione
            If Not objLayerTilesDescriptions.DeleteAllTilesDescriptionsPerLayer(objParametriServer.PivaSuperUser, layerCod, objParametriServer) Then
                Throw New Exception("Errore durante la cancellazione dei dati da GIS_LayerTilesDescrizione")
            End If

            'rimozione da GIS_LayerElementiGrafici
            objParametriServer.FlagCancellazioneLogica = enumCancellazioneLogica.CancellazioneFisica
            If Not objLayerElementiGrafici.DeleteLayer(objParametriServer.PivaSuperUser, "", layerCod, "", objParametriServer) Then
                Throw New Exception("Errore durante la cancellazione dei dati da GIS_LayerElementiGrafici")
            End If

            'rimozione da GIS_LayerElementiGrafici_Anagrafica
            If Not objLayerElementiGraficiAnagrafica.Delete(objParametriServer.PivaSuperUser, layerCod, 0, "", objParametriServer) Then
                Throw New Exception("Errore durante la cancellazione dei dati da GIS_LayerElementiGrafici_Anagrafica")
            End If

            'rimozione da GIS_LayerElementiGraficiXTipoOggetto
            If Not xScriviAssociazioneTipoOggetto.Delete(objParametriServer.PivaSuperUser, layerCod, 0, "", objParametriServer) Then
                Throw New Exception("Errore durante la cancellazione dei dati da GIS_LayerElementiGraficiXTipoOggetto")
            End If

            'rimozione permessi
            Dim objPermessiUtenti As New AgronicaCoreGisDAL.GIS_LayerElementiGraficiXUtente_W
            Dim objPermessiGruppi As New AgronicaCoreGisDAL.GIS_LayerElementiGraficiXGruppiUtente_W
            If Not objPermessiUtenti.Cancella(layerCod, "", "", objParametriServer) Then
                Throw New Exception("Errore durante la cancellazione dei permessi utenti")
            End If
            If Not objPermessiGruppi.Cancella(layerCod, 0, "", objParametriServer) Then
                Throw New Exception("Errore durante la cancellazione dei permessi gruppi")
            End If

            r.RispostaOK = True
            r.RispostaStringa = True
            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazione(1, objParametriServer)
            AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiConnessione(objParametriServer)
        Catch ex As GiasException
            r.RispostaOK = True
            r.RispostaStringa = False
            r.Errore = ex.Message

            If Not IsNothing(objParametriServer.objTransazione) Then
                AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazione(2, objParametriServer)
            End If

            If Not IsNothing(objParametriServer.objConnessione) Then
                AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiConnessione(objParametriServer)
            End If
        Catch ex As Exception
            r.RispostaOK = False
            r.Errore = ex.Message

            If Not IsNothing(objParametriServer.objTransazione) Then
                AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiTransazione(2, objParametriServer)
            End If

            If Not IsNothing(objParametriServer.objConnessione) Then
                AgronicaCoreDataProvider.ConnessioniTransazioni.ChiudiConnessione(objParametriServer)
            End If
        End Try

        Return r

    End Function

    Public Shared Function SalvaNuovoElementoGraficoDaChiaveAlberoConAppezza_2022(
        ByRef objNuovoElementoGrafico As SalvaNuovoElementoGraficoDaChiaveAlberoConAppezza_In,
        ByRef objParametri_Server As AgronicaCoreParametri
        ) As rispostaStandard(Of Obj_SalvaGrafica)

        Dim risp As New rispostaStandard(Of Obj_SalvaGrafica)

        risp.RispostaStringa = New Obj_SalvaGrafica()

        risp.RispostaStringa.Lista_ElementiGrafici = New List(Of Chiave_SalvaGrafica_Out)

        risp.RispostaOK = True

        Dim Piva As String
        Dim Sa_Cod As Integer
        Dim Campo_Cod As Integer
        Dim Appezza As Integer
        Dim Id_Imp As Integer
        Dim p_Part_Cod As Integer
        Dim p_Provincia_Cod As String
        Dim p_Comune_Cod As String
        Dim p_Sezione As String
        Dim p_Foglio As Integer
        Dim p_Numero As Integer
        Dim p_Subalterno As String
        Dim Cod_Fiscale As String
        Dim Fabbricato_Cod As Integer
        Dim Prodotto_Cod As Integer
        Dim Data_Lavorazione As String
        Dim Analisi_Certificato_Cod As Integer
        Dim Analisi_Testata_Cod As Integer
        Dim Analisi_Dettaglio_Cod As Integer
        Dim Analisi_Campione_Cod As Integer
        Dim Piano_Cod As Integer
        Dim Vas_Cod As Integer
        Dim id_agenda As Integer

        Albero.ChiaveAlbero_Decodifica_x_json(objNuovoElementoGrafico.ChiaveAlbero,
                                              Piva,
                                              Sa_Cod,
                                              Campo_Cod,
                                              Appezza,
                                              Id_Imp,
                                              p_Part_Cod,
                                              p_Provincia_Cod,
                                              p_Comune_Cod,
                                              p_Sezione,
                                              p_Foglio,
                                              p_Numero,
                                              p_Subalterno,
                                              Cod_Fiscale,
                                              Fabbricato_Cod,
                                              Prodotto_Cod,
                                              Data_Lavorazione,
                                              Analisi_Certificato_Cod,
                                              Analisi_Testata_Cod,
                                              Analisi_Dettaglio_Cod,
                                              Analisi_Campione_Cod,
                                              Piano_Cod,
                                              Vas_Cod,
                                              id_agenda)

        Dim objImpianto As New AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo

        objImpianto.Piva = Piva
        objImpianto.Sa_Cod = Sa_Cod
        objImpianto.Appezza = Appezza
        objImpianto.Id_reg = Id_Imp

        If objNuovoElementoGrafico.ChiaveAlbero.Split(SeparatoreAlberoJson)(0) = enum_TipoNodo.Campo Then
            objImpianto.campo_cod = Campo_Cod
        End If

        Dim PropagazioneSalvataggioPoligono As enum_PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.NessunaPropagazione

        If objNuovoElementoGrafico.Area <> "" Then
            AreaAppezzaImpiantoModificaConVerificaAgenda(objNuovoElementoGrafico.Area,
                                                         objParametri_Server,
                                                         Piva,
                                                         Sa_Cod,
                                                         Appezza,
                                                         Id_Imp,
                                                         PropagazioneSalvataggioPoligono)
        End If

        Dim programmazione_entita_cod As Integer = 0
        Dim programmazione_cod As Integer = 0

        Albero.ChiaveAlbero_Decodifica_PlanningEntita_x_json(objNuovoElementoGrafico.ChiaveAlbero,
                                                             "",
                                                             0,
                                                             programmazione_cod,
                                                             programmazione_entita_cod)

        Dim Tipo_entita_cod As Integer = 0
        Dim LayerElementiGrafici_Cod As Integer = 1

        Dim leggiTipoEntita As New AgronicaCoreGisDAL.GIS_TipoEntita_R
        Dim dtleggiTipoEntita As DataTable = leggiTipoEntita.Leggi(0,
                                                                   objNuovoElementoGrafico.ChiaveAlbero.Split(SeparatoreAlberoJson)(0),
                                                                   enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                   "",
                                                                   "",
                                                                   objParametri_Server)

        Tipo_entita_cod = dtleggiTipoEntita.Rows(0)("TipoEntita_Cod")
        LayerElementiGrafici_Cod = dtleggiTipoEntita.Rows(0)("LayerElementiGrafici_Cod")

        Dim listaRitornoObjSalvaGrafica As New List(Of Obj_SalvaGrafica)

        Dim id_Mov_det As Integer = 0
        Dim inSalvaGraficaDati As InSalvaGraficaModel

        Dim leggiCFGStaticMap As New Configurazione_Siti_R
        Dim jSonStaticMapCFG As String = leggiCFGStaticMap.Leggi_Valore(0, "GIS_StaticMapCFG", "", "", objParametri_Server)

        If Tipo_entita_cod = enum_GIS2012_TipoEntita.CATASTO Then
            inSalvaGraficaDati = New InSalvaGraficaModel(objNuovoElementoGrafico.EntitaCod,
                                                         p_Provincia_Cod,
                                                         p_Comune_Cod,
                                                         p_Sezione,
                                                         p_Foglio,
                                                         p_Numero,
                                                         p_Subalterno,
                                                         objNuovoElementoGrafico.HiddenPuntiNuovo,
                                                         Tipo_entita_cod,
                                                         "",
                                                         LayerElementiGrafici_Cod)
        Else
            inSalvaGraficaDati = New InSalvaGraficaModel(Piva,
                                                         Sa_Cod,
                                                         objNuovoElementoGrafico.EntitaCod,
                                                         objNuovoElementoGrafico.HiddenPuntiNuovo,
                                                         programmazione_cod,
                                                         programmazione_entita_cod,
                                                         Tipo_entita_cod,
                                                         objImpianto,
                                                         "",
                                                         LayerElementiGrafici_Cod,
                                                         id_agenda,
                                                         id_Mov_det,
                                                         Analisi_Campione_Cod)

            If Not String.IsNullOrEmpty(jSonStaticMapCFG) Then
                inSalvaGraficaDati.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(jSonStaticMapCFG)
                inSalvaGraficaDati.StaticMapCFG.EntitaCod = objNuovoElementoGrafico.EntitaCod
            End If

        End If

        Dim esitoPositivo As Boolean = True
        ModificaImpiantoSalvaEntitaConGestionePropagazione2(inSalvaGraficaDati,
                                                            enum_TipoOperazioneDB.Scrittura,
                                                            objParametri_Server,
                                                            listaRitornoObjSalvaGrafica,
                                                            PropagazioneSalvataggioPoligono,
                                                            jSonStaticMapCFG,
                                                            esitoPositivo)

        risp.RispostaStringa.Messaggio = ""

        If Not esitoPositivo Then
            risp.RispostaOK = False
            risp.Errore = "Errori ricontrati: "
        End If

        For Each objSalvaGrafica In listaRitornoObjSalvaGrafica
            If Not objSalvaGrafica.Esito Then
                risp.Errore &= objSalvaGrafica.Messaggio & " "
            Else
                For Each elementoGrafico In objSalvaGrafica.Lista_ElementiGrafici
                    risp.RispostaStringa.Lista_ElementiGrafici.Add(elementoGrafico)
                Next
            End If
            risp.RispostaStringa.Messaggio = objSalvaGrafica.Messaggio & " "
        Next

        Return risp

    End Function

    ''' <summary>
    ''' Recupero informazioni WMS
    ''' </summary>
    ''' <param name="url">Indirizzo web servizio recupero informazioni WMS</param>
    ''' <returns></returns>
    Public Shared Function WmsGetFeature(ByVal url As String) As RispostaStandard

        Dim proxy As New AgronicaCoreUtility.Http
        Dim rval As New RispostaStandard

        Try

            Dim pSecur As SecurityProtocolType = ServicePointManager.SecurityProtocol
            ServicePointManager.SecurityProtocol = CType(3072, SecurityProtocolType)

            rval.RispostaStringa = proxy.chiamaWS("",
                                                  Nothing,
                                                  url,
                                                  "text/html",
                                                  "GET",
                                                  "text/html",
                                                  "")

            ServicePointManager.SecurityProtocol = pSecur

            rval.RispostaOK = True

        Catch ex As Exception
            rval.RispostaOK = False
            rval.Errore = Gestione_Eccezioni_2015.MessaggioCompletoDataEccezione(ex, True)
        End Try

        Return rval

    End Function

    Public Shared Function LeggiElencoStrutturaAttributiLayer(
            ByVal LayerElementiGraficiCod_Stringa As String,
            ByRef objParametri_Server As AgronicaCoreParametri,
            ByRef objParametri_Utenti As AgronicaCoreParametri
        ) As DatiStrutturaAttributiLayer

        ' Inizializzazione

        Dim separatore As Object = New With {
            .attributi = "|",
            .proprietaAttributo = "§"
        }

        Dim LayerElementiGraficiCod = Int32.Parse(LayerElementiGraficiCod_Stringa)

        Dim risp As New DatiStrutturaAttributiLayer

        risp.ListaStrutturaAttributiLayer = New List(Of StrutturaAttributiLayer)

        ' Lettura tabella struttura attributi layer

        Dim objLetturaLayerDataStruct = New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_Anagrafica_DataStruct_R
        Dim dtLayerDataStruct = objLetturaLayerDataStruct.Leggi(objParametri_Server.PivaSuperUser,
                                                                LayerElementiGraficiCod,
                                                                enum_TipologiaLayer.Std,
                                                                0,
                                                                "",
                                                                enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                                "",
                                                                "LayerDataStruct.TipologiaLayer_struct_cod",
                                                                objParametri_Server,
                                                                objParametri_Utenti)

        If Not IsNothing(dtLayerDataStruct) And dtLayerDataStruct.Rows.Count > 0 Then

            ' Se presente carico elenco struttura dati attributi
            For Each rigaStrutturaDati In dtLayerDataStruct.Rows
                Dim objStrutturaDati = New StrutturaAttributiLayer()
                objStrutturaDati.StructCod = rigaStrutturaDati("TipologiaLayer_struct_cod")
                objStrutturaDati.EtichettaCod = rigaStrutturaDati("LayerElementiGrafici_Etichetta")
                objStrutturaDati.EtichettaDes = rigaStrutturaDati("LayerElementiGrafici_Etichetta_Des")
                objStrutturaDati.TipoDato = rigaStrutturaDati("LayerElementiGrafici_TipoDato")
                risp.ListaStrutturaAttributiLayer.Add(objStrutturaDati)
            Next

        Else

            ' Se non presente, verifico se posso inserire la struttura dagli elementi grafici
            Dim dtElemGrafici = LeggiElementiGrafici(LayerElementiGraficiCod,
                                                     separatore,
                                                     objParametri_Server)

            If Not IsNothing(dtElemGrafici) And dtElemGrafici.Rows.Count > 0 Then

                Dim attributiElementoGrafico = dtElemGrafici.Rows(0)("ElementoGrafico_Des").ToString()

                RecuperaStrutturaAttributiConInserimento(attributiElementoGrafico,
                                                         separatore,
                                                         LayerElementiGraficiCod,
                                                         objParametri_Server,
                                                         risp)

            End If

        End If

        If risp.ListaStrutturaAttributiLayer.Count > 0 Then
            PreparaStrutturaDatiLayerKendoGrid(risp)
        End If

        ' Risposta

        Return risp

    End Function

    Private Shared Function LeggiElementiGrafici(ByVal LayerElementiGraficiCod As Integer,
                                                 ByRef separatore As Object,
                                                 ByRef objParametri_Server As AgronicaCoreParametri
                                                 ) As DataTable

        Dim objLetturaElemGrafici = New AgronicaCoreGisDAL.GIS_ElementiGrafici_R

        Dim filtroRicercaStrutturaAttributi = String.Format(" Entita.ElementoGrafico_Des LIKE '%{0}%{1}%' ",
                                                            separatore.proprietaAttributo,
                                                            separatore.attributi)

        Dim dtElemGrafici = objLetturaElemGrafici.Leggi(objParametri_Server.PivaSuperUser,
                                                        0,
                                                        0,
                                                        LayerElementiGraficiCod,
                                                        enumFromatoCartograficoConvertito.Nessuna_Conversione,
                                                        enumSelezioneVariabile.Selezione_TabellaCompleta,
                                                        filtroRicercaStrutturaAttributi,
                                                        "",
                                                        objParametri_Server,
                                                        numeroRigheDaLeggere:=1,
                                                        colonneDaLeggere:="ElementoGrafico_Des")

        Return dtElemGrafici

    End Function

    Private Shared Sub RecuperaStrutturaAttributiConInserimento(ByVal attributiElementoGrafico As String,
                                                                ByRef separatore As Object,
                                                                ByVal LayerElementiGraficiCod As Integer,
                                                                ByRef objParametri_Server As AgronicaCoreParametri,
                                                                ByRef risp As DatiStrutturaAttributiLayer)

        Dim elencoAttributi = attributiElementoGrafico.Split(separatore.attributi)

        Dim objScritturaLayerDataStruct = New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_Anagrafica_DataStruct_W

        Dim FlagTransazioneLocale As Boolean
        Dim FlagConnessioneLocale As Boolean

        Try

            Utility.VerificaApriTransazione(objParametri_Server, FlagConnessioneLocale, FlagTransazioneLocale)

            For Each attributo In elencoAttributi
                Dim proprietaAttributo = attributo.Split(separatore.proprietaAttributo)
                If proprietaAttributo.Length = 2 Then
                    Dim etichetta = proprietaAttributo(0)
                    Dim valore = proprietaAttributo(1)

                    Dim agroSequenze As New Agro_Sequenze
                    'Dim structCod = agroSequenze.Agronica_SequenzaTabelle_NuovoID("GIS_LayerElementiGrafici_Anagrafica_DataStruct",
                    '                                                              objParametri_Server)
                    'Lavez - 12/07/2024 - normalizzazione chiamate a stack counter
                    Dim structCod = agroSequenze.NuovoId_Tabella("GIS_LayerElementiGrafici_Anagrafica_DataStruct", 0, AgronicaCoreDataProvider.CostantiPersonalizzate.UpperBoundTabelle_Per_SequenzaTabelle_Topcode, objParametri_Server)

                    objScritturaLayerDataStruct.Scrivi(objParametri_Server.PivaSuperUser,
                                                       LayerElementiGraficiCod,
                                                       enum_TipologiaLayer.Std,
                                                       structCod,
                                                       etichetta,
                                                       TipoDatoString,
                                                       AGRODATAINIZIO,
                                                       AGRODATAFINE,
                                                       objParametri_Server)

                    Dim objStrutturaDati = New StrutturaAttributiLayer()
                    objStrutturaDati.StructCod = structCod
                    objStrutturaDati.EtichettaCod = etichetta
                    objStrutturaDati.EtichettaDes = objStrutturaDati.EtichettaCod
                    objStrutturaDati.TipoDato = TipoDatoString
                    risp.ListaStrutturaAttributiLayer.Add(objStrutturaDati)

                End If
            Next

            Utility.VerificaChiudiTransazione(objParametri_Server, FlagTransazioneLocale)

        Catch ex As Exception

            Utility.VerificaAnnullaTransazione(objParametri_Server, FlagTransazioneLocale)
            Throw New Exception(ex.Message)

        Finally

            Utility.VerificaChiudiConnessione(objParametri_Server, FlagConnessioneLocale)

        End Try

    End Sub

    Private Shared Sub PreparaStrutturaDatiLayerKendoGrid(ByRef risp As DatiStrutturaAttributiLayer)

        Dim dtDati = New DataTable

        Dim listaColonne As New List(Of ColonneNome)

        Dim c As ColonneNome

        For Each attributo In risp.ListaStrutturaAttributiLayer

            dtDati.Columns.Add(New DataColumn(attributo.EtichettaCod, GetTypeAttributo(attributo.TipoDato)))

            c = New ColonneNome(attributo.EtichettaCod, attributo.EtichettaDes, attributo.TipoDato)
            c._Filtrabile = True
            c._Display = True
            '--------------------------------------------------------------------------------
            ' In attributo.TipoDato si potrebbe in futuro gestire anche il formato.
            '--------------------------------------------------------------------------------
            ' Alcuni esempi:
            ' "date"   => c._formatNr = "{0:dd/MM/yyyy}"
            ' "number" => c._formatNr = "n2"
            '--------------------------------------------------------------------------------
            listaColonne.Add(c)

        Next

        Dim js As New JSON_DataTable With {
            .Editabile_Deafault = False
        }

        risp.KendoGridAttributiLayer = js.JSON_DataTable_Kendo(dtDati,
                                                               listaColonne,
                                                               AssegnaAutomaticamenteTipoFiltro_daTipoDato:=True,
                                                               tipoFiltroKendo:=TipoFiltroKendo_colonne.CasellaDiscesa)

    End Sub

    Private Shared Function GetTypeAttributo(tipoDatoAttributo As String) As Type

        Dim typeAttributo As Type

        Select Case tipoDatoAttributo

            Case TipoDatoString
                typeAttributo = GetType(String)

            Case TipoDatoNumber
                typeAttributo = GetType(Integer)

            Case TipoDatoDate
                typeAttributo = GetType(Date)

            Case Else
                typeAttributo = GetType(String)

        End Select

        Return typeAttributo

    End Function

