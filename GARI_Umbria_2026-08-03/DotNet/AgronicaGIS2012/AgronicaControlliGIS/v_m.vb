    Public Shared Function SalvaNuovoElementoGraficoDaChiaveAlberoConAppezza_Generic(ByVal ChiaveAlbero As String, ByVal hiddenPunti_Nuovo As String, ByVal Area As String, ByVal flag_gps As String, ByVal tipoOperazioneDB As TipiEnumerativi.enum_TipoOperazioneDB, ByVal entitaCod As Integer) As RispostaStandard
        Dim risp As New RispostaStandard
        Dim objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")

        risp.RispostaOK = True

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            risp.RispostaOK = False
            risp.Sessione = False
            risp.RispostaStringa = "SessioneScaduta"
            Return risp
        End If

        Lingua.Gias_InizializzaCultura_DaSession()


        Dim Piva As String
        Dim Sa_Cod As Integer
        Dim Campo_Cod As Integer
        Dim Appezza As Integer
        Dim Id_Imp As Integer
        Dim p_Part_Cod As Integer
        Dim p_Provincia_Cod As String
        Dim p_Comune_Cod As String
        Dim p_Sezione As String
        Dim p_Foglio As Integer
        Dim p_Numero As Integer
        Dim p_Subalterno As String
        Dim Cod_Fiscale As String
        Dim Fabbricato_Cod As Integer
        Dim Prodotto_Cod As Integer
        Dim Data_Lavorazione As String
        Dim Analisi_Certificato_Cod As Integer
        Dim Analisi_Testata_Cod As Integer
        Dim Analisi_Dettaglio_Cod As Integer
        Dim Analisi_Campione_Cod As Integer
        Dim Piano_Cod As Integer
        Dim Vas_Cod As Integer
        Dim id_agenda As Integer


        AgronicaCoreDataProvider.Albero.ChiaveAlbero_Decodifica_x_json(
            ChiaveAlbero,
            Piva,
            Sa_Cod,
            Campo_Cod,
            Appezza,
            Id_Imp,
            p_Part_Cod,
            p_Provincia_Cod,
            p_Comune_Cod,
            p_Sezione,
            p_Foglio,
            p_Numero,
            p_Subalterno,
            Cod_Fiscale,
            Fabbricato_Cod,
            Prodotto_Cod,
            Data_Lavorazione,
            Analisi_Certificato_Cod,
            Analisi_Testata_Cod,
            Analisi_Dettaglio_Cod,
            Analisi_Campione_Cod,
            Piano_Cod,
            Vas_Cod,
            id_agenda
        )




        Dim objImpianto As New AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo

        objImpianto.Piva = Piva
        objImpianto.Sa_Cod = Sa_Cod
        objImpianto.Appezza = Appezza
        objImpianto.Id_reg = Id_Imp

        If ChiaveAlbero.Split(SeparatoreAlberoJson)(0) = enum_TipoNodo.Campo Then
            objImpianto.campo_cod = Campo_Cod
        End If

        Dim PropagazioneSalvataggioPoligono As enum_PropagazioneSalvataggioPoligono = enum_PropagazioneSalvataggioPoligono.NessunaPropagazione

        If Area <> "" Then
            AreaAppezzaImpiantoModificaConVerificaAgenda(Area, objParametri_Server, Piva, Sa_Cod, Appezza, Id_Imp, PropagazioneSalvataggioPoligono)
        End If

        Dim programmazione_entita_cod As Integer = 0
        Dim programmazione_cod As Integer = 0

        '  Vanni, 13/06/2013 12:55:21: aggiunta decodifica planning
        Albero.ChiaveAlbero_Decodifica_PlanningEntita_x_json(ChiaveAlbero, "", 0, programmazione_cod, programmazione_entita_cod)

        Dim Tipo_entita_cod As Integer = 0
        Dim LayerElementiGrafici_Cod As Integer = 1

        Dim leggiTipoEntita As New AgronicaCoreGisDAL.GIS_TipoEntita_R
        Dim dtleggiTipoEntita As DataTable =
        leggiTipoEntita.Leggi(
            0,
            ChiaveAlbero.Split(SeparatoreAlberoJson)(0),
            enumSelezioneVariabile.Selezione_TabellaCompleta,
            "",
            "",
            objParametri_Server
        )

        Tipo_entita_cod = dtleggiTipoEntita.Rows(0)("TipoEntita_Cod")
        LayerElementiGrafici_Cod = dtleggiTipoEntita.Rows(0)("LayerElementiGrafici_Cod")

        Dim strErrore As String = ""

        Dim rispostaSalvataggio As Boolean

        Dim id_Mov_det As Integer = 0 'ma perchè zero?, verificare
        Dim inSalvaGraficaDati As InSalvaGraficaModel

        Dim leggiCFGStaticMap As New Configurazione_Siti_R
        Dim jSonStaticMapCFG As String = leggiCFGStaticMap.Leggi_Valore(0, "GIS_StaticMapCFG", "", "", objParametri_Server)

        If Tipo_entita_cod = enum_GIS2012_TipoEntita.CATASTO Then
            inSalvaGraficaDati = New InSalvaGraficaModel(
                Entita_cod:=entitaCod,
                CatastoProv:=p_Provincia_Cod,
                CatastoCom:=p_Comune_Cod,
                CatastoSezione:=p_Sezione,
                CatastoFoglio:=p_Foglio,
                CatastoNumero:=p_Numero,
                CatastoSubalterno:=p_Subalterno,
                HiddenPunti:=hiddenPunti_Nuovo,
                Tipo_entita_cod:=Tipo_entita_cod,
                ElementoGrafico_DES:="",
                layer_codAtt:=LayerElementiGrafici_Cod
            )
        Else
            inSalvaGraficaDati = New InSalvaGraficaModel(
                piva:=Piva,
                sa_cod:=Sa_Cod,
                Entita_cod:=entitaCod,
                hiddenPunti:=hiddenPunti_Nuovo,
                programmazione_cod:=programmazione_cod,
                programmazione_entita_cod:=programmazione_entita_cod,
                Tipo_entita_cod:=Tipo_entita_cod,
                objImpianto:=objImpianto,
                ElementoGrafico_DES:="",
                layer_codAtt:=LayerElementiGrafici_Cod,
                id_agenda:=id_agenda,
                id_Mov_Det:=id_Mov_det,
                analisi_campione_cod:=Analisi_Campione_Cod
            )

            ' VAnni: 29/9/2021: GIS_StaticMapCFG            
            If Not String.IsNullOrEmpty(jSonStaticMapCFG) Then
                inSalvaGraficaDati.StaticMapCFG = JsonConvert.DeserializeObject(Of GeneraMappaStaticaInData)(jSonStaticMapCFG)
                inSalvaGraficaDati.StaticMapCFG.EntitaCod = entitaCod
            End If

        End If


        ModificaImpiantoSalvaEntitaConGestionePropagazione(
                inSalvaGraficaDati,
                enum_TipoOperazioneDB.Scrittura,
                objParametri_Server,
                strErrore,
                risp.RispostaOK,
                PropagazioneSalvataggioPoligono,
                jSonStaticMapCFG
            )


