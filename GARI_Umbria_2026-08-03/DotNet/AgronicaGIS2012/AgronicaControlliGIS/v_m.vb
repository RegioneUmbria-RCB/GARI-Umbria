    Private Function GetLayer(ByRef strs As String, ByVal xdoc As XDocument, ByVal ns As XNamespace) As String
        Dim JSON As New StringBuilder

        Dim rndom As New Random
        generaElencoTipologia_json(xdoc, JSON, Layer_Selezionato)

        Dim str_app As String = "layers = " & elencoTipologieToJson(JSON) & "; "

        'comprimo
        'strs = strs & JavaScriptCompressor.Compress(str_app)
        strs = strs & JavaScriptCompressor.Compress(str_app)

        Dim opzioniDrop As New StringBuilder
        opzioniDrop.Append("<select class='form-control' id='tipologia_layer'>")
        For Each elemento In (
           From a In xdoc.<DatiEntita>.<layersdescrizioni>.<layer>).ToList()
            opzioniDrop.Append("<option value='" & elemento.@tipologia_layer & "'")
            If Layer_Selezionato = elemento.@tipologia_layer Then
                opzioniDrop.Append(" selected='selected'")
            End If
            opzioniDrop.Append(">" & elemento.@nome_layer & "</option>")
        Next
        opzioniDrop.Append("</select>")



        Return opzioniDrop.ToString
        'Place_combo_opzioni.Controls.Add(New LiteralControl(opzioniDrop.ToString))

    End Function

    Private Shared Function getIcona(ByVal icona As String, ByVal layerSelezionato As Integer) As String



        Dim lbase As String = "../AB_Immagini/icone/"

        If layerSelezionato = enum_TipologiaLayer.SpecieVegetale OrElse layerSelezionato = enum_TipologiaLayer.Cultivar Then
            lbase = "../AB_Immagini/iconeVegetali/"
        End If

        Return lbase & icona
    End Function


    Private Shared Sub generaElencoTipologia_json(ByVal xdoc As XDocument, ByRef JSON As StringBuilder, ByVal Layer_Selezionato As Integer)

        Const formatoJsonTile = "{0}" &
                                " 'nome' : '{1}' ," &
                                " 'id' : '{2}' ," &
                                " 'colore_primario' : '{3}' ," &
                                " 'colore_secondario' : '{4}' ," &
                                " 'varianza' : '{5}' ," &
                                " 'v_min' : '99999999' ," &
                                " 'v_max' : '-99999999' ," &
                                " {6} " &
                                "{7}"

        For Each elemento In (
                    From a In xdoc.<DatiEntita>.<layersdescrizioni>.<layer>).ToList()
            If (elemento.@tipologia_layer.ToString = Layer_Selezionato) Then
                For Each valore In (
                    From b In elemento.<valori>).ToList()
                    'se ho il layer selezionato
                    Dim nome As String = valore.Value
                    Dim codice As String = valore.@codice

                    Dim colore As String = valore.@colore_primario

                    Dim dSep As String = Threading.Thread.CurrentThread.CurrentCulture.NumberFormat.NumberDecimalSeparator
                    Dim sTrasparenza As String = valore.@trasparenza.ToString.Replace(".", dSep)

                    If String.IsNullOrEmpty(sTrasparenza) Then
                        sTrasparenza = "0"
                    End If

                    Dim trasparenza As Double = Math.Round(CDbl(sTrasparenza), 1)
                    sTrasparenza = trasparenza.ToString.Replace(dSep, ".")

                    Dim sMostraDescrizioneAssociata As String = valore.@MostraDescrizioneAssociata
                    If String.IsNullOrEmpty(sMostraDescrizioneAssociata) Then
                        sMostraDescrizioneAssociata = "0"
                    End If

                    Dim varianza As Integer = valore.@varianza
                    Dim icona16 As String = valore.@icona16
                    Dim icona32 As String = valore.@icona32

                    'apertura
                    If JSON.Length > 0 Then
                        JSON.Append(",{")
                    Else
                        JSON.Append("{")
                    End If
                    JSON.Append("'nome' : '" & nome.Replace("'", PlaceholderApiceSingolo) & "' , ")
                    JSON.Append("'id' : '" & codice & "' , ")
                    JSON.Append("'colore_1' : '" & colore & "',  ")

                    If varianza = 1 Then
                        colore = ""
                    Else
                        colore = valore.@colore_secondario
                        If IsNothing(colore) Then
                            colore = ""
                        End If
                    End If

                    JSON.Append("'colore_2' : '" & colore & "',  ")
                    JSON.Append("'varianza' : '" & varianza & "',  ")
                    JSON.Append("'trasparenza' : '" & trasparenza & "',  ")
                    JSON.Append("'MostraDescrizioneAssociata' : '" & sMostraDescrizioneAssociata & "',  ")
                    JSON.Append("'zindex' : '" & valore.@ZIndex & "',  ")

                    JSON.Append("'icona16' : '" & getIcona(icona16, Layer_Selezionato) & "',  ")
                    JSON.Append("'icona32' : '" & getIcona(icona32, Layer_Selezionato) & "',  ")

                    JSON.Append("'flagvisibile' : '" & valore.@flagvisibile & "',  ")

                    JSON.Append("'RaggruppaDescrizioneAssociata' : '1',  ")

                    'dati anagrafica layer
                    JSON.Append("'FlagInserimento' : '" & valore.@FlagInserimento & "', ")
                    JSON.Append("'FlagModifica' : '" & valore.@FlagModifica & "', ")
                    JSON.Append("'FlagCancellazione' : '" & valore.@FlagCancellazione & "', ")
                    JSON.Append("'FlagInformazioni' : '" & valore.@FlagInformazioni & "', ")

                    'dati tipo oggetto
                    JSON.Append("'FeatureTypeId' : '" & valore.@FeatureTypeId & "', ")

                    'tipo nodo albero
                    JSON.Append("'TipoNodoAlberoAnagrafe' : '" & valore.@TipoNodoAlberoAnagrafe & "' ")

                    'tiles
                    Dim tiles = (From t In elemento.<tiles>.<tile>
                                 Where t.@codice = codice).ToList

                    Dim jsonTiles As New StringBuilder
                    jsonTiles.Length = 0
                    If tiles.Count > 0 Then
                        jsonTiles.Append(", 'tiles' : [")
                    End If
                    Dim conta As Integer = 0
                    For Each tile In tiles
                        Dim stringaJsonTile = String.Format(formatoJsonTile,
                                                            "{",
                                                            tile.<tiletesto>.Value.Replace("'", PlaceholderApiceSingolo),
                                                            tile.@id,
                                                            tile.@colore_primario,
                                                            tile.@colore_secondario,
                                                            tile.@varianza,
                                                            getTileLabels(tile),
                                                            "}")
                        jsonTiles.Append(stringaJsonTile)
                        If conta < tiles.Count - 1 Then
                            jsonTiles.Append(" , ")
                        End If
                        conta += 1
                    Next
                    If tiles.Count > 0 Then
                        jsonTiles.Append(" ] ")
                    End If
                    JSON.Append(jsonTiles.ToString)

                    JSON.Append(" } ")
                Next

            End If
        Next
    End Sub

    Private Shared Function getTileLabels(ByVal t As XElement) As String


        Dim lT As String = t.<tilelayerpadre>.Value
        Dim sTilelayerpadre As String = ""
        If Not String.IsNullOrEmpty(lT) Then
            sTilelayerpadre = lT.ToString.Replace("'", PlaceholderApiceSingolo)
        End If

        Dim rval As String =
            "   'tilelayerpadre': '" & sTilelayerpadre & "'" &
            " , 'tilelabels':["

        Dim lbls As String = ""
        For Each t1 In t.<tilelabels>.<tilelabel>
            lbls &= "{ 'label': '" & t1.Value.ToString.Replace("'", PlaceholderApiceSingolo) & "', 'valore_associato': '" & t1.@valore_associato & "', 'valore_min': '" & t1.@valore_min & "', 'valore_max': '" & t1.@valore_max & "'},"
        Next

        If lbls <> "" Then
            rval &= lbls.TrimEnd(",")
        End If

        Return rval & "]"
    End Function

