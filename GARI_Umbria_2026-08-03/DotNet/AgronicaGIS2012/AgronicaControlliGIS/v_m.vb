    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="ChiaveAlbero"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <returns></returns>
    Public Shared Function ControllaSeEsistonoOperazioni_2022(ByVal ChiaveAlbero As ChiaveAlbero,
                                                              ByRef objParametri_Server As AgronicaCoreParametri) As RispostaStandard
        Dim r As New RispostaStandard

        Dim tipoNodoAlbero As enum_TipoNodo = ChiaveAlbero.TipoNodo

        If Not (tipoNodoAlbero = enum_TipoNodo.ImpiantoArborea _
                Or tipoNodoAlbero = enum_TipoNodo.ImpiantoErbacea _
                Or tipoNodoAlbero = enum_TipoNodo.ImpiantoNudo _
                Or tipoNodoAlbero = enum_TipoNodo.ImpiantoOrticola _
                Or tipoNodoAlbero = enum_TipoNodo.Impianto_Generico) Then

            r.RispostaStringa = "true"

        Else
            'controllo se esistono le operazioni
            Dim objAgenda As New AgronicaCoreContabDAL.Mov_Destinazioni_R
            Dim dt As DataTable

            dt = objAgenda.Leggi(ChiaveAlbero.Piva,
                                 ChiaveAlbero.Sa_Cod,
                                 0,
                                 0,
                                 0,
                                 ChiaveAlbero.Appezza,
                                 ChiaveAlbero.Id_Imp,
                                 0,
                                 enumSelezioneVariabile.Selezione_TabellaCompleta,
                                 "",
                                 "",
                                 objParametri_Server)

            If dt.Rows.Count = 0 Then
                r.RispostaStringa = "true"

            Else
                Dim strToReturn As String = AgronicaControlliGIS.My.Resources.AgronicaControlliGIS.V_M_ControllaSeEsistonoOperazioni_Avviso_modifica_superficie_impianto

                r.RispostaStringa = String.Format(strToReturn, dt.Rows.Count)

            End If

        End If

        r.RispostaOK = True

        Return r

    End Function

