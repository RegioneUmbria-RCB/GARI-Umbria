    Private Shared Function GetGeoJSONFromDataTablePuntiGPS(puntiGps As DataTable, objParametri_Utenti As AgronicaCoreParametri) As GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
        Dim geoJson As New GeoJson_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)

        geoJson.geoJsonCaricato = New AgronicaCoreModelsSTD.Gis.GeoJson_Shape_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)
        geoJson.geoJsonCaricato.type = "FeatureCollection"
        geoJson.geoJsonCaricato.features = New List(Of AgronicaCoreModelsSTD.Gis.GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp))

        For Each row In puntiGps.Rows
            Dim gisProp As New GeoJson_Feature_New(Of AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp)

            Dim stringaId = ""
            Dim dataOra = My.Resources.AgronicaControlliGIS.DataOra
            Dim tecnico = My.Resources.AgronicaControlliGIS.Tecnico
            Dim direzioneGradi = My.Resources.AgronicaControlliGIS.DirezioneGradi
            Dim nTelefono = My.Resources.AgronicaControlliGIS.NTelefono
            Dim quotaM = My.Resources.AgronicaControlliGIS.QuotaM
            Dim velocitaKmH = My.Resources.AgronicaControlliGIS.VelocitaKmH
            stringaId = String.Format("{0}" & dataOra & "§ {1}", stringaId, row("DataOra").ToString)
            stringaId = String.Format("{0}|" & tecnico & "§ {1}", stringaId, row("Descrizione").ToString)
            stringaId = String.Format("{0}|" & direzioneGradi & "§ {1}", stringaId, row("direzione").ToString)
            stringaId = String.Format("{0}|" & nTelefono & "§ {1}", stringaId, row("N_telefono").ToString)
            stringaId = String.Format("{0}|" & quotaM & "§ {1}", stringaId, row("quota").ToString)
            stringaId = String.Format("{0}|" & velocitaKmH & "§ {1}", stringaId, row("velocita").ToString)

            gisProp.type = "Feature"

            Dim prop As New AgronicaCoreModelsSTD.Gis.GeoJSONAgroGisProp()

            'Parametri dinamici
            prop.AppIdRate = stringaId
            prop.Testo = stringaId
            prop.Entita_Cod = String.Format("-{0}", row("id"))
            prop.id = String.Format("{0}|{1}|{2}|{3}", objParametri_Utenti.PivaSuperUser,
                                                       prop.Entita_Cod,
                                                       Convert.ToInt32(enum_TipologiaLayer.Std).ToString,
                                                       Convert.ToInt32(enum_Gis_LayerElementiGrafici_std.Tecnici_in_campo).ToString)

            'Parametri fissi
            prop.layer = Convert.ToInt32(enum_Gis_LayerElementiGrafici_std.Tecnici_in_campo).ToString
            prop.StandardEntita_layerDiAppartenenza = Convert.ToInt32(enum_Gis_LayerElementiGrafici_std.Tecnici_in_campo).ToString
            prop.zindex = Convert.ToInt32(enum_Gis_LayerElementiGrafici_std.Tecnici_in_campo).ToString
            prop.StandardEntita_layerDiAppartenenza_Des = "Tecnici in campo"
            prop.StandardEntita_layerDiAppartenenza_Icona32 = ""
            prop.TipologiaGML = "Point"
            prop.flag_gps = "2"
            prop.cancellazione = "False"
            prop.modifica = "False"
            prop.inserimento = "False"
            prop.chiavealbero = ""
            prop.Colore_Primario = ""
            prop.Colore_Retinatura = ""
            prop.InOsservazione = 0
            prop.informazioni = "True"
            prop.etichetta = ""
            prop.veg_cod = "-1"
            prop.tipoicona = ""

            Dim coord As New List(Of Double)

            coord.Add(Double.Parse(row("Longitudine"), System.Globalization.CultureInfo.InvariantCulture))
            coord.Add(Double.Parse(row("Latitudine"), System.Globalization.CultureInfo.InvariantCulture))

            gisProp.geometry = New GeoJson_Geometry_New(FeatureType.Point, Newtonsoft.Json.JsonConvert.SerializeObject(coord))

            gisProp.properties = prop

            geoJson.geoJsonCaricato.features.Add(gisProp)
        Next

        Return geoJson
    End Function

