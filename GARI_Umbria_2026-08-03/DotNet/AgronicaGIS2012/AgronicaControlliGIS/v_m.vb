    ''' <summary>
    ''' gestione della tabella dei layers
    ''' </summary>
    ''' <param name="tipologiaLayerCod"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Shared Function Caricaplace_tabella(ByVal tipologiaLayerCod As Integer) As String

        Dim objParametri_server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()


        If tipologiaLayerCod = -1 Then
            Return ""
        End If

        If objParametri_server.PivaSuperUser = objParametri_server.UsernameOperazione Then
            Try
                Dim oneShot As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_W
                oneShot.UpdateSuperUserOneShot(objParametri_server.PivaSuperUser, objParametri_server)
            Catch e As Exception
            End Try

        End If

        Dim objLyerEntita As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_R

        'leggo tutti le impostazioni del superuser e incollo i default del super user
        Dim DT_SuperUser As DataTable
        DT_SuperUser = objLyerEntita.Leggi(objParametri_server.PivaSuperUser, objParametri_server.SuperUserUsername, 0, 0, AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta, "", " ZIndex ", objParametri_server)

        Dim DT_UtenteCorrente As DataTable
        DT_UtenteCorrente = objLyerEntita.Leggi(objParametri_server.PivaSuperUser, objParametri_server.UtenteUsername, 0, 0, AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta, "", " ZIndex ", objParametri_server)

        Dim dr() As DataRow
        Dim objW As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_W

        For i = 0 To DT_SuperUser.Rows.Count - 1

            Dim leg_cod As String = DT_SuperUser.Rows(i).Item("LayerElementiGrafici_Cod")
            If leg_cod <> 0 Then

                dr = DT_UtenteCorrente.Select("LayerElementiGrafici_Cod='" & DT_SuperUser.Rows(i).Item("LayerElementiGrafici_Cod") & "'")
                If dr.Length = 0 Then
                    objW.Scrivi(objParametri_server.PivaSuperUser, objParametri_server.UtenteUsername,
                             DT_SuperUser.Rows(i).Item("LayerElementiGrafici_Cod"),
                             DT_SuperUser.Rows(i).Item("LayerElementiGrafici_Des"),
                             DT_SuperUser.Rows(i).Item("Flag_Attivo"),
                             DT_SuperUser.Rows(i).Item("Flag_Visibile"),
                             IIf(IsDBNull(DT_SuperUser.Rows(i).Item("Colore_Base")), "", DT_SuperUser.Rows(i).Item("Colore_Base")),
                             IIf(IsDBNull(DT_SuperUser.Rows(i).Item("Colore_Selezionato")), "", DT_SuperUser.Rows(i).Item("Colore_Selezionato")),
                             IIf(IsDBNull(DT_SuperUser.Rows(i).Item("Colore_Primario")), "", DT_SuperUser.Rows(i).Item("Colore_Primario")),
                             IIf(IsDBNull(DT_SuperUser.Rows(i).Item("Colore_Secondario")), "", DT_SuperUser.Rows(i).Item("Colore_Secondario")),
                             DT_SuperUser.Rows(i).Item("Varianza"),
                             DT_SuperUser.Rows(i).Item("Trasparenza"),
                             DT_SuperUser.Rows(i).Item("MostraDescrizioneAssociata"),
                             DT_SuperUser.Rows(i).Item("TipologiaLayer_cod"),
                             DT_SuperUser.Rows(i).Item("ZIndex"),
                             IIf(IsDBNull(DT_SuperUser.Rows(i).Item("icona16")), "", DT_SuperUser.Rows(i).Item("Icona16")),
                             IIf(IsDBNull(DT_SuperUser.Rows(i).Item("icona32")), "", DT_SuperUser.Rows(i).Item("Icona32")),
                             DT_SuperUser.Rows(i).Item("Validita_Inizio"),
                             DT_SuperUser.Rows(i).Item("Validita_Fine"),
                             objParametri_server)
                End If

            End If

        Next


        'leggo solo i layer della tipologia selezionata
        Dim SingoloColore As Boolean
        Dim dt_Ti As DataTable
        Dim objTip As New AgronicaCoreGisDAL.GIS_TipologiaLayer_cod_R
        dt_Ti = objTip.Leggi(tipologiaLayerCod, "", "", objParametri_server)
        SingoloColore = CBool(dt_Ti.Rows(0).Item("SingoloColore"))


        Dim DT_EleG As DataTable
        DT_EleG = objLyerEntita.Leggi(
            objParametri_server.PivaSuperUser,
            objParametri_server.UtenteUsername, 0,
            tipologiaLayerCod,
            AgronicaCoreParametri.enumSelezioneVariabile.Selezione_TabellaCompleta,
            "",
            " ZIndex ",
            objParametri_server
        )



        Dim strTabella As New StringBuilder

        strTabella.AppendLine("<table>")
        strTabella.AppendLine("<tr>")
        strTabella.AppendLine("<th>Entità</th>")
        strTabella.AppendLine("<th>Colore Primario</th>")
        If SingoloColore = False Then
            strTabella.AppendLine("<th>Colore Secondario</th>")
            strTabella.AppendLine("<th>N. di Varianza</th>")
        End If

        strTabella.AppendLine("<th>Trasparenza</th>")
        strTabella.AppendLine("<th>Livello</th>")
        strTabella.AppendLine("<th>Visibile</th>")
        strTabella.AppendLine("<th>Mostra Descrizione</th>")
        strTabella.AppendLine("</tr>")



        For i = 0 To DT_EleG.Rows.Count - 1

            strTabella.AppendLine("<tr>")

            Dim str_hidden As String = "<input type='hidden' class='chiave' value='" & DT_EleG.Rows(i).Item("LayerElementiGrafici_Cod") & "'/>"
            strTabella.AppendLine("<td>" & DT_EleG.Rows(i).Item("LayerElementiGrafici_Des") & str_hidden & "</td>")

            Dim str_Text As String = "<input type='text' style='width:60px;' class='tavolozza primario' value='" & DT_EleG.Rows(i).Item("colore_primario") & "'/>"
            strTabella.AppendLine("<td>" & str_Text & "</td>")




            If SingoloColore = False Then
                str_Text = "<input type='text' style='width:60px;' class='tavolozza secondario' value='" & DT_EleG.Rows(i).Item("Colore_secondario") & "'/>"
                strTabella.AppendLine("<td>" & str_Text & "</td>")

                str_Text = "<input type='text' style='width:60px;' class='varianza' value='" & DT_EleG.Rows(i).Item("varianza") & "'/>"
                strTabella.AppendLine("<td>" & str_Text & "</td>")

            End If

            Dim trasparenza As String =
                "<div id="" slider-" & DT_EleG.Rows(i).Item(" LayerElementiGrafici_Cod") & """ class="" aslider slider-range"" style="" width:90px;""></div>" &
                "<input class="" sliderValue trasparenza"" id="" slider-txt-" & DT_EleG.Rows(i).Item(" LayerElementiGrafici_Cod") & """ type='text' style='display: none; width:40px;' value='" & DT_EleG.Rows(i).Item("trasparenza") & "'/>" &
                "<input class="" kendoSlider"" id="" sliderKendo-txt-" & DT_EleG.Rows(i).Item(" LayerElementiGrafici_Cod") & """ type='text' style='width:40px;'/>"
            strTabella.AppendLine("<td>" & trasparenza & "</td>")

            Dim zindex As String = "<input type='text' style='width:40px;' class='zindex' value='" & DT_EleG.Rows(i).Item("zindex") & "'/>"
            strTabella.AppendLine("<td>" & zindex & "</td>")

            Caricaplace_tabella_impostacheckbox("flag_visibile", DT_EleG, strTabella, i)
            Caricaplace_tabella_impostacheckbox("MostraDescrizioneAssociata", DT_EleG, strTabella, i)


            strTabella.AppendLine("</tr>")
        Next

        strTabella.AppendLine("</table>")

        Return strTabella.ToString


    End Function

