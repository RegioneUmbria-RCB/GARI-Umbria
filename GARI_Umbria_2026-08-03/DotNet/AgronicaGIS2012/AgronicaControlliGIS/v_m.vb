                .InOsservazione = elemento.<EntitaGIAS>.<DatoGias>.<InOsservazione>.Value,
                .Colore_Primario = elemento.<EntitaGIAS>.<DatoGias>.<Colore_Primario>.Value,
                .Colore_Retinatura = elemento.<EntitaGIAS>.<DatoGias>.<Colore_Retinatura>.Value,
                .Trasparenza = elemento.<EntitaGIAS>.<DatoGias>.<Trasparenza>.Value
                }}).ToList

        strs = JsonConvert.SerializeObject(finalObj)

