            Ind.Cap = objM.CAP_form_PROV_COM(Ind.Pro_Cod, Ind.Com_Cod, objParametri_Server)
        End If


        Dim strErr As String

        strErr = SalvaCentroAziendale(piva, ragione_sociale, sLat, sLong, Ind, objParametri_Server, objParametri_Utenti)

        Return strErr

