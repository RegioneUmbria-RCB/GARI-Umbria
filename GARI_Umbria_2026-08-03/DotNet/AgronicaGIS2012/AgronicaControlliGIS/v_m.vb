    Public Shared Function AggiornaFinestraTemporale(ByVal da As String, ByVal limite_inferiore As String,
                                                     ByVal a As String, ByVal limite_superiore As String) As String


        'todo: session
        Lingua.Gias_InizializzaCultura_DaSession()

        Dim objParametri_Server As New AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")
        Dim objParametri_utenti As New AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_utenti = HttpContext.Current.Session("ASG_objParametri_Utenti")
        If limite_superiore = "precedente" Then
            HttpContext.Current.Session("limite_superiore") = "<="
        Else
            HttpContext.Current.Session("limite_superiore") = ">="
        End If

        If limite_inferiore = "precedente" Then
            HttpContext.Current.Session("limite_inferiore") = "<="
        Else
            HttpContext.Current.Session("limite_inferiore") = ">="
        End If


        Dim DataDa As Date
        Dim DataA As Date

        If IsDate(da) Then
            DataDa = da
        Else
            DataDa = AGRODATAINIZIO
        End If
        If IsDate(a) Then
            DataA = a
        Else
            DataA = AGRODATAFINE
        End If

        objParametri_Server.FinestraTemporaleFine = DataA
        objParametri_Server.FinestraTemporaleInizio = DataDa

        objParametri_utenti.FinestraTemporaleFine = DataA
        objParametri_utenti.FinestraTemporaleInizio = DataDa


        HttpContext.Current.Session("ASG_objParametri_Server") = objParametri_Server
        HttpContext.Current.Session("ASG_objParametri_Utenti") = objParametri_utenti

        Return "ok"
    End Function



