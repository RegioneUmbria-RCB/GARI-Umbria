    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="objAnalisiBs"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="objParametri_Utenti"></param>
    ''' <param name="objParametri_Super_Server"></param>
    ''' <returns></returns>
    Public Shared Function AnalisiMeteoBs_2022(ByVal objAnalisiBs As AnalisiMeteo_In,
                                               ByRef objParametri_Server As AgronicaCoreParametri,
                                               ByRef objParametri_Utenti As AgronicaCoreParametri,
                                               ByRef objParametri_Super_Server As AgronicaCoreParametri) As rispostaStandard(Of AnalisiMeteo_Out)
        Dim r As rispostaStandard(Of AnalisiMeteo_Out)

        Dim Veg_Cod As String = objAnalisiBs.objParametri_Agenda.Veg_Cod

        r = AnalisiMeteoCommon2(objAnalisiBs,
                                objParametri_Server,
                                objParametri_Utenti,
                                objParametri_Super_Server)

        'Compone l'URL di ritorno
        Dim Url As String = "../DataAnalisiBi/"

        Select Case objAnalisiBs.Flag_TipoAnalisi

            Case enum_GIS_TipoAnalisiBs.AnalisiModelli
                Url &= "Meteo/DSS_Difesa.aspx?"

            Case enum_GIS_TipoAnalisiBs.AnalisiRilievi
                Url &= "AnalisiRilievi/AnalisiRilievi.aspx?"

            Case enum_GIS_TipoAnalisiBs.AnalisiMeteo
                Url &= "Meteo/Meteo.aspx?"

        End Select

        Url &= "&lat=" & objAnalisiBs.Latitudine & "&lng=" & objAnalisiBs.Longitudine & "&veg_Cod=" & Veg_Cod.ToString


        If objAnalisiBs.Flag_TipoAnalisi = enum_GIS_TipoAnalisiBs.AnalisiMeteo Or
            objAnalisiBs.Flag_TipoAnalisi = enum_GIS_TipoAnalisiBs.AnalisiModelli Then

            Url &= "&ViewModal=" & objAnalisiBs.View_Modal.ToString()

        End If

        r.RispostaOK = True
        r.RispostaStringa.Url = Url

        Return r

    End Function

