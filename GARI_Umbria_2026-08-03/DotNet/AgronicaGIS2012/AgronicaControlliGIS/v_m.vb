    Public Shared Function CaricaDatiPrecisionXmlDaAllegati(Codici As String, TipoCodici As Integer, objParametri_Server As AgronicaCoreParametri) As rispostaStandard(Of AgronicaCoreModello.PrecisionModel_CFGLetturaDati)


        'BOOKMARK: Precision: caricamento oggetto per filtri
        Dim rval As New rispostaStandard(Of AgronicaCoreModello.PrecisionModel_CFGLetturaDati)

        Try



            rval.RispostaStringa = New AgronicaCoreModello.PrecisionModel_CFGLetturaDati
            rval.RispostaOK = True

            Dim listCodici As List(Of Integer) =
                Codici.Split(",").[Select](AddressOf Integer.Parse).ToList()

            If TipoCodici = 1 Then

                Dim xLetturaTipoRicetta As New AgronicaCoreContabDAL.Ricette_Operazioni_R
                Dim dRic As DataTable = xLetturaTipoRicetta.Leggi(
                0,
                listCodici.First,
