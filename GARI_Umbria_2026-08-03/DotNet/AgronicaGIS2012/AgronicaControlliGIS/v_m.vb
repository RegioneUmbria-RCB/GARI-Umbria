        If Not String.IsNullOrEmpty(riga("CodiceParticella")) Then
            stb.Append(AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_Codice) & ": <span style='font-weight: bold'>" & riga("CodiceParticella") & "</span>")
        End If

        stb.Append("<br />")
    End Sub

    Private Shared Function GetInfoGeneraliRipartoLog(ByVal dtDetLog As DataTable, ByVal objParametri_Utenti As AgronicaCoreParametri) As String

        Dim rval As New StringBuilder

        Dim letturaUtente As New AgronicaCoreUtentiDAL.Utenti_Dettagli_R
        Dim dtUtente As DataTable

        Dim flgRigaLog As Boolean = False

        For Each riga As DataRow In dtDetLog.Rows

            flgRigaLog = True

            Dim descrizioneTipoOperazione As String = ""
            Dim ParametriSalvataggio As String = ""

            If riga("CfgSalvataggio").ToString <> "" Then
                Dim CfgSalvataggio1 As v_m_RipartoCatastoCfgSalvataggio =
                    JsonConvert.DeserializeObject(Of v_m_RipartoCatastoCfgSalvataggio)(riga("CfgSalvataggio").ToString)

                ParametriSalvataggio = AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_Proposto)
                If CfgSalvataggio1.GlobalSalvaSelezione Then
                    ParametriSalvataggio = "<span style='font-weight: bold'>" & AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_Effettivo) & "</span>"
                End If

            End If

            Select Case riga("Operazione_DB")
                Case enum_TipoOperazioneDB.Scrittura
                    descrizioneTipoOperazione = AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_GetInfoGeneraliRipartoLog_Nuovo_Riparto)
                Case enum_TipoOperazioneDB.Modifica
                    descrizioneTipoOperazione = AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_GetInfoGeneraliRipartoLog_Modifica_Riparto)
