    Public Shared Function GestioneOpAgendaBS(ByVal lav_cod As String, ByVal ChiaveAlbero As String, ByVal lat As String, ByVal lng As String, ByVal idAgenda As String, ByVal ParamTipoOperazioneDB As Integer) As RispostaStandard
        Dim r As New RispostaStandard

        Dim objParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        Dim objParametri_Utenti As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Utenti")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            r.Sessione = False
            Return r
        End If

        Lingua.Gias_InizializzaCultura_DaSession()


        Try

            'HttpContext.Current.Session.Remove("ParametriAgenda")
            Dim objOpAgenda2010 As New ParametriAgenda

            objOpAgenda2010.Svuota_DatiOperazione()

            Dim objLink As New AgronicaCoreModello.Utility_Operazioni
            Dim Url As String = ""






            Dim StrVariabiliFiltro As String
            Dim Veg_Cod As Integer
            Dim Piva As String
            Dim lShouldReturn As Boolean

            Dim id_agenda As Integer = 0
            Dim sa_cod As Integer = 0

            Dim xLetturaDAtiAgenda As New AgronicaCoreContabDAL.Agenda_R
            Dim xLetturaDatiDestinazioni As New AgronicaCoreContabDAL.Mov_Destinazioni_R

            'si suppone che la funzione sia chiamata con una chiave albero quando viene richiesta una nuova operazione di agenda
            ' altrimenti devo recuperare da database le informazioni in base ad id_agenda
            If ChiaveAlbero <> "" And idAgenda = 0 Then
                Dim vetChiaveAlbero As String() = ChiaveAlbero.Split(SeparatoreAlberoJson)
                id_agenda = vetChiaveAlbero(25)
                sa_cod = vetChiaveAlbero(2)
                Dim lResult As String = Gestione_RicettaAgendaxml(ChiaveAlbero, objParametri_Server, StrVariabiliFiltro, Veg_Cod, 0, Piva, objOpAgenda2010.Impianti, lShouldReturn, id_agenda)

            Else

                Dim dtInfo As DataTable =
                    xLetturaDAtiAgenda.Leggi("", 0, idAgenda, 0, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)

                sa_cod = dtInfo(0)("sa_cod")
                Piva = dtInfo(0)("piva")
                lav_cod = dtInfo(0)("lav_cod")

                Dim dtVegCod As DataTable =
                    xLetturaDatiDestinazioni.VegCod_From_Agenda(Piva, idAgenda, "", "", objParametri_Server)
                If dtVegCod.Rows.Count > 0 Then
                    Veg_Cod = dtVegCod(0)("veg_cod")
                Else
                    Veg_Cod = 0
                End If

            End If

            Url = objLink.LinkPagina_from_LavCod(CInt(lav_cod), objOpAgenda2010, enum_PagineAgenda_2010.Gis)

            If idAgenda <> "-1" Then

                id_agenda = idAgenda
                If id_agenda <> 0 AndAlso lav_cod = 0 Then

                    lav_cod = xLetturaDAtiAgenda.Lav_Cod_From_Id_Agenda(id_agenda, objParametri_Server)
                    Url = objLink.LinkPagina_from_LavCod(CInt(lav_cod))

                End If

            End If

            If Not GestioneOpAgendaBSVerificaDiponibilitaOp(0, Url) Then
                r.RispostaOK = False
                r.Errore = My.Resources.AgronicaControlliGIS.V_M_GestioneOpAgendaBS_Operazione_non_disponibile_in_modalità_GIS
                Return r
            End If

            Dim tipoOperazioneDB As enum_TipoOperazioneDB = enum_TipoOperazioneDB.Scrittura

            If id_agenda <> 0 Then
                tipoOperazioneDB = enum_TipoOperazioneDB.Modifica
            End If

            'se passato uso quanto passato
            If ParamTipoOperazioneDB > -1 Then
                tipoOperazioneDB = ParamTipoOperazioneDB
            End If

            Dim letturaRagSoc As New AgronicaCoreAnagrafeDAL.Imprese_Read
            Dim RagSocLetta As String =
                letturaRagSoc.RagSoc_from_Piva(Piva, objParametri_Server)


            Dim cfg As New AgronicaCoreVarieDAL.Configurazione_Siti_R

            Dim fito As String = cfg.Leggi_Valore(0, "GiasOnline_WS_Fitofarmaci_AgroWS_Fitofarmaci", "", "", objParametri_Server)
            Dim disciplinari As String = cfg.Leggi_Valore(0, "GiasOnline_WS_Disciplinari_AgroWS_Disciplinari", "", "", objParametri_Server)

            objOpAgenda2010.Id_Agenda = id_agenda
            objOpAgenda2010.Piva = Piva
            objOpAgenda2010.RagSoc = RagSocLetta
            objOpAgenda2010.Tipo_Operazione = tipoOperazioneDB
            objOpAgenda2010.Sa_Cod = sa_cod
            objOpAgenda2010.Veg_Cod = Veg_Cod
            objOpAgenda2010.Cul_Cod = 0
            objOpAgenda2010.Data = Now.Date
            objOpAgenda2010.Lav_Cod = lav_cod
            objOpAgenda2010.WS_Fitofarmaci_AgroWS_Fitofarmaci = fito
            objOpAgenda2010.WS_Disciplinari_AgroWS_Disciplinari = disciplinari
            objOpAgenda2010.PaginaSitoOrigine = enum_PagineAgenda_2010.Gis

            If lat <> "" Then
                If objOpAgenda2010.Impianti.Count = 1 Then
                    objOpAgenda2010.Impianti.First.GisWkt = "POINT (" & lng & " " & lat & ")"
                    objOpAgenda2010.Impianti.First.GisWktGps = "1"
                    objOpAgenda2010.Impianti.First.GisWktSistemaRiferimento = "-1"
                    objOpAgenda2010.Impianti.First.GisLayerCod = enum_Gis_LayerElementiGrafici_std.AGENDA_RILIEVI
                    objOpAgenda2010.Impianti.First.GisTipoEntita_cod = enum_GIS2012_TipoEntita.Destinazione_Agenda

                Else
                    'TODO: nel caso di più impianti selezionati il punto GPS va assegnato all'impianto in cui ci si trova
                    '(o stabilire migliore strategia)


                End If
            End If

            'Controllo blocchi se non sono in modifica
            If tipoOperazioneDB <> enum_TipoOperazioneDB.Lettura Then
                Try
                    Dim matrice_delete(,) As String
                    If AgronicaCoreModello.OperazioneAgenda_Temp.ControllaOperazione(matrice_delete, objOpAgenda2010, objParametri_Server, "", False, objParametri_Utenti:=objParametri_Utenti) Then
                    End If
                Catch ex As Exception
                    r.RispostaOK = False
                    r.Errore = ex.Message
                    Return r
                End Try
            End If

            objOpAgenda2010.salva()

            r.RispostaOK = True
            r.RispostaStringa = Url & "?gis=true&lat=" & lat & "&lng=" & lng


        Catch ex As Exception

            r.RispostaOK = False
            r.Errore = "Errore durante l'operazione: " & AgronicaCoreUtility.Gestione_Eccezioni.MessaggioCompletoDataEccezione(ex, False)

        End Try

        Return r
    End Function

    Public Shared Function GestioneOpAgenda(ByVal lav_cod As String, ByVal ChiaveAlbero As String) As String

        'todo: session
        Lingua.Gias_InizializzaCultura_DaSession()

        Dim ObjParametri_Server As AgronicaCoreParametri = HttpContext.Current.Session("ASG_objParametri_Server")
        Dim lShouldReturn As Boolean
        Dim StrVariabiliFiltro As String
        Dim Veg_Cod As Integer
        Dim Piva As String

        Dim id_agenda As Integer = ChiaveAlbero.Split(SeparatoreAlberoJson)(25)
        Dim idleListOfImpianto As List(Of Impianto)

        Dim lResult As String = Gestione_RicettaAgendaxml(ChiaveAlbero, ObjParametri_Server, StrVariabiliFiltro, Veg_Cod, 0, Piva, idleListOfImpianto, lShouldReturn, id_agenda)
        If lShouldReturn Then
            Return lResult
        End If

        Dim objOpAgenda2010 As New AgronicaCoreGestioneRichieste.ParametriAgenda_2010
        If Not HttpContext.Current.Session("objOpAgenda_2010PerRitorno") Is Nothing Then
            objOpAgenda2010 = CType(HttpContext.Current.Session("objOpAgenda_2010PerRitorno"), AgronicaCoreGestioneRichieste.ParametriAgenda_2010)
        End If
        ''inizializzo l'oggetto con le altre informazioni


        Dim Sa_Cod As Integer = ChiaveAlbero.Split(SeparatoreAlberoJson)(2)


        Dim lEnum_TipoOperazioneDBScrittura As enum_TipoOperazioneDB
        If id_agenda = 0 Then
            lEnum_TipoOperazioneDBScrittura = enum_TipoOperazioneDB.Scrittura
        Else

            Dim leggiAg As New AgronicaCoreContabDAL.Agenda_R
            Dim dt As DataTable =
                leggiAg.Leggi(Piva, Sa_Cod, id_agenda, 0, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", ObjParametri_Server)
            lav_cod = dt.Rows(0)("lav_cod")
            If dt.Rows(0)("blocco_flag") <> 0 Then
                lEnum_TipoOperazioneDBScrittura = enum_TipoOperazioneDB.Lettura
            Else

                lEnum_TipoOperazioneDBScrittura = enum_TipoOperazioneDB.Modifica
            End If

        End If


        objOpAgenda2010.Id_Agenda = id_agenda
        objOpAgenda2010.Piva = Piva
        objOpAgenda2010.Sa_Cod = Sa_Cod
        objOpAgenda2010.Veg_Cod = Veg_Cod
        objOpAgenda2010.Cul_Cod = 0
        objOpAgenda2010.PaginaRichiesta = getPaginaFromLavCod(lav_cod)

        objOpAgenda2010.Operazione = lEnum_TipoOperazioneDBScrittura
        objOpAgenda2010.Lavorazione = lav_cod
        objOpAgenda2010.DataSelezionata = Now.Date
        objOpAgenda2010.StrVariabiliOpAgenda = StrVariabiliFiltro


        Return AgronicaCoreGestioneRichieste.RedirectGestione.IndirizzoCompleto_SitoAgenda_PassandoDirettamente_ParametriAgenda_2010(Enum_SiteRedirector.Sito_AgronicaAgenda_2010, objOpAgenda2010)


    End Function

