            '            chiaveAlberoProgrammazione, 0,
            '            Piva:=piva,
            '            Sa_Cod:=sa_cod
            '        )
            'End If


            Albero.ChiaveAlbero_Codifica_x_json(
                        chiaveAlberoProgrammazione, 0,
                        Piva:=piva,
                        Sa_Cod:=sa_cod
                    )

            If CInt(AggregaGrafica >= 0) Then

