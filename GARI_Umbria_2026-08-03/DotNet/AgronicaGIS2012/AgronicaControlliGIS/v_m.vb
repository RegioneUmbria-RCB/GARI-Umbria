                obj_Return_GetProp.Indirizzo = dt.Rows(0).Item("via_stringa")
                obj_Return_GetProp.Validita_Inizio = dt.Rows(0).Item("Validita_Inizio")
                obj_Return_GetProp.Validita_Fine = dt.Rows(0).Item("Validita_Fine")
                obj_Return_GetProp.Flag_GPS = dt.Rows(0).Item("Flag_GPS")
                obj_Return_GetProp.Progetto_Nome = dt.Rows(0).Item("Progetto_Nome")

                obj_Return_GetProp.GiasPalm = New GiasPalm With {
                    .Descrizione = dt.Rows(0).Item("GiasPalm"),
                    .Piva = dt.Rows(0).Item("GiasPalm_piva"),
                    .Sa_Cod = dt.Rows(0).Item("GiasPalm_sa_cod"),
                    .Id = dt.Rows(0).Item("GiasPalm_id")
                }

            Case 2
                Select Case dt.Rows(0)("TipoEntita_Cod")

                    Case enum_GIS2012_TipoEntita.Dettaglio_Ricetta
                        obj_Return_GetProp.Tipo_EntitaCod = enum_GIS2012_TipoEntita.Dettaglio_Ricetta

                        obj_Return_GetProp.Cul_Cod = dt.Rows(0).Item("cul_cod")
                        obj_Return_GetProp.Cul_Des = ""
                        obj_Return_GetProp.Veg_Des = ""
                        obj_Return_GetProp.Flag_GPS = dt.Rows(0).Item("Flag_GPS")
                        obj_Return_GetProp.Indirizzo = dt.Rows(0).Item("ElementoGrafico_Des")

                        obj_Return_GetProp.GiasPalm = New GiasPalm With {
                            .Descrizione = dt.Rows(0).Item("GiasPalm"),
                            .Piva = dt.Rows(0).Item("GiasPalm_piva"),
                            .Sa_Cod = dt.Rows(0).Item("GiasPalm_sa_cod"),
                            .Id = dt.Rows(0).Item("GiasPalm_id")
                        }

                    Case enum_GIS2012_TipoEntita.CATASTO
                        obj_Return_GetProp.Tipo_EntitaCod = enum_GIS2012_TipoEntita.CATASTO

                        obj_Return_GetProp.Cul_Cod = dt.Rows(0).Item("cul_cod")
                        obj_Return_GetProp.Cul_Des = ""
                        obj_Return_GetProp.Veg_Des = ""
                        obj_Return_GetProp.Superficie = dt.Rows(0).Item("Superficie")
                        obj_Return_GetProp.Flag_GPS = dt.Rows(0).Item("Flag_GPS")
                        obj_Return_GetProp.Rag_Soc = ""
                        obj_Return_GetProp.Sa_Nome = ""
                        obj_Return_GetProp.Indirizzo = dt.Rows(0).Item("ElementoGrafico_Des")
                        obj_Return_GetProp.Grfi_Cod = ""
                        obj_Return_GetProp.Grfi_Des = ""
                        obj_Return_GetProp.Grva_Cod = ""
                        obj_Return_GetProp.Grva_Des = ""
                        obj_Return_GetProp.Codice_Fiscale_Tecnico = dt.Rows(0).Item("Codice_fiscale_tecnico")
                        obj_Return_GetProp.Validita_Inizio = dt.Rows(0).Item("Validita_Inizio")
                        obj_Return_GetProp.Validita_Fine = dt.Rows(0).Item("Validita_Fine")
                        obj_Return_GetProp.Progetto_Nome = dt.Rows(0).Item("Progetto_Nome")

                        obj_Return_GetProp.GiasPalm = New GiasPalm With {
                            .Descrizione = dt.Rows(0).Item("GiasPalm"),
                            .Piva = dt.Rows(0).Item("GiasPalm_piva"),
                            .Sa_Cod = dt.Rows(0).Item("GiasPalm_sa_cod"),
                            .Id = dt.Rows(0).Item("GiasPalm_id")
                        }

                        'Nel caso di aggiunta di questa parte, aggiungere prima i campi alla classe GetProprieta_Out
                        'strB.Append("""ind_des"" : """ & dt.Rows(0).Item("ElementoGrafico_Des") & """ ,  ")
                        'strB.Append("""frazione"" : """" ,  ")
                        'strB.Append("""cap"" : """" ,  ")
                        'strB.Append("""comune"" : """" ,  ")
                        'strB.Append("""provincia"" : """" ,  ")
                        'strB.Append("""sigla_prov"" : """" ,  ")
                        'strB.Append("""stato"" : """" ,  ")
                        'strB.Append("""regione"" : """" ,  ")

                        'Al momento nel campo Extra_Info viene aggiunta una tabella HTML come String
                        Dim datiParticellaStilePF As String = V_M.DatiCatastoAggiuntivi(CType(Entita_Cod, Integer),
                                                                                        """",
                                                                                        objParametri_Server,
                                                                                        objParametri_Utenti)

                        If Not String.IsNullOrEmpty(datiParticellaStilePF) Then
                            datiParticellaStilePF = V_M.DatiPf2(datiParticellaStilePF, "")
                        End If

                        obj_Return_GetProp.Extra_Info = datiParticellaStilePF

                    Case Else
                        Dim vegcod As Integer
                        Dim vegdes As String = ""
                        Dim culdes As String = ""

                        Dim o As New AgronicaCoreMetaSchemaDAL.Cultivar_R()

                        If dt.Rows(0).Item("cul_cod") = 0 Then
                            vegdes = ""
                            culdes = ""

                        Else
                            o.VegCod_VegDes_CulDes_from_CulCod(dt.Rows(0).Item("cul_cod"),
                                                               vegcod,
                                                               vegdes,
                                                               culdes,
                                                               objParametri_Server)

                        End If

                        'Dim o2 As AgronicaCoreAnagrafeDAL.CentriAziendali_Read = New AgronicaCoreAnagrafeDAL.CentriAziendali_Read()
                        'Dim centro As String = o2.SaNome_from_SaCod(dt.Rows(0).Item("piva"), dt.Rows(0).Item("sa_cod"), objParamentri_server)

                        Dim ragsoc As String = ""
                        Dim sanome2 As String = ""

                        Dim Codice_Fiscale_Tecnico As String = ""
                        Dim xUtenteCorrente As String = objParametri_Server.UtenteUsername
                        Dim objUtentiDAL As New AgronicaCoreUtentiDAL.Utenti_xGruppi_Utente_R
                        Codice_Fiscale_Tecnico = objUtentiDAL.Leggi_IdentificativoGruppoUtenti_Singolo(xUtenteCorrente,
                                                                                                       objParametri_Utenti)

                        Dim cfgSitiLeggi As New AgronicaCoreVarieDAL.Configurazione_Siti_R
                        Dim filtroCfTec As String = cfgSitiLeggi.Leggi_Valore(0,
                                                                              "GIS_EscludiFiltroCodiceFiscaleTecnico",
                                                                              "",
                                                                              "",
                                                                              objParametri_Server)

                        Dim sBioConversione As String = ""

                        Dim appezza1 As Integer = dt.Rows(0).Item("appezza")
                        Dim sa_Cod1 As Integer = dt.Rows(0).Item("sa_cod")
                        Dim piva1 As String = dt.Rows(0).Item("piva")

                        Dim programmazione_entita_cod1 As Integer = dt.Rows(0)("programmazione_entita_cod")

                        V_M.LeggiInfoBioConversione(objParametri_Server,
                                                    sBioConversione,
                                                    appezza1,
                                                    sa_Cod1,
                                                    piva1,
                                                    programmazione_entita_cod1)

                        'controllo se posso vedere la rag_soc o no
                        If dt.Rows(0).Item("Codice_fiscale_tecnico") = Codice_Fiscale_Tecnico Or filtroCfTec = "" Or filtroCfTec.ToLower = "true" Then
                            Dim o2 As New AgronicaCoreAnagrafeDAL.CentriAziendali_Read()
                            Dim o3 As New AgronicaCoreAnagrafeDAL.Imprese_Read

                            sanome2 = o2.SaNome_from_SaCod(dt.Rows(0).Item("piva"),
                                                           CInt(dt.Rows(0).Item("sa_cod")),
                                                           objParametri_Server)

                            ragsoc = o3.RagSoc_from_Piva(dt.Rows(0).Item("piva"),
                                                         objParametri_Server)

                        End If

                        Dim regione As String = ""
                        Dim grfi_des As String
                        Dim o4 As New AgronicaCoreMetaSchemaDAL.GruppoFinalita_R
                        Dim lGrfi_cod As Integer = dt.Rows(0).Item("Grfi_Cod")

                        If vegcod = 0 And lGrfi_cod = 0 Then
                            grfi_des = ""

                        Else
                            grfi_des = o4.GrfiDes_from_GrfiCod(lGrfi_cod,
                                                               vegcod,
                                                               objParametri_Server)
                        End If

                        Dim grva_Des As String
                        Dim o5 As New AgronicaCoreMetaSchemaDAL.GruppoVarietale_R
                        Dim lGrva_cod As Integer = dt.Rows(0).Item("grva_cod")

                        If vegcod <> 0 And lGrva_cod <> 0 Then
                            grva_Des = o5.Grva_Des_From_Grva_Cod_xSementi(vegcod,
                                                                          lGrva_cod,
                                                                          objParametri_Server)
                        Else
                            grva_Des = ""

                        End If

                        Dim o6 As New AgronicaCoreMetaSchemaDAL.Lista_Regioni_R
                        regione = o6.RegioneDes_from_REG(regione,
                                                         objParametri_Server)

                        obj_Return_GetProp.App_Nome = dt.Rows(0).Item("app_nome") & sBioConversione
                        obj_Return_GetProp.Cul_Cod = dt.Rows(0).Item("cul_cod")
                        obj_Return_GetProp.Cul_Des = culdes
                        obj_Return_GetProp.Veg_Des = vegdes
                        obj_Return_GetProp.Destinazione_Uso = dt.Rows(0).Item("destinazione_uso")
                        obj_Return_GetProp.Superficie = dt.Rows(0).Item("Superficie")
                        obj_Return_GetProp.Flag_GPS = dt.Rows(0).Item("Flag_GPS")
                        obj_Return_GetProp.Rag_Soc = ragsoc
                        obj_Return_GetProp.Sa_Nome = sanome2
                        obj_Return_GetProp.Indirizzo = dt.Rows(0).Item("via_stringa")
                        obj_Return_GetProp.Grfi_Cod = dt.Rows(0).Item("Grfi_Cod")
                        obj_Return_GetProp.Grfi_Des = grfi_des
                        obj_Return_GetProp.Grva_Cod = dt.Rows(0).Item("GRVA_Cod")
                        obj_Return_GetProp.Grva_Des = grva_Des
                        obj_Return_GetProp.Codice_Fiscale_Tecnico = dt.Rows(0).Item("Codice_fiscale_tecnico")
                        obj_Return_GetProp.Validita_Inizio = dt.Rows(0).Item("Validita_Inizio")
                        obj_Return_GetProp.Validita_Fine = dt.Rows(0).Item("Validita_Fine")
                        obj_Return_GetProp.Appezza_Validita_Inizio = dt.Rows(0).Item("Appezzamento_Validita_Inizio")
                        obj_Return_GetProp.Appezza_Validita_Fine = dt.Rows(0).Item("Appezzamento_Validita_Fine")
                        obj_Return_GetProp.Progetto_Nome = dt.Rows(0).Item("Progetto_Nome")

                        obj_Return_GetProp.GiasPalm = New GiasPalm With {
                            .Descrizione = dt.Rows(0).Item("GiasPalm"),
                            .Piva = dt.Rows(0).Item("GiasPalm_piva"),
                            .Sa_Cod = dt.Rows(0).Item("GiasPalm_sa_cod"),
                            .Id = dt.Rows(0).Item("GiasPalm_id")
                        }

                        'Nel caso di aggiunta di questa parte, aggiungere prima i campi alla classe GetProprieta_Out
                        'strB.Append("""ind_des"" : """ & inddes & """ ,  ")
                        'strB.Append("""frazione"" : """ & frzdes & """ ,  ")
                        'strB.Append("""cap"" : """ & CAP & """ ,  ")
                        'strB.Append("""comune"" : """ & Comune & """ ,  ")
                        'strB.Append("""provincia"" : """ & Provincia & """ ,  ")
                        'strB.Append("""sigla_prov"" : """ & Sigla_Prov & """ ,  ")
                        'strB.Append("""stato"" : """ & Stato & """ ,  ")
                        'strB.Append("""regione"" : """ & regione & """ ,  ")

                        If dt.Rows(0)("TipoEntita_Cod") = enum_GIS2012_TipoEntita.APPEZZAMENTI Then
                            'Al momento nel campo Extra_Info viene aggiunta una tabella HTML come String
                            Dim datiConduzioneStilePF As String = V_M.DatiAppezzamentoAggiuntivi(CType(Entita_Cod, Integer),
                                                                                                 """",
                                                                                                 objParametri_Server,
                                                                                                 objParametri_Utenti)

                            If Not String.IsNullOrEmpty(datiConduzioneStilePF) Then
                                datiConduzioneStilePF = V_M.DatiPf2(datiConduzioneStilePF, "")
                            End If

                            obj_Return_GetProp.Extra_Info = datiConduzioneStilePF

                        Else
                            obj_Return_GetProp.Extra_Info = V_M.DatiPf2_Translated(dt.Rows(0).Item("ElementoGrafico_Des"),
                                                                                dt.Rows(0).Item("LayerElementiGrafici_Cod"),
                                                                        """",
                                                                                   objParametri_Server)

                        End If
                End Select
        End Select

        r.RispostaOK = True
        r.RispostaStringa = obj_Return_GetProp

        Return r

    End Function

