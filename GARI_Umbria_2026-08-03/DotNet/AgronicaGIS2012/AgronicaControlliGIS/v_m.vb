    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' Altra versione di getCoord, ma al posto di una stringa ritorna un array
    ''' </summary>
    ''' <param name="ns"></param>
    ''' <param name="elemento"></param>
    ''' <returns></returns>
    Private Shared Function getCoord2(ByVal ns As XNamespace,
                                      ByVal elemento As XElement) As List(Of AgronicaCoreModelsSTD.Gis.Coordinate)
        Dim str As String() = GML.DammiArrayCoordinateDatoXml(ns, elemento.<geodata>.FirstOrDefault)

        Dim strVertici As New List(Of AgronicaCoreModelsSTD.Gis.Coordinate)
        Dim i As Integer

        Dim lContaVertici As Integer

        If CType(elemento.<geodata>.FirstOrDefault.DescendantNodes.FirstOrDefault, XElement).Name.ToString.ToLower.Contains("linestring") Then
            lContaVertici = 1

        Else
            lContaVertici = 4

            If str.Count <= 4 Then
                lContaVertici = 1

            End If
        End If

        For i = 0 To str.Count - lContaVertici
            Dim coords As New AgronicaCoreModelsSTD.Gis.Coordinate
            coords.Lat = str(i)
            i += 1
            coords.Long = str(i)

            strVertici.Add(coords)

        Next

        Return strVertici

    End Function

