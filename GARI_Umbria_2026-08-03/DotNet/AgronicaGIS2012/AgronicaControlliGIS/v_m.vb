                            'codice_specie,
                            'codice_destinazione_uso,
                            'InData.id_imp,
                            '"",
                            '"",
                            '"-1",
                            '-1,
                            '-1,
                            '"-1",
                            '0,
                            '0,
                            '0,
                            '0,
                            'lAggiungiLayer_Imprese,
                            'True,
                            'False,
                            'True,
                            'SementiSportelloCod,
                            'Codice_Fiscale_Tecnico,
                            'InData.wktBoundaySTIntersects,
                            'cfgAlbero,
                            'xFiltroAggiuntivo,
                            'objParametri_Server,
                            'objParametri_Utenti,
                            'filtroTemporaleAvanzato:=filtroTemporaleAvanzato,
                            'layerElementiGrafici_cod:=layerCorrenteList,
                            'LayersVisibili:=LayersVisibili
                            ')

                            'Dim geoJsonOriginaleLayer = GetPlaceGeoJSONFromDataTable(
                            '    objParametri_Server.PivaSuperUser,
                            '    dt,
                            '    ns,
                            '    CInt(InData.TipologiaLayerSelezionata),
                            '    layerCorrenteList,
                            '    cfgAlbero,
                            '    InData.piva,
                            '    SementiSportelloCod,
                            '    Codice_Fiscale_Tecnico
                            '    objParametri_Server,
                            '    objParametri_Utenti
                            ')

                            Dim geoJsonOriginaleLayer = V_M.GetGeoJsonResult(InData,
                                        cfgAlbero,
                                        ns,
                                        layerCorrenteList,
                                        Codice_Fiscale_Tecnico,
                                        codice_specie,
                                        codice_destinazione_uso,
                                        lAggiungiLayer_Imprese,
                                        SementiSportelloCod,
                                        xFiltroAggiuntivo,
                                        filtroTemporaleAvanzato,
                                        LayersVisibili,
                                        objParametri_Super_Server,
                                        objParametri_Server,
                                        objParametri_Utenti
                                        )

                            ' Aggiunge le "feature" di questo layer al risultato finale.
                            If geoJsonOriginaleLayer.geoJsonCaricato.features IsNot Nothing Then
                                geoJsonFinale.geoJsonCaricato.features.AddRange(geoJsonOriginaleLayer.geoJsonCaricato.features)
                            End If

                        End If

                    Else

                        ' Se il clustering non è attivo per questo layer, eseguiamo la lettura orginale completa.

                        'Dim dt = objEntitaBiz.LeggiPerGerarchiaImprese(
                        'objParametri_Server.PivaSuperUser,
                        'Codice_Fiscale_Tecnico,
                        '0,
                        '0,
                        'InData.piva,
                        'InData.sa_cod,
                        'InData.appezza,
                        'InData.campo_cod,
                        'codice_specie,
                        'codice_destinazione_uso,
                        'InData.id_imp,
                        '"",
                        '"",
                        '"-1",
                        '-1,
                        '-1,
                        '"-1",
                        '0,
                        '0,
                        '0,
                        '0,
                        'lAggiungiLayer_Imprese,
                        'True,
                        'False,
                        'True,
                        'SementiSportelloCod,
