    'Utility cancellazione

    Private Shared Sub GestisciEsitoRispostaCancella(objDati As DatiCancella,
                                                     risposta As rispostaStandard(Of Cancella_Out),
                                                     Optional msgErrore As String = Nothing)

        risposta.RispostaOK = (risposta.RispostaOK AndAlso objDati.EsitoRispostaOK)

        If objDati.EsitoRispostaOK Then

            risposta.RispostaStringa.Lista_MessaggiEsito.Add(objDati.StringaRisposta)

        Else

            If String.IsNullOrEmpty(msgErrore) Then
                risposta.RispostaStringa.MessaggioEsito = objDati.StringaRisposta
            Else
                risposta.RispostaStringa.MessaggioEsito = msgErrore
            End If

            Throw New GiasException(risposta.RispostaStringa.MessaggioEsito)

        End If

    End Sub

    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="lista_Entita_Cod"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="objParametri_Utenti"></param>
    ''' <returns></returns>
    Public Shared Function CancellaEntitaGrafiche_2022(ByVal lista_Entita_Cod As List(Of String),
                                                       ByRef objParametri_Server As AgronicaCoreParametri,
                                                       ByRef objParametri_Utenti As AgronicaCoreParametri) As rispostaStandard(Of Cancella_EntitaGraf_Out)
        Dim r As New rispostaStandard(Of Cancella_EntitaGraf_Out) With {
            .RispostaStringa = New Cancella_EntitaGraf_Out
        }

        Dim obj_Cancella As New Cancella_In With {
            .Elimina_Grafica = True,
            .Elimina_Impianto = False,
            .Elimina_PrecisionFarming = False,
            .Elimina_PrecisionFarmingABLine = False,
            .Elimina_DatoGiasPalm = False
        }

        Dim cntTrue As Integer = 0
        Dim cntFalse As Integer = 0

        For Each e In lista_Entita_Cod

            obj_Cancella.Entita_Cod = CType(e, Integer)
            Dim rispEntita As rispostaStandard(Of Cancella_Out) = Cancella_2022(obj_Cancella,
                                                                                objParametri_Server,
                                                                                objParametri_Utenti)

            If rispEntita.RispostaOK Then
                cntTrue += 1
            Else
                cntFalse += 1
            End If

        Next

        If cntTrue = 0 Then
            r.RispostaOK = False
            r.RispostaStringa.Eliminate = 0
            r.RispostaStringa.NonEliminate = 0
            r.RispostaStringa.Messaggio = "Operazione non eseguita correttamente"

        Else
            r.RispostaOK = True
            r.RispostaStringa.Eliminate = cntTrue
            r.RispostaStringa.NonEliminate = cntFalse
            r.RispostaStringa.Messaggio = "Entità eliminate: " & cntTrue

            If cntFalse <> 0 Then
                r.RispostaStringa.Messaggio &= ", Entità non eliminate " & cntFalse

            End If

        End If

        Return r

    End Function

    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="lista_HiddenPunti"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="objParametri_Utenti"></param>
    ''' <returns></returns>
    Public Shared Function CancellaMultipoint_2022(ByVal lista_HiddenPunti As List(Of String),
                                                   ByRef objParametri_Server As AgronicaCoreParametri,
                                                   ByRef objParametri_Utenti As AgronicaCoreParametri) As RispostaStandard
        Dim r As New RispostaStandard

        Dim obj_Cancella As New Cancella_In With {
            .Elimina_Grafica = True,
            .Elimina_Impianto = False,
            .Elimina_PrecisionFarming = False,
            .Elimina_PrecisionFarmingABLine = False,
            .Elimina_DatoGiasPalm = False
        }

        'ATTENZIONE: Questa funzione si comporta esattamente come CancellaEntitaGrafiche poichè richiama la funzione generale presente nel V_M
        'Cancella() (la versione senza Session) passandogli esattamente gli stessi params (cicla una Lista di Entita_Cod, il resto li inizializza uguale):
        'la differenza che si potrebbe aggiustare è tenerle separate poichè sul finale fanno diverse operazioni ma nei parametri passati utilizzare
        'semplicemente una Lista di Entita_Cod invece di uno stringone da Splittare

        Dim i As Integer = 0

        For Each hiddenPunti In lista_HiddenPunti

            Dim ChiaviValori_hiddenPunti As String() = hiddenPunti.Split("^")

            obj_Cancella.Entita_Cod = ChiaviValori_hiddenPunti(0).Split("|")(1)

            Cancella_2022(obj_Cancella,
                          objParametri_Server,
                          objParametri_Utenti)

            i += 1

        Next

        r.RispostaOK = True
        r.RispostaStringa = "Eliminati " & i & " elementi"

        Return r

    End Function

