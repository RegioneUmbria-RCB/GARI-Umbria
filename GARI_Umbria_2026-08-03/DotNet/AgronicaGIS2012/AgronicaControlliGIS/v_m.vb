                If rval Then

                    Dim rvalAGG As Boolean = AggregaElementiDateChiaveAlbero(listaEntita, chiaveAlberoProgrammazione, AggregaGrafica, Codice_Fiscale_Tecnico, Programmazione_Des, objParametri_Server, objParametri_Utenti)
