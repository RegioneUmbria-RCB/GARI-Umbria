                    'strB.Append("""stato"" : """ & Stato & """ ,  ")
                    'strB.Append("""regione"" : """ & regione & """ ,  ")
                    strB.Append("""indirizzo"" : """ & dt.Rows(0).Item("via_stringa") & """ ,  ")

                    strB.Append("""grfi_cod"" : """ & dt.Rows(0).Item("Grfi_Cod") & """ ,  ")
                    strB.Append("""grfi_des"" : """ & grfi_des & """ ,  ")

                    strB.Append("""grva_cod"" : """ & dt.Rows(0).Item("GRVA_Cod") & """ ,  ")
                    strB.Append("""grva_des"" : """ & grva_Des & """ ,  ")

                    strB.Append("""codice_fiscale_tecnico"" : """ & dt.Rows(0).Item("Codice_fiscale_tecnico") & """, ")
                    strB.Append("""Validita_Inizio"" : """ & dt.Rows(0).Item("Validita_Inizio") & """,   ")
                    strB.Append("""Validita_Fine"" : """ & dt.Rows(0).Item("Validita_Fine") & """,   ")
                    strB.Append("""Appezzamento_Validita_Inizio"" : """ & dt.Rows(0).Item("Appezzamento_Validita_Inizio") & """,   ")
                    strB.Append("""Appezzamento_Validita_Fine"" : """ & dt.Rows(0).Item("Appezzamento_Validita_Fine") & """,   ")
                    strB.Append("""Progetto_Nome"" : """ & dt.Rows(0).Item("Progetto_Nome") & """,   ")

                    GiasPalm(dt, strB)

                    If dt.Rows(0)("TipoEntita_Cod") = enum_GIS2012_TipoEntita.APPEZZAMENTI Then

                        Dim datiConduzioneStilePF As String =
                            DatiAppezzamentoAggiuntivi(Entita_Cod, """", objParametri_server, objParametri_utenti)

                        If Not String.IsNullOrEmpty(datiConduzioneStilePF) Then
