    Public Shared Function VerificaVicini_2022(ByVal obj_VerificaVicini As VerificaVicini_In,
                                               ByRef objParametri_Server As AgronicaCoreParametri,
                                               ByRef objParametri_Utenti As AgronicaCoreParametri) As rispostaStandard(Of VerificaVicini_Out)
        Dim r As New rispostaStandard(Of VerificaVicini_Out) With {
            .RispostaStringa = New VerificaVicini_Out
        }

        If Not String.IsNullOrEmpty(obj_VerificaVicini.Entita_Cod) Then
            Dim GISEntita As New AgronicaCoreGisDAL.GIS_Entita_R

            Dim DT As DataTable = GISEntita.LeggiDateSpecieDaEntitaCod(obj_VerificaVicini.Entita_Cod,
                                                                       objParametri_Server)

            If DT.Rows.Count < 1 Then
                r.RispostaStringa.Messaggio = ""

            Else
                Dim row = DT.Rows(0)

                obj_VerificaVicini.Veg_Cod = row("Veg_Cod")
                obj_VerificaVicini.Grva_Cod = row("GRVA_Cod_VEG")
                obj_VerificaVicini.Validita_Inizio = row("Validita_Inizio")
                obj_VerificaVicini.Validita_Fine = row("Validita_Fine")

                r = VerificaVicini(obj_VerificaVicini,
                                   objParametri_Server,
                                   objParametri_Utenti)

            End If

        Else
            r = VerificaVicini(obj_VerificaVicini,
                               objParametri_Server,
                               objParametri_Utenti)

        End If

        r.RispostaOK = True

        Return r

    End Function

    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="obj_InfoInterferenze"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <returns></returns>
    Public Shared Function InfoInterferenze_2022(ByVal obj_InfoInterferenze As InfoInterferenze_In,
                                                 ByRef objParametri_Server As AgronicaCoreParametri,
                                                 ByRef objParametri_Utenti As AgronicaCoreParametri) As rispostaStandard(Of List(Of Entita_Info_Out))
        Dim r As New rispostaStandard(Of List(Of Entita_Info_Out)) With {
            .RispostaStringa = New List(Of Entita_Info_Out)
        }

        'Solo se sono in fase di notifica???
        Dim sportello As New AgronicaCoreSementieriDAL.Sportello_R
        Dim fase As DataTable = sportello.LeggiFaseSportelloXSpecie(obj_InfoInterferenze.Veg_Cod,
                                                                    DateTime.Now(),
                                                                    objParametri_Server)

        If fase Is Nothing OrElse fase.Rows.Count = 0 Then

        ElseIf CInt(fase.Rows(0)("RichiediConfermaSuInterferenze")) <> 1 Then

        Else
            Dim dtInterferenze As DataTable = DtInterferenze_FromPoligono(obj_InfoInterferenze.Codice_Fiscale_Tecnico,
                                                                          obj_InfoInterferenze.Veg_Cod,
                                                                          obj_InfoInterferenze.Grva_Cod,
                                                                          obj_InfoInterferenze.Validita_Inizio,
                                                                          obj_InfoInterferenze.Validita_Fine,
                                                                          obj_InfoInterferenze.Sementi,
                                                                          obj_InfoInterferenze.SementiMappaturaLibera,
                                                                          1,
                                                                          False,
                                                                          0,
                                                                          obj_InfoInterferenze.HiddenPunti,
                                                                          objParametri_Server,
                                                                          objParametri_Utenti)

            Dim iEntitaCod As Integer = -1

            If Not String.IsNullOrEmpty(obj_InfoInterferenze.Entita_Cod) Then
                If Not Integer.TryParse(obj_InfoInterferenze.Entita_Cod, iEntitaCod) Then
                    iEntitaCod = -1

                End If
            End If

            If dtInterferenze Is Nothing OrElse dtInterferenze.Rows.Count = 0 Then

            Else
                For Each dr As DataRow In dtInterferenze.Rows

                    'Filtro per CodiceFiscaleTecnico... non ho bisogno di escludere l'entita_cod!!! 
                    If iEntitaCod <> dr("Entita_Cod") Then
                        Dim indirizzo As String = dr("Ind_des") _
                                                  & " " & dr("frz_des") _
                                                  & " - " & dr("cap") _
                                                  & " " & dr("citta") _
                                                  & " " & dr("provincia")

                        Dim dist As Decimal = dr("DistanzaEffettiva")
                        Dim distanza As String

                        If dist > 1000 Then
                            distanza = Agro_Math.ArrotondaVal_3(dist / 1000).ToString("0.000") & " km"

                        Else
                            distanza = Agro_Math.ArrotondaVal_0(dist).ToString() & " mt"

                        End If

                        Dim obj_Entita As New Entita_Info_Out With {
                            .Indirizzo = indirizzo,
                            .Referente = dr("Referente"),
                            .Distanza = distanza,
                            .Veg_Des = dr("veg_des"),
                            .Tipologia = dr("Tipologia")
                        }

                        r.RispostaStringa.Add(obj_Entita)

                    End If

                Next

            End If
        End If

        r.RispostaOK = True

        Return r

    End Function

    ''' <summary>
    ''' Cancella entità Gis - Versione 2022
    ''' </summary>
    ''' <param name="objCancella"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="objParametri_Utenti"></param>
    ''' <returns></returns>
    Public Shared Function Cancella_2022(ByVal objCancella As Cancella_In,
                                         ByRef objParametri_Server As AgronicaCoreParametri,
                                         ByRef objParametri_Utenti As AgronicaCoreParametri) As rispostaStandard(Of Cancella_Out)

        'Inizializzo risposta

        Dim risposta As New rispostaStandard(Of Cancella_Out) With {
            .RispostaStringa = New Cancella_Out
        }

        risposta.RispostaStringa.Lista_MessaggiEsito = New List(Of String)

        risposta.RispostaOK = True
        risposta.RispostaStringa.MessaggioEsito = "OK"

        'Inizializzazione dati

        Dim objDati = New DatiCancella

        Dim objImpianto As New AgronicaCoreAnagrafeBIZ.Appezzamento_Piccolo

        'Valorizzo il Codice_Fiscale_Tecnico prendendolo dalla tabella Gruppi_Utente

        Dim xUtenteCorrente As String = CType(objParametri_Server, AgronicaCoreParametri).UtenteUsername
        Dim objUtentiDAL As New Utenti_xGruppi_Utente_R

        objDati.Codice_Fiscale_Tecnico = objUtentiDAL.Leggi_IdentificativoGruppoUtenti_Singolo(xUtenteCorrente, objParametri_Utenti)

        Dim FlagTransazioneLocale As Boolean
        Dim FlagConnessioneLocale As Boolean

        Try

            'Verifico se aprire la transazione 

            Utility.VerificaApriTransazione(objParametri_Server, FlagConnessioneLocale, FlagTransazioneLocale)

            'Sementieri: conflitti e log

            Dim gp As New GisPurpose(objCancella.Sementi, objCancella.SementiMappaturaLibera)

            If objCancella.Elimina_Grafica = True AndAlso gp.Mode() = GisPurpose.enum_GisPurpose.SementiSportello Then

                CancellaConflittiConLogSementieri(objCancella, gp, objParametri_Server, objParametri_Utenti)

            End If

            Dim isSementieri = GetIsSementieri(objParametri_Server)

            'Lettura entità

            If isSementieri OrElse objCancella.Elimina_Impianto OrElse objCancella.Elimina_DatoGiasPalm Then
                GetEntitaGiasFromEntitaGrafica(objCancella.Entita_Cod,
                                               objDati.piva,
                                               objDati.sa_cod,
                                               objDati.appezza,
                                               objDati.id_reg,
                                               objDati.programmazione_entita_cod,
                                               objDati.programmazione_cod,
                                               objParametri_Server,
                                               objParametri_Utenti,
                                               objDati.Preventivo1_Consuntivo2,
                                               objDati.tipoentita_cod,
                                               0,
                                               0,
                                               0,
                                               objImpianto,
                                               objDati.idleLayerElementiGrafici_Cod,
                                               objDati.Codice_Fiscale_Tecnico)
            End If

            'Indica se eliminare anche l'appezzamento insieme all'impianto

            objDati.EliminaImpiantoConEliminaAppezzamento = (isSementieri And objCancella.Elimina_Dato_Anagrafica) Or SeEliminaAncheAppezzamento(objParametri_Server)

            'Cancella grafica

            If objCancella.Elimina_Grafica Then
                CancellaGrafica(objDati, objCancella, objParametri_Server, objParametri_Utenti, risposta)
            End If

            'Cancella impianto e, se previsto, appezzamento

            If objCancella.Elimina_Impianto Or isSementieri Then
                CancellaImpiantoAppezzamento(objDati, objCancella, objParametri_Server, objParametri_Utenti, risposta, objImpianto)
            End If

            'Cancella dati GiasPalm

            If objCancella.Elimina_DatoGiasPalm Then
                CancellaDatoGiasPalm(objDati, objCancella, objParametri_Server, risposta)
            End If

            'Cancella dati PrecisionFarming

            If objCancella.Elimina_PrecisionFarming Then
                CancellaPrecisionFarming(objDati, objCancella, objParametri_Server, risposta)
            End If

            If objCancella.Elimina_PrecisionFarmingABLine Then
                CancellaPrecisionFarmingABLine(objDati, objCancella, objParametri_Server, risposta)
            End If

            'Verifico se chiudere la transazione

            Utility.VerificaChiudiTransazione(objParametri_Server, FlagTransazioneLocale)

            'Al momento restituisce la lista di messaggi vuota; se si deciderà di ritornarli, basta rimuovere questa riga
            risposta.RispostaStringa.Lista_MessaggiEsito = Nothing

        Catch ex As GiasException

            Utility.VerificaAnnullaTransazione(objParametri_Server, FlagTransazioneLocale)
            risposta.RispostaOK = False
            risposta.RispostaStringa.MessaggioEsito = ex.Message
            Throw ex

        Catch ex As Exception

            Utility.VerificaAnnullaTransazione(objParametri_Server, FlagTransazioneLocale)
            risposta.RispostaOK = False
            risposta.RispostaStringa.MessaggioEsito = ex.Message

        Finally

            Utility.VerificaChiudiConnessione(objParametri_Server, FlagConnessioneLocale)

        End Try

        If risposta.RispostaOK Then
            risposta.RispostaStringa.MessaggioEsito = "OK"
        Else
            Throw New Exception(risposta.RispostaStringa.MessaggioEsito)
        End If

        Return risposta

    End Function

    Private Shared Sub CancellaConflittiConLogSementieri(objCancella As Cancella_In,
                                                         gp As GisPurpose,
                                                         objParametri_Server As AgronicaCoreParametri,
                                                         objParametri_Utenti As AgronicaCoreParametri)

        'Cancello eventuali conflitti

        Dim Interferenze As New Interferenze
        Interferenze.GeneraDescrizione_Casella_Conflitto(CType(objCancella.Entita_Cod, Integer),
                                                         objParametri_Server, objParametri_Utenti)

        'Log operazione

        LoggaOperazioneDB(objParametri_Server,
                          CType(objCancella.Entita_Cod, Integer),
                          3,
                          objCancella.DatiPassaggio,
                          gp.Sementi)

        'Metto in cache tutti i log relativi all'entità

        Dim leggiDati As New AgronicaCoreSementieriDAL.Sementieri_Sportello_LOG_R
        Dim dt As DataTable = leggiDati.Leggi(0,
                                              CType(objCancella.Entita_Cod, Integer),
                                              objParametri_Server, objParametri_Utenti)

        Dim aggiorna As New AgronicaCoreSementieriDAL.Sementieri_Sportello_LOG_W

        For Each riga As DataRow In dt.Rows

            aggiorna.ScriviInCache(CInt(riga("Sementieri_Sportello_LogOperazioni_COD")),
                                   0,
                                   riga,
                                   objParametri_Server)

        Next

    End Sub

    Private Shared Function SeEliminaAncheAppezzamento(objParametri_Server As AgronicaCoreParametri) As Boolean

        Dim letturaCfg As New Configurazione_Siti_R

        Dim cfgGisEliminaImpiantoEliminaAppezzamento As String = letturaCfg.Leggi_Valore(0,
                                                                                         "GisEliminazioneImpiantoEliminaAppezzamento",
                                                                                         "",
                                                                                         "",
                                                                                         objParametri_Server)

        Dim bGisEliminaImpiantoEliminaAppezzamento As Boolean = False

        If cfgGisEliminaImpiantoEliminaAppezzamento <> "" Then
            bGisEliminaImpiantoEliminaAppezzamento = CBool(cfgGisEliminaImpiantoEliminaAppezzamento)
        End If

        Return bGisEliminaImpiantoEliminaAppezzamento

    End Function

    Private Shared Function GetIsSementieri(objParametri_Server As AgronicaCoreParametri) As Boolean

        Dim letturaCfg As New Configurazione_Siti_R

        Dim result As Boolean = False

        Dim cfgIsSementieri As String = letturaCfg.Leggi_Valore(0,
                                                                CostantiPersonalizzate.Is_Sementieri,
                                                                "",
                                                                "",
                                                                objParametri_Server)


        If cfgIsSementieri <> "" Then
            result = CBool(cfgIsSementieri)
        End If

        Return result

    End Function

    Private Shared Sub CancellaGrafica(objDati As DatiCancella,
                                       objCancella As Cancella_In,
                                       objParametri_Server As AgronicaCoreParametri,
                                       objParametri_Utenti As AgronicaCoreParametri,
                                       risposta As rispostaStandard(Of Cancella_Out))

        Select Case objDati.tipoentita_cod

            Case enum_GIS2012_TipoEntita.APPEZZAMENTI

                If objCancella.Elimina_Impianto Then

                    CancellaGraficaAppezzamentoConFigli(objDati, objCancella, objParametri_Server, objParametri_Utenti, risposta)

                Else

                    CancellaSoloGrafica(objDati, objCancella, objParametri_Server, risposta)

                End If

            Case Else

                CancellaSoloGrafica(objDati, objCancella, objParametri_Server, risposta)

        End Select

    End Sub

    Private Shared Sub CancellaGraficaAppezzamentoConFigli(objDati As DatiCancella,
                                                           objCancella As Cancella_In,
                                                           objParametri_Server As AgronicaCoreParametri,
                                                           objParametri_Utenti As AgronicaCoreParametri,
                                                           risposta As rispostaStandard(Of Cancella_Out))

        'Se sto eliminando un appezzamento, comprensivo della parte di anagrafica, allora devo eliminare tutti gli elementi figli.
        'Se sono arrivato a questo punto ho la certezza di non avere elementi di agenda e ricette.

        Dim letturaElementiGisDaEliminare As New AgronicaCoreGisDAL.GIS_Entita_R
        Dim dtListaElementiDaEliminare As DataTable = letturaElementiGisDaEliminare.Leggi(objParametri_Server.PivaSuperUser,
                                                                                          0,
                                                                                          0,
