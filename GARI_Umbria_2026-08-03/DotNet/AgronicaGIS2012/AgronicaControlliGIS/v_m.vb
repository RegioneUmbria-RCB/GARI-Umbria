    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' </summary>
    ''' <param name="objPfRateoSrv"></param>
    ''' <param name="objParametri_Server"></param>
    ''' <param name="objParametri_Utenti"></param>
    ''' <param name="objParametri_Super_Server"></param>
    ''' <returns></returns>
    Public Shared Function pfRateo_2022(ByVal objPfRateoSrv As PfRateoSrv_In,
                                        ByRef objParametri_Server As AgronicaCoreParametri,
                                        ByRef objParametri_Utenti As AgronicaCoreParametri,
                                        ByRef objParametri_Super_Server As AgronicaCoreParametri) As RispostaStandard
        Dim r As New RispostaStandard

        'per ottenere la psw_SuperUser
        Dim user As String = objParametri_Server.SuperUserUsername
        Dim passwordSuperUser As String = ""
        Dim letturaUtenti As New AgronicaCoreUtentiDAL.Utenti_Read

        Dim dt_Utenti As DataTable = letturaUtenti.Leggi2(user, "", "", objParametri_Utenti)

        If dt_Utenti.Rows.Count > 0 Then
            passwordSuperUser = dt_Utenti.Rows(0).Item("Password")

        End If

        Dim AgroPF As New AgronicaPrecisionFarming.PianoConcimazioneRateoVariabile

        'Converto da Lista_DatiPrecision_XmlAllegati_Out a AgronicaCoreModello.PrecisionModel_CFGLetturaDati
        'non potendo sfruttare la classe all'interno di AgronicaCoreWs
        Dim objDeserialize As String = JsonConvert.SerializeObject(objPfRateoSrv.oCfgLetturaPF)
        Dim oCfgLetturaPF As PrecisionModel_CFGLetturaDati =
            JsonConvert.DeserializeObject(Of PrecisionModel_CFGLetturaDati)(objDeserialize)

        Dim ChiaveAlbero As String = Converti_ChiaveAlbero_ToString(objPfRateoSrv.ChiaveAlbero)

        'Valorizzo il Codice_Fiscale_Tecnico prendendolo dalla tabella Gruppi_Utente
        Dim Codice_Fiscale_Tecnico As String = ""
        Dim xUtenteCorrente As String = CType(objParametri_Server, AgronicaCoreDataProvider.AgronicaCoreParametri).UtenteUsername
        Dim objUtentiDAL As New AgronicaCoreUtentiDAL.Utenti_xGruppi_Utente_R
        Codice_Fiscale_Tecnico = objUtentiDAL.Leggi_IdentificativoGruppoUtenti_Singolo(xUtenteCorrente,
                                                                                       objParametri_Utenti)

        r.RispostaOK = True
        r = AgroPF.CalcolaPianoConcimazioneRateoVariabileLocal(objPfRateoSrv.DescrizionePiano,
                                                               objPfRateoSrv.DataRiferimento_LetturaDatiSentinel,
                                                               ChiaveAlbero,
                                                               CType(objPfRateoSrv.CellSize, Integer),
                                                               Codice_Fiscale_Tecnico,
                                                               passwordSuperUser,
                                                               oCfgLetturaPF,
                                                               objParametri_Server,
                                                               objParametri_Utenti)

        Return r

    End Function

