    ''' <param name="s"></param>
    ''' <param name="hipenChar"></param>
    ''' <returns></returns>
    Public Shared Function DatiPf2(ByVal s As String,
                                   ByVal hipenChar As String) As String

        If s.Contains("§") Then


            Dim lSSplit As String() = s.Split("|")
            Dim s1 As New List(Of String)
            Dim lenllsplit As Integer = lSSplit.Length

            For i As Integer = 0 To lSSplit.Length - 1
                If lSSplit(i) <> "" Then
                    s1.Add(hipenChar & lSSplit(i).Split("§ ")(0) & hipenChar & " : " & hipenChar & lSSplit(i).Split("§")(1) & hipenChar)
                End If

            Next

            Return String.Join(",", s1.ToArray)
        Else
            Return ""
        End If
    End Function


    ''' <summary>
    ''' Versione - Importazione funzioni GIS 2022
    ''' Implementata per non utilizzare la Sessione
    ''' </summary>
    ''' <param name="s"></param>
    ''' <param name="hipenChar"></param>
    ''' <returns></returns>
    Public Shared Function DatiPf2_Translated(ByVal s As String,
                                   ByVal layerCod As Int32,
                                   ByVal hipenChar As String,
                                   ByRef objParametri_Server As AgronicaCoreParametri) As String

        If s.Contains("§") Then

            Dim xRead As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_R
            Dim dtTranslations = xRead.LeggiTraduzioniAttributoByLayerId(1, layerCod,
                                                                objParametri_Server.Lingua_Cod,
                                                              objParametri_Server)
            Dim translations = dtTranslations.AsEnumerable().ToArray()

            Dim lSSplit As String() = s.Split("|")
            Dim s1 As New List(Of String)
            Dim lenllsplit As Integer = lSSplit.Length

            For i As Integer = 0 To lSSplit.Length - 1
                If lSSplit(i) <> "" Then
                    Dim attribute = lSSplit(i).Split("§ ")
                    Dim attributeName = attribute(0)
                    Dim translation = translations.FirstOrDefault(Function(x) x("attributeName") = attributeName)
                    Dim attributeValue = attribute(1)
                    Dim displayName = If(translation Is Nothing,
                                         attributeName,
                                         If(Not String.IsNullOrWhiteSpace(CStr(translation("LayerElementiGrafici_Etichetta"))),
                                            CStr(translation("LayerElementiGrafici_Etichetta")),
                                            attributeName))
                    s1.Add(hipenChar & displayName & hipenChar & " : " & hipenChar & attributeValue & hipenChar)
                End If

            Next

            Return String.Join(",", s1.ToArray)
        Else
            Return ""
        End If
    End Function

