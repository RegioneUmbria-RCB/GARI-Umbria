            r.RispostaOK = (r.RispostaOK And r1.RispostaOK)
            r.RispostaStringa.Messaggio = AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_CaricaSingoloOggetto_Impianto_Cartografici_archivio)
            r.RispostaStringa.Lista_DatiImpianto = r1.RispostaStringa
            r.RispostaStringa.Entita_Cod = Entita_Cod

        Else

            r.RispostaOK = True
            r.RispostaStringa.Messaggio = AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_CaricaSingoloOggetto_Impianto_No_cartografici_archivio)
