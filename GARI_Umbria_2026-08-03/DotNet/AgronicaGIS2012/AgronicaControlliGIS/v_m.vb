            GestisciEsitoRispostaCancella(objDati, risposta)

        Next

        'Elemento figlio da eliminare

        Dim elementoStr As String = ""

        If NRowElementoDt >= 0 Then
            elementoStr = My.Resources.AgronicaControlliGIS.V_M_Elemento_GIS_principale_
