    Private Shared Function SalvaCentroAziendale(ByVal piva As String, ByVal sa_nome As String, ByVal sLat As String, ByVal sLong As String, ByVal ind As Indirizzo_struttura,
                                          ByVal objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri,
                                          ByVal objParametri_Utenti As AgronicaCoreDataProvider.AgronicaCoreParametri) As String


        Dim xmlDoc As XmlDocument

        Dim Base, Top, Progressivo As Integer
        CodiciProgressivi.Trova_Base_e_Top(Progressivo, Base, Top, objParametri_Utenti, objParametri_Server)

        Dim streerore As String = ""

        Dim xCentro As XmlElement
        Dim objxml As New AgronicaCoreXML.XML_Anagrafe

        Dim llat As Decimal = AgronicaGIS2012.Commons.xyz.myCDBL(sLat)
        Dim llong As Decimal = AgronicaGIS2012.Commons.xyz.myCDBL(sLong)

        xCentro = objxml.XML_2_CentriAziendali(streerore,
                              xmlDoc,
                              Base,
                              Top,
                              AgronicaCoreDataProvider.TipiEnumerativi.enum_TipoOperazioneDB.Scrittura,
                              piva,
                              0,
                              sa_nome,
                              1,
                               ind.Pro_Cod,
                               ind.Com_Cod,
                               0,
                               ind.Via,
                               ind.Frazione,
                               ind.Cap,
                               ind.Stato,
                               ind.Note,
                                Nothing,
                                Nothing,
                                Latitudine:=llat,
                                Longitudine:=llong
                                )

        Dim objCentroBiz As New AgronicaCoreAnagrafeBIZ.CentroAziendale_W
        Dim risp_boolean As Boolean

        Dim sa_cod As Integer = 0



        Try
            risp_boolean = objCentroBiz.CentroAziendale_Scrivi(xCentro.OuterXml, piva, sa_cod, objParametri_Server, objParametri_Utenti)
            streerore = "sa_cod=" & sa_cod
        Catch ex As Exception
            streerore = ex.Message
        End Try


        Return streerore
    End Function


