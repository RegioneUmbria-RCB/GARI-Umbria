    Public Shared Function CaricaSpecieDaCentro(ByVal Piva As String, ByVal Sa_Cod As String, ByVal isSementieri As Boolean, ByVal AggiungiCasellaSelezione As Boolean) As String

        Dim objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")
        Dim objParametri_Utenti = HttpContext.Current.Session("ASG_objParametri_Utenti")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim ddl_specie As New DropDownList
        Dim gp As New GisPurpose(HttpContext.Current.Session("Sementi"), HttpContext.Current.Session("SementiMappaturaLibera"))
        If gp.Mode() = GisPurpose.enum_GisPurpose.SementiSportello Then

            Dim id_specie As Integer = gp.SementiSportelloSpecie()
            Dim id_sottoSpecie As Integer = gp.SementiSportelloSottospecie()
            Dim id_Gruppo As Integer = gp.SementiSportelloGruppo()
            Dim id_Genotipo As Integer = gp.SementiSportelloGenotipo()

            AgronicaCoreUtility.CaricaListControl.SpecieVegetale_DaFiltroSementieri_Optimize(
                    ddl_specie, True, "", "", id_specie, id_sottoSpecie, id_Gruppo, id_Genotipo, "", False, 0, 0, 0, "", "", objParametri_Server, objParametri_Utenti)
        Else

            Dim objSpecie As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
            Dim dt As DataTable
            dt = objSpecie.Leggi_SpecieVarieta(Piva, Sa_Cod, 0, 0, 0, 0, enumSelezioneVariabile.Selezione_TabellaDatiMinimi, "", "", objParametri_Server)
            ddl_specie.Items.Clear()
            For Each dr In dt.Rows
                ddl_specie.Items.Add(New ListItem(dr("Veg_Des"), dr("Veg_Cod")))
            Next
        End If

        Dim str As New StringBuilder
        If AggiungiCasellaSelezione Then
            str.Append("<option value='-1'>" & My.Resources.AgronicaControlliGIS.V_M_Specie_Vegetale & "</option>")
        End If

        Dim hash As New List(Of String)
        For i = 0 To ddl_specie.Items.Count - 1
            If Not hash.Contains(ddl_specie.Items(i).Value) Then
                str.Append("<option value='" & ddl_specie.Items(i).Value & "'>" & ddl_specie.Items(i).Text & "</option>")
                hash.Add(ddl_specie.Items(i).Value)
            End If

        Next

        Return str.ToString
    End Function


    Public Shared Function CaricaImpiantiEsistenti(ByVal Piva As String, ByVal Sa_Cod As String, ByVal Veg_Cod As Integer, ByVal isSementieri As Boolean,
                                                   Optional ByVal rigaIniziale As Boolean = True,
                                                   Optional ByRef objParametri_Server As AgronicaCoreParametri = Nothing) As String

        If IsNothing(objParametri_Server) Then
            objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")

            If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
                Return "SessioneScaduta"
            End If
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim ddl_Impianti As New DropDownList
        Dim objRegImpianti As New AgronicaCoreAnagrafeDAL.Reg_Impianti_Read
        Dim dt As DataTable
        dt = objRegImpianti.Leggi_SpecieVarieta(Piva, Sa_Cod, 0, 0, Veg_Cod, 0, enumSelezioneVariabile.Selezione_TabellaCompleta, "", "", objParametri_Server)

        Dim str As New StringBuilder
        Dim hash As New Hashtable

        If rigaIniziale Then
            str.Append("<option value='-1'>" & My.Resources.AgronicaControlliGIS.V_M_CaricaImpiantiEsistenti_Seleziona & "</option>")
        End If

        For i = 0 To dt.Rows.Count - 1
            Dim key, nome
            Dim xTipoNodoChiave As Integer = enum_TipoNodo.Impianto_Generico

            Select Case dt.Rows(i).Item("gru_cod")
                Case 1
                    xTipoNodoChiave = enum_TipoNodo.ImpiantoArborea
                Case 2
                    xTipoNodoChiave = enum_TipoNodo.ImpiantoErbacea
                Case 3
                    xTipoNodoChiave = enum_TipoNodo.ImpiantoOrticola
            End Select

            AgronicaCoreDataProvider.Albero.ChiaveAlbero_Codifica_x_json(key, xTipoNodoChiave,
                                                                   dt.Rows(i).Item("Piva"), dt.Rows(i).Item("sa_cod"), ,
                                                                    dt.Rows(i).Item("Appezza"), dt.Rows(i).Item("id_reg"))

            ' VAnni: 10/4/2017: aggiungo la descrizone se necessario..
            Dim vegDes As String = ""
            If Veg_Cod = 0 Then
                vegDes = dt.Rows(i).Item("veg_des") & " - "
            End If

            nome = dt.Rows(i).Item("app_nome") & " - " & vegDes & dt.Rows(i).Item("cul_des") & " - " & dt.Rows(i).Item("validita_inizio") & " - " & dt.Rows(i).Item("sup_imp")
            str.Append("<option value='" & key & "'>" & nome & "</option>")
        Next

        Return str.ToString
    End Function



