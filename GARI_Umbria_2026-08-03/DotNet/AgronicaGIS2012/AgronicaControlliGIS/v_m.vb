                AGRODATAFINE,
                enumSelezioneVariabile.Selezione_TabellaDatiMinimi,
                "",
                "",
                objParametri_Server,
                True)



                Dim tipoRicettaDaCaricare As String = dRic.Rows(0)("W_Anagrafica_Stati_Cod").ToString


                Select Case tipoRicettaDaCaricare
                    Case "300"
                        rval.RispostaStringa.ListaCodici_RicetteOperazioniCod_MappePrescrizione = listCodici
                    Case "301"
                        rval.RispostaStringa.ListaCodici_RicetteOperazioniCod_MappeProduzione = listCodici
                    Case Else
                        rval.RispostaStringa.ListaCodici_AllegatiDocumentiCod_MappePrescrizione = listCodici
