    Public Shared Function VerificaVicini(ByVal veg_cod As String, ByRef grva_cod As String, ByVal data_inizio As String, ByVal data_fine As String, ByVal hiddenPunti_Nuovo As String, ByVal escludi_entita_cod As String) As String

        Dim objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")
        Dim objParametri_Utenti = HttpContext.Current.Session("ASG_objParametri_Utenti")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        If data_inizio = "" Then
            data_inizio = AgronicaCoreDataProvider.CostantiPersonalizzate.AGRODATAINIZIO
        End If

        If data_fine = "" Then
            data_fine = AgronicaCoreDataProvider.CostantiPersonalizzate.AGRODATAFINE
        End If

        If String.IsNullOrEmpty(grva_cod) Then
            grva_cod = "0"
        End If

        Dim dtInterferenze As DataTable = dtInterferenze_from_poligono("", veg_cod, grva_cod, data_inizio, data_fine,
                                                                       -1000, True, 5, hiddenPunti_Nuovo, objParametri_Server, objParametri_Utenti)

        Dim iEntitaCod As Integer = -1
        If Not String.IsNullOrEmpty(escludi_entita_cod) Then
            If Not Integer.TryParse(escludi_entita_cod, iEntitaCod) Then
                iEntitaCod = -1
            End If
        End If


        Dim msg As String = ""
        Dim arr As String = ""
        If dtInterferenze Is Nothing Then
            msg = AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_Poligono_non_corretto_riprovare)
        Else
            If dtInterferenze.Rows.Count = 0 Then
                msg = AgronicaCoreUtility.jSon.Escape(My.Resources.AgronicaControlliGIS.V_M_Nessuna_prossimità_rilevata)
            Else
                Dim primo As Boolean = True
                For Each drowRisp As DataRow In dtInterferenze.Rows

                    If iEntitaCod <> drowRisp("Entita_Cod") Then

                        If Not primo Then
                            arr &= ", "
                        End If
                        primo = False
                        Dim indirizzo As String = drowRisp("Ind_des") & " " & drowRisp("frz_des") & " - " & drowRisp("cap") & " " & drowRisp("citta") & " " & drowRisp("provincia")
                        Dim referente As String = drowRisp("Referente")
                        Dim dist As Double = drowRisp("DistanzaEffettiva")
                        Dim distanza As String = ""
                        If dist > 1000 Then
                            distanza = Agro_Math.ArrotondaVal_3(dist / 1000).ToString("0.000") & " km"
                        Else
                            distanza = Agro_Math.ArrotondaVal_0(dist).ToString() & " mt"
                        End If
                        Dim veg_des As String = drowRisp("veg_des")
                        arr &= "{ "
                        arr &= """indirizzo"": """ & AgronicaCoreUtility.jSon.Escape(indirizzo) & """, "
                        arr &= """referente"": """ & AgronicaCoreUtility.jSon.Escape(referente) & """, "
                        arr &= """distanza"": """ & distanza & """, "
                        arr &= """veg_des"": """ & veg_des & """"
                        arr &= " }"

                    End If

                Next

            End If

        End If

        Dim risposta As String = "{"
        risposta &= """msg"": """ & msg & """, "
        risposta &= """arr"": [" & arr & "]"
        risposta &= "}"

        Return risposta

    End Function

    Public Shared Function InfoInterferenze(ByVal CodiceFiscaleTecnico As String, ByVal veg_cod As String, ByRef grva_cod As String, ByVal data_inizio As String, ByVal data_fine As String, ByVal hiddenPunti As String, ByVal escludi_entita_cod As String) As String

        Dim objParametri_Server As AgronicaCoreDataProvider.AgronicaCoreParametri
        objParametri_Server = HttpContext.Current.Session("ASG_objParametri_Server")
        Dim objParametri_Utenti = HttpContext.Current.Session("ASG_objParametri_Utenti")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_Server) Then
            Return "" '"SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()


        'Solo se sono in fase di notifica???
        Dim sportello As New AgronicaCoreSementieriDAL.Sportello_R
        Dim fase As DataTable = sportello.LeggiFaseSportelloXSpecie(veg_cod, DateTime.Now(), objParametri_Server)
        If fase Is Nothing OrElse fase.Rows.Count = 0 Then
            Return ""
        End If
        If CInt(fase.Rows(0)("RichiediConfermaSuInterferenze")) <> 1 Then
            Return ""
        End If

        Dim dtInterferenze As DataTable = dtInterferenze_from_poligono(CodiceFiscaleTecnico, veg_cod, grva_cod, data_inizio, data_fine,
                                                                       1, False, 0, hiddenPunti, objParametri_Server, objParametri_Utenti)
        Dim iEntitaCod As Integer = -1
        If Not String.IsNullOrEmpty(escludi_entita_cod) Then
            If Not Integer.TryParse(escludi_entita_cod, iEntitaCod) Then
                iEntitaCod = -1
            End If
        End If

        If dtInterferenze Is Nothing Then
            Return ""
        End If

        If dtInterferenze.Rows.Count = 0 Then
            Return ""
        End If

        Dim str As String
        Dim dist As Decimal

        Dim arrResult As New JArray

        For Each dr As DataRow In dtInterferenze.Rows

            'Filtro per CodiceFiscaleTecnico... non ho bisogno di escludere l'entita_cod!!! 
            If iEntitaCod <> dr("Entita_Cod") Then

                Dim obj As New JObject

                str = dr("Ind_des") & " " & dr("frz_des") & " - " & dr("cap") & " " & dr("citta") & " " & dr("provincia")
                obj("indirizzo") = str
                obj("referente") = dr("Referente").ToString
                dist = dr("DistanzaEffettiva")
                If dist > 1000 Then
                    str = Agro_Math.ArrotondaVal_3(dist / 1000).ToString("0.000") & " km"
                Else
                    str = Agro_Math.ArrotondaVal_0(dist).ToString() & " mt"
                End If
                obj("distanza") = str
                obj("veg_des") = dr("veg_des").ToString
                obj("tipologia") = dr("Tipologia").ToString

                arrResult.Add(obj)

            End If

        Next

        Return arrResult.ToString()

    End Function


    Public Shared Function DistanzaMTKM(ByVal mt As Decimal) As String
        Dim srval As String = ""
        Dim drval As Decimal = Math.Round(mt, 0)

        If drval > 10000 Then
            srval = "<b> km </b>"
            drval = drval / 1000
        Else
            srval = "<b> mt </b>"
        End If

        Return srval & drval.ToString

    End Function

    Private Shared Function GetCoord(ByVal hiddenPunti_Nuovo As String) As String
        Dim coord As String
        Dim app_coor = Replace(hiddenPunti_Nuovo, "(", "")
        app_coor = Replace(app_coor, ",", " ")
        app_coor = app_coor.Trim
        app_coor = Replace(app_coor, "   ", " ")
        app_coor = Replace(app_coor, "  ", " ")

        app_coor = Replace(app_coor, ") ", ",")
        app_coor = Replace(app_coor, ")", "")

        'app_coor = app_coor + " " + app_coor.Split(" ")(0) + " " + app_coor.Split(" ")(1)

        Dim TipoOggetto As String = "POLYGON"
        If hiddenPunti_Nuovo.Split(",").Count = 2 Then
            TipoOggetto = "POINT"

        End If
        If hiddenPunti_Nuovo.Split(",").Count = 4 Then
            TipoOggetto = "LINESTRING"

        End If
        coord = TipoOggetto & " ((" & app_coor & "))"
        Return coord

    End Function

    Public Shared Function coordinateFromViaCentro()

        Dim objParamentri_server As New AgronicaCoreDataProvider.AgronicaCoreParametri
        objParamentri_server = HttpContext.Current.Session("ASG_objParametri_Server")

        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParamentri_server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim _FiltroSa_Cod As Integer = 0

        If (IsNothing(HttpContext.Current.Session("_Piva"))) Then
            HttpContext.Current.Session("_Piva") = ""
        End If
        Dim Piva As String = HttpContext.Current.Session("_Piva")
        If Not String.IsNullOrEmpty(HttpContext.Current.Session("_Sa_Cod")) Then
            'in realtà qui c'è la chiave dell'albero
            '' VAnni: 30/3/2018: Su interfaccia GIS dopo avere eliminato l'ultimo impianto viene chiamata la funzione con impostato il Sa_Cod in sessione che non usa il carattere § come separatore
            If HttpContext.Current.Session("_Sa_Cod").ToString().Split(SeparatoreAlberoJson).Length > 2 Then
                _FiltroSa_Cod = HttpContext.Current.Session("_Sa_Cod").ToString().Split(SeparatoreAlberoJson)(2)
            Else
                _FiltroSa_Cod = HttpContext.Current.Session("_Sa_Cod")
            End If
        End If


        Dim str As String
        Dim objIndirizzi As New AgronicaCoreAnagrafeDAL.Indirizzi_Read
        Dim dt As DataTable = objIndirizzi.LeggixGisCentro(Piva, _FiltroSa_Cod, objParamentri_server)
        If dt.Rows.Count = 0 Then
            dt = objIndirizzi.LeggixGisCentro(Piva, 0, objParamentri_server)
            If dt.Rows.Count = 0 Then
                dt = objIndirizzi.LeggixGisCentro("", 0, objParamentri_server)
            End If
        End If
        If dt.Rows.Count = 0 Then
            Return ""
        End If
        str = ""
        'creo la stringa di risposta
        If dt.Rows(0).Item("stato") <> "" Then
            str = str + " " + dt.Rows(0).Item("stato")
        End If
        If dt.Rows(0).Item("localita") <> "" And dt.Rows(0).Item("localita").ToString.ToUpper <> "NONE" Then
            str = str + " " + dt.Rows(0).Item("localita")
        End If
        If dt.Rows(0).Item("provincia") <> "" And dt.Rows(0).Item("provincia").ToString.ToUpper <> "NONE" Then
            str = str + " " + dt.Rows(0).Item("provincia")
        End If
        If dt.Rows(0).Item("ind_des") <> "" And dt.Rows(0).Item("ind_des").ToString.ToUpper <> "NONE" Then
            str = str + " " + dt.Rows(0).Item("ind_des")
        End If
        If dt.Rows(0).Item("frz_des") <> "" And dt.Rows(0).Item("frz_des").ToString.ToUpper <> "NONE" Then
            str = str + " " + dt.Rows(0).Item("frz_des")
        End If
        If dt.Rows(0).Item("com_des") <> "" And dt.Rows(0).Item("com_des").ToString.ToUpper <> "NONE" Then
            str = str + " " + dt.Rows(0).Item("com_des")
        End If

        Return str
    End Function

