    Public Shared Function SalvaColoriLayer(ByVal Tipologia As Integer, ByVal Dati As String) As String

        Dim objParametri_server = HttpContext.Current.Session("ASG_objParametri_Server")
        If HttpContext.Current.Session.IsNewSession OrElse IsNothing(objParametri_server) Then
            Return "SessioneScaduta"
        End If

        Lingua.Gias_InizializzaCultura_DaSession()

        Dim lDatiSplittati As String() = Dati.Split("$")

        If Tipologia = 1 Then

            'GIS_LayerElementiGrafici

            Dim objMod As New AgronicaCoreGisDAL.GIS_LayerElementiGrafici_W
            Dim i As Integer
            Dim ID, primario, secondario, varianza, trasparenza, MostraDescrizioneAssociata, zindex, visibile, tipologiaLayer_cod As String
            For i = 0 To lDatiSplittati.Length - 2

                Dim lDecSep As String = Threading.Thread.CurrentThread.CurrentCulture.NumberFormat.NumberDecimalSeparator
                Dim v As String() = lDatiSplittati(i).Split("|")

                ID = v(0)
                primario = v(1)
                secondario = v(2)
                varianza = v(3)

                'TODO: vanni, 23/05/2017 - verificare questo: per evitare una dipendenza con Gias base verifico il numero il numero di elementi .. così è compatibile con versioni precedenti.
                Select Case v.Length
                    Case 9
                        trasparenza = v(4).Replace(".", lDecSep)
                        MostraDescrizioneAssociata = v(5)
                        zindex = v(6)
                        visibile = v(7)
                        tipologiaLayer_cod = v(8)
                    Case 8
                        trasparenza = v(4).Replace(".", lDecSep)
                        MostraDescrizioneAssociata = "0"
                        zindex = v(5)
                        visibile = v(6)
                        tipologiaLayer_cod = v(7)
                    Case 7
                        trasparenza = "0" & lDecSep & "6"
                        MostraDescrizioneAssociata = "0"
                        zindex = v(4)
                        visibile = v(5)
                        tipologiaLayer_cod = v(6)

                End Select

                If MostraDescrizioneAssociata = "true" Then
                    MostraDescrizioneAssociata = "1"
                End If

                If visibile = "false" Then
                    visibile = "0"
                Else
                    visibile = "1"
                End If

                primario = primario.TrimStart("#")
                secondario = secondario.TrimStart("#")

                objMod.Modifica_Colori(objParametri_server.PivaSuperUser, objParametri_server.UtenteUsername, ID, tipologiaLayer_cod, primario, secondario, varianza, trasparenza, MostraDescrizioneAssociata, zindex, visibile, "", objParametri_server)
            Next

        Else

            'GIS_LayerTiles

            Dim objModTiles As New AgronicaCoreGisDAL.GIS_LayerTiles_W

            Dim i As Integer
            Dim ID, primario, secondario, varianza As String

            For i = 0 To lDatiSplittati.Length - 2
                ID = lDatiSplittati(i).Split("|")(0)
                primario = lDatiSplittati(i).Split("|")(1)
                secondario = lDatiSplittati(i).Split("|")(2)
                varianza = lDatiSplittati(i).Split("|")(3)

                primario = primario.TrimStart("#")
                secondario = secondario.TrimStart("#")

                objModTiles.Modifica_colori(
                    objParametri_server.PivaSuperUser,
                    0,
                    ID,
                    0,
                    objParametri_server.UtenteUsername,
                    primario,
                    secondario,
                    varianza,
                    objParametri_server)
            Next

        End If

        Return "OK"

    End Function





