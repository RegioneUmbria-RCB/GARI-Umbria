{
  "$schema": "node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "GiasNG": {
      "i18n": {
        "sourceLocale": "en-US",
        "locales": {
          "it": "src/locale/messages.it.xlf"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "localize": false,
            "outputPath": "dist/",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.app.json",
            "optimization": false,
            "sourceMap": true,
            "namedChunks": true,
            "extractLicenses": false,
            "vendorChunk": true,
            "buildOptimizer": false,
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/GiasVersioneCorrente.txt",
              "src/web.config",
              "src/RewriteRules.config"
            ],
            "styles": [
              "node_modules/gias-shared-css/src/index.scss",
              {
                "input": "src/stylesBootstrapClassic.scss",
                "bundleName": "stylesBootstrapClassic",
                "inject": false
              }
            ],
            "scripts": [
              "src/assets/breadcrumbSelector.js",
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.min.js"
            ],
            "progress": true,
            "aot": true,
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true
            },
            "it": {
              "localize": false
            },
            "production-it": {
              "localize": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          }
        },
        "build-vite": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "localize": false,
            "outputPath": "dist/",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "src/tsconfig.app.json",
            "optimization": false,
            "sourceMap": true,
            "namedChunks": true,
            "extractLicenses": false,
            "outputHashing": "media",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/GiasVersioneCorrente.txt",
              "src/web.config",
              "src/RewriteRules.config"
            ],
            "styles": [
              "node_modules/gias-shared-css/src/index.scss",
              {
                "input": "src/stylesBootstrapClassic.scss",
                "bundleName": "stylesBootstrapClassic",
                "inject": false
              }
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.min.js",
              "src/assets/breadcrumbSelector.js"
            ],
            "progress": true,
            "aot": true,
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true
            },
            "it": {
              "localize": false
            },
            "production-it": {
              "localize": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "GiasNG:build-vite:it"
          },
          "configurations": {
            "production": {
              "buildTarget": "GiasNG:build-vite:production-it"
            },
            "it": {
              "buildTarget": "GiasNG:build-vite:it"
            },
            "production-it": {
              "buildTarget": "GiasNG:build-vite:production-it"
            },
            "en": {
              "buildTarget": "GiasNG:build-vite"
            },
            "production-en": {
              "buildTarget": "GiasNG:build-vite:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "GiasNG:build:it"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              "node_modules/gias-shared-css/src/index.scss",
              {
                "input": "src/stylesBootstrapClassic.scss",
                "bundleName": "stylesBootstrapClassic",
                "inject": false
              }
            ],
            "scripts": [
              "src/assets/breadcrumbSelector.js"
            ],
            "assets": [
              "src/assets"
            ],
            "webWorkerTsConfig": "tsconfig.worker.json"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "src/tsconfig.app.json",
              "src/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        },
        "server": {
          "builder": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist-server",
            "main": "src/main.ts",
            "tsConfig": "src/tsconfig.server.json"
          },
          "configurations": {
            "dev": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "buildOptimizer": true
            },
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "buildOptimizer": true
            }
          }
        }
      }
    }
  }
}