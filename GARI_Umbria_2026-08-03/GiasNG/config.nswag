le\": false\r\n        },\r\n        \"chkMostraAnagrafica\": {\r\n          \"description\": \"Visualizza i dati di anagrafica (Nell'albero anagrafica o altrove)\",\r\n          \"type\": \"boolean\",\r\n          \"example\": true\r\n        },\r\n        \"chkMostraCatasto\": {\r\n          \"description\": \"Visualizza i dati catastali (Nell'albero anagrafica o altrove)\",\r\n          \"type\": \"boolean\",\r\n          \"example\": true\r\n        },\r\n        \"chkMostraCatastoAppezzamento\": {\r\n          \"description\": \"Visualizza i dati catastali dettagliati per ciascun appezzamento (Nell'albero anagrafica o altrove)\",\r\n          \"type\": \"boolean\",\r\n          \"example\": false\r\n        },\r\n        \"ckGrigliaTiles_Sviluppo\": {\r\n          \"description\": \"Mostra una griglia con i tiles di goole, utiili per lo sviluppo\",\r\n          \"type\": \"boolean\",\r\n          \"example\": false\r\n        },\r\n        \"ckViewModal\": {\r\n          \"description\": \"Visualizza le finestre in maniera modale, in alternativa esegue una redirezione alla pagina abbandonando il GIS\",\r\n          \"type\": \"boolean\",\r\n          \"example\": true\r\n        },\r\n        \"srvGisTipoRender_ServerSide\": {\r\n          \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.Gis.ConfigurazioneGisUtente+enum_TipoRender_ServerSide\"\r\n        },\r\n        \"SistemaDiRiferimentoPredefinito\": {\r\n          \"format\": \"int32\",\r\n          \"description\": \"Sistema di riferimento predefinito per popolare le caselle a discesa\",\r\n          \"type\": \"integer\",\r\n          \"example\": 1\r\n        },\r\n        \"GruppoOperazioneColturale\": {\r\n          \"description\": \"Gruppo Operazione colturale (per filtro)\",\r\n          \"type\": \"string\",\r\n          \"example\": \"0\"\r\n        },\r\n        \"TipoOperazioneColturale\": {\r\n          \"description\": \"Tipo Operazione Colturale (per filtro)\",\r\n          \"type\": \"string\",\r\n          \"example\": \"0\"\r\n        },\r\n        \"iAutoZoomSuVisualizzazioneTotale\": {\r\n          \"format\": \"int32\",\r\n          \"description\": \"Livello auto zoom per visualizzazione totale.\\r\\nValori ammessi:\\r\\n-1 = auto zoom disabilitato,\\r\\n8-16 = specifico livello di auto zoom.\",\r\n          \"type\": \"integer\",\r\n          \"example\": 15\r\n        },\r\n        \"ckAvversitaUsaPuntoInterno\": {\r\n          \"description\": \"Flag per indicare l'utilizzo di un punto interno al poligono in assenza di rilievo puntuale\",\r\n          \"type\": \"boolean\",\r\n          \"example\": true\r\n        },\r\n        \"ckAvversitaPuntoPoligono\": {\r\n          \"description\": \"Flag per consentire l'utilizzo di un punto interno al posto dell'intero poligono\",\r\n          \"type\": \"boolean\",\r\n          \"example\": true\r\n        },\r\n        \"ckGestioneAnalisiMappeLegacy\": {\r\n          \"description\": \"Flag per consentire l'utilizzo di un punto interno al posto dell'intero poligono\",\r\n          \"type\": \"boolean\",\r\n          \"example\": true\r\n        },\r\n        \"LivelloClusterizzazione\": {\r\n          \"format\": \"int32\",\r\n          \"description\": \"Livello definito per inizio funzione di clusterizzazione poligoni\",\r\n          \"type\": \"integer\",\r\n          \"example\": 15\r\n        },\r\n        \"chkMostraHeatmap\": {\r\n          \"description\": \"Flag per visualizzare i cluster sulla mappa in versione heatmap\",\r\n          \"type\": \"boolean\",\r\n          \"example\": false\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreModelsSTD.Gis.ConfigurazioneGisUtente+enum_TipoRender_ServerSide\": {\r\n      \"description\": \"Tipo di lettura dei dati SQL Spatial, se completa non si applicano filtri basati su Bounding Box, se parziale sì\",\r\n      \"enum\": [\r\n        \"Completa\",\r\n        \"Parziale\"\r\n      ],\r\n      \"typ