: {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"listaEntita\": {\r\n          \"type\": \"array\",\r\n          \"items\": {\r\n            \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Gis.EntitaAlgoritmoCartografico\"\r\n          }\r\n        },\r\n        \"isAttivo\": {\r\n          \"type\": \"boolean\"\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.AttivazioneMascheraLayerRaster\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"Maschera_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"isAttivo\": {\r\n          \"type\": \"boolean\"\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.AttributoLayer_In\": {\r\n      \"description\": \"Parametri di filtro in lettura della lista dei layer e dei tiles\",\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"IdLayer\": {\r\n          \"description\": \"l’ID del layer selezionato\",\r\n          \"type\": \"string\",\r\n          \"example\": \"123\"\r\n        },\r\n        \"Nome\": {\r\n          \"description\": \"Nuovo nome dell'Attributo (INSERT ed UPDATE)\",\r\n          \"type\": \"string\",\r\n          \"example\": \"Catasto\"\r\n        },\r\n        \"TipoDato\": {\r\n          \"description\": \"Il tipo del dato dell'attributo\",\r\n          \"type\": \"string\",\r\n          \"example\": \"string\"\r\n        },\r\n        \"ProgressivoDataStruct\": {\r\n          \"description\": \"Progressivo Data Struct. OPZIONALE, solo per operazioni di UPDATE e DELETE\",\r\n          \"type\": \"string\",\r\n          \"example\": \"123\"\r\n        },\r\n        \"IdOperazione\": {\r\n          \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Gis.AttributoLayer_In+OperazioneAttributo\"\r\n        }\r\n      },\r\n      \"