n              \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.profilazione.LeggiScriviVisibilitaUtenti\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreVarieBizSTD.RispostaStandard\"\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/HaVisibilitaTotale\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"summary\": \"Esegue un check sugli utenti specificati indicando se hanno visibilità totale o meno.\",\r\n        \"operationId\": \"ProfilazioneHaVisibilitaTotale\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"produces\": [\r\n          \"text/plain\",\r\n          \"application/json\",\r\n          \"text/json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"description\": \"Lista degli username degli utenti interessati\",\r\n            \"schema\": {\r\n              \"type\": \"array\",\r\n              \"items\": {\r\n                \"type\": \"string\"\r\n              }\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreVarieBizSTD.RispostaStandard\"\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/ControllaStessaVisibilita\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"operationId\": \"ProfilazioneControllaStessaVisibilita\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"type\": \"array\",\r\n              \"items\": {\r\n                \"type\": \"string\"\r\n              }\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/ConfrontaVisibilitaUtenti\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"operationId\": \"ProfilazioneConfrontaVisibilitaUtenti\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.profilazione.ConfrontaVisibilitaUtenti\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/CheckFathersInList\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"operationId\": \"ProfilazioneCheckFathersInList\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"type\": \"array\",\r\n              \"items\": {\r\n                \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.anagrafiche.ImpresaDto\"\r\n              }\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/AssociaProfilo\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"summary\": \"Associa un profilo (aka tipologia utente) a uno o più utenti,\",\r\n        \"operationId\": \"ProfilazioneAssociaProfilo\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.profilazione.AssociaProfiloObj\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/ModificaValiditaPermessi\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"summary\": \"Aggiorna l'intervallo di tempo per cui sono validi i permessi di uno o più utenti.\",\r\n        \"operationId\": \"ProfilazioneModificaValiditaPermessi\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.profilazione.AssociaProfiloObj\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/ModificaFinestraTemporale\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"summary\": \"Aggiorna la finestra temporale di uno o più utenti.\",\r\n        \"operationId\": \"ProfilazioneModificaFinestraTemporale\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"type\": \"array\",\r\n              \"items\": {\r\n                \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.profilazione.UtenteFinestraTemp\"\r\n              }\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/AggiornaPermessiUtentiTipologia\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"summary\": \"Aggiorna l'intervallo di tempo per cui sono validi i permessi di uno o più utenti.\",\r\n        \"operationId\": \"ProfilazioneAggiornaPermessiUtentiTipologia\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.profilazione.TipologiaUtente\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/CreateRandomCF\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"operationId\": \"ProfilazioneCreateRandomCF\",\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/CaricaUtenti\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"summary\": \"Carica i dati inerenti a uno o più utenti.\\r\\nVersione con parametro di: <seealso cref=\\\"M:AgronicaCoreAPI.Controllers.ProvisioningController.ListaUtenti(System.String)\\\" />\",\r\n        \"operationId\": \"ProfilazioneCaricaUtenti\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"description\": \"Stringa in formato JSON contenente i filtri da applicare alla lettura degli utenti.\",\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/GetUsersCount\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"operationId\": \"ProfilazioneGetUsersCount\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/ImpostaLingua\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"summary\": \"Modifica la lingua di visualizzazione di un utente.\",\r\n        \"operationId\": \"ProfilazioneImpostaLingua\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.profilazione.CambioLinguaObj\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/AggiornaCliente_Permessi\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"operationId\": \"ProfilazioneAggiornaClientePermessi\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Metaschema.Cliente_PermessiScrivi\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/LeggiCliente_Permessi\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"operationId\": \"ProfilazioneLeggiClientePermessi\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/ControllaEsistenzaTabellaCliente_Permessi\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"operationId\": \"ProfilazioneControllaEsistenzaTabellaClientePermessi\",\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Profilazione/ImportaUtentiDaExcel\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Profilazione\"\r\n        ],\r\n        \"operationId\": \"ProfilazioneImportaUtentiDaExcel\",\r\n        \"consumes\": [\r\n          \"multipart/form-data\"\r\n        ],\r\n        \"produces\": [\r\n          \"text/plain\",\r\n          \"application/json\",\r\n          \"text/json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"formData\",\r\n            \"name\": \"file\",\r\n            \"type\": \"file\"\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreVarieBizSTD.RispostaStandard\"\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Provisioning/ClientValidation\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Provisioning\"\r\n        ],\r\n        \"operationId\": \"ProvisioningPostClientValidation\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Provisioning.ClientValidationRequest\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Provisioning/ApiValidation\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Provisioning\"\r\n        ],\r\n        \"operationId\": \"ProvisioningPostApiValidation\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Provisioning.ApiValidationRequest\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Provisioning/ListaUtenti\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Provisioning\"\r\n        ],\r\n        \"summary\": \"Ritorna l'elenco degli utenti\",\r\n        \"description\": \"GET /ListaUtenti\",\r\n        \"operationId\": \"ProvisioningListaUtenti\",\r\n        \"produces\": [\r\n          \"text/plain\",\r\n          \"application/json\",\r\n          \"text/json\"\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"Operazione andata a buon fine\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreVarieBizSTD.RispostaStandard\"\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Errore durante l'operazione\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Provisioning/ListaUtentiDatiBase\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Provisioning\"\r\n        ],\r\n        \"summary\": \"Ritorna l'elenco degli utenti con i dati di base\",\r\n        \"description\": \"GET /ListaUtentiDatiBase\",\r\n        \"operationId\": \"ProvisioningListaUtentiDatiBase\",\r\n        \"produces\": [\r\n          \"text/plain\",\r\n          \"application/json\",\r\n          \"text/json\"\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"Operazione andata a buon fine\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreVarieBizSTD.RispostaStandard`1[AgronicaCoreModelsSTD.provisioning.ListaUtenti]\"\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Errore durante l'operazione\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Provisioning/ListaGruppiUtente\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Provisioning\"\r\n        ],\r\n        \"summary\": \"Ritorna l'elenco dei gruppi utenti\",\r\n        \"description\": \"GET /ListaGruppiUtente\",\r\n        \"operationId\": \"ProvisioningListaGruppiUtente\",\r\n        \"produces\": [\r\n          \"text/plain\",\r\n          \"application/json\",\r\n          \"text/json\"\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"Operazione andata a buon fine\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreVarieBizSTD.RispostaStandard`1[AgronicaCoreModelsSTD.provisioning.ListaGruppiUtente]\"\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Errore durante l'operazione\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Provisioning/DatiServer\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Provisioning\"\r\n        ],\r\n        \"summary\": \"Ritorna i dati del server richiesto\",\r\n        \"description\": \"POST /DatiServer\",\r\n        \"operationId\": \"ProvisioningDatiServer\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"produces\": [\r\n          \"text/plain\",\r\n          \"application/json\",\r\n          \"text/json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"description\": \"Il tipo di server di cui si richiedono i dati\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Provisioning.DatiServerRequest\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"Operazione andata a buon fine\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreVarieBizSTD.RispostaStandard`1[AgronicaCoreModelsSTD.provisioning.DatiServer]\"\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Utente non autorizzato\"\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Errore durante l'operazione\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Provisioning/CreaNuovoToken\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Provisioning\"\r\n        ],\r\n        \"summary\": \"Crea un nuovo token utente nelle tabelle super_server\",\r\n        \"description\": \"POST /CreaNuovoToken\",\r\n        \"operationId\": \"ProvisioningCreaNuovoToken\",\r\n        \"consumes\": [\r\n          \"application/json-patch+json\",\r\n          \"application/json\",\r\n          \"text/json\",\r\n          \"application/*+json\"\r\n        ],\r\n        \"produces\": [\r\n          \"text/plain\",\r\n          \"application/json\",\r\n          \"text/json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"description\": \"Contiene i riferimenti ai DB\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Provisioning.CreaToken_In\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"Operazione andata a buon fine\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreVarieBizSTD.RispostaStandard\"\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Utente non autorizzato\"\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Errore durante l'operazione\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/Provisioning/VerificaEsistenzaToken\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Provisioning\"\r\n        ],\r\n        \"summary\": \"Verifica l'esistenza di un token\",\r\n        \"description\": \"POST /VerificaEsistenzaToken\",\r\n        \"operationId\": \"ProvisioningVerificaEsistenzaToken\",\r\n        \"produces\": [\r\n          \"text/plain\",\r\n          \"application/json\",\r\n          \"text/json\"\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"Operazione andata a buon fine\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AgronicaCoreVarieBizSTD.RispostaStandard\"\r\n            }\r\n          },\r\n          \"401\":