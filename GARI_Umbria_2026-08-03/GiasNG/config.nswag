": {\r\n            \"format\": \"int32\",\r\n            \"type\": \"integer\"\r\n          }\r\n        },\r\n        \"Flag_TipoCod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.CaricaImpreseCod_In\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"Piva\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"Id_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.ChiaveImpianto_In\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"Piva\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"Sa_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"Appezza\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"Id_Reg\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"Progetto_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"Veg_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"Id_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.ConfigurazioneProiezione\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"ConfigurazioneProiezione_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"ConfigurazioneProiezione_Des\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"ConfigurazioneProiezione_GUID\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"AlgoritmoProiezione_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"AttivoTuttiLayer\": {\r\n          \"type\": \"boolean\"\r\n        },\r\n        \"canManage\": {\r\n          \"type\": \"boolean\"\r\n        },\r\n        \"canActivate\": {\r\n          \"type\": \"boolean\"\r\n        },\r\n        \"canEditCfg\": {\r\n          \"type\": \"boolean\"\r\n        },\r\n        \"cfg\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"Layer1\": {\r\n          \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Gis.ProiezioneLayer\"\r\n        },\r\n        \"Layer2\": {\r\n          \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Gis.ProiezioneLayer\"\r\n        },\r\n        \"LayerRisultato\": {\r\n          \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Gis.ProiezioneLayer\"\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.ConfigurazioneSuEntitaAttiva\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"Entita_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"AttivaDa\": {\r\n          \"format\": \"date-time\",\r\n          \"type\": \"string\"\r\n        },\r\n        \"AttivaA\": {\r\n          \"format\": \"date-time\",\r\n          \"type\": \"string\"\r\n        },\r\n        \"Sospesa\": {\r\n          \"type\": \"boolean\"\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.ConfigurazioneSuLayer\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"LayerAnalysisConfig_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"LayerAnalysisConfig_Des\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"LayerAnalysisConfig_Algorithm_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"LayerAnalysisConfig_Algorithm_Des\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"AttivaSuTuttiLayer\": {\r\n          \"type\": \"boolean\"\r\n        },\r\n        \"NumEntitaMax\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"NumEntitaAttive\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        },\r\n        \"EntitaAttive\": {\r\n          \"type\": \"array\",\r\n          \"items\": {\r\n            \"$ref\": \"#/definitions/AgronicaCoreDTOStd.InData.Gis.ConfigurazioneSuEntitaAttiva\"\r\n          }\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.CoordinateFromImpresa_In\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"Piva\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"Sa_Cod\": {\r\n          \"format\": \"int32\",\r\n          \"type\": \"integer\"\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.DatiLayer\": {\r\n      \"description\": \"Dati salvataggio layer\",\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"ID\": {\r\n          \"description\": \"ID layer\",\r\n          \"type\": \"string\",\r\n          \"example\": \"1\"\r\n        },\r\n        \"Colore_Primario\": {\r\n          \"description\": \"Colore primario in RGB\",\r\n          \"type\": \"string\",\r\n          \"example\": \"FFFF00\"\r\n        },\r\n        \"Colore_Secondario\": {\r\n          \"description\": \"Colore secondario in RGB\",\r\n          \"type\": \"string\",\r\n          \"example\": \"FFFF00\"\r\n        },\r\n        \"Varianza\": {\r\n          \"description\": \"Numero di intervalli in cui viene divisa la scala dei colori, calcolata a partire\\r\\ndal colore primario e secondario (se tipologia = 1 indicare 1 come valore)\",\r\n          \"type\": \"string\",\r\n          \"example\": \"5\"\r\n        },\r\n        \"Trasparenza\": {\r\n          \"description\": \"Trasparenza, indicare un valore compreso fra 0 e 1, a \\\"step\\\" di 0,1 : 0 = trasparente, 1 = pieno\",\r\n          \"type\": \"string\",\r\n          \"example\": \"0.6\"\r\n        },\r\n        \"ZIndex\": {\r\n          \"description\": \"Indica quale layer è in primo piano in base al valore assegnato (valore più alto = in primo piano)\",\r\n          \"type\": \"string\",\r\n          \"example\": \"10\"\r\n        },\r\n        \"Flag_Visibile\": {\r\n          \"format\": \"int32\",\r\n          \"description\": \"Indica se il layer è visibile nell'elenco (e di conseguenza vengono visualizzati elementi grafici) \\r\\noppure si trova in uno stato nascosto. (1 = visibile, 0 = nascosto)\",\r\n          \"type\": \"integer\",\r\n          \"example\": 1\r\n        },\r\n        \"MostraDescrizioneAssociata\": {\r\n          \"description\": \"Mostra la descrizione associata al layer (1 = mostra, 2 = nascondi)\",\r\n          \"type\": \"string\",\r\n          \"example\": \"1\"\r\n        },\r\n        \"TipologiaLayer_Cod\": {\r\n          \"description\": \"Indica la tipologia di appartenenza del layer\",\r\n          \"type\": \"string\",\r\n          \"example\": \"1\"\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.DatiTema\": {\r\n      \"description\": \"Dati salvataggio tema\",\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"ID\": {\r\n          \"description\": \"ID tema\",\r\n          \"type\": \"string\",\r\n          \"example\": \"1\"\r\n        },\r\n        \"Colore_Primario\": {\r\n          \"description\": \"Colore primario in RGB\",\r\n          \"type\": \"string\",\r\n          \"example\": \"FFFF00\"\r\n        },\r\n        \"Colore_Secondario\": {\r\n          \"description\": \"Colore secondario in RGB\",\r\n          \"type\": \"string\",\r\n          \"example\": \"FFFF00\"\r\n        },\r\n        \"Varianza\": {\r\n          \"description\": \"Numero di intervalli in cui viene divisa la scala dei colori, calcolata a partire dal colore primario e secondario (se tipologia = 1 indicare 1 come valore)\",\r\n          \"type\": \"string\",\r\n          \"example\": \"5\"\r\n        },\r\n        \"TipologiaLayer_Cod\": {\r\n          \"description\": \"Indica la tipologia di appartenenza del tema\",\r\n          \"type\": \"string\",\r\n          \"example\": \"1\"\r\n        },\r\n        \"LayerElementiGrafici_Cod\": {\r\n          \"description\": \"Indica il codice layer a cui appartiene il tema\",\r\n          \"type\": \"string\",\r\n          \"example\": \"50\"\r\n        },\r\n        \"layerDescrizione_aggiungi\": {\r\n          \"description\": \"La lista dei LayerTilesDescrizione da aggiungere al tema\",\r\n          \"type\": \"array\",\r\n          \"items\": {\r\n            \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.Gis.TipologiaLabel\"\r\n          }\r\n        },\r\n        \"layerDescrizione_modifica\": {\r\n          \"description\": \"La lista dei LayerTilesDescrizione da modificare per il tema\",\r\n          \"type\": \"array\",\r\n          \"items\": {\r\n            \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.Gis.TipologiaLabel\"\r\n          }\r\n        },\r\n        \"layerDescrizione_elimina\": {\r\n          \"description\": \"La lista dei LayerTilesDescrizione da eliminare per il tema\",\r\n          \"type\": \"array\",\r\n          \"items\": {\r\n            \"$ref\": \"#/definitions/AgronicaCoreModelsSTD.Gis.TipologiaLabel\"\r\n          }\r\n        }\r\n      },\r\n      \"additionalProperties\": false\r\n    },\r\n    \"AgronicaCoreDTOStd.InData.Gis.ElaborazioneGEE\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"GIS_LayerAnalysisConfig_Exec_Log_Cod